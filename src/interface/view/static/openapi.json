{
  "openapi": "3.1.0",
  "info": {
    "title": "curlone",
    "description": "Конвертер команды curl в код на языке 1С",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/convert": {
      "get": {
        "tags": [
          "API"
        ],
        "summary": "Конвертирует команду curl в код на 1С",
        "parameters": [
          {
            "name": "cmd",
            "in": "query",
            "description": "Команда curl",
            "required": true,
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/ConversionRequest/properties/cmd"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Язык / библиотека",
            "required": false,
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/ConversionRequest/properties/lang"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Язык перевода",
            "required": false,
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/ConversionRequest/properties/locale"
            }
          },
          {
            "name": "response-type",
            "in": "query",
            "description": "Ожидаемый тип ответа на запрос команды curl",
            "required": false,
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/ConversionRequest/properties/response-type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "API"
        ],
        "summary": "Конвертирует команду curl из параметров POST-запроса в код на 1С",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ConversionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConversionRequest": {
        "description": "Параметры конвертации команды curl",
        "type": "object",
        "required": [
          "cmd"
        ],
        "properties": {
          "cmd": {
            "description": "Команда curl",
            "type": "string"
          },
          "lang": {
            "description": "Язык / библиотека",
            "type": "string",
            "default": "1c",
            "enum": [
              "1c",
              "connector"
            ]
          },
          "locale": {
            "description": "Язык перевода",
            "type": "string",
            "default": "ru",
            "enum": [
              "ru",
              "en"
            ]
          },
          "response-type": {
            "description": "Ожидаемый тип ответа на запрос команды curl",
            "type": "string",
            "enum": [
              "json"
            ]
          }
        }
      },
      "Result": {
        "description": "Результат конвертации",
        "type": "object",
        "properties": {
          "result": {
            "description": "Код на 1С",
            "type": "string"
          },
          "errors": {
            "description": "Ошибки и предупреждения",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "Описание ошибки",
        "type": "object",
        "properties": {
          "text": {
            "description": "Текст ошибки",
            "type": "string"
          },
          "critical": {
            "description": "Ошибка критичная",
            "type": "boolean"
          }
        }
      }
    }
  }
}

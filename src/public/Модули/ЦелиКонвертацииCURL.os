#Область ПрограммныйИнтерфейс

// Возвращает идентификатор генератора платформенного HTTP.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора платформенного HTTP.
Функция ПлатформенныйHTTP() Экспорт

	Возврат "1c";

КонецФункции

// Возвращает идентификатор генератора для библиотеки Connector.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора для библиотеки Connector.
Функция КоннекторHTTP() Экспорт

	Возврат "connector";

КонецФункции

#КонецОбласти

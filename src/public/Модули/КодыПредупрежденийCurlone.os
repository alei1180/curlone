#Область ПрограммныйИнтерфейс

// Возвращает стабильный код предупреждения о неподдерживаемой возможности генератора.
//
// Возвращаемое значение:
//   Строка - Код предупреждения.
Функция НеподдерживаемаяВозможность() Экспорт

	Возврат "curlone.generator.unsupported_capability";

КонецФункции

// Возвращает стабильный код предупреждения об проигнорированной опции.
//
// Возвращаемое значение:
//   Строка - Код предупреждения.
Функция ОпцияПроигнорирована() Экспорт

	Возврат "curlone.generator.option_ignored";

КонецФункции

// Возвращает стабильный код предупреждения о преобразовании с потерями.
//
// Возвращаемое значение:
//   Строка - Код предупреждения.
Функция ПреобразованиеСПотерями() Экспорт

	Возврат "curlone.generator.lossy_conversion";

КонецФункции

#КонецОбласти

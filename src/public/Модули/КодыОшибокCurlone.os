КонецФункции

// Возвращает стабильный код ошибки позиционной опции без соответствующего URL.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НесопоставленнаяОпцияURL() Экспорт

	Возврат "curlone.command.unmatched_per_url_option";

КонецФункции

// Возвращает стабильный код ошибки конфликта режима запроса.
//

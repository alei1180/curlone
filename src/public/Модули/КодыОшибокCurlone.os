КонецФункции

// Возвращает стабильный код ошибки недопустимого URL.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НедопустимыйURL() Экспорт

	Возврат "curlone.command.invalid_url";

КонецФункции

// Возвращает стабильный код ошибки недопустимого значения опции.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НедопустимоеЗначениеОпции() Экспорт


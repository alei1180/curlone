#Область ПрограммныйИнтерфейс

// Возвращает стабильный код ошибки незакрытой кавычки в команде curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НезакрытаяКавычка() Экспорт

	Возврат "curlone.command.unclosed_quote";

КонецФункции

// Возвращает стабильный код ошибки отсутствующего URL в команде curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НеУказанURL() Экспорт

	Возврат "curlone.command.url_required";

КонецФункции

// Возвращает стабильный код ошибки конфликта тела запроса.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция КонфликтТелаЗапроса() Экспорт

	Возврат "curlone.command.conflicting_body";

КонецФункции

// Возвращает стабильный код ошибки неизвестного генератора.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НеизвестныйГенератор() Экспорт

	Возврат "curlone.generator.unknown";

КонецФункции

// Возвращает стабильный код ошибки выполнения генератора.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ОшибкаГенератора() Экспорт

	Возврат "curlone.generator.failed";

КонецФункции

// Возвращает стабильный код нарушения контракта генератора.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НарушенКонтрактГенератора() Экспорт

	Возврат "curlone.generator.contract_violated";

КонецФункции

// Возвращает стабильный код несовместимой версии контракта генератора.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НесовместимаяВерсияКонтрактаГенератора() Экспорт

	Возврат "curlone.generator.incompatible_contract";

КонецФункции

// Возвращает стабильный код ошибки отсутствия команды curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ТребуетсяCurl() Экспорт

	Возврат "curlone.command.curl_required";

КонецФункции

// Возвращает стабильный код ошибки неподдерживаемого синтаксиса командной оболочки.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НеподдерживаемыйСинтаксисОболочки() Экспорт

	Возврат "curlone.command.unsupported_shell_syntax";

КонецФункции

// Возвращает стабильный код ошибки неизвестной опции curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НеизвестнаяОпция() Экспорт

	Возврат "curlone.command.unknown_option";

КонецФункции

// Возвращает стабильный код ошибки отсутствующего значения опции curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ТребуетсяЗначениеОпции() Экспорт

	Возврат "curlone.command.option_value_required";

КонецФункции

// Возвращает стабильный код ошибки недопустимого значения опции curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция ЗначениеОпцииНеДопускается() Экспорт

	Возврат "curlone.command.option_value_not_allowed";

КонецФункции

// Возвращает стабильный код ошибки неподдерживаемой опции curl.
//
// Возвращаемое значение:
//   Строка - Код ошибки.
Функция НеподдерживаемаяОпция() Экспорт


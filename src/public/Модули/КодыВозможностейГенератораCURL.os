КонецФункции

Функция СоздатьПорядокИдентификаторов()

	Результат = Новый Массив(_ВсеИдентификаторы.Количество());
	Для Каждого Идентификатор Из _ВсеИдентификаторы Цикл
		Результат[Идентификатор.Значение] = Идентификатор.Ключ;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

#КонецОбласти

_ВсеИдентификаторы = СоздатьВсеИдентификаторы();
_ПорядокИдентификаторов = СоздатьПорядокИдентификаторов();

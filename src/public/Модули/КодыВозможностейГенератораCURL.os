// Проверяет принадлежность группе по точке с учётом регистра и непустым суффиксом.
//
// Параметры:
//   Код - Строка - Проверяемый код.
//   Группа - Строка - Имя группы без конечной точки.
//
// Возвращаемое значение:
//   Булево - Истина для вложенного кода; пустая группа и конечная точка дают Ложь.
//
// Исключения:
//   argument.invalid_type - Аргумент имеет неверный тип.
Функция ВходитВГруппу(Код, Группа) Экспорт

	ПроверкаАргументов.ПроверитьТип("Код", Код, "Строка");
	ПроверкаАргументов.ПроверитьТип("Группа", Группа, "Строка");
	Возврат ПринадлежитГруппе(Код, Группа);

КонецФункции

// Проверяет принадлежность к группе protocol.
//
// Параметры:
//   Код - Строка - Проверяемый код.
//
// Возвращаемое значение:
//   Булево - Признак принадлежности к группе.
//
// Исключения:
//   argument.invalid_type - Аргумент имеет неверный тип.
Функция ЭтоПротокол(Код) Экспорт

	ПроверкаАргументов.ПроверитьТип("Код", Код, "Строка");
	Возврат ПринадлежитГруппе(Код, "protocol");

КонецФункции

// Проверяет принадлежность к группе values.
//
// Параметры:
//   Код - Строка - Проверяемый код.
//
// Возвращаемое значение:
//   Булево - Признак принадлежности к группе.
//
// Исключения:
//   argument.invalid_type - Аргумент имеет неверный тип.
Функция ЭтоВычисляемоеЗначение(Код) Экспорт

	ПроверкаАргументов.ПроверитьТип("Код", Код, "Строка");
	Возврат ПринадлежитГруппе(Код, "values");

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает служебное требование вычисляемого протокола, не объявляемое генератором.
//
// Возвращаемое значение:
//   Строка - Код требования, отсутствующий в каталоге возможностей.
Функция ВычисляемыйПротокол() Экспорт

	Возврат "protocol.dynamic";

КонецФункции


Функция ПринадлежитГруппе(Код, Группа)

	Если Группа = "" Или Прав(Группа, 1) = "." Тогда
		Возврат Ложь;
	КонецЕсли;

	Префикс = Группа + ".";
	Возврат СтрДлина(Код) > СтрДлина(Префикс) И СтрНачинаетсяС(Код, Префикс);

КонецФункции

Функция СоздатьВсеИдентификаторы()

	Результат = Новый Соответствие;
	Результат.Вставить(ПротоколHTTP(), 0);
	Результат.Вставить(ПротоколHTTPS(), 1);
	Результат.Вставить(ПротоколFTP(), 2);
	Результат.Вставить(ПротоколFTPS(), 3);

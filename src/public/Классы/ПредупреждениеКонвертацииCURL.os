#Использовать errors

Перем _Код; // Строка
Перем _Сообщение; // Строка
Перем _ИдентификаторВозможности; // Строка
Перем _ИсходнаяОпция; // Строка
Перем _Позиция; // Число
Перем _ИдентификаторГенератора; // Строка

#Область ОбработчикиСобытий

// Создаёт предупреждение конвертации команды curl.
//
// Параметры:
//   Код - Строка - Машинный код предупреждения.
//   Сообщение - Строка - Текст предупреждения.
//   ИдентификаторВозможности - Строка - Идентификатор возможности генератора.
//   ИсходнаяОпция - Строка - Исходная опция команды curl.
//   Позиция - Число - Позиция исходной опции в команде.
//   ИдентификаторГенератора - Строка - Идентификатор целевого генератора.
//
// Исключения:
//   Если обязательный аргумент не заполнен или любой аргумент имеет неверный тип.
Процедура ПриСозданииОбъекта(
	Код,
	Сообщение,
	ИдентификаторВозможности = "",
	ИсходнаяОпция = "",
	Позиция = -1,
	ИдентификаторГенератора = ""
)

	ПроверкаАргументов.ПроверитьТип("Код", Код, "Строка");
	ПроверкаАргументов.ПроверитьЗаполненность("Код", Код);
	ПроверкаАргументов.ПроверитьТип("Сообщение", Сообщение, "Строка");
	ПроверкаАргументов.ПроверитьЗаполненность("Сообщение", Сообщение);
	ПроверкаАргументов.ПроверитьТип("ИдентификаторВозможности", ИдентификаторВозможности, "Строка");
	ПроверкаАргументов.ПроверитьТип("ИсходнаяОпция", ИсходнаяОпция, "Строка");
	ПроверкаАргументов.ПроверитьТип("Позиция", Позиция, "Число");
	ПроверкаАргументов.ПроверитьТип("ИдентификаторГенератора", ИдентификаторГенератора, "Строка");

	_Код = Код;
	_Сообщение = Сообщение;
	_ИдентификаторВозможности = ИдентификаторВозможности;
	_ИсходнаяОпция = ИсходнаяОпция;
	_Позиция = Позиция;
	_ИдентификаторГенератора = ИдентификаторГенератора;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает машинный код предупреждения.
//
// Возвращаемое значение:
//   Строка - Машинный код предупреждения.
Функция Код() Экспорт

	Возврат _Код;

КонецФункции

// Возвращает текст предупреждения.
//
// Возвращаемое значение:
//   Строка - Текст предупреждения.
Функция Сообщение() Экспорт

	Возврат _Сообщение;

КонецФункции

// Возвращает идентификатор возможности генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор возможности или пустая строка.
Функция ИдентификаторВозможности() Экспорт

	Возврат _ИдентификаторВозможности;

КонецФункции

// Возвращает исходную опцию команды curl.
//
// Возвращаемое значение:
//   Строка - Исходная опция или пустая строка.
Функция ИсходнаяОпция() Экспорт

	Возврат _ИсходнаяОпция;

КонецФункции

// Возвращает позицию исходной опции в команде.
//
// Возвращаемое значение:
//   Число - Позиция исходной опции или -1.
Функция Позиция() Экспорт

	Возврат _Позиция;

КонецФункции

// Возвращает идентификатор целевого генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора или пустая строка.
Функция ИдентификаторГенератора() Экспорт

	Возврат _ИдентификаторГенератора;

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать "../../shared"

Перем _Записи; // Соответствие из ФиксированнаяСтруктура - Изменяемое хранилище записей.

#Область ОбработчикиСобытий

// Создаёт пустой реестр генераторов.
Процедура ПриСозданииОбъекта()
	_Записи = Новый Соответствие;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует генератор после полной проверки SPI и метаданных.
//
// Параметры:
//   Генератор - Произвольный - Объект, реализующий SPI генератора CURL.
Процедура Зарегистрировать(Генератор) Экспорт

	ПроверитьИнтерфейс(Генератор);

	Попытка
		Идентификатор = Генератор.Идентификатор();
		Наименование = Генератор.Наименование();
		ВерсияКонтракта = Генератор.ВерсияКонтракта();
		Возможности = Генератор.Возможности();
	Исключение
		ВызватьОшибкаКонтракта("Не удалось прочитать метаданные генератора");
	КонецПопытки;

	ПроверитьМетаданные(Идентификатор, Наименование, ВерсияКонтракта, Возможности);

	Если _Записи.Получить(Идентификатор) <> Неопределено Тогда
		ВызватьОшибкаКонтракта("Идентификатор генератора уже зарегистрирован");
	КонецЕсли;

	КопияВозможностей = КоллекцииМоделиCURL.Скопировать(Возможности);
	СнимокВозможностей = Новый ФиксированныйМассив(КопияВозможностей);

	Описание = Новый ОписаниеГенератораCURL(
		Идентификатор,
		Наименование,
		ВерсияКонтракта,
		СнимокВозможностей
	);

	Запись = Новый ФиксированнаяСтруктура("Описание, Генератор", Описание, Генератор);
	_Записи.Вставить(Идентификатор, Запись);

КонецПроцедуры

// Возвращает описания в порядке регистрации.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ОписаниеГенератораCURL - Описания генераторов.
Функция Описания() Экспорт

	Результат = Новый Массив;
	Для Каждого Элемент Из _Записи Цикл
		Результат.Добавить(Элемент.Значение.Описание);
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает неизменяемый снимок записей реестра для внутреннего сервиса.
//
// Возвращаемое значение:
//   ФиксированноеСоответствие - _Записи с полями Описание и Генератор.
Функция Снимок() Экспорт

	Копия = Новый Соответствие;
	Для Каждого Элемент Из _Записи Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Копия);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИнтерфейс(Генератор)

	Попытка
		Методы = Новый Рефлектор().ПолучитьТаблицуМетодов(Генератор);
	Исключение
		ВызватьОшибкаКонтракта("Передан объект недопустимого вида");
	КонецПопытки;

	ПроверитьМетод(Методы, "Идентификатор", 0);
	ПроверитьМетод(Методы, "Наименование", 0);
	ПроверитьМетод(Методы, "ВерсияКонтракта", 0);
	ПроверитьМетод(Методы, "Возможности", 0);
	ПроверитьМетод(Методы, "Сгенерировать", 1);

КонецПроцедуры

Процедура ПроверитьМетод(Методы, Имя, КоличествоПараметров)

	Метод = Неопределено;
	ИмяБезУчетаРегистра = НРег(Имя);

	Для Каждого Кандидат Из Методы Цикл
		Если НРег(Кандидат.Имя) = ИмяБезУчетаРегистра Тогда
			Метод = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Метод = Неопределено Тогда
		ВызватьОшибкаКонтракта("Отсутствует обязательная функция " + Имя);
	КонецЕсли;

	Если Не Метод.Экспорт Или Не Метод.ЭтоФункция Или Метод.КоличествоПараметров <> КоличествоПараметров Тогда
		ВызватьОшибкаКонтракта("Неверная форма функции " + Имя);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМетаданные(Идентификатор, Наименование, ВерсияКонтракта, Возможности)

	Если ТипЗнч(ВерсияКонтракта) <> Тип("Число") Тогда
		ВызватьОшибкаКонтракта("Версия контракта генератора должна быть числом");
	КонецЕсли;

	Если ВерсияКонтракта <> ВерсииКонтрактаГенератораCURL.Актуальная() Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыОшибокCurlone.НесовместимаяВерсияКонтрактаГенератора(),
			"Версия контракта генератора не поддерживается"
		);
	КонецЕсли;

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Идентификатор))
		Или Идентификатор <> СокрЛП(Идентификатор) Тогда
		ВызватьОшибкаКонтракта("Идентификатор генератора недопустим");
	КонецЕсли;

	Если ТипЗнч(Наименование) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Наименование)) Тогда
		ВызватьОшибкаКонтракта("Наименование генератора недопустимо");
	КонецЕсли;

	Если ТипЗнч(Возможности) <> Тип("ФиксированныйМассив") Тогда
		ВызватьОшибкаКонтракта("Список возможностей должен быть фиксированным массивом");
	КонецЕсли;

	Уникальные = Новый Соответствие;
	КодыВозможностей = КодыВозможностейГенератораCURL;

	Для Каждого Возможность Из Возможности Цикл
		Если ТипЗнч(Возможность) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Возможность))
			Или Не КодыВозможностей.Содержит(Возможность) Или Уникальные.Получить(Возможность) <> Неопределено Тогда
			ВызватьОшибкаКонтракта("Список возможностей генератора недопустим");
		КонецЕсли;
		
		Уникальные.Вставить(Возможность, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ВызватьОшибкаКонтракта(Сообщение)
	ВызватьИсключение ФабрикаОшибок.Создать(КодыОшибокCurlone.НарушенКонтрактГенератора(), Сообщение);
КонецПроцедуры

#КонецОбласти

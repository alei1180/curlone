#Использовать errors
#Использовать "../../shared"

Перем _Код; // Строка
Перем _Ошибки; // Массив из ИнформацияОбОшибке
Перем _Предупреждения; // Массив из ПредупреждениеКонвертацииCURL
Перем _ИдентификаторГенератора; // Строка

#Область ОбработчикиСобытий

// Создаёт результат конвертации команды curl.
//
// Параметры:
//   Код - Строка - Сформированный программный код или пустая строка.
//   Ошибки - Массив из ИнформацияОбОшибке,
//             ФиксированныйМассив из ИнформацияОбОшибке,
//             Неопределено - Ошибки конвертации.
//   Предупреждения - Массив из ПредупреждениеКонвертацииCURL,
//                    ФиксированныйМассив из ПредупреждениеКонвертацииCURL,
//                    Неопределено - Предупреждения конвертации.
//   ИдентификаторГенератора - Строка - Идентификатор использованного генератора.
//
// Исключения:
//   argument.invalid_type - Аргумент или элемент коллекции имеет неверный тип.
Процедура ПриСозданииОбъекта(
	Код = "",
	Ошибки = Неопределено,
	Предупреждения = Неопределено,
	ИдентификаторГенератора = ""
)

	ПроверкаАргументов.ПроверитьТип("Код", Код, "Строка");
	ПроверкаАргументов.ПроверитьТип("ИдентификаторГенератора", ИдентификаторГенератора, "Строка");

	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Массив;
	КонецЕсли;

	Если Предупреждения = Неопределено Тогда
		Предупреждения = Новый Массив;
	КонецЕсли;

	_Код = Код;

	_Ошибки = СкопироватьКоллекциюСПроверкой(
		Ошибки,
		"Ошибки",
		"ИнформацияОбОшибке"
	);

	_Предупреждения = СкопироватьКоллекциюСПроверкой(
		Предупреждения,
		"Предупреждения",
		"ПредупреждениеКонвертацииCURL"
	);

	_ИдентификаторГенератора = ИдентификаторГенератора;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет успешность конвертации.
//
// Возвращаемое значение:
//   Булево - Истина, если код сформирован и ошибки отсутствуют.
Функция Успешно() Экспорт

	Возврат СтрДлина(_Код) > 0 И _Ошибки.Количество() = 0;

КонецФункции

// Возвращает сформированный программный код.
//
// Возвращаемое значение:
//   Строка - Сформированный код или пустая строка.
Функция Код() Экспорт

	Возврат _Код;

КонецФункции

// Возвращает копию ошибок конвертации.
//
// Возвращаемое значение:
//   Массив из ИнформацияОбОшибке - Ошибки конвертации.
Функция Ошибки() Экспорт

	Возврат КоллекцииМоделиCURL.Скопировать(_Ошибки);

КонецФункции

// Возвращает копию предупреждений конвертации.
//
// Возвращаемое значение:
//   Массив из ПредупреждениеКонвертацииCURL - Предупреждения конвертации.
Функция Предупреждения() Экспорт

	Возврат КоллекцииМоделиCURL.Скопировать(_Предупреждения);

КонецФункции

// Возвращает безопасное упорядоченное представление ошибок и предупреждений.
//
// Возвращаемое значение:
//   Массив из Структура - Диагностика: сначала ошибки, затем предупреждения:
//     * Вид - Строка - Вид элемента: `Ошибка` или `Предупреждение`.
//     * Код - Строка - Машинный код ошибки или предупреждения.
//     * Сообщение - Строка - Безопасное пользовательское сообщение.
//     * ИдентификаторВозможности - Строка, Неопределено - Идентификатор возможности генератора.
//     * ИсходнаяОпция - Строка, Неопределено - Исходная опция команды curl.
//     * Позиция - Число, Неопределено - Позиция исходной опции.
//     * ИдентификаторГенератора - Строка, Неопределено - Идентификатор генератора.
Функция Диагностика() Экспорт

	Результат = Новый Массив;
	Для Каждого Ошибка Из _Ошибки Цикл
		Результат.Добавить(ДиагностикаОшибки(Ошибка));
	КонецЦикла;

	Для Каждого Предупреждение Из _Предупреждения Цикл
		Результат.Добавить(ДиагностикаПредупреждения(Предупреждение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает идентификатор использованного генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора или пустая строка.
Функция ИдентификаторГенератора() Экспорт

	Возврат _ИдентификаторГенератора;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьКоллекциюСПроверкой(Коллекция, ИмяАргумента, ТипЭлемента)

	ПроверкаАргументов.ПроверитьТип(
		ИмяАргумента,
		Коллекция,
		"Массив,ФиксированныйМассив"
	);

	Копия = Новый Массив;
	Индекс = 0;
	Для Каждого Элемент Из Коллекция Цикл
		ПроверкаАргументов.ПроверитьТип(
			СтрШаблон("%1[%2]", ИмяАргумента, Индекс),
			Элемент,
			ТипЭлемента
		);
		Копия.Добавить(Элемент);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Копия;

КонецФункции

Функция ДиагностикаОшибки(Ошибка)

	Код = ДиагностикаОшибок.КодОшибки(Ошибка);
	Кадр = ДиагностикаОшибок.НайтиПервую(Ошибка, Код);
	Сообщение = ?(
		Кадр = Неопределено,
		ДиагностикаОшибок.КраткоеПредставление(Ошибка),
		Кадр.Сообщение()
	);

	Возврат Новый Структура(
		"Вид, Код, Сообщение, ИдентификаторВозможности, ИсходнаяОпция, Позиция, ИдентификаторГенератора",
		"Ошибка",
		Код,
		Сообщение,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено
	);

КонецФункции

Функция ДиагностикаПредупреждения(Предупреждение)

	Возврат Новый Структура(
		"Вид, Код, Сообщение, ИдентификаторВозможности, ИсходнаяОпция, Позиция, ИдентификаторГенератора",
		"Предупреждение",
		Предупреждение.Код(),
		Предупреждение.Сообщение(),
		Предупреждение.ИдентификаторВозможности(),
		Предупреждение.ИсходнаяОпция(),
		Предупреждение.Позиция(),
		Предупреждение.ИдентификаторГенератора()
	);

КонецФункции

#КонецОбласти

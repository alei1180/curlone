#Использовать "../../shared"

Перем _Операции; // ФиксированныйМассив из ОперацияПередачиCURL
Перем _Локаль; // Строка
Перем _ПараметрыГенератора; // ФиксированноеСоответствие из КлючИЗначение
Перем _ИдентификаторГенератора; // Строка
Перем _ВозможностиГенератора; // ФиксированныйМассив из Строка
Перем _ФорматДесериализацииОтвета; // Строка, Неопределено

#Область ОбработчикиСобытий

// Создаёт контекст генерации программного кода.
//
// Параметры:
//   Операции - Массив, ФиксированныйМассив из ОперацияПередачиCURL - Неизменяемые модели операций.
//   Локаль - Строка - Код локали генерируемого программного кода.
//                     Поддерживаемые локали см. в модуле ЛокалиКонвертацииCURL.
//   ПараметрыГенератора - Соответствие из КлючИЗначение,
//                         ФиксированноеСоответствие из КлючИЗначение - Параметры генератора:
//     * Ключ - Строка - Ключ параметра генератора.
//     * Значение - Произвольный - Значение параметра генератора.
//   ИдентификаторГенератора - Строка - Идентификатор целевого генератора.
//   ВозможностиГенератора - ФиксированныйМассив из Строка - Уникальные возможности из каталога.
//   ФорматДесериализацииОтвета - Строка, Неопределено - Формат десериализации тела HTTP-ответа.
//
// Исключения:
//   argument.invalid_type - Формат десериализации ответа имеет неверный тип.
//   argument.invalid_value - Переданы неизвестный формат или возможности генератора.
Процедура ПриСозданииОбъекта(
	Операции,
	Локаль,
	ПараметрыГенератора,
	ИдентификаторГенератора,
	ВозможностиГенератора,
	ФорматДесериализацииОтвета = Неопределено
)

	ПроверитьФорматДесериализацииОтвета(ФорматДесериализацииОтвета);

	КодыВозможностей = КодыВозможностейГенератораCURL;
	КопияВозможностей = Новый Массив;

	Для Каждого Возможность Из ВозможностиГенератора Цикл
		Если Не КодыВозможностей.Содержит(Возможность) Или КопияВозможностей.Найти(Возможность) <> Неопределено Тогда
			ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
				"ВозможностиГенератора",
				"Уникальные возможности из каталога"
			);
		КонецЕсли;

		КопияВозможностей.Добавить(Возможность);
	КонецЦикла;

	КопияОпераций = КоллекцииМоделиCURL.Скопировать(Операции);
	КопияПараметров = КоллекцииМоделиCURL.Скопировать(ПараметрыГенератора);

	_Операции = Новый ФиксированныйМассив(КопияОпераций);
	_ВозможностиГенератора = Новый ФиксированныйМассив(КопияВозможностей);
	_Локаль = Локаль;
	_ПараметрыГенератора = Новый ФиксированноеСоответствие(КопияПараметров);
	_ИдентификаторГенератора = ИдентификаторГенератора;
	_ФорматДесериализацииОтвета = ФорматДесериализацииОтвета;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает независимый неизменяемый список моделей операций.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ОперацияПередачиCURL - Модели нормализованных операций.
Функция Операции() Экспорт

	Возврат _Операции;

КонецФункции

// Возвращает код локали генерируемого программного кода.
//
// Возвращаемое значение:
//   Строка - Код локали. Поддерживаемые значения см. в модуле ЛокалиКонвертацииCURL.
Функция Локаль() Экспорт

	Возврат _Локаль;

КонецФункции

// Возвращает независимый неизменяемый набор параметров генератора.
//
// Возвращаемое значение:
//   ФиксированноеСоответствие из КлючИЗначение - Параметры генератора:
//     * Ключ - Строка - Ключ параметра генератора.
//     * Значение - Произвольный - Значение параметра генератора.
Функция ПараметрыГенератора() Экспорт

	Возврат _ПараметрыГенератора;

КонецФункции

// Возвращает формат десериализации тела HTTP-ответа.
//
// Возвращаемое значение:
//   Строка, Неопределено - Формат из модуля ФорматыДесериализацииОтветаCURL
//                          или Неопределено, если десериализация не требуется.
Функция ФорматДесериализацииОтвета() Экспорт

	Возврат _ФорматДесериализацииОтвета;

КонецФункции

// Возвращает идентификатор целевого генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора.
Функция ИдентификаторГенератора() Экспорт

	Возврат _ИдентификаторГенератора;

КонецФункции

// Возвращает зарегистрированные возможности, использованные при анализе команды.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Неизменяемый независимый набор возможностей.
Функция ВозможностиГенератора() Экспорт

	Возврат _ВозможностиГенератора;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьФорматДесериализацииОтвета(Формат)

	Если Формат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Формат) <> Тип("Строка") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"ФорматДесериализацииОтвета",
			"Строка,Неопределено",
			Формат
		);
	КонецЕсли;

	Если Формат <> ФорматыДесериализацииОтветаCURL.JSON() Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"ФорматДесериализацииОтвета",
			ФорматыДесериализацииОтветаCURL.JSON()
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Использовать errors

Перем _Операции; // ФиксированныйМассив из Произвольный
Перем _Локаль; // Строка
Перем _ПараметрыГенератора; // ФиксированноеСоответствие из КлючИЗначение
Перем _ИдентификаторГенератора; // Строка

#Область ОбработчикиСобытий

// Создаёт неизменяемый контекст генерации программного кода.
//
// Параметры:
//   Операции - Массив из Произвольный,
//              ФиксированныйМассив из Произвольный - Снимки нормализованных операций.
//   Локаль - Строка - Код локали генерируемого программного кода.
//                     Поддерживаемые локали см. в модуле ЛокалиКонвертацииCURL.
//   ПараметрыГенератора - Соответствие из КлючИЗначение,
//                         ФиксированноеСоответствие из КлючИЗначение - Параметры генератора:
//     * Ключ - Произвольный - Ключ параметра генератора.
//     * Значение - Произвольный - Значение параметра генератора.
//   ИдентификаторГенератора - Строка - Идентификатор целевого генератора.
//
// Исключения:
//   argument.invalid_type - Аргумент имеет неверный тип.
Процедура ПриСозданииОбъекта(
	Операции,
	Локаль,
	ПараметрыГенератора,
	ИдентификаторГенератора
)

	ПроверкаАргументов.ПроверитьТип(
		"Операции",
		Операции,
		"Массив,ФиксированныйМассив"
	);
	ПроверкаАргументов.ПроверитьТип("Локаль", Локаль, "Строка");
	ПроверкаАргументов.ПроверитьТип(
		"ПараметрыГенератора",
		ПараметрыГенератора,
		"Соответствие,ФиксированноеСоответствие"
	);
	ПроверкаАргументов.ПроверитьТип(
		"ИдентификаторГенератора",
		ИдентификаторГенератора,
		"Строка"
	);

	_Операции = ГлубокоЗафиксировать(Операции);
	_Локаль = Локаль;
	_ПараметрыГенератора = ГлубокоЗафиксировать(ПараметрыГенератора);
	_ИдентификаторГенератора = ИдентификаторГенератора;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает неизменяемые снимки нормализованных операций.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Произвольный - Снимки нормализованных операций.
Функция Операции() Экспорт

	Возврат _Операции;

КонецФункции

// Возвращает код локали генерируемого программного кода.
//
// Возвращаемое значение:
//   Строка - Код локали. Поддерживаемые значения см. в модуле ЛокалиКонвертацииCURL.
Функция Локаль() Экспорт

	Возврат _Локаль;

КонецФункции

// Возвращает неизменяемые параметры генератора.
//
// Возвращаемое значение:
//   ФиксированноеСоответствие из КлючИЗначение - Параметры генератора:
//     * Ключ - Произвольный - Ключ параметра генератора.
//     * Значение - Произвольный - Значение параметра генератора.
Функция ПараметрыГенератора() Экспорт

	Возврат _ПараметрыГенератора;

КонецФункции

// Возвращает идентификатор целевого генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора.
Функция ИдентификаторГенератора() Экспорт

	Возврат _ИдентификаторГенератора;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ГлубокоЗафиксировать(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат ГлубокоЗафиксироватьМассив(Значение);
	ИначеЕсли ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Возврат ГлубокоЗафиксироватьСтруктуру(Значение);
	ИначеЕсли ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат ГлубокоЗафиксироватьСоответствие(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ГлубокоЗафиксироватьМассив(ИсходныйМассив)

	Копия = Новый Массив;
	Для Каждого Элемент Из ИсходныйМассив Цикл
		Копия.Добавить(ГлубокоЗафиксировать(Элемент));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Копия);

КонецФункции

Функция ГлубокоЗафиксироватьСтруктуру(ИсходнаяСтруктура)

	Копия = Новый Структура;
	Для Каждого Элемент Из ИсходнаяСтруктура Цикл
		Копия.Вставить(Элемент.Ключ, ГлубокоЗафиксировать(Элемент.Значение));
	КонецЦикла;

	Возврат Новый ФиксированнаяСтруктура(Копия);

КонецФункции

Функция ГлубокоЗафиксироватьСоответствие(ИсходноеСоответствие)

	Копия = Новый Соответствие;
	Для Каждого Элемент Из ИсходноеСоответствие Цикл
		Копия.Вставить(
			ГлубокоЗафиксировать(Элемент.Ключ),
			ГлубокоЗафиксировать(Элемент.Значение)
		);
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Копия);

КонецФункции

#КонецОбласти

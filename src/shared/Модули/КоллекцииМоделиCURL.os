#Область СлужебныйПрограммныйИнтерфейс

// Создаёт изменяемую копию коллекции, сохраняя порядок и ссылки на элементы или значения.
// Контейнер и элементы должны быть проверены вызывающим этапом конвейера.
//
// Параметры:
//   Источник - Массив, ФиксированныйМассив,
//              Соответствие, ФиксированноеСоответствие,
//              Структура, ФиксированнаяСтруктура - Исходная коллекция.
//
// Возвращаемое значение:
//   Массив, Соответствие, Структура - Новая изменяемая коллекция того же вида.
Функция Скопировать(Источник) Экспорт

	Если ТипЗнч(Источник) = Тип("Массив")
		Или ТипЗнч(Источник) = Тип("ФиксированныйМассив") Тогда
		Возврат СкопироватьМассив(Источник);
	КонецЕсли;

	Возврат СкопироватьСоответствиеИлиСтруктуру(Источник);

КонецФункции

// Дополняет приемник элементами из источника
//
// Параметры:
//   Приемник - Массив - Коллекция, в которую добавляются элементы
//   Источник - Массив - Коллекция, элементы которого копируются
Процедура Дополнить(Приемник, Источник) Экспорт

	Для Каждого Значение Из Источник Цикл
		Приемник.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьМассив(Источник)

	Копия = Новый Массив;

	Для Каждого Элемент Из Источник Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;

	Возврат Копия;

КонецФункции

Функция СкопироватьСоответствиеИлиСтруктуру(Источник)

	ЭтоСтруктура = ТипЗнч(Источник) = Тип("Структура")
		Или ТипЗнч(Источник) = Тип("ФиксированнаяСтруктура");
	Копия = ?(ЭтоСтруктура, Новый Структура, Новый Соответствие);

	Для Каждого Элемент Из Источник Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Копия;

КонецФункции

#КонецОбласти

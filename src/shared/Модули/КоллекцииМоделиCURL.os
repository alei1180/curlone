#Область СлужебныйПрограммныйИнтерфейс

// Создаёт изменяемую копию коллекции, сохраняя порядок и ссылки на элементы.
// Контейнер и элементы должны быть проверены вызывающим этапом конвейера.
//
// Параметры:
//   Источник - Массив, ФиксированныйМассив - Исходная коллекция.
//
// Возвращаемое значение:
//   Массив - Новая изменяемая коллекция.
Функция Скопировать(Источник) Экспорт

	Копия = Новый Массив;
	Для Каждого Элемент Из Источник Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;

	Возврат Копия;

КонецФункции

// Дополняет приемник элементами из источника
//
// Параметры:
//   Приемник - Массив - Коллекция, в которую добавляются элементы
//   Источник - Массив - Коллекция, элементы которого копируются
Процедура Дополнить(Приемник, Источник) Экспорт

	Для Каждого Значение Из Источник Цикл
		Приемник.Добавить(Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

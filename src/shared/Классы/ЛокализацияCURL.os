#Использовать i18n

#Область ПрограммныйИнтерфейс

// Возвращает строку из пакета ресурсов curlone.
//
// Параметры:
//   ИмяПакета - Строка - Базовое имя пакета ресурсов.
//   Локаль - Строка - Код локализации.
//   Ключ - Строка - Ключ строки.
//
// Возвращаемое значение:
//   Строка - Локализованная строка.
//
// Исключения:
//   Исключение - Каталог или пакет ресурсов недоступен.
Функция ПолучитьСтроку(ИмяПакета, Локаль, Ключ) Экспорт

	Возврат ПолучитьПакет(ИмяПакета, Локаль).ПолучитьСтроку(Ключ);

КонецФункции

// Возвращает пакет ресурсов curlone.
//
// Параметры:
//   ИмяПакета - Строка - Базовое имя пакета ресурсов.
//   Локаль - Строка - Код локализации.
//
// Возвращаемое значение:
//   ПакетРесурсовЛокализации - Пакет ресурсов указанной локали.
//
// Исключения:
//   Исключение - Каталог или пакет ресурсов недоступен.
Функция ПолучитьПакет(ИмяПакета, Локаль) Экспорт

	Блокировка = Новый БлокировкаРесурса(МенеджерРесурсовЛокализации);
	Блокировка.Заблокировать();

	Попытка
		МенеджерРесурсовЛокализации.ДобавитьКаталог(КаталогРесурсов());
		Пакет = МенеджерРесурсовЛокализации.ПолучитьПакет(ИмяПакета, Локаль);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();
	Возврат Пакет;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КаталогРесурсов()

	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "../../locales");

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать "../../public"

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт структурированную ошибку разбора команды curl.
//
// Параметры:
//   Код - Строка - Код из модуля КодыОшибокCurlone.
//   Сообщение - Строка - Безопасное пользовательское сообщение.
//   Позиция - Число - Номер аргумента или -1.
//   ПозицияВИсходнойСтроке - Число - Номер символа или -1.
//   ПозицияВАргументе - Число - Номер символа внутри аргумента или -1.
//   ИсходноеПредставление - Строка - Исходный фрагмент или пустая строка.
//
// Возвращаемое значение:
//   ИнформацияОбОшибке - Ошибка с фиксированной структурой данных:
//     * Позиция - Число - Номер аргумента или -1.
//     * ПозицияВИсходнойСтроке - Число - Номер символа или -1.
//     * ПозицияВАргументе - Число - Номер символа внутри аргумента или -1.
//     * ИсходноеПредставление - Строка - Исходный фрагмент или пустая строка.
//
// Исключения:
//   argument.invalid_type - Код или сообщение имеют неверный тип.
//   argument.required - Код или сообщение не заполнены.
//   argument.invalid_value - Код ошибки имеет недопустимый формат.
Функция Создать(
	Код,
	Сообщение,
	Позиция,
	ПозицияВИсходнойСтроке,
	ПозицияВАргументе,
	ИсходноеПредставление
) Экспорт

	Данные = Новый Структура(
		"Позиция, ПозицияВИсходнойСтроке, ПозицияВАргументе, ИсходноеПредставление",
		Позиция,
		ПозицияВИсходнойСтроке,
		ПозицияВАргументе,
		ИсходноеПредставление
	);

	Возврат ФабрикаОшибок.Создать(Код, Сообщение, Новый ФиксированнаяСтруктура(Данные));

КонецФункции

#КонецОбласти

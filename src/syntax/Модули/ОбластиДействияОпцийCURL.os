#Область ПрограммныйИнтерфейс

// Возвращает глобальную область действия опции.
//
// Возвращаемое значение:
//   Строка - Область действия опции.
Функция Глобальная() Экспорт

	Возврат "global";

КонецФункции

// Возвращает локальную область действия опции.
//
// Возвращаемое значение:
//   Строка - Область действия опции.
Функция Локальная() Экспорт

	Возврат "local";

КонецФункции

#КонецОбласти

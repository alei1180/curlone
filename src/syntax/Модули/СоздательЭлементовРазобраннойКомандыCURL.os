#Область СлужебныйПрограммныйИнтерфейс

// Создаёт элемент опции.
//
// Параметры:
//   ОписаниеОпции - ОписаниеОпцииCURL - Метаданные опции.
//   УказанноеИмя - Строка - Имя с префиксом, указанное пользователем.
//   ОтрицательнаяФорма - Булево - Признак отрицательного псевдонима.
//   ТокенОпции - ТокенКомандыCURL - Токен имени.
//   ТокенЗначения - ТокенКомандыCURL, Неопределено - Токен значения.
//   ИсходныйТокен - ТокенКомандыCURL - Исходный токен аргумента.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Неизменяемый элемент опции.
Функция Опция(
	ОписаниеОпции,
	УказанноеИмя,
	ОтрицательнаяФорма,
	ТокенОпции,
	ТокенЗначения,
	ИсходныйТокен
) Экспорт

	Возврат Новый ЭлементРазобраннойКомандыCURL(
		ВидыЭлементовРазобраннойКомандыCURL.Опция(),
		ОписаниеОпции,
		УказанноеИмя,
		ОтрицательнаяФорма,
		ТокенОпции,
		ТокенЗначения,
		Неопределено,
		ИсходныйТокен
	);

КонецФункции

// Создаёт элемент URL.
//
// Параметры:
//   ТокенURL - ТокенКомандыCURL - Исходный токен URL.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Неизменяемый элемент URL.
Функция URL(ТокенURL) Экспорт

	Возврат Новый ЭлементРазобраннойКомандыCURL(
		ВидыЭлементовРазобраннойКомандыCURL.URL(),
		Неопределено,
		Неопределено,
		Ложь,
		Неопределено,
		Неопределено,
		ТокенURL,
		ТокенURL
	);

КонецФункции

// Создаёт границу группы команд.
//
// Параметры:
//   ОписаниеОпции - ОписаниеОпцииCURL - Метаданные управляющей опции.
//   УказанноеИмя - Строка - Имя с префиксом, указанное пользователем.
//   ТокенОпции - ТокенКомандыCURL - Токен имени управляющей опции.
//   ИсходныйТокен - ТокенКомандыCURL - Исходный токен аргумента.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Неизменяемая граница группы.
Функция ГраницаГруппы(ОписаниеОпции, УказанноеИмя, ТокенОпции, ИсходныйТокен) Экспорт

	Возврат Новый ЭлементРазобраннойКомандыCURL(
		ВидыЭлементовРазобраннойКомандыCURL.ГраницаГруппы(),
		ОписаниеОпции,
		УказанноеИмя,
		Ложь,
		ТокенОпции,
		Неопределено,
		Неопределено,
		ИсходныйТокен
	);

КонецФункции

#КонецОбласти

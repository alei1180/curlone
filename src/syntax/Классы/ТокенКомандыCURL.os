#Использовать "../../shared"
#Использовать errors

Перем _Значение; // Строка
Перем _ИсходноеПредставление; // Строка
Перем _Фрагменты; // ФиксированныйМассив из ФиксированнаяСтруктура
Перем _Позиция; // Число
Перем _ПозицияВИсходнойСтроке; // Число
Перем _ПозицияВАргументе; // Число
Перем _КартаИсходныхПозиций; // ФиксированныйМассив из Число

#Область ОбработчикиСобытий

// Создаёт токен команды curl.
//
// Параметры:
//   Значение - Строка - Значение после обработки синтаксиса командной оболочки.
//   ИсходноеПредставление - Строка - Соответствующая часть исходной команды.
//   Фрагменты - Массив, ФиксированныйМассив из Структура, ФиксированнаяСтруктура - Части значения:
//     * Вид - Строка - Вид из модуля ВидыФрагментовТокенаCURL.
//     * Значение - Строка - Текст или имя переменной.
//     * ИсходноеПредставление - Строка - Исходная форма фрагмента.
//   Позиция - Число - Номер аргумента с единицы.
//   ПозицияВИсходнойСтроке - Число - Начальная позиция с единицы или -1.
//   ПозицияВАргументе - Число - Начальная позиция внутри аргумента с единицы.
//   КартаИсходныхПозиций - Массив, ФиксированныйМассив из Число - Для каждого символа значения позиция
//     соответствующего символа в исходном представлении.
Процедура ПриСозданииОбъекта(
	Значение,
	ИсходноеПредставление,
	Фрагменты,
	Позиция,
	ПозицияВИсходнойСтроке,
	ПозицияВАргументе,
	КартаИсходныхПозиций
)

	_Значение = Значение;
	_ИсходноеПредставление = ИсходноеПредставление;
	_Фрагменты = СкопироватьФрагменты(Фрагменты);
	_Позиция = Позиция;
	_ПозицияВИсходнойСтроке = ПозицияВИсходнойСтроке;
	_ПозицияВАргументе = ПозицияВАргументе;
	_КартаИсходныхПозиций = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(КартаИсходныхПозиций));

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает значение токена.
//
// Возвращаемое значение:
//   Строка - Значение токена.
Функция Значение() Экспорт

	Возврат _Значение;

КонецФункции

// Возвращает исходное представление токена.
//
// Возвращаемое значение:
//   Строка - Соответствующая часть исходной команды.
Функция ИсходноеПредставление() Экспорт

	Возврат _ИсходноеПредставление;

КонецФункции

// Возвращает неизменяемые фрагменты токена.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - Фрагменты токена:
//     * Вид - Строка - Вид из модуля ВидыФрагментовТокенаCURL.
//     * Значение - Строка - Текст или имя переменной.
//     * ИсходноеПредставление - Строка - Исходная форма фрагмента.
Функция Фрагменты() Экспорт

	Возврат _Фрагменты;

КонецФункции

// Возвращает номер аргумента.
//
// Возвращаемое значение:
//   Число - Номер аргумента с единицы.
Функция Позиция() Экспорт

	Возврат _Позиция;

КонецФункции

// Возвращает начальную позицию в исходной строке.
//
// Возвращаемое значение:
//   Число - Позиция с единицы или -1 для массива аргументов.
Функция ПозицияВИсходнойСтроке() Экспорт

	Возврат _ПозицияВИсходнойСтроке;

КонецФункции

// Возвращает начальную позицию внутри исходного аргумента.
//
// Возвращаемое значение:
//   Число - Позиция с единицы.
Функция ПозицияВАргументе() Экспорт

	Возврат _ПозицияВАргументе;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт токен для диапазона текущего значения.
//
// Параметры:
//   НачальнаяПозиция - Число - Начальная позиция в значении с единицы.
//   КоличествоСимволов - Число - Неотрицательная длина диапазона.
//
// Возвращаемое значение:
//   ТокенКомандыCURL - Новый неизменяемый токен диапазона.
//
// Исключения:
//   argument.invalid_value - Диапазон выходит за границы значения.
Функция СоздатьПроизводный(НачальнаяПозиция, КоличествоСимволов) Экспорт

	ДопустимыйДиапазон = НачальнаяПозиция >= 1
		И КоличествоСимволов >= 0
		И НачальнаяПозиция + КоличествоСимволов <= СтрДлина(_Значение) + 1;

	Если Не ДопустимыйДиапазон Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Диапазон",
			"Диапазон внутри значения токена"
		);
	КонецЕсли;

	Если КоличествоСимволов = 0 Тогда
		Возврат СоздатьПустойПроизводный(НачальнаяПозиция);
	КонецЕсли;

	НачалоВИсходном = _КартаИсходныхПозиций[НачальнаяПозиция - 1];
	КонецВИсходном = _КартаИсходныхПозиций[НачальнаяПозиция + КоличествоСимволов - 2];
	ИсходноеПредставление = Сред(
		_ИсходноеПредставление,
		НачалоВИсходном,
		КонецВИсходном - НачалоВИсходном + 1
	);

	Возврат Новый ТокенКомандыCURL(
		Сред(_Значение, НачальнаяПозиция, КоличествоСимволов),
		ИсходноеПредставление,
		ФрагментыДиапазона(НачальнаяПозиция, КоличествоСимволов),
		_Позиция,
		НоваяПозицияВИсходнойСтроке(НачалоВИсходном),
		_ПозицияВАргументе + НачалоВИсходном - 1,
		КартаДиапазона(НачальнаяПозиция, КоличествоСимволов, НачалоВИсходном)
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьФрагменты(Фрагменты)

	Копия = Новый Массив;
	Для Каждого Фрагмент Из Фрагменты Цикл
		Копия.Добавить(Новый ФиксированнаяСтруктура(Фрагмент));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Копия);

КонецФункции

Функция СоздатьПустойПроизводный(НачальнаяПозиция)

	НачалоВИсходном = ?(
		НачальнаяПозиция <= _КартаИсходныхПозиций.Количество(),
		_КартаИсходныхПозиций[НачальнаяПозиция - 1],
		СтрДлина(_ИсходноеПредставление) + 1
	);

	Фрагменты = Новый Массив;
	Фрагменты.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Текст(),
		"",
		""
	));

	Возврат Новый ТокенКомандыCURL(
		"",
		"",
		Фрагменты,
		_Позиция,
		НоваяПозицияВИсходнойСтроке(НачалоВИсходном),
		_ПозицияВАргументе + НачалоВИсходном - 1,
		Новый Массив
	);

КонецФункции

Функция НоваяПозицияВИсходнойСтроке(НачалоВИсходном)

	Если _ПозицияВИсходнойСтроке = -1 Тогда
		Возврат -1;
	КонецЕсли;

	Возврат _ПозицияВИсходнойСтроке + НачалоВИсходном - 1;

КонецФункции

Функция КартаДиапазона(НачальнаяПозиция, КоличествоСимволов, НачалоВИсходном)

	Карта = Новый Массив;
	Для Смещение = 0 По КоличествоСимволов - 1 Цикл
		Карта.Добавить(_КартаИсходныхПозиций[НачальнаяПозиция + Смещение - 1] - НачалоВИсходном + 1);
	КонецЦикла;

	Возврат Карта;

КонецФункции

Функция ФрагментыДиапазона(НачальнаяПозиция, КоличествоСимволов)

	КонецДиапазона = НачальнаяПозиция + КоличествоСимволов - 1;
	ТекущаяПозиция = 1;
	Результат = Новый Массив;

	Для Каждого Фрагмент Из _Фрагменты Цикл
		Представление = ПредставлениеФрагментаВЗначении(Фрагмент);
		КонецФрагмента = ТекущаяПозиция + СтрДлина(Представление) - 1;
		НачалоПересечения = Макс(НачальнаяПозиция, ТекущаяПозиция);
		КонецПересечения = Мин(КонецДиапазона, КонецФрагмента);

		Если НачалоПересечения <= КонецПересечения Тогда
			ДобавитьФрагментДиапазона(
				Результат,
				Фрагмент,
				НачалоПересечения,
				КонецПересечения,
				ТекущаяПозиция
			);
		КонецЕсли;

		ТекущаяПозиция = КонецФрагмента + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьФрагментДиапазона(
	Результат,
	Фрагмент,
	НачалоПересечения,
	КонецПересечения,
	НачалоФрагмента
)

	Количество = КонецПересечения - НачалоПересечения + 1;
	ПолноеПересечение = НачалоПересечения = НачалоФрагмента
		И Количество = СтрДлина(ПредставлениеФрагментаВЗначении(Фрагмент));
	Вид = ?(ПолноеПересечение, Фрагмент.Вид, ВидыФрагментовТокенаCURL.Текст());
	Значение = ?(
		Вид = ВидыФрагментовТокенаCURL.Переменная(),
		Фрагмент.Значение,
		Сред(_Значение, НачалоПересечения, Количество)
	);
	НачалоИсходного = _КартаИсходныхПозиций[НачалоПересечения - 1];
	КонецИсходного = _КартаИсходныхПозиций[КонецПересечения - 1];
	ИсходноеПредставление = Сред(
		_ИсходноеПредставление,
		НачалоИсходного,
		КонецИсходного - НачалоИсходного + 1
	);
	Результат.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		Вид,
		Значение,
		ИсходноеПредставление
	));

КонецПроцедуры

Функция ПредставлениеФрагментаВЗначении(Фрагмент)

	Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Переменная() Тогда
		Возврат Фрагмент.ИсходноеПредставление;
	КонецЕсли;

	Возврат Фрагмент.Значение;

КонецФункции

#КонецОбласти

#Использовать errors

#Область ПрограммныйИнтерфейс

// Преобразует готовые аргументы командной оболочки в токены curl.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Готовые аргументы без дополнительного разбора.
//
// Возвращаемое значение:
//   РезультатЛексическогоРазбораCURL - Успешный результат с токенами.
//
// Исключения:
//   argument.invalid_type - Коллекция аргументов или её элемент имеют неверный тип.
Функция Адаптировать(Аргументы) Экспорт

	ПроверкаАргументов.ПроверитьТип("Аргументы", Аргументы, "Массив,ФиксированныйМассив");

	РезультирующиеТокены = Новый Массив;
	Позиция = 1;

	Для Каждого Аргумент Из Аргументы Цикл
		ПроверкаАргументов.ПроверитьТип("Аргумент", Аргумент, "Строка");
		РезультирующиеТокены.Добавить(СоздатьТокен(Аргумент, Позиция));
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Новый РезультатЛексическогоРазбораCURL(РезультирующиеТокены, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьТокен(Аргумент, Позиция)

	Фрагменты = Новый Массив;
	Фрагменты.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Текст(),
		Аргумент,
		Аргумент
	));

	КартаПозиций = Новый Массив;
	Для Индекс = 1 По СтрДлина(Аргумент) Цикл
		КартаПозиций.Добавить(Индекс);
	КонецЦикла;

	Возврат Новый ТокенКомандыCURL(
		Аргумент,
		Аргумент,
		Фрагменты,
		Позиция,
		-1,
		1,
		КартаПозиций
	);

КонецФункции

#КонецОбласти

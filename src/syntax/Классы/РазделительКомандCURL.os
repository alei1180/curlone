#Область ПрограммныйИнтерфейс

// Разделяет последовательность команд curl с учётом кавычек и продолжений строк.
//
// Параметры:
//   Текст - Строка - Исходный текст одной или нескольких команд.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Отдельные команды curl.
Функция Разделить(Текст) Экспорт

	Команды = Новый Массив;
	ТекущаяКоманда = "";
	Кавычка = "";
	Индекс = 1;

	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "\" И Кавычка <> "'" И Индекс < СтрДлина(Текст) Тогда
			Следующий = Сред(Текст, Индекс + 1, 1);
			ТекущаяКоманда = ТекущаяКоманда + Символ + Следующий;
			Индекс = Индекс + 2;
			Продолжить;
		КонецЕсли;

		Если Символ = "'" Или Символ = """" Тогда
			Если Кавычка = "" Тогда
				Кавычка = Символ;
			ИначеЕсли Кавычка = Символ Тогда
				Кавычка = "";
			КонецЕсли;
		КонецЕсли;

		ЭтоРазделитель = Кавычка = "" И (
			Символ = "&"
			Или Символ = Символы.ПС
			Или Символ = Символы.ВК
		);
		Если ЭтоРазделитель Тогда
			ДобавитьКоманду(Команды, ТекущаяКоманда);
			ТекущаяКоманда = "";
			Если Символ = Символы.ВК И Сред(Текст, Индекс + 1, 1) = Символы.ПС Тогда
				Индекс = Индекс + 1;
			КонецЕсли;
		Иначе
			ТекущаяКоманда = ТекущаяКоманда + Символ;
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	ДобавитьКоманду(Команды, ТекущаяКоманда);

	Возврат Новый ФиксированныйМассив(Команды);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКоманду(Команды, Текст)

	Текст = СокрЛП(Текст);
	Если Не ПустаяСтрока(Текст) Тогда
		Команды.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

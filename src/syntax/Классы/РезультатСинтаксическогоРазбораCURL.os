#Использовать errors

Перем _Команда; // РазобраннаяКомандаCURL, Неопределено
Перем _Ошибки; // ФиксированныйМассив из ИнформацияОбОшибке

#Область ОбработчикиСобытий

// Создаёт результат синтаксического разбора.
//
// Параметры:
//   Команда - РазобраннаяКомандаCURL, Неопределено - Команда при успешном результате.
//   Ошибки - Массив, ФиксированныйМассив из ИнформацияОбОшибке - Ошибки разбора.
//
// Исключения:
//   internal.invariant_violation - Наличие команды не соответствует наличию ошибок.
Процедура ПриСозданииОбъекта(Команда, Ошибки)

	УспешныйРезультат = Ошибки.Количество() = 0 И Команда <> Неопределено;
	НеуспешныйРезультат = Ошибки.Количество() > 0 И Команда = Неопределено;

	Если Не УспешныйРезультат И Не НеуспешныйРезультат Тогда
		ВызватьИсключение СтандартныеОшибки.НарушенВнутреннийИнвариант(
			"Успешный результат содержит команду, неуспешный результат содержит ошибки",
			"Наличие команды не соответствует наличию ошибок синтаксического разбора"
		);
	КонецЕсли;

	_Команда = Команда;

	КопияОшибок = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		КопияОшибок.Добавить(Ошибка);
	КонецЦикла;

	_Ошибки = Новый ФиксированныйМассив(КопияОшибок);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает признак успешного разбора.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибки отсутствуют.
Функция Успешно() Экспорт
	Возврат _Ошибки.Количество() = 0;
КонецФункции

// Возвращает разобранную команду.
//
// Возвращаемое значение:
//   РазобраннаяКомандаCURL, Неопределено - Команда при успехе или Неопределено.
Функция Команда() Экспорт
	Возврат _Команда;
КонецФункции

// Возвращает ошибки синтаксического разбора.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ИнформацияОбОшибке - Ошибки разбора.
Функция Ошибки() Экспорт
	Возврат _Ошибки;
КонецФункции

#КонецОбласти

Перем _Команда; // Строка
Перем _Токены; // Массив из ТокенКомандыCURL
Перем _Ошибки; // Массив из ИнформацияОбОшибке
Перем _Состояние; // Строка
Перем _Индекс; // Число
Перем _НомерАргумента; // Число
Перем _ТокенНачат; // Булево
Перем _НачалоТокена; // Число
Перем _Значение; // Строка
Перем _ИсходноеПредставление; // Строка
Перем _КартаИсходныхПозиций; // Массив из Число
Перем _Фрагменты; // Массив из Структура
Перем _ТекстФрагмента; // Строка
Перем _ИсходныйТекстФрагмента; // Строка
Перем _НачальнаяПозицияВИсходнойСтроке; // Число

#Область ПрограммныйИнтерфейс

// Разбирает одну Bash-подобную команду curl на токены.
//
// Параметры:
//   Команда - Строка - Исходная команда.
//   НачальнаяПозицияВИсходнойСтроке - Число - Позиция начала команды с единицы.
//
// Возвращаемое значение:
//   РезультатЛексическогоРазбораCURL - Токены либо структурированная ошибка.
Функция Разобрать(Команда, НачальнаяПозицияВИсходнойСтроке = 1) Экспорт

	ПодготовитьРазбор(Команда, НачальнаяПозицияВИсходнойСтроке);

	Пока _Индекс <= СтрДлина(_Команда) И _Ошибки.Количество() = 0 Цикл
		ОбработатьТекущийСимвол();
	КонецЦикла;

	Если _Ошибки.Количество() = 0 Тогда
		ЗавершитьРазбор();
	КонецЕсли;

	Возврат Новый РезультатЛексическогоРазбораCURL(_Токены, _Ошибки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьРазбор(Команда, НачальнаяПозицияВИсходнойСтроке)

	_Команда = Команда;
	_НачальнаяПозицияВИсходнойСтроке = НачальнаяПозицияВИсходнойСтроке;
	_Токены = Новый Массив;
	_Ошибки = Новый Массив;
	_Состояние = "ВнеКавычек";
	_Индекс = 1;
	_НомерАргумента = 0;

	СброситьТекущийТокен();

КонецПроцедуры

Процедура ОбработатьТекущийСимвол()

	Символ = Сред(_Команда, _Индекс, 1);
	Если _Состояние = "ОдинарнаяКавычка" Тогда
		ОбработатьВОдинарнойКавычке(Символ);
	ИначеЕсли _Состояние = "ДвойнаяКавычка" Тогда
		ОбработатьВДвойнойКавычке(Символ);
	Иначе
		ОбработатьВнеКавычек(Символ);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьВОдинарнойКавычке(Символ)

	Если Символ = "'" Тогда
		ДобавитьТолькоВИсходныйТекст(Символ);
		_Состояние = "ВнеКавычек";
		_Индекс = _Индекс + 1;
		Возврат;
	КонецЕсли;

	ДобавитьТекстовыйСимвол(Символ, Символ, 1);
	_Индекс = _Индекс + 1;

КонецПроцедуры

Процедура ОбработатьВДвойнойКавычке(Символ)

	Если Символ = """" Тогда
		ДобавитьТолькоВИсходныйТекст(Символ);
		_Состояние = "ВнеКавычек";
		_Индекс = _Индекс + 1;
	ИначеЕсли Символ = "\" Тогда
		ОбработатьОбратныйСлеш(Истина);
	ИначеЕсли Символ = "$" Тогда
		ОбработатьДоллар();
	ИначеЕсли Символ = "`" Тогда
		ДобавитьОшибкуShellСинтаксиса(Символ);
	Иначе
		ДобавитьТекстовыйСимвол(Символ, Символ, 1);
		_Индекс = _Индекс + 1;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьВнеКавычек(Символ)

	Если Символ = " " Или Символ = Символы.Таб Тогда
		ЗавершитьТекущийТокен();
		_Индекс = _Индекс + 1;
	ИначеЕсли Символ = "'" Тогда
		НачатьТокен();
		ДобавитьТолькоВИсходныйТекст(Символ);
		_Состояние = "ОдинарнаяКавычка";
		_Индекс = _Индекс + 1;
	ИначеЕсли Символ = """" Тогда
		НачатьТокен();
		ДобавитьТолькоВИсходныйТекст(Символ);
		_Состояние = "ДвойнаяКавычка";
		_Индекс = _Индекс + 1;
	ИначеЕсли Символ = "\" Тогда
		ОбработатьОбратныйСлеш(Ложь);
	ИначеЕсли Символ = "$" Тогда
		ОбработатьДоллар();
	ИначеЕсли ЭтоЗапрещённыйСимволShell(Символ) Тогда
		ДобавитьОшибкуShellСинтаксиса(Символ);
	ИначеЕсли ЭтоПереводСтроки(Символ) Тогда
		ДобавитьОшибкуShellСинтаксиса(Символ);
	Иначе
		ДобавитьТекстовыйСимвол(Символ, Символ, 1);
		_Индекс = _Индекс + 1;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьОбратныйСлеш(ВнутриДвойныхКавычек)

	Если _Индекс = СтрДлина(_Команда) Тогда
		ДобавитьОшибкуShellСинтаксиса("\");
		Возврат;
	КонецЕсли;

	СледующийСимвол = Сред(_Команда, _Индекс + 1, 1);
	Если ЭтоПереводСтроки(СледующийСимвол) Тогда
		ДлинаПродолжения = 2;
		Если СледующийСимвол = Символы.ВК
			И Сред(_Команда, _Индекс + 2, 1) = Символы.ПС Тогда
			ДлинаПродолжения = 3;
		КонецЕсли;
	
		ПродолжениеСтроки = Сред(_Команда, _Индекс, ДлинаПродолжения);

		Если _ТокенНачат Тогда
			ДобавитьТолькоВИсходныйТекст(ПродолжениеСтроки);
		КонецЕсли;
	
		_Индекс = _Индекс + ДлинаПродолжения;
		Возврат;
	КонецЕсли;

	ЭкранируетсяВДвойныхКавычках = СтрНайти("$`""\", СледующийСимвол) > 0;
	Если ВнутриДвойныхКавычек И Не ЭкранируетсяВДвойныхКавычках Тогда
		ДобавитьТекстовыйСимвол("\", "\", 1);
		_Индекс = _Индекс + 1;
		Возврат;
	КонецЕсли;

	ДобавитьТекстовыйСимвол(СледующийСимвол, "\" + СледующийСимвол, 2);
	_Индекс = _Индекс + 2;

КонецПроцедуры

Процедура ОбработатьДоллар()

	Если _Индекс = СтрДлина(_Команда) Тогда
		ДобавитьТекстовыйСимвол("$", "$", 1);
		_Индекс = _Индекс + 1;
		Возврат;
	КонецЕсли;

	СледующийСимвол = Сред(_Команда, _Индекс + 1, 1);
	Если СледующийСимвол = "(" Тогда
		ДобавитьОшибкуShellСинтаксиса("$(");
	ИначеЕсли _Состояние = "ВнеКавычек"
		И (СледующийСимвол = "'" Или СледующийСимвол = """") Тогда
		ДобавитьОшибкуShellСинтаксиса("$" + СледующийСимвол);
	ИначеЕсли СледующийСимвол = "{" Тогда
		ОбработатьПеременнуюВФигурныхСкобках();
	ИначеЕсли ЭтоПервыйСимволИмениПеременной(СледующийСимвол) Тогда
		ОбработатьПростуюПеременную();
	ИначеЕсли ЭтоСпециальныйПараметрBash(СледующийСимвол) Тогда
		ДобавитьОшибкуShellСинтаксиса("$" + СледующийСимвол);
	Иначе
		ДобавитьТекстовыйСимвол("$", "$", 1);
		_Индекс = _Индекс + 1;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьПеременнуюВФигурныхСкобках()

	ПозицияЗакрывающейСкобки = СтрНайти(_Команда, "}", НаправлениеПоиска.СНачала, _Индекс + 2);
	Если ПозицияЗакрывающейСкобки = 0 Тогда
		ДобавитьОшибкуShellСинтаксиса(Сред(_Команда, _Индекс));
		Возврат;
	КонецЕсли;

	Имя = Сред(_Команда, _Индекс + 2, ПозицияЗакрывающейСкобки - _Индекс - 2);
	Если Не ДопустимоеИмяПеременной(Имя) Тогда
		ДобавитьОшибкуShellСинтаксиса(
			Сред(_Команда, _Индекс, ПозицияЗакрывающейСкобки - _Индекс + 1)
		);
		Возврат;
	КонецЕсли;

	ИсходноеПредставление = Сред(
		_Команда,
		_Индекс,
		ПозицияЗакрывающейСкобки - _Индекс + 1
	);
	ДобавитьПеременную(Имя, ИсходноеПредставление);

	_Индекс = ПозицияЗакрывающейСкобки + 1;

КонецПроцедуры

Процедура ОбработатьПростуюПеременную()

	КонецИмени = _Индекс + 1;
	Пока КонецИмени <= СтрДлина(_Команда)
		И ЭтоСимволИмениПеременной(Сред(_Команда, КонецИмени, 1)) Цикл
		КонецИмени = КонецИмени + 1;
	КонецЦикла;

	Имя = Сред(_Команда, _Индекс + 1, КонецИмени - _Индекс - 1);
	ИсходноеПредставление = "$" + Имя;
	ДобавитьПеременную(Имя, ИсходноеПредставление);

	_Индекс = КонецИмени;

КонецПроцедуры

Процедура ДобавитьПеременную(Имя, ИсходноеПредставление)

	НачатьТокен();
	ЗавершитьТекстовыйФрагмент();

	НачалоИсходного = СтрДлина(_ИсходноеПредставление) + 1;
	_ИсходноеПредставление = _ИсходноеПредставление + ИсходноеПредставление;
	_Значение = _Значение + ИсходноеПредставление;

	Для Смещение = 0 По СтрДлина(ИсходноеПредставление) - 1 Цикл
		_КартаИсходныхПозиций.Добавить(НачалоИсходного + Смещение);
	КонецЦикла;

	_Фрагменты.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Переменная(),
		Имя,
		ИсходноеПредставление
	));

КонецПроцедуры

Процедура ДобавитьТекстовыйСимвол(ЗначениеСимвола, ИсходныйТекст, ПозицияЗначимогоСимвола)

	НачатьТокен();

	_ИсходноеПредставление = _ИсходноеПредставление + ИсходныйТекст;
	_ИсходныйТекстФрагмента = _ИсходныйТекстФрагмента + ИсходныйТекст;
	_Значение = _Значение + ЗначениеСимвола;
	_ТекстФрагмента = _ТекстФрагмента + ЗначениеСимвола;
	_КартаИсходныхПозиций.Добавить(
		СтрДлина(_ИсходноеПредставление) - СтрДлина(ИсходныйТекст) + ПозицияЗначимогоСимвола
	);

КонецПроцедуры

Процедура ДобавитьТолькоВИсходныйТекст(ИсходныйТекст)

	НачатьТокен();

	_ИсходноеПредставление = _ИсходноеПредставление + ИсходныйТекст;
	_ИсходныйТекстФрагмента = _ИсходныйТекстФрагмента + ИсходныйТекст;

КонецПроцедуры

Процедура НачатьТокен()

	Если _ТокенНачат Тогда
		Возврат;
	КонецЕсли;

	_ТокенНачат = Истина;
	_НачалоТокена = _Индекс;

КонецПроцедуры

Процедура ЗавершитьТекущийТокен()

	Если Не _ТокенНачат Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьТекстовыйФрагмент();

	_НомерАргумента = _НомерАргумента + 1;
	_Токены.Добавить(Новый ТокенКомандыCURL(
		_Значение,
		_ИсходноеПредставление,
		_Фрагменты,
		_НомерАргумента,
		ПозицияВИсходнойСтроке(_НачалоТокена),
		1,
		_КартаИсходныхПозиций
	));

	СброситьТекущийТокен();

КонецПроцедуры

Процедура ЗавершитьТекстовыйФрагмент()

	Если _ТекстФрагмента = "" И _ИсходныйТекстФрагмента = "" Тогда
		Возврат;
	КонецЕсли;

	_Фрагменты.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Текст(),
		_ТекстФрагмента,
		_ИсходныйТекстФрагмента
	));

	_ТекстФрагмента = "";
	_ИсходныйТекстФрагмента = "";

КонецПроцедуры

Процедура СброситьТекущийТокен()

	_ТокенНачат = Ложь;
	_НачалоТокена = -1;
	_Значение = "";
	_ИсходноеПредставление = "";
	_КартаИсходныхПозиций = Новый Массив;
	_Фрагменты = Новый Массив;
	_ТекстФрагмента = "";
	_ИсходныйТекстФрагмента = "";

КонецПроцедуры

Процедура ЗавершитьРазбор()

	Если _Состояние <> "ВнеКавычек" Тогда
		_Ошибки.Добавить(ОшибкиРазбораCURL.Создать(
			КодыОшибокCurlOne.НезакрытаяКавычка(),
			"В команде curl не закрыта кавычка",
			_НомерАргумента + 1,
			ПозицияВИсходнойСтроке(_НачалоТокена),
			1,
			_ИсходноеПредставление
		));
		Возврат;
	КонецЕсли;

	ЗавершитьТекущийТокен();

КонецПроцедуры

Процедура ДобавитьОшибкуShellСинтаксиса(ИсходноеПредставление)

	Позиция = _НомерАргумента + 1;
	ПозицияВАргументе = ?(_ТокенНачат, СтрДлина(_ИсходноеПредставление) + 1, -1);

	_Ошибки.Добавить(ОшибкиРазбораCURL.Создать(
		КодыОшибокCurlOne.НеподдерживаемыйСинтаксисОболочки(),
		"Команда содержит неподдерживаемый синтаксис командной оболочки",
		Позиция,
		ПозицияВИсходнойСтроке(_Индекс),
		ПозицияВАргументе,
		ИсходноеПредставление
	));

КонецПроцедуры

Функция ПозицияВИсходнойСтроке(ПозицияВКоманде)

	Возврат _НачальнаяПозицияВИсходнойСтроке + ПозицияВКоманде - 1;

КонецФункции

Функция ЭтоЗапрещённыйСимволShell(Символ)

	Возврат СтрНайти(";|&<>`", Символ) > 0;

КонецФункции

Функция ЭтоПереводСтроки(Символ)

	Возврат Символ = Символы.ПС Или Символ = Символы.ВК;

КонецФункции

Функция ДопустимоеИмяПеременной(Имя)

	Если Имя = "" Или Не ЭтоПервыйСимволИмениПеременной(Лев(Имя, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 2 По СтрДлина(Имя) Цикл
		Если Не ЭтоСимволИмениПеременной(Сред(Имя, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоПервыйСимволИмениПеременной(Символ)

	Возврат Символ = "_" Или СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", Символ) > 0;

КонецФункции

Функция ЭтоСимволИмениПеременной(Символ)

	Возврат ЭтоПервыйСимволИмениПеременной(Символ) Или ЭтоЦифра(Символ);

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоСпециальныйПараметрBash(Символ)

	Возврат ЭтоЦифра(Символ) Или СтрНайти("$?@*#!-", Символ) > 0;

КонецФункции

#КонецОбласти

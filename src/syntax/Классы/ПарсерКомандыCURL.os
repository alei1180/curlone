#Использовать "../../shared"

Перем _Токены; // ФиксированныйМассив из ТокенКомандыCURL
Перем _Индекс; // Число
Перем _Элементы; // Массив из ЭлементРазобраннойКомандыCURL
Перем _Ошибки; // Массив из ИнформацияОбОшибке
Перем _РазборОпцийЗавершен; // Булево

#Область ПрограммныйИнтерфейс

// Связывает токены с описаниями опций curl.
//
// Параметры:
//   Токены - Массив, ФиксированныйМассив из ТокенКомандыCURL - Токены лексера или адаптера.
//
// Возвращаемое значение:
//   РезультатСинтаксическогоРазбораCURL - Команда либо структурированная ошибка.
Функция Разобрать(Токены) Экспорт

	_Токены = Новый ФиксированныйМассив(Новый КоллекцииМоделиCURL().Скопировать(Токены));
	_Индекс = 0;
	_Элементы = Новый Массив;
	_Ошибки = Новый Массив;
	_РазборОпцийЗавершен = Ложь;

	Если Не ПроверитьCurl() Тогда
		Возврат РезультатСОшибками();
	КонецЕсли;

	_Индекс = 1;
	Пока _Индекс <= _Токены.ВГраница() И _Ошибки.Количество() = 0 Цикл
		ОбработатьТокен(_Токены[_Индекс]);
		_Индекс = _Индекс + 1;
	КонецЦикла;

	Если _Ошибки.Количество() > 0 Тогда
		Возврат РезультатСОшибками();
	КонецЕсли;

	Возврат Новый РезультатСинтаксическогоРазбораCURL(
		Новый РазобраннаяКомандаCURL(_Элементы),
		_Ошибки
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьCurl()

	Если _Токены.Количество() > 0 И НРег(_Токены[0].Значение()) = "curl" Тогда
		Возврат Истина;
	КонецЕсли;

	Если _Токены.Количество() = 0 Тогда
		ДобавитьОшибку(КодыОшибокCurlone.ТребуетсяCurl(), "Команда должна начинаться с curl", Неопределено);
	Иначе
		ДобавитьОшибку(КодыОшибокCurlone.ТребуетсяCurl(), "Команда должна начинаться с curl", _Токены[0]);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ОбработатьТокен(Токен)

	Значение = Токен.Значение();
	Если Не _РазборОпцийЗавершен И Значение = "--" Тогда
		_РазборОпцийЗавершен = Истина;
	ИначеЕсли Не _РазборОпцийЗавершен И СтрНачинаетсяС(Значение, "--") Тогда
		РазобратьДлиннуюОпцию(Токен);
	ИначеЕсли Не _РазборОпцийЗавершен И СтрНачинаетсяС(Значение, "-") И СтрДлина(Значение) > 1 Тогда
		РазобратьКороткиеОпции(Токен);
	Иначе
		_Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.URL(Токен));
	КонецЕсли;

КонецПроцедуры

Процедура РазобратьДлиннуюОпцию(ИсходныйТокен)

	Значение = ИсходныйТокен.Значение();
	ПозицияРавенства = СтрНайти(Значение, "=");

	Если ПозицияРавенства > 0 Тогда
		УказанноеИмя = Лев(Значение, ПозицияРавенства - 1);
		ТокенОпции = ИсходныйТокен.СоздатьПроизводный(1, ПозицияРавенства - 1);
		ТокенЗначения = ИсходныйТокен.СоздатьПроизводный(
			ПозицияРавенства + 1,
			СтрДлина(Значение) - ПозицияРавенства
		);
	Иначе
		УказанноеИмя = Значение;
		ТокенОпции = ИсходныйТокен;
		ТокенЗначения = Неопределено;
	КонецЕсли;

	Описание = СпецификацияОпцийCURL.НайтиПоИмени(УказанноеИмя);
	Если Описание = Неопределено Тогда
		ДобавитьОшибку(КодыОшибокCurlone.НеизвестнаяОпция(), "Неизвестная опция curl", ТокенОпции);
		Возврат;
	КонецЕсли;

	Если Описание.Управляющая() Тогда
		Если ТокенЗначения <> Неопределено Тогда
			ДобавитьНедопустимоеЗначение(ТокенЗначения);
			Возврат;
		КонецЕсли;

		_Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.ГраницаГруппы(
			Описание, УказанноеИмя, ТокенОпции, ИсходныйТокен));
		Возврат;
	КонецЕсли;

	ДобавитьОпцию(Описание, УказанноеИмя, ТокенОпции, ТокенЗначения, ИсходныйТокен);

КонецПроцедуры

Процедура РазобратьКороткиеОпции(ИсходныйТокен)

	Значение = ИсходныйТокен.Значение();
	ПозицияСимвола = 2;

	Пока ПозицияСимвола <= СтрДлина(Значение) И _Ошибки.Количество() = 0 Цикл
		УказанноеИмя = "-" + Сред(Значение, ПозицияСимвола, 1);
		Описание = СпецификацияОпцийCURL.НайтиПоИмени(УказанноеИмя);

		Если Описание = Неопределено Тогда
			ТокенОшибки = ИсходныйТокен.СоздатьПроизводный(ПозицияСимвола, 1);
			ДобавитьОшибку(КодыОшибокCurlone.НеизвестнаяОпция(), "Неизвестная опция curl", ТокенОшибки);
			Возврат;
		КонецЕсли;

		ТокенОпции = ПроизводныйТокенКороткойОпции(ИсходныйТокен, ПозицияСимвола);
		Если Описание.Управляющая() Тогда
			_Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.ГраницаГруппы(
				Описание, УказанноеИмя, ТокенОпции, ИсходныйТокен));
			ПозицияСимвола = ПозицияСимвола + 1;
			Продолжить;
		КонецЕсли;

		Если Описание.РежимЗначения() <> РежимыЗначенияОпцийCURL.НеПринимает() Тогда
			Если ПозицияСимвола < СтрДлина(Значение) Тогда
				ТокенЗначения = ИсходныйТокен.СоздатьПроизводный(
					ПозицияСимвола + 1,
					СтрДлина(Значение) - ПозицияСимвола
				);
			Иначе
				ТокенЗначения = Неопределено;
			КонецЕсли;

			ДобавитьОпцию(Описание, УказанноеИмя, ТокенОпции, ТокенЗначения, ИсходныйТокен);
			Возврат;
		КонецЕсли;

		ДобавитьЭлементОпции(Описание, УказанноеИмя, ТокенОпции, Неопределено, ИсходныйТокен);
		ПозицияСимвола = ПозицияСимвола + 1;
	КонецЦикла;

КонецПроцедуры

Функция ПроизводныйТокенКороткойОпции(ИсходныйТокен, ПозицияСимвола)

	Если ПозицияСимвола = 2 Тогда
		Возврат ИсходныйТокен.СоздатьПроизводный(1, 2);
	КонецЕсли;

	Возврат ИсходныйТокен.СоздатьПроизводный(ПозицияСимвола, 1);

КонецФункции

Процедура ДобавитьОпцию(Описание, УказанноеИмя, ТокенОпции, ТокенЗначения, ИсходныйТокен)

	ТребуетЗначение = Описание.РежимЗначения() = РежимыЗначенияОпцийCURL.Требует();
	ПринимаетЗначение = Описание.РежимЗначения() <> РежимыЗначенияОпцийCURL.НеПринимает();

	Если ПринимаетЗначение И ТокенЗначения = Неопределено И _Индекс < _Токены.ВГраница() Тогда
		_Индекс = _Индекс + 1;
		ТокенЗначения = _Токены[_Индекс];
	ИначеЕсли ТребуетЗначение И ТокенЗначения = Неопределено Тогда
		ДобавитьОшибку(
			КодыОшибокCurlone.ТребуетсяЗначениеОпции(),
			"Для опции curl требуется значение",
			ТокенОпции
		);
		Возврат;
	ИначеЕсли Не ПринимаетЗначение И ТокенЗначения <> Неопределено Тогда
		ДобавитьНедопустимоеЗначение(ТокенЗначения);
		Возврат;
	КонецЕсли;

	ДобавитьЭлементОпции(Описание, УказанноеИмя, ТокенОпции, ТокенЗначения, ИсходныйТокен);

КонецПроцедуры

Процедура ДобавитьЭлементОпции(Описание, УказанноеИмя, ТокенОпции, ТокенЗначения, ИсходныйТокен)

	ИмяБезПрефикса = ?(СтрНачинаетсяС(УказанноеИмя, "--"), Сред(УказанноеИмя, 3), Сред(УказанноеИмя, 2));
	ОтрицательнаяФорма = Описание.ОтрицательныеПсевдонимы().Найти(ИмяБезПрефикса) <> Неопределено;

	_Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.Опция(
		Описание,
		УказанноеИмя,
		ОтрицательнаяФорма,
		ТокенОпции,
		ТокенЗначения,
		ИсходныйТокен
	));

КонецПроцедуры

Процедура ДобавитьНедопустимоеЗначение(Токен)

	ДобавитьОшибку(
		КодыОшибокCurlone.ЗначениеОпцииНеДопускается(),
		"Опция curl не принимает значение",
		Токен
	);

КонецПроцедуры

Процедура ДобавитьОшибку(Код, Сообщение, Токен)

	Если Токен = Неопределено Тогда
		_Ошибки.Добавить(ОшибкиРазбораCURL.Создать(Код, Сообщение, -1, -1, -1, ""));
	Иначе
		_Ошибки.Добавить(ОшибкиРазбораCURL.Создать(
			Код,
			Сообщение,
			Токен.Позиция(),
			Токен.ПозицияВИсходнойСтроке(),
			Токен.ПозицияВАргументе(),
			Токен.ИсходноеПредставление()
		));
	КонецЕсли;

КонецПроцедуры

Функция РезультатСОшибками()

	Возврат Новый РезультатСинтаксическогоРазбораCURL(Неопределено, _Ошибки);

КонецФункции

#КонецОбласти

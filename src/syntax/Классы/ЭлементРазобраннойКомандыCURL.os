Перем _Вид; // Строка
Перем _ОписаниеОпции; // ОписаниеОпцииCURL, Неопределено
Перем _УказанноеИмяОпции; // Строка, Неопределено
Перем _ОтрицательнаяФорма; // Булево
Перем _ТокенОпции; // ТокенКомандыCURL, Неопределено
Перем _ТокенЗначения; // ТокенКомандыCURL, Неопределено
Перем _ТокенURL; // ТокенКомандыCURL, Неопределено
Перем _ИсходныйТокен; // ТокенКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемый элемент разобранной команды.
//
// Параметры:
//   Вид - Строка - Значение из модуля ВидыЭлементовРазобраннойКомандыCURL.
//   ОписаниеОпции - ОписаниеОпцииCURL, Неопределено - Метаданные опции.
//   УказанноеИмяОпции - Строка, Неопределено - Имя с префиксом, указанное пользователем.
//   ОтрицательнаяФорма - Булево - Признак отрицательного псевдонима.
//   ТокенОпции - ТокенКомандыCURL, Неопределено - Токен имени опции.
//   ТокенЗначения - ТокенКомандыCURL, Неопределено - Токен значения опции.
//   ТокенURL - ТокенКомандыCURL, Неопределено - Токен URL.
//   ИсходныйТокен - ТокенКомандыCURL - Токен, из которого создан элемент.
Процедура ПриСозданииОбъекта(
	Вид,
	ОписаниеОпции,
	УказанноеИмяОпции,
	ОтрицательнаяФорма,
	ТокенОпции,
	ТокенЗначения,
	ТокенURL,
	ИсходныйТокен
)

	_Вид = Вид;
	_ОписаниеОпции = ОписаниеОпции;
	_УказанноеИмяОпции = УказанноеИмяОпции;
	_ОтрицательнаяФорма = ОтрицательнаяФорма;
	_ТокенОпции = ТокенОпции;
	_ТокенЗначения = ТокенЗначения;
	_ТокенURL = ТокенURL;
	_ИсходныйТокен = ИсходныйТокен;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает вид элемента.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ВидыЭлементовРазобраннойКомандыCURL.
Функция Вид() Экспорт
	Возврат _Вид;
КонецФункции

// Возвращает описание опции.
//
// Возвращаемое значение:
//   ОписаниеОпцииCURL, Неопределено - Метаданные для опции или границы.
Функция ОписаниеОпции() Экспорт
	Возврат _ОписаниеОпции;
КонецФункции

// Возвращает указанное пользователем имя опции.
//
// Возвращаемое значение:
//   Строка, Неопределено - Имя с префиксом либо Неопределено для URL.
Функция УказанноеИмяОпции() Экспорт
	Возврат _УказанноеИмяОпции;
КонецФункции

// Возвращает признак отрицательной формы.
//
// Возвращаемое значение:
//   Булево - Истина, если использован отрицательный псевдоним.
Функция ОтрицательнаяФорма() Экспорт
	Возврат _ОтрицательнаяФорма;
КонецФункции

// Возвращает токен имени опции.
//
// Возвращаемое значение:
//   ТокенКомандыCURL, Неопределено - Токен имени или Неопределено.
Функция ТокенОпции() Экспорт
	Возврат _ТокенОпции;
КонецФункции

// Возвращает токен значения опции.
//
// Возвращаемое значение:
//   ТокенКомандыCURL, Неопределено - Токен значения или Неопределено.
Функция ТокенЗначения() Экспорт
	Возврат _ТокенЗначения;
КонецФункции

// Возвращает токен URL.
//
// Возвращаемое значение:
//   ТокенКомандыCURL, Неопределено - Токен URL или Неопределено.
Функция ТокенURL() Экспорт
	Возврат _ТокенURL;
КонецФункции

// Возвращает исходный токен элемента.
//
// Возвращаемое значение:
//   ТокенКомандыCURL - Токен лексера или адаптера.
Функция ИсходныйТокен() Экспорт
	Возврат _ИсходныйТокен;
КонецФункции

#КонецОбласти

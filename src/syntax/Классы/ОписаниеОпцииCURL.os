#Использовать "../../shared"

Перем _КаноническоеИмя; // Строка
Перем _Псевдонимы; // ФиксированныйМассив из Строка
Перем _ОтрицательныеПсевдонимы; // ФиксированныйМассив из Строка
Перем _РежимЗначения; // Строка
Перем _ТипЗначения; // Строка
Перем _ОбластьДействия; // Строка
Перем _ПравилоПовторения; // Строка
Перем _ИдентификаторОбработчика; // Строка
Перем _ПоддерживаласьВV1; // Булево
Перем _Управляющая; // Булево

#Область ОбработчикиСобытий

// Создаёт неизменяемое описание опции curl.
//
// Параметры:
//   КаноническоеИмя - Строка - Основное длинное имя опции без дефисов.
//   Псевдонимы - Массив, ФиксированныйМассив из Строка - Все короткие и длинные имена без дефисов.
//   ОтрицательныеПсевдонимы - Массив, ФиксированныйМассив из Строка - Имена, отключающие булеву опцию.
//   РежимЗначения - Строка - Значение из модуля РежимыЗначенияОпцийCURL.
//   ТипЗначения - Строка - Значение из модуля ТипыЗначенийОпцийCURL.
//   ОбластьДействия - Строка - Значение из модуля ОбластиДействияОпцийCURL.
//   ПравилоПовторения - Строка - Значение из модуля ПравилаПовторенияОпцийCURL.
//   ИдентификаторОбработчика - Строка - Имя обработчика семантики или пустая строка.
//   ПоддерживаласьВV1 - Булево - Признак поддержки прежней реализацией.
//   Управляющая - Булево - Признак управления последовательностью команд.
Процедура ПриСозданииОбъекта(
	КаноническоеИмя,
	Псевдонимы,
	ОтрицательныеПсевдонимы,
	РежимЗначения,
	ТипЗначения,
	ОбластьДействия,
	ПравилоПовторения,
	ИдентификаторОбработчика,
	ПоддерживаласьВV1,
	Управляющая
)

	_КаноническоеИмя = КаноническоеИмя;
	_Псевдонимы = Новый ФиксированныйМассив(Новый КоллекцииМоделиCURL().Скопировать(Псевдонимы));
	_ОтрицательныеПсевдонимы = Новый ФиксированныйМассив(
		Новый КоллекцииМоделиCURL().Скопировать(ОтрицательныеПсевдонимы)
	);
	_РежимЗначения = РежимЗначения;
	_ТипЗначения = ТипЗначения;
	_ОбластьДействия = ОбластьДействия;
	_ПравилоПовторения = ПравилоПовторения;
	_ИдентификаторОбработчика = ИдентификаторОбработчика;
	_ПоддерживаласьВV1 = ПоддерживаласьВV1;
	_Управляющая = Управляющая;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает каноническое имя опции.
//
// Возвращаемое значение:
//   Строка - Длинное имя без дефисов.
Функция КаноническоеИмя() Экспорт

	Возврат _КаноническоеИмя;

КонецФункции

// Возвращает все имена опции.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Короткие и длинные имена без дефисов.
Функция Псевдонимы() Экспорт

	Возврат _Псевдонимы;

КонецФункции

// Возвращает имена, отключающие булеву опцию.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Подмножество псевдонимов.
Функция ОтрицательныеПсевдонимы() Экспорт

	Возврат _ОтрицательныеПсевдонимы;

КонецФункции

// Возвращает режим значения опции.
//
// Возвращаемое значение:
//   Строка - Значение из модуля РежимыЗначенияОпцийCURL.
Функция РежимЗначения() Экспорт

	Возврат _РежимЗначения;

КонецФункции

// Возвращает тип значения опции.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ТипыЗначенийОпцийCURL.
Функция ТипЗначения() Экспорт

	Возврат _ТипЗначения;

КонецФункции

// Возвращает область действия опции.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ОбластиДействияОпцийCURL.
Функция ОбластьДействия() Экспорт

	Возврат _ОбластьДействия;

КонецФункции

// Возвращает правило обработки повторной опции.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ПравилаПовторенияОпцийCURL.
Функция ПравилоПовторения() Экспорт

	Возврат _ПравилоПовторения;

КонецФункции

// Возвращает идентификатор обработчика семантики.
//
// Возвращаемое значение:
//   Строка - Имя обработчика или пустая строка.
Функция ИдентификаторОбработчика() Экспорт

	Возврат _ИдентификаторОбработчика;

КонецФункции

// Возвращает признак поддержки опции прежней реализацией.
//
// Возвращаемое значение:
//   Булево - Истина, если опция поддерживалась в v1.
Функция ПоддерживаласьВV1() Экспорт

	Возврат _ПоддерживаласьВV1;

КонецФункции

// Возвращает признак управляющей опции.
//
// Возвращаемое значение:
//   Булево - Истина для опции управления последовательностью команд.
Функция Управляющая() Экспорт

	Возврат _Управляющая;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

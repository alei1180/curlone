#Использовать "../../shared"

Перем _Элементы; // ФиксированныйМассив из ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемую разобранную команду curl.
//
// Параметры:
//   Элементы - Массив, ФиксированныйМассив из ЭлементРазобраннойКомандыCURL - Элементы в исходном порядке.
Процедура ПриСозданииОбъекта(Элементы)

	_Элементы = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Элементы));

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает элементы команды в исходном порядке.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ЭлементРазобраннойКомандыCURL - Опции, URL и границы секций команды.
Функция Элементы() Экспорт
	Возврат _Элементы;
КонецФункции

#КонецОбласти

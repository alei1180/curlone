Перем _Элементы; // ФиксированныйМассив из ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемую разобранную команду curl.
//
// Параметры:
//   Элементы - Массив, ФиксированныйМассив из ЭлементРазобраннойКомандыCURL - Элементы в исходном порядке.
Процедура ПриСозданииОбъекта(Элементы)

	Копия = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;

	_Элементы = Новый ФиксированныйМассив(Копия);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает элементы команды в исходном порядке.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ЭлементРазобраннойКомандыCURL - Опции, URL и границы групп.
Функция Элементы() Экспорт
	Возврат _Элементы;
КонецФункции

#КонецОбласти

#Использовать decorator
#Использовать errors

Перем _Поделка; // Поделка
Перем _ПроверкаЗапроса; // ПроверкаЗапросаКонвертацииJSON
Перем _ФормированиеОтвета; // ФормированиеОтветаКонвертацииJSON

#Область ОбработчикиСобытий

// Создаёт напильник для проверки JSON до автоматического разбора Winow.
//
// Параметры:
//   Поделка - Поделка - Приложение Autumn для получения фабрики ответов.
&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") Поделка)

	_Поделка = Поделка;
	_ПроверкаЗапроса = Новый ПроверкаЗапросаКонвертацииJSON;
	_ФормированиеОтвета = Новый ФормированиеОтветаКонвертацииJSON;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет предварительную проверку в обработчик запросов Winow.
//
// Параметры:
//   Желудь            - ОбработчикЗапросов - Исходный обработчик запросов.
//   ОпределениеЖелудя - ОпределениеЖелудя  - Описание компонента Autumn.
//
// Возвращаемое значение:
//   Произвольный - Декоратор обработчика запросов.
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	ТелоПерехватчика = "
	|Декоратор_ПредварительныйОтвет = Декоратор_ПроверкаJSON.ПредварительныйОтвет(Запрос);
	|
	|Если Декоратор_ПредварительныйОтвет <> Неопределено Тогда
	|	Возврат Декоратор_ПредварительныйОтвет;
	|КонецЕсли;";

	Перехватчик = Новый Перехватчик("СформироватьОтвет")
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПерехватчика);

	Построитель = Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Декоратор_ПроверкаJSON"))
		.Перехватчик(Перехватчик);

	Декоратор = Построитель.Построить();

	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Декоратор, "Декоратор_ПроверкаJSON", ЭтотОбъект);

	Возврат Декоратор;

КонецФункции

// Проверяет размер и синтаксис JSON до передачи запроса маршрутизатору Winow.
//
// Параметры:
//   Запрос - ВходящийЗапрос - Входящий HTTP-запрос.
//
// Возвращаемое значение:
//   Ответ, Неопределено - Готовый ответ при нарушении ограничений или Неопределено.
Функция ПредварительныйОтвет(Запрос) Экспорт

	Если Не ЭтоЦелевойЗапрос(Запрос) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если _ПроверкаЗапроса.РазмерТела(Запрос) > _ПроверкаЗапроса.ПредельныйРазмерТела() Тогда
		Возврат ОтветСОшибкой(
			Запрос,
			413,
			"Content Too Large",
			КодыСтандартныхОшибок.ДанныеСлишкомБольшие(),
			"Тело запроса превышает 65536 байт"
		);
	КонецЕсли;

	Разбор = _ПроверкаЗапроса.Разобрать(Запрос.Тело);
	Если Разбор.Ошибка <> Неопределено Тогда
		Возврат ОтветСОшибкойПроверки(Запрос, Разбор.Ошибка);
	КонецЕсли;

	ОшибкаПроверки = _ПроверкаЗапроса.ПроверитьДанные(Разбор.Данные);
	Если ОшибкаПроверки <> Неопределено Тогда
		Возврат ОтветСОшибкойПроверки(Запрос, ОшибкаПроверки);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЦелевойЗапрос(Запрос)

	Если Запрос.Путь <> "/api/v2/convert" Или ВРег(Запрос.Метод) <> "POST" Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипСодержимого = _ПроверкаЗапроса.ЗначениеЗаголовка(Запрос.Заголовки, "Content-Type");

	Возврат _ПроверкаЗапроса.ЭтоТипСодержимогоJSON(ТипСодержимого);

КонецФункции

Функция ОтветСОшибкой(Запрос, КодСостояния, ТекстСостояния, КодОшибки, Сообщение)

	Ошибка = _ПроверкаЗапроса.НоваяОшибка(
		КодСостояния,
		ТекстСостояния,
		"тело запроса",
		КодОшибки,
		Сообщение
	);

	Возврат ОтветСОшибкойПроверки(Запрос, Ошибка);

КонецФункции

Функция ОтветСОшибкойПроверки(Запрос, ОшибкаПроверки)

	ФабрикаОтветов = _Поделка.НайтиЖелудь("ФабрикаОтветов");
	Ответ = ФабрикаОтветов.НовыйОтвет();
	Ответ.ИдентификаторЗапроса = Запрос.Идентификатор;
	_ФормированиеОтвета.ЗаписатьОшибку(
		Ответ,
		ОшибкаПроверки.Статус,
		ОшибкаПроверки.ТекстСтатуса,
		ОшибкаПроверки.Ошибка
	);

	Возврат Ответ;

КонецФункции

#КонецОбласти

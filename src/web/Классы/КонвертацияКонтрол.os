#Использовать errors
#Использовать resilience
#Использовать "../../public"
#Использовать "../../generation"
#Использовать "../../generators/shared"

Перем _Конвертер; // Произвольный
Перем _ПроверкаЗапроса; // ПроверкаЗапросаКонвертацииJSON
Перем _ФормированиеОтвета; // ФормированиеОтветаКонвертацииJSON
Перем _ОграничениеПараллелизма; // СтратегияОграниченияПараллелизма

#Область ОбработчикиСобытий

// Создает контроллер конвертации.
//
// Параметры:
//   Конвертер - Произвольный, Неопределено - Необязательный конвертер.
//   МаксимальноеКоличествоОдновременныхКонвертаций - Число - Предельное количество одновременных конвертаций.
//
// Исключения:
//   Произвольное исключение - Максимальное количество одновременных конвертаций не больше нуля.
&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Деталька(ЗначениеПоУмолчанию = Неопределено) Конвертер = Неопределено,
	&Деталька(
		Значение = "curlone.web.МаксимальноеКоличествоОдновременныхКонвертаций",
		ЗначениеПоУмолчанию = 50
	) МаксимальноеКоличествоОдновременныхКонвертаций = 50
)

	_Конвертер = Конвертер;
	_ПроверкаЗапроса = Новый ПроверкаЗапросаКонвертацииJSON;
	_ФормированиеОтвета = Новый ФормированиеОтветаКонвертацииJSON;
	_ОграничениеПараллелизма = Новый СтратегияОграниченияПараллелизма(МаксимальноеКоличествоОдновременныхКонвертаций);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Преобразует curl-команду из JSON-запроса.
//
// Параметры:
//   Запрос - ВходящийЗапрос - HTTP-запрос с JSON-телом.
//   Ответ - Ответ - Формируемый HTTP-ответ.
&ТочкаМаршрута("api/v2/convert")
Процедура Преобразовать(Запрос, Ответ) Экспорт

	Если ВРег(Запрос.Метод) <> "POST" Тогда
		Ответ.Заголовки.Вставить("Allow", "POST");
		Ошибка = СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"HTTP-метод",
			"POST",
			"Метод HTTP должен быть POST"
		);
		_ФормированиеОтвета.ЗаписатьОшибку(Ответ, 405, "Method Not Allowed", Ошибка);

		Возврат;
	КонецЕсли;

	ТипСодержимого = _ПроверкаЗапроса.ЗначениеЗаголовка(Запрос.Заголовки, "Content-Type");
	Если Не _ПроверкаЗапроса.ЭтоТипСодержимогоJSON(ТипСодержимого) Тогда
		Ошибка = СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Content-Type",
			"application/json",
			"Тип содержимого должен быть application/json"
		);
		_ФормированиеОтвета.ЗаписатьОшибку(Ответ, 415, "Unsupported Media Type", Ошибка);

		Возврат;
	КонецЕсли;

	Если _ПроверкаЗапроса.РазмерТела(Запрос) > _ПроверкаЗапроса.ПредельныйРазмерТела() Тогда
		Ошибка = СтандартныеОшибки.ДанныеСлишкомБольшие(
			"тело запроса",
			"65536 байт",
			"Тело запроса превышает 65536 байт"
		);
		_ФормированиеОтвета.ЗаписатьОшибку(Ответ, 413, "Content Too Large", Ошибка);

		Возврат;
	КонецЕсли;

	Разбор = _ПроверкаЗапроса.Разобрать(Запрос.Тело);
	Если Разбор.Ошибка <> Неопределено Тогда
		ЗаписатьОшибкуПроверки(Ответ, Разбор.Ошибка);

		Возврат;
	КонецЕсли;

	ДанныеЗапроса = Разбор.Данные;
	ОшибкаПроверки = _ПроверкаЗапроса.ПроверитьДанные(ДанныеЗапроса);
	Если ОшибкаПроверки <> Неопределено Тогда
		ЗаписатьОшибкуПроверки(Ответ, ОшибкаПроверки);

		Возврат;
	КонецЕсли;

	Попытка
		Параметры = Новый ПараметрыКонвертацииCURL(ДанныеЗапроса["command"]);
		ЗаполнитьПараметры(Параметры, ДанныеЗапроса);

		Конвертер = КонвертерДляЗапроса();
		Результат = _ОграничениеПараллелизма.Применить(
			Новый Действие(Конвертер, "Конвертировать"),
			Параметры
		);
		_ФормированиеОтвета.ЗаписатьРезультат(Ответ, Результат, Параметры.Цель);
	Исключение
		ЗаписатьОшибкуВыполнения(Ответ, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонвертерДляЗапроса()

	Если _Конвертер <> Неопределено Тогда
		Возврат _Конвертер;
	КонецЕсли;

	Возврат Новый КонвертерCURL;

КонецФункции

Процедура ЗаписатьОшибкуВыполнения(Ответ, ДанныеОшибки)

	КодПереполнения = КодыОшибокОтказоустойчивости.ОтклонениеПоОграничениюПараллелизма();
	Если ДиагностикаОшибок.НайтиПервую(ДанныеОшибки, КодПереполнения) <> Неопределено Тогда
		Ошибка = ФабрикаОшибок.Создать(
			КодПереполнения,
			"Сервис временно перегружен"
		);
		_ФормированиеОтвета.ЗаписатьОшибку(Ответ, 503, "Service Unavailable", Ошибка);

		Возврат;
	КонецЕсли;

	Ошибка = ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		"Внутренняя ошибка сервера"
	);
	_ФормированиеОтвета.ЗаписатьОшибку(Ответ, 500, "Internal Server Error", Ошибка);

КонецПроцедуры

Процедура ЗаписатьОшибкуПроверки(Ответ, ОшибкаПроверки)

	_ФормированиеОтвета.ЗаписатьОшибку(
		Ответ,
		ОшибкаПроверки.Статус,
		ОшибкаПроверки.ТекстСтатуса,
		ОшибкаПроверки.Ошибка
	);

КонецПроцедуры

Процедура ЗаполнитьПараметры(Параметры, ДанныеЗапроса)

	Если ДанныеЗапроса.Получить("target") <> Неопределено Тогда
		Параметры.Цель = ДанныеЗапроса["target"];
	КонецЕсли;

	Если ДанныеЗапроса.Получить("locale") <> Неопределено Тогда
		Параметры.Локаль = ДанныеЗапроса["locale"];
	КонецЕсли;

	НастройкиГенератора = ДанныеЗапроса.Получить("generatorOptions");
	Если НастройкиГенератора <> Неопределено
		И НастройкиГенератора.Получить("responseDeserializationFormat") <> Неопределено Тогда

		Параметры.ФорматДесериализацииОтвета = НастройкиГенератора["responseDeserializationFormat"];

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

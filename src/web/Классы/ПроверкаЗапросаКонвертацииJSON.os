#Использовать errors
#Использовать jason
#Использовать "../../public"

#Область ПрограммныйИнтерфейс

// Возвращает предельный размер тела запроса.
//
// Возвращаемое значение:
//   Число - Предельный размер тела запроса в байтах.
Функция ПредельныйРазмерТела() Экспорт

	Возврат 65536;

КонецФункции

// Определяет размер тела запроса в байтах UTF-8.
//
// Параметры:
//   Запрос - ВходящийЗапрос - Проверяемый HTTP-запрос.
//
// Возвращаемое значение:
//   Число - Размер тела запроса в байтах.
Функция РазмерТела(Запрос) Экспорт

	Если Запрос.ТелоДвоичныеДанные <> Неопределено Тогда
		Возврат Запрос.ТелоДвоичныеДанные.Размер();
	КонецЕсли;

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Запрос.Тело, КодировкаТекста.UTF8, Ложь).Размер();

КонецФункции

// Разбирает тело JSON без выбрасывания ошибки синтаксиса наружу.
//
// Параметры:
//   Тело - Строка - Тело HTTP-запроса.
//
// Возвращаемое значение:
//   Структура - Поля Данные и Ошибка.
Функция Разобрать(Тело) Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Ошибка = НоваяОшибка(
			400,
			"Bad Request",
			"данные запроса",
			КодыСтандартныхОшибок.НекорректныеДанные(),
			"Тело запроса содержит неверный JSON"
		);

		Возврат Новый Структура("Данные,Ошибка", Неопределено, Ошибка);
	КонецПопытки;

	Возврат Новый Структура("Данные,Ошибка", Данные, Неопределено);

КонецФункции

// Проверяет договорные поля запроса конвертации.
//
// Параметры:
//   Данные - Соответствие, Произвольный - Разобранное тело JSON.
//
// Возвращаемое значение:
//   Структура, Неопределено - Описание ошибки или Неопределено.
Функция ПроверитьДанные(Данные) Экспорт

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"тело JSON",
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			"Тело JSON должно быть объектом"
		);
	КонецЕсли;

	Если ЕстьНеизвестноеПоле(Данные, "command,target,locale,generatorOptions") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"поля запроса",
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Запрос содержит неизвестное поле"
		);
	КонецЕсли;

	Команда = Данные.Получить("command");
	Если Команда = Неопределено Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"command",
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Поле command обязательно"
		);
	ИначеЕсли ТипЗнч(Команда) <> Тип("Строка") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"command",
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			"Поле command должно быть строкой"
		);
	ИначеЕсли ПустаяСтрока(СокрЛП(Команда)) Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"command",
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Поле command обязательно"
		);
	КонецЕсли;

	Ошибка = ПроверитьСтроковоеПоле(Данные, "target", "1c,connector", 422);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Ошибка = ПроверитьСтроковоеПоле(Данные, "locale", "ru,en", 400);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Возврат ПроверитьПараметрыГенератора(Данные.Получить("generatorOptions"));

КонецФункции

// Проверяет тип содержимого JSON.
//
// Параметры:
//   ТипСодержимого - Строка - Значение заголовка Content-Type.
//
// Возвращаемое значение:
//   Булево - Истина для application/json с необязательными параметрами.
Функция ЭтоТипСодержимогоJSON(ТипСодержимого) Экспорт

	ОсновнойТип = СокрЛП(СтрРазделить(НРег(ТипСодержимого), ";")[0]);

	Возврат ОсновнойТип = "application/json";

КонецФункции

// Возвращает значение HTTP-заголовка без учета регистра имени.
//
// Параметры:
//   Заголовки - Соответствие из КлючИЗначение - Заголовки запроса.
//   Имя - Строка - Имя заголовка.
//
// Возвращаемое значение:
//   Строка - Значение заголовка или пустая строка.
Функция ЗначениеЗаголовка(Заголовки, Имя) Экспорт

	Для Каждого Заголовок Из Заголовки Цикл

		Если НРег(Заголовок.Ключ) = НРег(Имя) Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Создает описание ошибки проверки запроса.
//
// Параметры:
//   Статус - Число - Код состояния HTTP.
//   ТекстСтатуса - Строка - Текст состояния HTTP.
//   ИмяДанных - Строка - Имя неверных данных.
//   Код - Строка - Машинный код ошибки.
//   Сообщение - Строка - Пользовательское сообщение.
//
// Возвращаемое значение:
//   Структура - Поля Статус, ТекстСтатуса и Ошибка.
Функция НоваяОшибка(Статус, ТекстСтатуса, ИмяДанных, Код, Сообщение) Экспорт

	Ошибка = ФабрикаОшибок.Создать(Код, Сообщение, Новый Структура("ИмяДанных", ИмяДанных));

	Возврат Новый Структура("Статус,ТекстСтатуса,Ошибка", Статус, ТекстСтатуса, Ошибка);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьСтроковоеПоле(Данные, Имя, ДопустимыеЗначения, Статус)

	Значение = Данные.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Сообщение = СтрШаблон("Поле %1 должно быть строкой", Имя);

		Возврат НоваяОшибка(
			400,
			"Bad Request",
			Имя,
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			Сообщение
		);
	ИначеЕсли Не ЗначениеРазрешено(Значение, ДопустимыеЗначения) Тогда
		Сообщение = СтрШаблон("Неизвестное значение поля %1", Имя);
		ТекстСтатуса = ?(Статус = 422, "Unprocessable Content", "Bad Request");

		Возврат НоваяОшибка(
			Статус,
			ТекстСтатуса,
			Имя,
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			Сообщение
		);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПроверитьПараметрыГенератора(Параметры)

	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"generatorOptions",
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			"Поле generatorOptions должно быть объектом"
		);
	ИначеЕсли ЕстьНеизвестноеПоле(Параметры, "responseDeserializationFormat") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"параметры генератора",
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Параметры генератора содержат неизвестное поле"
		);
	КонецЕсли;

	Значение = Параметры.Получить("responseDeserializationFormat");
	Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"responseDeserializationFormat",
			КодыСтандартныхОшибок.НеверныйТипАргумента(),
			"Поле responseDeserializationFormat должно быть строкой"
		);
	КонецЕсли;

	Если Значение <> Неопределено И Значение <> ФорматыДесериализацииОтветаCURL.JSON() Тогда
		Возврат НоваяОшибка(
			400,
			"Bad Request",
			"responseDeserializationFormat",
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Неизвестное значение поля responseDeserializationFormat"
		);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЕстьНеизвестноеПоле(Данные, РазрешенныеПоля)

	Для Каждого Поле Из Данные Цикл
		Если Не ЗначениеРазрешено(Поле.Ключ, РазрешенныеПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЗначениеРазрешено(Значение, РазрешенныеЗначения)

	Для Каждого РазрешенноеЗначение Из СтрРазделить(РазрешенныеЗначения, ",") Цикл

		Если Значение = РазрешенноеЗначение Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать jason
#Использовать "../../internal"

Перем _СериализаторJSON; // СериализаторJson

#Область ОбработчикиСобытий

// Создает формирователь договорных ответов API конвертации.
Процедура ПриСозданииОбъекта()

	_СериализаторJSON = Новый СериализаторJson;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Записывает результат конвертации в HTTP-ответ.
//
// Параметры:
//   Ответ - Ответ - Формируемый HTTP-ответ.
//   Результат - РезультатКонвертацииCURL - Результат конвертации.
//   ЗапрошеннаяЦель - Строка - Запрошенная цель генерации.
Процедура ЗаписатьРезультат(Ответ, Результат, ЗапрошеннаяЦель) Экспорт

	Данные = Новый ФормированиеДанныхРезультатаКонвертацииCURL().Сформировать(
		Результат,
		ЗапрошеннаяЦель
	);

	Если Результат.Успешно() Тогда
		Ответ.УстановитьСостояниеОК();
	Иначе
		Ответ.СостояниеКод = 422;
		Ответ.СостояниеТекст = "Unprocessable Content";
	КонецЕсли;

	ЗаписатьТелоJSON(Ответ, Данные);

КонецПроцедуры

// Записывает договорную ошибку в HTTP-ответ.
//
// Параметры:
//   Ответ - Ответ - Формируемый HTTP-ответ.
//   КодСостояния - Число - Код состояния HTTP.
//   ТекстСостояния - Строка - Текст состояния HTTP.
//   Ошибка - ИнформацияОбОшибке - Ошибка для внешнего представления.
Процедура ЗаписатьОшибку(Ответ, КодСостояния, ТекстСостояния, Ошибка) Экспорт

	СнимокОшибки = ДиагностикаОшибок.ЭффективнаяОшибка(Ошибка);

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура(
		"code,message,position",
		СнимокОшибки.КодОшибки(),
		СнимокОшибки.Сообщение(),
		Null
	));

	Данные = Новый Структура(
		"success,target,code,errors,warnings",
		Ложь,
		"",
		"",
		Ошибки,
		Новый Массив
	);

	Ответ.СостояниеКод = КодСостояния;
	Ответ.СостояниеТекст = ТекстСостояния;

	ЗаписатьТелоJSON(Ответ, Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьТелоJSON(Ответ, Данные)

	Ответ.УстановитьТипКонтента("json");
	Ответ.ТелоТекст = _СериализаторJSON.Сериализовать(Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает известную часть до первой переменной.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Проверенное выражение модели.
//
// Возвращаемое значение:
//   Строка - Литеральный префикс.
Функция Префикс(Выражение) Экспорт

	Результат = "";
	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид = "variable" Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Фрагмент.Значение;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет возможность короткого специального значения с учётом всех литеральных фрагментов.
// Повторные переменные рассматриваются независимо, сохраняя консервативную оценку.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Проверенное выражение модели.
//   Значение - Строка - Конечный маркер грамматики: пустая строка, -, . или @-.
//
// Возвращаемое значение:
//   Булево - Ложь, если литеральные части исключают значение.
Функция ДопускаетЗначение(Выражение, Значение) Экспорт

	Позиции = Новый Соответствие;
	Позиции.Вставить(0, Истина);
	Длина = СтрДлина(Значение);

	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Следующие = Новый Соответствие;
		Для Каждого Позиция Из Позиции Цикл
			Начало = Позиция.Ключ;
			Если Фрагмент.Вид = "variable" Тогда
				Для Конец = Начало По Длина Цикл
					Следующие.Вставить(Конец, Истина);
				КонецЦикла;
			Иначе
				Размер = СтрДлина(Фрагмент.Значение);
				Если Начало + Размер <= Длина И Сред(Значение, Начало + 1, Размер) = Фрагмент.Значение Тогда
					Следующие.Вставить(Начало + Размер, Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Позиции = Следующие;
		Если Позиции.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Позиции.Получить(Длина) = Истина;

КонецФункции

// Возвращает полностью известную схему из литерального префикса URL.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение адреса.
//
// Возвращаемое значение:
//   Строка - Схема в нижнем регистре либо пустая строка при неизвестной схеме.
Функция ИзвестнаяСхема(Выражение) Экспорт

	Начало = Префикс(Выражение);
	Разделитель = СтрНайти(Начало, "://");

	Если Разделитель = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(Лев(Начало, Разделитель - 1));

КонецФункции

// Определяет, могут ли учётные данные находиться в части URL перед путём.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение адреса.
//
// Возвращаемое значение:
//   Булево - Ложь для полностью известной части адреса без учётных данных.
Функция ДопускаетУчетныеДанные(Выражение) Экспорт

	Начало = Префикс(Выражение);
	Разделитель = СтрНайти(Начало, "://");

	Если Разделитель = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Адрес = Сред(Начало, Разделитель + 3);
	
	Для Позиция = 1 По СтрДлина(Адрес) Цикл
		Символ = Сред(Адрес, Позиция, 1);
		Если Символ = "@" Тогда
			Возврат Истина;
		ИначеЕсли Символ = "/" Или Символ = "?" Или Символ = "#" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

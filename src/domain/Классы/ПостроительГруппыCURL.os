#Использовать "../../shared"

Перем _URL; // Массив из ЭлементРазобраннойКомандыCURL
Перем _Результаты; // Массив из ОписаниеРезультатаCURL
Перем _Загрузки; // Массив из ЧастьТелаЗапросаCURL
Перем _Ошибки; // Массив из ИнформацияОбОшибке
// Поля элемента: Часть - ЧастьСтрокиЗапросаCURL, ПереносИзТела - Булево.
Перем _ИсточникиЧастейЗапроса; // Массив из Структура
Перем _ЧастиТела; // Массив из ЧастьТелаЗапросаCURL
Перем _Заголовки; // Массив из ОперацияНадЗаголовкомCURL
Перем _АвтоЗаголовки; // Массив из ОперацияНадЗаголовкомCURL
Перем _Агент; // ОперацияНадЗаголовкомCURL, Неопределено
Перем _Способы; // Массив из СпособАутентификацииCURL
Перем _СпособыПрокси; // Массив из СпособАутентификацииПроксиCURL
Перем _ЯвныйМетод; // ВыражениеЗначенияCURL, Неопределено
Перем _Переносить; // Булево
Перем _БезТела; // Булево
Перем _ТолькоИмена; // Булево
Перем _УчетныеДанные; // УчетныеДанныеCURL, Неопределено
Перем _OAuth2; // ТокенOAuth2CURL, Неопределено
Перем _AWS; // ПараметрыПодписиAWSV4CURL, Неопределено
Перем _Сертификат; // СертификатКлиентаCURL, Неопределено
Перем _УЦ; // ВыражениеЗначенияCURL, Неопределено
Перем _ИсточникУЦ; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _СистемноеХранилище; // Булево
Перем _ИсточникХранилища; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _Прокси; // ПроксиCURL, Неопределено
Перем _УчетныеДанныеПрокси; // УчетныеДанныеCURL, Неопределено
Перем _Таймаут; // ЧисловоеЗначениеCURL, Неопределено
Перем _ТаймаутСоединения; // ЧисловоеЗначениеCURL, Неопределено
Перем _РежимFTP; // Строка
Перем _АдресFTP; // ВыражениеЗначенияCURL, Неопределено
Перем _ИсточникFTP; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _Перенаправления; // Булево
Перем _ИсточникПеренаправлений; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _Повторы; // ЧисловоеЗначениеCURL, Неопределено
Перем _ВремяПовторов; // ЧисловоеЗначениеCURL, Неопределено
Перем _Каталог; // ВыражениеЗначенияCURL, Неопределено
Перем _СоздаватьКаталоги; // Булево
Перем _ИмяИзURL; // Булево
Перем _ИсточникИмениИзURL; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _Выбор; // Строка

#Область ОбработчикиСобытий

// Создаёт локальное состояние одной группы передачи.
Процедура ПриСозданииОбъекта()

	_URL = Новый Массив;
	_Результаты = Новый Массив;
	_Загрузки = Новый Массив;
	_Ошибки = Новый Массив;
	_ИсточникиЧастейЗапроса = Новый Массив;
	_ЧастиТела = Новый Массив;
	_Заголовки = Новый Массив;
	_АвтоЗаголовки = Новый Массив;
	_Способы = Новый Массив;
	_СпособыПрокси = Новый Массив;
	_Переносить = Ложь;
	_БезТела = Ложь;
	_ТолькоИмена = Ложь;
	_СистемноеХранилище = Ложь;
	_РежимFTP = РежимыСоединенияFTPCURL.Пассивный();
	_Перенаправления = Ложь;
	_СоздаватьКаталоги = Ложь;
	_ИмяИзURL = Ложь;
	_Выбор = "";

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Принимает нормализованное событие: ДобавитьURL.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Элемент события.
Процедура ДобавитьURL(Элемент) Экспорт

	_URL.Добавить(Элемент);

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьРезультат.
//
// Параметры:
//   Описание - ОписаниеРезультатаCURL - Описание события.
Процедура ДобавитьРезультат(Описание) Экспорт

	_Результаты.Добавить(Описание);

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьЗагрузку.
//
// Параметры:
//   Часть - ЧастьТелаЗапросаCURL - Часть события.
Процедура ДобавитьЗагрузку(Часть) Экспорт

	_Загрузки.Добавить(Часть);

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьЧастьЗапроса.
//
// Параметры:
//   Часть - ЧастьСтрокиЗапросаCURL - Часть события.
Процедура ДобавитьЧастьЗапроса(Часть) Экспорт

	_ИсточникиЧастейЗапроса.Добавить(Новый Структура("Часть, ПереносИзТела", Часть, Ложь));

КонецПроцедуры

// Принимает нормализованное событие: УстановитьЯвныйМетод.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение события.
Процедура УстановитьЯвныйМетод(Выражение) Экспорт

	_ЯвныйМетод = Выражение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьУчетныеДанные.
//
// Параметры:
//   Значение - УчетныеДанныеCURL - Значение события.
Процедура УстановитьУчетныеДанные(Значение) Экспорт

	_УчетныеДанные = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьOAuth2.
//
// Параметры:
//   Токен - ТокенOAuth2CURL - Токен события.
Процедура УстановитьOAuth2(Токен) Экспорт

	_OAuth2 = Токен;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьПодписьAWSV4.
//
// Параметры:
//   Параметры - ПараметрыПодписиAWSV4CURL - Параметры события.
Процедура УстановитьПодписьAWSV4(Параметры) Экспорт

	_AWS = Параметры;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьСертификатКлиента.
//
// Параметры:
//   Сертификат - СертификатКлиентаCURL - Сертификат события.
Процедура УстановитьСертификатКлиента(Сертификат) Экспорт

	_Сертификат = Сертификат;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьПрокси.
//
// Параметры:
//   Прокси - ПроксиCURL - Прокси события.
Процедура УстановитьПрокси(Прокси) Экспорт

	_Прокси = Прокси;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьУчетныеДанныеПрокси.
//
// Параметры:
//   Значение - УчетныеДанныеCURL - Значение события.
Процедура УстановитьУчетныеДанныеПрокси(Значение) Экспорт

	_УчетныеДанныеПрокси = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьТаймаут.
//
// Параметры:
//   Значение - ЧисловоеЗначениеCURL - Значение события.
Процедура УстановитьТаймаут(Значение) Экспорт

	_Таймаут = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьТаймаутСоединения.
//
// Параметры:
//   Значение - ЧисловоеЗначениеCURL - Значение события.
Процедура УстановитьТаймаутСоединения(Значение) Экспорт

	_ТаймаутСоединения = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьКоличествоПовторов.
//
// Параметры:
//   Значение - ЧисловоеЗначениеCURL - Значение события.
Процедура УстановитьКоличествоПовторов(Значение) Экспорт

	_Повторы = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьМаксимальноеВремяПовторов.
//
// Параметры:
//   Значение - ЧисловоеЗначениеCURL - Значение события.
Процедура УстановитьМаксимальноеВремяПовторов(Значение) Экспорт

	_ВремяПовторов = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьПереносДанныхВURL.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьПереносДанныхВURL(Значение, Источник) Экспорт

	_Переносить = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьТолькоИмена.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьТолькоИмена(Значение, Источник) Экспорт

	_ТолькоИмена = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьСозданиеКаталогов.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьСозданиеКаталогов(Значение, Источник) Экспорт

	_СоздаватьКаталоги = Значение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьКаталогРезультата.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьКаталогРезультата(Выражение, Источник) Экспорт

	_Каталог = Выражение;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьСертификатыУдостоверяющегоЦентра.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьСертификатыУдостоверяющегоЦентра(Выражение, Источник) Экспорт

	_УЦ = Выражение;
	_ИсточникУЦ = Источник;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьСистемноеХранилище.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьСистемноеХранилище(Значение, Источник) Экспорт

	_СистемноеХранилище = Значение;
	_ИсточникХранилища = Источник;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьПеренаправления.
//
// Параметры:
//   Следовать - Булево - Следовать события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьПеренаправления(Следовать, Источник) Экспорт

	_Перенаправления = Следовать;
	_ИсточникПеренаправлений = Источник;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьИмяИзURLПоУмолчанию.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьИмяИзURLПоУмолчанию(Значение, Источник) Экспорт

	_ИмяИзURL = Значение;
	_ИсточникИмениИзURL = Источник;

КонецПроцедуры

// Принимает нормализованное событие: ОтключитьПозиционноеИмяИзURL.
//
// Параметры:
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура ОтключитьПозиционноеИмяИзURL(Источник) Экспорт

	Если _ИмяИзURL Тогда
		ДобавитьРезультат(Новый ОписаниеРезультатаCURL(
			РежимыРезультатаCURL.СтандартныйВывод(),
			Неопределено,
			Неопределено,
			Ложь,
			Неопределено,
			Источник
		));
	КонецЕсли;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьРежимFTP.
//
// Параметры:
//   Режим - Строка - Режим события.
//   Адрес - ВыражениеЗначенияCURL, Неопределено - Адрес события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьРежимFTP(Режим, Адрес, Источник) Экспорт

	_РежимFTP = Режим;
	_АдресFTP = Адрес;
	_ИсточникFTP = Источник;

КонецПроцедуры

// Принимает нормализованное событие: УстановитьНеПолучатьТело.
//
// Параметры:
//   Значение - Булево - Значение события.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник события.
Процедура УстановитьНеПолучатьТело(Значение, Источник) Экспорт

	_БезТела = Значение;
	ВыбратьРежим(?(Значение, МетодыЗапросаПоУмолчаниюCURL.HEAD(), МетодыЗапросаПоУмолчаниюCURL.GET()), Источник);

КонецПроцедуры

// Принимает нормализованное событие: ИзменитьСпособАутентификации.
//
// Параметры:
//   Способ - СпособАутентификацииCURL - Способ события.
//   Добавить - Булево - Добавить события.
Процедура ИзменитьСпособАутентификации(Способ, Добавить) Экспорт

	ИзменитьСпособ(_Способы, Способ, Добавить);

КонецПроцедуры

// Принимает нормализованное событие: ИзменитьСпособАутентификацииПрокси.
//
// Параметры:
//   Способ - СпособАутентификацииПроксиCURL - Способ события.
//   Добавить - Булево - Добавить события.
Процедура ИзменитьСпособАутентификацииПрокси(Способ, Добавить) Экспорт

	ИзменитьСпособ(_СпособыПрокси, Способ, Добавить);

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьОшибки.
//
// Параметры:
//   Ошибки - Массив, ФиксированныйМассив из ИнформацияОбОшибке - Ошибки события.
Процедура ДобавитьОшибки(Ошибки) Экспорт

	Для Каждого Ошибка Из Ошибки Цикл
		_Ошибки.Добавить(Ошибка);
	КонецЦикла;

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьЗаголовок.
//
// Параметры:
//   Операция - ОперацияНадЗаголовкомCURL - Операция события.
Процедура ДобавитьЗаголовок(Операция) Экспорт

	Если Операция.Выражение() = Неопределено Тогда
		Для Каждого Имеющийся Из _АвтоЗаголовки Цикл
			Если Имеющийся.Имя() = Операция.Имя() Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;

		_АвтоЗаголовки.Добавить(Операция);
	ИначеЕсли Операция.Источник().ОписаниеОпции().КаноническоеИмя() = "user-agent" Тогда
		_Агент = Операция;
	Иначе
		_Заголовки.Добавить(Операция);
	КонецЕсли;

КонецПроцедуры

// Принимает нормализованное событие: ДобавитьЧастьТела.
//
// Параметры:
//   Часть - ЧастьТелаЗапросаCURL - Часть события.
Процедура ДобавитьЧастьТела(Часть) Экспорт

	Вид = ВидТелаЧасти(Часть);
	Если Вид = ВидыТелаЗапросаCURL.Multipart() Тогда
		ВыбратьРежим(МетодыЗапросаПоУмолчаниюCURL.POST(), Часть.Источник());
	КонецЕсли;

	Если _ЧастиТела.Количество() > 0 И ВидТелаЧасти(_ЧастиТела[0]) <> Вид Тогда
		ДобавитьОшибку(КодыОшибокCurlone.КонфликтТелаЗапроса(), "Несовместимые виды тела запроса", Часть.Источник());
	КонецЕсли;

	_ЧастиТела.Добавить(Часть);
	
	Если Вид = ВидыТелаЗапросаCURL.Данные() Тогда
		_ИсточникиЧастейЗапроса.Добавить(
			Новый Структура("Часть, ПереносИзТела",
				Новый ПравилаФормированияЗапросаCURL().ПеренестиДанныеВСтрокуЗапроса(Часть),
				Истина
			)
		);
	КонецЕсли;

КонецПроцедуры

// Формирует операции группы и накапливает независимые ошибки.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - ФиксированныйМассив операций либо ошибки.
Функция Построить() Экспорт

	ПроверитьОчереди();

	Если _URL.Количество() = 0 Тогда
		ДобавитьОшибку(КодыОшибокCurlone.НеУказанURL(), "В группе не указан URL", Неопределено);
	КонецЕсли;

	Если _РежимFTP = РежимыСоединенияFTPCURL.Активный()
		И _Прокси <> Неопределено И _Прокси.Режим() <> РежимыПроксиCURL.Отключен()
		И _Прокси.Режим() <> РежимыПроксиCURL.ОпределитьПослеВычисления() Тогда
		ДобавитьОшибку(КодыОшибокCurlone.КонфликтСоединения(), "Активный FTP несовместим с прокси", _ИсточникFTP);
	КонецЕсли;

	Операции = Новый Массив;
	Для Индекс = 0 По _URL.ВГраница() Цикл
		ЭлементURL = _URL[Индекс];
		ТокенURL = ЭлементURL.ТокенURL();

		Если ТокенURL = Неопределено Тогда
			ТокенURL = ЭлементURL.ТокенЗначения();
		КонецЕсли;

		Результат = Новый КлассификаторРесурсаCURL().Классифицировать(
			Новый ВыражениеЗначенияCURL(ТокенURL),
			ЭлементURL
		);

		Если Не Результат.Успешно() Тогда
			ДобавитьОшибки(Результат.Ошибки());
			Продолжить;
		КонецЕсли;

		Операции.Добавить(СоздатьОперацию(Результат.Значение(), Индекс));
	КонецЦикла;

	Если _Ошибки.Количество() > 0 Тогда
		Возврат Новый РезультатКлассификацииCURL(Неопределено, _Ошибки);
	КонецЕсли;

	Возврат Новый РезультатКлассификацииCURL(Новый ФиксированныйМассив(Операции), _Ошибки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОшибку(Код, Сообщение, Источник)

	_Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(Код, Сообщение, Источник));

КонецПроцедуры

Процедура ПроверитьОчереди()

	Для Индекс = _URL.Количество() По _Результаты.ВГраница() Цикл
		ДобавитьОшибку(
			КодыОшибокCurlone.НесопоставленнаяОпцияURL(),
			"Опции результата не соответствует URL",
			_Результаты[Индекс].Источник()
		);
	КонецЦикла;

	Для Индекс = _URL.Количество() По _Загрузки.ВГраница() Цикл
		ДобавитьОшибку(
			КодыОшибокCurlone.НесопоставленнаяОпцияURL(),
			"Опции загрузки не соответствует URL",
			_Загрузки[Индекс].Источник()
		);
	КонецЦикла;

КонецПроцедуры

Процедура ВыбратьРежим(Режим, Источник)

	Если _Выбор <> "" И _Выбор <> Режим Тогда
		ДобавитьОшибку(КодыОшибокCurlone.КонфликтРежимаЗапроса(), "Несовместимые режимы запроса", Источник);
	Иначе
		_Выбор = Режим;
	КонецЕсли;

КонецПроцедуры

Процедура ИзменитьСпособ(Способы, Способ, Добавить)

	Индекс = 0;
	Пока Индекс < Способы.Количество() Цикл
		Если Способы[Индекс].Вид() = Способ.Вид() Тогда
			Способы.Удалить(Индекс);
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Если Добавить Тогда
		Способы.Добавить(Способ);
	КонецЕсли;

КонецПроцедуры

Функция ВидТелаЧасти(Часть)

	Если Часть.Вид() = ВидыЧастейТелаЗапросаCURL.ПолеMultipart() Тогда
		Возврат ВидыТелаЗапросаCURL.Multipart();
	КонецЕсли;

	Отложенная = Часть.ОтложеннаяКлассификация();
	Если Отложенная <> Неопределено И (Отложенная.Грамматика() = ГрамматикиЗначенийCURL.Форма()
		Или Отложенная.Грамматика() = ГрамматикиЗначенийCURL.СтроковаяФорма()) Тогда
		Возврат ВидыТелаЗапросаCURL.Multipart();
	КонецЕсли;

	Возврат ВидыТелаЗапросаCURL.Данные();

КонецФункции

Функция СоздатьОперацию(КлассифицированныйРесурс, Индекс)

	Запрос = СоздатьЗапрос(КлассифицированныйРесурс, Индекс);

	Возврат Новый ОперацияCURL(
		КлассифицированныйРесурс.Ресурс(),
		Запрос,
		СоздатьСоединение(),
		СоздатьПолитики(),
		СоздатьРезультат(Индекс)
	);

КонецФункции

Функция СоздатьЗапрос(КлассифицированныйРесурс, Индекс)

	Ресурс = КлассифицированныйРесурс.Ресурс();
	ЧастиЗапроса = СоздатьЧастиСтрокиЗапроса();
	Тело = СоздатьТело(Индекс);
	Метод = Новый ПравилаФормированияЗапросаCURL().МетодПоУмолчанию(
		Ресурс.Протокол(),
		_БезТела,
		Тело.Вид()
	);
	Разделитель = ?(
		ЧастиЗапроса.Количество() = 0,
		РазделителиСтрокиЗапросаCURL.Нет(),
		КлассифицированныйРесурс.РазделительПередПервойЧастью()
	);
	УчетныеДанные = ?(_УчетныеДанные = Неопределено, КлассифицированныйРесурс.УчетныеДанные(), _УчетныеДанные);
	Заголовки = СоздатьЗаголовки();

	Возврат Новый ЗапросCURL(
		_ЯвныйМетод,
		Метод,
		_Переносить,
		_БезТела,
		_ТолькоИмена,
		Новый СтрокаЗапросаCURL(ЧастиЗапроса, Разделитель),
		Заголовки,
		Тело,
		Новый АутентификацияCURL(УчетныеДанные, _Способы, _OAuth2, _AWS)
	);

КонецФункции

Функция СоздатьЧастиСтрокиЗапроса()

	ЧастиЗапроса = Новый Массив;
	Для Каждого ИсточникЧасти Из _ИсточникиЧастейЗапроса Цикл
		Если Не ИсточникЧасти.ПереносИзТела Или _Переносить Тогда
			ЧастиЗапроса.Добавить(ИсточникЧасти.Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат ЧастиЗапроса;

КонецФункции

Функция СоздатьТело(Индекс)

	ЧастиТела = Новый Массив;
	ВидТела = ВидыТелаЗапросаCURL.Отсутствует();
	ИсточникТела = Неопределено;

	Для Каждого Часть Из _ЧастиТела Цикл
		ВидЧасти = ВидТелаЧасти(Часть);
		Если _Переносить И ВидЧасти = ВидыТелаЗапросаCURL.Данные() Тогда
			Продолжить;
		КонецЕсли;

		ВидТела = ВидЧасти;
		ИсточникТела = Часть.Источник();
		Разделитель = ?(ЧастиТела.Количество() = 0, РазделителиЧастейТелаCURL.Нет(), Часть.РазделительПеред());
		
		ЧастиТела.Добавить(Часть.СРазделителем(Разделитель));
	КонецЦикла;

	Если Индекс < _Загрузки.Количество() Тогда
		Загрузка = _Загрузки[Индекс];

		Если _ЧастиТела.Количество() > 0 Тогда
			ДобавитьОшибку(
				КодыОшибокCurlone.КонфликтТелаЗапроса(),
				"Загрузка несовместима с другими видами тела",
				Загрузка.Источник()
			);
		КонецЕсли;

		ЧастиТела = Новый Массив;
		ЧастиТела.Добавить(Загрузка);
		ВидТела = ВидыТелаЗапросаCURL.ЗагрузкаФайла();
		ИсточникТела = Загрузка.Источник();
	КонецЕсли;

	// Отложенный выбор проверяется для каждой передачи отдельно.
	Если ВидТела = ВидыТелаЗапросаCURL.Данные() Тогда
		ПроверитьОтложенныйВыбор(МетодыЗапросаПоУмолчаниюCURL.POST(), ИсточникТела);
	ИначеЕсли ВидТела = ВидыТелаЗапросаCURL.ЗагрузкаФайла() Тогда
		ПроверитьОтложенныйВыбор(МетодыЗапросаПоУмолчаниюCURL.PUT(), ИсточникТела);
	КонецЕсли;

	Возврат Новый ТелоЗапросаCURL(ВидТела, ЧастиТела, ИсточникТела);

КонецФункции

Функция СоздатьЗаголовки()

	Заголовки = Новый КоллекцииМоделиCURL().Скопировать(_Заголовки);
	
	Если _Агент <> Неопределено Тогда
		Заголовки.Добавить(_Агент);
	КонецЕсли;

	Для Каждого Заголовок Из _АвтоЗаголовки Цикл
		Заголовки.Добавить(Заголовок);
	КонецЦикла;

	Возврат Заголовки;

КонецФункции

Функция СоздатьСоединение()

	ИсточникСертификата = ?(_Сертификат = Неопределено, Неопределено, _Сертификат.Источник());
	TLS = Новый НастройкиTLSCURL(
		_Сертификат,
		_УЦ,
		_СистемноеХранилище,
		ИсточникСертификата,
		_ИсточникУЦ,
		_ИсточникХранилища
	);

	Возврат Новый СоединениеCURL(
		TLS,
		СоздатьПрокси(),
		_Таймаут,
		_ТаймаутСоединения,
		_РежимFTP,
		_АдресFTP
	);

КонецФункции

Функция СоздатьПолитики()

	Возврат Новый ПолитикиПередачиCURL(
		Новый ПолитикаПеренаправленийCURL(_Перенаправления, _ИсточникПеренаправлений),
		Новый ПолитикаПовторовCURL(_Повторы, _ВремяПовторов)
	);

КонецФункции

Процедура ПроверитьОтложенныйВыбор(Режим, Источник)

	Если _Выбор <> "" И _Выбор <> Режим Тогда
		ДобавитьОшибку(КодыОшибокCurlone.КонфликтРежимаЗапроса(), "Несовместимые режимы запроса", Источник);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьРезультат(Индекс)

	Если Индекс < _Результаты.Количество() Тогда
		Описание = _Результаты[Индекс];
		Возврат Новый ОписаниеРезультатаCURL(
			Описание.Режим(),
			Описание.ИмяФайла(),
			_Каталог,
			_СоздаватьКаталоги,
			Описание.ОтложеннаяКлассификация(),
			Описание.Источник()
		);
	КонецЕсли;

	Режим = ?(_ИмяИзURL, РежимыРезультатаCURL.ИмяИзURL(), РежимыРезультатаCURL.СтандартныйВывод());
	
	Возврат Новый ОписаниеРезультатаCURL(
		Режим,
		Неопределено,
		_Каталог,
		_СоздаватьКаталоги,
		Неопределено,
		_ИсточникИмениИзURL
	);

КонецФункции

Функция СоздатьПрокси()

	Прокси = _Прокси;
	Если Прокси = Неопределено Тогда
		Прокси = Новый ПроксиCURL(
			РежимыПроксиCURL.Отключен(),
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Новый Массив,
			Неопределено,
			Ложь,
			Неопределено,
			Неопределено
		);
	КонецЕсли;

	Данные = ?(_УчетныеДанныеПрокси = Неопределено, Прокси.УчетныеДанные(), _УчетныеДанныеПрокси);
	ИсточникДанных = ?(Данные = Неопределено, Неопределено, Данные.Источник());
	
	Возврат Новый ПроксиCURL(
		Прокси.Режим(),
		Прокси.Адрес(),
		Прокси.Протокол(),
		Прокси.Сервер(),
		Прокси.Порт(),
		Прокси.ПутьUnixСокета(),
		Данные,
		_СпособыПрокси,
		Прокси.ОтложеннаяКлассификация(),
		Прокси.ТребуетРазбора(),
		Прокси.ИсточникАдреса(),
		ИсточникДанных
	);

КонецФункции

#КонецОбласти

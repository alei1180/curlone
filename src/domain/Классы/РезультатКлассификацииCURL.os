#Использовать "../../shared"
#Использовать errors

Перем _Значение; // Произвольный, Неопределено
Перем _Ошибки; // ФиксированныйМассив из ИнформацияОбОшибке

#Область ОбработчикиСобытий

// Создаёт результат классификации значения команды curl.
//
// Параметры:
//   Значение - Произвольный - Результат успешной классификации или Неопределено.
//   Ошибки - Массив, ФиксированныйМассив из ИнформацияОбОшибке - Ошибки классификации.
//
// Исключения:
//   internal.invariant_violation - Наличие значения не соответствует наличию ошибок.
Процедура ПриСозданииОбъекта(Значение, Ошибки)

	УспешныйРезультат = Ошибки.Количество() = 0 И Значение <> Неопределено;
	НеуспешныйРезультат = Ошибки.Количество() > 0 И Значение = Неопределено;

	Если Не УспешныйРезультат И Не НеуспешныйРезультат Тогда
		ВызватьИсключение СтандартныеОшибки.НарушенВнутреннийИнвариант(
			"Успешный результат содержит значение, неуспешный результат содержит ошибки",
			"Наличие значения не соответствует наличию ошибок классификации"
		);
	КонецЕсли;

	_Значение = Значение;
	_Ошибки = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Ошибки));

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает признак успешной классификации.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибки отсутствуют.
Функция Успешно() Экспорт

	Возврат _Ошибки.Количество() = 0;

КонецФункции

// Возвращает классифицированное значение.
//
// Возвращаемое значение:
//   Произвольный - Значение при успехе или Неопределено.
Функция Значение() Экспорт

	Возврат _Значение;

КонецФункции

// Возвращает ошибки классификации.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ИнформацияОбОшибке - Ошибки классификации.
Функция Ошибки() Экспорт

	Возврат _Ошибки;

КонецФункции

#КонецОбласти

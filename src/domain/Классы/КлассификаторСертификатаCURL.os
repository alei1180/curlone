#Область ПрограммныйИнтерфейс

// Классифицирует выражение сертификата клиента.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение классификации.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник классификации.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Значение либо безопасные ошибки.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Сертификат = Новый СертификатКлиентаCURL(
			Выражение,
			Неопределено,
			Неопределено,
			Ложь,
			Истина,
			Источник
		);
		Возврат Новый РезультатКлассификацииCURL(Сертификат, Новый Массив);
	КонецЕсли;

	Значение = Выражение.ЛитеральноеЗначение();
	Если НРег(Лев(Значение, 7)) = "pkcs11:" Тогда
		Сертификат = Новый СертификатКлиентаCURL(
			Выражение,
			Значение,
			Неопределено,
			Ложь,
			Ложь,
			Источник
		);
		Возврат Новый РезультатКлассификацииCURL(Сертификат, Новый Массив);
	КонецЕсли;

	ПозицияПароля = ПозицияНеэкранированногоДвоеточия(Значение);
	Если ПозицияПароля = 2 И СтрДлина(Значение) > 2
		И (Сред(Значение, 3, 1) = "\" Или Сред(Значение, 3, 1) = "/") Тогда
		ПозицияПароля = ПозицияНеэкранированногоДвоеточия(Значение, 3);
	КонецЕсли;

	Если ПозицияПароля = 0 Тогда
		Путь = Значение;
		Пароль = Неопределено;
		ПарольУказан = Ложь;
	Иначе
		Путь = Лев(Значение, ПозицияПароля - 1);
		Пароль = Сред(Значение, ПозицияПароля + 1);
		ПарольУказан = Истина;
	КонецЕсли;

	Сертификат = Новый СертификатКлиентаCURL(
		Выражение,
		Раскодировать(Путь),
		Раскодировать(Пароль),
		ПарольУказан,
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Сертификат, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПозицияНеэкранированногоДвоеточия(Значение, НачальнаяПозиция = 1)
	
	Экранирован = Ложь;
	
	Для Индекс = НачальнаяПозиция По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если Символ = ":" И Не Экранирован Тогда
			Возврат Индекс;
		КонецЕсли;
		Если Символ = "\" Тогда
			Экранирован = Не Экранирован;
		Иначе
			Экранирован = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция Раскодировать(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрЗаменить(СтрЗаменить(Значение, "\:", ":"), "\""", """");

КонецФункции

#КонецОбласти

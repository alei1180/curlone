#Использовать url
#Использовать "../../syntax"

#Область ПрограммныйИнтерфейс

// Разбирает литеральный URL через библиотеку url.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Литеральное выражение URL.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с РазобранныйURLCURL либо безопасной ошибкой.
Функция ПопытатьсяРазобратьЛитерал(Выражение, Источник) Экспорт

	Адрес = Выражение.ЛитеральноеЗначение();
	Если Адрес = "" Тогда
		Возврат ОшибкаРазбора(Источник);
	КонецЕсли;

	Адрес = СтрЗаменить(СтрЗаменить(Адрес, "\{", "%7B"), "\}", "%7D");
	Адрес = СтрЗаменить(СтрЗаменить(Адрес, "\[", "%5B"), "\]", "%5D");
	АдресСоСхемой = НормализоватьСхему(Адрес);
	
	Если АдресСоСхемой = Неопределено Тогда
		Возврат ОшибкаРазбора(Источник);
	КонецЕсли;
	
	Попытка
		ОбъектURL = Новый URL(АдресСоСхемой);

		Если НРег(ОбъектURL.Схема()) <> ПротоколыCURL.FILE() И ПустаяСтрока(ОбъектURL.Хост()) Тогда
			Возврат ОшибкаРазбора(Источник);
		КонецЕсли;

		Порт = ОбъектURL.Порт();
		Если Порт <> Неопределено И (Порт < 0 Или Порт > 65535) Тогда
			Возврат ОшибкаРазбора(Источник);
		КонецЕсли;
	Исключение
		Возврат ОшибкаРазбора(Источник);
	КонецПопытки;

	ДанныеПользователя = ОбъектURL.КодированныеДанныеПользователя();
	ЗапросУказан = ОбъектURL.КодированнаяСтрокаЗапроса() <> Неопределено;
	Фрагмент = ОбъектURL.КодированныйФрагмент();
	ФрагментУказан = Фрагмент <> Неопределено;
	
	ОбъектURL.УстановитьКодированныеДанныеПользователя(Неопределено);
	ОбъектURL.УстановитьКодированныйФрагмент(Неопределено);
	
	ОчищенныйАдрес = СоздатьВыражение(ОбъектURL.ВСтроку());

	Разобранный = Новый РазобранныйURLCURL(
		ОчищенныйАдрес,
		НРег(ОбъектURL.Схема()),
		ДанныеПользователя,
		ЗапросУказан,
		Фрагмент,
		ФрагментУказан
	);

	Возврат Новый РезультатКлассификацииCURL(Разобранный, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьСхему(Адрес)

	ПозицияДвоеточия = СтрНайти(Адрес, ":");
	Если ПозицияДвоеточия < 2 Или Сред(Адрес, ПозицияДвоеточия + 1, 1) <> "/" Тогда
		Возврат ОпределитьСхему(Адрес) + "://" + Адрес;
	КонецЕсли;

	Схема = Лев(Адрес, ПозицияДвоеточия - 1);
	Буквы = "abcdefghijklmnopqrstuvwxyz";

	Для Индекс = 1 По СтрДлина(Схема) Цикл
		ДопустимыеСимволы = ?(Индекс = 1, Буквы, Буквы + "0123456789+.-");
		Если СтрНайти(ДопустимыеСимволы, НРег(Сред(Схема, Индекс, 1))) = 0 Тогда
			Возврат ОпределитьСхему(Адрес) + "://" + Адрес;
		КонецЕсли;
	КонецЦикла;

	НачалоСодержимого = ПозицияДвоеточия + 1;
	Пока Сред(Адрес, НачалоСодержимого, 1) = "/" Цикл
		НачалоСодержимого = НачалоСодержимого + 1;
	КонецЦикла;

	КоличествоЧерточек = НачалоСодержимого - ПозицияДвоеточия - 1;
	Если КоличествоЧерточек > 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НРег(Схема) = ПротоколыCURL.FILE() Тогда
		Если КоличествоЧерточек = 1 Тогда
			Возврат Схема + ":///" + Сред(Адрес, НачалоСодержимого);
		КонецЕсли;
		Возврат Адрес;
	КонецЕсли;

	Возврат Схема + "://" + Сред(Адрес, НачалоСодержимого);

КонецФункции

Функция ОпределитьСхему(Адрес)
	
	АдресСервера = СтрРазделить(Адрес, "/?#", Истина)[0];
	ЧастиАдресаСервера = СтрРазделить(АдресСервера, "@", Истина);
	Хост = ЧастиАдресаСервера[ЧастиАдресаСервера.ВГраница()];
	Поддомен = НРег(СтрРазделить(Хост, ".", Истина)[0]);
	
	Если ЭтоПротоколПоИмениУзла(Поддомен) Тогда
		Возврат Поддомен;
	КонецЕсли;

	Возврат ПротоколыCURL.HTTP();

КонецФункции

Функция ЭтоПротоколПоИмениУзла(ИмяУзла)

	Возврат ИмяУзла = ПротоколыCURL.DICT()
		Или ИмяУзла = ПротоколыCURL.FTP()
		Или ИмяУзла = ПротоколыCURL.IMAP()
		Или ИмяУзла = ПротоколыCURL.LDAP()
		Или ИмяУзла = ПротоколыCURL.POP3()
		Или ИмяУзла = ПротоколыCURL.SMTP();

КонецФункции

Функция СоздатьВыражение(Адрес)

	Аргументы = Новый Массив;
	Аргументы.Добавить(Адрес);
	Токен = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены()[0];
	
	Возврат Новый ВыражениеЗначенияCURL(Токен);

КонецФункции

Функция ОшибкаРазбора(Источник)

	Ошибка = Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НедопустимыйURL(),
		"URL имеет недопустимый формат",
		Источник
	);

	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

#КонецОбласти

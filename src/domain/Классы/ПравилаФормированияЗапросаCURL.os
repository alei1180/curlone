#Область СлужебныйПрограммныйИнтерфейс

// Выбирает метод запроса по протоколу и окончательному виду тела.
//
// Параметры:
//   Протокол - Строка, Неопределено - Протокол ресурса.
//   БезТела - Булево - Получать только заголовки ответа.
//   ВидТела - Строка - Значение ВидыТелаЗапросаCURL.
//
// Возвращаемое значение:
//   Строка - Значение МетодыЗапросаПоУмолчаниюCURL.
Функция МетодПоУмолчанию(Протокол, БезТела, ВидТела) Экспорт

	Если Протокол <> ПротоколыCURL.HTTP() И Протокол <> ПротоколыCURL.HTTPS() Тогда
		Возврат МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола();
	ИначеЕсли БезТела Тогда
		Возврат МетодыЗапросаПоУмолчаниюCURL.HEAD();
	ИначеЕсли ВидТела = ВидыТелаЗапросаCURL.ЗагрузкаФайла() Тогда
		Возврат МетодыЗапросаПоУмолчаниюCURL.PUT();
	ИначеЕсли ВидТела <> ВидыТелаЗапросаCURL.Отсутствует() Тогда
		Возврат МетодыЗапросаПоУмолчаниюCURL.POST();
	КонецЕсли;

	Возврат МетодыЗапросаПоУмолчаниюCURL.GET();

КонецФункции

// Переносит данные тела в строку запроса, сохраняя отложенную классификацию.
//
// Параметры:
//   Часть - ЧастьТелаЗапросаCURL - Часть, созданная классификатором данных.
//
// Возвращаемое значение:
//   ЧастьСтрокиЗапросаCURL - Часть строки запроса.
Функция ПеренестиДанныеВСтрокуЗапроса(Часть) Экспорт

	Возврат СоздатьЧастьСтрокиЗапроса(
		Часть,
		Часть.ИмяПоля(),
		Часть.ОтложеннаяКлассификация(),
		Часть.ТребуетРазбора()
	);

КонецФункции

// Завершает перенос вычисленных данных, сохраняя ранее определенное имя поля.
//
// Параметры:
//   Часть - ЧастьТелаЗапросаCURL - Успешно классифицированная часть данных.
//   ИсходнаяЧасть - ЧастьСтрокиЗапросаCURL - Часть до вычисления переменных.
//
// Возвращаемое значение:
//   ЧастьСтрокиЗапросаCURL - Часть без отложенной классификации.
Функция ПеренестиВычисленныеДанныеВСтрокуЗапроса(Часть, ИсходнаяЧасть) Экспорт

	Имя = ?(Часть.ИмяПоля() = Неопределено, ИсходнаяЧасть.Имя(), Часть.ИмяПоля());
	Возврат СоздатьЧастьСтрокиЗапроса(Часть, Имя, Неопределено, Ложь);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЧастьСтрокиЗапроса(Часть, Имя, Отложенная, ТребуетРазбора)

	Если ТребуетРазбора Тогда
		Вид = ВидыИсточниковЧастиСтрокиЗапросаCURL.ОпределитьПослеВычисления();
	ИначеЕсли Часть.РежимИсточника() = РежимыИсточникаТелаCURL.СтандартныйВвод() Тогда
		Вид = ВидыИсточниковЧастиСтрокиЗапросаCURL.СтандартныйВвод();
	ИначеЕсли Часть.ПутьКФайлу() <> Неопределено Тогда
		Вид = ВидыИсточниковЧастиСтрокиЗапросаCURL.Файл();
	Иначе
		Вид = ВидыИсточниковЧастиСтрокиЗапросаCURL.Текст();
	КонецЕсли;

	Возврат Новый ЧастьСтрокиЗапросаCURL(
		Вид,
		Часть.Выражение(),
		Имя,
		Часть.Текст(),
		Часть.ПутьКФайлу(),
		Часть.Кодировать(),
		Имя <> Неопределено,
		Отложенная,
		Часть.Источник(),
		Часть.РежимИсточника()
	);

КонецФункции

#КонецОбласти

#Использовать errors

Перем _Обработчики; // ФиксированноеСоответствие из КлючИЗначение: Строка, объект обработчика

#Область ОбработчикиСобытий

// Создаёт неизменяемый реестр семи семантических обработчиков.
//
// Исключения:
//   internal.invariant_violation - Повторный идентификатор обработчика.
Процедура ПриСозданииОбъекта()

	Обработчики = Новый Соответствие;
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.РесурсИРезультат(),
		Новый ОбработчикОпцийРесурсаИРезультатаCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.ЗапросИЗаголовки(),
		Новый ОбработчикОпцийЗапросаИЗаголовковCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.Тело(),
		Новый ОбработчикОпцийТелаCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.Аутентификация(),
		Новый ОбработчикОпцийАутентификацииCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.TLS(),
		Новый ОбработчикОпцийTLSCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.Прокси(),
		Новый ОбработчикОпцийПроксиCURL());
	Зарегистрировать(Обработчики, ИдентификаторыОбработчиковОпцийCURL.СоединениеИПолитики(),
		Новый ОбработчикОпцийСоединенияИПолитикCURL());

	_Обработчики = Новый ФиксированноеСоответствие(Обработчики);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает обработчик по идентификатору каталога.
//
// Параметры:
//   Идентификатор - Строка - Идентификатор семантического обработчика.
//
// Возвращаемое значение:
//   Произвольный - Обработчик с процедурой Применить.
//
// Исключения:
//   internal.invariant_violation - Идентификатор пуст или отсутствует.
Функция НайтиОбработчик(Идентификатор) Экспорт

	Обработчик = _Обработчики.Получить(Идентификатор);
	Если Обработчик = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НарушенВнутреннийИнвариант(
			"Обработчик зарегистрирован", 
			"Семантический обработчик отсутствует"
		);
	КонецЕсли;

	Возврат Обработчик;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Зарегистрировать(Обработчики, Идентификатор, Обработчик)

	Если Идентификатор = "" Или Обработчики.Получить(Идентификатор) <> Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НарушенВнутреннийИнвариант(
			"Идентификатор непуст и уникален",
			"Повторная регистрация семантического обработчика"
		);
	КонецЕсли;

	Обработчики.Вставить(Идентификатор, Обработчик);

КонецПроцедуры

#КонецОбласти


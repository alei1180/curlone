Перем _АдресДляВыполнения; // ВыражениеЗначенияCURL
Перем _Протокол; // Строка
Перем _КодированныеДанныеПользователя; // Строка, Неопределено
Перем _СтрокаЗапросаУказана; // Булево
Перем _Фрагмент; // Строка, Неопределено
Перем _ФрагментУказан; // Булево

#Область ОбработчикиСобытий

// Создаёт неизменяемый результат разбора URL.
//
// Параметры:
//   АдресДляВыполнения - ВыражениеЗначенияCURL - Адрес без данных пользователя и фрагмента.
//   Протокол - Строка - Схема в нижнем регистре.
//   КодированныеДанныеПользователя - Строка, Неопределено - Данные пользователя.
//   СтрокаЗапросаУказана - Булево - Признак наличия вопросительного знака.
//   Фрагмент - Строка, Неопределено - Декодированный фрагмент.
//   ФрагментУказан - Булево - Признак наличия решётки.
Процедура ПриСозданииОбъекта(
	АдресДляВыполнения,
	Протокол,
	КодированныеДанныеПользователя,
	СтрокаЗапросаУказана,
	Фрагмент,
	ФрагментУказан
)

	_АдресДляВыполнения = АдресДляВыполнения;
	_Протокол = Протокол;
	_КодированныеДанныеПользователя = КодированныеДанныеПользователя;
	_СтрокаЗапросаУказана = СтрокаЗапросаУказана;
	_Фрагмент = Фрагмент;
	_ФрагментУказан = ФрагментУказан;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает адрес для выполнения.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Очищенный адрес.
Функция АдресДляВыполнения() Экспорт
	Возврат _АдресДляВыполнения;
КонецФункции

// Возвращает протокол.
//
// Возвращаемое значение:
//   Строка - Схема в нижнем регистре.
Функция Протокол() Экспорт
	Возврат _Протокол;
КонецФункции

// Возвращает кодированные данные пользователя.
//
// Возвращаемое значение:
//   Строка, Неопределено - Данные пользователя.
Функция КодированныеДанныеПользователя() Экспорт
	Возврат _КодированныеДанныеПользователя;
КонецФункции

// Возвращает признак наличия строки запроса.
//
// Возвращаемое значение:
//   Булево - Признак наличия вопросительного знака.
Функция СтрокаЗапросаУказана() Экспорт
	Возврат _СтрокаЗапросаУказана;
КонецФункции

// Возвращает фрагмент.
//
// Возвращаемое значение:
//   Строка, Неопределено - Декодированный фрагмент.
Функция Фрагмент() Экспорт
	Возврат _Фрагмент;
КонецФункции

// Возвращает признак наличия фрагмента.
//
// Возвращаемое значение:
//   Булево - Признак наличия решётки.
Функция ФрагментУказан() Экспорт
	Возврат _ФрагментУказан;
КонецФункции

#КонецОбласти

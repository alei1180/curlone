Перем _Выражение; // ВыражениеЗначенияCURL
Перем _Грамматика; // Строка
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт описание классификации значения после вычисления переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение с переменными.
//   Грамматика - Строка - Значение из модуля ГрамматикиЗначенийCURL.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
Процедура ПриСозданииОбъекта(Выражение, Грамматика, Источник)

	_Выражение = Выражение;
	_Грамматика = Грамматика;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает выражение для последующего вычисления.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Выражение с переменными.
Функция Выражение() Экспорт

	Возврат _Выражение;

КонецФункции

// Возвращает грамматику вычисленного значения.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ГрамматикиЗначенийCURL.
Функция Грамматика() Экспорт

	Возврат _Грамматика;

КонецФункции

// Возвращает исходный элемент команды.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Опция или URL, создавшие отложенную классификацию.
Функция Источник() Экспорт

	Возврат _Источник;

КонецФункции

#КонецОбласти

Перем _Ресурс; // АдресПередачиCURL
Перем _Запрос; // ЗапросCURL
Перем _Соединение; // НастройкиСоединенияCURL
Перем _Политики; // ПолитикиПередачиCURL
Перем _Результат; // ОписаниеРезультатаCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемую операцию передачи.
//
// Параметры:
//   Ресурс - АдресПередачиCURL - Адрес передачи.
//   Запрос - ЗапросCURL - Параметры запроса.
//   Соединение - НастройкиСоединенияCURL - Параметры соединения.
//   Политики - ПолитикиПередачиCURL - Политики передачи.
//   Результат - ОписаниеРезультатаCURL - Назначение результата.
Процедура ПриСозданииОбъекта(
	Ресурс,
	Запрос,
	Соединение,
	Политики,
	Результат
)

	_Ресурс = Ресурс;
	_Запрос = Запрос;
	_Соединение = Соединение;
	_Политики = Политики;
	_Результат = Результат;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Адрес передачи.
//
// Возвращаемое значение:
//   АдресПередачиCURL - Адрес передачи.
Функция Ресурс() Экспорт

	Возврат _Ресурс;

КонецФункции

// Параметры запроса.
//
// Возвращаемое значение:
//   ЗапросCURL - Параметры запроса.
Функция Запрос() Экспорт

	Возврат _Запрос;

КонецФункции

// Параметры соединения.
//
// Возвращаемое значение:
//   НастройкиСоединенияCURL - Параметры соединения.
Функция Соединение() Экспорт

	Возврат _Соединение;

КонецФункции

// Политики передачи.
//
// Возвращаемое значение:
//   ПолитикиПередачиCURL - Политики передачи.
Функция Политики() Экспорт

	Возврат _Политики;

КонецФункции

// Назначение результата.
//
// Возвращаемое значение:
//   ОписаниеРезультатаCURL - Назначение результата.
Функция Результат() Экспорт

	Возврат _Результат;

КонецФункции

#КонецОбласти

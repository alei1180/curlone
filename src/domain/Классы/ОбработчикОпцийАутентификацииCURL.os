#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю группы.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительГруппыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;
	
	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "user" Тогда
		Результат = Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Элемент);
		
		Если Результат.Успешно() Тогда
			Построитель.УстановитьУчетныеДанные(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	ИначеЕсли Имя = "aws-sigv4" Тогда
		Результат = Новый КлассификаторАутентификацииCURL().ПодписьAWSV4(Выражение, Элемент);
		
		Если Результат.Успешно() Тогда
			Построитель.УстановитьПодписьAWSV4(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	ИначеЕсли Имя = "oauth2-bearer" Тогда
		Построитель.УстановитьOAuth2(Новый ТокенOAuth2CURL(Выражение, Элемент));
	Иначе
		Если Имя = "basic" Тогда
			Вид = СпособыАутентификацииCURL.Basic();
		ИначеЕсли Имя = "digest" Тогда
			Вид = СпособыАутентификацииCURL.Digest();
		ИначеЕсли Имя = "ntlm" Тогда
			Вид = СпособыАутентификацииCURL.NTLM();
		Иначе
			Вид = СпособыАутентификацииCURL.Negotiate();
		КонецЕсли;
		
		Построитель.ИзменитьСпособАутентификации(Новый СпособАутентификацииCURL(Вид, Элемент), Включить);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


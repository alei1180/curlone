#Область ПрограммныйИнтерфейс

// Классифицирует значение опции семейства данных.
//
// Параметры:
//   ИмяОпции - Строка - Каноническое имя опции.
//   Выражение - ВыражениеЗначенияCURL - Значение опции.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//   РазделительПеред - Строка - Значение из модуля РазделителиЧастейТелаCURL.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с частью тела.
Функция Классифицировать(ИмяОпции, Выражение, Источник, РазделительПеред) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Грамматика = ГрамматикаПоИмени(ИмяОпции);
		Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение, Грамматика, Источник);
		Часть = СоздатьЧасть(
			ВидыЧастейТелаЗапросаCURL.ОпределитьПослеВычисления(),
			РежимыИсточникаТелаCURL.ОпределитьПослеВычисления(),
			Выражение,
			Неопределено,
			Неопределено,
			Ложь,
			РазделительПеред,
			Отложенная,
			Источник
		);
		Возврат Успех(Часть);
	КонецЕсли;

	Текст = Выражение.ЛитеральноеЗначение();
	Если ИмяОпции = "data-urlencode" Тогда
		Возврат КлассифицироватьКодированныеДанные(Выражение, Источник, РазделительПеред);
	КонецЕсли;

	СсылкаНаФайл = Лев(Текст, 1) = "@" И ИмяОпции <> "data-raw";
	Если СсылкаНаФайл Тогда
		Путь = Сред(Текст, 2);
		Режим = РежимФайла(ИмяОпции, Путь);

		Если Путь = "-" Тогда
			Путь = Неопределено;
		КонецЕсли;

		Кодировать = ИмяОпции = "data-urlencode";
		Часть = СоздатьЧасть(
			ВидыЧастейТелаЗапросаCURL.Данные(),
			Режим,
			Выражение,
			Неопределено,
			Путь,
			Кодировать,
			РазделительПеред,
			Неопределено,
			Источник
		);
	Иначе
		Кодировать = ИмяОпции = "data-urlencode";
		Часть = СоздатьЧасть(
			ВидыЧастейТелаЗапросаCURL.Данные(),
			РежимыИсточникаТелаCURL.ЛитеральноеЗначение(),
			Выражение,
			Текст,
			Неопределено,
			Кодировать,
			РазделительПеред,
			Неопределено,
			Источник
		);
	КонецЕсли;

	Возврат Успех(Часть);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьКодированныеДанные(Выражение, Источник, РазделительПеред)

	Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(Выражение, Источник, Ложь);
	ЧастьЗапроса = Результат.Значение();

	Если ЧастьЗапроса.ВидИсточника() = ВидыИсточниковЧастиСтрокиЗапросаCURL.СтандартныйВвод() Тогда
		Режим = РежимыИсточникаТелаCURL.СтандартныйВвод();
	ИначеЕсли ЧастьЗапроса.ПутьКФайлу() = Неопределено Тогда
		Режим = РежимыИсточникаТелаCURL.ЛитеральноеЗначение();
	Иначе
		Режим = РежимыИсточникаТелаCURL.ДвоичныйФайл();
	КонецЕсли;

	Содержимое = Новый СодержимоеЧастиТелаCURL(Режим, Выражение, ЧастьЗапроса.Текст(), ЧастьЗапроса.ПутьКФайлу());
	Поле = Новый ОписаниеПоляТелаCURL(ЧастьЗапроса.Имя(), Неопределено, Неопределено, Новый Массив);
	Часть = Новый ЧастьТелаЗапросаCURL(
		ВидыЧастейТелаЗапросаCURL.Данные(),
		Содержимое,
		Поле,
		Истина,
		РазделительПеред,
		Неопределено,
		Источник
	);

	Возврат Успех(Часть);

КонецФункции

Функция СоздатьЧасть(
	Вид,
	Режим,
	Выражение,
	Текст,
	Путь,
	Кодировать,
	Разделитель,
	Отложенная,
	Источник
)

	Содержимое = Новый СодержимоеЧастиТелаCURL(Режим, Выражение, Текст, Путь);
	Поле = Новый ОписаниеПоляТелаCURL(Неопределено, Неопределено, Неопределено, Новый Массив);

	Возврат Новый ЧастьТелаЗапросаCURL(
		Вид,
		Содержимое,
		Поле,
		Кодировать,
		Разделитель,
		Отложенная,
		Источник
	);

КонецФункции

Функция РежимФайла(ИмяОпции, Путь)

	Если Путь = "-" Тогда
		Возврат РежимыИсточникаТелаCURL.СтандартныйВвод();
	КонецЕсли;

	Если ИмяОпции = "data" Или ИмяОпции = "data-ascii" Тогда
		Возврат РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL();
	КонецЕсли;

	Возврат РежимыИсточникаТелаCURL.ДвоичныйФайл();

КонецФункции

Функция ГрамматикаПоИмени(Имя)

	Если Имя = "data" Или Имя = "data-ascii" Тогда
		Возврат ГрамматикиЗначенийCURL.Данные();
	КонецЕсли;

	Если Имя = "data-raw" Тогда
		Возврат ГрамматикиЗначенийCURL.ДанныеБезСсылкиНаФайл();
	КонецЕсли;

	Если Имя = "data-binary" Тогда
		Возврат ГрамматикиЗначенийCURL.ДвоичныеДанные();
	КонецЕсли;

	Если Имя = "data-urlencode" Тогда
		Возврат ГрамматикиЗначенийCURL.КодированныеДанные();
	КонецЕсли;

	Возврат ГрамматикиЗначенийCURL.JSON();

КонецФункции

Функция Успех(Значение)
	Возврат Новый РезультатКлассификацииCURL(Значение, Новый Массив);
КонецФункции

#КонецОбласти

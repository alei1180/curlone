#Использовать errors
#Использовать "../../syntax"
#Использовать "../../public"

#Область ПрограммныйИнтерфейс

// Вычисляет переменные и завершает отложенную классификацию операции curl.
//
// Параметры:
//   Операция - ОперацияПередачиCURL - Операция с отложенными значениями.
//   ЗначенияПеременных - Соответствие, ФиксированноеСоответствие из Строка - Значения переменных.
//
// Возвращаемое значение:
//   РезультатИнтерпретацииCURL - Одна материализованная операция либо безопасные ошибки.
Функция Материализовать(Операция, ЗначенияПеременных) Экспорт

	Контекст = Новый Структура("Переменные, Ошибки", ЗначенияПеременных, Новый Массив);
	НоваяОперация = МатериализоватьОперацию(Операция, Контекст);

	Если Контекст.Ошибки.Количество() > 0 Тогда
		Возврат Новый РезультатИнтерпретацииCURL(Неопределено, Контекст.Ошибки);
	КонецЕсли;

	Операции = Новый Массив;
	Операции.Добавить(НоваяОперация);

	Возврат Новый РезультатИнтерпретацииCURL(Новый ОписаниеВыполненияCURL(Операции), Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МатериализоватьОперацию(Операция, Контекст)

	КоличествоОшибок = Контекст.Ошибки.Количество();
	РесурсИРазделитель = МатериализоватьРесурс(Операция.Ресурс(), Контекст);
	РесурсМатериализован = Контекст.Ошибки.Количество() = КоличествоОшибок;
	Запрос = МатериализоватьЗапрос(Операция.Запрос(), РесурсИРазделитель, Контекст);
	Соединение = МатериализоватьСоединение(
		Операция.Соединение(),
		РесурсИРазделитель.Ресурс,
		РесурсМатериализован,
		Контекст
	);
	Политики = МатериализоватьПолитики(Операция.Политики(), Контекст);
	Результат = МатериализоватьРезультат(Операция.Результат(), РесурсИРазделитель.Ресурс, Контекст);

	Возврат Новый ОперацияПередачиCURL(
		РесурсИРазделитель.Ресурс,
		Запрос,
		Соединение,
		Политики,
		Результат
	);

КонецФункции

Функция МатериализоватьРесурс(Ресурс, Контекст)

	Если Ресурс.ОтложеннаяКлассификация() = Неопределено Тогда
		Возврат СоздатьРесурсИРазделитель(Ресурс);
	КонецЕсли;

	Результат = Классифицировать(Ресурс.ОтложеннаяКлассификация(), Контекст, Ресурс);
	Если Результат = Неопределено Тогда
		Возврат СоздатьРесурсИРазделитель(Ресурс);
	КонецЕсли;

	Возврат СоздатьРесурсИРазделитель(
		Результат.Ресурс(),
		Результат.УчетныеДанные(),
		Результат.РазделительПередПервойЧастью()
	);

КонецФункции

Функция СоздатьРесурсИРазделитель(
	Ресурс,
	УчетныеДанные = Неопределено,
	Разделитель = Неопределено
)

	Возврат Новый Структура(
		"Ресурс, УчетныеДанные, Разделитель",
		Ресурс,
		УчетныеДанные,
		Разделитель
	);

КонецФункции

Функция МатериализоватьЗапрос(Запрос, РесурсИРазделитель, Контекст)

	Части = Новый Массив;
	Для Каждого Часть Из Запрос.СтрокаЗапроса().Части() Цикл
		МатериализованнаяЧасть = МатериализоватьОтложенноеЗначение(
			Часть,
			Часть.ОтложеннаяКлассификация(),
			Контекст
		);

		Если ТипЗнч(МатериализованнаяЧасть) = Тип("ЧастьТелаЗапросаCURL") Тогда
			МатериализованнаяЧасть = Новый ПравилаФормированияЗапросаCURL()
				.ПеренестиВычисленныеДанныеВСтрокуЗапроса(МатериализованнаяЧасть, Часть);
		КонецЕсли;

		Части.Добавить(МатериализованнаяЧасть);
	КонецЦикла;

	Разделитель = Запрос.СтрокаЗапроса().РазделительПередПервойЧастью();
	Если Части.Количество() = 0 Тогда
		Разделитель = РазделителиСтрокиЗапросаCURL.Нет();
	ИначеЕсли РесурсИРазделитель.Разделитель <> Неопределено Тогда
		Разделитель = РесурсИРазделитель.Разделитель;
	КонецЕсли;

	Заголовки = Новый Массив;
	Для Каждого Заголовок Из Запрос.Заголовки() Цикл
		Заголовки.Добавить(МатериализоватьОтложенноеЗначение(
			Заголовок,
			Заголовок.ОтложеннаяКлассификация(),
			Контекст
		));
	КонецЦикла;

	Аутентификация = МатериализоватьАутентификацию(Запрос.Аутентификация(), РесурсИРазделитель, Контекст);
	Тело = МатериализоватьТело(Запрос.Тело(), Контекст);
	МетодПоУмолчанию = Запрос.МетодПоУмолчанию();

	Если МетодПоУмолчанию = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола()
		И (РесурсИРазделитель.Ресурс.Протокол() = ПротоколыCURL.HTTP()
			Или РесурсИРазделитель.Ресурс.Протокол() = ПротоколыCURL.HTTPS()) Тогда
		МетодПоУмолчанию = Новый ПравилаФормированияЗапросаCURL().МетодПоУмолчанию(
			РесурсИРазделитель.Ресурс.Протокол(),
			Запрос.НеПолучатьТело(),
			Тело.Вид()
		);
	КонецЕсли;

	Возврат Новый ЗапросCURL(
		МатериализоватьВыражение(Запрос.ЯвныйМетод(), Контекст),
		МетодПоУмолчанию,
		Запрос.ПереноситьДанныеВURL(),
		Запрос.НеПолучатьТело(),
		Запрос.ТолькоИменаПриПеречислении(),
		Новый СтрокаЗапросаCURL(Части, Разделитель),
		Заголовки,
		Тело,
		Аутентификация
	);

КонецФункции

Функция МатериализоватьАутентификацию(Аутентификация, РесурсИРазделитель, Контекст)

	Данные = Аутентификация.УчетныеДанные();
	Если Данные = Неопределено И РесурсИРазделитель.УчетныеДанные <> Неопределено Тогда
		Данные = РесурсИРазделитель.УчетныеДанные;
	Иначе
		Данные = МатериализоватьУчетныеДанные(Данные, Контекст);
	КонецЕсли;

	OAuth2 = Аутентификация.OAuth2();
	Если OAuth2 <> Неопределено Тогда
		OAuth2 = Новый ТокенOAuth2CURL(МатериализоватьВыражение(OAuth2.Выражение(), Контекст), OAuth2.Источник());
	КонецЕсли;

	AWS = Аутентификация.ПодписьAWSV4();
	Если AWS <> Неопределено И AWS.ТребуетРазбора() Тогда
		ВыражениеAWS = МатериализоватьВыражение(AWS.Выражение(), Контекст);
		РезультатAWS = Новый КлассификаторАутентификацииCURL().ПодписьAWSV4(ВыражениеAWS, AWS.Источник());

		Если РезультатAWS.Успешно() Тогда
			AWS = РезультатAWS.Значение();
		Иначе
			ДобавитьОшибкиМатериализации(Контекст.Ошибки, РезультатAWS.Ошибки(), AWS.Источник());
		КонецЕсли;
	КонецЕсли;

	Возврат Новый АутентификацияCURL(Аутентификация.Способы(), Данные, OAuth2, AWS);

КонецФункции

Функция МатериализоватьСоединение(Соединение, Ресурс, РесурсМатериализован, Контекст)

	НовыйTLS = МатериализоватьTLS(Соединение.TLS(), Контекст);
	Прокси = МатериализоватьПрокси(Соединение.Прокси(), Контекст);

	АдресFTP = Соединение.АдресОбратногоСоединенияFTP();
	Если РесурсМатериализован
		И Соединение.РежимFTP() = РежимыСоединенияFTPCURL.Активный()
		И Новый АктивностьНастроекCURL().FTP(Ресурс) Тогда
		АдресFTP = МатериализоватьВыражение(АдресFTP, Контекст);
	КонецЕсли;

	Возврат Новый НастройкиСоединенияCURL(
		НовыйTLS,
		Прокси,
		МатериализоватьЧисло(Соединение.Таймаут(), Контекст),
		МатериализоватьЧисло(Соединение.ТаймаутСоединения(), Контекст),
		Соединение.РежимFTP(),
		АдресFTP
	);

КонецФункции

Функция МатериализоватьTLS(TLS, Контекст)

	Сертификат = TLS.СертификатКлиента();
	Если Сертификат <> Неопределено И Сертификат.ТребуетРазбора() Тогда
		Отложенная = Новый ОтложеннаяКлассификацияCURL(
			Сертификат.Выражение(),
			ГрамматикиЗначенийCURL.Сертификат(),
			Сертификат.Источник()
		);
		Сертификат = МатериализоватьОтложенноеЗначение(Сертификат, Отложенная, Контекст);
	КонецЕсли;

	Возврат Новый НастройкиTLSCURL(
		Сертификат,
		МатериализоватьВыражение(
		TLS.СертификатыУдостоверяющегоЦентра(), Контекст),
		TLS.ИспользоватьСистемноеХранилище(),
		TLS.ИсточникСертификата(),
		TLS.ИсточникСертификатовУдостоверяющегоЦентра(),
		TLS.ИсточникСистемногоХранилища()
	);

КонецФункции

Функция МатериализоватьПрокси(ИсходныйПрокси, Контекст)

	КоличествоОшибок = Контекст.Ошибки.Количество();
	Прокси = МатериализоватьОтложенноеЗначение(ИсходныйПрокси, ИсходныйПрокси.ОтложеннаяКлассификация(), Контекст);
	Данные = ИсходныйПрокси.УчетныеДанные();

	Если Контекст.Ошибки.Количество() > КоличествоОшибок Тогда
		Возврат Прокси;
	КонецЕсли;

	Если Не Новый АктивностьНастроекCURL().Прокси(Прокси) Тогда
		Возврат Новый ПроксиCURL(
			Прокси.Режим(),
			Прокси.Адрес(),
			Прокси.Протокол(),
			Прокси.Сервер(),
			Прокси.Порт(),
			Прокси.ПутьUnixСокета(),
			Данные,
			ИсходныйПрокси.СпособыАутентификации(),
			Неопределено,
			Ложь,
			Прокси.ИсточникАдреса(),
			?(Данные = Неопределено, Неопределено, Данные.Источник())
		);
	КонецЕсли;

	Если Прокси = ИсходныйПрокси И (Данные = Неопределено Или Не Данные.ТребуетРазбора()) Тогда
		Возврат Прокси;
	КонецЕсли;

	// Явные учетные данные имеют приоритет над данными вычисленного адреса.
	Данные = МатериализоватьУчетныеДанные(Данные, Контекст);
	Если Данные = Неопределено Тогда
		Данные = Прокси.УчетныеДанные();
	КонецЕсли;

	Возврат Новый ПроксиCURL(
		Прокси.Режим(),
		Прокси.Адрес(),
		Прокси.Протокол(),
		Прокси.Сервер(),
		Прокси.Порт(),
		Прокси.ПутьUnixСокета(),
		Данные,
		ИсходныйПрокси.СпособыАутентификации(),
		Неопределено,
		Ложь,
		Прокси.ИсточникАдреса(),
		?(Данные = Неопределено, Неопределено, Данные.Источник())
	);

КонецФункции

Функция МатериализоватьУчетныеДанные(Данные, Контекст)

	Если Данные = Неопределено Или Не Данные.ТребуетРазбора() Тогда
		Возврат Данные;
	КонецЕсли;

	Отложенная = Новый ОтложеннаяКлассификацияCURL(
		Данные.Выражение(),
		ГрамматикиЗначенийCURL.УчетныеДанные(),
		Данные.Источник()
	);

	Возврат МатериализоватьОтложенноеЗначение(Данные, Отложенная, Контекст);

КонецФункции

Функция МатериализоватьПолитики(Политики, Контекст)

	Повторы = Политики.Повторы();
	КоличествоОшибок = Контекст.Ошибки.Количество();
	Количество = МатериализоватьЧисло(Повторы.Количество(), Контекст);
	МаксимальноеВремя = Повторы.МаксимальноеВремя();

	Если Контекст.Ошибки.Количество() = КоличествоОшибок
		И Новый АктивностьНастроекCURL().Повторы(Количество) Тогда
		МаксимальноеВремя = МатериализоватьЧисло(МаксимальноеВремя, Контекст);
	КонецЕсли;

	Возврат Новый ПолитикиПередачиCURL(
		Политики.Перенаправления(),
		Новый ПолитикаПовторовCURL(
			Количество,
			МаксимальноеВремя
		)
	);

КонецФункции

Функция МатериализоватьРезультат(Результат, Ресурс, Контекст)

	Если Контекст.Ошибки.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ИсходныйРезультат = Результат;
	Если Результат.ОтложеннаяКлассификация() <> Неопределено Тогда
		Результат = МатериализоватьОтложенноеЗначение(Результат,Результат.ОтложеннаяКлассификация(), Контекст);
	КонецЕсли;

	Если Контекст.Ошибки.Количество() > 0 Тогда
		Возврат ИсходныйРезультат;
	КонецЕсли;

	Если Не Новый АктивностьНастроекCURL().ФайловыйРезультат(Результат) Тогда
		Возврат Новый ОписаниеРезультатаCURL(
			Результат.Режим(),
			Результат.ИмяФайла(),
			ИсходныйРезультат.Каталог(),
			ИсходныйРезультат.СоздаватьКаталоги(),
			Неопределено,
			Результат.Источник()
		);
	КонецЕсли;

	Результат = Новый ОписаниеРезультатаCURL(
		Результат.Режим(),
		Результат.ИмяФайла(),
		МатериализоватьВыражение(ИсходныйРезультат.Каталог(), Контекст),
		ИсходныйРезультат.СоздаватьКаталоги(),
		Неопределено,
		Результат.Источник()
	);

	Если Результат.Режим() = РежимыРезультатаCURL.ИмяИзURL() Тогда
		Имя = ИмяФайлаИзURL(Ресурс.АдресДляВыполнения().ЛитеральноеЗначение());
		Результат = Новый ОписаниеРезультатаCURL(
			Результат.Режим(),
			СоздатьЛитеральноеВыражение(
			Имя, Ресурс.ИсходныйАдрес().Источник()),
			Результат.Каталог(),
			Результат.СоздаватьКаталоги(),
			Неопределено,
			Результат.Источник()
		);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция МатериализоватьЧисло(Число, Контекст)

	Если Число = Неопределено Или Не Число.ТребуетВычисления() Тогда
		Возврат Число;
	КонецЕсли;

	Грамматика = ?(
		Число.ФорматЗначения() = ФорматыЧисловыхЗначенийCURL.ЦелоеНеотрицательное(),
		ГрамматикиЗначенийCURL.ЦелоеНеотрицательное(),
		ГрамматикиЗначенийCURL.ДесятичноеНеотрицательное()
	);

	Возврат МатериализоватьОтложенноеЗначение(
		Число,
		Новый ОтложеннаяКлассификацияCURL(
			Число.Выражение(),
			Грамматика,
			Число.Источник()
		),
		Контекст
	);

КонецФункции

Функция МатериализоватьОтложенноеЗначение(Исходное, Отложенная, Контекст)

	Если Отложенная = Неопределено Тогда
		Возврат Исходное;
	КонецЕсли;

	Результат = Классифицировать(Отложенная, Контекст, Исходное);

	Возврат ?(Результат = Неопределено, Исходное, Результат);

КонецФункции

Функция Классифицировать(Отложенная, Контекст, Исходное)

	Выражение = СоздатьЛитеральноеВыражение(
		ВычислитьВыражение(Отложенная.Выражение(), Контекст.Переменные),
		Отложенная.Выражение().Источник()
	);
	Грамматика = Отложенная.Грамматика();

	Если Грамматика = ГрамматикиЗначенийCURL.URL() Тогда
		Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли ТипЗнч(Исходное) = Тип("ЧастьТелаЗапросаCURL")
		И Исходное.Вид() = ВидыТелаЗапросаCURL.ЗагрузкаФайла() Тогда
		Результат = Новый КлассификаторЗагрузкиCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.Заголовок() Тогда
		Результат = Новый КлассификаторЗаголовкаCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.ПользовательскийАгент() Тогда
		Результат = Новый КлассификаторЗаголовкаCURL().КлассифицироватьПользовательскийАгент(
			Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.ЧастьЗапроса() Тогда
		Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(
			Выражение, Отложенная.Источник(), Истина);
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.Результат() Тогда
		Результат = Новый КлассификаторРезультатаCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.УчетныеДанные() Тогда
		Результат = Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.Прокси() Тогда
		Результат = Новый КлассификаторПроксиCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.Сертификат() Тогда
		Результат = Новый КлассификаторСертификатаCURL().Классифицировать(Выражение, Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.ЦелоеНеотрицательное() Тогда
		Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(Выражение,
			ФорматыЧисловыхЗначенийCURL.ЦелоеНеотрицательное(), Отложенная.Источник());
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.ДесятичноеНеотрицательное() Тогда
		Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(Выражение,
			ФорматыЧисловыхЗначенийCURL.ДесятичноеНеотрицательное(), Отложенная.Источник());
	Иначе
		Результат = КлассифицироватьТело(Грамматика, Выражение, Отложенная.Источник());
	КонецЕсли;

	Если Результат.Успешно() Тогда
		Возврат Результат.Значение();
	КонецЕсли;

	ДобавитьОшибкиМатериализации(Контекст.Ошибки, Результат.Ошибки(), Отложенная.Источник());

	Возврат Неопределено;

КонецФункции

Функция КлассифицироватьТело(Грамматика, Выражение, Источник)

	Если Грамматика = ГрамматикиЗначенийCURL.Форма() Тогда
		Возврат Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник);
	ИначеЕсли Грамматика = ГрамматикиЗначенийCURL.СтроковаяФорма() Тогда
		Возврат Новый КлассификаторФормыCURL().КлассифицироватьСтроку(Выражение, Источник);
	КонецЕсли;

	Имя = Источник.ОписаниеОпции().КаноническоеИмя();

	Возврат Новый КлассификаторДанныхCURL().Классифицировать(
		Имя,
		Выражение,
		Источник,
		РазделителиЧастейТелаCURL.Нет()
	);

КонецФункции

Функция МатериализоватьТело(Тело, Контекст)

	Части = Новый Массив;
	Для Каждого Часть Из Тело.Части() Цикл
		Материализованная = МатериализоватьОтложенноеЗначение(Часть, Часть.ОтложеннаяКлассификация(), Контекст);

		Если Контекст.Ошибки.Количество() > 0 Тогда
			Части.Добавить(Часть);
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Материализованная) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Элемент Из Материализованная Цикл
				Части.Добавить(Элемент.БезОтложеннойКлассификации().СРазделителем(Часть.РазделительПеред()));
			КонецЦикла;
		Иначе
			Части.Добавить(Материализованная.БезОтложеннойКлассификации().СРазделителем(Часть.РазделительПеред()));
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ТелоЗапросаCURL(Тело.Вид(), Части, Тело.Источник());

КонецФункции

Функция ВычислитьВыражение(Выражение, Переменные)

	Результат = "";
	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Переменная() Тогда
			Значение = Переменные.Получить(Фрагмент.Значение);
			Если Значение = Неопределено Тогда
				Значение = "";
			КонецЕсли;

			Результат = Результат + Значение;
		Иначе
			Результат = Результат + Фрагмент.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МатериализоватьВыражение(Выражение, Контекст)

	Если Выражение = Неопределено Или Выражение.ЯвляетсяЛитералом() Тогда
		Возврат Выражение;
	КонецЕсли;

	Возврат СоздатьЛитеральноеВыражение(ВычислитьВыражение(Выражение, Контекст.Переменные), Выражение.Источник());

КонецФункции

Функция СоздатьЛитеральноеВыражение(Значение, ИсходныйТокен)

	Фрагменты = Новый Массив;
	Фрагменты.Добавить(Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Текст(),
		Значение,
		Значение
	));

	Карта = Новый Массив;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Карта.Добавить(Индекс);
	КонецЦикла;

	Токен = Новый ТокенКомандыCURL(
		Значение,
		Значение,
		Фрагменты,
		ИсходныйТокен.Позиция(),
		ИсходныйТокен.ПозицияВИсходнойСтроке(),
		ИсходныйТокен.ПозицияВАргументе(),
		Карта
	);

	Возврат Новый ВыражениеЗначенияCURL(Токен);

КонецФункции

Процедура ДобавитьОшибкиМатериализации(Ошибки, ОшибкиКлассификации, Источник)

	Для Каждого Ошибка Из ОшибкиКлассификации Цикл
		Код = ДиагностикаОшибок.КодОшибки(Ошибка);
		Если Код = КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач() Тогда
			Код = КодыОшибокCurlone.НеподдерживаемыйМатериализованныйИсточникНесколькихПередач();
		Иначе
			Код = КодыОшибокCurlone.НедопустимоеМатериализованноеЗначение();
		КонецЕсли;

		Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(Код, "Вычисленное значение недопустимо", Источник));
	КонецЦикла;

КонецПроцедуры

Функция ИмяФайлаИзURL(Адрес)

	Путь = Новый URL(Адрес).КодированныйПуть();
	Сегменты = СтрРазделить(Путь, "/");
	Индекс = Сегменты.ВГраница();

	Пока Индекс >= 0 Цикл
		Если Не ПустаяСтрока(Сегменты[Индекс]) Тогда
			Возврат Сегменты[Индекс];
		КонецЕсли;

		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат "curl_response";

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю секции команды.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительСекцииКомандыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;

	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "location" Тогда
		Построитель.УстановитьПеренаправления(Включить, Элемент);
	ИначеЕсли Имя = "ftp-pasv" Тогда
		Построитель.УстановитьРежимFTP(РежимыСоединенияFTPCURL.Пассивный(), Неопределено, Элемент);
	ИначеЕсли Имя = "ftp-port" Тогда
		Построитель.УстановитьРежимFTP(РежимыСоединенияFTPCURL.Активный(), Выражение, Элемент);
	Иначе
		Формат = ?(Имя = "retry",
			ФорматыЧисловыхЗначенийCURL.ЦелоеНеотрицательное(),
			ФорматыЧисловыхЗначенийCURL.ДесятичноеНеотрицательное()
		);
		Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(Выражение, Формат, Элемент);
		Если Не Результат.Успешно() Тогда
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		ИначеЕсли Имя = "max-time" Тогда
			Построитель.УстановитьТаймаут(Результат.Значение());
		ИначеЕсли Имя = "connect-timeout" Тогда
			Построитель.УстановитьТаймаутСоединения(Результат.Значение());
		ИначеЕсли Имя = "retry" Тогда
			Построитель.УстановитьКоличествоПовторов(Результат.Значение());
		Иначе
			Построитель.УстановитьМаксимальноеВремяПовторов(Результат.Значение());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


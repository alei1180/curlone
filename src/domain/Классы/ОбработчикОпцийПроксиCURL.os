#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю группы.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительГруппыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;

	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "proxy" Тогда
		Результат = Новый КлассификаторПроксиCURL().Классифицировать(Выражение, Элемент);
		Если Результат.Успешно() Тогда
			Построитель.УстановитьПрокси(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	ИначеЕсли Имя = "proxy-user" Тогда
		Результат = Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Элемент);
		Если Результат.Успешно() Тогда
			Построитель.УстановитьУчетныеДанныеПрокси(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	Иначе
		Вид = ?(Имя = "proxy-basic", СпособыАутентификацииПроксиCURL.Basic(), СпособыАутентификацииПроксиCURL.NTLM());
		Построитель.ИзменитьСпособАутентификацииПрокси(Новый СпособАутентификацииПроксиCURL(Вид, Элемент), Включить);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


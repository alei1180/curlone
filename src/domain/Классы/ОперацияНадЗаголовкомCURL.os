Перем _Действие; // Строка
Перем _Выражение; // ВыражениеЗначенияCURL, Неопределено
Перем _Имя; // Строка, Неопределено
Перем _Значение; // Строка, Неопределено
Перем _ПутьКФайлу; // Строка, Неопределено
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _ТребуетРазбора; // Булево
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемую операцию над заголовком.
//
// Параметры:
//   Действие - Строка - Значение из модуля ДействияНадЗаголовкамиCURL.
//   Выражение - ВыражениеЗначенияCURL, Неопределено - Исходное выражение.
//   Имя - Строка, Неопределено - Имя заголовка с исходным регистром.
//   Значение - Строка, Неопределено - Значение заголовка.
//   ПутьКФайлу - Строка, Неопределено - Путь к файлу заголовков.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор.
//   ТребуетРазбора - Булево - Признак отложенного разбора.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
Процедура ПриСозданииОбъекта(
	Действие,
	Выражение,
	Имя,
	Значение,
	ПутьКФайлу,
	ОтложеннаяКлассификация,
	ТребуетРазбора,
	Источник
)

	_Действие = Действие;
	_Выражение = Выражение;
	_Имя = Имя;
	_Значение = Значение;
	_ПутьКФайлу = ПутьКФайлу;
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_ТребуетРазбора = ТребуетРазбора;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает действие над заголовком.
//
// Возвращаемое значение:
//   Строка - Возвращает действие над заголовком.
Функция Действие() Экспорт
	Возврат _Действие;
КонецФункции

// Возвращает исходное выражение.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL, Неопределено - Возвращает исходное выражение.
Функция Выражение() Экспорт
	Возврат _Выражение;
КонецФункции

// Возвращает имя заголовка.
//
// Возвращаемое значение:
//   Строка, Неопределено - Возвращает имя заголовка.
Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

// Возвращает значение заголовка.
//
// Возвращаемое значение:
//   Строка, Неопределено - Возвращает значение заголовка.
Функция Значение() Экспорт
	Возврат _Значение;
КонецФункции

// Возвращает путь к файлу заголовков.
//
// Возвращаемое значение:
//   Строка, Неопределено - Возвращает путь к файлу заголовков.
Функция ПутьКФайлу() Экспорт
	Возврат _ПутьКФайлу;
КонецФункции

// Возвращает отложенную классификацию.
//
// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - Возвращает отложенную классификацию.
Функция ОтложеннаяКлассификация() Экспорт
	Возврат _ОтложеннаяКлассификация;
КонецФункции

// Возвращает признак отложенного разбора.
//
// Возвращаемое значение:
//   Булево - Возвращает признак отложенного разбора.
Функция ТребуетРазбора() Экспорт
	Возврат _ТребуетРазбора;
КонецФункции

// Возвращает исходную опцию.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Возвращает исходную опцию.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

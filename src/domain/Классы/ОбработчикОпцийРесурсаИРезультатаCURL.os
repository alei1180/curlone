#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю секции команды.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительСекцииКомандыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;

	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "url" Тогда
		Построитель.ДобавитьURL(Элемент);
	ИначеЕсли Имя = "output-dir" Тогда
		Построитель.УстановитьКаталогРезультата(Выражение, Элемент);
	ИначеЕсли Имя = "create-dirs" Тогда
		Построитель.УстановитьСозданиеКаталогов(Включить, Элемент);
	ИначеЕсли Имя = "remote-name-all" Тогда
		Построитель.УстановитьИмяИзURLПоУмолчанию(Включить, Элемент);
	ИначеЕсли Имя = "remote-name" Тогда
		Если Включить Тогда
			Построитель.ДобавитьРезультат(Новый ОписаниеРезультатаCURL(
				РежимыРезультатаCURL.ИмяИзURL(),
				Неопределено,
				Неопределено,
				Ложь,
				Неопределено,
				Элемент
			));
		Иначе
			Построитель.ОтключитьПозиционноеИмяИзURL(Элемент);
		КонецЕсли;
	ИначеЕсли Имя = "output" Тогда
		Результат = Новый КлассификаторРезультатаCURL().Классифицировать(Выражение, Элемент);
		Если Результат.Успешно() Тогда
			Построитель.ДобавитьРезультат(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	Иначе
		Результат = Новый КлассификаторЗагрузкиCURL().Классифицировать(Выражение, Элемент);
		Если Результат.Успешно() Тогда
			Если ТипЗнч(Результат.Значение()) = Тип("ФиксированныйМассив") Тогда
				Построитель.ДобавитьГруппуЗагрузок(Результат.Значение());
			Иначе
				Построитель.ДобавитьЗагрузку(Результат.Значение());
			КонецЕсли;
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

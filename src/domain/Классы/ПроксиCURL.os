КонецФункции

// Возвращает СпособыАутентификации.
//
// Возвращаемое значение:
//   ФиксированныйМассив из СпособАутентификацииПроксиCURL - СпособыАутентификации.
Функция СпособыАутентификации() Экспорт

	Возврат _СпособыАутентификации;

КонецФункции

// Возвращает ОтложеннаяКлассификация.
//
// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - ОтложеннаяКлассификация.
Функция ОтложеннаяКлассификация() Экспорт

	Возврат _ОтложеннаяКлассификация;

КонецФункции

// Возвращает ТребуетРазбора.
//
// Возвращаемое значение:
//   Булево - ТребуетРазбора.
Функция ТребуетРазбора() Экспорт

	Возврат _ТребуетРазбора;

КонецФункции

// Возвращает ИсточникАдреса.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL, Неопределено - ИсточникАдреса.
Функция ИсточникАдреса() Экспорт

	Возврат _ИсточникАдреса;

КонецФункции

// Возвращает ИсточникУчетныхДанных.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL, Неопределено - ИсточникУчетныхДанных.
Функция ИсточникУчетныхДанных() Экспорт

	Возврат _ИсточникУчетныхДанных;

КонецФункции

#КонецОбласти

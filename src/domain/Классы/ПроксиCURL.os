#Использовать "../../shared"

Перем _Режим; // Строка
Перем _Адрес; // ВыражениеЗначенияCURL, Неопределено
Перем _Протокол; // Строка, Неопределено
Перем _Сервер; // Строка, Неопределено
Перем _Порт; // Число, Неопределено
Перем _ПутьUnixСокета; // Строка, Неопределено
Перем _УчетныеДанные; // УчетныеДанныеCURL, Неопределено
Перем _СпособыАутентификации; // ФиксированныйМассив из СпособАутентификацииПроксиCURL
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _ТребуетРазбора; // Булево
Перем _ИсточникАдреса; // ЭлементРазобраннойКомандыCURL, Неопределено
Перем _ИсточникУчетныхДанных; // ЭлементРазобраннойКомандыCURL, Неопределено

#Область ОбработчикиСобытий

// Создаёт настройки прокси.
//
// Параметры:
//   Режим - Строка - Режим.
//   Адрес - ВыражениеЗначенияCURL, Неопределено - Адрес.
//   Протокол - Строка, Неопределено - Протокол.
//   Сервер - Строка, Неопределено - Сервер.
//   Порт - Число, Неопределено - Порт.
//   ПутьUnixСокета - Строка, Неопределено - ПутьUnixСокета.
//   УчетныеДанные - УчетныеДанныеCURL, Неопределено - УчетныеДанные.
//   СпособыАутентификации - Массив, ФиксированныйМассив из СпособАутентификацииПроксиCURL - СпособыАутентификации.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - ОтложеннаяКлассификация.
//   ТребуетРазбора - Булево - ТребуетРазбора.
//   ИсточникАдреса - ЭлементРазобраннойКомандыCURL, Неопределено - ИсточникАдреса.
//   ИсточникУчетныхДанных - ЭлементРазобраннойКомандыCURL, Неопределено - ИсточникУчетныхДанных.
Процедура ПриСозданииОбъекта(
	Режим,
	Адрес,
	Протокол,
	Сервер,
	Порт,
	ПутьUnixСокета,
	УчетныеДанные,
	СпособыАутентификации,
	ОтложеннаяКлассификация,
	ТребуетРазбора,
	ИсточникАдреса,
	ИсточникУчетныхДанных
)

	_Режим = Режим;
	_Адрес = Адрес;
	_Протокол = Протокол;
	_Сервер = Сервер;
	_Порт = Порт;
	_ПутьUnixСокета = ПутьUnixСокета;
	_УчетныеДанные = УчетныеДанные;
	_СпособыАутентификации = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(СпособыАутентификации));
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_ТребуетРазбора = ТребуетРазбора;
	_ИсточникАдреса = ИсточникАдреса;
	_ИсточникУчетныхДанных = ИсточникУчетныхДанных;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает Режим.
//
// Возвращаемое значение:
//   Строка - Режим.
Функция Режим() Экспорт

	Возврат _Режим;

КонецФункции

// Возвращает Адрес.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL, Неопределено - Адрес.
Функция Адрес() Экспорт

	Возврат _Адрес;

КонецФункции

// Возвращает Протокол.
//
// Возвращаемое значение:
//   Строка, Неопределено - Протокол.
Функция Протокол() Экспорт

	Возврат _Протокол;

КонецФункции


Перем _Режим; // Строка
Перем _ИмяФайла; // ВыражениеЗначенияCURL, Неопределено
Перем _Каталог; // ВыражениеЗначенияCURL, Неопределено
Перем _СоздаватьКаталоги; // Булево
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _Источник; // ЭлементРазобраннойКомандыCURL, Неопределено

#Область ОбработчикиСобытий

// Создаёт описание результата curl.
//
// Параметры:
//   Режим - Строка - Значение из РежимыРезультатаCURL.
//   ИмяФайла - ВыражениеЗначенияCURL, Неопределено - Имя результата.
//   Каталог - ВыражениеЗначенияCURL, Неопределено - Каталог результата.
//   СоздаватьКаталоги - Булево - Признак создания каталогов.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор имени.
//   Источник - ЭлементРазобраннойКомандыCURL, Неопределено - Исходная опция.
Процедура ПриСозданииОбъекта(
	Режим,
	ИмяФайла,
	Каталог,
	СоздаватьКаталоги,
	ОтложеннаяКлассификация,
	Источник
)

	_Режим = Режим;
	_ИмяФайла = ИмяФайла;
	_Каталог = Каталог;
	_СоздаватьКаталоги = СоздаватьКаталоги;
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает режим.
//
// Возвращаемое значение:
//   Строка - Значение из РежимыРезультатаCURL.
Функция Режим() Экспорт
	Возврат _Режим;
КонецФункции
// Возвращает имя файла.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL, Неопределено - Имя результата.
Функция ИмяФайла() Экспорт
	Возврат _ИмяФайла;
КонецФункции
// Возвращает каталог.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL, Неопределено - Каталог результата.
Функция Каталог() Экспорт
	Возврат _Каталог;
КонецФункции
// Возвращает признак создания каталогов.
//
// Возвращаемое значение:
//   Булево - Признак создания.
Функция СоздаватьКаталоги() Экспорт
	Возврат _СоздаватьКаталоги;
КонецФункции
// Возвращает отложенную классификацию.
//
// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор имени.
Функция ОтложеннаяКлассификация() Экспорт
	Возврат _ОтложеннаяКлассификация;
КонецФункции
// Возвращает источник.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL, Неопределено - Исходная опция.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

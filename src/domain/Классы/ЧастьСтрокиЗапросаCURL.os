Перем _ВидИсточника; // Строка
Перем _Выражение; // ВыражениеЗначенияCURL
Перем _Имя; // Строка, Неопределено
Перем _Текст; // Строка, Неопределено
Перем _ПутьКФайлу; // Строка, Неопределено
Перем _Кодировать; // Булево, Неопределено
Перем _ДобавлятьЗнакРавно; // Булево, Неопределено
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемую часть строки запроса.
//
// Параметры:
//   ВидИсточника - Строка - Значение из модуля ВидыИсточниковЧастиСтрокиЗапросаCURL.
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Имя - Строка, Неопределено - Имя части.
//   Текст - Строка, Неопределено - Текстовое содержимое.
//   ПутьКФайлу - Строка, Неопределено - Путь к источнику содержимого.
//   Кодировать - Булево, Неопределено - Признак кодирования содержимого.
//   ДобавлятьЗнакРавно - Булево, Неопределено - Признак добавления знака равенства после имени.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор выражения.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
Процедура ПриСозданииОбъекта(
	ВидИсточника,
	Выражение,
	Имя,
	Текст,
	ПутьКФайлу,
	Кодировать,
	ДобавлятьЗнакРавно,
	ОтложеннаяКлассификация,
	Источник
)

	_ВидИсточника = ВидИсточника;
	_Выражение = Выражение;
	_Имя = Имя;
	_Текст = Текст;
	_ПутьКФайлу = ПутьКФайлу;
	_Кодировать = Кодировать;
	_ДобавлятьЗнакРавно = ДобавлятьЗнакРавно;
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает вид источника содержимого.
//
// Возвращаемое значение:
//   Строка - Значение из модуля ВидыИсточниковЧастиСтрокиЗапросаCURL.
Функция ВидИсточника() Экспорт
	Возврат _ВидИсточника;
КонецФункции

// Возвращает исходное выражение.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Исходное выражение.
Функция Выражение() Экспорт
	Возврат _Выражение;
КонецФункции

// Возвращает имя части.
//
// Возвращаемое значение:
//   Строка, Неопределено - Имя части или Неопределено.
Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

// Возвращает текстовое содержимое.
//
// Возвращаемое значение:
//   Строка, Неопределено - Текстовое содержимое или Неопределено.
Функция Текст() Экспорт
	Возврат _Текст;
КонецФункции

// Возвращает путь к источнику содержимого.
//
// Возвращаемое значение:
//   Строка, Неопределено - Путь к файлу или Неопределено.
Функция ПутьКФайлу() Экспорт
	Возврат _ПутьКФайлу;
КонецФункции

// Возвращает признак кодирования содержимого.
//
// Возвращаемое значение:
//   Булево, Неопределено - Признак кодирования или Неопределено для отложенной классификации.
Функция Кодировать() Экспорт
	Возврат _Кодировать;
КонецФункции

// Возвращает признак добавления знака равенства после имени.
//
// Возвращаемое значение:
//   Булево, Неопределено - Признак добавления или Неопределено для отложенной классификации.
Функция ДобавлятьЗнакРавно() Экспорт
	Возврат _ДобавлятьЗнакРавно;
КонецФункции

// Возвращает описание отложенной классификации.
//
// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - Отложенная классификация или Неопределено.
Функция ОтложеннаяКлассификация() Экспорт
	Возврат _ОтложеннаяКлассификация;
КонецФункции

// Возвращает исходный элемент команды.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

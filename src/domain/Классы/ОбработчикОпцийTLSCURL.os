#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю группы.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительГруппыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;
	
	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "cert" Тогда
		Результат = Новый КлассификаторСертификатаCURL().Классифицировать(Выражение, Элемент);
		
		Если Результат.Успешно() Тогда
			Построитель.УстановитьСертификатКлиента(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	ИначеЕсли Имя = "cacert" Тогда
		Построитель.УстановитьСертификатыУдостоверяющегоЦентра(Выражение, Элемент);
	Иначе
		Построитель.УстановитьСистемноеХранилище(Включить, Элемент);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


Перем _Фрагменты; // ФиксированныйМассив из ФиксированнаяСтруктура
Перем _ЯвляетсяЛитералом; // Булево
Перем _ЛитеральноеЗначение; // Строка, Неопределено
Перем _Источник; // ТокенКомандыCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемое выражение из токена команды curl.
//
// Параметры:
//   Источник - ТокенКомандыCURL - Исходный токен синтаксического этапа.
Процедура ПриСозданииОбъекта(Источник)

	_Источник = Источник;
	_Фрагменты = СкопироватьФрагменты(Источник.Фрагменты());
	_ЯвляетсяЛитералом = Не СодержитПеременную(_Фрагменты);
	_ЛитеральноеЗначение = ?(_ЯвляетсяЛитералом, Источник.Значение(), Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает неизменяемые фрагменты выражения.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - Фрагменты выражения:
//     * Вид - Строка - Вид из модуля ВидыФрагментовТокенаCURL.
//     * Значение - Строка - Текст или имя переменной.
//     * ИсходноеПредставление - Строка - Исходная форма фрагмента.
Функция Фрагменты() Экспорт

	Возврат _Фрагменты;

КонецФункции

// Возвращает признак отсутствия переменных в выражении.
//
// Возвращаемое значение:
//   Булево - Истина, если выражение целиком является литералом.
Функция ЯвляетсяЛитералом() Экспорт

	Возврат _ЯвляетсяЛитералом;

КонецФункции

// Возвращает значение литерального выражения.
//
// Возвращаемое значение:
//   Строка, Неопределено - Значение литерала или Неопределено для выражения с переменными.
Функция ЛитеральноеЗначение() Экспорт

	Возврат _ЛитеральноеЗначение;

КонецФункции

// Возвращает исходный токен.
//
// Возвращаемое значение:
//   ТокенКомандыCURL - Токен синтаксического этапа.
Функция Источник() Экспорт

	Возврат _Источник;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьФрагменты(Фрагменты)

	Копия = Новый Массив;
	Для Каждого Фрагмент Из Фрагменты Цикл
		Копия.Добавить(Новый ФиксированнаяСтруктура(
			"Вид, Значение, ИсходноеПредставление",
			Фрагмент.Вид,
			Фрагмент.Значение,
			Фрагмент.ИсходноеПредставление
		));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Копия);

КонецФункции

Функция СодержитПеременную(Фрагменты)

	Для Каждого Фрагмент Из Фрагменты Цикл
		Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Переменная() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

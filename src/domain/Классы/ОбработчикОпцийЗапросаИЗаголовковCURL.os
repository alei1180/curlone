#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю секции команды.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительСекцииКомандыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;

	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "request" Тогда
		Построитель.УстановитьЯвныйМетод(Выражение);
	ИначеЕсли Имя = "get" Тогда
		Построитель.УстановитьПереносДанныхВURL(Включить, Элемент);
	ИначеЕсли Имя = "head" Тогда
		Построитель.УстановитьНеПолучатьТело(Включить, Элемент);
	ИначеЕсли Имя = "list-only" Тогда
		Построитель.УстановитьТолькоИмена(Включить, Элемент);
	ИначеЕсли Имя = "url-query" Тогда
		Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(Выражение, Элемент, Истина);
		Если Результат.Успешно() Тогда
			Построитель.ДобавитьЧастьЗапроса(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	Иначе
		Классификатор = Новый КлассификаторЗаголовкаCURL();

		Если Имя = "header" Тогда
			Результат = Классификатор.Классифицировать(Выражение, Элемент);
		Иначе
			Результат = Классификатор.КлассифицироватьПользовательскийАгент(Выражение, Элемент);
		КонецЕсли;

		Если Результат.Успешно() Тогда
			Построитель.ДобавитьЗаголовок(Результат.Значение());
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


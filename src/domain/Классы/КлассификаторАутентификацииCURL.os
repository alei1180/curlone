#Использовать "../../public"

#Область ПрограммныйИнтерфейс

// Классифицирует выражение учётных данных без подстановки переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Классифицируемое выражение.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Успешный результат с учётными данными.
Функция УчетныеДанные(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Данные = Новый УчетныеДанныеCURL(
			Выражение,
			Неопределено,
			Неопределено,
			Ложь,
			Истина,
			Источник
		);
		Возврат Новый РезультатКлассификацииCURL(Данные, Новый Массив);
	КонецЕсли;

	Значение = Выражение.ЛитеральноеЗначение();
	ПозицияДвоеточия = СтрНайти(Значение, ":");

	Если ПозицияДвоеточия = 0 Тогда
		Пользователь = Значение;
		Пароль = Неопределено;
		ПарольУказан = Ложь;
	Иначе
		Пользователь = Лев(Значение, ПозицияДвоеточия - 1);
		Пароль = Сред(Значение, ПозицияДвоеточия + 1);
		ПарольУказан = Истина;
	КонецЕсли;

	Данные = Новый УчетныеДанныеCURL(
		Выражение,
		Пользователь,
		Пароль,
		ПарольУказан,
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Данные, Новый Массив);

КонецФункции

// Классифицирует выражение параметров подписи AWS V4 без подстановки переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Классифицируемое выражение.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с параметрами подписи либо безопасной ошибкой.
Функция ПодписьAWSV4(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Параметры = Новый ПараметрыПодписиAWSV4CURL(
			Выражение,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Истина,
			Источник
		);
		Возврат Новый РезультатКлассификацииCURL(Параметры, Новый Массив);
	КонецЕсли;

	Компоненты = СтрРазделить(Выражение.ЛитеральноеЗначение(), ":", Истина);
	Если Компоненты.Количество() > 4 Или Компоненты[0] = "" Тогда
		Возврат ОшибкаНедопустимогоЗначения(Источник);
	КонецЕсли;

	Параметры = Новый ПараметрыПодписиAWSV4CURL(
		Выражение,
		Компоненты[0],
		ПолучитьКомпонент(Компоненты, 1),
		ПолучитьКомпонент(Компоненты, 2),
		ПолучитьКомпонент(Компоненты, 3),
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Параметры, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьКомпонент(Компоненты, Индекс)

	Возврат ?(Индекс < Компоненты.Количество(), Компоненты[Индекс], Неопределено);

КонецФункции

Функция ОшибкаНедопустимогоЗначения(Источник)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции(),
		"Значение параметров подписи AWS V4 имеет недопустимый формат",
		Источник
	));

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

#КонецОбласти

Перем _ИсходныйАдрес; // ВыражениеЗначенияCURL
Перем _АдресДляВыполнения; // ВыражениеЗначенияCURL
Перем _Фрагмент; // Строка, Неопределено
Перем _ФрагментУказан; // Булево, Неопределено
Перем _Протокол; // Строка, Неопределено
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _ТребуетРазбора; // Булево
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт описание ресурса curl.
//
// Параметры:
//   ИсходныйАдрес - ВыражениеЗначенияCURL - Исходное выражение URL.
//   АдресДляВыполнения - ВыражениеЗначенияCURL - Адрес без данных пользователя и фрагмента.
//   Фрагмент - Строка, Неопределено - Декодированный фрагмент.
//   ФрагментУказан - Булево, Неопределено - Признак наличия решётки.
//   Протокол - Строка, Неопределено - Схема в нижнем регистре.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор URL.
//   ТребуетРазбора - Булево - Признак разбора после вычисления.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный URL.
Процедура ПриСозданииОбъекта(
	ИсходныйАдрес,
	АдресДляВыполнения,
	Фрагмент,
	ФрагментУказан,
	Протокол,
	ОтложеннаяКлассификация,
	ТребуетРазбора,
	Источник
)

	_ИсходныйАдрес = ИсходныйАдрес;
	_АдресДляВыполнения = АдресДляВыполнения;
	_Фрагмент = Фрагмент;
	_ФрагментУказан = ФрагментУказан;
	_Протокол = Протокол;
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_ТребуетРазбора = ТребуетРазбора;
	_Источник = Источник;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходный адрес.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Исходное выражение.
Функция ИсходныйАдрес() Экспорт
	Возврат _ИсходныйАдрес;
КонецФункции

// Возвращает адрес для выполнения.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Очищенный адрес.
Функция АдресДляВыполнения() Экспорт
	Возврат _АдресДляВыполнения;
КонецФункции

// Возвращает фрагмент.
//
// Возвращаемое значение:
//   Строка, Неопределено - Фрагмент.
Функция Фрагмент() Экспорт
	Возврат _Фрагмент;
КонецФункции

// Возвращает признак наличия фрагмента.
//
// Возвращаемое значение:
//   Булево, Неопределено - Признак наличия.
Функция ФрагментУказан() Экспорт
	Возврат _ФрагментУказан;
КонецФункции

// Возвращает протокол.
//
// Возвращаемое значение:
//   Строка, Неопределено - Схема.
Функция Протокол() Экспорт
	Возврат _Протокол;
КонецФункции

// Возвращает отложенную классификацию.
//
// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор URL.
Функция ОтложеннаяКлассификация() Экспорт
	Возврат _ОтложеннаяКлассификация;
КонецФункции

// Возвращает необходимость разбора.
//
// Возвращаемое значение:
//   Булево - Признак разбора после вычисления.
Функция ТребуетРазбора() Экспорт
	Возврат _ТребуетРазбора;
КонецФункции

// Возвращает источник.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Исходный URL.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

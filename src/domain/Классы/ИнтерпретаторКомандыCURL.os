#Использовать errors
#Использовать "../../shared"
#Использовать "../../syntax"

Перем _Реестр; // РеестрСемантическихОбработчиковCURL

#Область ОбработчикиСобытий

// Создаёт интерпретатор с неизменяемым реестром обработчиков.
//
// Исключения:
//   internal.invariant_violation - Нарушена уникальность идентификаторов реестра.
Процедура ПриСозданииОбъекта()

	_Реестр = Новый РеестрСемантическихОбработчиковCURL();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Преобразует разобранную команду в неизменяемые операции передачи.
//
// Параметры:
//   Команда - РазобраннаяКомандаCURL - Результат синтаксического анализа.
//
// Возвращаемое значение:
//   РезультатИнтерпретацииCURL - Описание выполнения либо безопасные ошибки.
//
// Исключения:
//   internal.invariant_violation - Нарушен контракт каталога, реестра или итоговой модели.
Функция Интерпретировать(Команда) Экспорт

	Построитель = Новый ПостроительСекцииКомандыCURL();
	Операции = Новый Массив;
	Ошибки = Новый Массив;
	Предупреждения = Новый Массив;

	Для Каждого Элемент Из Команда.Элементы() Цикл
		Если Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды() Тогда
			ЗавершитьСекциюКоманды(Построитель, Элемент, Операции, Ошибки, Предупреждения);
			Построитель = Новый ПостроительСекцииКомандыCURL();
		ИначеЕсли Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.URL() Тогда
			Построитель.ДобавитьURL(Элемент);
		ИначеЕсли Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.Опция() Тогда
			Описание = Элемент.ОписаниеОпции();
			Если Не Описание.Поддерживается() Тогда
				ДобавитьПредупреждениеОПропущеннойОпции(Предупреждения, Элемент);
			Иначе
				Обработчик = _Реестр.НайтиОбработчик(Описание.ИдентификаторОбработчика());
				Обработчик.Применить(Элемент, Построитель);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЗавершитьСекциюКоманды(Построитель, Неопределено, Операции, Ошибки, Предупреждения);

	Если Ошибки.Количество() > 0 Тогда
		Возврат Новый РезультатИнтерпретацииCURL(Неопределено, Ошибки, Предупреждения);
	КонецЕсли;

	Возврат Новый РезультатИнтерпретацииCURL(
		Новый ОписаниеВыполненияCURL(Операции),
		Ошибки,
		Предупреждения
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПредупреждениеОПропущеннойОпции(Предупреждения, Элемент)

	ИмяОпции = Элемент.УказанноеИмяОпции();
	Предупреждения.Добавить(Новый ПредупреждениеКонвертацииCURL(
		КодыПредупрежденийCurlone.ОпцияПроигнорирована(),
		СтрШаблон("Опция %1 проигнорирована", ИмяОпции),
		"",
		ИмяОпции,
		Элемент.ТокенОпции().Позиция()
	));

КонецПроцедуры

Процедура ЗавершитьСекциюКоманды(Построитель, ГраницаСекции, Операции, Ошибки, Предупреждения)

	Результат = Построитель.Построить();
	КоллекцииМоделиCURL.Дополнить(Предупреждения, Построитель.Предупреждения());

	Если Результат.Успешно() Тогда
		КоллекцииМоделиCURL.Дополнить(Операции, Результат.Значение());
	Иначе
		Для Каждого Ошибка Из Результат.Ошибки() Цикл
			Если ГраницаСекции <> Неопределено
				И ДиагностикаОшибок.КодОшибки(Ошибка) = КодыОшибокCurlone.НеУказанURL() Тогда
				Ошибка = Новый ФабрикаОшибокКомандыCURL().Создать(
					КодыОшибокCurlone.НеУказанURL(),
					"В команде не указан URL",
					ГраницаСекции
				);
			КонецЕсли;

			Ошибки.Добавить(Ошибка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

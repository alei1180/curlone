#Использовать errors

Перем _Реестр; // РеестрСемантическихОбработчиковCURL

#Область ОбработчикиСобытий

// Создаёт интерпретатор с неизменяемым реестром обработчиков.
//
// Исключения:
//   internal.invariant_violation - Нарушена уникальность идентификаторов реестра.
Процедура ПриСозданииОбъекта()

	_Реестр = Новый РеестрСемантическихОбработчиковCURL();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Преобразует разобранную команду в неизменяемые операции передачи.
//
// Параметры:
//   Команда - РазобраннаяКомандаCURL - Результат синтаксического анализа.
//
// Возвращаемое значение:
//   РезультатИнтерпретацииCURL - Описание выполнения либо безопасные ошибки.
//
// Исключения:
//   internal.invariant_violation - Нарушен контракт каталога, реестра или итоговой модели.
Функция Интерпретировать(Команда) Экспорт

	Построитель = Новый ПостроительГруппыCURL();
	Операции = Новый Массив;
	Ошибки = Новый Массив;

	Для Каждого Элемент Из Команда.Элементы() Цикл
		Если Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.ГраницаГруппы() Тогда
			ЗавершитьГруппу(Построитель, Элемент, Операции, Ошибки);
			Построитель = Новый ПостроительГруппыCURL();
		ИначеЕсли Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.URL() Тогда
			Построитель.ДобавитьURL(Элемент);
		ИначеЕсли Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.Опция() Тогда
			Описание = Элемент.ОписаниеОпции();
			Если Не Описание.ПоддерживаласьВV1() Тогда
				Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
					КодыОшибокCurlone.НеподдерживаемаяОпция(),
					"Опция не поддерживается",
					Элемент
				));
			Иначе
				Обработчик = _Реестр.НайтиОбработчик(Описание.ИдентификаторОбработчика());
				Обработчик.Применить(Элемент, Построитель);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЗавершитьГруппу(Построитель, Неопределено, Операции, Ошибки);

	Если Ошибки.Количество() > 0 Тогда
		Возврат Новый РезультатИнтерпретацииCURL(Неопределено, Ошибки);
	КонецЕсли;

	Возврат Новый РезультатИнтерпретацииCURL(Новый ОписаниеВыполненияCURL(Операции), Ошибки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗавершитьГруппу(Построитель, Граница, Операции, Ошибки)

	Результат = Построитель.Построить();
	Если Результат.Успешно() Тогда
		Для Каждого Операция Из Результат.Значение() Цикл
			Операции.Добавить(Операция);
		КонецЦикла;
	Иначе
		Для Каждого Ошибка Из Результат.Ошибки() Цикл
			Если Граница <> Неопределено И ДиагностикаОшибок.КодОшибки(Ошибка) = КодыОшибокCurlone.НеУказанURL() Тогда
				Ошибка = Новый ФабрикаОшибокКомандыCURL().Создать(
					КодыОшибокCurlone.НеУказанURL(),
					"В группе не указан URL",
					Граница
				);
			КонецЕсли;

			Ошибки.Добавить(Ошибка);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Использовать errors
#Использовать "../../syntax"

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт безопасную структурированную ошибку семантики команды curl.
//
// Параметры:
//   Код - Строка - Код ошибки.
//   Сообщение - Строка - Безопасное пользовательское сообщение.
//   Источник - ЭлементРазобраннойКомандыCURL, Неопределено - Источник ошибки или конец команды.
//
// Возвращаемое значение:
//   ИнформацияОбОшибке - Ошибка с позициями и безопасным представлением источника.
Функция Создать(Код, Сообщение, Источник) Экспорт

	Если Источник = Неопределено Тогда
		Возврат СоздатьОшибку(
			Код,
			Сообщение,
			-1,
			-1,
			-1,
			""
		);
	КонецЕсли;

	Токен = Источник.ИсходныйТокен();

	Возврат СоздатьОшибку(
		Код,
		Сообщение,
		Токен.Позиция(),
		Токен.ПозицияВИсходнойСтроке(),
		Токен.ПозицияВАргументе(),
		БезопасноеПредставление(Источник)
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОшибку(
	Код,
	Сообщение,
	Позиция,
	ПозицияВИсходнойСтроке,
	ПозицияВАргументе,
	Представление
)

	Данные = Новый Структура(
		"Позиция, ПозицияВИсходнойСтроке, ПозицияВАргументе, ИсходноеПредставление",
		Позиция,
		ПозицияВИсходнойСтроке,
		ПозицияВАргументе,
		Представление
	);

	Возврат ФабрикаОшибок.Создать(Код, Сообщение, Новый ФиксированнаяСтруктура(Данные));

КонецФункции

Функция БезопасноеПредставление(Источник)

	Если Источник.Вид() = ВидыЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды() Тогда
		Возврат "--next";
	КонецЕсли;

	Если Источник.Вид() <> ВидыЭлементовРазобраннойКомандыCURL.Опция() Тогда
		Возврат ?(Источник.ИсходныйТокен().Значение() = "--", "--", "<значение скрыто>");
	КонецЕсли;

	Если Источник.ОписаниеОпции().РежимЗначения() = РежимыЗначенияОпцийCURL.НеПринимает() Тогда
		Возврат "--" + Источник.ОписаниеОпции().КаноническоеИмя();
	КонецЕсли;

	Возврат "<значение скрыто>";

КонецФункции

#КонецОбласти

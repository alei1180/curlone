#Использовать "../../shared"
#Использовать errors

Перем _Выполнение; // ОписаниеВыполненияCURL, Неопределено
Перем _Ошибки; // ФиксированныйМассив из ИнформацияОбОшибке
Перем _Предупреждения; // ФиксированныйМассив из ПредупреждениеКонвертацииCURL

#Область ОбработчикиСобытий

// Создаёт результат семантической интерпретации команды curl.
//
// Параметры:
//   Выполнение - ОписаниеВыполненияCURL, Неопределено - Описание при успешном результате.
//   Ошибки - Массив, ФиксированныйМассив из ИнформацияОбОшибке - Семантические ошибки.
//   Предупреждения - Массив, ФиксированныйМассив из ПредупреждениеКонвертацииCURL,
//                    Неопределено - Семантические предупреждения.
//
// Исключения:
//   internal.invariant_violation - Наличие выполнения не соответствует наличию ошибок.
Процедура ПриСозданииОбъекта(Выполнение, Ошибки, Предупреждения = Неопределено)

	Если Предупреждения = Неопределено Тогда
		Предупреждения = Новый Массив;
	КонецЕсли;

	УспешныйРезультат = Ошибки.Количество() = 0 И Выполнение <> Неопределено;
	НеуспешныйРезультат = Ошибки.Количество() > 0 И Выполнение = Неопределено;

	Если Не УспешныйРезультат И Не НеуспешныйРезультат Тогда
		ВызватьИсключение СтандартныеОшибки.НарушенВнутреннийИнвариант(
			"Успешный результат содержит выполнение, неуспешный результат содержит ошибки",
			"Наличие выполнения не соответствует наличию ошибок интерпретации"
		);
	КонецЕсли;

	_Выполнение = Выполнение;
	_Ошибки = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Ошибки));
	_Предупреждения = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Предупреждения));

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает признак успешной интерпретации.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибки отсутствуют.
Функция Успешно() Экспорт

	Возврат _Ошибки.Количество() = 0;

КонецФункции

// Возвращает описание выполнения команды.
//
// Возвращаемое значение:
//   ОписаниеВыполненияCURL, Неопределено - Описание при успехе или Неопределено.
Функция Выполнение() Экспорт

	Возврат _Выполнение;

КонецФункции

// Возвращает ошибки интерпретации.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ИнформацияОбОшибке - Семантические ошибки.
Функция Ошибки() Экспорт

	Возврат _Ошибки;

КонецФункции

// Возвращает предупреждения интерпретации.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ПредупреждениеКонвертацииCURL - Семантические предупреждения.
Функция Предупреждения() Экспорт

	Возврат _Предупреждения;

КонецФункции

#КонецОбласти

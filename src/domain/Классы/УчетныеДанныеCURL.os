Перем _Выражение; // ВыражениеЗначенияCURL
Перем _Пользователь; // Строка, Неопределено
Перем _Пароль; // Строка, Неопределено
Перем _ПарольУказан; // Булево
Перем _ТребуетРазбора; // Булево
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт учётные данные curl.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Пользователь - Строка, Неопределено - Имя пользователя.
//   Пароль - Строка, Неопределено - Пароль.
//   ПарольУказан - Булево - Признак явного пароля.
//   ТребуетРазбора - Булево - Признак отложенного разбора.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
Процедура ПриСозданииОбъекта(
	Выражение,
	Пользователь,
	Пароль,
	ПарольУказан,
	ТребуетРазбора,
	Источник
)

	_Выражение = Выражение;
	_Пользователь = Пользователь;
	_Пароль = Пароль;
	_ПарольУказан = ПарольУказан;
	_ТребуетРазбора = ТребуетРазбора;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходное выражение.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Исходное выражение.
Функция Выражение() Экспорт
	Возврат _Выражение;
КонецФункции

// Возвращает имя пользователя.
//
// Возвращаемое значение:
//   Строка, Неопределено - Имя пользователя или Неопределено.
Функция Пользователь() Экспорт
	Возврат _Пользователь;
КонецФункции

// Возвращает пароль.
//
// Возвращаемое значение:
//   Строка, Неопределено - Пароль или Неопределено.
Функция Пароль() Экспорт
	Возврат _Пароль;
КонецФункции

// Возвращает признак явного пароля.
//
// Возвращаемое значение:
//   Булево - Истина, если пароль указан.
Функция ПарольУказан() Экспорт
	Возврат _ПарольУказан;
КонецФункции

// Возвращает признак отложенного разбора.
//
// Возвращаемое значение:
//   Булево - Истина, если выражение содержит переменные.
Функция ТребуетРазбора() Экспорт
	Возврат _ТребуетРазбора;
КонецФункции

// Возвращает исходную опцию.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Исходная опция.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

Перем _Выражение; // ВыражениеЗначенияCURL
Перем _Поставщик; // Строка, Неопределено
Перем _ВторойПрефиксПоставщика; // Строка, Неопределено
Перем _Регион; // Строка, Неопределено
Перем _Сервис; // Строка, Неопределено
Перем _ТребуетРазбора; // Булево
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создаёт параметры подписи AWS V4.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Поставщик - Строка, Неопределено - Первый префикс поставщика.
//   ВторойПрефиксПоставщика - Строка, Неопределено - Второй префикс поставщика.
//   Регион - Строка, Неопределено - Регион.
//   Сервис - Строка, Неопределено - Сервис.
//   ТребуетРазбора - Булево - Признак отложенного разбора.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
Процедура ПриСозданииОбъекта(
	Выражение,
	Поставщик,
	ВторойПрефиксПоставщика,
	Регион,
	Сервис,
	ТребуетРазбора,
	Источник
)

	_Выражение = Выражение;
	_Поставщик = Поставщик;
	_ВторойПрефиксПоставщика = ВторойПрефиксПоставщика;
	_Регион = Регион;
	_Сервис = Сервис;
	_ТребуетРазбора = ТребуетРазбора;
	_Источник = Источник;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходное выражение.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Исходное выражение.
Функция Выражение() Экспорт
	Возврат _Выражение;
КонецФункции

// Возвращает первый префикс поставщика.
//
// Возвращаемое значение:
//   Строка, Неопределено - Префикс или Неопределено.
Функция Поставщик() Экспорт
	Возврат _Поставщик;
КонецФункции

// Возвращает второй префикс поставщика.
//
// Возвращаемое значение:
//   Строка, Неопределено - Префикс или Неопределено.
Функция ВторойПрефиксПоставщика() Экспорт
	Возврат _ВторойПрефиксПоставщика;
КонецФункции

// Возвращает регион.
//
// Возвращаемое значение:
//   Строка, Неопределено - Регион или Неопределено.
Функция Регион() Экспорт
	Возврат _Регион;
КонецФункции

// Возвращает сервис.
//
// Возвращаемое значение:
//   Строка, Неопределено - Сервис или Неопределено.
Функция Сервис() Экспорт
	Возврат _Сервис;
КонецФункции

// Возвращает признак отложенного разбора.
//
// Возвращаемое значение:
//   Булево - Истина, если выражение содержит переменные.
Функция ТребуетРазбора() Экспорт
	Возврат _ТребуетРазбора;
КонецФункции

// Возвращает исходную опцию.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Исходная опция.
Функция Источник() Экспорт
	Возврат _Источник;
КонецФункции

#КонецОбласти

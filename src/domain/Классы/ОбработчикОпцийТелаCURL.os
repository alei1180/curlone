#Область СлужебныйПрограммныйИнтерфейс

// Применяет опцию к локальному построителю группы.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Опция соответствующего обработчика.
//   Построитель - ПостроительГруппыCURL - Получатель нормализованных значений.
Процедура Применить(Элемент, Построитель) Экспорт

	Имя = Элемент.ОписаниеОпции().КаноническоеИмя();
	Включить = Не Элемент.ОтрицательнаяФорма();
	Выражение = Неопределено;
	
	Если Элемент.ТокенЗначения() <> Неопределено Тогда
		Выражение = Новый ВыражениеЗначенияCURL(Элемент.ТокенЗначения());
	КонецЕсли;

	Если Имя = "form" Или Имя = "form-string" Тогда
		Классификатор = Новый КлассификаторФормыCURL();
		Если Имя = "form" Тогда
			Результат = Классификатор.Классифицировать(Выражение, Элемент);
		Иначе
			Результат = Классификатор.КлассифицироватьСтроку(Выражение, Элемент);
		КонецЕсли;

		Если Результат.Успешно() Тогда
			Для Каждого Часть Из Результат.Значение() Цикл
				Построитель.ДобавитьЧастьТела(Часть);
			КонецЦикла;
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	Иначе
		Разделитель = ?(Имя = "json", РазделителиЧастейТелаCURL.Нет(), РазделителиЧастейТелаCURL.Амперсанд());
		Результат = Новый КлассификаторДанныхCURL().Классифицировать(Имя, Выражение, Элемент, Разделитель);
		
		Если Результат.Успешно() Тогда
			Построитель.ДобавитьЧастьТела(Результат.Значение());
			
			Если Имя = "json" Тогда
				Заголовки = Новый КлассификаторЗаголовкаCURL();
				Построитель.ДобавитьЗаголовок(Заголовки.АвтоматическийJSON("Content-Type", "application/json", Элемент));
				Построитель.ДобавитьЗаголовок(Заголовки.АвтоматическийJSON("Accept", "application/json", Элемент));
			КонецЕсли;
		Иначе
			Построитель.ДобавитьОшибки(Результат.Ошибки());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


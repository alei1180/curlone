#Использовать "../../shared"

Перем _ЯвныйМетод; // ВыражениеЗначенияCURL, Неопределено
Перем _МетодПоУмолчанию; // Строка
Перем _ПереноситьДанныеВURL; // Булево
Перем _НеПолучатьТело; // Булево
Перем _ТолькоИменаПриПеречислении; // Булево
Перем _СтрокаЗапроса; // СтрокаЗапросаCURL
Перем _Заголовки; // ФиксированныйМассив из ОперацияНадЗаголовкомCURL
Перем _Тело; // ТелоЗапросаCURL
Перем _Аутентификация; // АутентификацияCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемое описание запроса.
//
// Параметры:
//   ЯвныйМетод - ВыражениеЗначенияCURL, Неопределено - Метод из опции request.
//   МетодПоУмолчанию - Строка - Значение МетодыЗапросаПоУмолчаниюCURL.
//   ПереноситьДанныеВURL - Булево - Переносить части данных в URL.
//   НеПолучатьТело - Булево - Получать только метаданные.
//   ТолькоИменаПриПеречислении - Булево - Перечислять только имена.
//   СтрокаЗапроса - СтрокаЗапросаCURL - Дополнительные части запроса.
//   Заголовки - Массив, ФиксированныйМассив из ОперацияНадЗаголовкомCURL - Операции в порядке применения.
//   Тело - ТелоЗапросаCURL - Тело запроса.
//   Аутентификация - АутентификацияCURL - Параметры аутентификации.
Процедура ПриСозданииОбъекта(
	ЯвныйМетод,
	МетодПоУмолчанию,
	ПереноситьДанныеВURL,
	НеПолучатьТело,
	ТолькоИменаПриПеречислении,
	СтрокаЗапроса,
	Заголовки,
	Тело,
	Аутентификация
)

	_ЯвныйМетод = ЯвныйМетод;
	_МетодПоУмолчанию = МетодПоУмолчанию;
	_ПереноситьДанныеВURL = ПереноситьДанныеВURL;
	_НеПолучатьТело = НеПолучатьТело;
	_ТолькоИменаПриПеречислении = ТолькоИменаПриПеречислении;
	_СтрокаЗапроса = СтрокаЗапроса;
	_Заголовки = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Заголовки));
	_Тело = Тело;
	_Аутентификация = Аутентификация;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Метод из опции request.
//
// Возвращаемое значение:
//   ВыражениеЗначенияCURL, Неопределено - Метод из опции request.
Функция ЯвныйМетод() Экспорт

	Возврат _ЯвныйМетод;

КонецФункции

// Значение МетодыЗапросаПоУмолчаниюCURL.
//
// Возвращаемое значение:
//   Строка - Значение МетодыЗапросаПоУмолчаниюCURL.
Функция МетодПоУмолчанию() Экспорт

	Возврат _МетодПоУмолчанию;

КонецФункции

// Переносить части данных в URL.
//
// Возвращаемое значение:
//   Булево - Переносить части данных в URL.
Функция ПереноситьДанныеВURL() Экспорт

	Возврат _ПереноситьДанныеВURL;

КонецФункции

// Получать только метаданные.
//
// Возвращаемое значение:
//   Булево - Получать только метаданные.
Функция НеПолучатьТело() Экспорт

	Возврат _НеПолучатьТело;

КонецФункции

// Перечислять только имена.
//
// Возвращаемое значение:
//   Булево - Перечислять только имена.
Функция ТолькоИменаПриПеречислении() Экспорт

	Возврат _ТолькоИменаПриПеречислении;

КонецФункции

// Дополнительные части запроса.
//
// Возвращаемое значение:
//   СтрокаЗапросаCURL - Дополнительные части запроса.
Функция СтрокаЗапроса() Экспорт

	Возврат _СтрокаЗапроса;

КонецФункции

// Операции в порядке применения.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ОперацияНадЗаголовкомCURL - Операции в порядке применения.
Функция Заголовки() Экспорт

	Возврат _Заголовки;

КонецФункции

// Тело запроса.
//
// Возвращаемое значение:
//   ТелоЗапросаCURL - Тело запроса.
Функция Тело() Экспорт

	Возврат _Тело;

КонецФункции

// Параметры аутентификации.
//
// Возвращаемое значение:
//   АутентификацияCURL - Параметры аутентификации.
Функция Аутентификация() Экспорт

	Возврат _Аутентификация;

КонецФункции

#КонецОбласти

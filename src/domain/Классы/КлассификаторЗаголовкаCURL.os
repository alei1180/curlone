#Область ПрограммныйИнтерфейс

// Классифицирует значение --header без чтения внешних источников.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Классифицируемое выражение.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с операцией над заголовком.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Возврат СоздатьОтложенныйРезультат(Выражение, Источник, ГрамматикиЗначенийCURL.Заголовок());
	КонецЕсли;

	Операция = КлассифицироватьЛитерал(Выражение, Источник);

	Возврат Новый РезультатКлассификацииCURL(Операция, Новый Массив);

КонецФункции

// Классифицирует значение --user-agent.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Классифицируемое выражение.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с операцией над заголовком.
Функция КлассифицироватьПользовательскийАгент(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Возврат СоздатьОтложенныйРезультат(
			Выражение,
			Источник,
			ГрамматикиЗначенийCURL.ПользовательскийАгент()
		);
	КонецЕсли;

	Если Выражение.ЛитеральноеЗначение() = "" Тогда
		Действие = ДействияНадЗаголовкамиCURL.Удалить();
		Значение = Неопределено;
	Иначе
		Действие = ДействияНадЗаголовкамиCURL.УстановитьЕслиОтсутствует();
		Значение = Выражение.ЛитеральноеЗначение();
	КонецЕсли;

	Операция = Новый ОперацияНадЗаголовкомCURL(
		Действие,
		Выражение,
		"User-Agent",
		Значение,
		Неопределено,
		Неопределено,
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Операция, Новый Массив);

КонецФункции

// Создаёт условную операцию для автоматического JSON-заголовка.
//
// Параметры:
//   Имя - Строка - Имя заголовка.
//   Значение - Строка - Значение заголовка.
//   Источник - ЭлементРазобраннойКомандыCURL - Первая опция --json.
//
// Возвращаемое значение:
//   ОперацияНадЗаголовкомCURL - Условная операция установки.
Функция АвтоматическийJSON(Имя, Значение, Источник) Экспорт

	Возврат Новый ОперацияНадЗаголовкомCURL(
		ДействияНадЗаголовкамиCURL.УстановитьЕслиОтсутствует(),
		Неопределено,
		Имя,
		Значение,
		Неопределено,
		Неопределено,
		Ложь,
		Источник
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьЛитерал(Выражение, Источник)

	Текст = Выражение.ЛитеральноеЗначение();
	Если Лев(Текст, 1) = "@" Тогда
		Возврат СоздатьЗагрузку(Текст, Выражение, Источник);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Текст, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Имя = Лев(Текст, ПозицияДвоеточия - 1);
		Значение = Сред(Текст, ПозицияДвоеточия + 1);
		Действие = ?(Значение = "", ДействияНадЗаголовкамиCURL.Удалить(), ДействияНадЗаголовкамиCURL.Установить());

		Если Значение = "" Тогда
			Значение = Неопределено;
		КонецЕсли;
	ИначеЕсли Прав(Текст, 1) = ";" Тогда
		Имя = Лев(Текст, СтрДлина(Текст) - 1);
		Значение = Неопределено;
		Действие = ДействияНадЗаголовкамиCURL.ПередатьПустой();
	Иначе
		Имя = Текст;
		Значение = Неопределено;
		Действие = ДействияНадЗаголовкамиCURL.Установить();
	КонецЕсли;

	Возврат Новый ОперацияНадЗаголовкомCURL(
		Действие,
		Выражение,
		Имя,
		Значение,
		Неопределено,
		Неопределено,
		Ложь,
		Источник
	);

КонецФункции

Функция СоздатьЗагрузку(Текст, Выражение, Источник)

	Путь = Сред(Текст, 2);
	Если Путь = "-" Тогда
		Действие = ДействияНадЗаголовкамиCURL.ЗагрузитьИзСтандартногоВвода();
		Путь = Неопределено;
	Иначе
		Действие = ДействияНадЗаголовкамиCURL.ЗагрузитьИзФайла();
	КонецЕсли;

	Возврат Новый ОперацияНадЗаголовкомCURL(
		Действие,
		Выражение,
		Неопределено,
		Неопределено,
		Путь,
		Неопределено,
		Ложь,
		Источник
	);

КонецФункции

Функция СоздатьОтложенныйРезультат(Выражение, Источник, Грамматика)

	ОтложеннаяКлассификация = Новый ОтложеннаяКлассификацияCURL(Выражение, Грамматика, Источник);
	Операция = Новый ОперацияНадЗаголовкомCURL(
		ДействияНадЗаголовкамиCURL.ОпределитьПослеВычисления(),
		Выражение,
		Неопределено,
		Неопределено,
		Неопределено,
		ОтложеннаяКлассификация,
		Истина,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Операция, Новый Массив);

КонецФункции

#КонецОбласти

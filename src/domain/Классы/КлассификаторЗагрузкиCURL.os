#Область ПрограммныйИнтерфейс

// Классифицирует источник --upload-file без чтения данных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Источник загружаемого тела.
//   Источник - ЭлементРазобраннойКомандыCURL - Опция загрузки.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Часть тела либо ошибка источника нескольких передач.
Функция Классифицировать(Выражение, Источник) Экспорт

	Отложенная = Неопределено;
	ПутьКФайлу = Неопределено;

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Режим = РежимыИсточникаТелаCURL.ОпределитьПослеВычисления();
		Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение,
			ГрамматикиЗначенийCURL.ДвоичныеДанные(), Источник);
	Иначе
		Путь = Выражение.ЛитеральноеЗначение();

		Если СодержитАктивныйШаблон(Путь) Тогда
			Возврат КлассифицироватьШаблон(Путь, Выражение, Источник);
		КонецЕсли;

		Если Путь = "-" Тогда
			Режим = РежимыИсточникаТелаCURL.СтандартныйВвод();
		ИначеЕсли Путь = "." Тогда
			Режим = РежимыИсточникаТелаCURL.НеблокирующийСтандартныйВвод();
		Иначе
			Режим = РежимыИсточникаТелаCURL.ДвоичныйФайл();
			ПутьКФайлу = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(
				Путь, "\{", "{"), "\}", "}"), "\[", "["), "\]", "]");
		КонецЕсли;
	КонецЕсли;

	Часть = СоздатьЧасть(Режим, Выражение, ПутьКФайлу, Источник, Отложенная);

	Возврат Новый РезультатКлассификацииCURL(Часть, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЧасть(Режим, Выражение, ПутьКФайлу, Источник, Отложенная = Неопределено)

	Содержимое = Новый СодержимоеЧастиТелаCURL(Режим, Выражение, Неопределено, ПутьКФайлу);
	Поле = Новый ОписаниеПоляТелаCURL(Неопределено, Неопределено, Неопределено, Новый Массив);

	Возврат Новый ЧастьТелаЗапросаCURL(
		ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла(),
		Содержимое,
		Поле,
		Ложь,
		РазделителиЧастейТелаCURL.Нет(),
		Отложенная,
		Источник
	);

КонецФункции

Функция КлассифицироватьШаблон(Путь, Выражение, Источник)

	НачалоСписка = СтрНайти(Путь, "{");
	КонецСписка = СтрНайти(Путь, "}");
	Если НачалоСписка = 0 Или КонецСписка <= НачалоСписка Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	ДоСписка = Лев(Путь, НачалоСписка - 1);
	ПослеСписка = Сред(Путь, КонецСписка + 1);
	Значения = СтрРазделить(Сред(Путь, НачалоСписка + 1, КонецСписка - НачалоСписка - 1), ",", Ложь);
	Если Значения.Количество() < 2 Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Если ПустаяСтрока(Значение) Тогда
			Возврат Ошибка(Источник);
		КонецЕсли;

		Части.Добавить(СоздатьЧасть(
			РежимыИсточникаТелаCURL.ДвоичныйФайл(),
			Выражение,
			ДоСписка + Значение + ПослеСписка,
			Источник
		));
	КонецЦикла;

	Возврат Новый РезультатКлассификацииCURL(Новый ФиксированныйМассив(Части), Новый Массив);

КонецФункции

Функция СодержитАктивныйШаблон(Путь)

	Экранирован = Ложь;
	Для Позиция = 1 По СтрДлина(Путь) Цикл
		Символ = Сред(Путь, Позиция, 1);

		Если Экранирован Тогда
			Экранирован = Ложь;
			Продолжить;
		КонецЕсли;

		Если Символ = "\" Тогда
			Экранирован = Истина;
			Продолжить;
		КонецЕсли;

		Если Символ = "{" Тогда
			Возврат Истина;
		КонецЕсли;

		Если Символ = "[" Тогда
			Остаток = Сред(Путь, Позиция + 1);
			КонецДиапазона = СтрНайти(Остаток, "]");
			Если КонецДиапазона > 0 Тогда
				Диапазон = Лев(Остаток, КонецДиапазона - 1);
				Если СтрНайти(СтрРазделить(Диапазон, ":", Истина)[0], "-") > 0 Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Ошибка(Источник)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач(),
		"Источник загрузки раскрывается в несколько передач",
		Источник
	));

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

#КонецОбласти

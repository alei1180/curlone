#Область ПрограммныйИнтерфейс

// Классифицирует составную MIME-форму curl без чтения файлов.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное значение формы.
//   Источник - ЭлементРазобраннойКомандыCURL - Опция формы.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - ФиксированныйМассив частей тела либо безопасные ошибки.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Части = Новый Массив;
		Части.Добавить(СоздатьОтложеннуюЧасть(Выражение, Источник, ГрамматикиЗначенийCURL.Форма()));
		Возврат Успех(Новый ФиксированныйМассив(Части));
	КонецЕсли;

	Возврат КлассифицироватьЛитерал(Выражение, Источник, Ложь);

КонецФункции

// Классифицирует строковое поле формы, в котором значение трактуется буквально.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное значение формы.
//   Источник - ЭлементРазобраннойКомандыCURL - Опция формы.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - ФиксированныйМассив частей тела либо безопасные ошибки.
Функция КлассифицироватьСтроку(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Части = Новый Массив;
		Части.Добавить(СоздатьОтложеннуюЧасть(Выражение, Источник, ГрамматикиЗначенийCURL.СтроковаяФорма()));
		Возврат Успех(Новый ФиксированныйМассив(Части));
	КонецЕсли;

	Возврат КлассифицироватьЛитерал(Выражение, Источник, Истина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьЛитерал(Выражение, Источник, СтроковаяФорма)

	Текст = Выражение.ЛитеральноеЗначение();
	ПозицияРавно = СтрНайти(Текст, "=");

	Если ПозицияРавно = 0 Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	ИмяПоля = Лев(Текст, ПозицияРавно - 1);
	Значение = Сред(Текст, ПозицияРавно + 1);

	Если СтроковаяФорма Тогда
		Части = Новый Массив;
		Части.Добавить(СоздатьЧасть(
			Выражение,
			Источник,
			ИмяПоля,
			РежимыИсточникаТелаCURL.ЛитеральноеЗначение(),
			Значение,
			Неопределено,
			Неопределено,
			Неопределено,
			Новый Массив
		));
		Возврат Успех(Новый ФиксированныйМассив(Части));
	КонецЕсли;

	Если Лев(Значение, 1) = "@" И СтрНайти(Значение, ",") > 0 Тогда
		Возврат СоздатьЧастиИзСпискаФайлов(Значение, Выражение, Источник, ИмяПоля);
	КонецЕсли;

	Сегменты = РазделитьСУчетомКавычек(Значение, ";");
	Если Сегменты = Неопределено Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Основное = Сегменты[0];
	ПроверяемоеОсновное = Раскодировать(Основное);
	Если Лев(ПроверяемоеОсновное, 1) = "(" Или Лев(ПроверяемоеОсновное, 1) = ")" Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Модификаторы = РазобратьМодификаторы(Сегменты, Источник);
	Если Модификаторы = Неопределено Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Возврат СоздатьЧастиФормы(
		Основное,
		Модификаторы,
		Выражение,
		Источник,
		ИмяПоля
	);

КонецФункции

Функция СоздатьЧастиИзСпискаФайлов(Значение, Выражение, Источник, ИмяПоля)

	ОписанияФайлов = РазделитьСУчетомКавычек(Значение, ",");
	Если ОписанияФайлов = Неопределено Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого ОписаниеФайла Из ОписанияФайлов Цикл
		Сегменты = РазделитьСУчетомКавычек(ОписаниеФайла, ";");
		Если Сегменты = Неопределено Тогда
			Возврат Ошибка(Источник);
		КонецЕсли;

		Основное = Сегменты[0];
		Если Лев(Основное, 1) = "@" Тогда
			Основное = Сред(Основное, 2);
		КонецЕсли;

		Путь = Раскодировать(Основное);
		Модификаторы = РазобратьМодификаторы(Сегменты, Источник);
		Если ПустаяСтрока(Путь) Или Модификаторы = Неопределено Тогда
			Возврат Ошибка(Источник);
		КонецЕсли;

		ИмяФайла = ?(
			Модификаторы.ИмяФайла = Неопределено,
			Новый Файл(Путь).Имя,
			Модификаторы.ИмяФайла
		);
		Части.Добавить(СоздатьЧасть(
			Выражение,
			Источник,
			ИмяПоля,
			РежимФайла(Путь),
			Неопределено,
			?(Путь = "-", Неопределено, Путь),
			ИмяФайла,
			Модификаторы.MIMEТип,
			Модификаторы.Заголовки
		));
	КонецЦикла;

	Возврат Успех(Новый ФиксированныйМассив(Части));

КонецФункции

Функция РазобратьМодификаторы(Сегменты, Источник)

	MIMEТип = Неопределено;
	ИмяФайла = Неопределено;
	Заголовки = Новый Массив;

	Для Индекс = 1 По Сегменты.ВГраница() Цикл
		Модификатор = Сегменты[Индекс];

		Если Лев(Модификатор, 5) = "type=" Тогда
			MIMEТип = Раскодировать(Сред(Модификатор, 6));
		ИначеЕсли Лев(Модификатор, 9) = "filename=" Тогда
			ИмяФайла = Раскодировать(Сред(Модификатор, 10));
		ИначеЕсли Лев(Модификатор, 8) = "headers=" Тогда
			ЗначениеЗаголовка = Раскодировать(Сред(Модификатор, 9));
			Заголовки.Добавить(СоздатьЗаголовокФормы(ЗначениеЗаголовка, Источник));
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("MIMEТип, ИмяФайла, Заголовки", MIMEТип, ИмяФайла, Заголовки);

КонецФункции

Функция СоздатьЧастиФормы(
	Основное,
	Модификаторы,
	Выражение,
	Источник,
	ИмяПоля
)

	Части = Новый Массив;
	Если Лев(Основное, 1) = "@" Тогда
		Возврат СоздатьЧастиИзФайлов(
			Основное,
			Модификаторы,
			Выражение,
			Источник,
			ИмяПоля
		);
	ИначеЕсли Лев(Основное, 1) = "<" Тогда
		Путь = Раскодировать(Сред(Основное, 2));
		Если Путь = "" Тогда
			Возврат Ошибка(Источник);
		КонецЕсли;

		Части.Добавить(СоздатьЧасть(
			Выражение,
			Источник,
			ИмяПоля,
			РежимТекстовогоФайла(Путь),
			Неопределено,
			?(Путь = "-", Неопределено, Путь),
			Неопределено,
			Модификаторы.MIMEТип,
			Модификаторы.Заголовки
		));
	Иначе
		Части.Добавить(СоздатьЧасть(
			Выражение,
			Источник,
			ИмяПоля,
			РежимыИсточникаТелаCURL.ЛитеральноеЗначение(),
			Раскодировать(Основное),
			Неопределено,
			Модификаторы.ИмяФайла,
			Модификаторы.MIMEТип,
			Модификаторы.Заголовки
		));
	КонецЕсли;

	Возврат Успех(Новый ФиксированныйМассив(Части));

КонецФункции

Функция СоздатьЧастиИзФайлов(
	Основное,
	Модификаторы,
	Выражение,
	Источник,
	ИмяПоля
)

	Файлы = РазделитьСУчетомКавычек(Сред(Основное, 2), ",");
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат Ошибка(Источник);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Путь = Раскодировать(Файл);
		Если Путь = "" Тогда
			Возврат Ошибка(Источник);
		КонецЕсли;

		ПередаваемоеИмяФайла = ?(
			Модификаторы.ИмяФайла = Неопределено,
			Новый Файл(Путь).Имя,
			Модификаторы.ИмяФайла
		);

		Части.Добавить(СоздатьЧасть(
			Выражение,
			Источник,
			ИмяПоля,
			РежимФайла(Путь),
			Неопределено,
			?(Путь = "-", Неопределено, Путь),
			ПередаваемоеИмяФайла,
			Модификаторы.MIMEТип,
			Модификаторы.Заголовки
		));
	КонецЦикла;

	Возврат Успех(Новый ФиксированныйМассив(Части));

КонецФункции

Функция СоздатьЧасть(
	Выражение,
	Источник,
	ИмяПоля,
	Режим,
	Текст,
	Путь,
	ИмяФайла,
	MIMEТип,
	Заголовки
)

	Содержимое = Новый СодержимоеЧастиТелаCURL(Режим, Выражение, Текст, Путь);
	Поле = Новый ОписаниеПоляТелаCURL(ИмяПоля, ИмяФайла, MIMEТип, Заголовки);

	Возврат Новый ЧастьТелаЗапросаCURL(
		ВидыЧастейТелаЗапросаCURL.ПолеMultipart(),
		Содержимое,
		Поле,
		Ложь,
		РазделителиЧастейТелаCURL.Нет(),
		Неопределено,
		Источник
	);

КонецФункции

Функция СоздатьОтложеннуюЧасть(Выражение, Источник, Грамматика)

	Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение, Грамматика, Источник);
	Содержимое = Новый СодержимоеЧастиТелаCURL(
		РежимыИсточникаТелаCURL.ОпределитьПослеВычисления(),
		Выражение,
		Неопределено,
		Неопределено
	);
	Поле = Новый ОписаниеПоляТелаCURL(Неопределено, Неопределено, Неопределено, Новый Массив);

	Возврат Новый ЧастьТелаЗапросаCURL(
		ВидыЧастейТелаЗапросаCURL.ОпределитьПослеВычисления(),
		Содержимое,
		Поле,
		Неопределено,
		РазделителиЧастейТелаCURL.Нет(),
		Отложенная,
		Источник
	);

КонецФункции

Функция СоздатьЗаголовокФормы(Значение, Источник)

	Если Лев(Значение, 1) = "@" Тогда
		Действие = ?(Значение = "@-", ДействияНадЗаголовкамиCURL.ЗагрузитьИзСтандартногоВвода(),
			ДействияНадЗаголовкамиCURL.ЗагрузитьИзФайла());
		Путь = ?(Значение = "@-", Неопределено, Сред(Значение, 2));

		Возврат Новый ОперацияНадЗаголовкомCURL(
			Действие,
			Неопределено,
			Неопределено,
			Неопределено,
			Путь,
			Неопределено,
			Ложь,
			Источник
		);
	КонецЕсли;

	Позиция = СтрНайти(Значение, ":");
	Если Позиция = 0 Тогда
		Возврат Новый ОперацияНадЗаголовкомCURL(
			ДействияНадЗаголовкамиCURL.Установить(),
			Неопределено,
			Значение,
			Неопределено,
			Неопределено,
			Неопределено,
			Ложь,
			Источник
		);
	КонецЕсли;

	Возврат Новый ОперацияНадЗаголовкомCURL(
		ДействияНадЗаголовкамиCURL.Установить(),
		Неопределено,
		Лев(Значение, Позиция - 1),
		Сред(Значение, Позиция + 1),
		Неопределено,
		Неопределено,
		Ложь,
		Источник
	);

КонецФункции

Функция РазделитьСУчетомКавычек(Текст, Разделитель)

	Результат = Новый Массив;
	Текущий = "";
	ВКавычках = Ложь;
	Экранирован = Ложь;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);

		Если Экранирован Тогда
			Текущий = Текущий + "\" + Символ;
			Экранирован = Ложь;
		ИначеЕсли Символ = "\" Тогда
			Экранирован = Истина;
		ИначеЕсли Символ = """" Тогда
			Текущий = Текущий + Символ;
			ВКавычках = Не ВКавычках;
		ИначеЕсли Символ = Разделитель И Не ВКавычках Тогда
			Результат.Добавить(Текущий);
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
	КонецЦикла;

	Если ВКавычках Или Экранирован Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат.Добавить(Текущий);

	Возврат Результат;

КонецФункции

Функция Раскодировать(Текст)

	Если СтрДлина(Текст) >= 2 И Лев(Текст, 1) = """" И Прав(Текст, 1) = """" Тогда
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	КонецЕсли;

	ОбратнаяКосая = "\";
	Текст = СтрЗаменить(Текст, ОбратнаяКосая + """", """");

	Возврат СтрЗаменить(Текст, ОбратнаяКосая + ОбратнаяКосая, ОбратнаяКосая);

КонецФункции

Функция РежимФайла(Путь)
	Возврат ?(Путь = "-", РежимыИсточникаТелаCURL.СтандартныйВвод(), РежимыИсточникаТелаCURL.ДвоичныйФайл());
КонецФункции

Функция РежимТекстовогоФайла(Путь)
	Возврат ?(
		Путь = "-",
		РежимыИсточникаТелаCURL.СтандартныйВвод(),
		РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL()
	);
КонецФункции

Функция Ошибка(Источник)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции(),
		"Недопустимое значение опции формы",
		Источник
	));

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

Функция Успех(Значение)
	Возврат Новый РезультатКлассификацииCURL(Значение, Новый Массив);
КонецФункции

#КонецОбласти

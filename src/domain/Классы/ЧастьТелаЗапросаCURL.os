Перем _Вид; // Строка
Перем _Содержимое; // СодержимоеЧастиТелаCURL
Перем _Поле; // ОписаниеПоляТелаCURL
Перем _Кодировать; // Булево, Неопределено
Перем _РазделительПеред; // Строка
Перем _ОтложеннаяКлассификация; // ОтложеннаяКлассификацияCURL, Неопределено
Перем _Источник; // ЭлементРазобраннойКомандыCURL

#Область ОбработчикиСобытий

// Создает неизменяемую часть тела из содержимого и описания поля.
//
// Параметры:
//   Вид - Строка - Вид части тела.
//   Содержимое - СодержимоеЧастиТелаCURL - Классифицированный источник содержимого.
//   Поле - ОписаниеПоляТелаCURL - Имя и оформление поля, включая заголовки.
//   Кодировать - Булево, Неопределено - Требование кодирования содержимого.
//   РазделительПеред - Строка - Разделитель перед частью.
//   ОтложеннаяКлассификация - ОтложеннаяКлассификацияCURL, Неопределено - Разбор после вычисления.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
Процедура ПриСозданииОбъекта(
	Вид,
	Содержимое,
	Поле,
	Кодировать,
	РазделительПеред,
	ОтложеннаяКлассификация,
	Источник
)

	_Вид = Вид;
	_Содержимое = Содержимое;
	_Поле = Поле;
	_Кодировать = Кодировать;
	_РазделительПеред = РазделительПеред;
	_ОтложеннаяКлассификация = ОтложеннаяКлассификация;
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Методы чтения возвращают поля неизменяемой части тела.
// Возвращаемое значение:
//   Строка - Вид части тела.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращаемое значение:
//   Строка - Режим источника.
Функция РежимИсточника() Экспорт

	Возврат _Содержимое.РежимИсточника();

КонецФункции

// Возвращаемое значение:
//   ВыражениеЗначенияCURL - Исходное выражение.
Функция Выражение() Экспорт

	Возврат _Содержимое.Выражение();

КонецФункции

// Возвращаемое значение:
//   Строка, Неопределено - Текст части.
Функция Текст() Экспорт

	Возврат _Содержимое.Текст();

КонецФункции

// Возвращаемое значение:
//   Строка, Неопределено - Путь к файлу.
Функция ПутьКФайлу() Экспорт

	Возврат _Содержимое.ПутьКФайлу();

КонецФункции

// Возвращаемое значение:
//   Строка, Неопределено - Имя поля формы.
Функция ИмяПоля() Экспорт

	Возврат _Поле.ИмяПоля();

КонецФункции

// Возвращаемое значение:
//   Строка, Неопределено - Передаваемое имя файла.
Функция ИмяФайла() Экспорт

	Возврат _Поле.ИмяФайла();

КонецФункции

// Возвращаемое значение:
//   Строка, Неопределено - MIME-тип части.
Функция MIMEТип() Экспорт

	Возврат _Поле.MIMEТип();

КонецФункции

// Возвращаемое значение:
//   ФиксированныйМассив из ОперацияНадЗаголовкомCURL - Заголовки части.
Функция Заголовки() Экспорт

	Возврат _Поле.Заголовки();

КонецФункции

// Возвращаемое значение:
//   Булево, Неопределено - Признак кодирования.
Функция Кодировать() Экспорт

	Возврат _Кодировать;

КонецФункции

// Возвращаемое значение:
//   Строка - Разделитель перед частью.
Функция РазделительПеред() Экспорт

	Возврат _РазделительПеред;

КонецФункции

// Возвращаемое значение:
//   ОтложеннаяКлассификацияCURL, Неопределено - Отложенный разбор.
Функция ОтложеннаяКлассификация() Экспорт

	Возврат _ОтложеннаяКлассификация;

КонецФункции

// Возвращаемое значение:
//   Булево - Признак отложенного разбора.
Функция ТребуетРазбора() Экспорт

	Возврат _ОтложеннаяКлассификация <> Неопределено;

КонецФункции

// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL - Исходная опция.
Функция Источник() Экспорт

	Возврат _Источник;

КонецФункции

// Возвращает часть с новым разделителем, сохраняя отложенную классификацию и все остальные поля.
//
// Параметры:
//   Разделитель - Строка - Новый разделитель перед частью.
//
// Возвращаемое значение:
//   ЧастьТелаЗапросаCURL - Новая неизменяемая часть.
Функция СРазделителем(Разделитель) Экспорт

	Возврат Новый ЧастьТелаЗапросаCURL(
		_Вид,
		_Содержимое,
		_Поле,
		_Кодировать,
		Разделитель,
		_ОтложеннаяКлассификация,
		_Источник
	);

КонецФункции

// Возвращает часть без отложенного разбора после успешной классификации.
// Содержимое и описание поля должны быть уже вычислены вызывающим этапом.
//
// Возвращаемое значение:
//   ЧастьТелаЗапросаCURL - Неизменяемая часть без отложенной классификации.
Функция БезОтложеннойКлассификации() Экспорт

	Если _ОтложеннаяКлассификация = Неопределено Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;
	
	Возврат Новый ЧастьТелаЗапросаCURL(
		_Вид,
		_Содержимое,
		_Поле,
		_Кодировать,
		_РазделительПеред,
		Неопределено,
		_Источник
	);

КонецФункции

#КонецОбласти

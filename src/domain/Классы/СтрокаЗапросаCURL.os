#Использовать "../../shared"

Перем _Части; // ФиксированныйМассив из ЧастьСтрокиЗапросаCURL
Перем _РазделительПередПервойЧастью; // Строка

#Область ОбработчикиСобытий

// Создаёт неизменяемое описание строки запроса.
//
// Параметры:
//   Части - Массив, ФиксированныйМассив из ЧастьСтрокиЗапросаCURL - Части в порядке применения.
//   РазделительПередПервойЧастью - Строка - Значение из модуля РазделителиСтрокиЗапросаCURL.
Процедура ПриСозданииОбъекта(Части, РазделительПередПервойЧастью)

	_Части = Новый ФиксированныйМассив(Новый КоллекцииМоделиCURL().Скопировать(Части));
	_РазделительПередПервойЧастью = РазделительПередПервойЧастью;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает части строки запроса в порядке применения.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ЧастьСтрокиЗапросаCURL - Части в порядке применения.
Функция Части() Экспорт
	Возврат _Части;
КонецФункции

// Возвращает разделитель перед первой частью.
//
// Возвращаемое значение:
//   Строка - Значение из модуля РазделителиСтрокиЗапросаCURL.
Функция РазделительПередПервойЧастью() Экспорт
	Возврат _РазделительПередПервойЧастью;
КонецФункции

#КонецОбласти

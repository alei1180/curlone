#Область ПрограммныйИнтерфейс

// Определяет активность настроек повторов.
//
// Параметры:
//   Количество - ЧисловоеЗначениеCURL, Неопределено - Количество повторов.
//
// Возвращаемое значение:
//   Булево - Истина для активных и условно активных повторов.
Функция Повторы(Количество) Экспорт

	Если Количество = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Количество.ТребуетВычисления() Или Количество.Значение() > 0;

КонецФункции

// Определяет активность настроек прокси.
//
// Параметры:
//   НастройкиПрокси - ПроксиCURL - Настройки прокси.
//
// Возвращаемое значение:
//   Булево - Истина для настроенного и условно активного прокси.
Функция Прокси(НастройкиПрокси) Экспорт

	Возврат НастройкиПрокси.Режим() <> РежимыПроксиCURL.Отключен();

КонецФункции

// Определяет активность файловых настроек результата.
//
// Параметры:
//   Результат - ОписаниеРезультатаCURL - Описание результата.
//
// Возвращаемое значение:
//   Булево - Истина для файлового и условно активного результата.
Функция ФайловыйРезультат(Результат) Экспорт

	Возврат Результат.Режим() <> РежимыРезультатаCURL.СтандартныйВывод();

КонецФункции

// Определяет применимость настроек FTP к ресурсу.
//
// Параметры:
//   Ресурс - РесурсCURL - Ресурс операции.
//
// Возвращаемое значение:
//   Булево - Истина для FTP, FTPS и динамического URL без исключающей FTP литеральной схемы.
Функция FTP(Ресурс) Экспорт

	Если Ресурс.ТребуетРазбора() Тогда
		Схема = Новый ОграниченияВыраженияCURL().ИзвестнаяСхема(Ресурс.АдресДляВыполнения());
		Возврат Схема = "" Или Схема = "ftp" Или Схема = "ftps";
	КонецЕсли;

	Возврат Ресурс.Протокол() = "ftp" Или Ресурс.Протокол() = "ftps";

КонецФункции

#КонецОбласти

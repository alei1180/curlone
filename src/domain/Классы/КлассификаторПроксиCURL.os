#Использовать url
#Использовать "../../public"

#Область ПрограммныйИнтерфейс

// Классифицирует адрес прокси через пакет url.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение классификации.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник классификации.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Значение либо безопасные ошибки.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение, ГрамматикиЗначенийCURL.Прокси(), Источник);
		Прокси = СоздатьМодель(
			РежимыПроксиCURL.ОпределитьПослеВычисления(),
			Выражение,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Отложенная,
			Истина,
			Источник
		);

		Возврат Новый РезультатКлассификацииCURL(Прокси, Новый Массив);
	КонецЕсли;

	Значение = Выражение.ЛитеральноеЗначение();

	Если Значение = "" Тогда
		Прокси = СоздатьМодель(
			РежимыПроксиCURL.Отключен(),
			Выражение,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Неопределено,
			Ложь,
			Источник
		);

		Возврат Новый РезультатКлассификацииCURL(Прокси, Новый Массив);
	КонецЕсли;

	Попытка
		АдресURL = Новый URL(ДобавитьСхемуПоУмолчанию(Значение));
		Протокол = НРег(АдресURL.Схема());

		Если Не ДопустимыйПротокол(Протокол) Тогда
			Возврат ОшибкаНедопустимогоЗначения(Источник);
		КонецЕсли;

		Сервер = АдресURL.Хост();
		Если Сервер = Неопределено Или Сервер = "" Тогда
			Возврат ОшибкаНедопустимогоЗначения(Источник);
		КонецЕсли;

		Порт = ?(АдресURL.Порт() = Неопределено, 1080, АдресURL.Порт());
		Если Порт < 1 Или Порт > 65535 Тогда
			Возврат ОшибкаНедопустимогоЗначения(Источник);
		КонецЕсли;

		Если СтрНайти(АдресURL.ВСтроку(), "?") > 0 Или АдресURL.КодированныйФрагмент() <> Неопределено Тогда
			Возврат ОшибкаНедопустимогоЗначения(Источник);
		КонецЕсли;

		ПутьUnixСокета = ОпределитьПутьUnixСокета(АдресURL, Протокол, Сервер);
		УчетныеДанные = РазобратьУчетныеДанные(АдресURL, Выражение, Источник);
	Исключение
		Возврат ОшибкаНедопустимогоЗначения(Источник);
	КонецПопытки;

	Прокси = СоздатьМодель(
		РежимыПроксиCURL.Настроен(),
		Выражение,
		Протокол,
		Сервер,
		Порт,
		ПутьUnixСокета,
		УчетныеДанные,
		Неопределено,
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Прокси, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьМодель(
	Режим,
	Адрес,
	Протокол,
	Сервер,
	Порт,
	Путь,
	Данные,
	Отложенная,
	ТребуетРазбора,
	Источник
)
	Возврат Новый ПроксиCURL(
		Режим,
		Адрес,
		Протокол,
		Сервер,
		Порт,
		Путь,
		Данные,
		Новый Массив,
		Отложенная,
		ТребуетРазбора,
		Источник,
		Неопределено
	);
КонецФункции

Функция ДобавитьСхемуПоУмолчанию(Адрес)
	Возврат ?(СтрНайти(Адрес, "://") = 0, ПротоколыCURL.HTTP() + "://" + Адрес, Адрес);
КонецФункции

Функция ДопустимыйПротокол(Протокол)

	Возврат Протокол = ПротоколыCURL.HTTP()
		Или Протокол = ПротоколыCURL.HTTPS()
		Или ЭтоПротоколSOCKS(Протокол);

КонецФункции

Функция ЭтоПротоколSOCKS(Протокол)

	Возврат Протокол = ПротоколыCURL.SOCKS4()
		Или Протокол = ПротоколыCURL.SOCKS4A()
		Или Протокол = ПротоколыCURL.SOCKS5()
		Или Протокол = ПротоколыCURL.SOCKS5H();

КонецФункции

Функция ОпределитьПутьUnixСокета(АдресURL, Протокол, Сервер)

	Путь = АдресURL.Путь();
	Если Путь = "" Или Путь = "/" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЭтоПротоколSOCKS(Протокол) Или НРег(Сервер) <> "localhost" Тогда
		ВызватьИсключение "Путь в адресе прокси недопустим";
	КонецЕсли;

	Возврат Путь;

КонецФункции

Функция РазобратьУчетныеДанные(АдресURL, Выражение, Источник)
	
	КодированныеДанные = АдресURL.КодированныеДанныеПользователя();
	Если КодированныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Позиция = СтрНайти(КодированныеДанные, ":");
	Если Позиция = 0 Тогда
		Пользователь = КодированиеURL.ДекодироватьUTF8(КодированныеДанные);
		Пароль = Неопределено;
		ПарольУказан = Ложь;
	Иначе
		Пользователь = КодированиеURL.ДекодироватьUTF8(Лев(КодированныеДанные, Позиция - 1));
		Пароль = КодированиеURL.ДекодироватьUTF8(Сред(КодированныеДанные, Позиция + 1));
		ПарольУказан = Истина;
	КонецЕсли;

	Возврат Новый УчетныеДанныеCURL(
		Выражение,
		Пользователь,
		Пароль,
		ПарольУказан,
		Ложь,
		Источник
	);

КонецФункции

Функция ОшибкаНедопустимогоЗначения(Источник)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции(),
		"Адрес прокси имеет недопустимый формат",
		Источник
	));

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

#КонецОбласти

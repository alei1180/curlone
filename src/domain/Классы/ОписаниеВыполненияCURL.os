#Использовать "../../shared"

Перем _Операции; // ФиксированныйМассив из ОперацияПередачиCURL

#Область ОбработчикиСобытий

// Создаёт неизменяемое описание выполнения.
//
// Параметры:
//   Операции - Массив, ФиксированныйМассив из ОперацияПередачиCURL - Операции в исходном порядке.
Процедура ПриСозданииОбъекта(Операции)

	_Операции = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Операции));

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Операции в исходном порядке.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ОперацияПередачиCURL - Операции в исходном порядке.
Функция Операции() Экспорт

	Возврат _Операции;

КонецФункции

#КонецОбласти

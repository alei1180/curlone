#Область ПрограммныйИнтерфейс

// Классифицирует выражение части строки запроса без чтения внешних источников.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Классифицируемое выражение.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный элемент команды.
//   РазрешитьНачальныйПлюс - Булево - Разрешает форму +текст без кодирования.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Успешный результат с частью строки запроса.
Функция Классифицировать(Выражение, Источник, РазрешитьНачальныйПлюс) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Возврат СоздатьОтложенныйРезультат(Выражение, Источник);
	КонецЕсли;

	Часть = КлассифицироватьЛитерал(
		Выражение.ЛитеральноеЗначение(),
		Выражение,
		Источник,
		РазрешитьНачальныйПлюс
	);

	Возврат Новый РезультатКлассификацииCURL(Часть, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьЛитерал(Значение, Выражение, Источник, РазрешитьНачальныйПлюс)

	Если РазрешитьНачальныйПлюс И Лев(Значение, 1) = "+" Тогда
		Возврат СоздатьТекст(
			Выражение,
			Источник,
			Неопределено,
			Сред(Значение, 2),
			Ложь,
			Ложь
		);
	КонецЕсли;

	ПозицияРавно = СтрНайти(Значение, "=");
	Если ПозицияРавно = 1 Тогда
		Возврат СоздатьТекст(
			Выражение,
			Источник,
			Неопределено,
			Сред(Значение, 2),
			Истина,
			Ложь
		);
	ИначеЕсли ПозицияРавно > 1 Тогда
		Возврат СоздатьТекст(
			Выражение,
			Источник,
			Лев(Значение, ПозицияРавно - 1),
			Сред(Значение, ПозицияРавно + 1),
			Истина,
			Истина
		);
	КонецЕсли;

	ПозицияСсылки = СтрНайти(Значение, "@");
	Если ПозицияСсылки = 1 Тогда
		Возврат СоздатьИзФайла(
			Выражение,
			Источник,
			Неопределено,
			Сред(Значение, 2),
			Ложь
		);
	ИначеЕсли ПозицияСсылки > 1 Тогда
		Возврат СоздатьИзФайла(
			Выражение,
			Источник,
			Лев(Значение, ПозицияСсылки - 1),
			Сред(Значение, ПозицияСсылки + 1),
			Истина
		);
	КонецЕсли;

	Возврат СоздатьТекст(
		Выражение,
		Источник,
		Неопределено,
		Значение,
		Истина,
		Ложь
	);

КонецФункции

Функция СоздатьТекст(
	Выражение,
	Источник,
	Имя,
	Текст,
	Кодировать,
	ДобавлятьЗнакРавно
)

	Возврат Новый ЧастьСтрокиЗапросаCURL(
		ВидыИсточниковЧастиСтрокиЗапросаCURL.Текст(),
		Выражение,
		Имя,
		Текст,
		Неопределено,
		Кодировать,
		ДобавлятьЗнакРавно,
		Неопределено,
		Источник
	);

КонецФункции

Функция СоздатьИзФайла(
	Выражение,
	Источник,
	Имя,
	ПутьКФайлу,
	ДобавлятьЗнакРавно
)

	Если ПутьКФайлу = "-" Тогда
		ВидИсточника = ВидыИсточниковЧастиСтрокиЗапросаCURL.СтандартныйВвод();
		ПутьКФайлу = Неопределено;
	Иначе
		ВидИсточника = ВидыИсточниковЧастиСтрокиЗапросаCURL.Файл();
	КонецЕсли;

	Возврат Новый ЧастьСтрокиЗапросаCURL(
		ВидИсточника,
		Выражение,
		Имя,
		Неопределено,
		ПутьКФайлу,
		Истина,
		ДобавлятьЗнакРавно,
		Неопределено,
		Источник
	);

КонецФункции

Функция СоздатьОтложенныйРезультат(Выражение, Источник)

	ОтложеннаяКлассификация = Новый ОтложеннаяКлассификацияCURL(
		Выражение,
		ГрамматикиЗначенийCURL.ЧастьЗапроса(),
		Источник
	);
	Часть = Новый ЧастьСтрокиЗапросаCURL(
		ВидыИсточниковЧастиСтрокиЗапросаCURL.ОпределитьПослеВычисления(),
		Выражение,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено,
		ОтложеннаяКлассификация,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Часть, Новый Массив);

КонецФункции

#КонецОбласти

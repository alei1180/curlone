#Область ПрограммныйИнтерфейс

// Классифицирует путь результата из --output без подстановки переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение пути.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходная опция.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Успешный результат с ОписаниеРезультатаCURL.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Режим = РежимыРезультатаCURL.ОпределитьПослеВычисления();
		ИмяФайла = Выражение;
		Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение, ГрамматикиЗначенийCURL.Результат(), Источник);
	ИначеЕсли Выражение.ЛитеральноеЗначение() = "-" Тогда
		Режим = РежимыРезультатаCURL.СтандартныйВывод();
		ИмяФайла = Неопределено;
		Отложенная = Неопределено;
	Иначе
		Режим = РежимыРезультатаCURL.Файл();
		ИмяФайла = Выражение;
		Отложенная = Неопределено;
	КонецЕсли;

	Описание = Новый ОписаниеРезультатаCURL(
		Режим,
		ИмяФайла,
		Неопределено,
		Ложь,
		Отложенная,
		Источник
	);
	
	Возврат Новый РезультатКлассификацииCURL(Описание, Новый Массив);

КонецФункции

#КонецОбласти

#Использовать "../../public"

#Область ПрограммныйИнтерфейс

// Классифицирует неотрицательное числовое выражение.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение классификации.
//   Формат - Строка - Формат классификации.
//   Источник - ЭлементРазобраннойКомандыCURL - Источник классификации.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Значение либо безопасные ошибки.
Функция Классифицировать(Выражение, Формат, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Число = Новый ЧисловоеЗначениеCURL(
			Выражение,
			Неопределено,
			Формат,
			Истина,
			Источник
		);
		Возврат Новый РезультатКлассификацииCURL(Число, Новый Массив);
	КонецЕсли;

	Текст = Выражение.ЛитеральноеЗначение();
	Если Формат = ФорматыЧисловыхЗначенийCURL.ЦелоеНеотрицательное() Тогда
		Значение = РазобратьЦелое(Текст);
	Иначе
		Значение = РазобратьДесятичное(Текст);
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат ОшибкаНедопустимогоЗначения(Источник);
	КонецЕсли;

	Число = Новый ЧисловоеЗначениеCURL(
		Выражение,
		Значение,
		Формат,
		Ложь,
		Источник
	);

	Возврат Новый РезультатКлассификацииCURL(Число, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьЦелое(Текст)

	Если Не СостоитИзЦифр(Текст) Или БольшеПредельного(Текст, "2147483647") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Число(Текст);

КонецФункции

Функция РазобратьДесятичное(Текст)

	Части = СтрРазделить(Текст, ".", Истина);
	Если Части.Количество() > 2 Или Не СостоитИзЦифр(Части[0]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Части.Количество() = 2 И Не СостоитИзЦифр(Части[1]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если БольшеПредельного(Части[0], "2147482") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДробнаяЧасть = ?(Части.Количество() = 2, Лев(Части[1] + "000", 3), "000");
	
	Возврат Число(Части[0]) * 1000 + Число(ДробнаяЧасть);

КонецФункции

Функция СостоитИзЦифр(Текст)

	Если СтрДлина(Текст) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция БольшеПредельного(Текст, Предел)

	БезНулей = СократитьНачальныеНули(Текст);

	Если СтрДлина(БезНулей) <> СтрДлина(Предел) Тогда
		Возврат СтрДлина(БезНулей) > СтрДлина(Предел);
	КонецЕсли;

	Возврат БезНулей > Предел;

КонецФункции

Функция СократитьНачальныеНули(Текст)

	Индекс = 1;
	Пока Индекс < СтрДлина(Текст) И Сред(Текст, Индекс, 1) = "0" Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Сред(Текст, Индекс);

КонецФункции

Функция ОшибкаНедопустимогоЗначения(Источник)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции(),
		"Числовое значение имеет недопустимый формат или выходит за переносимые границы",
		Источник
	));

	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);
	
КонецФункции

#КонецОбласти

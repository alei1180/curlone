#Использовать url
#Использовать "../../public"
#Использовать "../../syntax"

#Область ПрограммныйИнтерфейс

// Классифицирует выражение URL без подстановки переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение адреса.
//   Источник - ЭлементРазобраннойКомандыCURL - Исходный URL.
//
// Возвращаемое значение:
//   РезультатКлассификацииCURL - Результат с КлассифицированныйРесурсCURL либо ошибкой.
Функция Классифицировать(Выражение, Источник) Экспорт

	Если Не Выражение.ЯвляетсяЛитералом() Тогда
		Отложенная = Новый ОтложеннаяКлассификацияCURL(Выражение, ГрамматикиЗначенийCURL.URL(), Источник);
		Ресурс = Новый РесурсCURL(
			Выражение,
			Выражение,
			Неопределено,
			Неопределено,
			Неопределено,
			Отложенная,
			Истина,
			Источник
		);
		Значение = Новый КлассифицированныйРесурсCURL(
			Ресурс,
			Неопределено,
			РазделителиСтрокиЗапросаCURL.ОпределитьПоАдресу()
		);
		
		Возврат Новый РезультатКлассификацииCURL(Значение, Новый Массив);
	КонецЕсли;

	Адрес = Выражение.ЛитеральноеЗначение();
	Если Лев(Адрес, 1) = "@" Или СодержитАктивныйШаблон(Адрес) Тогда
		Возврат ОшибкаНесколькихПередач(Источник);
	КонецЕсли;

	РезультатРазбора = Новый АдаптерРазбораURLCURL().ПопытатьсяРазобратьЛитерал(Выражение, Источник);
	Если Не РезультатРазбора.Успешно() Тогда
		Возврат РезультатРазбора;
	КонецЕсли;

	Разобранный = РезультатРазбора.Значение();
	Ресурс = Новый РесурсCURL(
		Выражение,
		Разобранный.АдресДляВыполнения(),
		Разобранный.Фрагмент(),
		Разобранный.ФрагментУказан(),
		Разобранный.Протокол(),
		Неопределено,
		Ложь,
		Источник
	);
	
	Попытка
		УчетныеДанные = КлассифицироватьУчетныеДанные(Разобранный.КодированныеДанныеПользователя(), Источник);
	Исключение
		Ошибки = Новый Массив;
		Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
			КодыОшибокCurlone.НедопустимыйURL(),
			"URL имеет недопустимый формат",
			Источник
		));
		Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);
	КонецПопытки;

	Разделитель = ?(
		Разобранный.СтрокаЗапросаУказана(),
		РазделителиСтрокиЗапросаCURL.Амперсанд(),
		РазделителиСтрокиЗапросаCURL.ВопросительныйЗнак()
	);
	Значение = Новый КлассифицированныйРесурсCURL(Ресурс, УчетныеДанные, Разделитель);
	
	Возврат Новый РезультатКлассификацииCURL(Значение, Новый Массив);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьУчетныеДанные(КодированныеДанные, Источник)
	
	Если КодированныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Позиция = СтрНайти(КодированныеДанные, ":");
	Если Позиция = 0 Тогда
		Имя = КодированиеURL.ДекодироватьUTF8(КодированныеДанные);
		Пароль = Неопределено;
		ПарольУказан = Ложь;
	Иначе
		Имя = КодированиеURL.ДекодироватьUTF8(Лев(КодированныеДанные, Позиция - 1));
		Пароль = КодированиеURL.ДекодироватьUTF8(Сред(КодированныеДанные, Позиция + 1));
		ПарольУказан = Истина;
	КонецЕсли;

	Текст = Имя + ?(ПарольУказан, ":" + Пароль, "");
	Возврат Новый УчетныеДанныеCURL(
		СоздатьВыражение(Текст),
		Имя,
		Пароль,
		ПарольУказан,
		Ложь,
		Источник
	);

КонецФункции

Функция СодержитАктивныйШаблон(Адрес)

	Экранирован = Ложь;

	Для Позиция = 1 По СтрДлина(Адрес) Цикл
		Символ = Сред(Адрес, Позиция, 1);
		
		Если Экранирован Тогда
			Экранирован = Ложь;
			Продолжить;
		КонецЕсли;

		Если Символ = "\" Тогда
			Экранирован = Истина;
			Продолжить;
		КонецЕсли;

		Если Символ = "{" Или Символ = "}" Тогда
			Возврат Истина;
		КонецЕсли;

		Если Символ = "[" Тогда
			Остаток = Сред(Адрес, Позиция + 1);
			КонецДиапазона = СтрНайти(Остаток, "]");
			Если КонецДиапазона > 0 Тогда
				Диапазон = Лев(Остаток, КонецДиапазона - 1);
				Границы = СтрРазделить(Диапазон, ":", Истина)[0];
				Если СтрНайти(Границы, "-") > 0 Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СоздатьВыражение(Текст)
	
	Аргументы = Новый Массив;
	Аргументы.Добавить(Текст);

	ТокенЗначения = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены()[0];
	
	Возврат Новый ВыражениеЗначенияCURL(ТокенЗначения);

КонецФункции

Функция ОшибкаНесколькихПередач(Источник)
	
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый ФабрикаОшибокКомандыCURL().Создать(
		КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач(),
		"Источник адресов задаёт несколько запросов в одной позиции. Такая команда не поддерживается.",
		Источник
	));
	
	Возврат Новый РезультатКлассификацииCURL(Неопределено, Ошибки);

КонецФункции

#КонецОбласти

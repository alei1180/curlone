#Использовать "../../shared"

Перем _Вид; // Строка
Перем _Части; // ФиксированныйМассив из ЧастьТелаЗапросаCURL
Перем _Источник; // ЭлементРазобраннойКомандыCURL, Неопределено

#Область ОбработчикиСобытий

// Создаёт неизменяемое тело запроса.
//
// Параметры:
//   Вид - Строка - Значение из модуля ВидыТелаЗапросаCURL.
//   Части - Массив, ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части тела.
//   Источник - ЭлементРазобраннойКомандыCURL, Неопределено - Источник тела.
Процедура ПриСозданииОбъекта(Вид, Части, Источник)

	_Вид = Вид;
	_Части = Новый ФиксированныйМассив(Новый КоллекцииМоделиCURL().Скопировать(Части));
	_Источник = Источник;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс
// Возвращает вид тела.
//
// Возвращаемое значение:
//   Строка - Значение из ВидыТелаЗапросаCURL.
Функция Вид() Экспорт

	Возврат _Вид;

КонецФункции

// Возвращает неизменяемые части тела.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ЧастьТелаЗапросаCURL - Упорядоченные части.
Функция Части() Экспорт

	Возврат _Части;

КонецФункции

// Возвращает источник тела.
//
// Возвращаемое значение:
//   ЭлементРазобраннойКомандыCURL, Неопределено - Источник выбора тела.
Функция Источник() Экспорт

	Возврат _Источник;

КонецФункции

#КонецОбласти

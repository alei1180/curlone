Функция ВопросительныйЗнак() Экспорт

	Возврат "question_mark";

КонецФункции

// Возвращает именованное значение Амперсанд.
//
// Возвращаемое значение:
//   Строка - Именованное значение предметной модели curl.
Функция Амперсанд() Экспорт

	Возврат "ampersand";

КонецФункции

// Возвращает именованное значение ОпределитьПоАдресу.
//

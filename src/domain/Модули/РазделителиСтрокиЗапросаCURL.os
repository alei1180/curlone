#Область ПрограммныйИнтерфейс

// Возвращает именованное значение Нет.
//
// Возвращаемое значение:
//   Строка - Именованное значение предметной модели curl.
Функция Нет() Экспорт

	Возврат "none";

КонецФункции

// Возвращает именованное значение ВопросительныйЗнак.
//
// Возвращаемое значение:

#Область ПрограммныйИнтерфейс

// Возвращает отсутствие разделителя перед частью тела.
//
// Возвращаемое значение:
//   Строка - Именованное значение разделителя.
Функция Нет() Экспорт

	Возврат "none";

КонецФункции

// Возвращает разделение частей тела амперсандом.
//
// Возвращаемое значение:
//   Строка - Именованное значение разделителя.
Функция Амперсанд() Экспорт

	Возврат "ampersand";

КонецФункции

#КонецОбласти

	);
	Добавить(
		КодыВозможностейГенератораCURL.ОтложеннаяКлассификация(),
		"Назначение значения можно определить только после его вычисления."
	);

КонецПроцедуры

Процедура Добавить(Идентификатор, Последствие)

	_Последствия.Вставить(Идентификатор, Последствие);

КонецПроцедуры

#КонецОбласти

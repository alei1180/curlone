		"Проверка подлинности NTLM на прокси-сервере не будет настроена."
	);
	Добавить(КодыВозможностейГенератораCURL.UnixСокетПрокси(), "Подключение через сокет Unix не будет настроено.");
	Добавить(КодыВозможностейГенератораCURL.СертификатКлиента(), "Клиентский сертификат не будет использован.");
	Добавить(
		КодыВозможностейГенератораCURL.ФайлУдостоверяющегоЦентра(),
		"Указанный файл удостоверяющего центра не будет использован."
	);
	Добавить(
		КодыВозможностейГенератораCURL.СистемноеХранилищеСертификатов(),

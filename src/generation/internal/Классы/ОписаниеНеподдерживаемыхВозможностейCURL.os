	);
	Добавить(КодыВозможностейГенератораCURL.ВыводВФайл(), "Ответ не будет записан в указанный файл.");
	Добавить(КодыВозможностейГенератораCURL.ИмяФайлаИзURL(), "Имя файла ответа не будет получено из адреса.");
	Добавить(КодыВозможностейГенератораCURL.КаталогВывода(), "Ответ не будет записан в указанный каталог.");
	Добавить(КодыВозможностейГенератораCURL.СозданиеКаталогов(), "Каталоги для файла ответа не будут созданы.");

	Добавить(КодыВозможностейГенератораCURL.АктивныйFTP(), "Активный режим FTP не будет включён.");
	Добавить(КодыВозможностейГенератораCURL.ПассивныйFTP(), "Пассивный режим FTP не будет включён.");
	Добавить(КодыВозможностейГенератораCURL.ПереходПоПеренаправлениям(), "Переход по перенаправлениям не будет включён.");

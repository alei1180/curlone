Перем _Последствия; // Соответствие из Строка в Строка

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Последствия = Новый Соответствие;
	ЗаполнитьПоследствия();

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Объясняет пользователю последствие отсутствующей возможности генератора.
//
// Параметры:
//  Идентификатор - Строка - Код возможности.
//  Условное - Булево - Признак зависимости от вычисления значения или чтения источника.
//
// Возвращаемое значение:
//  Строка - Описание возможной потери без внутренних кодов.
Функция Предупреждение(Идентификатор, Условное) Экспорт

	Если Идентификатор = КодыВозможностейГенератораCURL.ПовторяющиесяЗаголовки() Тогда
		Если Условное Тогда
			Возврат "После чтения источника могут обнаружиться повторяющиеся заголовки. "
				+ "Генератор сохранит только последнее значение.";
		КонецЕсли;

		Возврат "Повторяющиеся заголовки не сохраняются. Останется только последнее значение.";
	КонецЕсли;

	Последствие = _Последствия.Получить(Идентификатор);
	Если Последствие = Неопределено Тогда
		Последствие = "Часть команды не поддерживается и может быть потеряна.";
	КонецЕсли;

	Если Условное Тогда
		Возврат "Ограничение может проявиться после вычисления значения или чтения источника. " + Последствие;
	КонецЕсли;

	Возврат Последствие;

КонецФункции

// Объясняет причину невозможности преобразования команды.
//
// Параметры:
//  Идентификатор - Строка - Код обязательной возможности.
//
// Возвращаемое значение:
//  Строка - Описание причины без внутренних кодов.
Функция Ошибка(Идентификатор) Экспорт

	Последствие = _Последствия.Получить(Идентификатор);
	Если Последствие = Неопределено Тогда
		Возврат "Команду невозможно представить средствами выбранного генератора.";
	КонецЕсли;

	Возврат "Команду невозможно преобразовать. " + Последствие;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоследствия()

	Добавить(КодыВозможностейГенератораCURL.ПротоколHTTP(), "Генератор не поддерживает протокол HTTP.");
	Добавить(КодыВозможностейГенератораCURL.ПротоколHTTPS(), "Генератор не поддерживает протокол HTTPS.");
	Добавить(КодыВозможностейГенератораCURL.ПротоколFTP(), "Генератор не поддерживает протокол FTP.");
	Добавить(КодыВозможностейГенератораCURL.ПротоколFTPS(), "Генератор не поддерживает протокол FTPS.");
	Добавить(
		КодыВозможностейГенератораCURL.ВычисляемыйПротокол(),
		"Протокол адреса станет известен только после вычисления значения."
	);
	Добавить(
		КодыВозможностейГенератораCURL.НесколькоОпераций(),
		"Генератор не поддерживает несколько запросов в одной команде."
	);
	Добавить(
		КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса(),
		"Явно заданный метод запроса может быть заменён методом по умолчанию."
	);
	Добавить(
		КодыВозможностейГенератораCURL.ТолькоМетаданные(),
		"Запрос только метаданных будет преобразован в обычный запрос."
	);
	Добавить(КодыВозможностейГенератораCURL.ТолькоИмена(), "Ответ не будет ограничен именами ресурсов.");
	Добавить(
		КодыВозможностейГенератораCURL.ЧастиСтрокиЗапроса(),
		"Параметры адреса могут быть объединены с потерей исходной структуры."
	);
	Добавить(КодыВозможностейГенератораCURL.ПорядокЗаголовков(), "Порядок заголовков может измениться.");
	Добавить(КодыВозможностейГенератораCURL.ПустыеЗаголовки(), "Заголовки с пустым значением могут быть пропущены.");
	Добавить(
		КодыВозможностейГенератораCURL.УдалениеЗаголовков(),
		"Удаление ранее заданных заголовков не будет выполнено."
	);
	Добавить(КодыВозможностейГенератораCURL.ЗаголовкиИзФайла(), "Заголовки из файла не будут добавлены в запрос.");
	Добавить(
		КодыВозможностейГенератораCURL.ЗаголовкиИзСтандартногоВвода(),
		"Заголовки из стандартного ввода не будут добавлены в запрос."
	);
	Добавить(
		КодыВозможностейГенератораCURL.ЗаголовкиJSON(),
		"Заголовок для данных JSON не будет установлен автоматически."
	);
	Добавить(КодыВозможностейГенератораCURL.ДанныеТела(), "Данные тела запроса могут быть перенесены не полностью.");
	Добавить(КодыВозможностейГенератораCURL.СоставноеТело(), "Поля и файлы составного тела запроса могут быть потеряны.");
	Добавить(КодыВозможностейГенератораCURL.ЗагрузкаФайла(), "Загружаемый файл не будет передан.");
	Добавить(КодыВозможностейГенератораCURL.ЗаголовкиЧасти(), "Заголовки части составного тела не будут переданы.");
	Добавить(КодыВозможностейГенератораCURL.ИмяФайлаЧасти(), "Заданное имя файла части составного тела не сохранится.");
	Добавить(КодыВозможностейГенератораCURL.ТипСодержимогоЧасти(), "Тип содержимого части составного тела не сохранится.");
	Добавить(
		КодыВозможностейГенератораCURL.КодированиеДанныхURL(),
		"Значение не будет автоматически закодировано для передачи в адресе."
	);
	Добавить(КодыВозможностейГенератораCURL.ЧтениеФайла(), "Содержимое указанного файла не будет передано.");
	Добавить(КодыВозможностейГенератораCURL.ЧтениеСтандартногоВвода(), "Данные из стандартного ввода не будут переданы.");
	Добавить(
		КодыВозможностейГенератораCURL.НеблокирующийСтандартныйВвод(),
		"Неблокирующее чтение стандартного ввода не поддерживается."
	);
	Добавить(КодыВозможностейГенератораCURL.УчетныеДанные(), "Учётные данные не будут переданы.");
	Добавить(КодыВозможностейГенератораCURL.АутентификацияBasic(), "Обычная проверка подлинности не будет настроена.");
	Добавить(КодыВозможностейГенератораCURL.АутентификацияDigest(), "Дайджест-проверка подлинности не будет настроена.");
	Добавить(
		КодыВозможностейГенератораCURL.АутентификацияNegotiate(),
		"Согласование способа проверки подлинности не будет настроено."
	);
	Добавить(КодыВозможностейГенератораCURL.АутентификацияNTLM(), "Проверка подлинности NTLM не будет настроена.");
	Добавить(КодыВозможностейГенератораCURL.АутентификацияOAuth2Bearer(), "Токен доступа OAuth 2.0 не будет передан.");
	Добавить(КодыВозможностейГенератораCURL.ВыборАутентификации(), "Выбор способа проверки подлинности не сохранится.");
	Добавить(КодыВозможностейГенератораCURL.ТокенOAuth2(), "Проверка подлинности OAuth 2.0 не будет настроена.");
	Добавить(
		КодыВозможностейГенератораCURL.ПодписьAWSV4(),
		"Подпись запроса AWS Signature Version 4 не будет сформирована."
	);
	Добавить(КодыВозможностейГенератораCURL.ПроксиHTTP(), "Генератор не поддерживает прокси-сервер HTTP.");
	Добавить(КодыВозможностейГенератораCURL.ПроксиHTTPS(), "Генератор не поддерживает прокси-сервер HTTPS.");
	Добавить(КодыВозможностейГенератораCURL.ПроксиSOCKS4(), "Генератор не поддерживает прокси-сервер SOCKS4.");
	Добавить(КодыВозможностейГенератораCURL.ПроксиSOCKS4A(), "Генератор не поддерживает прокси-сервер SOCKS4A.");
	Добавить(КодыВозможностейГенератораCURL.ПроксиSOCKS5(), "Генератор не поддерживает прокси-сервер SOCKS5.");
	Добавить(
		КодыВозможностейГенератораCURL.ПроксиSOCKS5СИменемУзла(),
		"Генератор не поддерживает разрешение имени узла через SOCKS5."
	);
	Добавить(КодыВозможностейГенератораCURL.УчетныеДанныеПрокси(), "Учётные данные прокси-сервера не будут переданы.");
	Добавить(
		КодыВозможностейГенератораCURL.АутентификацияПроксиBasic(),
		"Обычная проверка подлинности на прокси-сервере не будет настроена."
	);
	Добавить(

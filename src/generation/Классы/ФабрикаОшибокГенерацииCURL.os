#Область СлужебныйПрограммныйИнтерфейс

// Создаёт классифицированную ошибку, сохраняя при необходимости исходную причину.
//
// Параметры:
//  Код - Строка - Стабильный код.
//  Сообщение - Строка - Безопасное сообщение без исходных значений.
//  Данные - Произвольный - Безопасные данные.
//  Причина - ИнформацияОбОшибке, Неопределено - Исходная причина.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - Классифицированная ошибка.
Функция Создать(Код, Сообщение, Данные = Неопределено, Причина = Неопределено) Экспорт

	Если Причина = Неопределено Тогда
		Возврат ФабрикаОшибок.Создать(Код, Сообщение, Данные);
	КонецЕсли;
	
	Возврат ФабрикаОшибок.Обернуть(Причина, Код, Сообщение, Данные);

КонецФункции

#КонецОбласти

#Использовать "../../shared"

Перем _Ошибки; // ФиксированныйМассив из ИнформацияОбОшибке
Перем _Предупреждения; // ФиксированныйМассив из ПредупреждениеКонвертацииCURL

#Область ОбработчикиСобытий

// Создаёт результат внутреннего анализа из проверенных коллекций.
//
// Параметры:
//  Ошибки - Массив - Ошибки анализа.
//  Предупреждения - Массив - Предупреждения анализа.
Процедура ПриСозданииОбъекта(Ошибки, Предупреждения)

	_Ошибки = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Ошибки));
	_Предупреждения = Новый ФиксированныйМассив(КоллекцииМоделиCURL.Скопировать(Предупреждения));

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращаемое значение:
//  Булево - Отсутствуют блокирующие ошибки.
Функция Успешно() Экспорт

	Возврат _Ошибки.Количество() = 0;

КонецФункции

// Возвращаемое значение:
//  ФиксированныйМассив из ИнформацияОбОшибке - Ошибки анализа.
Функция Ошибки() Экспорт

	Возврат _Ошибки;

КонецФункции

// Возвращаемое значение:
//  ФиксированныйМассив из ПредупреждениеКонвертацииCURL - Предупреждения анализа.
Функция Предупреждения() Экспорт

	Возврат _Предупреждения;

КонецФункции

#КонецОбласти

#Использовать "../../public"
#Использовать "../../domain"

#Область СлужебныйПрограммныйИнтерфейс

// Собирает требования активных частей нормализованного выполнения.
//
// Параметры:
//  Выполнение - ОписаниеВыполненияCURL - Результат внутреннего интерпретатора.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - НомерОперации, Идентификатор, Источник, Условное.
Функция Собрать(Выполнение) Экспорт

	Коды = КодыВозможностейГенератораCURL;
	Результат = Новый Массив;
	Номер = 0;

	Для Каждого Операция Из Выполнение.Операции() Цикл
		Требования = Новый Соответствие;

		Если Выполнение.Операции().Количество() > 1 Тогда
			Добавить(Требования, Коды.НесколькоОпераций(), Операция.Ресурс().Источник());
		КонецЕсли;

		СобратьОперацию(Операция, Требования);

		Для Каждого Элемент Из Требования Цикл
			Результат.Добавить(Новый ФиксированнаяСтруктура(
				"НомерОперации,Идентификатор,Источник,Условное",
				Номер,
				Элемент.Ключ,
				Элемент.Значение.Источник,
				Элемент.Значение.Условное
			));
		КонецЦикла;

		Номер = Номер + 1;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Добавить(Требования, Идентификатор, Источник = Неопределено, Условное = Ложь)

	Предыдущее = Требования.Получить(Идентификатор);
	Если Предыдущее = Неопределено Тогда
		Требования.Вставить(Идентификатор, Новый Структура("Источник,Условное", Источник, Условное));
	ИначеЕсли Не Условное Тогда
		Предыдущее.Условное = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура Выражение(Значение, Требования, Источник = Неопределено, Условное = Ложь)

	Коды = КодыВозможностейГенератораCURL;

	Если Значение <> Неопределено И Не Значение.ЯвляетсяЛитералом() Тогда
		Добавить(Требования, Коды.ВыраженияЗначений(), Источник, Условное);
	КонецЕсли;

КонецПроцедуры

Процедура Грамматика(Имя, Требования, Источник, Условное = Ложь, Значение = Неопределено)

	Коды = КодыВозможностейГенератораCURL;
	Добавить(Требования, Коды.ВыраженияЗначений(), Источник, Условное);
	Добавить(Требования, Коды.ОтложеннаяКлассификация(), Источник, Условное);

	Для Каждого ИмяВозможности Из Новый ВозможныеТребованияГрамматикCURL().Получить(Имя, Значение) Цикл
		Добавить(Требования, ИмяВозможности, Источник, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура Отложенное(Значение, Требования, Источник)

	Если Значение <> Неопределено Тогда
		Грамматика(Значение.Грамматика(), Требования, Источник, Ложь, Значение.Выражение());
	КонецЕсли;

КонецПроцедуры

Процедура СобратьОперацию(Операция, Требования)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;
	Ресурс = Операция.Ресурс();

	Если Ресурс.ТребуетРазбора() Тогда
		Грамматика(Грамматики.URL(), Требования, Ресурс.Источник(), Ложь, Ресурс.АдресДляВыполнения());
		Добавить(Требования, Коды.ВычисляемыйПротокол(), Ресурс.Источник());
	Иначе
		Добавить(Требования, Коды.ДляПротокола(Ресурс.Протокол()), Ресурс.Источник());
	КонецЕсли;

	СобратьЗапрос(Операция.Запрос(), Требования);
	СобратьСоединение(Операция.Соединение(), Ресурс, Требования);
	СобратьПолитики(Операция.Политики(), Требования);
	СобратьРезультат(Операция.Результат(), Требования);

КонецПроцедуры

Процедура СобратьЗапрос(Запрос, Требования)

	Коды = КодыВозможностейГенератораCURL;

	Если Запрос.ЯвныйМетод() <> Неопределено Тогда
		Добавить(Требования, Коды.ЯвныйМетодЗапроса());
		Выражение(Запрос.ЯвныйМетод(), Требования);
	КонецЕсли;

	Если Запрос.НеПолучатьТело() Тогда
		Добавить(Требования, Коды.ТолькоМетаданные());
	КонецЕсли;

	Если Запрос.ТолькоИменаПриПеречислении() Тогда
		Добавить(Требования, Коды.ТолькоИмена());
	КонецЕсли;

	СобратьЗаголовки(Запрос.Заголовки(), Требования);

	Для Каждого Часть Из Запрос.СтрокаЗапроса().Части() Цикл
		Добавить(Требования, Коды.ЧастиСтрокиЗапроса(), Часть.Источник());

		Если Часть.Кодировать() = Истина Тогда
			Добавить(Требования, Коды.КодированиеДанныхURL(), Часть.Источник());
		КонецЕсли;

		СобратьИсточник(Часть.ВидИсточника(), Требования, Часть.Источник());
		Отложенное(Часть.ОтложеннаяКлассификация(), Требования, Часть.Источник());
	КонецЦикла;

	СобратьТело(Запрос.Тело(), Требования);
	СобратьАутентификацию(Запрос.Аутентификация(), Требования);

КонецПроцедуры

Процедура СобратьЗаголовки(Заголовки, Требования)

	Коды = КодыВозможностейГенератораCURL;
	Имена = Новый Соответствие;

	Для Каждого Заголовок Из Заголовки Цикл
		Источник = Заголовок.Источник();
		Добавить(Требования, Коды.ПорядокЗаголовков(), Источник);

		Если Заголовок.Имя() <> Неопределено Тогда
			Имя = НРег(Заголовок.Имя());
			Если Имена.Получить(Имя) <> Неопределено Тогда
				Добавить(Требования, Коды.ПовторяющиесяЗаголовки(), Источник);
			КонецЕсли;

			Имена.Вставить(Имя, Истина);
		КонецЕсли;

		Действие = Заголовок.Действие();
		Если Действие = "remove" Тогда
			Добавить(Требования, Коды.УдалениеЗаголовков(), Источник);
		ИначеЕсли Действие = "set_empty" Тогда
			Добавить(Требования, Коды.ПустыеЗаголовки(), Источник);
		ИначеЕсли Действие = "set_if_absent" Тогда
			Если НРег(Заголовок.Имя()) = "accept" Или НРег(Заголовок.Имя()) = "content-type" Тогда
				Добавить(Требования, Коды.ЗаголовкиJSON(), Источник);
			КонецЕсли;
		ИначеЕсли Действие = "load_file" Или Действие = "load_stdin" Тогда
			Добавить(
				Требования,
				?(Действие = "load_file", Коды.ЗаголовкиИзФайла(), Коды.ЗаголовкиИзСтандартногоВвода()),
				Источник
			);
			Добавить(Требования, ?(Действие = "load_file", Коды.ЧтениеФайла(), Коды.ЧтениеСтандартногоВвода()), Источник);

			Для Каждого Возможность Из Новый ВозможныеТребованияГрамматикCURL().ДляВнешнихЗаголовков() Цикл
				Добавить(Требования, Возможность, Источник, Истина);
			КонецЦикла;
		КонецЕсли;

		Отложенное(Заголовок.ОтложеннаяКлассификация(), Требования, Источник);
	КонецЦикла;

КонецПроцедуры

Процедура СобратьИсточник(Режим, Требования, Источник)

	Коды = КодыВозможностейГенератораCURL;

	Если Режим = "file" Или Режим = "binary_file" Или Режим = "text_file_without_crlf_nul" Тогда
		Добавить(Требования, Коды.ЧтениеФайла(), Источник);
	ИначеЕсли Режим = "stdin" Тогда
		Добавить(Требования, Коды.ЧтениеСтандартногоВвода(), Источник);
	ИначеЕсли Режим = "nonblocking_stdin" Тогда
		Добавить(Требования, Коды.НеблокирующийСтандартныйВвод(), Источник);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьТело(Тело, Требования)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;
	Вид = Тело.Вид();

	Если Вид = "none" Тогда
		Возврат;
	КонецЕсли;

	Возможность = Коды.ДляВидаТела(Вид);
	Добавить(Требования, Возможность, Тело.Источник());

	Для Каждого Часть Из Тело.Части() Цикл
		Источник = Часть.Источник();
		СобратьИсточник(Часть.РежимИсточника(), Требования, Источник);

		Если Часть.Кодировать() = Истина Тогда
			Добавить(Требования, Коды.КодированиеДанныхURL(), Источник);
		КонецЕсли;

		Если Вид = "multipart" Тогда
			Если Часть.ИмяФайла() <> Неопределено Тогда
				Добавить(Требования, Коды.ИмяФайлаЧасти(), Источник);
			КонецЕсли;

			Если Часть.MIMEТип() <> Неопределено Тогда
				Добавить(Требования, Коды.ТипСодержимогоЧасти(), Источник);
			КонецЕсли;

			Если Часть.Заголовки().Количество() > 0 Тогда
				Добавить(Требования, Коды.ЗаголовкиЧасти(), Источник);
				СобратьЗаголовки(Часть.Заголовки(), Требования);
			КонецЕсли;
		КонецЕсли;

		Если Вид = "upload_file" И Часть.ТребуетРазбора() Тогда
			Грамматика(Грамматики.ЗагрузкаФайла(), Требования, Источник, Ложь, Часть.Выражение());
		Иначе
			Отложенное(Часть.ОтложеннаяКлассификация(), Требования, Источник);
		КонецЕсли;

		Выражение(Часть.Выражение(), Требования, Источник);
	КонецЦикла;

КонецПроцедуры

Процедура СобратьУчетныеДанные(Данные, Требования, Возможность, Условное = Ложь)

	Грамматики = ГрамматикиЗначенийCURL;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Добавить(Требования, Возможность, Данные.Источник(), Условное);

	Если Данные.ТребуетРазбора() Тогда
		Грамматика(Грамматики.УчетныеДанные(), Требования, Данные.Источник(), Условное);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьАутентификацию(Аутентификация, Требования)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;
	СобратьУчетныеДанные(Аутентификация.УчетныеДанные(), Требования, Коды.УчетныеДанные());

	Для Каждого Способ Из Аутентификация.Способы() Цикл
		Добавить(Требования, Коды.ДляСпособаАутентификации(Способ.Вид()), Способ.Источник());
	КонецЦикла;

	Если Аутентификация.Способы().Количество() > 1 Тогда
		Добавить(Требования, Коды.ВыборАутентификации(), Аутентификация.Способы()[0].Источник());
	КонецЕсли;

	Токен = Аутентификация.OAuth2();
	Если Токен <> Неопределено Тогда
		Добавить(Требования, Коды.ТокенOAuth2(), Токен.Источник());
		Выражение(Токен.Выражение(), Требования, Токен.Источник());
	КонецЕсли;

	Подпись = Аутентификация.ПодписьAWSV4();
	Если Подпись <> Неопределено Тогда
		Добавить(Требования, Коды.ПодписьAWSV4(), Подпись.Источник());

		Если Подпись.ТребуетРазбора() Тогда
			Грамматика(Грамматики.ПодписьAWSV4(), Требования, Подпись.Источник());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура СобратьЧисло(ЧислоМодели, Требования, Возможность, Условное = Ложь)

	Если ЧислоМодели = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Добавить(Требования, Возможность, ЧислоМодели.Источник(), Условное);

	Если ЧислоМодели.ТребуетВычисления() Тогда
		Грамматика(ЧислоМодели.ФорматЗначения(), Требования, ЧислоМодели.Источник(), Условное);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьСоединение(Соединение, Ресурс, Требования)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;
	СобратьЧисло(Соединение.Таймаут(), Требования, Коды.ОбщееОграничениеВремени());
	СобратьЧисло(Соединение.ТаймаутСоединения(), Требования, Коды.ОграничениеВремениСоединения());

	Если Новый АктивностьНастроекCURL().FTP(Ресурс) Тогда
		Добавить(Требования, Коды.ДляРежимаFTP(Соединение.РежимFTP()), Неопределено, Ресурс.ТребуетРазбора());

		Если Соединение.РежимFTP() = "active" Тогда
			Выражение(Соединение.АдресОбратногоСоединенияFTP(), Требования, Неопределено, Ресурс.ТребуетРазбора());
		КонецЕсли;
	КонецЕсли;

	СобратьПрокси(Соединение.Прокси(), Требования);
	TLS = Соединение.TLS();
	Сертификат = TLS.СертификатКлиента();

	Если Сертификат <> Неопределено Тогда
		Добавить(Требования, Коды.СертификатКлиента(), TLS.ИсточникСертификата());

		Если Сертификат.ТребуетРазбора() Тогда
			Грамматика(Грамматики.Сертификат(), Требования, TLS.ИсточникСертификата());
		КонецЕсли;
	КонецЕсли;

	Если TLS.СертификатыУдостоверяющегоЦентра() <> Неопределено Тогда
		Добавить(Требования, Коды.ФайлУдостоверяющегоЦентра(), TLS.ИсточникСертификатовУдостоверяющегоЦентра());
		Выражение(TLS.СертификатыУдостоверяющегоЦентра(), Требования, TLS.ИсточникСертификатовУдостоверяющегоЦентра());
	КонецЕсли;

	Если TLS.ИспользоватьСистемноеХранилище() Тогда
		Добавить(Требования, Коды.СистемноеХранилищеСертификатов(), TLS.ИсточникСистемногоХранилища());
	КонецЕсли;

КонецПроцедуры

Процедура СобратьПрокси(Прокси, Требования)

	Коды = КодыВозможностейГенератораCURL;

	Если Не Новый АктивностьНастроекCURL().Прокси(Прокси) Тогда
		Возврат;
	КонецЕсли;

	Условное = Прокси.ТребуетРазбора();
	Если Условное Тогда
		Отложенное(Прокси.ОтложеннаяКлассификация(), Требования, Прокси.ИсточникАдреса());
	Иначе
		Добавить(Требования, Коды.ДляПротоколаПрокси(Прокси.Протокол()), Прокси.ИсточникАдреса());
	КонецЕсли;

	Если Прокси.ПутьUnixСокета() <> Неопределено Тогда
		Добавить(Требования, Коды.UnixСокетПрокси(), Прокси.ИсточникАдреса(), Условное);
	КонецЕсли;

	СобратьУчетныеДанные(Прокси.УчетныеДанные(), Требования, Коды.УчетныеДанныеПрокси(), Условное);

	Для Каждого Способ Из Прокси.СпособыАутентификации() Цикл
		Добавить(Требования, Коды.ДляСпособаАутентификацииПрокси(Способ.Вид()), Способ.Источник(), Условное);
	КонецЦикла;

КонецПроцедуры

Процедура СобратьПолитики(Политики, Требования)

	Коды = КодыВозможностейГенератораCURL;
	Перенаправления = Политики.Перенаправления();

	Если Перенаправления.Следовать() Тогда
		Добавить(Требования, Коды.ПереходПоПеренаправлениям(), Перенаправления.Источник());
	КонецЕсли;

	Повторы = Политики.Повторы();
	Если Новый АктивностьНастроекCURL().Повторы(Повторы.Количество()) Тогда
		СобратьЧисло(Повторы.Количество(), Требования, Коды.ЧислоПовторов());

		Если Новый АктивностьНастроекCURL().Повторы(Повторы.МаксимальноеВремя()) Тогда
			СобратьЧисло(Повторы.МаксимальноеВремя(), Требования,
				Коды.ОграничениеВремениПовторов(), Повторы.Количество().ТребуетВычисления());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура СобратьРезультат(Результат, Требования)

	Коды = КодыВозможностейГенератораCURL;
	Источник = Результат.Источник();

	Если Результат.Режим() = "file" Или Результат.Режим() = "remote_name" Тогда
		Добавить(Требования, Коды.ДляРежимаВывода(Результат.Режим()), Источник);
	КонецЕсли;

	Отложенное(Результат.ОтложеннаяКлассификация(), Требования, Источник);

	Если Новый АктивностьНастроекCURL().ФайловыйРезультат(Результат) Тогда
		Условное = Результат.Режим() = "deferred";

		Если Результат.Каталог() <> Неопределено Тогда
			Добавить(Требования, Коды.КаталогВывода(), Источник, Условное);
			Выражение(Результат.Каталог(), Требования, Источник, Условное);
		КонецЕсли;

		Если Результат.СоздаватьКаталоги() Тогда
			Добавить(Требования, Коды.СозданиеКаталогов(), Источник, Условное);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

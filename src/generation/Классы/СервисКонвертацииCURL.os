#Использовать "../../syntax"
#Использовать "../../domain"
#Использовать "../../public"
#Использовать "../../shared"

Перем _СнимокРеестра;

#Область ОбработчикиСобытий

// Создаёт сервис конвертации с неизменяемым снимком реестра.
//
// Параметры:
//   Реестр - РеестрГенераторовCURL - Настроенный реестр генераторов.
Процедура ПриСозданииОбъекта(Реестр)

	_СнимокРеестра = Реестр.Снимок();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Конвертирует команду curl выбранным зарегистрированным генератором.
//
// Параметры:
//   Параметры - ПараметрыКонвертацииCURL - Параметры вызова.
//
// Возвращаемое значение:
//   РезультатКонвертацииCURL - Код либо безопасные ошибки и предупреждения.
Функция Конвертировать(Параметры) Экспорт

	Попытка
		ВходныеДанные = СкопироватьИПроверитьПараметры(Параметры);
	Исключение
		Цель = ?(ТипЗнч(Параметры.Цель) = Тип("Строка"), Параметры.Цель, "");
		Ошибка = ИнформацияОбОшибке();

		Если Не ДиагностикаОшибок.СодержитГруппу(Ошибка, "argument") Тогда
			Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
				КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
				"Внутренняя ошибка проверки параметров",
				Неопределено,
				Ошибка
			);
		КонецЕсли;

		Возврат РезультатСОшибкой(Ошибка, Цель);
	КонецПопытки;

	Запись = _СнимокРеестра.Получить(ВходныеДанные.Цель);
	Если Запись = Неопределено Тогда
		Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыОшибокCurlone.НеизвестныйГенератор(),
			"Целевой генератор не зарегистрирован"
		);
		Возврат РезультатСОшибкой(Ошибка, ВходныеДанные.Цель);
	КонецЕсли;

	Попытка
		Возврат ВыполнитьКонвертацию(ВходныеДанные, Запись);
	Исключение
		Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
			"Внутренняя ошибка конвертации",
			Неопределено,
			ИнформацияОбОшибке()
		);
		Возврат РезультатСОшибкой(Ошибка, ВходныеДанные.Цель);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьИПроверитьПараметры(Параметры)

	Если ТипЗнч(Параметры.Команда) = Тип("Неопределено") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"Команда",
			"Строка,Массив,ФиксированныйМассив",
			Параметры.Команда
		);
	КонецЕсли;

	Команда = Параметры.Команда;
	Если ТипЗнч(Команда) = Тип("Массив") Или ТипЗнч(Команда) = Тип("ФиксированныйМассив") Тогда
		Команда = КоллекцииМоделиCURL.Скопировать(Команда);
	КонецЕсли;

	Возврат Новый Структура(
		"Команда, Цель, Локаль, ПараметрыГенератора",
		Команда,
		Параметры.Цель,
		Параметры.Локаль,
		Параметры.ПараметрыГенератора
	);

КонецФункции

Функция ВыполнитьКонвертацию(Параметры, Запись)

	ЛексическийРезультат = РазобратьЛексически(Параметры.Команда);
	Если Не ЛексическийРезультат.Успешно() Тогда
		Возврат Новый РезультатКонвертацииCURL("", ЛексическийРезультат.Ошибки(), Неопределено, Параметры.Цель);
	КонецЕсли;

	СинтаксическийРезультат = Новый ПарсерКомандыCURL().Разобрать(ЛексическийРезультат.Токены());
	Если Не СинтаксическийРезультат.Успешно() Тогда
		Возврат Новый РезультатКонвертацииCURL("", СинтаксическийРезультат.Ошибки(), Неопределено, Параметры.Цель);
	КонецЕсли;

	СемантическийРезультат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(
		СинтаксическийРезультат.Команда()
	);
	Если Не СемантическийРезультат.Успешно() Тогда
		Возврат Новый РезультатКонвертацииCURL("", СемантическийРезультат.Ошибки(), Неопределено, Параметры.Цель);
	КонецЕсли;

	Анализ = Новый АнализаторВозможностейГенератора().Анализировать(
		СемантическийРезультат.Выполнение(),
		Запись.Описание
	);
	Если Не Анализ.Успешно() Тогда
		Возврат Новый РезультатКонвертацииCURL("", Анализ.Ошибки(), Анализ.Предупреждения(), Параметры.Цель);
	КонецЕсли;

	Попытка
		Контекст = Новый КонтекстГенерацииКода(
			СемантическийРезультат.Выполнение().Операции(),
			Параметры.Локаль,
			Параметры.ПараметрыГенератора,
			Запись.Описание.Идентификатор(),
			Запись.Описание.Возможности()
		);
		Возврат ВыполнитьГенератор(Запись.Генератор, Контекст, Анализ.Предупреждения(), Параметры.Цель);
	Исключение
		Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
			"Внутренняя ошибка конвертации", Неопределено, ИнформацияОбОшибке());
		Возврат РезультатСОшибкой(Ошибка, Параметры.Цель, Анализ.Предупреждения());
	КонецПопытки;

КонецФункции

Функция РазобратьЛексически(Команда)

	Если ТипЗнч(Команда) = Тип("Строка") Тогда
		Возврат Новый ЛексерКомандыCURL().Разобрать(Команда);
	КонецЕсли;

	Возврат Новый АдаптерАргументовКомандыCURL().Адаптировать(Команда);

КонецФункции

Функция ВыполнитьГенератор(Генератор, Контекст, Предупреждения, Идентификатор)

	Попытка
		Код = Генератор.Сгенерировать(Контекст);
	Исключение
		Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыОшибокCurlone.ОшибкаГенератора(),
			"Генератор завершился с ошибкой",
			Неопределено,
			ИнформацияОбОшибке()
		);
		Возврат РезультатСОшибкой(Ошибка, Идентификатор, Предупреждения);
	КонецПопытки;

	Если ТипЗнч(Код) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Код)) Тогда
		Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыОшибокCurlone.НарушенКонтрактГенератора(),
			"Генератор вернул недопустимый результат"
		);
		Возврат РезультатСОшибкой(Ошибка, Идентификатор, Предупреждения);
	КонецЕсли;

	Возврат Новый РезультатКонвертацииCURL(Код, Неопределено, Предупреждения, Идентификатор);

КонецФункции

Функция РезультатСОшибкой(Ошибка, Идентификатор = "", Предупреждения = Неопределено)

	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);

	Возврат Новый РезультатКонвертацииCURL("", Ошибки, Предупреждения, Идентификатор);

КонецФункции

#КонецОбласти

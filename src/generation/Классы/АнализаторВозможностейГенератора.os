#Использовать errors
#Использовать "../../shared"
#Использовать "../../public"
#Использовать "../../domain"

#Область СлужебныйПрограммныйИнтерфейс

// Сопоставляет активные требования выполнения с неизменяемым описанием генератора.
//
// Параметры:
//  Выполнение - ОписаниеВыполненияCURL - Проверенная внутренняя модель.
//  ОписаниеГенератора - ОписаниеГенератораCURL - Зарегистрированное описание.
//
// Возвращаемое значение:
//  РезультатАнализаВозможностейCURL - Ошибки и предупреждения в порядке операций и каталога.
Функция Анализировать(Выполнение, ОписаниеГенератора) Экспорт

	Требования = Новый ТребованияВозможностейCURL().Собрать(Выполнение);

	Идентификаторы = КодыВозможностейГенератораCURL.Все();
	Порядок = КоллекцииМоделиCURL.Скопировать(Идентификаторы);

	Для Каждого Требование Из Требования Цикл
		Если Порядок.Найти(Требование.Идентификатор) = Неопределено Тогда
			Порядок.Добавить(Требование.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Ошибки = Новый Массив;
	Предупреждения = Новый Массив;
	ПоОперациям = Новый Массив;

	Для Номер = 0 По Выполнение.Операции().Количество() - 1 Цикл
		ПоОперациям.Добавить(Новый Соответствие);
	КонецЦикла;

	Для Каждого Требование Из Требования Цикл
		ПоОперациям[Требование.НомерОперации].Вставить(Требование.Идентификатор, Требование);
	КонецЦикла;

	Для Каждого ТребованияОперации Из ПоОперациям Цикл
		Для Каждого Идентификатор Из Порядок Цикл
			Требование = ТребованияОперации.Получить(Идентификатор);
			Если Требование <> Неопределено Тогда
				ПроверитьТребование(Требование, ОписаниеГенератора, Ошибки, Предупреждения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый РезультатАнализаВозможностейCURL(Ошибки, Предупреждения);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТребование(Требование, Описание, Ошибки, Предупреждения)

	Коды = КодыВозможностейГенератораCURL;
	Возможность = Требование.Идентификатор;

	Если Описание.Возможности().Найти(Возможность) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Возможность = Коды.ВычисляемыйПротокол() Тогда
		Для Каждого Имя Из Описание.Возможности() Цикл
			Если Коды.ЭтоПротокол(Имя) Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Блокирующее = Коды.ЭтоПротокол(Возможность)
		Или ЭтоПротоколПрокси(Возможность, Коды)
		Или Возможность = Коды.НесколькоОпераций()
		Или Коды.ЭтоВычисляемоеЗначение(Возможность);

	Если Блокирующее Тогда
		Ошибки.Добавить(Новый ФабрикаОшибокГенерацииCURL().Создать(
			КодыОшибокCurlone.НепредставимаяСемантикаГенератора(),
			"Генератор не поддерживает обязательную возможность: " + Возможность));
		Возврат;
	КонецЕсли;

	Источник = Требование.Источник;
	Опция = "";
	Позиция = -1;

	Если Источник <> Неопределено Тогда
		Позиция = Источник.ИсходныйТокен().Позиция();

		Если Источник.ОписаниеОпции() <> Неопределено Тогда
			Опция = "--" + Источник.ОписаниеОпции().КаноническоеИмя();
		КонецЕсли;
	КонецЕсли;

	Сообщение = ?(Требование.Условное,
		"Возможна потеря после вычисления значения или чтения источника: ",
		"Не поддерживается возможность: ") + Возможность;

	Предупреждения.Добавить(Новый ПредупреждениеКонвертацииCURL(
		КодыПредупрежденийCurlone.НеподдерживаемаяВозможность(),
		Сообщение,
		Возможность,
		Опция,
		Позиция,
		Описание.Идентификатор()
	));

КонецПроцедуры

Функция ЭтоПротоколПрокси(Возможность, Коды)

	Возврат Возможность = Коды.ПроксиHTTP()
		Или Возможность = Коды.ПроксиHTTPS()
		Или Возможность = Коды.ПроксиSOCKS4()
		Или Возможность = Коды.ПроксиSOCKS4A()
		Или Возможность = Коды.ПроксиSOCKS5()
		Или Возможность = Коды.ПроксиSOCKS5СИменемУзла();

КонецФункции

#КонецОбласти

#Использовать "../../public"
#Использовать "../../domain"

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает возможные требования результата нормативной грамматики.
//
// Параметры:
//  Грамматика - Строка - Идентификатор грамматики.
//  Выражение - ВыражениеЗначенияCURL, Неопределено - Известные литеральные ограничения.
//
// Возвращаемое значение:
//  ФиксированныйМассив из Строка - Потенциальные возможности.
Функция Получить(Грамматика, Выражение = Неопределено) Экспорт

	Кандидаты = КандидатыГрамматики(Грамматика);
	Префикс = ПрефиксВыражения(Выражение);

	Результат = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Достижимо(Грамматика, Префикс, Кандидат)
			И ДопускаетсяПолнымВыражением(Грамматика, Выражение, Кандидат) Тогда
			Результат.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

// Возвращает требования неизвестного содержимого источника заголовков.
//
// Возвращаемое значение:
//  ФиксированныйМассив из Строка - Требования содержимого файла или стандартного ввода.
Функция ДляВнешнихЗаголовков() Экспорт

	Результат = Новый Массив;
	ДобавитьТребованияСодержимогоЗаголовков(Результат);

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КандидатыГрамматики(Грамматика)

	Грамматики = ГрамматикиЗначенийCURL;
	Если Грамматика = Грамматики.ЗагрузкаФайла() Тогда
		Возврат ТребованияЗагрузки();
	ИначеЕсли Грамматика = Грамматики.ПользовательскийАгент() Тогда
		Возврат ТребованияПользовательскогоАгента();
	ИначеЕсли ЭтоДанныеСоСсылкойНаФайл(Грамматика) Тогда
		Возврат ТребованияДанных();
	ИначеЕсли Грамматика = Грамматики.КодированныеДанные() Или Грамматика = Грамматики.ЧастьЗапроса() Тогда
		Возврат ТребованияКодированныхДанных();
	ИначеЕсли Грамматика = Грамматики.Заголовок() Тогда
		Возврат ТребованияЗаголовка();
	ИначеЕсли Грамматика = Грамматики.Форма() Тогда
		Возврат ТребованияФормы();
	ИначеЕсли Грамматика = Грамматики.Результат() Тогда
		Возврат ТребованияРезультата();
	ИначеЕсли Грамматика = Грамматики.Прокси() Тогда
		Возврат ТребованияПрокси();
	ИначеЕсли Грамматика = Грамматики.URL() Тогда
		Возврат ТребованияURL();
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

Функция ТребованияЗагрузки()

	Коды = КодыВозможностейГенератораCURL;
	
	Результат = ТребованияДанных();
	Результат.Добавить(Коды.НеблокирующийСтандартныйВвод());

	Возврат Результат;

КонецФункции

Функция ТребованияПользовательскогоАгента()

	Коды = КодыВозможностейГенератораCURL;

	Результат = Новый Массив;
	Результат.Добавить(Коды.УдалениеЗаголовков());

	Возврат Результат;

КонецФункции

Функция ТребованияДанных()

	Коды = КодыВозможностейГенератораCURL;

	Результат = Новый Массив;
	Результат.Добавить(Коды.ЧтениеФайла());
	Результат.Добавить(Коды.ЧтениеСтандартногоВвода());

	Возврат Результат;

КонецФункции

Функция ТребованияКодированныхДанных()

	Коды = КодыВозможностейГенератораCURL;

	Результат = ТребованияДанных();
	Результат.Добавить(Коды.КодированиеДанныхURL());

	Возврат Результат;

КонецФункции

Функция ТребованияЗаголовка()

	Коды = КодыВозможностейГенератораCURL;
	Результат = Новый Массив;

	ДобавитьТребованияСодержимогоЗаголовков(Результат);
	ДобавитьТребованияИсточниковЗаголовков(Результат);

	Результат.Добавить(Коды.ЧтениеФайла());
	Результат.Добавить(Коды.ЧтениеСтандартногоВвода());

	Возврат Результат;

КонецФункции

Функция ТребованияФормы()

	Коды = КодыВозможностейГенератораCURL;

	Результат = ТребованияДанных();
	Результат.Добавить(Коды.ИмяФайлаЧасти());
	Результат.Добавить(Коды.ТипСодержимогоЧасти());
	Результат.Добавить(Коды.ЗаголовкиЧасти());

	ДобавитьТребованияСодержимогоЗаголовков(Результат);
	ДобавитьТребованияИсточниковЗаголовков(Результат);

	Возврат Результат;

КонецФункции

Функция ТребованияРезультата()

	Коды = КодыВозможностейГенератораCURL;

	Результат = Новый Массив;
	Результат.Добавить(Коды.ВыводВФайл());

	Возврат Результат;

КонецФункции

Функция ТребованияПрокси()

	Коды = КодыВозможностейГенератораCURL;

	Результат = Новый Массив;
	Результат.Добавить(Коды.ПроксиHTTP());
	Результат.Добавить(Коды.ПроксиHTTPS());
	Результат.Добавить(Коды.ПроксиSOCKS4());
	Результат.Добавить(Коды.ПроксиSOCKS4A());
	Результат.Добавить(Коды.ПроксиSOCKS5());
	Результат.Добавить(Коды.ПроксиSOCKS5СИменемУзла());
	Результат.Добавить(Коды.УчетныеДанныеПрокси());
	Результат.Добавить(Коды.UnixСокетПрокси());

	Возврат Результат;

КонецФункции

Функция ТребованияURL()

	Коды = КодыВозможностейГенератораCURL;

	Результат = Новый Массив;
	Результат.Добавить(Коды.УчетныеДанные());

	Возврат Результат;

КонецФункции

Процедура ДобавитьТребованияСодержимогоЗаголовков(Результат)

	Коды = КодыВозможностейГенератораCURL;

	Результат.Добавить(Коды.ПорядокЗаголовков());
	Результат.Добавить(Коды.ПовторяющиесяЗаголовки());
	Результат.Добавить(Коды.ПустыеЗаголовки());
	Результат.Добавить(Коды.УдалениеЗаголовков());

КонецПроцедуры

Процедура ДобавитьТребованияИсточниковЗаголовков(Результат)

	Коды = КодыВозможностейГенератораCURL;

	Результат.Добавить(Коды.ЗаголовкиИзФайла());
	Результат.Добавить(Коды.ЗаголовкиИзСтандартногоВвода());

КонецПроцедуры

Функция ПрефиксВыражения(Выражение)

	Если Выражение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Новый ОграниченияВыраженияCURL().Префикс(Выражение);

КонецФункции

Функция ДостижимаЗагрузка(Префикс, Возможность)

	Коды = КодыВозможностейГенератораCURL;

	Если Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Возврат Префикс = "-";
	ИначеЕсли Возможность = Коды.НеблокирующийСтандартныйВвод() Тогда
		Возврат Префикс = ".";
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДостижимыДанные(Префикс, Возможность)

	Коды = КодыВозможностейГенератораCURL;

	Если Лев(Префикс, 1) <> "@" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Возврат Префикс = "@" Или Префикс = "@-";
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДостижимыКодированныеДанные(Грамматика, Префикс, Возможность)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;

	Если Грамматика = Грамматики.ЧастьЗапроса() И Лев(Префикс, 1) = "+" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Возможность = Коды.ЧтениеФайла() Или Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Если СтрНайти(Префикс, "=") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДостижимЗаголовок(Префикс, Возможность)

	Коды = КодыВозможностейГенератораCURL;

	Если Возможность = Коды.ЗаголовкиИзСтандартногоВвода() Или Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Возврат Префикс = "@" Или Префикс = "@-";
	КонецЕсли;

	Если Возможность = Коды.ЗаголовкиИзФайла() Или Возможность = Коды.ЗаголовкиИзСтандартногоВвода()
		Или Возможность = Коды.ЧтениеФайла() Или Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Возврат Лев(Префикс, 1) = "@";
	КонецЕсли;

	Если Лев(Префикс, 1) <> "@" Тогда
		Двоеточие = СтрНайти(Префикс, ":");
		Если Двоеточие > 0 Тогда
			Если Возможность = Коды.ПустыеЗаголовки() Тогда
				Возврат Ложь;
			ИначеЕсли Возможность = Коды.УдалениеЗаголовков() Тогда
				Возврат СокрЛП(Сред(Префикс, Двоеточие + 1)) = "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДостижимПрокси(Префикс, Возможность)

	Коды = КодыВозможностейГенератораCURL;

	КонецСхемы = СтрНайти(Префикс, "://");
	Если КонецСхемы > 0 Тогда
		Схема = НРег(Лев(Префикс, КонецСхемы - 1));

		Если Возможность = Коды.УчетныеДанныеПрокси() Тогда
			Возврат Истина;
		ИначеЕсли Возможность = Коды.UnixСокетПрокси() Тогда
			Возврат Схема = ПротоколыCURL.SOCKS5() Или Схема = ПротоколыCURL.SOCKS5H();
		КонецЕсли;

		Возврат Возможность = Коды.ДляПротоколаПрокси(Схема);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДопускаетсяИсточникЗагрузки(Выражение, Возможность, Ограничения)

	Коды = КодыВозможностейГенератораCURL;
	Если Возможность = Коды.ЧтениеСтандартногоВвода() Тогда
		Возврат Ограничения.ДопускаетЗначение(Выражение, "-");
	ИначеЕсли Возможность = Коды.НеблокирующийСтандартныйВвод() Тогда
		Возврат Ограничения.ДопускаетЗначение(Выражение, ".");
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДопускаетсяПолнымВыражением(Грамматика, Выражение, Возможность)

	Грамматики = ГрамматикиЗначенийCURL;
	Коды = КодыВозможностейГенератораCURL;

	Если Выражение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Ограничения = Новый ОграниченияВыраженияCURL;

	Если Грамматика = Грамматики.URL() И Возможность = Коды.УчетныеДанные() Тогда
		Возврат Ограничения.ДопускаетУчетныеДанные(Выражение);
	ИначеЕсли Грамматика = Грамматики.ПользовательскийАгент() Тогда
		Возврат Ограничения.ДопускаетЗначение(Выражение, "");
	ИначеЕсли Грамматика = Грамматики.ЗагрузкаФайла() Тогда
		Возврат ДопускаетсяИсточникЗагрузки(Выражение, Возможность, Ограничения);
	ИначеЕсли ЭтоДанныеСоСсылкойНаФайл(Грамматика)
		Или Грамматика = Грамматики.Заголовок() Тогда

		Если Возможность = Коды.ЧтениеСтандартногоВвода() Или Возможность = Коды.ЗаголовкиИзСтандартногоВвода() Тогда
			Возврат Ограничения.ДопускаетЗначение(Выражение, "@-");
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция Достижимо(Грамматика, Префикс, Возможность)

	Грамматики = ГрамматикиЗначенийCURL;

	Если Префикс = "" Тогда
		Возврат Истина;
	КонецЕсли;

	Если Грамматика = Грамматики.ЗагрузкаФайла() Тогда
		Возврат ДостижимаЗагрузка(Префикс, Возможность);
	ИначеЕсли Грамматика = Грамматики.ПользовательскийАгент() Тогда
		Возврат Ложь;
	ИначеЕсли ЭтоДанныеСоСсылкойНаФайл(Грамматика) Тогда
		Возврат ДостижимыДанные(Префикс, Возможность);
	ИначеЕсли Грамматика = Грамматики.КодированныеДанные() Или Грамматика = Грамматики.ЧастьЗапроса() Тогда
		Возврат ДостижимыКодированныеДанные(Грамматика, Префикс, Возможность);
	ИначеЕсли Грамматика = Грамматики.Заголовок() Тогда
		Возврат ДостижимЗаголовок(Префикс, Возможность);
	ИначеЕсли Грамматика = Грамматики.Прокси() Тогда
		Возврат ДостижимПрокси(Префикс, Возможность);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ЭтоДанныеСоСсылкойНаФайл(Грамматика)

	Грамматики = ГрамматикиЗначенийCURL;
	Возврат Грамматика = Грамматики.Данные()
		Или Грамматика = Грамматики.ДвоичныеДанные() Или Грамматика = Грамматики.JSON();

КонецФункции

#КонецОбласти

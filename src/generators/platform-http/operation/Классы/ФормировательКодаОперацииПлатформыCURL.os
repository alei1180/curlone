#Использовать url
#Использовать "../../../shared"
#Использовать "../../ftp"
#Использовать "../../internal"
#Использовать "../../../../domain"

#Область ПрограммныйИнтерфейс

// Формирует платформенный код для одной подготовленной операции.
//
// Параметры:
//   ПодготовленнаяОперация - Структура - Результат адаптации операции.
//   Локаль - Строка - Локаль результата, для платформы не используется.
//   ФорматДесериализацииОтвета - Строка, Неопределено - Формат десериализации HTTP-ответа.
//   Возможности - ФиксированныйМассив из Строка - Снимок возможностей генератора.
//
// Возвращаемое значение:
//   Строка - Платформенный код.
Функция СформироватьКод(
	ПодготовленнаяОперация,
	Локаль,
	ФорматДесериализацииОтвета,
	Возможности
) Экспорт // BSLLS:UnusedParameters-off

	Операция = ПодготовленнаяОперация.Операция;
	ИменаПеременных = Новый Соответствие;
	Выражения = Новый ГенераторВыраженийCURL(ЛокалиКонвертацииCURL.Русская(), ИменаПеременных);
	ВыражениеURL = Операция.Ресурс().ИсходныйАдрес();
	ВыражениеURLДляРазбора = Операция.Ресурс().АдресДляВыполнения();
	URL = Новый URL(Выражения.СтрокаДляРазбора(ВыражениеURLДляРазбора));

	Если Возможности.Найти(КодыВозможностейГенератораCURL.ДляПротокола(URL.Схема())) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ПоддерживаютсяТолькоБазовыеОперации(Возможности) Тогда
		Возврат СформироватьБазовуюОперацию(Операция, URL, Выражения);
	КонецЕсли;

	Если URL.Схема() = ПротоколыCURL.FTP() Или URL.Схема() = ПротоколыCURL.FTPS() Тогда
		Возврат Новый ФормированиеКодаFTPCURL().СформироватьКод(Операция, Возможности);
	КонецЕсли;

	Возврат СформироватьHTTPOперацию(
		ПодготовленнаяОперация,
		ФорматДесериализацииОтвета,
		Возможности,
		Операция,
		URL,
		Выражения,
		ИменаПеременных,
		ВыражениеURL
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьHTTPOперацию(
	ПодготовленнаяОперация,
	ФорматДесериализацииОтвета,
	Возможности,
	Операция,
	URL,
	Выражения,
	ИменаПеременных,
	ВыражениеURL
)

	Адрес = ДополнитьАдресИменемЗагружаемогоФайла(
		АдресHTTP(Операция, Выражения),
		Операция.Запрос(),
		ПодготовленнаяОперация.ЧастиТела,
		Возможности
	);
	Код = Новый ПостроительКодаCURL(Выражения);
	Тело = Новый ФормированиеТелаHTTPЗапросаCURL(Выражения);
	ДанныеЗапроса = ПодготовитьДанныеHTTPЗапроса(
		Код,
		Тело,
		ПодготовленнаяОперация,
		Адрес,
		Выражения
	);
	ЕстьЗаголовки = ДобавитьЗаголовкиHTTPЗапроса(
		Код,
		Операция.Запрос(),
		ПодготовленнаяОперация.Заголовки,
		ДанныеЗапроса,
		Выражения,
		Возможности
	);

	ФормированиеСоединения = Новый ФормированиеСоединенияHTTPПлатформыCURL;
	ФормированиеСоединения.ДобавитьКодСоединения(
		Код,
		Операция,
		URL,
		Выражения,
		Возможности
	);

	ДобавитьHTTPЗапрос(
		Код,
		Тело,
		ПодготовленнаяОперация,
		ДанныеЗапроса,
		Адрес,
		ВыражениеURL,
		Выражения,
		Возможности,
		ЕстьЗаголовки
	);

	ПредставлениеМетода = ПредставлениеМетодаHTTP(Операция.Запрос(), URL, Выражения, Возможности);
	ДобавитьВызовHTTPМетода(
		Код,
		Операция,
		URL,
		Выражения,
		Возможности,
		ПредставлениеМетода,
		ФорматДесериализацииОтвета
	);

	Возврат ДобавитьОбъявленияПеременных(Код.ПолучитьРезультат(), ИменаПеременных);

КонецФункции

Функция ДополнитьАдресИменемЗагружаемогоФайла(Адрес, Запрос, ЧастиТела, Возможности)

	Если Прав(Адрес, 1) <> "/"
		Или Запрос.Тело().Вид() <> ВидыТелаЗапросаCURL.ЗагрузкаФайла()
		Или Возможности.Найти(КодыВозможностейГенератораCURL.ЗагрузкаФайла()) = Неопределено
		Или Возможности.Найти(КодыВозможностейГенератораCURL.ЧтениеФайла()) = Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;

	Для Каждого Часть Из ЧастиТела Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Сегменты = СтрРазделить(СтрЗаменить(Часть.ПутьКФайлу(), "\", "/"), "/", Ложь);
			Возврат Адрес + КодированиеURL.КодироватьСегментПути(Сегменты[Сегменты.Количество() - 1]);
		КонецЕсли;
	КонецЦикла;

	Возврат Адрес;

КонецФункции

Функция ПодготовитьДанныеHTTPЗапроса(Код, Тело, ПодготовленнаяОперация, Адрес, Выражения)

	Результат = Новый Структура("ПростоеТело, СтрокаЗапроса, ЕстьСоставнаяФорма, ЕстьСтрокаЗапроса");
	Результат.ЕстьСоставнаяФорма = Тело.ЭтоСоставнаяФорма(ПодготовленнаяОперация.ЧастиТела);
	Результат.ЕстьСтрокаЗапроса = ПодготовленнаяОперация.ЧастиСтрокиЗапроса.Количество() > 0;

	ФормированиеДанных = Новый ФормированиеДанныхHTTPЗапросаПлатформыCURL;

	Если Результат.ЕстьСоставнаяФорма Тогда
		Тело.ПодготовитьСоставнуюФорму(Код, ПодготовленнаяОперация.ЧастиТела);
		Результат.ПростоеТело = Новый Структура(
			"Есть, Выражение, МетодУстановки, ДобавитьТипСодержимого",
			Ложь
		);
	Иначе
		Результат.ПростоеТело = ФормированиеДанных.ПолучитьПростоеТело(
			Код,
			ПодготовленнаяОперация.ЧастиТела,
			Выражения
		);
	КонецЕсли;

	Если Результат.ЕстьСтрокаЗапроса Тогда
		Результат.СтрокаЗапроса = ФормированиеДанных.ПодготовитьСтрокуЗапроса(
			Код,
			ПодготовленнаяОперация.ЧастиСтрокиЗапроса,
			Адрес,
			Выражения
		);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ДобавитьЗаголовкиHTTPЗапроса(Код, Запрос, Заголовки, ДанныеЗапроса, Выражения, Возможности)

	Аутентификация = Запрос.Аутентификация();
	ЕстьOAuth = Аутентификация.OAuth2() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТокенOAuth2()) <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.АутентификацияOAuth2Bearer()) <> Неопределено
		И Заголовки.Получить("authorization") = Неопределено;
	ДобавитьТипСодержимого = ДанныеЗапроса.ПростоеТело.Есть
		И ДанныеЗапроса.ПростоеТело.ДобавитьТипСодержимого
		И Заголовки.Получить("content-type") = Неопределено;
	ЕстьЗаголовки = ЕстьВыводимыеЗаголовки(Заголовки)
		Или ДобавитьТипСодержимого Или ЕстьOAuth Или ДанныеЗапроса.ЕстьСоставнаяФорма;

	Если Не ЕстьЗаголовки Тогда
		Возврат Ложь;
	КонецЕсли;

	Код.ОбъявитьСоответствие("Заголовки");
	ДобавитьЗаголовки(Код, Заголовки, Выражения);

	Если ДобавитьТипСодержимого Тогда
		Код.ДобавитьСтроку("Заголовки.Вставить(""Content-Type"", ""application/x-www-form-urlencoded"");");
	КонецЕсли;

	Если ДанныеЗапроса.ЕстьСоставнаяФорма Тогда
		Код.ДобавитьСтроку(
			"Заголовки.Вставить(""Content-Type"", ""multipart/form-data; boundary="" + РазделительMultipart);"
		);
	КонецЕсли;

	Если ЕстьOAuth Тогда
		ДобавитьЗаголовокOAuth(Код, Аутентификация, Выражения);
	КонецЕсли;

	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Процедура ДобавитьЗаголовокOAuth(Код, Аутентификация, Выражения)

	ВыражениеТокена = Аутентификация.OAuth2().Выражение();

	Если ВыражениеТокена.ЯвляетсяЛитералом() Тогда
		ПредставлениеТокена = Выражения.Литерал("Bearer " + ВыражениеТокена.ЛитеральноеЗначение());
	Иначе
		ПредставлениеТокена = Выражения.Литерал("Bearer ") + " + " + Выражения.Представить(ВыражениеТокена);
	КонецЕсли;

	Код.ДобавитьСтроку("Заголовки.Вставить(""Authorization"", %1);", ПредставлениеТокена);

КонецПроцедуры

Процедура ДобавитьHTTPЗапрос(
	Код,
	Тело,
	ПодготовленнаяОперация,
	ДанныеЗапроса,
	Адрес,
	ВыражениеURL,
	Выражения,
	Возможности,
	ЕстьЗаголовки
)

	Если ДанныеЗапроса.ЕстьСтрокаЗапроса
		И Не ПустаяСтрока(ДанныеЗапроса.СтрокаЗапроса.КодПередЗапросом) Тогда
		Код.ДобавитьСтроку();
		Код.ДобавитьСтроку(ДанныеЗапроса.СтрокаЗапроса.КодПередЗапросом);
	КонецЕсли;

	АдресЗапроса = ?(
		ДанныеЗапроса.ЕстьСтрокаЗапроса,
		ДанныеЗапроса.СтрокаЗапроса.ВыражениеАдреса,
		Выражения.ПредставитьШаблон(Адрес, ВыражениеURL)
	);

	Код.ДобавитьСтроку(
		"HTTPЗапрос = Новый HTTPЗапрос(%1%2);",
		АдресЗапроса,
		?(ЕстьЗаголовки, ", Заголовки", "")
	);

	ДобавитьТелоHTTPЗапроса(Код, Тело, ПодготовленнаяОперация, ДанныеЗапроса, Возможности);

	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьТелоHTTPЗапроса(Код, Тело, ПодготовленнаяОперация, ДанныеЗапроса, Возможности)

	Если ДанныеЗапроса.ЕстьСоставнаяФорма Тогда
		Тело.ДобавитьСоставнуюФорму(Код, ПодготовленнаяОперация.ЧастиТела, Возможности);
	ИначеЕсли ДанныеЗапроса.ПростоеТело.Есть Тогда
		Код.ДобавитьСтроку(
			"HTTPЗапрос.%1(%2);",
			ДанныеЗапроса.ПростоеТело.МетодУстановки,
			ДанныеЗапроса.ПростоеТело.Выражение
		);
	Иначе
		Тело.ДобавитьТелоИзЧастей(
			Код,
			ПодготовленнаяОперация.ЧастиТела,
			Возможности,
			ПодготовленнаяОперация.Заголовки.Получить("content-type") <> Неопределено
		);
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеМетодаHTTP(Запрос, URL, Выражения, Возможности)

	Метод = Запрос.МетодПоУмолчанию();
	ПредставлениеМетода = Неопределено;

	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = ?(
			URL.Схема() = ПротоколыCURL.HTTP() Или URL.Схема() = ПротоколыCURL.HTTPS(),
			МетодыЗапросаПоУмолчаниюCURL.GET(),
			Метод
		);
	КонецЕсли;

	Если Метод = МетодыЗапросаПоУмолчаниюCURL.HEAD()
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТолькоМетаданные()) = Неопределено Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Если Запрос.ЯвныйМетод() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса()) <> Неопределено Тогда
		ВыражениеМетода = Запрос.ЯвныйМетод();

		Если ВыражениеМетода.ЯвляетсяЛитералом() Тогда
			Метод = ВыражениеМетода.ЛитеральноеЗначение();
		Иначе
			ПредставлениеМетода = Выражения.Представить(ВыражениеМетода);
		КонецЕсли;
	КонецЕсли;

	Возврат ?(ПредставлениеМетода = Неопределено, Выражения.Литерал(Метод), ПредставлениеМетода);

КонецФункции

Процедура ДобавитьВызовHTTPМетода(
	Код,
	Операция,
	URL,
	Выражения,
	Возможности,
	ПредставлениеМетода,
	ФорматДесериализацииОтвета
)

	РезультатОперации = Операция.Результат();
	ФормированиеРезультата = Новый ФормированиеРезультатаHTTPПлатформыCURL;
	ПараметрФайла = ФормированиеРезультата.ПодготовитьВыражениеИмениФайла(
		Код,
		РезультатОперации,
		URL,
		Выражения,
		Возможности
	);

	Код.ДобавитьСтроку(
		"HTTPОтвет = Соединение.ВызватьHTTPМетод(%1, HTTPЗапрос%2);",
		ПредставлениеМетода,
		?(ПустаяСтрока(ПараметрФайла), "", ", " + ПараметрФайла)
	);

	ФормированиеРезультата.ДобавитьДесериализациюJSON(
		Код,
		РезультатОперации,
		ФорматДесериализацииОтвета
	);

КонецПроцедуры

Функция ПоддерживаютсяТолькоБазовыеОперации(Возможности)

	Для Каждого Возможность Из Возможности Цикл

		Если Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTP()
			И Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTPS()
			И Возможность <> КодыВозможностейГенератораCURL.НесколькоОпераций() Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СформироватьБазовуюОперацию(Операция, URL, Выражения)

	Метод = Операция.Запрос().МетодПоУмолчанию();
	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Код = Новый ПостроительКодаCURL(Выражения);
	Код.ДобавитьСтроку("Адрес = %1;", Выражения.Литерал(АдресHTTP(Операция, Выражения)));
	Код.ДобавитьСтроку("ЗапросHTTP = Новый HTTPЗапрос(Адрес);");
	Код.ДобавитьСтроку(
		"СоединениеHTTP = Новый HTTPСоединение(%1, %2);",
		Выражения.Литерал(URL.IDNХост()),
		Формат(URL.ЭффективныйПорт(), "ЧГ=0")
	);
	Код.ДобавитьСтроку(
		"ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(%1, ЗапросHTTP);",
		Выражения.Литерал(Метод)
	);
	Код.ДобавитьСтроку("Результат = ОтветHTTP.ПолучитьТелоКакСтроку();");

	Возврат Код.ПолучитьРезультат();

КонецФункции

Функция ЕстьВыводимыеЗаголовки(Заголовки)

	Для Каждого Элемент Из Заголовки Цикл
		Если Не Элемент.Значение.Удален Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДобавитьОбъявленияПеременных(ОсновнойКод, ИменаПеременных)

	Если ИменаПеременных.Количество() = 0 Тогда
		Возврат ОсновнойКод;
	КонецЕсли;

	Код = Новый ПостроительКодаCURL;

	Для Каждого Элемент Из ИменаПеременных Цикл
		Код.ДобавитьСтроку("%1 = """";", Элемент.Значение);
	КонецЦикла;

	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку(ОсновнойКод);

	Возврат Код.ПолучитьРезультат();

КонецФункции

Процедура ДобавитьЗаголовки(Код, Заголовки, Выражения)

	Для Каждого Элемент Из Заголовки Цикл
		Заголовок = Элемент.Значение;
		Если Заголовок.Удален Тогда
			Продолжить;
		КонецЕсли;

		Код.ВставитьВСоответствие(
			"Заголовки",
			Выражения.Литерал(Заголовок.Имя),
			?(Заголовок.Выражение = Неопределено Или Заголовок.Выражение.ЯвляетсяЛитералом(),
				Выражения.Литерал(СокрЛП(Заголовок.Значение)),
				Выражения.ПредставитьПослеРазделителя(Заголовок.Выражение, ":", Истина))
		);
	КонецЦикла;

КонецПроцедуры

Функция АдресHTTP(Операция, Выражения)

	Адрес = Выражения.СтрокаДляРазбора(Операция.Ресурс().АдресДляВыполнения());
	
	ПозицияФрагмента = СтрНайти(Адрес, "#");
	Если ПозицияФрагмента > 0 Тогда
		Адрес = Лев(Адрес, ПозицияФрагмента - 1);
	КонецЕсли;

	НачалоУзла = СтрНайти(Адрес, "://");
	Если НачалоУзла > 0 Тогда
		Адрес = Сред(Адрес, НачалоУзла + 3);
	КонецЕсли;

	Позиция = СтрДлина(Адрес) + 1;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		НайденнаяПозиция = СтрНайти(Адрес, Разделитель);
		Если НайденнаяПозиция > 0 И НайденнаяПозиция < Позиция Тогда
			Позиция = НайденнаяПозиция;
		КонецЕсли;
	КонецЦикла;

	Если Позиция > СтрДлина(Адрес) Тогда
		Возврат "/";
	КонецЕсли;

	Возврат Сред(Адрес, Позиция);

КонецФункции

#КонецОбласти

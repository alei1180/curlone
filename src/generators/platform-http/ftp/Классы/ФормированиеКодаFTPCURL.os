#Использовать errors
#Использовать url
#Использовать "../../../shared"
#Использовать "../../../../domain"

#Область ПрограммныйИнтерфейс

// Формирует код одной FTP-операции без чтения файлов и выполнения запроса.
//
// Параметры:
//   Операция - ОперацияCURL - Семантическая модель операции.
//   Возможности - ФиксированныйМассив из Строка - Снимок возможностей генератора.
//
// Возвращаемое значение:
//   Строка - Код FTP/FTPS на языке 1С.
//
// Исключения:
//   argument.invalid_value - FTP-метод не представим средствами платформы.
Функция Получить(Операция, Возможности) Экспорт

	ИменаПеременных = Новый Соответствие;
	Выражения = Новый ГенераторВыраженийCURL(ЛокалиКонвертацииCURL.Русская(), ИменаПеременных);
	ВыражениеАдреса = Операция.Ресурс().АдресДляВыполнения();
	Адрес = Новый URL(Выражения.СтрокаДляРазбора(ВыражениеАдреса));
	Код = Новый ПостроительКодаCURL(Выражения);

	ДобавитьСоединение(Код, Операция, Адрес, ВыражениеАдреса, Выражения, Возможности);

	Запрос = Операция.Запрос();
	Метод = МетодОперации(Запрос, Возможности);
	ШаблонПути = Адрес.Путь();

	Если ПустаяСтрока(ШаблонПути) Тогда
		ШаблонПути = "/";
	КонецЕсли;

	Путь = ПредставитьЧастьАдреса(ШаблонПути, ВыражениеАдреса, Выражения);

	Код.ДобавитьСтроку();

	Если Метод = "STOR" Тогда
		ДобавитьЗагрузку(Код, Запрос, ШаблонПути, Путь, Возможности);
	ИначеЕсли Метод = "NLST" Тогда
		Код.ДобавитьСтроку("Файлы = Соединение.НайтиФайлы(%1, ""*"");", Путь);
	ИначеЕсли Метод = МетодыЗапросаПоУмолчаниюCURL.HEAD() Тогда
		Код.ДобавитьСтроку("Файл = Соединение.НайтиФайлы(%1)[0];", Путь);
	ИначеЕсли Метод = "RETR" Тогда
		ДобавитьПолучение(Код, Операция.Результат(), ШаблонПути, Путь, Возможности);
	Иначе
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента(
			"Метод",
			"Поддерживаются RETR, STOR, NLST и HEAD"
		);
	КонецЕсли;

	Код = ДобавитьОбъявленияПеременных(Код.ПолучитьРезультат(), ИменаПеременных);

	Возврат Код;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МетодОперации(Запрос, Возможности)

	Если Запрос.ЯвныйМетод() <> Неопределено И Есть(Возможности, КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса()) Тогда
		Возврат Запрос.ЯвныйМетод().ЛитеральноеЗначение();
	КонецЕсли;

	Если Запрос.НеПолучатьТело() И Есть(Возможности, КодыВозможностейГенератораCURL.ТолькоМетаданные()) Тогда
		Возврат МетодыЗапросаПоУмолчаниюCURL.HEAD();
	КонецЕсли;

	Если Запрос.ТолькоИменаПриПеречислении() И Есть(Возможности, КодыВозможностейГенератораCURL.ТолькоИмена()) Тогда
		Возврат "NLST";
	КонецЕсли;

	Если Запрос.Тело().Вид() = "upload_file" И Есть(Возможности, КодыВозможностейГенератораCURL.ЗагрузкаФайла()) Тогда
		Возврат "STOR";
	КонецЕсли;

	Возврат "RETR";

КонецФункции

Процедура ДобавитьСоединение(Код, Операция, Адрес, ВыражениеАдреса, Выражения, Возможности)

	Настройки = Операция.Соединение();
	УчетныеДанные = Операция.Запрос().Аутентификация().УчетныеДанные();

	Пользователь = "";
	Пароль = "";

	Если УчетныеДанные <> Неопределено И Есть(Возможности, КодыВозможностейГенератораCURL.УчетныеДанные()) Тогда
		Если УчетныеДанные.ТребуетРазбора() Тогда
			Пользователь = Выражения.ПредставитьДоРазделителя(УчетныеДанные.Выражение(), ":");
			Пароль = Выражения.ПредставитьПослеРазделителя(УчетныеДанные.Выражение(), ":");
		Иначе
			Пользователь = Код.ПараметрВСтроку(УчетныеДанные.Пользователь());
			Пароль = Код.ПараметрВСтроку(?(УчетныеДанные.Пароль() = Неопределено, "", УчетныеДанные.Пароль()));
		КонецЕсли;
	КонецЕсли;

	Защита = ДобавитьTLS(Код, Настройки.TLS(), Адрес.Схема(), Выражения, Возможности);
	Прокси = ДобавитьПрокси(Код, Настройки.Прокси(), Возможности);

	Порт = Адрес.Порт();
	Если Порт = Неопределено Тогда
		Порт = ?(Адрес.Схема() = ПротоколыCURL.FTPS(), 990, 21);
	КонецЕсли;

	// Адрес обратного соединения не представим. Режим сохраняется с предупреждением ftp.active.
	Пассивный = ?(Настройки.РежимFTP() = "active" И ПустаяСтрока(Прокси), "", "Истина");
	Таймаут = "";

	// Платформенный таймаут является приближением общего лимита curl, анализатор предупреждает о timeout.total.
	Если Настройки.Таймаут() <> Неопределено Тогда
		Таймаут = Формат(Настройки.Таймаут().Значение() / 1000, "ЧГ=0;ЧРД=.");
	КонецЕсли;

	Аргументы = Новый Массив;
	Аргументы.Добавить(ПредставитьЧастьАдреса(Адрес.Хост(), ВыражениеАдреса, Выражения));
	Аргументы.Добавить(Формат(Порт, "ЧГ=0"));
	Аргументы.Добавить(Пользователь);
	Аргументы.Добавить(Пароль);
	Аргументы.Добавить(Прокси);
	Аргументы.Добавить(Пассивный);
	Аргументы.Добавить(Таймаут);
	Аргументы.Добавить(Защита);

	Код.ДобавитьСтроку(
		"Соединение = Новый FTPСоединение(%1);",
		Код.ПараметрыФункцииВСтроку(Аргументы)
	);

КонецПроцедуры

Функция ДобавитьTLS(Код, TLS, Схема, Выражения, Возможности)

	Если Схема <> ПротоколыCURL.FTPS() Тогда
		Возврат "";
	КонецЕсли;

	Клиент = "";
	УЦ = "";
	Сертификат = TLS.СертификатКлиента();

	Если Сертификат <> Неопределено И Есть(Возможности, КодыВозможностейГенератораCURL.СертификатКлиента()) Тогда
		Если Сертификат.ТребуетРазбора() Тогда
			ПутьСертификата = Выражения.ПредставитьДоРазделителя(Сертификат.Выражение(), ":");
			ПарольСертификата = Выражения.ПредставитьПослеРазделителя(Сертификат.Выражение(), ":");
		Иначе
			ПутьСертификата = Код.ПараметрВСтроку(Сертификат.Путь());
			ПарольСертификата = Код.ПараметрВСтроку(
				?(Сертификат.Пароль() = Неопределено, "", Сертификат.Пароль())
			);
		КонецЕсли;

		Код.ДобавитьСтроку(
			"СертификатКлиента = Новый СертификатКлиентаФайл(%1, %2);",
			ПутьСертификата,
			ПарольСертификата
		);
		Клиент = "СертификатКлиента";

	КонецЕсли;

	Если TLS.ИспользоватьСистемноеХранилище()
		И Есть(Возможности, КодыВозможностейГенератораCURL.СистемноеХранилищеСертификатов()) Тогда
		Код.ДобавитьСтроку("СертификатыУдостоверяющихЦентров = Новый СертификатыУдостоверяющихЦентровОС();");
		УЦ = "СертификатыУдостоверяющихЦентров";
	ИначеЕсли TLS.СертификатыУдостоверяющегоЦентра() <> Неопределено
		И Есть(Возможности, КодыВозможностейГенератораCURL.ФайлУдостоверяющегоЦентра()) Тогда

		Код.ДобавитьСтроку(
			"СертификатыУдостоверяющихЦентров = Новый СертификатыУдостоверяющихЦентровФайл(%1);",
			Выражения.Представить(TLS.СертификатыУдостоверяющегоЦентра())
		);
		УЦ = "СертификатыУдостоверяющихЦентров";

	КонецЕсли;

	Аргументы = Новый Массив;
	Аргументы.Добавить(Клиент);
	Аргументы.Добавить(УЦ);

	Код.ДобавитьСтроку(
		"ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(%1);",
		Код.ПараметрыФункцииВСтроку(Аргументы)
	);
	Код.ДобавитьСтроку();

	Возврат "ЗащищенноеСоединение";

КонецФункции

Функция ДобавитьПрокси(Код, Прокси, Возможности)

	Если Прокси.Режим() <> РежимыПроксиCURL.Настроен() Или Прокси.Протокол() <> ПротоколыCURL.HTTP()
		Или Не Есть(Возможности, КодыВозможностейГенератораCURL.ПроксиHTTP()) Тогда
		Возврат "";
	КонецЕсли;

	Пользователь = "";
	Пароль = "";
	Данные = Прокси.УчетныеДанные();

	Если Данные <> Неопределено И Есть(Возможности, КодыВозможностейГенератораCURL.УчетныеДанныеПрокси()) Тогда
		Пользователь = Код.ПараметрВСтроку(Данные.Пользователь());
		Пароль = Код.ПараметрВСтроку(?(Данные.Пароль() = Неопределено, "", Данные.Пароль()));
	КонецЕсли;

	Код.ДобавитьСтроку("Прокси = Новый ИнтернетПрокси();");

	Аргументы = Новый Массив;
	Аргументы.Добавить("""" + ПротоколыCURL.FTP() + """");
	Аргументы.Добавить(Код.ПараметрВСтроку(Прокси.Сервер()));
	Аргументы.Добавить(Формат(Прокси.Порт(), "ЧГ=0"));
	Аргументы.Добавить(Пользователь);
	Аргументы.Добавить(Пароль);
	Аргументы.Добавить("Ложь");

	Код.ДобавитьСтроку("Прокси.Установить(%1);", Код.ПараметрыФункцииВСтроку(Аргументы));
	Код.ДобавитьСтроку();

	Возврат "Прокси";

КонецФункции

Процедура ДобавитьЗагрузку(Код, Запрос, ШаблонПути, Путь, Возможности)

	Для Каждого Часть Из Запрос.Тело().Части() Цикл

		Если Часть.ПутьКФайлу() = Неопределено Или Не Есть(Возможности, КодыВозможностейГенератораCURL.ЧтениеФайла()) Тогда
			Продолжить;
		КонецЕсли;

		ИмяФайла = Часть.ПутьКФайлу();
		ПутьНазначения = Путь;

		Если Прав(ШаблонПути, 1) = "/" Тогда
			Если Лев(Путь, 1) = """" Тогда
				ПутьНазначения = Код.ПараметрВСтроку(ШаблонПути + ПоследнийСегмент(ИмяФайла));
			Иначе
				ПутьНазначения = Путь + " + " + Код.ПараметрВСтроку(ПоследнийСегмент(ИмяФайла));
			КонецЕсли;
		КонецЕсли;

		Код.ДобавитьСтроку(
			"Соединение.Записать(%1, %2);",
			Код.ПараметрВСтроку(ИмяФайла),
			ПутьНазначения
		);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолучение(Код, Результат, ШаблонПути, Путь, Возможности)

	ИмяФайла = "path/to/file";
	ПредставлениеФайла = Неопределено;

	Если (Результат.Режим() = "file" Или Результат.Режим() = "deferred")
		И Есть(Возможности, КодыВозможностейГенератораCURL.ВыводВФайл()) Тогда
		ПредставлениеФайла = Код.ПредставитьВыражение(Результат.ИмяФайла());
	ИначеЕсли Результат.Режим() = "remote_name" И Есть(Возможности, КодыВозможностейГенератораCURL.ИмяФайлаИзURL()) Тогда
		ИмяФайла = ПоследнийСегмент(ШаблонПути);
	КонецЕсли;

	Если ПредставлениеФайла = Неопределено Тогда
		ПредставлениеФайла = Код.ПараметрВСтроку(ИмяФайла);
	КонецЕсли;

	Если Результат.Каталог() <> Неопределено И Есть(Возможности, КодыВозможностейГенератораCURL.КаталогВывода()) Тогда
		ПредставлениеФайла = СтрШаблон(
			"ОбъединитьПути(%1, %2)",
			Код.ПредставитьВыражение(Результат.Каталог()),
			ПредставлениеФайла
		);
	КонецЕсли;

	Если Результат.СоздаватьКаталоги() И Есть(Возможности, КодыВозможностейГенератораCURL.СозданиеКаталогов()) Тогда
		Код.ДобавитьСтроку("СоздатьКаталог(Новый Файл(%1).Путь);", ПредставлениеФайла);
	КонецЕсли;

	Код.ДобавитьСтроку("Соединение.Получить(%1, %2);", Путь, ПредставлениеФайла);

КонецПроцедуры

Функция ПредставитьЧастьАдреса(Шаблон, ВыражениеАдреса, Выражения)

	Если ВыражениеАдреса.ЯвляетсяЛитералом() Тогда
		Возврат Выражения.Литерал(Шаблон);
	КонецЕсли;

	Возврат Выражения.ПредставитьШаблон(Шаблон, ВыражениеАдреса);

КонецФункции

Функция ДобавитьОбъявленияПеременных(ОсновнойКод, ИменаПеременных)

	Если ИменаПеременных.Количество() = 0 Тогда
		Возврат ОсновнойКод;
	КонецЕсли;

	Код = Новый ПостроительКодаCURL;

	Для Каждого Элемент Из ИменаПеременных Цикл
		Код.ДобавитьСтроку("%1 = """";", Элемент.Значение);
	КонецЦикла;

	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку(ОсновнойКод);

	Возврат Код.ПолучитьРезультат();

КонецФункции

Функция ПоследнийСегмент(Путь)

	Части = СтрРазделить(СтрЗаменить(Путь, "\", "/"), "/", Истина);
	Возврат Части[Части.Количество() - 1];

КонецФункции

Функция Есть(Возможности, Имя)
	Возврат Возможности.Найти(Имя) <> Неопределено;
КонецФункции

#КонецОбласти

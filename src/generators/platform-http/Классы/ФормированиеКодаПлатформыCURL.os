#Использовать url
#Использовать "../../shared"
#Использовать "../ftp"
#Использовать "../../../domain"

#Область ПрограммныйИнтерфейс

// Формирует платформенный код для одной подготовленной операции.
//
// Параметры:
//   ПодготовленнаяОперация - Структура - Результат адаптации операции.
//   Локаль - Строка - Локаль кода.
//   Параметры - Соответствие из КлючИЗначение - Параметры генератора.
//   Возможности - ФиксированныйМассив из Строка - Снимок возможностей генератора.
//
// Возвращаемое значение:
//   Строка - Платформенный код.
Функция Получить(ПодготовленнаяОперация, Локаль, Параметры, Возможности) Экспорт

	Операция = ПодготовленнаяОперация.Операция;
	Запрос = Операция.Запрос();
	ИменаПеременных = Новый Соответствие;
	Выражения = Новый ГенераторВыраженийCURL(ЛокалиКонвертацииCURL.Русская(), ИменаПеременных);
	ВыражениеURL = Операция.Ресурс().ИсходныйАдрес();
	ВыражениеURLДляРазбора = Операция.Ресурс().АдресДляВыполнения();
	URL = Новый URL(Выражения.СтрокаДляРазбора(ВыражениеURLДляРазбора));

	Если Возможности.Найти(КодыВозможностейГенератораCURL.ДляПротокола(URL.Схема())) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ПоддерживаютсяТолькоБазовыеОперации(Возможности) Тогда
		Возврат СформироватьБазовуюОперацию(Операция, URL, Выражения, Локаль);
	КонецЕсли;

	Если URL.Схема() = ПротоколыCURL.FTP() Или URL.Схема() = ПротоколыCURL.FTPS() Тогда
		Возврат Новый ФормированиеКодаFTPCURL().Получить(Операция, Локаль, Возможности);
	КонецЕсли;

	Адрес = АдресHTTP(Операция, Выражения);

	Если Прав(Адрес, 1) = "/" И Запрос.Тело().Вид() = "upload_file"
		И Возможности.Найти(КодыВозможностейГенератораCURL.ЗагрузкаФайла()) <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ЧтениеФайла()) <> Неопределено Тогда
		Для Каждого Часть Из ПодготовленнаяОперация.ЧастиТела Цикл
			Если Часть.ПутьКФайлу() <> Неопределено Тогда
				Сегменты = СтрРазделить(СтрЗаменить(Часть.ПутьКФайлу(), "\", "/"), "/", Ложь);
				Адрес = Адрес + КодированиеURL.КодироватьСегментПути(Сегменты[Сегменты.Количество() - 1]);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Код = Новый ПостроительКодаCURL(Выражения);
	Тело = Новый ФормированиеТелаHTTPЗапросаCURL(Выражения, , , Локаль);
	ЕстьСоставнаяФорма = Тело.ЭтоСоставнаяФорма(ПодготовленнаяОперация.ЧастиТела);
	ЕстьСтрокаЗапроса = ПодготовленнаяОперация.ЧастиСтрокиЗапроса.Количество() > 0;

	Если ЕстьСоставнаяФорма Тогда
		Тело.ПодготовитьСоставнуюФорму(Код, ПодготовленнаяОперация.ЧастиТела);
		ПростоеТело = Новый Структура("Есть, Выражение, МетодУстановки, ДобавитьТипСодержимого", Ложь);
	Иначе
		ПростоеТело = ПолучитьПростоеТело(Код, ПодготовленнаяОперация.ЧастиТела, Выражения);
	КонецЕсли;

	Если ЕстьСтрокаЗапроса Тогда
		СтрокаЗапроса = ПодготовитьСтрокуЗапроса(
			Код,
			ПодготовленнаяОперация.ЧастиСтрокиЗапроса,
			Адрес,
			Операция,
			Выражения
		);
	КонецЕсли;

	Аутентификация = Операция.Запрос().Аутентификация();
	ЕстьOAuth = Аутентификация.OAuth2() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТокенOAuth2()) <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.АутентификацияOAuth2Bearer()) <> Неопределено
		И ПодготовленнаяОперация.Заголовки.Получить("authorization") = Неопределено;
	ДобавитьТипСодержимого = ПростоеТело.Есть И ПростоеТело.ДобавитьТипСодержимого
		И ПодготовленнаяОперация.Заголовки.Получить("content-type") = Неопределено;
	ЕстьЗаголовки = ЕстьВыводимыеЗаголовки(ПодготовленнаяОперация.Заголовки)
		Или ДобавитьТипСодержимого Или ЕстьOAuth
		Или ЕстьСоставнаяФорма;

	Если ЕстьЗаголовки Тогда
		Код.ОбъявитьСоответствие("Заголовки");
		ДобавитьЗаголовки(Код, ПодготовленнаяОперация.Заголовки, Выражения);

		Если ДобавитьТипСодержимого Тогда
			Код.ДобавитьСтроку(
				"Заголовки.Вставить(""Content-Type"", ""application/x-www-form-urlencoded"");"
			);
		КонецЕсли;

		Если ЕстьСоставнаяФорма Тогда
			Код.ДобавитьСтроку(
				"Заголовки.Вставить(""Content-Type"", ""multipart/form-data; boundary="" + РазделительMultipart);"
			);
		КонецЕсли;

		Если ЕстьOAuth Тогда
			ВыражениеТокена = Аутентификация.OAuth2().Выражение();
			Если ВыражениеТокена.ЯвляетсяЛитералом() Тогда
				ПредставлениеТокена = Выражения.Литерал("Bearer " + ВыражениеТокена.ЛитеральноеЗначение());
			Иначе
				ПредставлениеТокена = Выражения.Литерал("Bearer ") + " + " + Выражения.Представить(ВыражениеТокена);
			КонецЕсли;

			Код.ДобавитьСтроку(
				"Заголовки.Вставить(""Authorization"", %1);",
				ПредставлениеТокена
			);
		КонецЕсли;

		Код.ДобавитьСтроку();
	КонецЕсли;

	ДобавитьСоединение(Код, Операция, URL, Выражения, Возможности, ПодготовленнаяОперация.Заголовки);

	Если ЕстьСтрокаЗапроса И Не ПустаяСтрока(СтрокаЗапроса.КодПередЗапросом) Тогда
		Код.ДобавитьСтроку();
		Код.ДобавитьСтроку(СтрокаЗапроса.КодПередЗапросом);
	КонецЕсли;

	Код.ДобавитьСтроку(
		"HTTPЗапрос = Новый HTTPЗапрос(%1%2);",
		?(ЕстьСтрокаЗапроса, СтрокаЗапроса.ВыражениеАдреса, Выражения.ПредставитьШаблон(Адрес, ВыражениеURL)),
		?(ЕстьЗаголовки, ", Заголовки", "")
	);

	Если ЕстьСоставнаяФорма Тогда
		Тело.ДобавитьСоставнуюФорму(Код, ПодготовленнаяОперация.ЧастиТела, Возможности);
	ИначеЕсли ПростоеТело.Есть Тогда
		Код.ДобавитьСтроку(
			"HTTPЗапрос.%1(%2);",
			ПростоеТело.МетодУстановки,
			ПростоеТело.Выражение
		);
	Иначе
		Тело.ДобавитьТелоИзЧастей(
			Код,
			ПодготовленнаяОперация.ЧастиТела,
			Возможности,
			ПодготовленнаяОперация.Заголовки.Получить("content-type") <> Неопределено
		);
	КонецЕсли;

	Код.ДобавитьСтроку();

	Метод = Запрос.МетодПоУмолчанию();
	ПредставлениеМетода = Неопределено;

	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = ?(
			URL.Схема() = ПротоколыCURL.HTTP() Или URL.Схема() = ПротоколыCURL.HTTPS(),
			МетодыЗапросаПоУмолчаниюCURL.GET(),
			Метод
		);
	КонецЕсли;

	Если Метод = МетодыЗапросаПоУмолчаниюCURL.HEAD()
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТолькоМетаданные()) = Неопределено Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Если Запрос.ЯвныйМетод() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса()) <> Неопределено Тогда
		ВыражениеМетода = Запрос.ЯвныйМетод();
		Если ВыражениеМетода.ЯвляетсяЛитералом() Тогда
			Метод = ВыражениеМетода.ЛитеральноеЗначение();
		Иначе
			ПредставлениеМетода = Выражения.Представить(ВыражениеМетода);
		КонецЕсли;
	КонецЕсли;

	Если ПредставлениеМетода = Неопределено Тогда
		ПредставлениеМетода = Выражения.Литерал(Метод);
	КонецЕсли;

	РезультатОперации = Операция.Результат();
	ПараметрФайла = ПодготовитьФайлРезультата(Код, РезультатОперации, URL, Выражения, Возможности);

	Код.ДобавитьСтроку(
		"HTTPОтвет = Соединение.ВызватьHTTPМетод(%1, HTTPЗапрос%2);",
		ПредставлениеМетода,
		?(ПустаяСтрока(ПараметрФайла), "", ", " + ПараметрФайла)
	);

	Локализация = Новый ЛокализацияКодаCURL(Локаль);
	ДобавитьОбработкуРезультата(Код, РезультатОперации, Параметры, Локализация);

	Код = ДобавитьОбъявленияПеременных(Код.ПолучитьРезультат(), ИменаПеременных);
	Код = Локализация.Перевести(Код);

	Возврат Код;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоддерживаютсяТолькоБазовыеОперации(Возможности)

	Для Каждого Возможность Из Возможности Цикл

		Если Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTP()
			И Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTPS()
			И Возможность <> КодыВозможностейГенератораCURL.НесколькоОпераций() Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СформироватьБазовуюОперацию(Операция, URL, Выражения, Локаль)

	Метод = Операция.Запрос().МетодПоУмолчанию();
	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Код = Новый ПостроительКодаCURL(Выражения);
	Код.ДобавитьСтроку("Адрес = %1;", Выражения.Литерал(АдресHTTP(Операция, Выражения)));
	Код.ДобавитьСтроку("ЗапросHTTP = Новый HTTPЗапрос(Адрес);");
	Код.ДобавитьСтроку(
		"СоединениеHTTP = Новый HTTPСоединение(%1, %2);",
		Выражения.Литерал(URL.IDNХост()),
		Формат(URL.ЭффективныйПорт(), "ЧГ=0")
	);
	Код.ДобавитьСтроку(
		"ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(%1, ЗапросHTTP);",
		Выражения.Литерал(Метод)
	);
	Код.ДобавитьСтроку("Результат = ОтветHTTP.ПолучитьТелоКакСтроку();");

	Результат = Код.ПолучитьРезультат();
	Результат = Новый ЛокализацияКодаCURL(Локаль).Перевести(Результат);

	Возврат Результат;

КонецФункции

Функция ПолучитьПростоеТело(Код, Части, Выражения)

	Результат = Новый Структура("Есть, Выражение, МетодУстановки, ДобавитьТипСодержимого");
	Результат.Есть = Ложь;

	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЭтоЛитеральныйJSON(Части) Тогда
		ТекстJSON = "";
		Для Каждого Часть Из Части Цикл
			ТекстJSON = ТекстJSON + Часть.Текст();
		КонецЦикла;

		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(ТекстJSON);
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Ложь;

		Возврат Результат;
	КонецЕсли;

	Если Части.Количество() = 1 Тогда
		Часть = Части[0];
		Если Часть.ПутьКФайлу() <> Неопределено
			И (Часть.Вид() = "upload_file" Или Часть.Источник().УказанноеИмяОпции() = "--data-binary") Тогда
			Результат.Есть = Истина;
			Результат.Выражение = Выражения.Литерал(Часть.ПутьКФайлу());
			Результат.МетодУстановки = "УстановитьИмяФайлаТела";
			Результат.ДобавитьТипСодержимого = Часть.Вид() <> "upload_file";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	МожноСформироватьСтроку = Истина;
	ВыраженияЧастей = Новый Массив;

	Для Каждого Элемент Из Части Цикл
		ИмяОпции = Элемент.Источник().УказанноеИмяОпции();
		МожноСформироватьСтроку = МожноСформироватьСтроку И Элемент.ПутьКФайлу() = Неопределено
			И ИмяОпции <> "--data-urlencode" И Элемент.Вид() <> "multipart_field";

		Если Элемент.Текст() <> Неопределено И СтрНайти(Элемент.Текст(), Символы.ПС) > 0 Тогда
			МожноСформироватьСтроку = Ложь;
		КонецЕсли;

		Если Не МожноСформироватьСтроку Тогда
			Прервать;
		КонецЕсли;

		Префикс = ?(ВыраженияЧастей.Количество() > 0 И Элемент.РазделительПеред() = "ampersand", "&", "");
		Если Элемент.Текст() = Неопределено Тогда
			Шаблон = Префикс + Выражения.СтрокаДляРазбора(Элемент.Выражение());
			Представление = Выражения.ПредставитьШаблон(Шаблон, Элемент.Выражение());
		Иначе
			Представление = Выражения.Литерал(Префикс + Элемент.Текст());
		КонецЕсли;

		ВыраженияЧастей.Добавить(Представление);
	КонецЦикла;

	Если МожноСформироватьСтроку Тогда
		Результат.Есть = Истина;
		Результат.Выражение = СтрСоединить(ВыраженияЧастей, " + ");
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьJSONФайл(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Ложь;
		Возврат Результат;
	КонецЕсли;

	Если ВсеЧастиКодируются(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "&");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьДвоичнаяЧасть(Части) Тогда
		ДобавитьДвоичноеТело(Код, Части, Выражения);
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзДвоичныхДанных";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьТекстовыйФайл(Части) Или ЕстьПереводСтроки(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "&");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если Части.Количество() <> 1 Тогда
		Возврат Результат;
	КонецЕсли;

	Часть = Части[0];
	Если Часть.ПутьКФайлу() <> Неопределено
		И (Часть.Вид() = "upload_file" Или Часть.Источник().УказанноеИмяОпции() = "--data-binary") Тогда
		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(Часть.ПутьКФайлу());
		Результат.МетодУстановки = "УстановитьИмяФайлаТела";
		Результат.ДобавитьТипСодержимого = Часть.Вид() <> "upload_file";
	ИначеЕсли Часть.Текст() <> Неопределено И Часть.Вид() = "data" Тогда
		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(Часть.Текст());
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЕстьJSONФайл(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() <> "--json" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВсеЧастиКодируются(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Кодировать() <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЕстьДвоичнаяЧасть(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьТекстовыйФайл(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПереводСтроки(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Текст() <> Неопределено И СтрНайти(Часть.Текст(), Символы.ПС) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПодготовитьСтрокуЗапроса(Код, Части, ИсходныйПуть, Операция, Выражения)

	Путь = ИсходныйПуть;

	Если Путь = "/" Тогда
		Путь = "";
	КонецЕсли;

	ЛитеральныеЧасти = Новый Массив;
	ФайловыеЧасти = Новый Массив;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерФайла = НомерФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
			Код.ДобавитьСтроку();
			ФайловыеЧасти.Добавить(Новый Структура("Часть, Выражение", Часть, ИмяПеременной));
		Иначе
			ЛитеральныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Если ЛитералСледуетПослеФайла(Части) Тогда
		Возврат СформироватьСтрокуЗапросаПоПорядку(Части, Путь, ФайловыеЧасти, Выражения);
	КонецЕсли;

	ЕстьЗнакВопроса = СтрНайти(Путь, "?") > 0;
	Для Каждого Часть Из ЛитеральныеЧасти Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Текст = Часть.Текст();
		Если Часть.Кодировать() = Истина Тогда
			Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		Путь = Путь + Префикс + Текст;
	КонецЦикла;

	Если ФайловыеЧасти.Количество() = 0 Тогда
		Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", Выражения.Литерал(Путь), "");
	КонецЕсли;

	Если ФайловыеЧасти.Количество() = 1 Тогда
		ФайловаяЧасть = ФайловыеЧасти[0];
		Часть = ФайловаяЧасть.Часть;
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		ВыражениеАдреса = Выражения.Литерал(Путь + Префикс) + " + " + ФайловаяЧасть.Выражение;

		Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", ВыражениеАдреса, "");
	КонецЕсли;

	СтрокиАдреса = Новый Массив;
	СтрокиАдреса.Добавить("АдресРесурса = " + Выражения.Литерал(Путь));
	Для Каждого ФайловаяЧасть Из ФайловыеЧасти Цикл
		Часть = ФайловаяЧасть.Часть;
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		СтрокиАдреса.Добавить(Символы.Таб + "+ " + Выражения.Литерал(Префикс)
			+ " + " + ФайловаяЧасть.Выражение);
	КонецЦикла;

	СтрокиАдреса[СтрокиАдреса.ВГраница()] = СтрокиАдреса[СтрокиАдреса.ВГраница()] + ";";
	КодАдреса = СтрСоединить(СтрокиАдреса, Символы.ПС);

	Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", "АдресРесурса", КодАдреса);

КонецФункции

Процедура ДобавитьТекстовоеТело(Код, Части, Выражения, Разделитель)

	Файлы = Новый Соответствие;
	НомерФайла = 0;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
		Код.ДобавитьСтроку();
		Файлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	ЧастиВыражения = Новый Массив;
	НакопленныйТекст = "";
	Для Каждого Часть Из Части Цикл
		Если Файлы.Получить(Часть) <> Неопределено Тогда
			Если Не ПустаяСтрока(НакопленныйТекст) Тогда
				ЧастиВыражения.Добавить(Код.ПараметрВСтроку(НакопленныйТекст));
				НакопленныйТекст = "";
			КонецЕсли;

			ПрефиксФайла = ?(ЧастиВыражения.Количество() = 0, "", Разделитель);
			Если Часть.Кодировать() = Истина И Часть.ИмяПоля() <> Неопределено Тогда
				ПрефиксФайла = ПрефиксФайла + Часть.ИмяПоля() + "=";
			КонецЕсли;

			Если ПустаяСтрока(ПрефиксФайла) Тогда
				ЧастиВыражения.Добавить(Файлы[Часть]);
			Иначе
				ЧастиВыражения.Добавить(Код.ПараметрВСтроку(ПрефиксФайла) + " + " + Файлы[Часть]);
			КонецЕсли;

			Продолжить;
		КонецЕсли;

		Текст = Часть.Текст();
		Если Часть.Кодировать() = Истина Тогда
			Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			Если Часть.ИмяПоля() <> Неопределено Тогда
				Текст = Часть.ИмяПоля() + "=" + Текст;
			КонецЕсли;
		КонецЕсли;

		Если Не ПустаяСтрока(НакопленныйТекст) И Не ПустаяСтрока(Разделитель) Тогда
			НакопленныйТекст = НакопленныйТекст + Разделитель;
		КонецЕсли;

		НакопленныйТекст = НакопленныйТекст + Текст;
	КонецЦикла;

	Если Не ПустаяСтрока(НакопленныйТекст) Тогда
		ЧастиВыражения.Добавить(Код.ПараметрВСтроку(НакопленныйТекст));
	КонецЕсли;

	ДобавитьПрисваиваниеТела(Код, ЧастиВыражения, "");
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения)

	Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Выражения.Литерал(Часть.ПутьКФайлу()));
	Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);

	Если Часть.РежимИсточника() = "text_file_without_crlf_nul" Тогда
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ПС, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ВК, """");", ИмяПеременной);
	КонецЕсли;

	Если Часть.Кодировать() = Истина Тогда
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПрисваиваниеТела(Код, Части, Разделитель)

	Если Части.Количество() = 1 Тогда
		Код.ДобавитьСтроку("ТелоЗапроса = %1;", Части[0]);
		Возврат;
	КонецЕсли;

	Код.ДобавитьСтроку("ТелоЗапроса = %1", Части[0]);
	Для Индекс = 1 По Части.ВГраница() Цикл
		Префикс = ?(ПустаяСтрока(Разделитель), "", Код.ПараметрВСтроку(Разделитель) + " + ");
		Окончание = ?(Индекс = Части.ВГраница(), ";", "");
		Код.ДобавитьСтроку("%1+ %2%3", Символы.Таб, Префикс, Части[Индекс] + Окончание);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДвоичноеТело(Код, Части, Выражения)

	ТекстовыеФайлы = Новый Соответствие;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено
			Или Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
		Код.ДобавитьСтроку();
		ТекстовыеФайлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	Код.ОбъявитьМассив("ЧастиТелаЗапроса");
	ТекстоваяГруппа = Новый Массив;
	ЕстьДобавленныеЧасти = Ложь;

	Для Каждого Часть Из Части Цикл
		ЭтоДвоичнаяЧасть = Часть.Источник().УказанноеИмяОпции() = "--data-binary";
		Если Не ЭтоДвоичнаяЧасть Тогда
			Если ТекстовыеФайлы.Получить(Часть) <> Неопределено Тогда
				ТекстоваяГруппа.Добавить(ТекстовыеФайлы[Часть]);
			ИначеЕсли Часть.Текст() <> Неопределено Тогда
				Для Каждого Фрагмент Из СтрРазделить(Часть.Текст(), "&", Ложь) Цикл
					ТекстоваяГруппа.Добавить(Код.ПараметрВСтроку(Фрагмент));
				КонецЦикла;
			Иначе
				ТекстоваяГруппа.Добавить(Код.ПредставитьВыражение(Часть.Выражение()));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТекстоваяГруппа.Количество() > 0 Тогда
			ЕстьДобавленныеЧасти = ДобавитьГруппуТекстовогоТела(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
			ТекстоваяГруппа = Новый Массив;
		КонецЕсли;

		Если ЕстьДобавленныеЧасти Тогда
			ДобавитьДвоичныйРазделитель(Код);
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Код.ДобавитьСтроку(
				"ЧастиТелаЗапроса.Добавить(Новый ДвоичныеДанные(%1));",
				Выражения.Литерал(Часть.ПутьКФайлу())
			);
		Иначе
			Код.ДобавитьСтроку(
				"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1, КодировкаТекста.UTF8, "
					+ "ИспользованиеByteOrderMark.НеИспользовать));",
				ПредставитьТекстЧастиПлатформы(Код, Часть, Выражения)
			);
		КонецЕсли;

		ЕстьДобавленныеЧасти = Истина;
	КонецЦикла;

	Если ТекстоваяГруппа.Количество() > 0 Тогда
		ДобавитьГруппуТекстовогоТела(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
	КонецЕсли;

	Код.ДобавитьСтроку("ТелоЗапроса = СоединитьДвоичныеДанные(ЧастиТелаЗапроса);");
	Код.ДобавитьСтроку();

КонецПроцедуры

Функция ДобавитьГруппуТекстовогоТела(Код, Выражения, ЕстьДобавленныеЧасти)

	Если ЕстьДобавленныеЧасти Тогда
		ДобавитьДвоичныйРазделитель(Код);
	КонецЕсли;

	Выражение = Выражения[0];
	Для Индекс = 1 По Выражения.ВГраница() Цикл
		СледующееВыражение = Выражения[Индекс];
		Если СтрНачинаетсяС(СледующееВыражение, """") Тогда
			СледующееВыражение = Лев(СледующееВыражение, 1) + "&" + Сред(СледующееВыражение, 2);
		Иначе
			СледующееВыражение = """&"" + " + СледующееВыражение;
		КонецЕсли;

		Выражение = Выражение + Символы.ПС + Символы.Таб + "+ " + СледующееВыражение;
	КонецЦикла;

	Код.ДобавитьСтроку(
		"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1,%2КодировкаТекста.UTF8,%2"
			+ "ИспользованиеByteOrderMark.НеИспользовать));",
		Выражение,
		Символы.ПС + Символы.Таб
	);

	Возврат Истина;

КонецФункции

Процедура ДобавитьДвоичныйРазделитель(Код)

	Код.ДобавитьСтроку(
		"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(""&"", КодировкаТекста.UTF8, "
			+ "ИспользованиеByteOrderMark.НеИспользовать));"
	);

КонецПроцедуры

Функция ПредставитьТекстЧастиПлатформы(Код, Часть, Выражения)

	Если Часть.Текст() <> Неопределено Тогда
		Возврат Код.ПараметрВСтроку(Часть.Текст());
	КонецЕсли;

	Возврат Код.ПредставитьВыражение(Часть.Выражение());

КонецФункции

Функция ЭтоЛитеральныйJSON(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() <> "--json" Или Часть.Текст() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЛитералСледуетПослеФайла(Части)

	ФайлНайден = Ложь;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			ФайлНайден = Истина;
		ИначеЕсли ФайлНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СформироватьСтрокуЗапросаПоПорядку(Части, Путь, ФайловыеЧасти, Выражения)

	Строки = Новый Массив;
	Строки.Добавить("АдресРесурса = " + Выражения.Литерал(Путь) + ";");
	ЕстьЗнакВопроса = СтрНайти(Путь, "?") > 0;
	ИндексФайла = 0;

	Для Каждого Часть Из Части Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Выражение = ФайловыеЧасти[ИндексФайла].Выражение;
			ИндексФайла = ИндексФайла + 1;
			Строки.Добавить("АдресРесурса = АдресРесурса + " + Выражения.Литерал(Префикс)
				+ " + " + Выражение + ";");
		Иначе
			Текст = Часть.Текст();
			Если Часть.Кодировать() = Истина Тогда
				Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			КонецЕсли;

			Строки.Добавить("АдресРесурса = АдресРесурса + " + Выражения.Литерал(Префикс + Текст) + ";");
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура(
		"ВыражениеАдреса, КодПередЗапросом",
		"АдресРесурса",
		СтрСоединить(Строки, Символы.ПС)
	);

КонецФункции

Функция ЕстьВыводимыеЗаголовки(Заголовки)

	Для Каждого Элемент Из Заголовки Цикл
		Если Не Элемент.Значение.Удален Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДобавитьОбъявленияПеременных(ОсновнойКод, ИменаПеременных)

	Если ИменаПеременных.Количество() = 0 Тогда
		Возврат ОсновнойКод;
	КонецЕсли;

	Код = Новый ПостроительКодаCURL;

	Для Каждого Элемент Из ИменаПеременных Цикл
		Код.ДобавитьСтроку("%1 = """";", Элемент.Значение);
	КонецЦикла;

	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку(ОсновнойКод);

	Возврат Код.ПолучитьРезультат();

КонецФункции

Процедура ДобавитьЗаголовки(Код, Заголовки, Выражения)

	Для Каждого Элемент Из Заголовки Цикл
		Заголовок = Элемент.Значение;
		Если Заголовок.Удален Тогда
			Продолжить;
		КонецЕсли;

		Код.ВставитьВСоответствие(
			"Заголовки",
			Выражения.Литерал(Заголовок.Имя),
			?(Заголовок.Выражение = Неопределено Или Заголовок.Выражение.ЯвляетсяЛитералом(),
				Выражения.Литерал(СокрЛП(Заголовок.Значение)),
				Выражения.ПредставитьПослеРазделителя(Заголовок.Выражение, ":", Истина))
		);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСоединение(Код, Операция, URL, Выражения, Возможности, Заголовки)

	Настройки = Операция.Соединение();
	TLS = ДобавитьTLS(Код, Настройки.TLS(), URL.Схема() = ПротоколыCURL.HTTPS(), Выражения, Возможности);
	Прокси = ДобавитьПрокси(Код, Настройки.Прокси(), URL.Схема(), Выражения, Возможности);
	Аутентификация = Операция.Запрос().Аутентификация();
	Пользователь = "";
	Пароль = "";
	АутентификацияОС = "";
	УчетныеДанные = Аутентификация.УчетныеДанные();
	Способ = "basic";

	Для Каждого Элемент Из Аутентификация.Способы() Цикл
		Способ = Элемент.Вид();
	КонецЦикла;

	Если (Способ = "ntlm" Или Способ = "negotiate")
		И Возможности.Найти(КодыВозможностейГенератораCURL.ДляСпособаАутентификации(Способ)) <> Неопределено Тогда
		АутентификацияОС = "Истина";
	КонецЕсли;

	Если УчетныеДанные <> Неопределено И Возможности.Найти(КодыВозможностейГенератораCURL.УчетныеДанные()) <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ДляСпособаАутентификации(Способ)) <> Неопределено Тогда
		Если УчетныеДанные.ТребуетРазбора() Тогда
			Пользователь = Выражения.ПредставитьДоРазделителя(УчетныеДанные.Выражение(), ":");
			Пароль = Выражения.ПредставитьПослеРазделителя(УчетныеДанные.Выражение(), ":");
		Иначе
			Пользователь = Выражения.Литерал(УчетныеДанные.Пользователь());
			Пароль = Выражения.Литерал(?(УчетныеДанные.Пароль() = Неопределено, "", УчетныеДанные.Пароль()));
		КонецЕсли;
	КонецЕсли;

	Аргументы = Новый Массив;
	Аргументы.Добавить(
		Выражения.ПредставитьШаблон(URL.IDNХост(), Операция.Ресурс().АдресДляВыполнения())
	);
	Аргументы.Добавить(Формат(URL.ЭффективныйПорт(), "ЧГ=0"));
	Аргументы.Добавить(Пользователь);
	Аргументы.Добавить(Пароль);
	Аргументы.Добавить(Прокси);

	// Общий таймаут приближается таймаутом соединения, анализатор сообщает о потере точности.
	Таймаут = Настройки.Таймаут();
	Если Таймаут = Неопределено Тогда
		Таймаут = Настройки.ТаймаутСоединения();
	КонецЕсли;

	Аргументы.Добавить(?(Таймаут = Неопределено, "", Формат(Таймаут.Значение() / 1000, "ЧГ=0; ЧРД=.")));
	Аргументы.Добавить(TLS);
	Аргументы.Добавить(АутентификацияОС);
	Код.ДобавитьСтроку(
		"Соединение = Новый HTTPСоединение(%1);",
		Код.ПараметрыФункцииВСтроку(Аргументы)
	);

КонецПроцедуры

Функция ДобавитьTLS(Код, Настройки, HTTPS, Выражения, Возможности)

	Если Не HTTPS Тогда
		Возврат "";
	КонецЕсли;

	Клиент = "";
	Центры = "";
	Сертификат = Настройки.СертификатКлиента();

	Если Сертификат <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.СертификатКлиента()) <> Неопределено Тогда
		Клиент = "СертификатКлиента";
		Если Сертификат.ТребуетРазбора() Тогда
			ПутьСертификата = Выражения.ПредставитьДоРазделителя(Сертификат.Выражение(), ":");
			ПарольСертификата = Выражения.ПредставитьПослеРазделителя(Сертификат.Выражение(), ":");
			Код.ДобавитьСтроку(
				"%1 = Новый СертификатКлиентаФайл(%2, %3);",
				Клиент,
				ПутьСертификата,
				ПарольСертификата
			);
		ИначеЕсли Сертификат.Пароль() = Неопределено Тогда
			Код.ДобавитьСтроку(
				"%1 = Новый СертификатКлиентаФайл(%2);",
				Клиент,
				Выражения.Литерал(Сертификат.Путь())
			);
		Иначе
			Код.ДобавитьСтроку(
				"%1 = Новый СертификатКлиентаФайл(%2, %3);",
				Клиент,
				Выражения.Литерал(Сертификат.Путь()),
				Выражения.Литерал(Сертификат.Пароль())
			);
		КонецЕсли;
	КонецЕсли;

	Если Настройки.ИспользоватьСистемноеХранилище()
		И Возможности.Найти(КодыВозможностейГенератораCURL.СистемноеХранилищеСертификатов()) <> Неопределено Тогда
		Центры = "СертификатыУдостоверяющихЦентров";
		Код.ДобавитьСтроку("%1 = Новый СертификатыУдостоверяющихЦентровОС();", Центры);
	ИначеЕсли Настройки.СертификатыУдостоверяющегоЦентра() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ФайлУдостоверяющегоЦентра()) <> Неопределено Тогда
		Центры = "СертификатыУдостоверяющихЦентров";
		Код.ДобавитьСтроку(
			"%1 = Новый СертификатыУдостоверяющихЦентровФайл(%2);",
			Центры,
			Код.ПредставитьВыражение(Настройки.СертификатыУдостоверяющегоЦентра())
		);
	КонецЕсли;

	Аргументы = Новый Массив;
	Аргументы.Добавить(Клиент);
	Аргументы.Добавить(Центры);
	Код.ДобавитьСтроку(
		"ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(%1);",
		Код.ПараметрыФункцииВСтроку(Аргументы)
	);
	Код.ДобавитьСтроку();

	Возврат "ЗащищенноеСоединение";

КонецФункции

Функция ДобавитьПрокси(Код, Настройки, Протокол, Выражения, Возможности)

	Если Возможности.Найти(КодыВозможностейГенератораCURL.ПроксиHTTP()) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Настройки.Режим() = РежимыПроксиCURL.ОпределитьПослеВычисления() Тогда
		ПараметрыПрокси = РазобратьВычисляемыйПрокси(Настройки, Выражения);
		Если ПараметрыПрокси = Неопределено Тогда
			Возврат "";
		КонецЕсли;
	ИначеЕсли Настройки.Режим() = РежимыПроксиCURL.Настроен() И Настройки.Протокол() = ПротоколыCURL.HTTP() Тогда
		ПараметрыПрокси = Новый Структура(
			"Сервер, Порт",
			Выражения.Литерал(Настройки.Сервер()),
			?(Настройки.Порт() = Неопределено, 1080, Настройки.Порт())
		);
	Иначе
		Возврат "";
	КонецЕсли;

	Пользователь = "";
	Пароль = "";
	Данные = Настройки.УчетныеДанные();

	Если Данные <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.УчетныеДанныеПрокси()) <> Неопределено Тогда
		Пользователь = Данные.Пользователь();
		Пароль = ?(Данные.Пароль() = Неопределено, "", Данные.Пароль());
	КонецЕсли;

	ОС = "Ложь";
	Для Каждого Способ Из Настройки.СпособыАутентификации() Цикл
		Если Способ.Вид() = "ntlm"
			И Возможности.Найти(КодыВозможностейГенератораCURL.АутентификацияПроксиNTLM()) <> Неопределено Тогда
			ОС = "Истина";
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСтроку("Прокси = Новый ИнтернетПрокси();");

	АргументыПрокси = Новый Массив;
	АргументыПрокси.Добавить(Выражения.Литерал(Протокол));
	АргументыПрокси.Добавить(ПараметрыПрокси.Сервер);
	АргументыПрокси.Добавить(Формат(ПараметрыПрокси.Порт, "ЧГ=0"));

	Если Данные <> Неопределено Тогда
		АргументыПрокси.Добавить(Выражения.Литерал(Пользователь));
		АргументыПрокси.Добавить(?(ПустаяСтрока(Пароль), "", Выражения.Литерал(Пароль)));
		АргументыПрокси.Добавить(ОС);
	Иначе
		АргументыПрокси.Добавить("");
		АргументыПрокси.Добавить("");
		АргументыПрокси.Добавить(ОС);
	КонецЕсли;

	Код.ДобавитьСтроку("Прокси.Установить(%1);", Код.ПараметрыФункцииВСтроку(АргументыПрокси));
	Код.ДобавитьСтроку();

	Возврат "Прокси";

КонецФункции

Функция РазобратьВычисляемыйПрокси(Настройки, Выражения)

	Шаблон = Выражения.СтрокаДляРазбора(Настройки.Адрес());
	Если СтрНайти(Шаблон, "://") = 0 Тогда
		Шаблон = ПротоколыCURL.HTTP() + "://" + Шаблон;
	КонецЕсли;

	Попытка
		Адрес = Новый URL(Шаблон);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НРег(Адрес.Схема()) <> ПротоколыCURL.HTTP() Или ПустаяСтрока(Адрес.Хост()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сервер = Выражения.ПредставитьШаблон(Адрес.Хост(), Настройки.Адрес());
	Порт = ?(Адрес.Порт() = Неопределено, 1080, Адрес.Порт());

	Возврат Новый Структура("Сервер, Порт", Сервер, Порт);

КонецФункции

Функция ПодготовитьФайлРезультата(Код, Результат, URL, Выражения, Возможности)

	Имя = Неопределено;
	Если (Результат.Режим() = "file" Или Результат.Режим() = "deferred")
		И Возможности.Найти(КодыВозможностейГенератораCURL.ВыводВФайл()) <> Неопределено Тогда
		Имя = Код.ПредставитьВыражение(Результат.ИмяФайла());
	ИначеЕсли Результат.Режим() = "remote_name"
		И Возможности.Найти(КодыВозможностейГенератораCURL.ИмяФайлаИзURL()) <> Неопределено Тогда
		Сегменты = СтрРазделить(URL.КодированныйПуть(), "/", Ложь);
		Если Сегменты.Количество() > 0 Тогда
			Имя = Выражения.Литерал(Сегменты[Сегменты.Количество() - 1]);
		Иначе
			Имя = Выражения.Литерал("curl_response");
		КонецЕсли;
	КонецЕсли;

	Если Имя = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Каталог = Результат.Каталог();
	Если Каталог <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.КаталогВывода()) <> Неопределено Тогда
		ИмяЛитеральное = Результат.Режим() = "remote_name"
			Или Результат.ИмяФайла() <> Неопределено И Результат.ИмяФайла().ЯвляетсяЛитералом();
		Если ИмяЛитеральное Тогда
			ЛитеральноеИмя = Сред(Имя, 2, СтрДлина(Имя) - 2);
			Если Каталог.ЯвляетсяЛитералом() Тогда
				ПутьКаталога = Каталог.ЛитеральноеЗначение();
				Разделитель = ?(
					СтрЗаканчиваетсяНа(ПутьКаталога, "/") Или СтрЗаканчиваетсяНа(ПутьКаталога, "\"),
					"",
					"/"
				);
				Имя = Выражения.Литерал(ПутьКаталога + Разделитель + ЛитеральноеИмя);
			Иначе
				Имя = Код.ПредставитьВыражение(Каталог) + " + " + Выражения.Литерал("/" + ЛитеральноеИмя);
			КонецЕсли;
		Иначе
			Имя = "ОбъединитьПути(" + Код.ПредставитьВыражение(Каталог) + ", " + Имя + ")";
		КонецЕсли;
	КонецЕсли;

	Если Результат.СоздаватьКаталоги()
		И Возможности.Найти(КодыВозможностейГенератораCURL.СозданиеКаталогов()) <> Неопределено Тогда
		ДобавитьСозданиеКаталога(Код, Результат, Имя, Выражения);
	КонецЕсли;

	Возврат Имя;

КонецФункции

Процедура ДобавитьСозданиеКаталога(Код, Результат, ИмяФайла, Выражения)

	Если Результат.Каталог() <> Неопределено Тогда
		Каталог = Код.ПредставитьВыражение(Результат.Каталог());
		Если Результат.Каталог().ЯвляетсяЛитералом() Тогда
			ПутьКаталога = Результат.Каталог().ЛитеральноеЗначение();
			Пока СтрДлина(ПутьКаталога) > 1
				И (СтрЗаканчиваетсяНа(ПутьКаталога, "/") Или СтрЗаканчиваетсяНа(ПутьКаталога, "\")) Цикл
				ПутьКаталога = Лев(ПутьКаталога, СтрДлина(ПутьКаталога) - 1);
			КонецЦикла;

			Каталог = Выражения.Литерал(ПутьКаталога);
		КонецЕсли;
	ИначеЕсли Результат.ИмяФайла().ЯвляетсяЛитералом() Тогда
		ЛитеральноеИмя = Сред(ИмяФайла, 2, СтрДлина(ИмяФайла) - 2);
		Позиция = Макс(СтрНайти(ЛитеральноеИмя, "/", НаправлениеПоиска.СКонца),
			СтрНайти(ЛитеральноеИмя, "\", НаправлениеПоиска.СКонца));
		Каталог = Выражения.Литерал(?(Позиция = 0, "", Лев(ЛитеральноеИмя, Позиция - 1)));
	Иначе
		Каталог = "Новый Файл(" + ИмяФайла + ").Путь";
	КонецЕсли;

	Код.ДобавитьСтроку("// Создание каталога по необходимости");
	Код.ДобавитьСтроку("Каталог = Новый Файл(%1);", Каталог);
	Код.ДобавитьСтроку("Если Не Каталог.Существует() Тогда");
	Код.ДобавитьСтроку("%1СоздатьКаталог(Каталог.ПолноеИмя);", Символы.Таб);
	Код.ДобавитьСтроку("КонецЕсли;");
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьОбработкуРезультата(Код, Результат, Параметры, Локализация)

	Если Результат.Режим() <> "file" И Результат.Режим() <> "remote_name"
		И Параметры.Получить("ДесериализоватьОтветИзJSON") = Истина Тогда
		Код.ДобавитьСтроку();
		Код.ДобавитьСтроку("// " + Локализация.ПолучитьРесурс("Комментарий.ДесериализацияJSON"));
		Код.ДобавитьСтроку("Поток = HTTPОтвет.ПолучитьТелоКакПоток();");
		Код.ДобавитьСтроку("ЧтениеJSON = Новый ЧтениеJSON();");
		Код.ДобавитьСтроку("ЧтениеJSON.ОткрытьПоток(Поток);");
		Код.ДобавитьСтроку("Результат = ПрочитатьJSON(ЧтениеJSON, Истина);");
		Код.ДобавитьСтроку("Поток.Закрыть();");
	КонецЕсли;

КонецПроцедуры

Функция АдресHTTP(Операция, Выражения)

	Адрес = Выражения.СтрокаДляРазбора(Операция.Ресурс().АдресДляВыполнения());
	
	ПозицияФрагмента = СтрНайти(Адрес, "#");
	Если ПозицияФрагмента > 0 Тогда
		Адрес = Лев(Адрес, ПозицияФрагмента - 1);
	КонецЕсли;

	НачалоУзла = СтрНайти(Адрес, "://");
	Если НачалоУзла > 0 Тогда
		Адрес = Сред(Адрес, НачалоУзла + 3);
	КонецЕсли;

	Позиция = СтрДлина(Адрес) + 1;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		НайденнаяПозиция = СтрНайти(Адрес, Разделитель);
		Если НайденнаяПозиция > 0 И НайденнаяПозиция < Позиция Тогда
			Позиция = НайденнаяПозиция;
		КонецЕсли;
	КонецЦикла;

	Если Позиция > СтрДлина(Адрес) Тогда
		Возврат "/";
	КонецЕсли;

	Возврат Сред(Адрес, Позиция);

КонецФункции

#КонецОбласти

#Использовать "../../../shared"
#Использовать "../../../../domain"

#Область СлужебныйПрограммныйИнтерфейс

// Подготавливает выражение имени файла, в который HTTP-соединение запишет ответ.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Результат - ОписаниеРезультатаCURL - Настройки результата операции.
//   URL - URL - Разобранный адрес запроса.
//   Выражения - ГенераторВыраженийCURL - Представление значений целевого кода.
//   Возможности - ФиксированныйМассив из Строка - Возможности генератора.
//
// Возвращаемое значение:
//   Строка - Выражение имени файла или пустая строка.
Функция ПодготовитьВыражениеИмениФайла(Код, Результат, URL, Выражения, Возможности) Экспорт

	Имя = Неопределено;
	ЛитеральноеИмя = Неопределено;

	Если (Результат.Режим() = "file" Или Результат.Режим() = "deferred")
		И Возможности.Найти(КодыВозможностейГенератораCURL.ВыводВФайл()) <> Неопределено Тогда
		Имя = Код.ПредставитьВыражение(Результат.ИмяФайла());
		Если Результат.ИмяФайла().ЯвляетсяЛитералом() Тогда
			ЛитеральноеИмя = Результат.ИмяФайла().ЛитеральноеЗначение();
		КонецЕсли;
	ИначеЕсли Результат.Режим() = "remote_name"
		И Возможности.Найти(КодыВозможностейГенератораCURL.ИмяФайлаИзURL()) <> Неопределено Тогда
		Сегменты = СтрРазделить(URL.КодированныйПуть(), "/", Ложь);
		Если Сегменты.Количество() > 0 Тогда
			ЛитеральноеИмя = Сегменты[Сегменты.Количество() - 1];
		Иначе
			ЛитеральноеИмя = "curl_response";
		КонецЕсли;

		Имя = Выражения.Литерал(ЛитеральноеИмя);
	КонецЕсли;

	Если Имя = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Каталог = Результат.Каталог();
	Если Каталог <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.КаталогВывода()) <> Неопределено Тогда
		Если ЛитеральноеИмя <> Неопределено И Каталог.ЯвляетсяЛитералом() Тогда
			ПутьКаталога = Каталог.ЛитеральноеЗначение();
			Разделитель = ?(
				ПутьКаталога = "" Или Прав(ПутьКаталога, 1) = "/" Или Прав(ПутьКаталога, 1) = "\",
				"",
				"/"
			);
			Имя = Выражения.Литерал(ПутьКаталога + Разделитель + ЛитеральноеИмя);
		Иначе
			Имя = Новый ФормированиеПутиФайлаCURL().Соединить(Код, Каталог, Имя, Выражения);
		КонецЕсли;
	КонецЕсли;

	Если Результат.СоздаватьКаталоги()
		И Возможности.Найти(КодыВозможностейГенератораCURL.СозданиеКаталогов()) <> Неопределено Тогда
		Код.ДобавитьСтроку("// {t(Создание каталога по необходимости)}");
		Имя = Новый ФормированиеПутиФайлаCURL().ДобавитьСозданиеКаталога(Код, Имя);
		Код.ДобавитьСтроку();
	КонецЕсли;

	Возврат Имя;

КонецФункции

// Добавляет код разбора тела ответа в JSON, если выбран соответствующий формат.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Результат - ОписаниеРезультатаCURL - Настройки результата операции.
//   ФорматДесериализацииОтвета - Строка, Неопределено - Формат десериализации HTTP-ответа.
Процедура ДобавитьДесериализациюJSON(Код, Результат, ФорматДесериализацииОтвета) Экспорт

	Если Результат.Режим() <> "file" И Результат.Режим() <> "remote_name"
		И ФорматДесериализацииОтвета = ФорматыДесериализацииОтветаCURL.JSON() Тогда
		Код.ДобавитьСтроку();
		Код.ДобавитьСтроку("// {t(Комментарий.ДесериализацияJSON)}");
		Код.ДобавитьСтроку("Поток = HTTPОтвет.ПолучитьТелоКакПоток();");
		Код.ДобавитьСтроку("ЧтениеJSON = Новый ЧтениеJSON();");
		Код.ДобавитьСтроку("ЧтениеJSON.ОткрытьПоток(Поток);");
		Код.ДобавитьСтроку("Результат = ПрочитатьJSON(ЧтениеJSON, Истина);");
		Код.ДобавитьСтроку("Поток.Закрыть();");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

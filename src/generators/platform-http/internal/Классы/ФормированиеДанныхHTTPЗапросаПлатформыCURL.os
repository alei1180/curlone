#Использовать "../../../shared"
#Использовать "../../../../domain"

#Область СлужебныйПрограммныйИнтерфейс

// Подготавливает компактное представление простого тела запроса.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Части - ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части тела.
//   Выражения - ГенераторВыраженийCURL - Представление значений целевого кода.
//
// Возвращаемое значение:
//   Структура - Признак тела, выражение, метод установки и признак заголовка.
Функция ПолучитьПростоеТело(Код, Части, Выражения) Экспорт

	Результат = Новый Структура("Есть, Выражение, МетодУстановки, ДобавитьТипСодержимого");
	Результат.Есть = Ложь;

	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЭтоЛитеральныйJSON(Части) Тогда
		ТекстJSON = "";
		Для Каждого Часть Из Части Цикл
			ТекстJSON = ТекстJSON + Часть.Текст();
		КонецЦикла;

		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(ТекстJSON);
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Ложь;

		Возврат Результат;
	КонецЕсли;

	Если Части.Количество() = 1 Тогда
		Часть = Части[0];
		Если Часть.ПутьКФайлу() <> Неопределено
			И (Часть.Вид() = ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла()
				Или Часть.Источник().УказанноеИмяОпции() = "--data-binary") Тогда
			Результат.Есть = Истина;
			Результат.Выражение = Выражения.Литерал(Часть.ПутьКФайлу());
			Результат.МетодУстановки = "УстановитьИмяФайлаТела";
			Результат.ДобавитьТипСодержимого = Часть.Вид() <> ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла();
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	МожноСформироватьСтроку = Истина;
	ВыраженияЧастей = Новый Массив;

	Для Каждого Элемент Из Части Цикл
		ИмяОпции = Элемент.Источник().УказанноеИмяОпции();
		МожноСформироватьСтроку = МожноСформироватьСтроку И Элемент.ПутьКФайлу() = Неопределено
			И ИмяОпции <> "--data-urlencode"
			И Элемент.Вид() <> ВидыЧастейТелаЗапросаCURL.ПолеMultipart();

		Если Элемент.Текст() <> Неопределено И СтрНайти(Элемент.Текст(), Символы.ПС) > 0 Тогда
			МожноСформироватьСтроку = Ложь;
		КонецЕсли;

		Если Не МожноСформироватьСтроку Тогда
			Прервать;
		КонецЕсли;

		Префикс = ?(ВыраженияЧастей.Количество() > 0 И Элемент.РазделительПеред() = "ampersand", "&", "");
		Если Элемент.Текст() = Неопределено Тогда
			Шаблон = Префикс + Выражения.СтрокаДляРазбора(Элемент.Выражение());
			Представление = Выражения.ПредставитьШаблон(Шаблон, Элемент.Выражение());
		Иначе
			Представление = Выражения.Литерал(Префикс + Элемент.Текст());
		КонецЕсли;

		ВыраженияЧастей.Добавить(Представление);
	КонецЦикла;

	Если МожноСформироватьСтроку Тогда
		Результат.Есть = Истина;
		Результат.Выражение = СтрСоединить(ВыраженияЧастей, " + ");
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьJSONФайл(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Ложь;
		Возврат Результат;
	КонецЕсли;

	Если ВсеЧастиКодируются(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "&");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьДвоичнаяЧасть(Части) Тогда
		ДобавитьДвоичноеТело(Код, Части, Выражения);
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзДвоичныхДанных";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если ЕстьТекстовыйФайл(Части) Или ЕстьПереводСтроки(Части) Тогда
		ДобавитьТекстовоеТело(Код, Части, Выражения, "&");
		Результат.Есть = Истина;
		Результат.Выражение = "ТелоЗапроса";
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
		Возврат Результат;
	КонецЕсли;

	Если Части.Количество() <> 1 Тогда
		Возврат Результат;
	КонецЕсли;

	Часть = Части[0];
	Если Часть.ПутьКФайлу() <> Неопределено
		И (Часть.Вид() = ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла()
			Или Часть.Источник().УказанноеИмяОпции() = "--data-binary") Тогда
		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(Часть.ПутьКФайлу());
		Результат.МетодУстановки = "УстановитьИмяФайлаТела";
		Результат.ДобавитьТипСодержимого = Часть.Вид() <> ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла();
	ИначеЕсли Часть.Текст() <> Неопределено
		И Часть.Вид() = ВидыЧастейТелаЗапросаCURL.Данные() Тогда
		Результат.Есть = Истина;
		Результат.Выражение = Выражения.Литерал(Часть.Текст());
		Результат.МетодУстановки = "УстановитьТелоИзСтроки";
		Результат.ДобавитьТипСодержимого = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьJSONФайл(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() <> "--json" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВсеЧастиКодируются(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Кодировать() <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЕстьДвоичнаяЧасть(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьТекстовыйФайл(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьПереводСтроки(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Текст() <> Неопределено И СтрНайти(Часть.Текст(), Символы.ПС) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Подготавливает адрес с параметрами строки запроса.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Части - ФиксированныйМассив из ЧастьСтрокиЗапросаCURL - Части строки запроса.
//   ИсходныйПуть - Строка - Путь ресурса до добавления параметров.
//   Выражения - ГенераторВыраженийCURL - Представление значений целевого кода.
//
// Возвращаемое значение:
//   Структура - Выражение адреса и код, который должен выполняться перед созданием запроса.
Функция ПодготовитьСтрокуЗапроса(Код, Части, ИсходныйПуть, Выражения) Экспорт

	Путь = ИсходныйПуть;

	Если Путь = "/" Тогда
		Путь = "";
	КонецЕсли;

	ЛитеральныеЧасти = Новый Массив;
	ФайловыеЧасти = Новый Массив;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерФайла = НомерФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
			Код.ДобавитьСтроку();
			ФайловыеЧасти.Добавить(Новый Структура("Часть, Выражение", Часть, ИмяПеременной));
		Иначе
			ЛитеральныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Если ЛитералСледуетПослеФайла(Части) Тогда
		Возврат СформироватьСтрокуЗапросаПоПорядку(Части, Путь, ФайловыеЧасти, Выражения);
	КонецЕсли;

	ЕстьЗнакВопроса = СтрНайти(Путь, "?") > 0;
	Для Каждого Часть Из ЛитеральныеЧасти Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Текст = Часть.Текст();
		Если Часть.Кодировать() = Истина Тогда
			Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		Путь = Путь + Префикс + Текст;
	КонецЦикла;

	Если ФайловыеЧасти.Количество() = 0 Тогда
		Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", Выражения.Литерал(Путь), "");
	КонецЕсли;

	Если ФайловыеЧасти.Количество() = 1 Тогда
		ФайловаяЧасть = ФайловыеЧасти[0];
		Часть = ФайловаяЧасть.Часть;
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		ВыражениеАдреса = Выражения.Литерал(Путь + Префикс) + " + " + ФайловаяЧасть.Выражение;

		Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", ВыражениеАдреса, "");
	КонецЕсли;

	СтрокиАдреса = Новый Массив;
	СтрокиАдреса.Добавить("АдресРесурса = " + Выражения.Литерал(Путь));
	Для Каждого ФайловаяЧасть Из ФайловыеЧасти Цикл
		Часть = ФайловаяЧасть.Часть;
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		СтрокиАдреса.Добавить(Символы.Таб + "+ " + Выражения.Литерал(Префикс)
			+ " + " + ФайловаяЧасть.Выражение);
	КонецЦикла;

	СтрокиАдреса[СтрокиАдреса.ВГраница()] = СтрокиАдреса[СтрокиАдреса.ВГраница()] + ";";
	КодАдреса = СтрСоединить(СтрокиАдреса, Символы.ПС);

	Возврат Новый Структура("ВыражениеАдреса, КодПередЗапросом", "АдресРесурса", КодАдреса);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьТекстовоеТело(Код, Части, Выражения, Разделитель)

	Файлы = Новый Соответствие;
	НомерФайла = 0;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
		Код.ДобавитьСтроку();
		Файлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	ЧастиВыражения = Новый Массив;
	НакопленныйТекст = "";
	Для Каждого Часть Из Части Цикл
		Если Файлы.Получить(Часть) <> Неопределено Тогда
			Если Не ПустаяСтрока(НакопленныйТекст) Тогда
				ЧастиВыражения.Добавить(Код.ПараметрВСтроку(НакопленныйТекст));
				НакопленныйТекст = "";
			КонецЕсли;

			ПрефиксФайла = ?(ЧастиВыражения.Количество() = 0, "", Разделитель);
			Если Часть.Кодировать() = Истина И Часть.ИмяПоля() <> Неопределено Тогда
				ПрефиксФайла = ПрефиксФайла + Часть.ИмяПоля() + "=";
			КонецЕсли;

			Если ПустаяСтрока(ПрефиксФайла) Тогда
				ЧастиВыражения.Добавить(Файлы[Часть]);
			Иначе
				ЧастиВыражения.Добавить(Код.ПараметрВСтроку(ПрефиксФайла) + " + " + Файлы[Часть]);
			КонецЕсли;

			Продолжить;
		КонецЕсли;

		Текст = Часть.Текст();
		Если Часть.Кодировать() = Истина Тогда
			Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			Если Часть.ИмяПоля() <> Неопределено Тогда
				Текст = Часть.ИмяПоля() + "=" + Текст;
			КонецЕсли;
		КонецЕсли;

		Если Не ПустаяСтрока(НакопленныйТекст) И Не ПустаяСтрока(Разделитель) Тогда
			НакопленныйТекст = НакопленныйТекст + Разделитель;
		КонецЕсли;

		НакопленныйТекст = НакопленныйТекст + Текст;
	КонецЦикла;

	Если Не ПустаяСтрока(НакопленныйТекст) Тогда
		ЧастиВыражения.Добавить(Код.ПараметрВСтроку(НакопленныйТекст));
	КонецЕсли;

	ДобавитьПрисваиваниеТела(Код, ЧастиВыражения, "");
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения)

	Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Выражения.Литерал(Часть.ПутьКФайлу()));
	Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);

	Если Часть.РежимИсточника() = РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL() Тогда
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ПС, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ВК, """");", ИмяПеременной);
	КонецЕсли;

	Если Часть.Кодировать() = Истина Тогда
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПрисваиваниеТела(Код, Части, Разделитель)

	Если Части.Количество() = 1 Тогда
		Код.ДобавитьСтроку("ТелоЗапроса = %1;", Части[0]);
		Возврат;
	КонецЕсли;

	Код.ДобавитьСтроку("ТелоЗапроса = %1", Части[0]);
	Для Индекс = 1 По Части.ВГраница() Цикл
		Префикс = ?(ПустаяСтрока(Разделитель), "", Код.ПараметрВСтроку(Разделитель) + " + ");
		Окончание = ?(Индекс = Части.ВГраница(), ";", "");
		Код.ДобавитьСтроку("%1+ %2%3", Символы.Таб, Префикс, Части[Индекс] + Окончание);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДвоичноеТело(Код, Части, Выражения)

	ТекстовыеФайлы = Новый Соответствие;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено
			Или Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной, Выражения);
		Код.ДобавитьСтроку();
		ТекстовыеФайлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	Код.ОбъявитьМассив("ЧастиТелаЗапроса");
	ТекстоваяГруппа = Новый Массив;
	ЕстьДобавленныеЧасти = Ложь;

	Для Каждого Часть Из Части Цикл
		ЭтоДвоичнаяЧасть = Часть.Источник().УказанноеИмяОпции() = "--data-binary";
		Если Не ЭтоДвоичнаяЧасть Тогда
			Если ТекстовыеФайлы.Получить(Часть) <> Неопределено Тогда
				ТекстоваяГруппа.Добавить(ТекстовыеФайлы[Часть]);
			ИначеЕсли Часть.Текст() <> Неопределено Тогда
				Для Каждого Фрагмент Из СтрРазделить(Часть.Текст(), "&", Ложь) Цикл
					ТекстоваяГруппа.Добавить(Код.ПараметрВСтроку(Фрагмент));
				КонецЦикла;
			Иначе
				ТекстоваяГруппа.Добавить(Код.ПредставитьВыражение(Часть.Выражение()));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТекстоваяГруппа.Количество() > 0 Тогда
			ЕстьДобавленныеЧасти = ДобавитьГруппуТекстовогоТела(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
			ТекстоваяГруппа = Новый Массив;
		КонецЕсли;

		Если ЕстьДобавленныеЧасти Тогда
			ДобавитьДвоичныйРазделитель(Код);
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Код.ДобавитьСтроку(
				"ЧастиТелаЗапроса.Добавить(Новый ДвоичныеДанные(%1));",
				Выражения.Литерал(Часть.ПутьКФайлу())
			);
		Иначе
			Код.ДобавитьСтроку(
				"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1, КодировкаТекста.UTF8, "
					+ "ИспользованиеByteOrderMark.НеИспользовать));",
				ПредставитьТекстЧастиПлатформы(Код, Часть, Выражения)
			);
		КонецЕсли;

		ЕстьДобавленныеЧасти = Истина;
	КонецЦикла;

	Если ТекстоваяГруппа.Количество() > 0 Тогда
		ДобавитьГруппуТекстовогоТела(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
	КонецЕсли;

	Код.ДобавитьСтроку("ТелоЗапроса = СоединитьДвоичныеДанные(ЧастиТелаЗапроса);");
	Код.ДобавитьСтроку();

КонецПроцедуры

Функция ДобавитьГруппуТекстовогоТела(Код, Выражения, ЕстьДобавленныеЧасти)

	Если ЕстьДобавленныеЧасти Тогда
		ДобавитьДвоичныйРазделитель(Код);
	КонецЕсли;

	Выражение = Выражения[0];
	Для Индекс = 1 По Выражения.ВГраница() Цикл
		СледующееВыражение = Выражения[Индекс];
		Если СтрНачинаетсяС(СледующееВыражение, """") Тогда
			СледующееВыражение = Лев(СледующееВыражение, 1) + "&" + Сред(СледующееВыражение, 2);
		Иначе
			СледующееВыражение = """&"" + " + СледующееВыражение;
		КонецЕсли;

		Выражение = Выражение + Символы.ПС + Символы.Таб + "+ " + СледующееВыражение;
	КонецЦикла;

	Код.ДобавитьСтроку(
		"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1,%2КодировкаТекста.UTF8,%2"
			+ "ИспользованиеByteOrderMark.НеИспользовать));",
		Выражение,
		Символы.ПС + Символы.Таб
	);

	Возврат Истина;

КонецФункции

Процедура ДобавитьДвоичныйРазделитель(Код)

	Код.ДобавитьСтроку(
		"ЧастиТелаЗапроса.Добавить(ПолучитьДвоичныеДанныеИзСтроки(""&"", КодировкаТекста.UTF8, "
			+ "ИспользованиеByteOrderMark.НеИспользовать));"
	);

КонецПроцедуры

Функция ПредставитьТекстЧастиПлатформы(Код, Часть, Выражения)

	Если Часть.Текст() <> Неопределено Тогда
		Возврат Код.ПараметрВСтроку(Часть.Текст());
	КонецЕсли;

	Возврат Код.ПредставитьВыражение(Часть.Выражение());

КонецФункции

Функция ЭтоЛитеральныйJSON(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() <> "--json" Или Часть.Текст() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЛитералСледуетПослеФайла(Части)

	ФайлНайден = Ложь;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			ФайлНайден = Истина;
		ИначеЕсли ФайлНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СформироватьСтрокуЗапросаПоПорядку(Части, Путь, ФайловыеЧасти, Выражения)

	Строки = Новый Массив;
	Строки.Добавить("АдресРесурса = " + Выражения.Литерал(Путь) + ";");
	ЕстьЗнакВопроса = СтрНайти(Путь, "?") > 0;
	ИндексФайла = 0;

	Для Каждого Часть Из Части Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Выражение = ФайловыеЧасти[ИндексФайла].Выражение;
			ИндексФайла = ИндексФайла + 1;
			Строки.Добавить("АдресРесурса = АдресРесурса + " + Выражения.Литерал(Префикс)
				+ " + " + Выражение + ";");
		Иначе
			Текст = Часть.Текст();
			Если Часть.Кодировать() = Истина Тогда
				Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			КонецЕсли;

			Строки.Добавить("АдресРесурса = АдресРесурса + " + Выражения.Литерал(Префикс + Текст) + ";");
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура(
		"ВыражениеАдреса, КодПередЗапросом",
		"АдресРесурса",
		СтрСоединить(Строки, Символы.ПС)
	);

КонецФункции

#КонецОбласти

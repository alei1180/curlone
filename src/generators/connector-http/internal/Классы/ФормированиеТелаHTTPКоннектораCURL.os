#Использовать "../../../../domain"

Перем _Выражения; // ГенераторВыраженийCURL
Перем _Локализация; // ЛокализацияКодаCURL

#Область ОбработчикиСобытий

// Создаёт формирователь тела запроса для библиотеки Коннектор HTTP.
//
// Параметры:
//   Выражения - ГенераторВыраженийCURL - Формирователь выражений целевого кода.
//   Локализация - ЛокализацияКодаCURL - Локализация ключей целевого кода.
Процедура ПриСозданииОбъекта(Выражения, Локализация)

	_Выражения = Выражения;
	_Локализация = Локализация;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет код тела HTTP-запроса.
//
// Параметры:
//   Код - ПостроительКодаCURL - Построитель целевого кода.
//   ПодготовленнаяОперация - Структура - Операция и подготовленные части запроса.
//
// Возвращаемое значение:
//   Структура - Поля Выражение, JSON и Файлы с описанием сформированного тела.

Функция Сформировать(Код, ПодготовленнаяОперация) Экспорт

	Если ЕстьСоставнаяФорма(ПодготовленнаяОперация.ЧастиТела) Тогда
		Возврат ДобавитьСоставнуюФорму(Код, ПодготовленнаяОперация.ЧастиТела);
	КонецЕсли;

	Возврат ДобавитьПростоеТело(
		Код,
		ПодготовленнаяОперация.ЧастиТела,
		ПодготовленнаяОперация.Заголовки
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьСоставнаяФорма(Части)

	Для Каждого Часть Из Части Цикл
		ИмяОпции = Часть.Источник().УказанноеИмяОпции();
		Если Часть.Вид() = ВидыЧастейТелаЗапросаCURL.ПолеMultipart()
			Или ИмяОпции = "-F" Или ИмяОпции = "--form"
			Или ИмяОпции = "--form-string" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДобавитьСоставнуюФорму(Код, Части)

	Результат = Новый Структура("Выражение, JSON, Файлы", "", Ложь, Ложь);
	Поля = Новый Соответствие;
	КоличествоТекстовыхФайлов = 0;

	Для Каждого Часть Из Части Цикл
		Если ЭтоТекстовыйФайлФормы(Часть) Тогда
			КоличествоТекстовыхФайлов = КоличествоТекстовыхФайлов + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(КоличествоТекстовыхФайлов);
			ИмяПоля = ПредставитьИмяПоля(Часть);

			Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", ПредставитьПутьФормы(Часть));
			Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);
			Код.ДобавитьСтроку();

			ДобавитьПолеФормы(Поля, ПредставитьИмяПоля(Часть), ИмяПеременной);
		ИначеЕсли Не ЭтоДвоичныйФайлФормы(Часть) Тогда
			ДобавитьПолеФормы(Поля, ПредставитьИмяПоля(Часть), ПредставитьЗначениеПоля(Код, Часть));
		КонецЕсли;
	КонецЦикла;

	Если Поля.Количество() > 0 Тогда
		ДобавитьПоляФормы(Код, Поля);
		Результат.Выражение = "Данные";
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если Не ЭтоДвоичныйФайлФормы(Часть) Тогда
			Продолжить;
		КонецЕсли;

		Если Не Результат.Файлы Тогда
			Код.ОбъявитьМассив("Файлы");
			Результат.Файлы = Истина;
		КонецЕсли;

		ДобавитьФайлФормы(Код, Часть);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьПолеФормы(Поля, Имя, Значение)

	Значения = Поля.Получить(Имя);

	Если Значения = Неопределено Тогда
		Значения = Новый Массив;
		Поля.Вставить(Имя, Значения);
	КонецЕсли;

	Значения.Добавить(Значение);

КонецПроцедуры

Процедура ДобавитьПоляФормы(Код, Поля)

	Код.ОбъявитьСоответствие("Данные");

	Для Каждого Элемент Из Поля Цикл
		Если Элемент.Значение.Количество() = 1 Тогда
			Код.ВставитьВСоответствие("Данные", Элемент.Ключ, Элемент.Значение[0]);
		Иначе
			Код.ВставитьВСоответствие("Данные", Элемент.Ключ, "Новый Массив()");
			Для Каждого Значение Из Элемент.Значение Цикл
				Код.ДобавитьСтроку("Данные[%1].Добавить(%2);", Элемент.Ключ, Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьФайлФормы(Код, Часть)

	Код.ДобавитьСтроку("Файл = Новый Структура();");
	Код.ДобавитьСтроку("Файл.Вставить(%1, %2);", Ключ("Файл.Имя"), ПредставитьИмяПоля(Часть));
	Код.ДобавитьСтроку("Файл.Вставить(%1, %2);", Ключ("Файл.ИмяФайла"), ПредставитьИмяФайлаФормы(Часть));
	Код.ДобавитьСтроку(
		"Файл.Вставить(%1, Новый ДвоичныеДанные(%2));",
		Ключ("Файл.Данные"),
		ПредставитьПутьФормы(Часть)
	);

	ТипСодержимого = Часть.MIMEТип();
	Если ТипСодержимого <> Неопределено И СтрНайти(ТипСодержимого, ",@") > 0 Тогда
		ТипСодержимого = Неопределено;
	КонецЕсли;

	Если ТипСодержимого = Неопределено И Часть.ИмяФайла() <> Неопределено Тогда
		ТипСодержимого = ТипСодержимогоПоИмени(Часть.ИмяФайла());
	КонецЕсли;

	Если ТипСодержимого <> Неопределено Тогда
		Код.ДобавитьСтроку("Файл.Вставить(%1, %2);", Ключ("Файл.Тип"), Литерал(ТипСодержимого));
	Иначе
		ПредставлениеТипа = ПредставитьТипФормы(Часть);
		Если Не ПустаяСтрока(ПредставлениеТипа) Тогда
			Код.ДобавитьСтроку("Файл.Вставить(%1, %2);", Ключ("Файл.Тип"), ПредставлениеТипа);
		КонецЕсли;
	КонецЕсли;

	Если Часть.Заголовки().Количество() > 0 Тогда
		Код.ДобавитьСтроку("Файл.Вставить(%1, Новый Соответствие());", Ключ("Файл.Заголовки"));
		Для Каждого Заголовок Из Часть.Заголовки() Цикл
			Если Заголовок.Имя() <> Неопределено И Заголовок.Значение() <> Неопределено Тогда
				Код.ДобавитьСтроку(
					"Файл.Заголовки.Вставить(%1, %2);",
					Литерал(Заголовок.Имя()),
					Литерал(СокрЛП(Заголовок.Значение()))
				);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Код.ДобавитьСтроку("Файлы.Добавить(Файл);");
	Код.ДобавитьСтроку();

КонецПроцедуры

Функция ПредставитьИмяПоля(Часть)

	Если Часть.ИмяПоля() <> Неопределено Тогда
		Возврат Литерал(Часть.ИмяПоля());
	КонецЕсли;

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, "=");

	Возврат _Выражения.ПредставитьШаблон(Лев(Шаблон, Позиция - 1), Часть.Выражение());

КонецФункции

Функция ПредставитьЗначениеПоля(Код, Часть)

	Если Часть.Текст() <> Неопределено Тогда
		Возврат Код.ПараметрВСтроку(Часть.Текст());
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(ОсновноеЗначениеФормы(Часть), Часть.Выражение());

КонецФункции

Функция ЭтоДвоичныйФайлФормы(Часть)

	Если Часть.Источник().УказанноеИмяОпции() = "--form-string" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.ИмяФайла() <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Значение = ОсновноеЗначениеФормы(Часть);

	Возврат СтрНачинаетсяС(Значение, "@");

КонецФункции

Функция ЭтоТекстовыйФайлФормы(Часть)

	Если Часть.Источник().УказанноеИмяОпции() = "--form-string" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.ПутьКФайлу() <> Неопределено И Часть.ИмяФайла() = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Значение = ОсновноеЗначениеФормы(Часть);

	Возврат СтрНачинаетсяС(Значение, "<");

КонецФункции

Функция ОсновноеЗначениеФормы(Часть)

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, "=");
	Значение = Сред(Шаблон, Позиция + 1);
	ПозицияПараметров = СтрНайти(Значение, ";");

	Возврат ?(ПозицияПараметров = 0, Значение, Лев(Значение, ПозицияПараметров - 1));

КонецФункции

Функция ПредставитьПутьФормы(Часть)

	Если Часть.ПутьКФайлу() <> Неопределено Тогда
		Возврат Литерал(Часть.ПутьКФайлу());
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(Сред(ОсновноеЗначениеФормы(Часть), 2), Часть.Выражение());

КонецФункции

Функция ПредставитьИмяФайлаФормы(Часть)

	Если Часть.ИмяФайла() <> Неопределено Тогда
		Возврат Литерал(Часть.ИмяФайла());
	КонецЕсли;

	Возврат ПредставитьПутьФормы(Часть);

КонецФункции

Функция ПредставитьТипФормы(Часть)

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, ";type=");

	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Тип = Сред(Шаблон, Позиция + 6);
	КонецТипа = СтрНайти(Тип, ";");
	Если КонецТипа > 0 Тогда
		Тип = Лев(Тип, КонецТипа - 1);
	КонецЕсли;

	Если СтрНайти(Тип, ",@") > 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(Тип, Часть.Выражение());

КонецФункции

Функция ТипСодержимогоПоИмени(ИмяФайла)

	Расширение = НРег(Прав(ИмяФайла, СтрДлина(ИмяФайла) - СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца)));
	Если Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "html" Или Расширение = "htm" Тогда
		Возврат "text/html";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ДобавитьПростоеТело(Код, Части, Заголовки)

	Результат = Новый Структура("Выражение, JSON, Файлы", "", Ложь, Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЭтоJSON(Части, Заголовки) И ЕстьФайлы(Части) Тогда
		ДобавитьJSONИзЧастей(Код, Части);
		Результат.Выражение = "Данные";
		Возврат Результат;
	КонецЕсли;

	Если ТребуетсяСтрокаКодированныхДанных(Части) Тогда
		ДобавитьКодированныеДанные(Код, Части);
		Результат.Выражение = "Данные";
		Возврат Результат;
	КонецЕсли;

	Если ЕстьДвоичныеФайлы(Части) Тогда
		ДобавитьДвоичныеДанные(Код, Части);
		Результат.Выражение = "Данные";
		Возврат Результат;
	КонецЕсли;

	Если ЭтоJSON(Части, Заголовки) Тогда
		ТекстJSON = "";
		Для Каждого Часть Из Части Цикл
			ТекстJSON = ТекстJSON + Часть.Текст();
		КонецЦикла;

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		ДанныеJSON = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();

		Если ТипЗнч(ДанныеJSON) = Тип("Соответствие") Или ТипЗнч(ДанныеJSON) = Тип("Массив") Тогда
			Код.ДобавитьКоллекцию("Данные", ДанныеJSON);
		Иначе
			Возврат Результат;
		КонецЕсли;

		Код.ДобавитьСтроку();
		Результат.JSON = Истина;

		Возврат Результат;
	КонецЕсли;

	Если Части.Количество() = 1 Тогда
		Часть = Части[0];
		Если Часть.Вид() = ВидыЧастейТелаЗапросаCURL.ЗагрузкаФайла()
			И Часть.ПутьКФайлу() <> Неопределено Тогда
			Код.ДобавитьСтроку("Данные = Новый ДвоичныеДанные(%1);", Литерал(Часть.ПутьКФайлу()));
			Результат.Выражение = "Данные";
			Возврат Результат;
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, "ТекстовыеДанныеФайла_1");
			Код.ДобавитьСтроку();
			Результат.Выражение = "ТекстовыеДанныеФайла_1";
			Возврат Результат;
		КонецЕсли;

		ИмяОпции = Часть.Источник().УказанноеИмяОпции();
		Если (ИмяОпции = "--data-raw" Или ИмяОпции = "--data-binary") И Часть.Текст() <> Неопределено Тогда
			Результат.Выражение = Литерал(Часть.Текст());
			Возврат Результат;
		КонецЕсли;

		Если Часть.Текст() = Неопределено
			И СтрНайти(_Выражения.СтрокаДляРазбора(Часть.Выражение()), "=") = 0 Тогда
			Результат.Выражение = Код.ПредставитьВыражение(Часть.Выражение());
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если Не ВсеЧастиМожноПредставитьСоответствием(Части) Тогда
		ДобавитьСоставнуюСтрокуДанных(Код, Части);
		Результат.Выражение = "Данные";
		Возврат Результат;
	КонецЕсли;

	ПодготовленныеФайлы = Новый Соответствие;
	НомерТекстовогоФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Не ПустаяСтрока(Часть.ИмяПоля()) И Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерТекстовогоФайла = НомерТекстовогоФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерТекстовогоФайла);
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной);
			Код.ДобавитьСтроку();
			ПодготовленныеФайлы.Вставить(Часть, ИмяПеременной);
		КонецЕсли;
	КонецЦикла;

	Код.ОбъявитьСоответствие("Данные");
	Для Каждого Часть Из Части Цикл
		Если ПодготовленныеФайлы.Получить(Часть) <> Неопределено Тогда
			Код.ВставитьВСоответствие("Данные", Литерал(Часть.ИмяПоля()), ПодготовленныеФайлы[Часть]);
			Продолжить;
		КонецЕсли;

		Если Не ПустаяСтрока(Часть.ИмяПоля()) И Часть.Текст() <> Неопределено Тогда
			Код.ВставитьВСоответствие("Данные", Литерал(Часть.ИмяПоля()), Литерал(Часть.Текст()));
			Продолжить;
		КонецЕсли;

		Если Часть.Текст() = Неопределено Тогда
			Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
			ПозицияРавно = СтрНайти(Шаблон, "=");
			Код.ВставитьВСоответствие(
				"Данные",
				_Выражения.ПредставитьШаблон(Лев(Шаблон, ПозицияРавно - 1), Часть.Выражение()),
				_Выражения.ПредставитьШаблон(Сред(Шаблон, ПозицияРавно + 1), Часть.Выражение())
			);
			Продолжить;
		КонецЕсли;

		Для Каждого Пара Из СтрРазделить(Часть.Текст(), "&", Истина) Цикл
			ПозицияРавно = СтрНайти(Пара, "=");
			Имя = Лев(Пара, ПозицияРавно - 1);
			Значение = Сред(Пара, ПозицияРавно + 1);
			ИмяОпции = Часть.Источник().УказанноеИмяОпции();

			Если ИмяОпции <> "--data-urlencode" Тогда
				Имя = КодированиеURL.ДекодироватьПараметрФормы(Имя);
				Значение = КодированиеURL.ДекодироватьПараметрФормы(Значение);
			КонецЕсли;

			Код.ВставитьВСоответствие("Данные", Литерал(Имя), Литерал(Значение));
		КонецЦикла;
	КонецЦикла;

	Код.ДобавитьСтроку();

	Результат.Выражение = "Данные";

	Возврат Результат;

КонецФункции

Процедура ДобавитьСоставнуюСтрокуДанных(Код, Части)

	Выражения = Новый Массив;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерФайла = НомерФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной);
			Код.ДобавитьСтроку();
			Выражения.Добавить(ИмяПеременной);
		Иначе
			Выражения.Добавить(ПредставитьТекстЧасти(Код, Часть));
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСоставноеВыражение("Данные", Выражения, "&");
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной)

	Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Литерал(Часть.ПутьКФайлу()));
	Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);

	Если Часть.РежимИсточника() = РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL() Тогда
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ПС, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ВК, """");", ИмяПеременной);
	КонецЕсли;

	Если Часть.Кодировать() = Истина Тогда
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
	КонецЕсли;

КонецПроцедуры

Функция ЕстьФайлы(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЕстьДвоичныеФайлы(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено
			И Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТребуетсяСтрокаКодированныхДанных(Части)

	ТребуетсяСтрока = Ложь;
	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() <> "--data-urlencode" Тогда
			Возврат Ложь;
		КонецЕсли;

		ТребуетсяСтрока = ТребуетсяСтрока Или Часть.ПутьКФайлу() <> Неопределено
			Или ПустаяСтрока(Часть.ИмяПоля());
	КонецЦикла;

	Возврат ТребуетсяСтрока;

КонецФункции

Процедура ДобавитьJSONИзЧастей(Код, Части)

	Выражения = Новый Массив;
	НомерФайла = 0;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерФайла = НомерФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
			Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Литерал(Часть.ПутьКФайлу()));
			Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);
			Код.ДобавитьСтроку();
			Выражения.Добавить(ИмяПеременной);
		Иначе
			Выражения.Добавить(ПредставитьТекстЧасти(Код, Часть));
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСоставноеВыражение("Данные", Выражения);
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьКодированныеДанные(Код, Части)

	Выражения = Новый Массив;
	ЛитеральнаяЧасть = "";
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено Тогда
			Текст = Часть.Текст();
			Если Не ПустаяСтрока(Часть.ИмяПоля()) Тогда
				Текст = Часть.ИмяПоля() + "=" + Текст;
			ИначеЕсли СтрНачинаетсяС(Часть.Выражение().ЛитеральноеЗначение(), "=") Тогда
				Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			КонецЕсли;

			ЛитеральнаяЧасть = ЛитеральнаяЧасть + ?(ПустаяСтрока(ЛитеральнаяЧасть), "", "&") + Текст;
			Продолжить;
		КонецЕсли;

		Если Не ПустаяСтрока(ЛитеральнаяЧасть) Тогда
			Выражения.Добавить(Литерал(ЛитеральнаяЧасть));
			ЛитеральнаяЧасть = "";
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);

		Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Литерал(Часть.ПутьКФайлу()));
		Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
		Код.ДобавитьСтроку();

		Префикс = ?(Часть.ИмяПоля() = Неопределено, "", Часть.ИмяПоля() + "=");
		Если Выражения.Количество() > 0 Тогда
			Префикс = "&" + Префикс;
		КонецЕсли;

		Выражения.Добавить(?(ПустаяСтрока(Префикс), "", Литерал(Префикс) + " + ") + ИмяПеременной);
	КонецЦикла;

	Если Не ПустаяСтрока(ЛитеральнаяЧасть) Тогда
		Выражения.Добавить(Литерал(ЛитеральнаяЧасть));
	КонецЕсли;

	Код.ДобавитьСоставноеВыражение("Данные", Выражения);
	Код.ДобавитьСтроку();

КонецПроцедуры

Процедура ДобавитьДвоичныеДанные(Код, Части)

	Если Части.Количество() = 1 Тогда
		Код.ДобавитьСтроку("Данные = Новый ДвоичныеДанные(%1);", Литерал(Части[0].ПутьКФайлу()));
		Код.ДобавитьСтроку();
		Возврат;
	КонецЕсли;

	ТекстовыеФайлы = Новый Соответствие;
	НомерФайла = 0;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено
			Или Часть.Источник().УказанноеИмяОпции() = "--data-binary" Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной);

		Код.ДобавитьСтроку();

		ТекстовыеФайлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	Код.ОбъявитьМассив("ЧастиДанных");
	ТекстоваяГруппа = Новый Массив;
	ЕстьДобавленныеЧасти = Ложь;

	Для Каждого Часть Из Части Цикл
		ЭтоДвоичнаяЧасть = Часть.Источник().УказанноеИмяОпции() = "--data-binary";

		Если Не ЭтоДвоичнаяЧасть Тогда
			Если ТекстовыеФайлы.Получить(Часть) <> Неопределено Тогда
				ТекстоваяГруппа.Добавить(ТекстовыеФайлы[Часть]);
			ИначеЕсли Часть.Текст() <> Неопределено Тогда
				Для Каждого Фрагмент Из СтрРазделить(Часть.Текст(), "&", Ложь) Цикл
					ТекстоваяГруппа.Добавить(Код.ПараметрВСтроку(Фрагмент));
				КонецЦикла;
			Иначе
				ТекстоваяГруппа.Добавить(Код.ПредставитьВыражение(Часть.Выражение()));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТекстоваяГруппа.Количество() > 0 Тогда
			ЕстьДобавленныеЧасти = ДобавитьГруппуТекстовыхДанных(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
			ТекстоваяГруппа = Новый Массив;
		КонецЕсли;

		Если ЕстьДобавленныеЧасти Тогда
			ДобавитьРазделительДвоичныхДанных(Код);
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Код.ДобавитьСтроку(
				"ЧастиДанных.Добавить(Новый ДвоичныеДанные(%1));",
				Литерал(Часть.ПутьКФайлу())
			);
		Иначе
			Код.ДобавитьСтроку(
				"ЧастиДанных.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1, КодировкаТекста.UTF8, "
					+ "ИспользованиеByteOrderMark.НеИспользовать));",
				ПредставитьТекстЧасти(Код, Часть)
			);
		КонецЕсли;

		ЕстьДобавленныеЧасти = Истина;
	КонецЦикла;

	Если ТекстоваяГруппа.Количество() > 0 Тогда
		ДобавитьГруппуТекстовыхДанных(Код, ТекстоваяГруппа, ЕстьДобавленныеЧасти);
	КонецЕсли;

	Код.ДобавитьСтроку("Данные = СоединитьДвоичныеДанные(ЧастиДанных);");
	Код.ДобавитьСтроку();

КонецПроцедуры

Функция ДобавитьГруппуТекстовыхДанных(Код, Выражения, ЕстьДобавленныеЧасти)

	Если ЕстьДобавленныеЧасти Тогда
		ДобавитьРазделительДвоичныхДанных(Код);
	КонецЕсли;

	Выражение = Выражения[0];
	Для Индекс = 1 По Выражения.ВГраница() Цикл
		СледующееВыражение = Выражения[Индекс];
		Если СтрНачинаетсяС(СледующееВыражение, """") Тогда
			СледующееВыражение = Лев(СледующееВыражение, 1) + "&" + Сред(СледующееВыражение, 2);
		Иначе
			СледующееВыражение = Литерал("&") + " + " + СледующееВыражение;
		КонецЕсли;

		Выражение = Выражение + Символы.ПС + Символы.Таб + "+ " + СледующееВыражение;
	КонецЦикла;

	Код.ДобавитьСтроку(
		"ЧастиДанных.Добавить(ПолучитьДвоичныеДанныеИзСтроки(%1,%2КодировкаТекста.UTF8,%2"
			+ "ИспользованиеByteOrderMark.НеИспользовать));",
		Выражение,
		Символы.ПС + Символы.Таб
	);

	Возврат Истина;

КонецФункции

Процедура ДобавитьРазделительДвоичныхДанных(Код)

	Код.ДобавитьСтроку(
		"ЧастиДанных.Добавить(ПолучитьДвоичныеДанныеИзСтроки(""&"", КодировкаТекста.UTF8, "
			+ "ИспользованиеByteOrderMark.НеИспользовать));"
	);

КонецПроцедуры

Функция ПредставитьТекстЧасти(Код, Часть)

	Если Часть.Текст() <> Неопределено Тогда
		Возврат Код.ПараметрВСтроку(Часть.Текст());
	КонецЕсли;

	Возврат Код.ПредставитьВыражение(Часть.Выражение());

КонецФункции

Функция ЭтоJSON(Части, Заголовки)

	Для Каждого Часть Из Части Цикл
		Если Часть.Источник().УказанноеИмяОпции() = "--json" Тогда
			Продолжить;
		КонецЕсли;

		Если Часть.Текст() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Заголовок = Заголовки.Получить("content-type");
		Если Заголовок = Неопределено Или НРег(СокрЛП(Заголовок.Значение)) <> "application/json" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ВсеЧастиМожноПредставитьСоответствием(Части)

	Для Каждого Часть Из Части Цикл
		ИмяОпции = Часть.Источник().УказанноеИмяОпции();
		Если Часть.Вид() <> ВидыЧастейТелаЗапросаCURL.Данные()
			И ИмяОпции <> "-d" И ИмяОпции <> "--data"
			И ИмяОпции <> "--data-ascii" И ИмяОпции <> "--data-urlencode" Тогда
			Возврат Ложь;
		КонецЕсли;

		Если ИмяОпции = "--data-raw" Или ИмяОпции = "--data-binary" Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Не ПустаяСтрока(Часть.ИмяПоля()) И Часть.ПутьКФайлу() <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Часть.Текст() = Неопределено Тогда
			Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
			Если СтрНайти(Шаблон, "=") = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Не ПустаяСтрока(Часть.ИмяПоля()) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Пара Из СтрРазделить(Часть.Текст(), "&", Истина) Цикл
			Если СтрНайти(Пара, "=") = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция Ключ(Имя)
	Возврат Литерал(_Локализация.ПолучитьРесурс("Параметр." + Имя));
КонецФункции

Функция Литерал(Значение)
	Возврат _Выражения.Литерал(?(Значение = Неопределено, "", Значение));
КонецФункции

#КонецОбласти

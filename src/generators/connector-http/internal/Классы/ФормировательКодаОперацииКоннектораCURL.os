#Использовать i18n
#Использовать url
#Использовать "../../../shared"
#Использовать "../../../../domain"

Перем _Возможности; // ФиксированныйМассив из Строка
Перем _Выражения; // ГенераторВыраженийCURL
Перем _Локализация; // ЛокализацияКодаCURL
Перем _ИменаПеременных; // Соответствие из КлючИЗначение

#Область ПрограммныйИнтерфейс

// Формирует код одной операции для библиотеки Коннектор HTTP.
// Объект создаётся отдельно для каждой операции и не используется совместно потоками.
//
// Параметры:
//   ПодготовленнаяОперация - Структура - Модель операции, заголовки и части данных.
//   Локаль - Строка - Поддерживаемая локаль из модуля ЛокалиКонвертацииCURL.
//   ФорматДесериализацииОтвета - Строка, Неопределено - Формат десериализации HTTP-ответа.
//   Возможности - ФиксированныйМассив из Строка - Снимок возможностей.
//
// Возвращаемое значение:
//   Строка - Код одной HTTP-операции.
//
// Исключения:
//   Исключение - Ресурсы локализации недоступны.
Функция СформироватьКод(ПодготовленнаяОперация, Локаль, ФорматДесериализацииОтвета, Возможности) Экспорт

	_Возможности = Возможности;
	_ИменаПеременных = Новый Соответствие;
	_Выражения = Новый ГенераторВыраженийCURL(ЛокалиКонвертацииCURL.Русская(), _ИменаПеременных);
	_Локализация = Новый ЛокализацияКодаCURL(
		Локаль,
		"ГенераторПрограммногоКодаКоннекторHTTP"
	);

	Операция = ПодготовленнаяОперация.Операция;
	ВыражениеURL = Операция.Ресурс().ИсходныйАдрес();
	URL = Новый URL(_Выражения.СтрокаДляРазбора(Операция.Ресурс().АдресДляВыполнения()));

	Если Не Есть(КодыВозможностейГенератораCURL.ДляПротокола(URL.Схема())) Тогда
		Возврат "";
	КонецЕсли;

	Если ПоддерживаютсяТолькоБазовыеОперации(Возможности) Тогда
		Возврат СформироватьБазовуюОперацию(Операция, URL);
	КонецЕсли;

	Код = Новый ПостроительКодаCURL(_Выражения);
	ФормированиеТела = Новый ФормированиеТелаHTTPКоннектораCURL(
		_Выражения,
		_Локализация
	);
	Тело = ФормированиеТела.Сформировать(Код, ПодготовленнаяОперация);
	ПараметрыURL = ДобавитьПараметрыURL(
		Код,
		URL,
		ВыражениеURL,
		ПодготовленнаяОперация.ЧастиСтрокиЗапроса,
		Возможности,
		Операция
	);
	ЕстьЗаголовки = ДобавитьЗаголовкиОперации(Код, ПодготовленнаяОперация);
	ЕстьАутентификация = ДобавитьАутентификацию(Код, Операция.Запрос().Аутентификация());
	ЕстьПрокси = ДобавитьПодготовкуПрокси(Код, Операция.Соединение().Прокси(), URL.Схема());
	Вызов = ПодготовитьВызов(
		Операция,
		URL,
		ВыражениеURL,
		ПараметрыURL,
		Тело,
		ФорматДесериализацииОтвета
	);
	
	ДобавитьДополнительныеПараметры(
		Код,
		Операция,
		ПараметрыURL,
		Тело,
		Вызов,
		ЕстьЗаголовки,
		ЕстьАутентификация,
		ЕстьПрокси
	);
	
	ДобавитьВызовКоннектора(Код, Вызов, Операция.Результат(), URL);

	Результат = ДобавитьОбъявленияПеременных(Код.ПолучитьРезультат());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


Функция ДобавитьЗаголовкиОперации(Код, ПодготовленнаяОперация)

	ЕстьЗаголовки = ПодготовленнаяОперация.Заголовки.Количество() > 0;
	Если Не ЕстьЗаголовки Тогда
		Возврат Ложь;
	КонецЕсли;

	Код.ОбъявитьСоответствие("Заголовки");
	ДобавитьЗаголовки(
		Код,
		ПодготовленнаяОперация.Заголовки,
		ПодготовленнаяОперация.Операция.Запрос().Аутентификация()
	);
	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Функция ПодготовитьВызов(Операция, URL, ВыражениеURL, ПараметрыURL, Тело, ФорматДесериализацииОтвета)

	ОписаниеМетода = ОпределитьМетод(Операция, URL);
	ДинамическийМетод = ОписаниеМетода.Динамический;
	ИмяМетода = ?(
		ДинамическийМетод,
		"ВызватьМетод",
		ИмяМетодаКоннектора(ОписаниеМетода.Значение, ФорматДесериализацииОтвета)
	);
	ПараметрыВызова = СформироватьПараметрыВызова(
		Операция,
		URL,
		ВыражениеURL,
		ПараметрыURL,
		Тело.Выражение,
		ОписаниеМетода
	);

	Возврат Новый Структура(
		"Метод, ДинамическийМетод, ИмяМетода, ПараметрыВызова",
		ОписаниеМетода.Значение,
		ДинамическийМетод,
		ИмяМетода,
		ПараметрыВызова
	);

КонецФункции

Функция ОпределитьМетод(Операция, URL)

	Метод = Операция.Запрос().МетодПоУмолчанию();
	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = ?(
			URL.Схема() = ПротоколыCURL.HTTP() Или URL.Схема() = ПротоколыCURL.HTTPS(),
			МетодыЗапросаПоУмолчаниюCURL.GET(),
			Метод
		);
	КонецЕсли;

	Если Метод = МетодыЗапросаПоУмолчаниюCURL.HEAD()
		И Не Есть(КодыВозможностейГенератораCURL.ТолькоМетаданные()) Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Выражение = Операция.Запрос().ЯвныйМетод();
	Если Выражение = Неопределено Или Не Есть(КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса()) Тогда
		Возврат Новый Структура("Значение, Динамический, Выражение", Метод, Ложь, Неопределено);
	КонецЕсли;

	Если Выражение.ЯвляетсяЛитералом() Тогда
		Возврат Новый Структура("Значение, Динамический, Выражение", Выражение.ЛитеральноеЗначение(), Ложь, Выражение);
	КонецЕсли;

	Возврат Новый Структура("Значение, Динамический, Выражение", Метод, Истина, Выражение);

КонецФункции

Функция СформироватьПараметрыВызова(
	Операция,
	URL,
	ВыражениеURL,
	ПараметрыURL,
	ВыражениеДанных,
	ОписаниеМетода
)

	Результат = Новый Массив;
	Если ОписаниеМетода.Динамический Тогда
		Результат.Добавить(_Выражения.Представить(ОписаниеМетода.Выражение));
	КонецЕсли;

	Результат.Добавить(ПредставитьАдресВызова(Операция, URL, ВыражениеURL, ПараметрыURL));

	Если Не ОписаниеМетода.Динамический И Не ПустаяСтрока(ВыражениеДанных) Тогда
		Результат.Добавить(ВыражениеДанных);
	ИначеЕсли Не ОписаниеМетода.Динамический
		И ОписаниеМетода.Значение = МетодыЗапросаПоУмолчаниюCURL.GET()
		И ПараметрыURL.Соответствие Тогда
		Результат.Добавить("ПараметрыЗапроса");
	ИначеЕсли Не ОписаниеМетода.Динамический Тогда
		Результат.Добавить("");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПредставитьАдресВызова(Операция, URL, ВыражениеURL, ПараметрыURL)

	Если Не ПустаяСтрока(ПараметрыURL.ВыражениеАдреса) Тогда
		Возврат ПараметрыURL.ВыражениеАдреса;
	ИначеЕсли ВыражениеURL.ЯвляетсяЛитералом() Тогда
		Возврат Литерал(АдресОперации(URL, Операция));
	ИначеЕсли ПараметрыURL.Есть Тогда
		Возврат АдресБезСтрокиЗапроса(ВыражениеURL);
	КонецЕсли;

	Возврат _Выражения.ПредставитьДоРазделителя(ВыражениеURL, "#");

КонецФункции

Процедура ДобавитьДополнительныеПараметры(
	Код,
	Операция,
	ПараметрыURL,
	Тело,
	Вызов,
	ЕстьЗаголовки,
	ЕстьАутентификация,
	ЕстьПрокси
)

	ЕстьНастройки = ЕстьНастройкиСоединения(Операция, Вызов);
	ЕстьДополнительныеПараметры = Вызов.ДинамическийМетод Или ЕстьЗаголовки Или ЕстьАутентификация
		Или ЕстьПрокси Или ЕстьНастройки Или Тело.JSON Или Тело.Файлы
		Или ((Вызов.ДинамическийМетод
			Или Вызов.Метод <> МетодыЗапросаПоУмолчаниюCURL.GET())
			И ПараметрыURL.Соответствие);

	Если Не ЕстьДополнительныеПараметры Тогда
		Возврат;
	КонецЕсли;

	Код.ДобавитьСтроку("ДополнительныеПараметры = Новый Структура();");
	
	Если ЕстьЗаголовки Тогда
		ДобавитьПараметр(Код, "Заголовки", "Заголовки");
	КонецЕсли;

	Если ЕстьАутентификация Тогда
		ДобавитьПараметр(Код, "Аутентификация", "Аутентификация");
	КонецЕсли;

	Если (Вызов.ДинамическийМетод Или Вызов.Метод <> МетодыЗапросаПоУмолчаниюCURL.GET())
		И ПараметрыURL.Соответствие Тогда
		ДобавитьПараметр(Код, "ПараметрыЗапроса", "ПараметрыЗапроса");
	КонецЕсли;

	Если Вызов.ДинамическийМетод И Не ПустаяСтрока(Тело.Выражение) И Не Тело.JSON Тогда
		ДобавитьПараметр(Код, "Данные", Тело.Выражение);
	КонецЕсли;

	Если Тело.JSON Тогда
		ДобавитьПараметр(Код, "Json", "Данные");
	КонецЕсли;

	Если Тело.Файлы Тогда
		ДобавитьПараметр(Код, "Файлы", "Файлы");
	КонецЕсли;

	ДобавитьНастройкиСоединения(Код, Операция, ЕстьПрокси, Вызов);
	Код.ДобавитьСтроку();

	Если Вызов.Метод = МетодыЗапросаПоУмолчаниюCURL.HEAD()
		И Вызов.ПараметрыВызова.Количество() = 2
		И ПустаяСтрока(Вызов.ПараметрыВызова[1]) Тогда
		Вызов.ПараметрыВызова.Удалить(1);
	КонецЕсли;

	Вызов.ПараметрыВызова.Добавить("ДополнительныеПараметры");

КонецПроцедуры

Процедура ДобавитьВызовКоннектора(Код, Вызов, РезультатОперации, URL)

	Код.ДобавитьВызов(
		"Результат = ",
		"КоннекторHTTP." + Вызов.ИмяМетода,
		Вызов.ПараметрыВызова
	);

	Если ЭтоФайловыйРезультат(РезультатОперации) Тогда
		Код.ДобавитьСтроку();
		ДобавитьРезультат(Код, РезультатОперации, URL);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоФайловыйРезультат(Результат)

	Возврат (Результат.Режим() = РежимыРезультатаCURL.Файл()
		Или Результат.Режим() = РежимыРезультатаCURL.ОпределитьПослеВычисления())
		И Есть(КодыВозможностейГенератораCURL.ВыводВФайл())
		Или Результат.Режим() = РежимыРезультатаCURL.ИмяИзURL()
		И Есть(КодыВозможностейГенератораCURL.ИмяФайлаИзURL());

КонецФункции

Функция ДобавитьОбъявленияПеременных(ОсновнойКод)

	Если _ИменаПеременных.Количество() = 0 Тогда
		Возврат ОсновнойКод;
	КонецЕсли;

	Код = Новый ПостроительКодаCURL;

	Для Каждого Элемент Из _ИменаПеременных Цикл
		Код.ДобавитьСтроку("%1 = """";", Элемент.Значение);
	КонецЦикла;

	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку(ОсновнойКод);

	Возврат Код.ПолучитьРезультат();

КонецФункции

Функция ПоддерживаютсяТолькоБазовыеОперации(Возможности)

	Для Каждого Возможность Из Возможности Цикл

		Если Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTP()
			И Возможность <> КодыВозможностейГенератораCURL.ПротоколHTTPS()
			И Возможность <> КодыВозможностейГенератораCURL.НесколькоОпераций() Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция СформироватьБазовуюОперацию(Операция, URL)

	Адрес = АдресОперации(URL, Операция);
	Если ПустаяСтрока(URL.КодированныйПуть()) Тогда
		Адрес = Адрес + "/";
	КонецЕсли;

	Метод = Операция.Запрос().МетодПоУмолчанию();
	Если Метод = МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола() Тогда
		Метод = МетодыЗапросаПоУмолчаниюCURL.GET();
	КонецЕсли;

	Код = Новый ПостроительКодаCURL;
	Код.ДобавитьСтроку("Адрес = %1;", Литерал(Адрес));
	Код.ДобавитьСтроку("Заголовки = Новый Соответствие;");
	Код.ДобавитьСтроку("ДанныеЗапроса = Неопределено;");
	Код.ДобавитьСтроку("ПараметрыЗапроса = Новый Структура;");
	Код.ДобавитьСтроку("ПараметрыЗапроса.Вставить(""Заголовки"", Заголовки);");
	Код.ДобавитьСтроку("ПараметрыЗапроса.Вставить(""Данные"", ДанныеЗапроса);");
	Код.ДобавитьСтроку("ПараметрыЗапроса.Вставить(""РазрешитьПеренаправление"", Ложь);");
	Код.ДобавитьСтроку(
		"Результат = КоннекторHTTP.ВызватьМетод(%1, Адрес, ПараметрыЗапроса);",
		Литерал(Метод)
	);

	Результат = Код.ПолучитьРезультат();

	Возврат Результат;

КонецФункции















Функция ДобавитьПодготовкуПрокси(Код, Прокси, Протокол)

	Если Прокси.Режим() = РежимыПроксиCURL.ОпределитьПослеВычисления() Тогда
		ПараметрыПрокси = РазобратьВычисляемыйПрокси(Прокси);
		Если ПараметрыПрокси = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли Прокси.Режим() = РежимыПроксиCURL.Настроен() И Прокси.Протокол() = ПротоколыCURL.HTTP() Тогда
		ПараметрыПрокси = Новый Структура(
			"Сервер, Порт",
			Литерал(Прокси.Сервер()),
			?(Прокси.Порт() = Неопределено, 1080, Прокси.Порт())
		);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Код.ДобавитьСтроку("Прокси = Новый ИнтернетПрокси();");

	Аргументы = Новый Массив;
	Аргументы.Добавить(Литерал(Протокол));
	Аргументы.Добавить(ПараметрыПрокси.Сервер);
	Аргументы.Добавить(ЧислоВКод(ПараметрыПрокси.Порт));

	ЕстьNTLM = Ложь;
	Для Каждого Способ Из Прокси.СпособыАутентификации() Цикл
		ЕстьNTLM = ЕстьNTLM Или Способ.Вид() = "ntlm";
	КонецЦикла;

	Данные = Прокси.УчетныеДанные();
	Если Данные <> Неопределено Тогда
		Аргументы.Добавить(Литерал(Данные.Пользователь()));
		Аргументы.Добавить(?(Данные.Пароль() = Неопределено, "", Литерал(Данные.Пароль())));
		Аргументы.Добавить(?(ЕстьNTLM, "Истина", "Ложь"));
	Иначе
		Аргументы.Добавить("");
		Аргументы.Добавить("");
		Аргументы.Добавить(?(ЕстьNTLM, "Истина", "Ложь"));
	КонецЕсли;

	Код.ДобавитьСтроку("Прокси.Установить(%1);", Код.ПараметрыФункцииВСтроку(Аргументы));
	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Функция РазобратьВычисляемыйПрокси(Прокси)

	Шаблон = _Выражения.СтрокаДляРазбора(Прокси.Адрес());
	Если СтрНайти(Шаблон, "://") = 0 Тогда
		Шаблон = ПротоколыCURL.HTTP() + "://" + Шаблон;
	КонецЕсли;

	Попытка
		Адрес = Новый URL(Шаблон);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если НРег(Адрес.Схема()) <> ПротоколыCURL.HTTP() Или ПустаяСтрока(Адрес.Хост()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сервер = _Выражения.ПредставитьШаблон(Адрес.Хост(), Прокси.Адрес());
	Порт = ?(Адрес.Порт() = Неопределено, 1080, Адрес.Порт());

	Возврат Новый Структура("Сервер, Порт", Сервер, Порт);

КонецФункции

Функция ЕстьНастройкиСоединения(Операция, Вызов)

	Соединение = Операция.Соединение();
	TLS = Соединение.TLS();
	Политики = Операция.Политики();
	Перенаправления = Политики.Перенаправления();
	Повторы = Политики.Повторы();

	Возврат TLS.СертификатКлиента() <> Неопределено
		Или TLS.СертификатыУдостоверяющегоЦентра() <> Неопределено
		Или Соединение.Таймаут() <> Неопределено
		Или ТребуетсяНастройкаПеренаправлений(Перенаправления, Вызов)
		Или Повторы.Количество() <> Неопределено И Повторы.Количество().Значение() > 0
		Или Повторы.МаксимальноеВремя() <> Неопределено И Повторы.МаксимальноеВремя().Значение() > 0;

КонецФункции

Процедура ДобавитьНастройкиСоединения(Код, Операция, ЕстьПрокси, Вызов)

	Соединение = Операция.Соединение();
	TLS = Соединение.TLS();

	Если TLS.СертификатыУдостоверяющегоЦентра() <> Неопределено Тогда
		ДобавитьПараметр(
			Код,
			"ПроверятьSSL",
			"Новый СертификатыУдостоверяющихЦентровФайл("
				+ Код.ПредставитьВыражение(TLS.СертификатыУдостоверяющегоЦентра()) + ")"
		);
	КонецЕсли;

	Сертификат = TLS.СертификатКлиента();
	Если Сертификат <> Неопределено Тогда
		Аргументы = Новый Массив;
		Если Сертификат.ТребуетРазбора() Тогда
			Аргументы.Добавить(_Выражения.ПредставитьДоРазделителя(Сертификат.Выражение(), ":"));
			Аргументы.Добавить(_Выражения.ПредставитьПослеРазделителя(Сертификат.Выражение(), ":"));
		Иначе
			Аргументы.Добавить(Литерал(Сертификат.Путь()));
			Аргументы.Добавить(?(Сертификат.Пароль() = Неопределено, "", Литерал(Сертификат.Пароль())));
		КонецЕсли;
		ДобавитьПараметр(
			Код,
			"КлиентскийСертификатSSL",
			"Новый СертификатКлиентаФайл(" + Код.ПараметрыФункцииВСтроку(Аргументы) + ")"
		);
	КонецЕсли;

	Если ЕстьПрокси Тогда
		ДобавитьПараметр(Код, "Прокси", "Прокси");
	КонецЕсли;

	Если Соединение.Таймаут() <> Неопределено Тогда
		ДобавитьПараметр(Код, "Таймаут", ЧислоВКод(Соединение.Таймаут().Значение() / 1000));
	КонецЕсли;

	Перенаправления = Операция.Политики().Перенаправления();
	Если ТребуетсяНастройкаПеренаправлений(Перенаправления, Вызов) Тогда
		Значение = ?(Перенаправления.Следовать(), "Истина", "Ложь");
		ДобавитьПараметр(Код, "РазрешитьПеренаправление", Значение);
	КонецЕсли;

	Повторы = Операция.Политики().Повторы();
	Если Повторы.Количество() <> Неопределено И Повторы.Количество().Значение() > 0 Тогда
		ДобавитьПараметр(Код, "МаксимальноеКоличествоПовторов", ЧислоВКод(Повторы.Количество().Значение()));
	КонецЕсли;

	Если Повторы.МаксимальноеВремя() <> Неопределено И Повторы.МаксимальноеВремя().Значение() > 0 Тогда
		ДобавитьПараметр(
			Код,
			"МаксимальноеВремяПовторов",
			ЧислоВКод(Повторы.МаксимальноеВремя().Значение() / 1000)
		);
	КонецЕсли;

КонецПроцедуры

Функция ТребуетсяНастройкаПеренаправлений(Перенаправления, Вызов)

	Если Перенаправления.Источник() = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не Перенаправления.Следовать() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Вызов.ДинамическийМетод
		Или ВРег(Вызов.Метод) = МетодыЗапросаПоУмолчаниюCURL.HEAD();

КонецФункции















Функция АдресОперации(URL, Операция)

	Путь = URL.КодированныйПуть();
	ИсходныйАдрес = Операция.Ресурс().ИсходныйАдрес().ЛитеральноеЗначение();
	ЯвноУказанКорневойПуть = СтрНайти(ИсходныйАдрес, "/#") > 0;

	Если (ПустаяСтрока(Путь) Или Прав(Путь, 1) = "/")
		И Операция.Запрос().Тело().Вид() = ВидыТелаЗапросаCURL.ЗагрузкаФайла()
		И Есть(КодыВозможностейГенератораCURL.ЗагрузкаФайла())
		И Есть(КодыВозможностейГенератораCURL.ЧтениеФайла()) Тогда
		Для Каждого Часть Из Операция.Запрос().Тело().Части() Цикл
			Если Часть.ПутьКФайлу() <> Неопределено Тогда
				Если ПустаяСтрока(Путь) Тогда
					Путь = "/";
				КонецЕсли;

				Путь = Путь + КодированиеURL.КодироватьСегментПути(ИмяФайла(Часть.ПутьКФайлу()));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Путь = "/" И Не ЯвноУказанКорневойПуть Тогда
		Путь = "";
	КонецЕсли;

	АдресURL = URL.Скопировать();
	АдресURL.УстановитьКодированныйПуть(Путь);
	АдресURL.УстановитьКодированнуюСтрокуЗапроса(
		?(URL.ПараметрыЗапроса().ИсходнаяСтрока() = "", "", Неопределено)
	);
	АдресURL.УстановитьКодированныйФрагмент(Неопределено);

	Данные = Операция.Запрос().Аутентификация().УчетныеДанные();
	Если Данные <> Неопределено И Данные.Источник().Вид() = "url" Тогда
		АдресURL.УстановитьДанныеПользователя(Данные.Пользователь() + ":" + Данные.Пароль());
	Иначе
		АдресURL.УстановитьКодированныеДанныеПользователя(Неопределено);
	КонецЕсли;

	Возврат АдресURL.КодированноеПредставление();

КонецФункции

Функция ДобавитьПараметрыURL(Код, URL, ВыражениеURL, Части, Возможности, Операция)

	Если Части.Количество() > 0 Тогда
		Возврат ДобавитьЧастиСтрокиЗапроса(Код, URL, Части, Операция);
	КонецЕсли;

	ЕстьПараметры = ДобавитьПараметрыURLИзАдреса(Код, URL, ВыражениеURL);
	Возврат Новый Структура("Есть, Соответствие, ВыражениеАдреса", ЕстьПараметры, ЕстьПараметры, "");

КонецФункции

Функция ДобавитьЧастиСтрокиЗапроса(Код, URL, Части, Операция)

	Если МожноПредставитьЗапросСоответствием(Части) Тогда
		ДобавитьСоответствиеСтрокиЗапроса(Код, Части);
		Возврат Новый Структура("Есть, Соответствие, ВыражениеАдреса", Истина, Истина, "");
	КонецЕсли;

	Адрес = АдресОперации(URL, Операция);

	ИсходнаяСтрокаЗапроса = URL.ПараметрыЗапроса().ИсходнаяСтрока();
	Если ИсходнаяСтрокаЗапроса <> Неопределено И Прав(Адрес, 1) <> "?" Тогда
		Адрес = Адрес + "?" + ИсходнаяСтрокаЗапроса;
	КонецЕсли;

	ЕстьЗнакВопроса = СтрНайти(Адрес, "?") > 0;
	ЛитеральныеЧасти = Новый Массив;
	ФайловыеЧасти = Новый Массив;
	НомерФайла = 0;

	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			НомерФайла = НомерФайла + 1;
			ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
			ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной);
			Код.ДобавитьСтроку();
			ФайловыеЧасти.Добавить(Новый Структура("Часть, Выражение", Часть, ИмяПеременной));
		Иначе
			ЛитеральныеЧасти.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Если ЛитералСледуетПослеФайла(Части) Тогда
		Возврат СформироватьСтрокуЗапросаПоПорядку(Код, Части, Адрес, ФайловыеЧасти);
	КонецЕсли;

	Для Каждого Часть Из ЛитеральныеЧасти Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Текст = Часть.Текст();

		Если Часть.Кодировать() = Истина Тогда
			Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		Адрес = Адрес + Префикс + Текст;
	КонецЦикла;

	Если ФайловыеЧасти.Количество() = 1 Тогда
		ФайловаяЧасть = ФайловыеЧасти[0];
		Часть = ФайловаяЧасть.Часть;

		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		ВыражениеАдреса = Литерал(Адрес + Префикс) + " + " + ФайловаяЧасть.Выражение;

		Возврат Новый Структура(
			"Есть, Соответствие, ВыражениеАдреса",
			Истина,
			Ложь,
			ВыражениеАдреса
		);
	КонецЕсли;

	СтрокиАдреса = Новый Массив;
	СтрокиАдреса.Добавить("URL = " + Литерал(Адрес));

	Для Каждого ФайловаяЧасть Из ФайловыеЧасти Цикл
		Часть = ФайловаяЧасть.Часть;
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;

		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		СтрокиАдреса.Добавить(Символы.Таб + "+ " + Литерал(Префикс) + " + " + ФайловаяЧасть.Выражение);
	КонецЦикла;

	СтрокиАдреса[СтрокиАдреса.ВГраница()] = СтрокиАдреса[СтрокиАдреса.ВГраница()] + ";";

	Код.ДобавитьСтроку(СтрСоединить(СтрокиАдреса, Символы.ПС));
	Код.ДобавитьСтроку();

	Возврат Новый Структура("Есть, Соответствие, ВыражениеАдреса", Истина, Ложь, "URL");

КонецФункции

Функция ЛитералСледуетПослеФайла(Части)

	ФайлНайден = Ложь;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			ФайлНайден = Истина;
		ИначеЕсли ФайлНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СформироватьСтрокуЗапросаПоПорядку(Код, Части, Адрес, ФайловыеЧасти)

	Код.ДобавитьСтроку("URL = %1;", Литерал(Адрес));
	ЕстьЗнакВопроса = СтрНайти(Адрес, "?") > 0;
	ИндексФайла = 0;

	Для Каждого Часть Из Части Цикл
		Префикс = ?(ЕстьЗнакВопроса, "&", "?") + ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		ЕстьЗнакВопроса = Истина;
		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Выражение = ФайловыеЧасти[ИндексФайла].Выражение;
			ИндексФайла = ИндексФайла + 1;
			Код.ДобавитьСтроку("URL = URL + %1 + %2;", Литерал(Префикс), Выражение);
		Иначе
			Текст = Часть.Текст();
			Если Часть.Кодировать() = Истина Тогда
				Текст = КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
			КонецЕсли;
			Код.ДобавитьСтроку("URL = URL + %1;", Литерал(Префикс + Текст));
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСтроку();

	Возврат Новый Структура("Есть, Соответствие, ВыражениеАдреса", Истина, Ложь, "URL");

КонецФункции

Функция МожноПредставитьЗапросСоответствием(Части)

	Для Каждого Часть Из Части Цикл
		Если Часть.Имя() <> Неопределено И Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Продолжить;
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено Или Часть.Текст() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		ПозицияРавно = СтрНайти(Часть.Текст(), "=");
		Если ПозицияРавно <= 1 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьСоответствиеСтрокиЗапроса(Код, Части)

	Файлы = Новый Соответствие;
	НомерФайла = 0;
	Для Каждого Часть Из Части Цикл
		Если Часть.ПутьКФайлу() = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной);
		Код.ДобавитьСтроку();
		Файлы.Вставить(Часть, ИмяПеременной);
	КонецЦикла;

	Код.ОбъявитьСоответствие("ПараметрыЗапроса");

	Для Каждого Часть Из Части Цикл
		Если Часть.Имя() <> Неопределено Тогда
			Имя = Часть.Имя();
			Значение = ?(
				Часть.ПутьКФайлу() = Неопределено,
				Литерал(Часть.Текст()),
				Файлы[Часть]
			);
		Иначе
			ПозицияРавно = СтрНайти(Часть.Текст(), "=");
			Имя = Лев(Часть.Текст(), ПозицияРавно - 1);
			Значение = Литерал(Сред(Часть.Текст(), ПозицияРавно + 1));
		КонецЕсли;

		Код.ВставитьВСоответствие("ПараметрыЗапроса", Литерал(Имя), Значение);
	КонецЦикла;

	Код.ДобавитьСтроку();

КонецПроцедуры

Функция ДобавитьПараметрыURLИзАдреса(Код, URL, ВыражениеURL)

	Если Не ВыражениеURL.ЯвляетсяЛитералом() Тогда
		Возврат ДобавитьПараметрыURLИзВыражения(Код, ВыражениеURL);
	КонецЕсли;

	Пары = URL.ПараметрыЗапроса().ВМассив();
	Если Пары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Имена = Новый Массив;
	Значения = Новый Соответствие;

	Для Каждого Пара Из Пары Цикл
		МассивЗначений = Значения.Получить(Пара.Имя);

		Если МассивЗначений = Неопределено Тогда
			Имена.Добавить(Пара.Имя);
			МассивЗначений = Новый Массив;
			Значения.Вставить(Пара.Имя, МассивЗначений);
		КонецЕсли;

		МассивЗначений.Добавить(Пара.Значение);
	КонецЦикла;

	Код.ОбъявитьСоответствие("ПараметрыЗапроса");

	Для Каждого Имя Из Имена Цикл
		МассивЗначений = Значения[Имя];
		Если МассивЗначений.Количество() = 1 Тогда
			Если МассивЗначений[0] = Неопределено Тогда
				Код.ДобавитьСтроку("ПараметрыЗапроса.Вставить(%1);", Литерал(Имя));
			Иначе
				Код.ВставитьВСоответствие(
					"ПараметрыЗапроса",
					Литерал(Имя),
					Литерал(МассивЗначений[0])
				);
			КонецЕсли;
		Иначе
			Код.ВставитьВСоответствие("ПараметрыЗапроса", Литерал(Имя), "Новый Массив()");
			Для Каждого Значение Из МассивЗначений Цикл
				Код.ДобавитьСтроку(
					"ПараметрыЗапроса[%1].Добавить(%2);",
					Литерал(Имя),
					?(Значение = Неопределено, "Неопределено", Литерал(Значение))
				);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Функция ДобавитьПараметрыURLИзВыражения(Код, ВыражениеURL)

	Шаблон = _Выражения.СтрокаДляРазбора(ВыражениеURL);
	ПозицияВопроса = СтрНайти(Шаблон, "?");

	Если ПозицияВопроса = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаЗапроса = Сред(Шаблон, ПозицияВопроса + 1);
	ПозицияФрагмента = СтрНайти(СтрокаЗапроса, "#");

	Если ПозицияФрагмента > 0 Тогда
		СтрокаЗапроса = Лев(СтрокаЗапроса, ПозицияФрагмента - 1);
	КонецЕсли;

	Пары = СтрРазделить(СтрокаЗапроса, "&", Истина);
	Для Каждого ЭлементПары Из Пары Цикл
		ПозицияРавно = СтрНайти(ЭлементПары, "=");
		Если ПозицияРавно = 0 Или СтрНайти(Лев(ЭлементПары, ПозицияРавно - 1), "curlonevariable") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Код.ОбъявитьСоответствие("ПараметрыЗапроса");

	Для Каждого ЭлементПары Из Пары Цикл
		ПозицияРавно = СтрНайти(ЭлементПары, "=");
		Имя = Лев(ЭлементПары, ПозицияРавно - 1);
		Значение = Сред(ЭлементПары, ПозицияРавно + 1);
		Код.ВставитьВСоответствие(
			"ПараметрыЗапроса",
			Литерал(Имя),
			_Выражения.ПредставитьШаблон(Значение, ВыражениеURL)
		);
	КонецЦикла;

	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Функция АдресБезСтрокиЗапроса(ВыражениеURL)

	Шаблон = _Выражения.СтрокаДляРазбора(ВыражениеURL);
	Позиция = СтрНайти(Шаблон, "?");

	Если Позиция > 0 Тогда
		Шаблон = Лев(Шаблон, Позиция - 1);
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Шаблон, "/") Тогда
		Шаблон = Лев(Шаблон, СтрДлина(Шаблон) - 1);
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(Шаблон, ВыражениеURL);

КонецФункции

Функция ДобавитьАутентификацию(Код, Аутентификация)

	Данные = Аутентификация.УчетныеДанные();
	Если Данные <> Неопределено И Данные.Источник().Вид() = "url" Тогда
		Данные = Неопределено;
	КонецЕсли;

	Способ = "basic";
	Для Каждого Элемент Из Аутентификация.Способы() Цикл
		Способ = Элемент.Вид();
	КонецЦикла;

	Подпись = Аутентификация.ПодписьAWSV4();
	Если Подпись <> Неопределено И Данные <> Неопределено Тогда
		Код.ДобавитьСтроку("Аутентификация = Новый Структура();");
		Код.ДобавитьСтроку(
			"Аутентификация.Вставить(%1, ""AWS4-HMAC-SHA256"");",
			Ключ("Аутентификация.Тип")
		);
		Код.ДобавитьСтроку(
			"Аутентификация.Вставить(%1, %2);",
			Ключ("AWS4.ИдентификаторКлючаДоступа"),
			Литерал(Данные.Пользователь())
		);
		Код.ДобавитьСтроку(
			"Аутентификация.Вставить(%1, %2);",
			Ключ("AWS4.СекретныйКлюч"),
			Литерал(Данные.Пароль())
		);
		Код.ДобавитьСтроку(
			"Аутентификация.Вставить(%1, %2);",
			Ключ("AWS4.Сервис"),
			Литерал(Подпись.Сервис())
		);
		Код.ДобавитьСтроку(
			"Аутентификация.Вставить(%1, %2);",
			Ключ("AWS4.Регион"),
			Литерал(Подпись.Регион())
		);
	ИначеЕсли Аутентификация.OAuth2() <> Неопределено Тогда
		Код.ДобавитьСтроку(
			"Аутентификация = Новый Структура(%1, %2, ""Bearer"");",
			ИменаПараметров("Bearer.Токен,Аутентификация.Тип"),
			_Выражения.Представить(Аутентификация.OAuth2().Выражение())
		);
	ИначеЕсли Данные <> Неопределено И Способ = "digest" Тогда
		Код.ДобавитьСтроку(
			"Аутентификация = Новый Структура(%1, ""Digest"", %2, %3);",
			ИменаПараметров("Аутентификация.Тип,Пользователь,Пароль"),
			ПредставитьПользователя(Данные),
			ПредставитьПароль(Данные)
		);
	ИначеЕсли Способ = "ntlm" Или Способ = "negotiate" Тогда
		Код.ДобавитьСтроку(
			"Аутентификация = Новый Структура(%1, Истина);",
			Ключ("ИспользоватьАутентификациюОС")
		);
	ИначеЕсли Данные <> Неопределено Тогда
		Код.ДобавитьСтроку(
			"Аутентификация = Новый Структура(%1, %2, %3);",
			ИменаПараметров("Пользователь,Пароль"),
			ПредставитьПользователя(Данные),
			ПредставитьПароль(Данные)
		);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Код.ДобавитьСтроку();

	Возврат Истина;

КонецФункции

Функция ПредставитьПользователя(Данные)

	Если Данные.ТребуетРазбора() Тогда
		Возврат _Выражения.ПредставитьДоРазделителя(Данные.Выражение(), ":");
	КонецЕсли;

	Возврат Литерал(Данные.Пользователь());

КонецФункции

Функция ПредставитьПароль(Данные)

	Если Данные.ТребуетРазбора() Тогда
		Возврат _Выражения.ПредставитьПослеРазделителя(Данные.Выражение(), ":");
	КонецЕсли;

	Возврат Литерал(Данные.Пароль());

КонецФункции

Функция ИмяМетодаКоннектора(Метод, ФорматДесериализацииОтвета)

	Имя = НРег(Лев(Метод, 1)) + НРег(Сред(Метод, 2));
	Имя = ВРег(Лев(Имя, 1)) + Сред(Имя, 2);

	Если ФорматДесериализацииОтвета = ФорматыДесериализацииОтветаCURL.JSON() Тогда
		Если Имя = "Get" Или Имя = "Post" Или Имя = "Put" Или Имя = "Delete" Тогда
			Имя = Имя + "Json";
		КонецЕсли;
	КонецЕсли;

	Возврат Имя;

КонецФункции

Процедура ДобавитьЗаголовки(Код, Заголовки, Аутентификация)

	Для Каждого Элемент Из Заголовки Цикл
		Заголовок = Элемент.Значение;
		Если Не Заголовок.Удален Тогда
			Код.ВставитьВСоответствие(
				"Заголовки",
				Литерал(Заголовок.Имя),
				?(Заголовок.Выражение = Неопределено Или Заголовок.Выражение.ЯвляетсяЛитералом(),
					Литерал(СокрЛП(Заголовок.Значение)),
					_Выражения.ПредставитьПослеРазделителя(Заголовок.Выражение, ":", Истина))
			);
		КонецЕсли;
	КонецЦикла;

	Если Аутентификация.OAuth2() <> Неопределено
		И Есть(КодыВозможностейГенератораCURL.ТокенOAuth2())
		И Есть(КодыВозможностейГенератораCURL.АутентификацияOAuth2Bearer())
		И Заголовки.Получить("authorization") = Неопределено Тогда
		Код.ДобавитьСтроку(
			"Заголовки.Вставить(""Authorization"", %1);",
			ПредставитьТокенBearer(Аутентификация.OAuth2().Выражение())
		);
	КонецЕсли;

КонецПроцедуры

Функция ПредставитьТокенBearer(Выражение)

	Если Выражение.ЯвляетсяЛитералом() Тогда
		Возврат Литерал("Bearer " + Выражение.ЛитеральноеЗначение());
	КонецЕсли;

	Возврат Литерал("Bearer ") + " + " + _Выражения.Представить(Выражение);

КонецФункции

Процедура ДобавитьРезультат(Код, Результат, URL)

	Имя = Неопределено;
	Если (Результат.Режим() = РежимыРезультатаCURL.Файл()
		Или Результат.Режим() = РежимыРезультатаCURL.ОпределитьПослеВычисления())
		И Есть(КодыВозможностейГенератораCURL.ВыводВФайл()) Тогда
		Имя = Код.ПредставитьВыражение(Результат.ИмяФайла());
	ИначеЕсли Результат.Режим() = РежимыРезультатаCURL.ИмяИзURL()
		И Есть(КодыВозможностейГенератораCURL.ИмяФайлаИзURL()) Тогда
		Имя = Литерал(ИмяФайла(URL.Путь()));
	КонецЕсли;

	Если Имя <> Неопределено Тогда

		Код.ДобавитьСтроку("ИмяФайлаОтвета = %1;", Имя);
		Если Результат.Каталог() <> Неопределено И Есть(КодыВозможностейГенератораCURL.КаталогВывода()) Тогда
			Код.ДобавитьСтроку(
				"ИмяФайлаОтвета = ОбъединитьПути(%1, ИмяФайлаОтвета);",
				Код.ПредставитьВыражение(Результат.Каталог())
			);
		КонецЕсли;

		Если Результат.СоздаватьКаталоги() И Есть(КодыВозможностейГенератораCURL.СозданиеКаталогов()) Тогда
			Код.ДобавитьСтроку("ФайлОтвета = Новый Файл(ИмяФайлаОтвета);");
			Код.ДобавитьСтроку("Если Не ПустаяСтрока(ФайлОтвета.Путь) Тогда");
			Код.ДобавитьСтроку("%1СоздатьКаталог(ФайлОтвета.Путь);", Символы.Таб);
			Код.ДобавитьСтроку("КонецЕсли;");
		КонецЕсли;

		Код.ДобавитьСтроку("ДанныеОтвета = Результат.ДвоичныеДанные();");
		Код.ДобавитьСтроку("ДанныеОтвета.Записать(ИмяФайлаОтвета);");
		Код.ДобавитьСтроку("Результат = ИмяФайлаОтвета;");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПараметр(Код, Имя, Выражение)
	Код.ВставитьВСоответствие("ДополнительныеПараметры", Ключ(Имя), Выражение);
КонецПроцедуры

Процедура ДобавитьЧтениеТекстовогоФайла(Код, Часть, ИмяПеременной)

	Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Литерал(Часть.ПутьКФайлу()));
	Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);

	Если Часть.РежимИсточника() = РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL() Тогда
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ПС, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ВК, """");", ИмяПеременной);
	КонецЕсли;

	Если Часть.Кодировать() = Истина Тогда
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
	КонецЕсли;

КонецПроцедуры

Функция Ключ(Имя)
	Возврат Литерал(_Локализация.ПолучитьРесурс("Параметр." + Имя));
КонецФункции

Функция Литерал(Значение)
	Возврат _Выражения.Литерал(Значение);
КонецФункции

Функция ИменаПараметров(Имена)

	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Результат.Добавить(_Локализация.ПолучитьРесурс("Параметр." + Имя));
	КонецЦикла;

	Возврат Литерал(СтрСоединить(Результат, ", "));

КонецФункции

Функция Есть(Возможность)
	Возврат _Возможности.Найти(Возможность) <> Неопределено;
КонецФункции


Функция ЧислоВКод(Значение)
	Возврат Формат(Значение, "ЧГ=0;ЧРД=.;ЧН=0");
КонецФункции

Функция ИмяФайла(Путь)

	Части = СтрРазделить(СтрЗаменить(Путь, "\", "/"), "/", Истина);
	Имя = Части[Части.Количество() - 1];

	Возврат ?(ПустаяСтрока(Имя), "curl_response", Имя);

КонецФункции

#КонецОбласти

КонецФункции

Функция СформироватьПоСнимку(Операции, Локаль, Параметры, Возможности)

	ОперацииСКодом = Новый Массив;
	Фрагменты = Новый Массив;

	Для Каждого Операция Из Операции Цикл
		Подготовленная = Новый ПодготовкаОперацииДляГенерацииCURL().Подготовить(Операция, Возможности);
		Код = Новый ФормированиеКодаКоннектораCURL().Получить(
			Подготовленная,
			Локаль,
			Параметры,
			Возможности
		);
		Если Не ПустаяСтрока(Код) Тогда
			ОперацииСКодом.Добавить(Операция);
			Фрагменты.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Компоновка = Новый КомпоновщикОперацийCURL().ВынестиОбщуюПодготовку(Фрагменты);
	ВсеПередаютФайлы = ВсеОперацииПередаютФайлы(ОперацииСКодом);
	Результаты = Новый Массив;

	Если Не ПустаяСтрока(Компоновка.ОбщийКод) Тогда
		Результаты.Добавить(Компоновка.ОбщийКод);
	КонецЕсли;

	Для Индекс = 0 По Компоновка.Фрагменты.ВГраница() Цикл
		Результаты.Добавить(ОформитьЗапрос(
			Компоновка.Фрагменты[Индекс],
			ОперацииСКодом[Индекс],
			Индекс + 1,
			ОперацииСКодом.Количество(),
			ВсеПередаютФайлы
		));
	КонецЦикла;

	Возврат СтрСоединить(Результаты, Символы.ПС + Символы.ПС);

КонецФункции

Функция ОформитьЗапрос(Код, Операция, НомерЗапроса, КоличествоЗапросов, ВсеПередаютФайлы)

	Если КоличествоЗапросов = 1 Тогда
		Возврат Код;
	КонецЕсли;

	Конструктор = Новый ПостроительКодаCURL;
	Если ВсеПередаютФайлы Тогда
		Для Каждого Часть Из Операция.Запрос().Тело().Части() Цикл
			Если Часть.ПутьКФайлу() <> Неопределено Тогда
				Конструктор.ДобавитьСтроку("// Передача файла %1. %2", НомерЗапроса, Часть.ПутьКФайлу());
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Конструктор.ДобавитьСтроку(
			"// Запрос %1. %2",
			НомерЗапроса,
			Операция.Ресурс().ИсходныйАдрес().ЛитеральноеЗначение()
		);
	КонецЕсли;

	Конструктор.ДобавитьСтроку(Код);

	Возврат Конструктор.ПолучитьРезультат();

КонецФункции

Функция ВсеОперацииПередаютФайлы(Операции)

	Если Операции.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ИсточникURL = Операции[0].Ресурс().Источник();
	Для Каждого Операция Из Операции Цикл
		Если Операция.Запрос().Тело().Вид() <> "upload_file" Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Операция.Ресурс().Источник() <> ИсточникURL Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ПроверитьПараметры(Параметры)

	Значение = Параметры.Получить("ДесериализоватьОтветИзJSON");
	Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Булево") Тогда
		ВызватьИсключение СтандартныеОшибки.НеверныйТипАргумента(
			"ДесериализоватьОтветИзJSON",
			"Булево",
			Значение
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

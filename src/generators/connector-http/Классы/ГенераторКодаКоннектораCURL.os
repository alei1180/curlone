#Использовать errors
#Использовать "../internal"
#Использовать "../../shared"

#Область ПрограммныйИнтерфейс

// Возвращает идентификатор генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор connector.
Функция Идентификатор() Экспорт
	Возврат "connector";
КонецФункции

// Возвращает наименование генератора.
//
// Возвращаемое значение:
//   Строка - Наименование генератора.
Функция Наименование() Экспорт
	Возврат "Коннектор HTTP";
КонецФункции

// Возвращает версию контракта SPI.
//
// Возвращаемое значение:
//   Число - Версия 1.
Функция ВерсияКонтракта() Экспорт
	Возврат 1;
КонецФункции

// Возвращает реализованные возможности генератора.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Возможности из каталога.
Функция Возможности() Экспорт

	Результат = КоллекцииМоделиCURL.Скопировать(РеализованныеВозможности());

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

// Генерирует код Коннектора для всех операций контекста.
//
// Параметры:
//   КонтекстГенерацииКода - КонтекстГенерацииКода - Снимок операций и настроек вызова.
//
// Возвращаемое значение:
//   Строка - Код операций, разделённых пустой строкой.
//
// Исключения:
//   argument - Передана неизвестная локаль.
Функция Сгенерировать(КонтекстГенерацииКода) Экспорт

	Локаль = КонтекстГенерацииКода.Локаль();
	ПроверитьЛокаль(Локаль);

	Формирователь = Новый ФормировательНабораОперацийCURL(
		Новый ФормировательКодаОперацииКоннектораCURL,
		"ГенераторПрограммногоКодаКоннекторHTTP"
	);

	Возврат Формирователь.Сформировать(
		КонтекстГенерацииКода.Операции(),
		Локаль,
		КонтекстГенерацииКода.ФорматДесериализацииОтвета(),
		КонтекстГенерацииКода.ВозможностиГенератора()
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РеализованныеВозможности()

	Результат = Новый Массив;
	Результат.Добавить(КодыВозможностейГенератораCURL.ПротоколHTTP());
	Результат.Добавить(КодыВозможностейГенератораCURL.ПротоколHTTPS());
	Результат.Добавить(КодыВозможностейГенератораCURL.НесколькоОпераций());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЯвныйМетодЗапроса());
	Результат.Добавить(КодыВозможностейГенератораCURL.ТолькоМетаданные());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЧастиСтрокиЗапроса());
	Результат.Добавить(КодыВозможностейГенератораCURL.ПорядокЗаголовков());
	Результат.Добавить(КодыВозможностейГенератораCURL.ПустыеЗаголовки());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЗаголовкиJSON());
	Результат.Добавить(КодыВозможностейГенератораCURL.ДанныеТела());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЗагрузкаФайла());
	Результат.Добавить(КодыВозможностейГенератораCURL.СоставноеТело());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЗаголовкиЧасти());
	Результат.Добавить(КодыВозможностейГенератораCURL.ИмяФайлаЧасти());
	Результат.Добавить(КодыВозможностейГенератораCURL.ТипСодержимогоЧасти());
	Результат.Добавить(КодыВозможностейГенератораCURL.КодированиеДанныхURL());
	Результат.Добавить(КодыВозможностейГенератораCURL.ЧтениеФайла());
	Результат.Добавить(КодыВозможностейГенератораCURL.УчетныеДанные());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияBasic());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияDigest());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияNegotiate());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияNTLM());
	Результат.Добавить(КодыВозможностейГенератораCURL.ТокенOAuth2());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияOAuth2Bearer());
	Результат.Добавить(КодыВозможностейГенератораCURL.ПроксиHTTP());
	Результат.Добавить(КодыВозможностейГенератораCURL.УчетныеДанныеПрокси());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияПроксиBasic());
	Результат.Добавить(КодыВозможностейГенератораCURL.АутентификацияПроксиNTLM());
	Результат.Добавить(КодыВозможностейГенератораCURL.СертификатКлиента());
	Результат.Добавить(КодыВозможностейГенератораCURL.ФайлУдостоверяющегоЦентра());
	Результат.Добавить(КодыВозможностейГенератораCURL.СистемноеХранилищеСертификатов());
	Результат.Добавить(КодыВозможностейГенератораCURL.ПереходПоПеренаправлениям());

#Использовать i18n

#Использовать "../../../shared"

Перем _Локаль; // Строка
Перем _Пакет; // ПакетРесурсовЛокализации, Неопределено
Перем _ИмяПакетаГенератора; // Строка
Перем _ПакетГенератора; // ПакетРесурсовЛокализации, Неопределено
Перем _ПакетКлючевыхСлов; // ПакетРесурсовЛокализации, Неопределено
Перем _ОбщийПакет; // ПакетРесурсовЛокализации, Неопределено
Перем _ГруппаПакетов; // ГруппаПакетовРесурсовЛокализации, Неопределено

#Область ОбработчикиСобытий

// Создаёт локализацию выпускаемого программного кода.
//
// Параметры:
//   Локаль - Строка - Поддерживаемая локаль из модуля ЛокалиКонвертацииCURL.
//   ИмяПакетаГенератора - Строка - Имя дополнительного пакета ресурсов генератора.
Процедура ПриСозданииОбъекта(Локаль, ИмяПакетаГенератора = "")

	_Локаль = Локаль;
	_ИмяПакетаГенератора = ИмяПакетаГенератора;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Заполняет литералы {t(Ключ)} и переводит идентификаторы выпускаемого кода по ресурсам i18n.
// Строковые литералы, комментарии и неизвестные идентификаторы сохраняются.
//
// Параметры:
//   Код - Строка - Русский программный код.
//
// Возвращаемое значение:
//   Строка - Код с английскими именами платформенного API.
//
// Исключения:
//   Исключение - Файл ресурсов локализации недоступен или поврежден.
Функция Перевести(Код) Экспорт

	Код = ЗаполнитьШаблон(Код);

	Если _Локаль = ЛокалиКонвертацииCURL.Русская() Тогда
		Возврат Код;
	КонецЕсли;

	Результат = Новый Массив;
	Индекс = 1;
	ВСтроке = Ложь;
	ВКомментарии = Ложь;

	Пока Индекс <= СтрДлина(Код) Цикл

		Знак = Сред(Код, Индекс, 1);

		Если Знак = Символы.ПС Тогда
			ВКомментарии = Ложь;
		ИначеЕсли Не ВСтроке И Сред(Код, Индекс, 2) = "//" Тогда
			ВКомментарии = Истина;
		ИначеЕсли Не ВКомментарии И Знак = """" Тогда
			ВСтроке = Не ВСтроке;
		КонецЕсли;

		Если Не ВСтроке И Не ВКомментарии И ЭтоБуква(Знак) Тогда

			Начало = Индекс;
			Пока Индекс <= СтрДлина(Код) Цикл
				Знак = Сред(Код, Индекс, 1);
				Если Не ЭтоБуква(Знак) И Знак <> "." Тогда
					Прервать;
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;

			Слово = Сред(Код, Начало, Индекс - Начало);
			Результат.Добавить(ПеревестиИмя(Слово));

		Иначе
			Результат.Добавить(Знак);
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

// Заполняет литералы {t(Ключ)} в шаблоне по ресурсам i18n.
//
// Параметры:
//   Шаблон - Строка - Текст с литералами ресурсов.
//
// Возвращаемое значение:
//   Строка - Заполненный шаблон.
Функция ЗаполнитьШаблон(Шаблон) Экспорт

	ПолучитьГруппуПакетов().ЗаполнитьШаблон(Шаблон);

	Возврат Шаблон;

КонецФункции

// Возвращает перевод одного ключа из общего пакета генераторов.
//
// Параметры:
//   Ключ - Строка - Ключ ресурса.
//
// Возвращаемое значение:
//   Строка - Локализованное значение ресурса.
//
// Исключения:
//   Исключение - Пакет или запрошенный ресурс недоступен.
Функция ПолучитьРесурс(Ключ) Экспорт

	Для Каждого Пакет Из ПакетыЛокализации() Цикл
		Результат = ПереводИзПакета(Пакет, Ключ, Ложь);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПакет()

	Если _Пакет <> Неопределено Тогда
		Возврат _Пакет;
	КонецЕсли;

	_Пакет = Новый ЛокализацияCURL().ПолучитьПакет(
		"КодГенераторовCURL",
		_Локаль
	);

	Возврат _Пакет;

КонецФункции

Функция ПолучитьПакетГенератора()

	Если ПустаяСтрока(_ИмяПакетаГенератора) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если _ПакетГенератора = Неопределено Тогда
		_ПакетГенератора = Новый ЛокализацияCURL().ПолучитьПакет(
			_ИмяПакетаГенератора,
			_Локаль
		);
	КонецЕсли;

	Возврат _ПакетГенератора;

КонецФункции

Функция ПолучитьПакетКлючевыхСлов()

	Если _ПакетКлючевыхСлов = Неопределено Тогда
		_ПакетКлючевыхСлов = Новый ЛокализацияCURL().ПолучитьПакет("КлючевыеСловаЯзыка", _Локаль);
	КонецЕсли;

	Возврат _ПакетКлючевыхСлов;

КонецФункции

Функция ПолучитьОбщийПакет()

	Если _ОбщийПакет = Неопределено Тогда
		_ОбщийПакет = Новый ЛокализацияCURL().ПолучитьПакет("Общий", _Локаль);
	КонецЕсли;

	Возврат _ОбщийПакет;

КонецФункции

Функция ПакетыЛокализации()

	Пакеты = Новый Массив;
	Если ПолучитьПакетГенератора() <> Неопределено Тогда
		Пакеты.Добавить(ПолучитьПакетГенератора());
	КонецЕсли;

	Пакеты.Добавить(ПолучитьПакет());
	Пакеты.Добавить(ПолучитьПакетКлючевыхСлов());
	Пакеты.Добавить(ПолучитьОбщийПакет());

	Возврат Пакеты;

КонецФункции

Функция ПолучитьГруппуПакетов()

	Если _ГруппаПакетов <> Неопределено Тогда
		Возврат _ГруппаПакетов;
	КонецЕсли;

	_ГруппаПакетов = Новый ГруппаПакетовРесурсовЛокализации;
	Для Каждого Пакет Из ПакетыЛокализации() Цикл
		_ГруппаПакетов.ДобавитьПакет(Пакет);
	КонецЦикла;

	Возврат _ГруппаПакетов;

КонецФункции

Функция ПеревестиИмя(Имя)

	Перевод = ПереводИмени(Имя);
	Если Перевод <> Неопределено Тогда
		Если СтрНайти(Имя, ".") > 0 И СтрНайти(Перевод, ".") = 0 Тогда
			Позиция = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
			Возврат ПеревестиИмя(Лев(Имя, Позиция - 1)) + "." + Перевод;
		КонецЕсли;

		Возврат Перевод;
	КонецЕсли;

	Перевод = ПеревестиИмяССуффиксом(Имя);
	Если Перевод <> Неопределено Тогда
		Возврат Перевод;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Имя, ".", Истина) Цикл
		Перевод = ПереводИмени(Часть);
		Части.Добавить(?(Перевод = Неопределено, Часть, Перевод));
	КонецЦикла;

	Возврат СтрСоединить(Части, ".");

КонецФункции

Функция ПереводИмени(Имя)

	Для Каждого Пакет Из ПакетыЛокализации() Цикл
		Перевод = ПереводИзПакета(Пакет, Имя, Истина);
		Если Перевод <> Неопределено Тогда
			Возврат Перевод;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПереводИзПакета(Пакет, Имя, ИскатьИмяПеременной)

	Перевод = Пакет.ПолучитьРесурс(Имя);
	Если ИскатьИмяПеременной И (Перевод = Неопределено Или ПустаяСтрока(Перевод)) Тогда
		Перевод = Пакет.ПолучитьРесурс("Переменная." + Имя);
	КонецЕсли;
	Если Перевод <> Неопределено И ПустаяСтрока(Перевод) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Перевод;

КонецФункции

Функция ПеревестиИмяССуффиксом(Имя)

	Позиция = СтрНайти(Имя, "_", НаправлениеПоиска.СКонца);
	Если Позиция <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Суффикс = Сред(Имя, Позиция + 1);
	Если Не ЭтоЧисло(Суффикс) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Перевод = ПереводИмени(Лев(Имя, Позиция - 1));
	Возврат ?(Перевод = Неопределено, Неопределено, Перевод + "_" + Суффикс);

КонецФункции

Функция ЭтоЧисло(Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоБуква(Знак)
	Возврат СтрНайти("_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
		+ "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Знак) > 0;
КонецФункции

#КонецОбласти

#Использовать i18n

#Использовать "../../../shared"

Перем _Локаль; // Строка
Перем _Пакет; // ПакетРесурсовЛокализации, Неопределено

#Область ОбработчикиСобытий

// Создаёт локализацию выпускаемого программного кода.
//
// Параметры:
//   Локаль - Строка - Поддерживаемая локаль из модуля ЛокалиКонвертацииCURL.
Процедура ПриСозданииОбъекта(Локаль)

	_Локаль = Локаль;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Переводит идентификаторы выпускаемого кода по ресурсам i18n.
// Строковые литералы, комментарии и неизвестные идентификаторы сохраняются.
//
// Параметры:
//   Код - Строка - Русский программный код.
//
// Возвращаемое значение:
//   Строка - Код с английскими именами платформенного API.
//
// Исключения:
//   Исключение - Файл ресурсов локализации недоступен или поврежден.
Функция Перевести(Код) Экспорт

	Если _Локаль = ЛокалиКонвертацииCURL.Русская() Тогда
		Возврат Код;
	КонецЕсли;

	Пакет = ПолучитьПакет();
	Результат = Новый Массив;
	Индекс = 1;
	ВСтроке = Ложь;
	ВКомментарии = Ложь;

	Пока Индекс <= СтрДлина(Код) Цикл

		Знак = Сред(Код, Индекс, 1);

		Если Знак = Символы.ПС Тогда
			ВКомментарии = Ложь;
		ИначеЕсли Не ВСтроке И Сред(Код, Индекс, 2) = "//" Тогда
			ВКомментарии = Истина;
		ИначеЕсли Не ВКомментарии И Знак = """" Тогда
			ВСтроке = Не ВСтроке;
		КонецЕсли;

		Если Не ВСтроке И Не ВКомментарии И ЭтоБуква(Знак) Тогда

			Начало = Индекс;
			Пока Индекс <= СтрДлина(Код) Цикл
				Знак = Сред(Код, Индекс, 1);
				Если Не ЭтоБуква(Знак) И Знак <> "." Тогда
					Прервать;
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;

			Слово = Сред(Код, Начало, Индекс - Начало);
			Результат.Добавить(ПеревестиИмя(Слово, Пакет));

		Иначе
			Результат.Добавить(Знак);
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

// Возвращает перевод одного ключа из общего пакета генераторов.
//
// Параметры:
//   Ключ - Строка - Ключ ресурса.
//
// Возвращаемое значение:
//   Строка - Локализованное значение ресурса.
//
// Исключения:
//   Исключение - Пакет или запрошенный ресурс недоступен.
Функция ПолучитьРесурс(Ключ) Экспорт

	Возврат ПолучитьПакет().ПолучитьСтроку(Ключ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПакет()

	Если _Пакет <> Неопределено Тогда
		Возврат _Пакет;
	КонецЕсли;

	_Пакет = Новый ЛокализацияCURL().ПолучитьПакет(
		"КодГенераторовCURL",
		_Локаль
	);

	Возврат _Пакет;

КонецФункции

Функция ПеревестиИмя(Имя, Пакет)

	Перевод = Пакет.ПолучитьРесурс(Имя);
	Если Перевод <> Неопределено Тогда
		Возврат Перевод;
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Имя, ".", Истина) Цикл
		Перевод = Пакет.ПолучитьРесурс(Часть);
		Части.Добавить(?(Перевод = Неопределено, Часть, Перевод));
	КонецЦикла;

	Возврат СтрСоединить(Части, ".");

КонецФункции

Функция ЭтоБуква(Знак)
	Возврат СтрНайти("_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
		+ "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ", Знак) > 0;
КонецФункции

#КонецОбласти

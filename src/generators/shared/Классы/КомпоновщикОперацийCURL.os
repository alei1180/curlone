#Область ПрограммныйИнтерфейс

// Выносит одинаковую подготовку из кода нескольких операций.
//
// Параметры:
//   Операции - Массив из Структура - Код отдельных операций:
//     * Подготовка - Строка - Код подготовки операции.
//     * ПодготовкаTLS - Строка - Необязательный код настройки защищённого соединения.
//     * ПодготовкаПрокси - Строка - Необязательный код настройки прокси.
//     * Выполнение - Строка - Код отдельной операции.
//     * Соединение - Строка - Необязательный код соединения.
//     * РазделительВыполнения - Строка - Необязательный разделитель перед выполнением.
//   ВыноситьСоединение - Булево - Определяет необходимость выноса одинакового соединения.
//
// Возвращаемое значение:
//   Структура - ОбщийКод и Фрагменты без общей подготовки.
Функция ВынестиОбщуюПодготовку(Операции, ВыноситьСоединение = Ложь) Экспорт

	ОбщиеЧасти = Новый Массив;
	ОбщаяПодготовка = ПолучитьОбщееПоле(Операции, "Подготовка");
	ПодготовкаВынесена = ДобавитьОбщуюЧасть(ОбщиеЧасти, ОбщаяПодготовка);

	ОбщаяПодготовкаTLS = "";
	Если ПодготовкаВынесена Или Не ЕстьНепустоеПоле(Операции, "Подготовка") Тогда
		ОбщаяПодготовкаTLS = ПолучитьОбщееПоле(Операции, "ПодготовкаTLS", Истина);
	КонецЕсли;

	ПодготовкаTLSВынесена = ДобавитьОбщуюЧасть(ОбщиеЧасти, ОбщаяПодготовкаTLS);

	ОбщаяПодготовкаПрокси = "";
	Если (ПодготовкаВынесена Или Не ЕстьНепустоеПоле(Операции, "Подготовка"))
		И (ПодготовкаTLSВынесена Или Не ЕстьНепустоеПоле(Операции, "ПодготовкаTLS")) Тогда
		ОбщаяПодготовкаПрокси = ПолучитьОбщееПоле(Операции, "ПодготовкаПрокси");
	КонецЕсли;
	ПодготовкаПроксиВынесена = ДобавитьОбщуюЧасть(ОбщиеЧасти, ОбщаяПодготовкаПрокси);

	СоединениеВынесено = Ложь;
	Если ВыноситьСоединение
		И (ПодготовкаВынесена Или Не ЕстьНепустоеПоле(Операции, "Подготовка"))
		И (ПодготовкаTLSВынесена Или Не ЕстьНепустоеПоле(Операции, "ПодготовкаTLS"))
		И (ПодготовкаПроксиВынесена Или Не ЕстьНепустоеПоле(Операции, "ПодготовкаПрокси")) Тогда
		СоединениеВынесено = ДобавитьОбщуюЧасть(
			ОбщиеЧасти,
			ПолучитьОбщееПоле(Операции, "Соединение")
		);
	КонецЕсли;

	Фрагменты = Новый Массив;
	Для Каждого Операция Из Операции Цикл
		Фрагменты.Добавить(СобратьОперацию(
			Операция,
			ПодготовкаВынесена,
			ПодготовкаTLSВынесена,
			ПодготовкаПроксиВынесена,
			СоединениеВынесено
		));
	КонецЦикла;

	Возврат Новый Структура(
		"ОбщийКод, Фрагменты",
		СтрСоединить(ОбщиеЧасти, Символы.ПС + Символы.ПС),
		Фрагменты
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОбщееПоле(Операции, ИмяПоля, ПропускатьПустые = Ложь)

	Если Операции.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	ОбщееЗначение = Неопределено;
	Для Каждого Операция Из Операции Цикл
		Значение = "";
		Операция.Свойство(ИмяПоля, Значение);

		Если ПустаяСтрока(Значение) Тогда
			Если ПропускатьПустые Тогда
				Продолжить;
			КонецЕсли;
			Возврат "";
		КонецЕсли;

		Если ОбщееЗначение = Неопределено Тогда
			ОбщееЗначение = Значение;
		ИначеЕсли ОбщееЗначение <> Значение Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ОбщееЗначение = Неопределено, "", ОбщееЗначение);

КонецФункции

Функция ЕстьНепустоеПоле(Операции, ИмяПоля)

	Для Каждого Операция Из Операции Цикл
		Значение = "";
		Операция.Свойство(ИмяПоля, Значение);
		Если Не ПустаяСтрока(Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДобавитьОбщуюЧасть(ОбщиеЧасти, Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбщиеЧасти.Добавить(Значение);

	Возврат Истина;

КонецФункции

Функция СобратьОперацию(
	Операция,
	ПодготовкаВынесена,
	ПодготовкаTLSВынесена,
	ПодготовкаПроксиВынесена,
	СоединениеВынесено
)

	Результат = "";
	Результат = ДобавитьПоле(Результат, Операция, "Подготовка", ПодготовкаВынесена);
	Результат = ДобавитьПоле(Результат, Операция, "ПодготовкаTLS", ПодготовкаTLSВынесена);
	Результат = ДобавитьПоле(Результат, Операция, "ПодготовкаПрокси", ПодготовкаПроксиВынесена);
	Результат = ДобавитьПоле(Результат, Операция, "Соединение", СоединениеВынесено);

	РазделительВыполнения = Символы.ПС + Символы.ПС;
	Если Не Операция.Свойство("РазделительВыполнения", РазделительВыполнения) Тогда
		РазделительВыполнения = Символы.ПС + Символы.ПС;
	КонецЕсли;

	Возврат ДобавитьЧасть(Результат, Операция.Выполнение, РазделительВыполнения);

КонецФункции

Функция ДобавитьПоле(Код, Операция, ИмяПоля, ПолеВынесено)

	Если ПолеВынесено Тогда
		Возврат Код;
	КонецЕсли;

	Значение = "";
	Операция.Свойство(ИмяПоля, Значение);

	Возврат ДобавитьЧасть(Код, Значение, Символы.ПС + Символы.ПС);

КонецФункции

Функция ДобавитьЧасть(Код, Часть, Разделитель)

	Если ПустаяСтрока(Часть) Тогда
		Возврат Код;
	КонецЕсли;

	Если ПустаяСтрока(Код) Тогда
		Возврат Часть;
	КонецЕсли;

	Возврат Код + Разделитель + Часть;

КонецФункции

#КонецОбласти

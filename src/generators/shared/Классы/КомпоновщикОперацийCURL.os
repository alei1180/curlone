#Область ПрограммныйИнтерфейс

// Выносит одинаковую подготовку из кода нескольких операций.
//
// Параметры:
//   Фрагменты - Массив из Строка - Код отдельных операций.
//
// Возвращаемое значение:
//   Структура - ОбщийКод и Фрагменты без общей подготовки.
Функция ВынестиОбщуюПодготовку(Фрагменты, ВыноситьСоединение = Ложь) Экспорт

	ОбщиеБлоки = Новый Массив;
	Если ВыноситьСоединение Тогда
		ВынестиОбщуюСтрокуСоединения(Фрагменты, ОбщиеБлоки);
	КонецЕсли;

	БлокиОпераций = Новый Массив;
	Для Каждого Фрагмент Из Фрагменты Цикл
		БлокиОпераций.Добавить(РазбитьНаБлоки(Фрагмент));
	КонецЦикла;

	Пока ЕстьОбщийБлок(БлокиОпераций) Цикл
		ОбщийБлок = БлокиОпераций[0][0];
		Если Не ЭтоПодготовка(ОбщийБлок) Тогда
			Прервать;
		КонецЕсли;

		ОбщиеБлоки.Добавить(ОбщийБлок);
		Для Каждого Блоки Из БлокиОпераций Цикл
			Блоки.Удалить(0);
		КонецЦикла;
	КонецЦикла;

	ВынестиНеобязательноеЗащищенноеСоединение(БлокиОпераций, ОбщиеБлоки);

	Остатки = Новый Массив;
	Для Каждого Блоки Из БлокиОпераций Цикл
		Остатки.Добавить(СтрСоединить(Блоки, Символы.ПС + Символы.ПС));
	КонецЦикла;

	Возврат Новый Структура(
		"ОбщийКод, Фрагменты",
		СтрСоединить(ОбщиеБлоки, Символы.ПС + Символы.ПС),
		Остатки
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазбитьНаБлоки(Код)

	Результат = Новый Массив;
	Разделитель = Символы.ПС + Символы.ПС;
	Остаток = Код;

	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, Разделитель);
		Если Позиция = 0 Тогда
			Результат.Добавить(Остаток);
			Прервать;
		КонецЕсли;

		Результат.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + СтрДлина(Разделитель));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЕстьОбщийБлок(БлокиОпераций)

	Если БлокиОпераций.Количество() < 2 Или БлокиОпераций[0].Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйБлок = БлокиОпераций[0][0];
	Для Индекс = 1 По БлокиОпераций.ВГраница() Цикл
		Если БлокиОпераций[Индекс].Количество() = 0 Или БлокиОпераций[Индекс][0] <> ПервыйБлок Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоПодготовка(Блок)

	ДопустимыеНачала = Новый Массив;
	ДопустимыеНачала.Добавить("Заголовки =");
	ДопустимыеНачала.Добавить("ЧтениеТекста =");
	ДопустимыеНачала.Добавить("Данные =");
	ДопустимыеНачала.Добавить("ТелоЗапроса =");
	ДопустимыеНачала.Добавить("ЧастиТелаЗапроса =");
	ДопустимыеНачала.Добавить("Прокси =");
	ДопустимыеНачала.Добавить("ЗащищенноеСоединение =");
	ДопустимыеНачала.Добавить("РазделительMultipart =");

	Для Каждого Начало Из ДопустимыеНачала Цикл
		Если СтрНачинаетсяС(Блок, Начало) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ВынестиОбщуюСтрокуСоединения(Фрагменты, ОбщиеБлоки)

	ОбщаяСтрока = Неопределено;
	Для Каждого Фрагмент Из Фрагменты Цикл
		Позиция = СтрНайти(Фрагмент, Символы.ПС);
		ПерваяСтрока = ?(Позиция = 0, Фрагмент, Лев(Фрагмент, Позиция - 1));

		Если Не СтрНачинаетсяС(ПерваяСтрока, "Соединение =") Тогда
			Возврат;
		КонецЕсли;

		Если ОбщаяСтрока = Неопределено Тогда
			ОбщаяСтрока = ПерваяСтрока;
		ИначеЕсли ОбщаяСтрока <> ПерваяСтрока Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если ОбщаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбщиеБлоки.Добавить(ОбщаяСтрока);

	Для Индекс = 0 По Фрагменты.ВГраница() Цикл
		Фрагменты[Индекс] = Сред(Фрагменты[Индекс], СтрДлина(ОбщаяСтрока) + 2);
	КонецЦикла;

КонецПроцедуры

Процедура ВынестиНеобязательноеЗащищенноеСоединение(БлокиОпераций, ОбщиеБлоки)

	ОбщийБлок = Неопределено;
	Для Каждого Блоки Из БлокиОпераций Цикл
		Если Блоки.Количество() = 0 Или Не СтрНачинаетсяС(Блоки[0], "ЗащищенноеСоединение =") Тогда
			Продолжить;
		КонецЕсли;

		Если ОбщийБлок = Неопределено Тогда
			ОбщийБлок = Блоки[0];
		ИначеЕсли ОбщийБлок <> Блоки[0] Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Если ОбщийБлок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбщиеБлоки.Добавить(ОбщийБлок);
	Для Каждого Блоки Из БлокиОпераций Цикл
		Если Блоки.Количество() > 0 И Блоки[0] = ОбщийБлок Тогда
			Блоки.Удалить(0);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Соединяет каталог с выражением имени файла средствами языка 1С.
//
// Параметры:
//   Код - ПостроительКодаCURL - Код, в который добавляется подготовка каталога из переменной.
//   Каталог - ВыражениеЗначенияCURL - Каталог результата.
//   ИмяФайла - Строка - Готовое выражение имени файла.
//   Выражения - ГенераторВыраженийCURL - Представление строковых литералов.
//
// Возвращаемое значение:
//   Строка - Выражение полного пути файла.
Функция Соединить(Код, Каталог, ИмяФайла, Выражения) Экспорт

	Если Каталог.ЯвляетсяЛитералом() Тогда

		ПутьКаталога = Каталог.ЛитеральноеЗначение();
		Если ПутьКаталога = "" Тогда
			Возврат ИмяФайла;
		КонецЕсли;

		Если Прав(ПутьКаталога, 1) <> "/" И Прав(ПутьКаталога, 1) <> "\" Тогда
			ПутьКаталога = ПутьКаталога + "/";
		КонецЕсли;

		Возврат Выражения.Литерал(ПутьКаталога) + " + " + ИмяФайла;

	КонецЕсли;

	Код.ДобавитьСтроку("Каталог = %1;", Код.ПредставитьВыражение(Каталог));
	Код.ДобавитьСтроку("Если Каталог <> """" И Прав(Каталог, 1) <> ""/"" И Прав(Каталог, 1) <> ""\"" Тогда");
	Код.ДобавитьСтроку("%1Каталог = Каталог + ""/"";", Символы.Таб);
	Код.ДобавитьСтроку("КонецЕсли;");
	Код.ДобавитьСтроку();

	Возврат "Каталог + " + ИмяФайла;

КонецФункции

// Добавляет создание родительского каталога файла.
//
// Параметры:
//   Код - ПостроительКодаCURL - Код, в который добавляется создание каталога.
//   ИмяФайла - Строка - Готовое выражение полного имени файла.
//
// Возвращаемое значение:
//   Строка - Имя переменной с полным именем файла.
Функция ДобавитьСозданиеКаталога(Код, ИмяФайла) Экспорт

	Код.ДобавитьСтроку("ИмяФайлаОтвета = %1;", ИмяФайла);
	Код.ДобавитьСтроку("Каталог = Новый Файл(ИмяФайлаОтвета).Путь;");
	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку("Если Не ПустаяСтрока(Каталог) Тогда");
	Код.ДобавитьСтроку("%1СоздатьКаталог(Каталог);", Символы.Таб);
	Код.ДобавитьСтроку("КонецЕсли;");

	Возврат "ИмяФайлаОтвета";

КонецФункции

#КонецОбласти

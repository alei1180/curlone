Перем _Строки; // Массив из Строка
Перем _ГенераторВыражений; // ГенераторВыраженийCURL, Неопределено

#Область ОбработчикиСобытий

// Создаёт построитель программного кода.
//
// Параметры:
//   ГенераторВыражений - ГенераторВыраженийCURL, Неопределено - Представление выражений с переменными.
Процедура ПриСозданииОбъекта(ГенераторВыражений = Неопределено)

	_Строки = Новый Массив;
	_ГенераторВыражений = ГенераторВыражений;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет строку к формируемому коду.
//
// Параметры:
//   Шаблон - Строка, Неопределено - Строка с заполнителями %1, %2 и %3 либо пустая строка.
//   Значение1 - Произвольный - Первое значение шаблона.
//   Значение2 - Произвольный - Второе значение шаблона.
//   Значение3 - Произвольный - Третье значение шаблона.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ДобавитьСтроку(
	Шаблон = Неопределено,
	Значение1 = Неопределено,
	Значение2 = Неопределено,
	Значение3 = Неопределено
) Экспорт

	Если Шаблон = Неопределено Тогда
		СтрокаКода = "";
	ИначеЕсли Значение1 = Неопределено И Значение2 = Неопределено И Значение3 = Неопределено Тогда
		СтрокаКода = Шаблон;
	ИначеЕсли Значение3 <> Неопределено Тогда
		СтрокаКода = СтрШаблон(
			Шаблон,
			ЗначениеШаблона(Значение1),
			ЗначениеШаблона(Значение2),
			ЗначениеШаблона(Значение3)
		);
	ИначеЕсли Значение2 <> Неопределено Тогда
		СтрокаКода = СтрШаблон(
			Шаблон,
			ЗначениеШаблона(Значение1),
			ЗначениеШаблона(Значение2)
		);
	Иначе
		СтрокаКода = СтрШаблон(Шаблон, ЗначениеШаблона(Значение1));
	КонецЕсли;

	_Строки.Добавить(СтрокаКода);

	Возврат ЭтотОбъект;

КонецФункции

// Возвращает сформированный код без пустых строк по краям.
//
// Возвращаемое значение:
//   Строка - Сформированный код.
Функция ПолучитьРезультат() Экспорт

	Возврат СокрЛП(СтрСоединить(_Строки, Символы.ПС));

КонецФункции

// Представляет значение как литерал программного кода.
//
// Параметры:
//   Значение - Строка, Число, Булево, Дата, Неопределено - Исходное значение.
//
// Возвращаемое значение:
//   Строка - Литерал встроенного языка или пустая строка для неподдерживаемого значения.
Функция ПараметрВСтроку(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат ПредставитьСтроку(Значение);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ПредставитьДату(Значение);
	КонецЕсли;

	Возврат "";

КонецФункции

// Представляет выражение модели с подстановкой переменных.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение модели.
//
// Возвращаемое значение:
//   Строка - Выражение целевого языка.
//
// Исключения:
//   Исключение - Построитель создан без генератора выражений.
Функция ПредставитьВыражение(Выражение) Экспорт

	Если _ГенераторВыражений = Неопределено Тогда
		ВызватьИсключение "Для подстановки переменных не задан генератор выражений";
	КонецЕсли;

	Возврат _ГенераторВыражений.Представить(Выражение);

КонецФункции

// Оформляет параметры вызова и отбрасывает пустые параметры справа.
//
// Параметры:
//   Параметры - Массив - Готовые выражения или значения простых типов.
//
// Возвращаемое значение:
//   Строка - Параметры через запятую, при большой длине по одному на строке.
Функция ПараметрыФункцииВСтроку(Параметры) Экспорт

	Выражения = ПредставитьПараметры(Параметры);
	УдалитьПустыеСправа(Выражения);

	Если Выражения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	ОднойСтрокой = СтрСоединить(Выражения, ", ");
	Если СтрДлина(ОднойСтрокой) <= 110 Тогда
		Возврат ОднойСтрокой;
	КонецЕсли;

	Возврат СтрСоединить(Выражения, "," + Символы.ПС + Символы.Таб);

КонецФункции

// Добавляет вызов процедуры или функции.
//
// Параметры:
//   ЛеваяЧасть - Строка - Получатель результата вместе со знаком равенства либо пустая строка.
//   Имя - Строка - Имя вызываемого метода.
//   Параметры - Массив - Готовые выражения или значения простых типов.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ДобавитьВызов(ЛеваяЧасть, Имя, Параметры) Экспорт

	ПараметрыВСтроку = ПараметрыФункцииВСтроку(Параметры);
	Возврат ДобавитьСтроку("%1%2(%3);", ЛеваяЧасть, Имя, ПараметрыВСтроку);

КонецФункции

// Добавляет объявление массива.
//
// Параметры:
//   Имя - Строка - Имя переменной или путь к элементу.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ОбъявитьМассив(Имя) Экспорт

	Возврат ДобавитьСтроку("%1 = Новый Массив();", Имя);

КонецФункции

// Добавляет готовое выражение в массив.
//
// Параметры:
//   Имя - Строка - Имя массива или путь к нему.
//   Выражение - Строка - Готовое выражение целевого языка.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ДобавитьВМассив(Имя, Выражение) Экспорт

	Возврат ДобавитьСтроку("%1.Добавить(%2);", Имя, Выражение);

КонецФункции

// Добавляет объявление соответствия.
//
// Параметры:
//   Имя - Строка - Имя переменной или путь к элементу.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ОбъявитьСоответствие(Имя) Экспорт

	Возврат ДобавитьСтроку("%1 = Новый Соответствие();", Имя);

КонецФункции

// Добавляет готовые выражения ключа и значения в соответствие.
//
// Параметры:
//   Имя - Строка - Имя соответствия или путь к нему.
//   Ключ - Строка - Готовое выражение ключа целевого языка.
//   Значение - Строка - Готовое выражение значения целевого языка.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ВставитьВСоответствие(Имя, Ключ, Значение) Экспорт

	Возврат ДобавитьСтроку("%1.Вставить(%2, %3);", Имя, Ключ, Значение);

КонецФункции

// Формирует дерево массивов и соответствий из значений простых типов.
//
// Параметры:
//   Имя - Строка - Имя переменной результата.
//   Коллекция - Массив, Соответствие - Исходное дерево значений.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
//
// Исключения:
//   Исключение - Передано значение другого типа.
Функция ДобавитьКоллекцию(Имя, Коллекция) Экспорт

	ТипКоллекции = ТипЗнч(Коллекция);
	Если ТипКоллекции = Тип("Соответствие") Тогда
		ОбъявитьСоответствие(Имя);
	ИначеЕсли ТипКоллекции = Тип("Массив") Тогда
		ОбъявитьМассив(Имя);
	Иначе
		ВызватьИсключение "Для формирования кода ожидался массив или соответствие";
	КонецЕсли;

	ДобавитьЭлементыКоллекции(Коллекция, Имя);
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет присваивание выражения, перенося каждую последующую часть на новую строку.
//
// Параметры:
//   Имя - Строка - Имя переменной результата.
//   Выражения - Массив из Строка - Готовые части выражения.
//   Разделитель - Строка - Литеральный разделитель между частями.
//
// Возвращаемое значение:
//   ПостроительКодаCURL - Этот объект.
Функция ДобавитьСоставноеВыражение(Имя, Выражения, Разделитель = "") Экспорт

	Если Выражения.Количество() = 0 Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	Если Выражения.Количество() = 1 Тогда
		Возврат ДобавитьСтроку("%1 = %2;", Имя, Выражения[0]);
	КонецЕсли;

	ДобавитьСтроку("%1 = %2", Имя, Выражения[0]);
	Для Индекс = 1 По Выражения.ВГраница() Цикл
		Префикс = ?(ПустаяСтрока(Разделитель), "", ПараметрВСтроку(Разделитель) + " + ");
		Окончание = ?(Индекс = Выражения.ВГраница(), ";", "");
		ДобавитьСтроку("%1+ %2%3", Символы.Таб, Префикс, Выражения[Индекс] + Окончание);
	КонецЦикла;

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеШаблона(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ПараметрВСтроку(Значение);

КонецФункции

Функция ПредставитьСтроку(Знач Текст)

	Текст = СтрЗаменить(Текст, """", """""");
	Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ПС + "|");

	Возврат """" + Текст + """";

КонецФункции

Функция ПредставитьДату(Дата)

	Если НачалоДня(Дата) = Дата Тогда
		Возврат Формат(Дата, "ДФ='''Дата(''yyyy, M, d'')'''");
	КонецЕсли;

	Возврат Формат(Дата, "ДФ='''Дата(''yyyy, M, d, H, m, s'')'''");

КонецФункции

Функция ПредставитьПараметры(Параметры)

	Результат = Новый Массив;
	Для Каждого Параметр Из Параметры Цикл

		Если ТипЗнч(Параметр) = Тип("Строка") Тогда
			Результат.Добавить(Параметр);
		Иначе
			Результат.Добавить(ПараметрВСтроку(Параметр));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура УдалитьПустыеСправа(Выражения)

	Пока Выражения.Количество() > 0 Цикл

		Индекс = Выражения.ВГраница();
		Если ЗначениеЗаполнено(Выражения[Индекс]) Тогда
			Прервать;
		КонецЕсли;

		Выражения.Удалить(Индекс);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЭлементыКоллекции(Коллекция, Путь)

	ЭтоСоответствие = ТипЗнч(Коллекция) = Тип("Соответствие");
	Индекс = 0;

	Для Каждого Элемент Из Коллекция Цикл

		Если ЭтоСоответствие Тогда
			Ключ = Элемент.Ключ;
			Значение = Элемент.Значение;
			ПутьЭлемента = Путь + "[" + ПараметрВСтроку(Ключ) + "]";
		Иначе
			Ключ = Неопределено;
			Значение = Элемент;
			ПутьЭлемента = Путь + "[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]";
		КонецЕсли;

		ТипЗначения = ТипЗнч(Значение);
		ЭтоВложеннаяКоллекция = ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("Массив");

		Если ЭтоВложеннаяКоллекция Тогда
			Конструктор = ?(ТипЗначения = Тип("Соответствие"), "Новый Соответствие()", "Новый Массив()");

			Если ЭтоСоответствие Тогда
				ВставитьВСоответствие(Путь, ПараметрВСтроку(Ключ), Конструктор);
			Иначе
				ДобавитьВМассив(Путь, Конструктор);
			КонецЕсли;

			ДобавитьЭлементыКоллекции(Значение, ПутьЭлемента);
		ИначеЕсли ЭтоСоответствие Тогда
			ВставитьВСоответствие(Путь, ПараметрВСтроку(Ключ), ПредставитьЗначениеКоллекции(Значение));
		Иначе
			ДобавитьВМассив(Путь, ПредставитьЗначениеКоллекции(Значение));
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Функция ПредставитьЗначениеКоллекции(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	Возврат ПараметрВСтроку(Значение);

КонецФункции

#КонецОбласти

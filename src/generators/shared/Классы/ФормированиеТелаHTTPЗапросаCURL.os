#Использовать "../../../generation"

Перем _Выражения; // ГенераторВыраженийCURL

Перем _ИмяТела; // Строка
Перем _ИмяЗаголовков; // Строка
Перем _ИмяЗапроса; // Строка
Перем _ТекстовыеФайлыMultipart; // Соответствие из КлючИЗначение

#Область ОбработчикиСобытий

// Создает формирователь тела с общими именами переменных операции.
//
// Параметры:
//   Выражения - ГенераторВыраженийCURL - Представление значений целевого кода.
//   ИмяТела - Строка - Переменная результата; пустая строка означает установку тела HTTPЗапрос.
//   ИмяЗаголовков - Строка - Выражение доступа к соответствию заголовков.
//   ИмяЗапроса - Строка - Переменная HTTP-запроса, в которую устанавливается тело.
Процедура ПриСозданииОбъекта(
	Выражения,
	ИмяТела = "",
	ИмяЗаголовков = "HTTPЗапрос.Заголовки",
	ИмяЗапроса = "HTTPЗапрос"
)

	_Выражения = Выражения;
	_ИмяТела = ИмяТела;
	_ИмяЗаголовков = ИмяЗаголовков;
	_ИмяЗапроса = ИмяЗапроса;
	_ТекстовыеФайлыMultipart = Новый Соответствие;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие составной формы.
//
// Параметры:
//   Части - ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части тела.
//
// Возвращаемое значение:
//   Булево - Истина для multipart/form-data.
Функция ЭтоСоставнаяФорма(Части) Экспорт

	Для Каждого Часть Из Части Цикл
		ИмяОпции = Часть.Источник().УказанноеИмяОпции();
		Если Часть.Вид() = "multipart_field" Или ИмяОпции = "-F" Или ИмяОпции = "--form"
			Или ИмяОпции = "--form-string" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Добавляет чтение текстовых файлов и создание разделителя multipart.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Части - ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части формы.
Процедура ПодготовитьСоставнуюФорму(Код, Части) Экспорт

	НомерФайла = 0;
	Для Индекс = 0 По Части.ВГраница() Цикл
		Часть = Части[Индекс];
		Если Не ЭтоТекстовыйФайлСоставнойФормы(Часть) Тогда
			Продолжить;
		КонецЕсли;

		НомерФайла = НомерФайла + 1;
		ИмяПеременной = "ТекстовыеДанныеФайла_" + Строка(НомерФайла);
		_ТекстовыеФайлыMultipart.Вставить(Индекс, ИмяПеременной);

		Если Часть.ИмяПоля() = Неопределено Тогда
			_Выражения.ЗарегистрироватьПеременныеДоРазделителя(Часть.Выражение(), "=");
		КонецЕсли;

		Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", ПредставитьПуть(Часть));
		Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);
		Код.ДобавитьСтроку();
	КонецЦикла;

	Код.ДобавитьСтроку("РазделительMultipart = СтрЗаменить(Новый УникальныйИдентификатор, ""-"", """");");
	Код.ДобавитьСтроку();

КонецПроцедуры

// Записывает составную форму в поток HTTP-запроса.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Части - ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части формы.
//   Возможности - ФиксированныйМассив из Строка - Возможности генератора.
Процедура ДобавитьСоставнуюФорму(Код, Части, Возможности) Экспорт

	Код.ДобавитьСтроку("Поток = HTTPЗапрос.ПолучитьТелоКакПоток();");
	Код.ДобавитьСтроку();
	Код.ДобавитьСтроку("РазделительСтрок = Символы.ВК + Символы.ПС;");
	Код.ДобавитьСтроку("ЗаписьДанных = Новый ЗаписьДанных(Поток, , , """", """");");

	Для Индекс = 0 По Части.ВГраница() Цикл
		ДобавитьЧастьСоставнойФормы(Код, Части[Индекс], Индекс, Возможности);
	КонецЦикла;

	Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(""--"" + РазделительMultipart + ""--"" + РазделительСтрок);");
	Код.ДобавитьСтроку("ЗаписьДанных.Закрыть();");

КонецПроцедуры

// Добавляет код установки тела существующего ЗапросHTTP. Файлы читает только выпускаемый код.
//
// Параметры:
//   Строки - ПостроительКодаCURL - Построитель целевого кода.
//   Части - ФиксированныйМассив из ЧастьТелаЗапросаCURL - Части подготовленного тела.
//   Возможности - Массив, ФиксированныйМассив из Строка - Возможности генератора.
//   ТипСодержимогоЗадан - Булево - Тип содержимого установлен или подавлен операцией над заголовком.
Процедура ДобавитьТелоИзЧастей(Строки, Части, Возможности, ТипСодержимогоЗадан = Ложь) Экспорт

	Подготовленные = Новый Массив;
	СоставнаяФорма = Ложь;

	Для Каждого Часть Из Части Цикл
		Если Не Доступна(Часть, Возможности) Тогда
			Продолжить;
		КонецЕсли;

		Подготовленные.Добавить(Часть);
		СоставнаяФорма = СоставнаяФорма Или Часть.Вид() = "multipart_field";
	КонецЦикла;

	Если Подготовленные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Строки.ДобавитьСтроку("ЧастиТелаHTTP = Новый Массив;");

	Если СоставнаяФорма Тогда
		Строки.ДобавитьСтроку("ГраницаФормы = Строка(Новый УникальныйИдентификатор);");
		Если Не ТипСодержимогоЗадан Тогда
			Строки.ДобавитьСтроку(
				"%1.Вставить(""Content-Type"", ""multipart/form-data; boundary="" + ГраницаФормы);",
				_ИмяЗаголовков
			);
		КонецЕсли;
	ИначеЕсли Подготовленные[0].Вид() = "data" И Не ТипСодержимогоЗадан Тогда
		Строки.ДобавитьСтроку(
			"%1.Вставить(""Content-Type"", ""application/x-www-form-urlencoded"");",
			_ИмяЗаголовков
		);
	КонецЕсли;

	Индекс = 0;
	Для Каждого Часть Из Подготовленные Цикл
		Если СоставнаяФорма Тогда
			ДобавитьЗаголовокЧасти(Строки, Часть, Возможности);
		ИначеЕсли Индекс > 0 И Часть.РазделительПеред() = "ampersand" Тогда
			ДобавитьТекстовыеБайты(Строки, _Выражения.Литерал("&"));
		КонецЕсли;

		ДобавитьСодержимое(Строки, Часть.Текст(), Часть.ПутьКФайлу(), Часть.Выражение());
		Если Часть.РежимИсточника() = "text_file_without_crlf_nul" Тогда
			ДобавитьКомментарийОбУдаленииБайтов(Строки);
		КонецЕсли;

		Если Часть.Кодировать() = Истина Тогда
			ДобавитьТекстДляКодирования(Строки);
			Префикс = ?(Часть.ИмяПоля() = Неопределено, "", Часть.ИмяПоля() + "=");
			Строки.ДобавитьСтроку(
				"ДанныеЧасти = %1;",
				Байты(_Выражения.Литерал(Префикс) + " + ТекстЧасти")
			);
		КонецЕсли;

		Строки.ДобавитьСтроку("ЧастиТелаHTTP.Добавить(ДанныеЧасти);");
		Если СоставнаяФорма Тогда
			ДобавитьТекстовыеБайты(Строки, "Символы.ВК + Символы.ПС");
		КонецЕсли;

		Индекс = Индекс + 1;
	КонецЦикла;

	Если СоставнаяФорма Тогда
		ДобавитьТекстовыеБайты(Строки, """--"" + ГраницаФормы + ""--"" + Символы.ВК + Символы.ПС");
	КонецЕсли;

	Если ПустаяСтрока(_ИмяТела) Тогда
		Строки.ДобавитьСтроку(
			"%1.УстановитьТелоИзДвоичныхДанных(СоединитьДвоичныеДанные(ЧастиТелаHTTP));",
			_ИмяЗапроса
		);
	Иначе
		Строки.ДобавитьСтроку("%1 = СоединитьДвоичныеДанные(ЧастиТелаHTTP);", _ИмяТела);
	КонецЕсли;

КонецПроцедуры

// Добавляет части строки запроса к переменной Адрес перед созданием HTTPЗапрос.
//
// Параметры:
//   Строки - ПостроительКодаCURL - Построитель целевого кода.
//   Части - ФиксированныйМассив из ЧастьСтрокиЗапросаCURL - Части строки запроса.
//   Возможности - Массив, ФиксированныйМассив из Строка - Возможности генератора.
Процедура ДобавитьСтрокуЗапроса(Строки, Части, Возможности) Экспорт

	Если Возможности.Найти(КодыВозможностейГенератораCURL.ЧастиСтрокиЗапроса()) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если Часть.ВидИсточника() = "stdin" Или Часть.ОтложеннаяКлассификация() <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Часть.ПутьКФайлу() <> Неопределено
			И Возможности.Найти(КодыВозможностейГенератораCURL.ЧтениеФайла()) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Часть.Кодировать() = Истина
			И Возможности.Найти(КодыВозможностейГенератораCURL.КодированиеДанныхURL()) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДобавитьСодержимое(Строки, Часть.Текст(), Часть.ПутьКФайлу(), Часть.Выражение());
		Если Часть.РежимИсточника() = "text_file_without_crlf_nul" Тогда
			ДобавитьКомментарийОбУдаленииБайтов(Строки);
		КонецЕсли;

		Если Часть.Кодировать() = Истина Тогда
			ДобавитьТекстДляКодирования(Строки);
		Иначе
			Строки.ДобавитьСтроку(
				"%1",
				"ТекстЧасти = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЧасти, КодировкаТекста.UTF8);"
			);
		КонецЕсли;

		Префикс = ?(Часть.Имя() = Неопределено, "", Часть.Имя());
		Если Часть.ДобавлятьЗнакРавно() = Истина Тогда
			Префикс = Префикс + "=";
		КонецЕсли;

		Строки.ДобавитьСтроку(
			"Адрес = Адрес + ?(СтрНайти(Адрес, ""?"") = 0, ""?"", ""&"") + %1 + ТекстЧасти;",
			_Выражения.Литерал(Префикс)
		);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЧастьСоставнойФормы(Код, Часть, Индекс, Возможности)

	Имя = ПредставитьИмяПоля(Часть);
	Метка = МеткаПоля(Часть);
	Код.ДобавитьСтроку("// {t(Текст.Начало)} %1", Метка);
	Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(""--"" + РазделительMultipart + РазделительСтрок);");

	ЛитеральноеИмяПоля = ЛитеральноеЗначениеКода(Имя);
	ИмяФайла = ?(ЭтоДвоичныйФайлСоставнойФормы(Часть), ПредставитьИмяФайла(Часть), "");
	ЛитеральноеИмяФайла = ЛитеральноеЗначениеКода(ИмяФайла);

	Если ЛитеральноеИмяПоля <> Неопределено
		И (ПустаяСтрока(ИмяФайла) Или ЛитеральноеИмяФайла <> Неопределено) Тогда
		ТекстДиспозиции = "Content-Disposition: form-data; name=""" + ЭкранироватьИмя(ЛитеральноеИмяПоля) + """";

		Если ЭтоДвоичныйФайлСоставнойФормы(Часть)
			И Возможности.Найти(КодыВозможностейГенератораCURL.ИмяФайлаЧасти()) <> Неопределено Тогда
			ТекстДиспозиции = ТекстДиспозиции + "; filename=""" + ЭкранироватьИмя(ЛитеральноеИмяФайла) + """";
		КонецЕсли;

		Диспозиция = _Выражения.Литерал(ТекстДиспозиции);
	Иначе
		Диспозиция = ПредставитьДинамическуюДиспозицию(Часть, Имя, Возможности);
	КонецЕсли;

	Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);", Диспозиция);

	ДобавитьЗаголовкиСоставнойЧасти(Код, Часть, Возможности);

	Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);");
	Если ЭтоДвоичныйФайлСоставнойФормы(Часть) Тогда
		Код.ДобавитьСтроку("ЗаписьДанных.Записать(Новый ДвоичныеДанные(%1));", ПредставитьПуть(Часть));
		Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);");
	ИначеЕсли _ТекстовыеФайлыMultipart.Получить(Индекс) <> Неопределено Тогда
		Код.ДобавитьСтроку(
			"ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);",
			_ТекстовыеФайлыMultipart[Индекс]
		);
	Иначе
		Код.ДобавитьСтроку("ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);", ПредставитьЗначение(Код, Часть));
	КонецЕсли;

	Код.ДобавитьСтроку("// {t(Текст.Конец)} %1", Метка);

КонецПроцедуры

Функция ПредставитьДинамическуюДиспозицию(Часть, Имя, Возможности)

	Кавычка = Символ(34);
	ЧастиДиспозиции = Новый Массив;
	ЧастиДиспозиции.Добавить(_Выражения.Литерал("Content-Disposition: form-data; name=" + Кавычка));
	ЧастиДиспозиции.Добавить(Имя);

	Если ЭтоДвоичныйФайлСоставнойФормы(Часть)
		И Возможности.Найти(КодыВозможностейГенератораCURL.ИмяФайлаЧасти()) <> Неопределено Тогда
		ЧастиДиспозиции.Добавить(_Выражения.Литерал(Кавычка + "; filename=" + Кавычка));
		ЧастиДиспозиции.Добавить(ПредставитьИмяФайла(Часть));
	КонецЕсли;

	ЧастиДиспозиции.Добавить(_Выражения.Литерал(Кавычка));

	Возврат СтрСоединить(ЧастиДиспозиции, " + ");

КонецФункции

Функция ЛитеральноеЗначениеКода(Представление)

	Если СтрДлина(Представление) >= 2 И Лев(Представление, 1) = """"
		И Прав(Представление, 1) = """" И СтрНайти(Представление, " + ") = 0 Тогда
		Возврат Сред(Представление, 2, СтрДлина(Представление) - 2);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьЗаголовкиСоставнойЧасти(Код, Часть, Возможности)

	ЭтоСтроковоеПоле = Часть.Источник().УказанноеИмяОпции() = "--form-string";
	Если Не ЭтоСтроковоеПоле
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТипСодержимогоЧасти()) <> Неопределено Тогда
		Если Часть.MIMEТип() <> Неопределено Тогда
			Если СтрНайти(Часть.MIMEТип(), ",@") = 0 Тогда
				Код.ДобавитьСтроку(
					"ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);",
					_Выражения.Литерал("Content-Type: " + Часть.MIMEТип())
				);
			ИначеЕсли ЭтоДвоичныйФайлСоставнойФормы(Часть) Тогда
				Код.ДобавитьСтроку(
					"ЗаписьДанных.ЗаписатьСтроку(""Content-Type: application/octet-stream"" + РазделительСтрок);"
				);
			КонецЕсли;
		ИначеЕсли ЭтоДвоичныйФайлСоставнойФормы(Часть) Тогда
			ПредставлениеТипа = ПредставитьТипСодержимого(Часть);

			Если Не ПустаяСтрока(ПредставлениеТипа) Тогда
				Код.ДобавитьСтроку(
					"ЗаписьДанных.ЗаписатьСтроку(""Content-Type: "" + %1 + РазделительСтрок);",
					ПредставлениеТипа
				);
				ПредставлениеТипа = "";
			Иначе
				ТипСодержимого = ТипСодержимогоПоИмени(ЛитеральноеИмяФайла(Часть));
			КонецЕсли;

			Если ПустаяСтрока(ПредставлениеТипа) И Не ПустаяСтрока(ТипСодержимого) Тогда
				Код.ДобавитьСтроку(
					"ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);",
					_Выражения.Литерал("Content-Type: " + ТипСодержимого)
				);
			КонецЕсли;
		Иначе
			ПредставлениеТипа = ПредставитьТипСодержимого(Часть);

			Если Не ПустаяСтрока(ПредставлениеТипа) Тогда
				Код.ДобавитьСтроку(
					"ЗаписьДанных.ЗаписатьСтроку(""Content-Type: "" + %1 + РазделительСтрок);",
					ПредставлениеТипа
				);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Возможности.Найти(КодыВозможностейГенератораCURL.ЗаголовкиЧасти()) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Заголовок Из Часть.Заголовки() Цикл
		Если Заголовок.Имя() <> Неопределено И Заголовок.Значение() <> Неопределено Тогда
			Код.ДобавитьСтроку(
				"ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);",
				_Выражения.Литерал(Заголовок.Имя() + ": " + СокрЛП(Заголовок.Значение()))
			);
		КонецЕсли;
	КонецЦикла;

	Если Часть.Заголовки().Количество() = 0 Тогда
		ПредставлениеЗаголовка = ПредставитьЗаголовокИзШаблона(Часть);
		Если Не ПустаяСтрока(ПредставлениеЗаголовка) Тогда
			Код.ДобавитьСтроку(
				"ЗаписьДанных.ЗаписатьСтроку(%1 + РазделительСтрок);",
				ПредставлениеЗаголовка
			);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ТипСодержимогоПоИмени(ИмяФайла)

	Позиция = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Расширение = ?(Позиция = 0, "", НРег(Сред(ИмяФайла, Позиция + 1)));

	Если Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "html" Или Расширение = "htm" Тогда
		Возврат "text/html";
	КонецЕсли;

	Возврат "application/octet-stream";

КонецФункции

Функция ПредставитьИмяПоля(Часть)

	Если Часть.ИмяПоля() <> Неопределено Тогда
		Возврат _Выражения.Литерал(Часть.ИмяПоля());
	КонецЕсли;

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, "=");

	Возврат _Выражения.ПредставитьШаблон(Лев(Шаблон, Позиция - 1), Часть.Выражение());

КонецФункции

Функция МеткаПоля(Часть)

	Если Часть.ИмяПоля() <> Неопределено Тогда
		Возврат Часть.ИмяПоля();
	КонецЕсли;

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, "=");
	Имя = Лев(Шаблон, Позиция - 1);

	Если СтрНачинаетсяС(Имя, "curlonevariable") Тогда
		Для Каждого Фрагмент Из Часть.Выражение().Фрагменты() Цикл
			Если Фрагмент.Вид <> "text" Тогда
				Возврат Фрагмент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Не ПустаяСтрока(Имя) Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат "Поле";

КонецФункции

Функция ПредставитьИмяФайла(Часть)

	Если Часть.ИмяФайла() <> Неопределено Тогда
		Возврат _Выражения.Литерал(Часть.ИмяФайла());
	КонецЕсли;

	Шаблон = ОсновноеЗначениеСоставнойФормы(Часть);

	Возврат _Выражения.ПредставитьШаблон(Сред(Шаблон, 2), Часть.Выражение());

КонецФункции

Функция ЭтоДвоичныйФайлСоставнойФормы(Часть)

	Если Часть.Источник().УказанноеИмяОпции() = "--form-string" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.ИмяФайла() <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	ПозицияРавно = СтрНайти(Шаблон, "=");

	Возврат ПозицияРавно > 0 И Сред(Шаблон, ПозицияРавно + 1, 1) = "@";

КонецФункции

Функция ЭтоТекстовыйФайлСоставнойФормы(Часть)

	Если Часть.Источник().УказанноеИмяОпции() = "--form-string" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.ПутьКФайлу() <> Неопределено И Часть.ИмяФайла() = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	ПозицияРавно = СтрНайти(Шаблон, "=");

	Возврат ПозицияРавно > 0 И Сред(Шаблон, ПозицияРавно + 1, 1) = "<";

КонецФункции

Функция ЛитеральноеИмяФайла(Часть)

	Если Часть.ИмяФайла() <> Неопределено Тогда
		Возврат Часть.ИмяФайла();
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПредставитьПуть(Часть)

	Если Часть.ПутьКФайлу() <> Неопределено Тогда
		Возврат _Выражения.Литерал(Часть.ПутьКФайлу());
	КонецЕсли;

	Шаблон = ОсновноеЗначениеСоставнойФормы(Часть);

	Возврат _Выражения.ПредставитьШаблон(Сред(Шаблон, 2), Часть.Выражение());

КонецФункции

Функция ПредставитьЗначение(Код, Часть)

	Если Часть.Текст() <> Неопределено Тогда
		Возврат Код.ПараметрВСтроку(Часть.Текст());
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(ОсновноеЗначениеСоставнойФормы(Часть), Часть.Выражение());

КонецФункции

Функция ОсновноеЗначениеСоставнойФормы(Часть)

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, "=");
	Значение = Сред(Шаблон, Позиция + 1);
	ПозицияПараметров = СтрНайти(Значение, ";");

	Возврат ?(ПозицияПараметров = 0, Значение, Лев(Значение, ПозицияПараметров - 1));

КонецФункции

Функция ПредставитьТипСодержимого(Часть)

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, ";type=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Тип = Сред(Шаблон, Позиция + 6);
	КонецТипа = СтрНайти(Тип, ";");
	Если КонецТипа > 0 Тогда
		Тип = Лев(Тип, КонецТипа - 1);
	КонецЕсли;

	Если СтрНайти(Тип, ",@") > 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(Тип, Часть.Выражение());

КонецФункции

Функция ПредставитьЗаголовокИзШаблона(Часть)

	Шаблон = _Выражения.СтрокаДляРазбора(Часть.Выражение());
	Позиция = СтрНайти(Шаблон, ";headers=");

	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Заголовок = Сред(Шаблон, Позиция + 9);
	Если СтрНачинаетсяС(Заголовок, """") И СтрЗаканчиваетсяНа(Заголовок, """") Тогда
		Заголовок = Сред(Заголовок, 2, СтрДлина(Заголовок) - 2);
	КонецЕсли;

	Возврат _Выражения.ПредставитьШаблон(Заголовок, Часть.Выражение());

КонецФункции

Функция Доступна(Часть, Возможности)

	Возможность = КодыВозможностейГенератораCURL.ДанныеТела();
	Если Часть.Вид() = "multipart_field" Тогда
		Возможность = КодыВозможностейГенератораCURL.СоставноеТело();
	ИначеЕсли Часть.Вид() = "upload_file" Тогда
		Возможность = КодыВозможностейГенератораCURL.ЗагрузкаФайла();
	КонецЕсли;

	Если Возможности.Найти(Возможность) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.Кодировать() = Истина
		И Возможности.Найти(КодыВозможностейГенератораCURL.КодированиеДанныхURL()) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.ТребуетРазбора() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Часть.РежимИсточника() = "stdin" Или Часть.РежимИсточника() = "nonblocking_stdin" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Часть.ПутьКФайлу() = Неопределено
		Или Возможности.Найти(КодыВозможностейГенератораCURL.ЧтениеФайла()) <> Неопределено;

КонецФункции

Процедура ДобавитьСодержимое(Строки, Текст, Путь, Выражение)

	Если Путь <> Неопределено Тогда
		Строки.ДобавитьСтроку("ДанныеЧасти = Новый ДвоичныеДанные(%1);", _Выражения.Литерал(Путь));
	ИначеЕсли Текст <> Неопределено Тогда
		Строки.ДобавитьСтроку("ДанныеЧасти = %1;", Байты(_Выражения.Литерал(Текст)));
	Иначе
		Строки.ДобавитьСтроку("ДанныеЧасти = %1;", Байты(Строки.ПредставитьВыражение(Выражение)));
	КонецЕсли;

КонецПроцедуры

Функция Байты(Текст)
	Возврат "ПолучитьДвоичныеДанныеИзСтроки(" + Текст + ", КодировкаТекста.UTF8, Ложь)";
КонецФункции

Процедура ДобавитьТекстовыеБайты(Строки, Выражение)
	Строки.ДобавитьСтроку("ЧастиТелаHTTP.Добавить(%1);", Байты(Выражение));
КонецПроцедуры

Процедура ДобавитьКомментарийОбУдаленииБайтов(Строки)

	Строки.ДобавитьСтроку("// {t(ТребуетсяУдалениеБайтовДанных)}");

КонецПроцедуры

Процедура ДобавитьТекстДляКодирования(Строки)

	Строки.ДобавитьСтроку("// {t(ТребуетсяКодированиеДанныхURL)}");
	Строки.ДобавитьСтроку(
		"ТекстЧасти = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЧасти, КодировкаТекста.UTF8);"
	);

КонецПроцедуры

Процедура ДобавитьЗаголовокЧасти(Строки, Часть, Возможности)

	Заголовок = "Content-Disposition: form-data; name=""" + ЭкранироватьИмя(Часть.ИмяПоля()) + """";
	Если Часть.ИмяФайла() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ИмяФайлаЧасти()) <> Неопределено Тогда
		Заголовок = Заголовок + "; filename=""" + ЭкранироватьИмя(Часть.ИмяФайла()) + """";
	КонецЕсли;

	Заголовок = Заголовок + Символы.ВК + Символы.ПС;

	Если Часть.MIMEТип() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТипСодержимогоЧасти()) <> Неопределено Тогда
		Заголовок = Заголовок + "Content-Type: " + Часть.MIMEТип() + Символы.ВК + Символы.ПС;
	ИначеЕсли Часть.ИмяФайла() <> Неопределено
		И Возможности.Найти(КодыВозможностейГенератораCURL.ТипСодержимогоЧасти()) <> Неопределено Тогда
		Заголовок = Заголовок + "Content-Type: application/octet-stream" + Символы.ВК + Символы.ПС;
	КонецЕсли;

	Для Каждого ЗаголовокЧасти Из Часть.Заголовки() Цикл
		Если Возможности.Найти(КодыВозможностейГенератораCURL.ЗаголовкиЧасти()) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗаголовокЧасти.Действие() = "set" Или ЗаголовокЧасти.Действие() = "add" Тогда
			Заголовок = Заголовок + ЗаголовокЧасти.Имя() + ": " + ЗаголовокЧасти.Значение()
				+ Символы.ВК + Символы.ПС;
		КонецЕсли;
	КонецЦикла;

	ДобавитьТекстовыеБайты(
		Строки,
		"""--"" + ГраницаФормы + Символы.ВК + Символы.ПС + "
			+ _Выражения.Литерал(Заголовок + Символы.ВК + Символы.ПС)
	);

КонецПроцедуры

Функция ЭкранироватьИмя(Значение)

	Результат = СтрЗаменить(Значение, """", "%22");
	Результат = СтрЗаменить(Результат, Символы.ВК, "%0D");
	Возврат СтрЗаменить(Результат, Символы.ПС, "%0A");

КонецФункции

#КонецОбласти

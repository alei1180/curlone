#Использовать "../../../syntax"

Перем _Локаль; // Строка
Перем _ИменаПеременных; // Соответствие из КлючИЗначение

#Область ОбработчикиСобытий

// Создаёт представление выражений для выпускаемого кода.
//
// Параметры:
//   Локаль - Строка - Локаль кода.
//   ИменаПеременных - Соответствие из КлючИЗначение - Общие имена переменных результата.
Процедура ПриСозданииОбъекта(Локаль, ИменаПеременных)

	_Локаль = Локаль;
	_ИменаПеременных = ИменаПеременных;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Представляет выражение значением языка 1С.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Выражение модели.
//
// Возвращаемое значение:
//   Строка - Выражение языка 1С.
Функция Представить(Выражение) Экспорт

	Если Выражение.ЯвляетсяЛитералом() Тогда
		Возврат Литерал(Выражение.ЛитеральноеЗначение());
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Текст() Тогда
			Если Не ПустаяСтрока(Фрагмент.Значение) Тогда
				Части.Добавить(Литерал(Фрагмент.Значение));
			КонецЕсли;
		Иначе
			Имя = ИмяПеременной(Фрагмент.Значение);
			Части.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, " + ");

КонецФункции

// Экранирует строковое значение для целевого кода.
//
// Параметры:
//   Значение - Строка - Значение литерала.
//
// Возвращаемое значение:
//   Строка - Выражение, сохраняющее кавычки и управляющие символы.
Функция Литерал(Значение) Экспорт

	Текст = СтрЗаменить(Значение, """", """" + """");
	Для Индекс = 0 По 31 Цикл
		Текст = СтрЗаменить(Текст, Символ(Индекс), """ + Символ(" + Строка(Индекс) + ") + """);
	КонецЦикла;

	Возврат """" + Текст + """";

КонецФункции

// Представляет часть выражения до первого указанного разделителя.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Разделитель - Строка - Односимвольный разделитель.
//
// Возвращаемое значение:
//   Строка - Выражение языка 1С.
Функция ПредставитьДоРазделителя(Выражение, Разделитель) Экспорт

	Возврат ПредставитьОтобранныеФрагменты(Выражение, Разделитель, Ложь, Ложь);

КонецФункции

// Представляет часть выражения после первого указанного разделителя.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Разделитель - Строка - Односимвольный разделитель.
//   УдалитьНачальныеПробелы - Булево - Удалить пробелы после разделителя.
//
// Возвращаемое значение:
//   Строка - Выражение языка 1С.
Функция ПредставитьПослеРазделителя(Выражение, Разделитель, УдалитьНачальныеПробелы = Ложь) Экспорт

	Возврат ПредставитьОтобранныеФрагменты(
		Выражение,
		Разделитель,
		Истина,
		УдалитьНачальныеПробелы
	);

КонецФункции

// Регистрирует имена переменных в части выражения до первого разделителя.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//   Разделитель - Строка - Односимвольный разделитель.
Процедура ЗарегистрироватьПеременныеДоРазделителя(Выражение, Разделитель) Экспорт

	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Текст() Тогда
			Если СтрНайти(Фрагмент.Значение, Разделитель) > 0 Тогда
				Прервать;
			КонецЕсли;
		Иначе
			ИмяПеременной(Фрагмент.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает строку для структурного разбора, заменяя переменные безопасными метками.
//
// Параметры:
//   Выражение - ВыражениеЗначенияCURL - Исходное выражение.
//
// Возвращаемое значение:
//   Строка - Строка с метками CURLONEVARIABLE<n>.
Функция СтрокаДляРазбора(Выражение) Экспорт

	Результат = "";
	ИндексПеременной = 0;

	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид = ВидыФрагментовТокенаCURL.Текст() Тогда
			Результат = Результат + Фрагмент.Значение;
		Иначе
			ИндексПеременной = ИндексПеременной + 1;
			Результат = Результат + "curlonevariable" + Строка(ИндексПеременной);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Восстанавливает выражение из строки после структурного разбора.
//
// Параметры:
//   Шаблон - Строка - Строка с метками CURLONEVARIABLE<n>.
//   ИсходноеВыражение - ВыражениеЗначенияCURL - Источник имён переменных.
//
// Возвращаемое значение:
//   Строка - Выражение языка 1С.
Функция ПредставитьШаблон(Шаблон, ИсходноеВыражение) Экспорт

	Переменные = Новый Массив;
	Для Каждого Фрагмент Из ИсходноеВыражение.Фрагменты() Цикл
		Если Фрагмент.Вид <> ВидыФрагментовТокенаCURL.Текст() Тогда
			Переменные.Добавить(Фрагмент.Значение);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Остаток = Шаблон;
	Для Индекс = 0 По Переменные.ВГраница() Цикл
		Метка = "curlonevariable" + Строка(Индекс + 1);
		Позиция = СтрНайти(Остаток, Метка);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;

		Текст = Лев(Остаток, Позиция - 1);
		Если Не ПустаяСтрока(Текст) Тогда
			Части.Добавить(Литерал(Текст));
		КонецЕсли;
		Части.Добавить(ИмяПеременной(Переменные[Индекс]));
		Остаток = Сред(Остаток, Позиция + СтрДлина(Метка));
	КонецЦикла;

	Если Не ПустаяСтрока(Остаток) Тогда
		Части.Добавить(Литерал(Остаток));
	КонецЕсли;

	Возврат ?(Части.Количество() = 0, Литерал(Шаблон), СтрСоединить(Части, " + "));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставитьОтобранныеФрагменты(Выражение, Разделитель, ЧастьПосле, УдалитьНачальныеПробелы)

	Части = Новый Массив;
	РазделительНайден = Ложь;
	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид <> ВидыФрагментовТокенаCURL.Текст() Тогда
			Если РазделительНайден = ЧастьПосле Тогда
				Части.Добавить(ИмяПеременной(Фрагмент.Значение));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Текст = Фрагмент.Значение;
		Если Не РазделительНайден Тогда
			Позиция = СтрНайти(Текст, Разделитель);
			Если Позиция = 0 Тогда
				Если Не ЧастьПосле И Не ПустаяСтрока(Текст) Тогда
					Части.Добавить(Литерал(Текст));
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			До = Лев(Текст, Позиция - 1);
			После = Сред(Текст, Позиция + СтрДлина(Разделитель));
			Если Не ЧастьПосле И Не ПустаяСтрока(До) Тогда
				Части.Добавить(Литерал(До));
			КонецЕсли;
			РазделительНайден = Истина;
			Текст = После;
		КонецЕсли;

		Если ЧастьПосле И РазделительНайден Тогда
			Если УдалитьНачальныеПробелы И Части.Количество() = 0 Тогда
				Текст = СокрЛ(Текст);
			КонецЕсли;
			Если Не ПустаяСтрока(Текст) Тогда
				Части.Добавить(Литерал(Текст));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Части.Количество() = 0, Литерал(""), СтрСоединить(Части, " + "));

КонецФункции

Функция ИмяПеременной(ИсходноеИмя)

	Имя = _ИменаПеременных.Получить(ИсходноеИмя);
	Если Имя = Неопределено Тогда
		Имя = ИсходноеИмя;
		_ИменаПеременных.Вставить(ИсходноеИмя, Имя);
	КонецЕсли;

	Возврат Имя;

КонецФункции

#КонецОбласти

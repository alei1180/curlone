#Использовать "../../../generation"

#Область ПрограммныйИнтерфейс


// Подготавливает данные операции без восстановления исходной команды.
//
// Параметры:
//   Операция - ОперацияCURL - Неизменяемая операция.
//   Возможности - ФиксированныйМассив из Строка - Снимок возможностей.
//
// Возвращаемое значение:
//   Структура - Операция, ЧастиТела, ЧастиСтрокиЗапроса, Заголовки.
Функция Подготовить(Операция, Возможности) Экспорт

	Запрос = Операция.Запрос();
	Заголовки = Новый Соответствие;
	Если Возможности.Найти(КодыВозможностейГенератораCURL.ПорядокЗаголовков()) <> Неопределено Тогда

		Для Каждого Заголовок Из Запрос.Заголовки() Цикл
			Имя = Заголовок.Имя();

			Если Имя = Неопределено Тогда
				Имя = ПолучитьИмяЗаголовкаИзВыражения(Заголовок.Выражение());
			КонецЕсли;

			Если Имя = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Ключ = НРег(Имя);
			Действие = Заголовок.Действие();

			Если (Действие = Неопределено Или Действие = "deferred") И Заголовок.Выражение() <> Неопределено Тогда
				Действие = "set";
			КонецЕсли;

			Если Действие = "remove"
				И Возможности.Найти(КодыВозможностейГенератораCURL.УдалениеЗаголовков()) <> Неопределено Тогда
				Заголовки.Вставить(
					Ключ,
					Новый Структура("Имя, Значение, Удален, Выражение", Имя, "", Истина, Заголовок.Выражение())
				);
			ИначеЕсли Действие = "set_if_absent" Тогда
				Если Возможности.Найти(КодыВозможностейГенератораCURL.ЗаголовкиJSON()) <> Неопределено
					И Заголовки.Получить(Ключ) = Неопределено Тогда
					Запись = Новый Структура(
						"Имя, Значение, Удален, Выражение",
						Имя,
						Заголовок.Значение(),
						Ложь,
						Заголовок.Выражение()
					);
					Заголовки.Вставить(Ключ, Запись);
				КонецЕсли;
			ИначеЕсли Действие = "set" Или (Действие = "set_empty"
				И Возможности.Найти(КодыВозможностейГенератораCURL.ПустыеЗаголовки()) <> Неопределено) Тогда
				Запись = Новый Структура(
					"Имя, Значение, Удален, Выражение",
					Имя,
					Заголовок.Значение(),
					Ложь,
					Заголовок.Выражение()
				);
				Заголовки.Вставить(Ключ, Запись);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Новый Структура(
		"Операция, ЧастиТела, ЧастиСтрокиЗапроса, Заголовки",
		Операция,
		Запрос.Тело().Части(),
		Запрос.СтрокаЗапроса().Части(),
		Заголовки
	);

КонецФункции

Функция ПолучитьИмяЗаголовкаИзВыражения(Выражение)

	Если Выражение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = "";
	Для Каждого Фрагмент Из Выражение.Фрагменты() Цикл
		Если Фрагмент.Вид <> "text" Тогда
			Возврат Неопределено;
		КонецЕсли;

		Позиция = СтрНайти(Фрагмент.Значение, ":");
		Если Позиция > 0 Тогда
			Возврат Имя + Лев(Фрагмент.Значение, Позиция - 1);
		КонецЕсли;

		Имя = Имя + Фрагмент.Значение;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

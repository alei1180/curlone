#Использовать "../../../domain"

#Область ПрограммныйИнтерфейс

// Добавляет чтение текстового файла с явным закрытием чтения.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Путь - Строка - Выражение пути к файлу в формируемом коде.
//   ИмяПеременной - Строка - Переменная, в которую читается содержимое файла.
Процедура Добавить(Код, Путь, ИмяПеременной) Экспорт

	Код.ДобавитьСтроку("ЧтениеТекста = Новый ЧтениеТекста(%1);", Путь);
	Код.ДобавитьСтроку("%1 = ЧтениеТекста.Прочитать();", ИмяПеременной);
	Код.ДобавитьСтроку("ЧтениеТекста.Закрыть();");

КонецПроцедуры

// Добавляет чтение текстового файла с обработкой, заданной частью запроса.
//
// Параметры:
//   Код - ПостроительКодаCURL - Формируемый код.
//   Часть - ЧастьТелаЗапросаCURL, ЧастьСтрокиЗапросаCURL - Описание источника файла.
//   Путь - Строка - Выражение пути к файлу в формируемом коде.
//   ИмяПеременной - Строка - Переменная, в которую читается содержимое файла.
Процедура ДобавитьСОбработкой(Код, Часть, Путь, ИмяПеременной) Экспорт

	Добавить(Код, Путь, ИмяПеременной);

	Если Часть.РежимИсточника() = РежимыИсточникаТелаCURL.ТекстовыйФайлБезCRLFNUL() Тогда
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ПС, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символы.ВК, """");", ИмяПеременной);
		Код.ДобавитьСтроку("%1 = СтрЗаменить(%1, Символ(0), """");", ИмяПеременной);
	КонецЕсли;

	Если Часть.Кодировать() = Истина Тогда
		Код.ДобавитьСтроку(
			"%1 = КодироватьСтроку(%1, СпособКодированияСтроки.КодировкаURL);",
			ИмяПеременной
		);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Использовать "../../../domain"

Перем _ФормировательОперации; // Произвольный
Перем _ИмяПакетаЛокализации; // Строка
Перем _ПередаватьПризнакФайловВКомпоновщик; // Булево

#Область ОбработчикиСобытий

// Создаёт формирователь кода для набора операций.
//
// Параметры:
//   ФормировательОперации - Произвольный - Объект с методом СформироватьКод.
//   ИмяПакетаЛокализации - Строка - Имя пакета ресурсов генератора.
//   ПередаватьПризнакФайловВКомпоновщик - Булево - Учитывать общую подготовку передачи файлов.
Процедура ПриСозданииОбъекта(
	ФормировательОперации,
	ИмяПакетаЛокализации,
	ПередаватьПризнакФайловВКомпоновщик = Ложь
)

	_ФормировательОперации = ФормировательОперации;
	_ИмяПакетаЛокализации = ИмяПакетаЛокализации;
	_ПередаватьПризнакФайловВКомпоновщик = ПередаватьПризнакФайловВКомпоновщик;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует локализованный код всех операций.
//
// Параметры:
//   Операции - ФиксированныйМассив из ОперацияПередачиCURL - Операции передачи.
//   Локаль - Строка - Локаль результата.
//   ФорматДесериализацииОтвета - Строка, Неопределено - Формат десериализации HTTP-ответа.
//   Возможности - ФиксированныйМассив из Строка - Возможности генератора.
//
// Возвращаемое значение:
//   Строка - Сформированный код операций.
Функция Сформировать(Операции, Локаль, ФорматДесериализацииОтвета, Возможности) Экспорт

	ОперацииСКодом = Новый Массив;
	Фрагменты = Новый Массив;

	Для Каждого Операция Из Операции Цикл
		Подготовленная = Новый ПодготовкаОперацииДляГенерацииCURL().ПодготовитьОперацию(
			Операция,
			Возможности
		);
		Код = _ФормировательОперации.СформироватьКод(
			Подготовленная,
			Локаль,
			ФорматДесериализацииОтвета,
			Возможности
		);

		Если Не ПустаяСтрока(Код) Тогда
			ОперацииСКодом.Добавить(Операция);
			Фрагменты.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	ВсеПередаютФайлы = ВсеОперацииПередаютФайлы(ОперацииСКодом);
	Компоновка = Скомпоновать(Фрагменты, ВсеПередаютФайлы);
	Результаты = ОформитьОперации(Компоновка, ОперацииСКодом, ВсеПередаютФайлы);
	Код = СтрСоединить(Результаты, Символы.ПС + Символы.ПС);

	Возврат Новый ЛокализацияКодаCURL(
		Локаль,
		_ИмяПакетаЛокализации
	).Перевести(Код);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Скомпоновать(Фрагменты, ВсеПередаютФайлы)

	Компоновщик = Новый КомпоновщикОперацийCURL;
	Если _ПередаватьПризнакФайловВКомпоновщик Тогда
		Возврат Компоновщик.ВынестиОбщуюПодготовку(Фрагменты, ВсеПередаютФайлы);
	КонецЕсли;

	Возврат Компоновщик.ВынестиОбщуюПодготовку(Фрагменты);

КонецФункции

Функция ОформитьОперации(Компоновка, Операции, ВсеПередаютФайлы)

	Результаты = Новый Массив;
	Если Не ПустаяСтрока(Компоновка.ОбщийКод) Тогда
		Результаты.Добавить(Компоновка.ОбщийКод);
	КонецЕсли;

	Для Индекс = 0 По Компоновка.Фрагменты.ВГраница() Цикл
		Результаты.Добавить(ОформитьОперацию(
			Компоновка.Фрагменты[Индекс],
			Операции[Индекс],
			Индекс + 1,
			Операции.Количество(),
			ВсеПередаютФайлы
		));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

Функция ОформитьОперацию(Код, Операция, НомерОперации, КоличествоОпераций, ВсеПередаютФайлы)

	Если КоличествоОпераций = 1 Тогда
		Возврат Код;
	КонецЕсли;

	Конструктор = Новый ПостроительКодаCURL;
	Если ВсеПередаютФайлы Тогда
		ДобавитьКомментарийПередачиФайла(Конструктор, Операция, НомерОперации);
	Иначе
		Конструктор.ДобавитьСтроку(
			"// {t(Текст.Запрос)} %1. %2",
			НомерОперации,
			Операция.Ресурс().ИсходныйАдрес().ЛитеральноеЗначение()
		);
	КонецЕсли;

	Конструктор.ДобавитьСтроку(Код);

	Возврат Конструктор.ПолучитьРезультат();

КонецФункции

Процедура ДобавитьКомментарийПередачиФайла(Конструктор, Операция, НомерОперации)

	Для Каждого Часть Из Операция.Запрос().Тело().Части() Цикл
		Если Часть.ПутьКФайлу() <> Неопределено Тогда
			Конструктор.ДобавитьСтроку(
				"// {t(Текст.ПередачаФайла)} %1. %2",
				НомерОперации,
				Часть.ПутьКФайлу()
			);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ВсеОперацииПередаютФайлы(Операции)

	Если Операции.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	ИсточникURL = Операции[0].Ресурс().Источник();
	Для Каждого Операция Из Операции Цикл
		Если Операция.Запрос().Тело().Вид() <> ВидыТелаЗапросаCURL.ЗагрузкаФайла() Тогда
			Возврат Ложь;
		КонецЕсли;

		Если Операция.Ресурс().Источник() <> ИсточникURL Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Использовать semaphore

Перем СвободныеКонвертеры; // Массив
Перем БлокировкаСвободныхКонвертеров; // БлокировкаРесурса
Перем СемафорАренды; // Семафор

#Область ПрограммныйИнтерфейс

// Получает свободный конвертер или создаёт новый в пределах максимума пула.
// Если все экземпляры арендованы, ожидает возврата одного из них.
//
// Возвращаемое значение:
//   КонвертерКомандыCURL - Арендованный конвертер.
Функция Получить() Экспорт

	СемафорАренды.Захватить();

	Попытка
		Конвертер = ИзвлечьСвободныйКонвертер();
		Если Конвертер = Неопределено Тогда
			Конвертер = СоздатьКонвертер();
		КонецЕсли;
	Исключение
		СемафорАренды.Освободить();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Конвертер;

КонецФункции

// Возвращает ранее арендованный конвертер в пул.
//
// Параметры:
//   Конвертер - КонвертерКомандыCURL - Возвращаемый экземпляр.
Процедура Вернуть(Конвертер) Экспорт

	БлокировкаСвободныхКонвертеров.Заблокировать();
	Попытка
		СвободныеКонвертеры.Добавить(Конвертер);
	Исключение
		БлокировкаСвободныхКонвертеров.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	БлокировкаСвободныхКонвертеров.Разблокировать();

	СемафорАренды.Освободить();

КонецПроцедуры

// Удаляет ранее арендованный конвертер из пула и освобождает место для нового.
// Используется, если состояние экземпляра после исключения нельзя считать корректным.
Процедура Отбросить() Экспорт

	СемафорАренды.Освободить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт динамический пул конвертеров.
//
// Параметры:
//   МаксимальноеКоличествоКонвертеров - Число - Предельное количество одновременно арендованных экземпляров.
Процедура ПриСозданииОбъекта(МаксимальноеКоличествоКонвертеров = 20)

	Если МаксимальноеКоличествоКонвертеров <= 0 Тогда
		ВызватьИсключение "Максимальное количество конвертеров должно быть больше нуля";
	КонецЕсли;

	СвободныеКонвертеры = Новый Массив();
	БлокировкаСвободныхКонвертеров = Новый БлокировкаРесурса(ЭтотОбъект);
	СемафорАренды = Новый Семафор(МаксимальноеКоличествоКонвертеров);

КонецПроцедуры

Функция СоздатьКонвертер()

	Конвертер = Новый КонвертерКомандыCURL();
	Конвертер.ПоддерживаемыеОпции();

	Возврат Конвертер;

КонецФункции

Функция ИзвлечьСвободныйКонвертер()

	БлокировкаСвободныхКонвертеров.Заблокировать();

	Попытка
		Если СвободныеКонвертеры.Количество() = 0 Тогда
			Конвертер = Неопределено;
		Иначе
			Индекс = СвободныеКонвертеры.ВГраница();
			Конвертер = СвободныеКонвертеры[Индекс];
			СвободныеКонвертеры.Удалить(Индекс);
		КонецЕсли;
	Исключение
		БлокировкаСвободныхКонвертеров.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	БлокировкаСвободныхКонвертеров.Разблокировать();

	Возврат Конвертер;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует договорные данные результата конвертации для внешних представлений.
//
// Параметры:
//   Результат - РезультатКонвертацииCURL - Код и диагностика конвертации.
//   ЗапрошеннаяЦель - Строка - Цель для результата без определенного генератора.
//
// Возвращаемое значение:
//   Структура - Поля success, target, code, errors и warnings.
Функция Сформировать(Результат, ЗапрошеннаяЦель) Экспорт

	Ошибки = Новый Массив;
	Предупреждения = Новый Массив;

	Для Каждого Диагностика Из Результат.Диагностика() Цикл
		Если Диагностика.Вид = ВидыДиагностикиКонвертацииCURL.Ошибка() Тогда
			Ошибки.Добавить(ОшибкаJSON(Диагностика));
		Иначе
			Предупреждения.Добавить(ПредупреждениеJSON(Диагностика));
		КонецЕсли;
	КонецЦикла;

	Цель = Результат.ИдентификаторГенератора();
	Если ПустаяСтрока(Цель) Тогда
		Цель = ЗапрошеннаяЦель;
	КонецЕсли;

	Возврат Новый Структура(
		"success,target,code,errors,warnings",
		Результат.Успешно(),
		Цель,
		Результат.Код(),
		Ошибки,
		Предупреждения
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаJSON(Диагностика)

	Возврат Новый Структура(
		"code,message,position",
		Диагностика.Код,
		Диагностика.Сообщение,
		ПозицияИлиNull(Диагностика.Позиция)
	);

КонецФункции

Функция ПредупреждениеJSON(Диагностика)

	Возврат Новый Структура(
		"code,message,capability,option,position,target",
		Диагностика.Код,
		Диагностика.Сообщение,
		ЗначениеИлиNull(Диагностика.ИдентификаторВозможности),
		ЗначениеИлиNull(Диагностика.ИсходнаяОпция),
		ПозицияИлиNull(Диагностика.Позиция),
		ЗначениеИлиNull(Диагностика.ИдентификаторГенератора)
	);

КонецФункции

Функция ЗначениеИлиNull(Значение)

	Если Значение = Неопределено Или Значение = "" Тогда
		Возврат Null;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПозицияИлиNull(Значение)

	Если Значение = Неопределено Или Значение < 1 Тогда
		Возврат Null;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

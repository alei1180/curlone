#Область ПрограммныйИнтерфейс

// Возвращает код успешного завершения.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция Успех() Экспорт
	Возврат 0;
КонецФункции

// Возвращает код внутренней ошибки приложения.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция ВнутренняяОшибка() Экспорт
	Возврат 1;
КонецФункции

// Возвращает код ошибки использования командной строки.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция ОшибкаИспользования() Экспорт
	Возврат 2;
КонецФункции

// Возвращает код ошибки разбора или преобразования команды curl.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция ОшибкаКонвертации() Экспорт
	Возврат 3;
КонецФункции

// Возвращает код ошибки выбора или контракта генератора.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция ОшибкаГенератора() Экспорт
	Возврат 4;
КонецФункции

// Возвращает код предупреждения, считающегося ошибкой.
//
// Возвращаемое значение:
//   Число - Код завершения.
Функция ПредупреждениеКакОшибка() Экспорт
	Возврат 5;
КонецФункции

#КонецОбласти

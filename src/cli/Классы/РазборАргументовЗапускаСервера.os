#Использовать errors

#Область ПрограммныйИнтерфейс

// Разбирает и проверяет аргументы команды serve.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы после serve.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - Поля Порт и ОткрытьВБраузере.
//
// Исключения:
//   argument.required - Отсутствует значение опции.
//   argument.invalid_value - Передана неизвестная опция или недопустимое значение.
Функция Разобрать(Аргументы) Экспорт

	Порт = Неопределено;
	ОткрытьВБраузере = Ложь;
	Индекс = 0;

	Пока Индекс < Аргументы.Количество() Цикл
		Аргумент = Аргументы[Индекс];

		Если Аргумент = "--open" Или Аргумент = "-o" Тогда
			ОткрытьВБраузере = Истина;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Опция = РазобратьОпцию(Аргументы, Индекс);
		Если Опция.Имя = "--port" Тогда
			Порт = ПроверитьПорт(Опция.Значение);
		Иначе
			ВызватьНедопустимыйАргумент();
		КонецЕсли;

		Индекс = Индекс + Опция.ЧислоАргументов + 1;
	КонецЦикла;

	Возврат Новый ФиксированнаяСтруктура("Порт,ОткрытьВБраузере", Порт, ОткрытьВБраузере);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьОпцию(Аргументы, Индекс)

	Аргумент = Аргументы[Индекс];
	ПозицияРавно = Найти(Аргумент, "=");
	Если ПозицияРавно > 0 Тогда
		Имя = НормализоватьИмя(Лев(Аргумент, ПозицияРавно - 1));
		Значение = Сред(Аргумент, ПозицияРавно + 1);
		Возврат Новый Структура("Имя,Значение,ЧислоАргументов", Имя, Значение, 0);
	КонецЕсли;

	Имя = НормализоватьИмя(Аргумент);
	Если Индекс = Аргументы.ВГраница() Или СтрНачинаетсяС(Аргументы[Индекс + 1], "-") Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Для опции " + Аргумент + " не указано значение"
		);
	КонецЕсли;

	Возврат Новый Структура(
		"Имя,Значение,ЧислоАргументов",
		Имя,
		Аргументы[Индекс + 1],
		1
	);

КонецФункции

Функция НормализоватьИмя(Имя)

	Если Имя = "-p" Тогда
		Возврат "--port";
	КонецЕсли;

	Если Имя <> "--port" Тогда
		ВызватьНедопустимыйАргумент();
	КонецЕсли;

	Возврат Имя;

КонецФункции

Функция ПроверитьПорт(Значение)

	Попытка
		Порт = Число(Значение);
	Исключение
		ВызватьНедопустимыйПорт();
	КонецПопытки;

	Если Порт <> Цел(Порт) Или Порт < 1 Или Порт > 65535 Тогда
		ВызватьНедопустимыйПорт();
	КонецЕсли;

	Возврат Порт;

КонецФункции

Процедура ВызватьНедопустимыйПорт()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
		"Порт должен быть целым числом от 1 до 65535"
	);

КонецПроцедуры

Процедура ВызватьНедопустимыйАргумент()

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
		"Неизвестная опция команды serve"
	);

КонецПроцедуры

#КонецОбласти

#Использовать errors

Перем _КодЗавершения; // Число
Перем _СтандартныйВывод; // Строка
Перем _ВыводОшибок; // Строка
Перем _ПутьВывода; // Строка, Неопределено
Перем _СодержимоеФайла; // Строка

#Область ОбработчикиСобытий

// Создаёт результат выполнения команды curlone.
//
// Параметры:
//   КодЗавершения - Число - Код завершения процесса.
//   СтандартныйВывод - Строка - Текст для stdout.
//   ВыводОшибок - Строка - Текст для stderr.
//   ПутьВывода - Строка, Неопределено - Путь к файлу результата.
//   СодержимоеФайла - Строка - Текст для записи в файл результата.
Процедура ПриСозданииОбъекта(
	КодЗавершения,
	СтандартныйВывод,
	ВыводОшибок,
	ПутьВывода = Неопределено,
	СодержимоеФайла = ""
)

	_КодЗавершения = КодЗавершения;
	_СтандартныйВывод = СтандартныйВывод;
	_ВыводОшибок = ВыводОшибок;
	_ПутьВывода = ПутьВывода;
	_СодержимоеФайла = СодержимоеФайла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает код завершения.
//
// Возвращаемое значение:
//   Число - Код завершения процесса.
Функция КодЗавершения() Экспорт

	Возврат _КодЗавершения;

КонецФункции

// Возвращает стандартный вывод.
//
// Возвращаемое значение:
//   Строка - Текст для stdout.
Функция СтандартныйВывод() Экспорт

	Возврат _СтандартныйВывод;

КонецФункции

// Возвращает вывод ошибок.
//
// Возвращаемое значение:
//   Строка - Текст для stderr.
Функция ВыводОшибок() Экспорт

	Возврат _ВыводОшибок;

КонецФункции

// Возвращает путь к файлу результата.
//
// Возвращаемое значение:
//   Строка, Неопределено - Путь к файлу или Неопределено для стандартного вывода.
Функция ПутьВывода() Экспорт

	Возврат _ПутьВывода;

КонецФункции

// Возвращает содержимое файла результата.
//
// Возвращаемое значение:
//   Строка - Текст для записи в файл.
Функция СодержимоеФайла() Экспорт

	Возврат _СодержимоеФайла;

КонецФункции

#КонецОбласти

#Использовать errors

#Область ПрограммныйИнтерфейс

// Проверяет перенаправление стандартного ввода без чтения данных.
//
// Возвращаемое значение:
//   Булево - Истина, если стандартный ввод не связан с интерактивной консолью.
Функция СтандартныйВводПеренаправлен() Экспорт

	Попытка
		НажатаКлавиша = Консоль.НажатаКлавиша;
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Получает текст команды из параметров вызова.
//
// Параметры:
//   ПараметрыКоманды - ПараметрыКомандыКонвертацииCURL - Разобранные параметры команды convert.
//
// Возвращаемое значение:
//   Строка, Массив из Строка - Команда curl.
//
// Исключения:
//   argument.required - Файл или стандартный ввод не содержит команды.
Функция Получить(ПараметрыКоманды) Экспорт

	ПутьВвода = ПараметрыКоманды.ПутьВвода();
	Если ПутьВвода = Неопределено Тогда
		Возврат ПараметрыКоманды.Команда();
	КонецЕсли;

	Если ПутьВвода = "-" Тогда
		Команда = ПрочитатьСтандартныйВвод();
	Иначе
		Команда = ПрочитатьФайл(ПутьВвода);
	КонецЕсли;

	Если СтрокаНеЗаполнена(Команда) Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументНеЗаполнен(),
			"Команда curl не указана"
		);
	КонецЕсли;

	Возврат СокрЛП(Команда);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьФайл(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Результат = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция ПрочитатьСтандартныйВвод()

	Поток = Консоль.ОткрытьСтандартныйПотокВвода();
	Чтение = Новый ЧтениеТекста(Поток, КодировкаТекста.UTF8);

	Возврат Чтение.Прочитать();

КонецФункции

Функция СтрокаНеЗаполнена(Значение)

	Возврат ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Значение));

КонецФункции

#КонецОбласти

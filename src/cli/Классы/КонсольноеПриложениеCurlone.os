Перем _ИсполнительКонвертации; // ИсполнительКомандыКонвертацииCURL, Произвольный

#Область ОбработчикиСобытий

// Создаёт маршрутизатор консольных команд curlone.
//
// Параметры:
//   ИсполнительКонвертации - ИсполнительКомандыКонвертацииCURL, Неопределено - Исполнитель convert.
Процедура ПриСозданииОбъекта(ИсполнительКонвертации = Неопределено)

	_ИсполнительКонвертации = ИсполнительКонвертации;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет, поддерживается ли команда собственным консольным приложением.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы процесса.
//
// Возвращаемое значение:
//   Булево - Истина для команды convert.
Функция Поддерживает(Аргументы) Экспорт

	Если Аргументы.Количество() = 0 Или ТипЗнч(Аргументы[0]) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(Аргументы[0]) = "convert";

КонецФункции

// Выполняет поддерживаемую консольную команду.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы процесса.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Код завершения и текст потоков.
Функция ВыполнитьКоманду(Аргументы) Экспорт

	Хвост = СкопироватьХвост(Аргументы);

	Попытка
		Исполнитель = _ИсполнительКонвертации;
		Если Исполнитель = Неопределено Тогда
			Исполнитель = Новый ИсполнительКомандыКонвертацииCURL;
		КонецЕсли;

		Возврат Исполнитель.ВыполнитьКоманду(Хвост);
	Исключение
		Возврат Новый РезультатВыполненияCurlone(
			1,
			"",
			"Внутренняя ошибка выполнения команды curlone" + Символы.ПС
		);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьХвост(Аргументы)

	Результат = Новый Массив;
	Для Индекс = 1 По Аргументы.ВГраница() Цикл
		Результат.Добавить(Аргументы[Индекс]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать packageinfo

#Область ПрограммныйИнтерфейс

// Подготавливает аргументы с учётом перенаправленного стандартного ввода.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы процесса.
//
// Возвращаемое значение:
//   Массив, ФиксированныйМассив из Строка - Исходные или дополненные аргументы.
Функция ПодготовитьАргументы(Аргументы) Экспорт

	ПолучениеКоманды = Новый ПолучениеКомандыКонвертацииCURL;
	Если Не ПолучениеКоманды.СтандартныйВводПеренаправлен() Тогда
		Возврат Аргументы;
	КонецЕсли;

	Если Аргументы.Количество() = 0 Тогда
		ИсходныеАргументы = Новый Массив;
		ИсходныеАргументы.Добавить("convert");
	ИначеЕсли НРег(Аргументы[0]) = "convert" Тогда
		ИсходныеАргументы = Аргументы;
	Иначе
		Возврат Аргументы;
	КонецЕсли;

	Результат = АргументыСоСтандартнымВводом(ИсходныеАргументы);

	Разбор = Новый РазборАргументовКонвертацииCURL().ПопытатьсяРазобрать(СкопироватьХвост(Результат));
	Если Разбор.Параметры = Неопределено Тогда
		Возврат Аргументы;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает параметры допустимого запуска веб-сервера.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы процесса.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура, Неопределено - Параметры запуска или Неопределено.
Функция ПараметрыЗапускаСервера(Аргументы) Экспорт

	Если Аргументы.Количество() = 0 Или ТипЗнч(Аргументы[0]) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НРег(Аргументы[0]) <> "serve" Или ЭтоЗапросСправкиКоманды(Аргументы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		РазборСервера = Новый РазборАргументовЗапускаСервера;
		Возврат РазборСервера.Разобрать(СкопироватьХвост(Аргументы));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Выполняет консольную команду.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы процесса.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Код завершения и текст потоков.
Функция ВыполнитьКоманду(Аргументы) Экспорт

	Справка = Новый СправкаCurlone;
	Если Аргументы.Количество() = 0 Тогда
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Общая(), "");
	КонецЕсли;

	Команда = НРег(Аргументы[0]);
	Если Команда = "--help" Или Команда = "-h" Тогда
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Общая(), "");
	ИначеЕсли Команда = "--version" Или Команда = "-v"  Тогда
		Версия = Новый ИнформацияОПакете(ПутьКPackagedef()).Версия();
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), "curlone " + Версия, "");
	ИначеЕсли Команда = "help" Тогда
		Возврат РезультатСправки(Аргументы, Справка);
	ИначеЕсли Команда = "convert" Тогда
		Если ЭтоЗапросСправкиКоманды(Аргументы) Тогда
			Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Convert(), "");
		КонецЕсли;
	ИначеЕсли Команда = "serve" Тогда
		Если ЭтоЗапросСправкиКоманды(Аргументы) Тогда
			Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Serve(), "");
		КонецЕсли;

		Попытка
			РазборСервера = Новый РазборАргументовЗапускаСервера;
			ПараметрыСервера = РазборСервера.Разобрать(СкопироватьХвост(Аргументы));
		Исключение
			Сообщение = ДиагностикаОшибок.ПользовательскоеПредставление(ИнформацияОбОшибке());
			Возврат Новый РезультатВыполненияCurlone(
				КодыЗавершенияCurlone.ОшибкаИспользования(),
				"",
				Сообщение
			);
		КонецПопытки;

		Возврат Новый РезультатВыполненияCurlone(
			КодыЗавершенияCurlone.ВнутренняяОшибка(),
			"",
			"Сервер не был запущен"
		);
	Иначе
		Возврат Новый РезультатВыполненияCurlone(
			КодыЗавершенияCurlone.ОшибкаИспользования(),
			"",
			"Неизвестная команда curlone"
		);
	КонецЕсли;

	Хвост = СкопироватьХвост(Аргументы);

	Попытка
		Возврат Новый ИсполнительКомандыКонвертацииCURL.ВыполнитьКоманду(Хвост);
	Исключение
		Возврат Новый РезультатВыполненияCurlone(
			КодыЗавершенияCurlone.ВнутренняяОшибка(),
			"",
			"Внутренняя ошибка выполнения команды curlone"
		);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПутьКPackagedef()

	Возврат Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "../../../packagedef")).ПолноеИмя;

КонецФункции

Функция РезультатСправки(Аргументы, Справка)

	Если Аргументы.Количество() = 1 Тогда
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Общая(), "");
	ИначеЕсли Аргументы.Количество() = 2 И НРег(Аргументы[1]) = "convert" Тогда
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Convert(), "");
	ИначеЕсли Аргументы.Количество() = 2 И НРег(Аргументы[1]) = "serve" Тогда
		Возврат Новый РезультатВыполненияCurlone(КодыЗавершенияCurlone.Успех(), Справка.Serve(), "");
	КонецЕсли;

	Возврат Новый РезультатВыполненияCurlone(
		КодыЗавершенияCurlone.ОшибкаИспользования(),
		"",
		"Неизвестная команда curlone"
	);

КонецФункции

Функция ЭтоЗапросСправкиКоманды(Аргументы)

	Возврат Аргументы.Количество() = 2
		И (Аргументы[1] = "--help" Или Аргументы[1] = "-h");

КонецФункции

Функция СкопироватьХвост(Аргументы)

	Результат = Новый Массив;
	Для Индекс = 1 По Аргументы.ВГраница() Цикл
		Результат.Добавить(Аргументы[Индекс]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АргументыСоСтандартнымВводом(Аргументы)

	Результат = Новый Массив;
	ВводДобавлен = Ложь;
	Для Каждого Аргумент Из Аргументы Цикл

		Если Не ВводДобавлен И Аргумент = "--" Тогда
			Результат.Добавить("--input");
			Результат.Добавить("-");
			ВводДобавлен = Истина;
		КонецЕсли;

		Результат.Добавить(Аргумент);
	КонецЦикла;

	Если Не ВводДобавлен Тогда
		Результат.Добавить("--input");
		Результат.Добавить("-");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

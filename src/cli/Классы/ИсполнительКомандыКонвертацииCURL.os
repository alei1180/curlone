#Использовать errors
#Использовать "../../public"

Перем _Конвертер; // КонвертерCURL, Произвольный

#Область ОбработчикиСобытий

// Создаёт исполнитель команды convert.
//
// Параметры:
//   Конвертер - КонвертерCURL, Неопределено - Фасад конвертации.
Процедура ПриСозданииОбъекта(Конвертер = Неопределено)

	_Конвертер = ?(Конвертер = Неопределено, Новый КонвертерCURL, Конвертер);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет команду convert и возвращает данные консольных потоков.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы после convert.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Код завершения и текст потоков.
Функция ВыполнитьКоманду(Аргументы) Экспорт

	Цель = ЦелиКонвертацииCURL.ПлатформенныйHTTP();
	Формат = "text";

	Попытка
		ПараметрыКоманды = Новый РазборАргументовКонвертацииCURL().Разобрать(Аргументы, Цель, Формат);
	Исключение
		Возврат РезультатОшибкиАргументов(ИнформацияОбОшибке(), Формат, Цель);
	КонецПопытки;

	Формат = ПараметрыКоманды.ФорматВывода();
	Цель = ПараметрыКоманды.Цель();

	Попытка
		Параметры = Новый ПараметрыКонвертацииCURL(ПараметрыКоманды.Команда());
		Параметры.Цель = Цель;
		Параметры.Локаль = ПараметрыКоманды.Локаль();

		Результат = _Конвертер.Конвертировать(Параметры);
		КодЗавершения = КлассифицироватьКодЗавершения(Результат);

		Возврат Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(
			Результат,
			Формат,
			КодЗавершения,
			Цель
		);
	Исключение
		Возврат РезультатВнутреннейОшибки(Формат, Цель);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьКодЗавершения(Результат)

	Если Результат.Успешно() Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого Ошибка Из Результат.Ошибки() Цикл
		Код = ДиагностикаОшибок.КодОшибки(Ошибка);

		Если Код = КодыОшибокCurlone.НеизвестныйГенератор()
			Или Код = КодыОшибокCurlone.НесовместимаяВерсияКонтрактаГенератора()
			Или Код = КодыОшибокCurlone.НарушенКонтрактГенератора() Тогда
			Возврат 4;
		КонецЕсли;
	КонецЦикла;

	Возврат 3;

КонецФункции

Функция РезультатОшибкиАргументов(Ошибка, Формат, Цель)

	Если Формат = "json" Тогда
		Ошибки = Новый Массив;
		Ошибки.Добавить(Ошибка);
		Результат = Новый РезультатКонвертацииCURL("", Ошибки, Неопределено, Цель);

		Возврат Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(Результат, Формат, 2, Цель);
	КонецЕсли;

	Сообщение = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка) + Символы.ПС;

	Возврат Новый РезультатВыполненияCurlone(2, "", Сообщение);

КонецФункции

Функция РезультатВнутреннейОшибки(Формат, Цель)

	Ошибка = ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		"Внутренняя ошибка выполнения команды convert"
	);

	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);

	Результат = Новый РезультатКонвертацииCURL("", Ошибки, Неопределено, Цель);

	Возврат Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(Результат, Формат, 1, Цель);

КонецФункции

#КонецОбласти

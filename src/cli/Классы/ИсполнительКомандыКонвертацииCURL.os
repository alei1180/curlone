#Использовать errors
#Использовать "../../public"

Перем _Конвертер; // КонвертерCURL, Произвольный
Перем _ПолучениеКоманды; // ПолучениеКомандыКонвертацииCURL, Произвольный

#Область ОбработчикиСобытий

// Создаёт исполнитель команды convert.
//
// Параметры:
//   Конвертер - КонвертерCURL, Неопределено - Фасад конвертации.
//   ПолучениеКоманды - ПолучениеКомандыКонвертацииCURL, Неопределено - Источник текста команды.
Процедура ПриСозданииОбъекта(Конвертер = Неопределено, ПолучениеКоманды = Неопределено)

	_Конвертер = ?(Конвертер = Неопределено, Новый КонвертерCURL, Конвертер);
	_ПолучениеКоманды = ?(
		ПолучениеКоманды = Неопределено,
		Новый ПолучениеКомандыКонвертацииCURL,
		ПолучениеКоманды
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет команду convert и возвращает данные консольных потоков.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы после convert.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Код завершения и текст потоков.
Функция ВыполнитьКоманду(Аргументы) Экспорт

	Разбор = Новый РазборАргументовКонвертацииCURL().ПопытатьсяРазобрать(Аргументы);
	Формат = Разбор.Формат;
	Цель = Разбор.Цель;
	ПутьВывода = Разбор.ПутьВывода;

	Если Разбор.Ошибка <> Неопределено Тогда
		РезультатОшибки = РезультатОшибкиАргументов(Разбор.Ошибка, Формат, Цель);
		Возврат ПрименитьНазначениеВывода(РезультатОшибки, ПутьВывода);
	КонецЕсли;

	ПараметрыКоманды = Разбор.Параметры;
	Формат = ПараметрыКоманды.ФорматВывода();
	Цель = ПараметрыКоманды.Цель();
	ПутьВывода = ПараметрыКоманды.ПутьВывода();

	Попытка
		Команда = _ПолучениеКоманды.Получить(ПараметрыКоманды);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Если ЯвляетсяОшибкойАргументов(Ошибка) Тогда
			РезультатОшибки = РезультатОшибкиАргументов(Ошибка, Формат, Цель);
		Иначе
			РезультатОшибки = РезультатВнутреннейОшибки(Формат, Цель);
		КонецЕсли;

		Возврат ПрименитьНазначениеВывода(РезультатОшибки, ПутьВывода);
	КонецПопытки;

	Попытка
		Параметры = Новый ПараметрыКонвертацииCURL(Команда);
		Параметры.Цель = Цель;
		Параметры.Локаль = ПараметрыКоманды.Локаль();

		Результат = _Конвертер.Конвертировать(Параметры);
		КодЗавершения = КлассифицироватьКодЗавершения(
			Результат,
			ПараметрыКоманды.ЗавершатьПриПредупреждении()
		);

		РезультатВыполнения = Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(
			Результат,
			Формат,
			КодЗавершения,
			Цель
		);

		Возврат ПрименитьНазначениеВывода(РезультатВыполнения, ПутьВывода);
	Исключение
		РезультатОшибки = РезультатВнутреннейОшибки(Формат, Цель);
		Возврат ПрименитьНазначениеВывода(РезультатОшибки, ПутьВывода);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯвляетсяОшибкойАргументов(Ошибка)

	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);

	Возврат КодОшибки = КодыСтандартныхОшибок.АргументНеЗаполнен()
		Или КодОшибки = КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента();

КонецФункции

Функция ПрименитьНазначениеВывода(Результат, ПутьВывода)

	Если ПутьВывода = "-" Или ПустаяСтрока(Результат.СтандартныйВывод()) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Новый РезультатВыполненияCurlone(
		Результат.КодЗавершения(),
		"",
		Результат.ВыводОшибок(),
		ПутьВывода,
		Результат.СтандартныйВывод()
	);

КонецФункции

Функция КлассифицироватьКодЗавершения(Результат, ЗавершатьПриПредупреждении)

	Если Результат.Успешно() Тогда
		Если ЗавершатьПриПредупреждении И СодержитПредупреждение(Результат) Тогда
			Возврат КодыЗавершенияCurlone.ПредупреждениеКакОшибка();
		КонецЕсли;

		Возврат КодыЗавершенияCurlone.Успех();
	КонецЕсли;

	Для Каждого Ошибка Из Результат.Ошибки() Цикл
		Код = ДиагностикаОшибок.КодОшибки(Ошибка);

		Если Код = КодыОшибокCurlone.НеизвестныйГенератор()
			Или Код = КодыОшибокCurlone.НесовместимаяВерсияКонтрактаГенератора()
			Или Код = КодыОшибокCurlone.НарушенКонтрактГенератора() Тогда
			Возврат КодыЗавершенияCurlone.ОшибкаГенератора();
		КонецЕсли;
	КонецЦикла;

	Возврат КодыЗавершенияCurlone.ОшибкаКонвертации();

КонецФункции

Функция СодержитПредупреждение(Результат)

	Для Каждого Диагностика Из Результат.Диагностика() Цикл
		Если Диагностика.Вид = ВидыДиагностикиКонвертацииCURL.Предупреждение() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция РезультатОшибкиАргументов(Ошибка, Формат, Цель)

	Если Формат = "json" Тогда
		Ошибки = Новый Массив;
		Ошибки.Добавить(Ошибка);
		Результат = Новый РезультатКонвертацииCURL("", Ошибки, Неопределено, Цель);

		Возврат Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(
			Результат,
			Формат,
			КодыЗавершенияCurlone.ОшибкаИспользования(),
			Цель
		);
	КонецЕсли;

	Сообщение = ДиагностикаОшибок.ПользовательскоеПредставление(Ошибка);
	Если ДиагностикаОшибок.КодОшибки(Ошибка) = КодыСтандартныхОшибок.АргументНеЗаполнен() Тогда
		Сообщение = СтрШаблон("%1
		|
		|Использование: curlone convert [ОПЦИИ] [КОМАНДА]", Сообщение);
	КонецЕсли;

	Возврат Новый РезультатВыполненияCurlone(
		КодыЗавершенияCurlone.ОшибкаИспользования(),
		"",
		Сообщение
	);

КонецФункции

Функция РезультатВнутреннейОшибки(Формат, Цель)

	Ошибка = ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		"Внутренняя ошибка выполнения команды convert"
	);

	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);

	Результат = Новый РезультатКонвертацииCURL("", Ошибки, Неопределено, Цель);

	Возврат Новый ФормированиеРезультатаКонвертацииCURL().Сформировать(
		Результат,
		Формат,
		КодыЗавершенияCurlone.ВнутренняяОшибка(),
		Цель
	);

КонецФункции

#КонецОбласти

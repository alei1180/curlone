#Использовать errors

#Область ПрограммныйИнтерфейс

// Разбирает аргументы команды convert.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы после convert.
//   РаспознаннаяЦель - Строка, Неопределено - Цель, успешно распознанная до возможной ошибки.
//   РаспознанныйФормат - Строка, Неопределено - Формат, успешно распознанный до возможной ошибки.
//
// Возвращаемое значение:
//   ПараметрыКомандыКонвертацииCURL - Параметры вызова.
//
// Исключения:
//   argument.required - Отсутствует команда или значение опции.
//   argument.invalid_value - Переданы недопустимые аргументы.
Функция Разобрать(
	Аргументы,
	РаспознаннаяЦель = Неопределено,
	РаспознанныйФормат = Неопределено
) Экспорт

	Результат = ПопытатьсяРазобрать(Аргументы);
	РаспознаннаяЦель = Результат.Цель;
	РаспознанныйФормат = Результат.Формат;

	Если Результат.Ошибка <> Неопределено Тогда
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;

	Возврат Результат.Параметры;

КонецФункции

// Разбирает аргументы и сохраняет контекст при ошибке.
//
// Параметры:
//   Аргументы - Массив, ФиксированныйМассив из Строка - Аргументы после convert.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - Параметры, Ошибка, Цель, Формат и ПутьВывода.
Функция ПопытатьсяРазобрать(Аргументы) Экспорт

	Если ТипЗнч(Аргументы) <> Тип("Массив")
		И ТипЗнч(Аргументы) <> Тип("ФиксированныйМассив") Тогда
		Ошибка = ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			"Аргументы команды convert должны быть массивом"
		);

		Возврат Новый ФиксированнаяСтруктура(
			"Параметры,Ошибка,Цель,Формат,ПутьВывода",
			Неопределено,
			Ошибка,
			"1c",
			"text",
			"-"
		);
	КонецЕсли;

	Цель = ЦелиКонвертацииCURL.ПлатформенныйHTTP();
	Локаль = ЛокалиКонвертацииCURL.Русская();
	Формат = "text";
	Команда = Неопределено;
	ПутьВвода = Неопределено;
	ПутьВывода = "-";
	ЗавершатьПриПредупреждении = Ложь;
	Ошибка = Неопределено;
	ИспользованныеОпции = Новый Соответствие;
	Индекс = 0;

	Пока Индекс < Аргументы.Количество() Цикл

		Аргумент = Аргументы[Индекс];

		Если Аргумент = "--" Тогда
			Попытка
				ПроверитьЕдинственныйИсточник(Команда, ПутьВвода);
				Команда = СкопироватьКомандуПослеМаркера(Аргументы, Индекс + 1);
			Исключение
				Ошибка = ПерваяОшибка(Ошибка, ИнформацияОбОшибке());
			КонецПопытки;

			Прервать;
		КонецЕсли;

		Если Не СтрНачинаетсяС(Аргумент, "-") Тогда
			Попытка
				ПроверитьЕдинственныйИсточник(Команда, ПутьВвода);
				Команда = Аргумент;
			Исключение
				Ошибка = ПерваяОшибка(Ошибка, ИнформацияОбОшибке());
			КонецПопытки;

			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		СледующийИндекс = Индекс + 1;
		Попытка
			Опция = РазобратьОпцию(Аргументы, Индекс);
			СледующийИндекс = Индекс + Опция.ЧислоАргументов + 1;

			Если Опция.Имя = "--input" Тогда
				ПроверитьЕдинственныйИсточник(Команда, ПутьВвода);
				ПроверитьЗаполненностьОпции(Опция);
				ПутьВвода = Опция.Значение;
				ПроверитьПовторениеОпции(Опция.Имя, ИспользованныеОпции);
			ИначеЕсли Опция.Имя = "--output" Тогда
				ПроверитьЗаполненностьОпции(Опция);
				ПутьВывода = Опция.Значение;
				ПроверитьПовторениеОпции(Опция.Имя, ИспользованныеОпции);
			ИначеЕсли Опция.Имя = "--fail-on-warning" Тогда
				ЗавершатьПриПредупреждении = Истина;
			ИначеЕсли Опция.Имя = "--target" Тогда
				Цель = ПроверитьЗначениеЦели(Опция);
				ПроверитьПовторениеОпции(Опция.Имя, ИспользованныеОпции);
			ИначеЕсли Опция.Имя = "--locale" Тогда
				Локаль = ПроверитьЗначениеЛокали(Опция);
				ПроверитьПовторениеОпции(Опция.Имя, ИспользованныеОпции);
			ИначеЕсли Опция.Имя = "--format" Тогда
				Формат = ПроверитьЗначениеФормата(Опция);
				ПроверитьПовторениеОпции(Опция.Имя, ИспользованныеОпции);
			Иначе
				ВызватьНедопустимоеЗначение("Неизвестная опция команды convert");
			КонецЕсли;
		Исключение
			Ошибка = ПерваяОшибка(Ошибка, ИнформацияОбОшибке());
		КонецПопытки;

		Индекс = СледующийИндекс;

	КонецЦикла;

	Если Ошибка = Неопределено И ПутьВвода = Неопределено Тогда
		Попытка
			ПроверитьКоманду(Команда);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЕсли;

	Параметры = Неопределено;
	Если Ошибка = Неопределено Тогда
		Параметры = Новый ПараметрыКомандыКонвертацииCURL(
			Команда,
			Цель,
			Локаль,
			Формат,
			ПутьВвода,
			ПутьВывода,
			ЗавершатьПриПредупреждении
		);
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура(
		"Параметры,Ошибка,Цель,Формат,ПутьВывода",
		Параметры,
		Ошибка,
		Цель,
		Формат,
		ПутьВывода
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПерваяОшибка(ТекущаяОшибка, НоваяОшибка)

	Возврат ?(ТекущаяОшибка = Неопределено, НоваяОшибка, ТекущаяОшибка);

КонецФункции

Процедура ПроверитьПовторениеОпции(Имя, ИспользованныеОпции)

	Если ИспользованныеОпции.Получить(Имя) <> Неопределено Тогда
		ВызватьНедопустимоеЗначение("Опцию " + Имя + " можно указать только один раз");
	КонецЕсли;

	ИспользованныеОпции.Вставить(Имя, Истина);

КонецПроцедуры

Функция РазобратьОпцию(Аргументы, Индекс)

	Аргумент = Аргументы[Индекс];
	ПозицияРавно = Найти(Аргумент, "=");

	Если ПозицияРавно > 0 Тогда
		Имя = Лев(Аргумент, ПозицияРавно - 1);
		Значение = Сред(Аргумент, ПозицияРавно + 1);

		Имя = ПроверитьИмяОпции(Имя);
		Если Имя = "--fail-on-warning" Тогда
			ВызватьНедопустимоеЗначение("Опция --fail-on-warning не принимает значение");
		КонецЕсли;

		Возврат Новый Структура("Имя,Значение,ЧислоАргументов", Имя, Значение, 0);
	КонецЕсли;

	Имя = ПроверитьИмяОпции(Аргумент);
	Если Имя = "--fail-on-warning" Тогда
		Возврат Новый Структура("Имя,Значение,ЧислоАргументов", Имя, Истина, 0);
	КонецЕсли;

	Если Индекс + 1 >= Аргументы.Количество() Тогда
		ВызватьНезаполненныйАргумент("Для опции " + Аргумент + " не указано значение");
	КонецЕсли;

	Значение = Аргументы[Индекс + 1];

	Если СтрНачинаетсяС(Значение, "--") Тогда
		ВызватьНезаполненныйАргумент("Для опции " + Аргумент + " не указано значение");
	КонецЕсли;

	Возврат Новый Структура("Имя,Значение,ЧислоАргументов", Имя, Значение, 1);

КонецФункции

Функция ПроверитьИмяОпции(Имя)

	Если Имя = "-t" Тогда
		Возврат "--target";
	ИначеЕсли Имя = "-l" Тогда
		Возврат "--locale";
	ИначеЕсли Имя = "-f" Тогда
		Возврат "--format";
	ИначеЕсли Имя = "-i" Тогда
		Возврат "--input";
	ИначеЕсли Имя = "-o" Тогда
		Возврат "--output";
	КонецЕсли;

	Если Имя <> "--target"
		И Имя <> "--locale"
		И Имя <> "--format"
		И Имя <> "--input"
		И Имя <> "--output"
		И Имя <> "--fail-on-warning" Тогда
		ВызватьНедопустимоеЗначение("Неизвестная опция команды convert");
	КонецЕсли;

	Возврат Имя;

КонецФункции

Процедура ПроверитьЗаполненностьОпции(Опция)

	Если СтрокаНеЗаполнена(Опция.Значение) Тогда
		ВызватьНезаполненныйАргумент("Для опции " + Опция.Имя + " не указано значение");
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьЗначениеЦели(Опция)

	ПроверитьЗаполненностьОпции(Опция);

	Возврат Опция.Значение;

КонецФункции

Функция ПроверитьЗначениеЛокали(Опция)

	ПроверитьЗаполненностьОпции(Опция);
	Если Опция.Значение <> ЛокалиКонвертацииCURL.Русская() И Опция.Значение <> ЛокалиКонвертацииCURL.Английская() Тогда
		ВызватьНедопустимоеЗначение("Локаль должна иметь значение ru или en");
	КонецЕсли;

	Возврат Опция.Значение;

КонецФункции

Функция ПроверитьЗначениеФормата(Опция)

	ПроверитьЗаполненностьОпции(Опция);
	Если Опция.Значение <> "text" И Опция.Значение <> "json" Тогда
		ВызватьНедопустимоеЗначение("Формат должен иметь значение text или json");
	КонецЕсли;

	Возврат Опция.Значение;

КонецФункции

Процедура ПроверитьЕдинственныйИсточник(Команда, ПутьВвода = Неопределено)

	Если Команда <> Неопределено Или ПутьВвода <> Неопределено Тогда
		ВызватьНедопустимоеЗначение(
			"Команду curl можно передать только одним способом: аргументом или через --input"
		);
	КонецЕсли;

КонецПроцедуры

Функция СкопироватьКомандуПослеМаркера(Аргументы, НачальныйИндекс)

	Команда = Новый Массив;
	Для Индекс = НачальныйИндекс По Аргументы.ВГраница() Цикл
		Команда.Добавить(Аргументы[Индекс]);
	КонецЦикла;

	Возврат Команда;

КонецФункции

Процедура ПроверитьКоманду(Команда)

	Если Команда = Неопределено Тогда
		ВызватьНезаполненныйАргумент("Команда curl не указана");
	КонецЕсли;

	Если ТипЗнч(Команда) = Тип("Строка") Тогда
		ПроверитьСтрокуКоманды(Команда);
	Иначе
		ПроверитьМассивКоманды(Команда);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтрокуКоманды(Команда)

	КомандаДляПроверки = СокрЛП(Команда);
	НачинаетсяСCurl = СтрДлина(КомандаДляПроверки) >= 4 И НРег(Лев(КомандаДляПроверки, 4)) = "curl";

	Если НачинаетсяСCurl И СтрДлина(КомандаДляПроверки) > 4 Тогда
		Разделитель = Сред(КомандаДляПроверки, 5, 1);
		НачинаетсяСCurl = Разделитель = " " Или Разделитель = Символы.Таб;
	КонецЕсли;

	Если Не НачинаетсяСCurl Тогда
		ВызватьНедопустимоеЗначение("В начале команды ожидается curl");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМассивКоманды(Команда)

	Если Команда.Количество() = 0 Тогда
		ВызватьНезаполненныйАргумент("Команда curl не указана");
	КонецЕсли;

	Если ТипЗнч(Команда[0]) <> Тип("Строка") Или НРег(Команда[0]) <> "curl" Тогда
		ВызватьНедопустимоеЗначение("В начале команды ожидается curl");
	КонецЕсли;

КонецПроцедуры

Процедура ВызватьНезаполненныйАргумент(Сообщение)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.АргументНеЗаполнен(),
		Сообщение
	);

КонецПроцедуры

Процедура ВызватьНедопустимоеЗначение(Сообщение)

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
		Сообщение
	);

КонецПроцедуры

Функция СтрокаНеЗаполнена(Значение)

	Возврат СтрДлина(СокрЛП(Значение)) = 0;

КонецФункции

#КонецОбласти

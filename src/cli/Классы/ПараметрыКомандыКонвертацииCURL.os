#Использовать errors

Перем _Команда; // Строка, Массив из Строка
Перем _Цель; // Строка
Перем _Локаль; // Строка
Перем _Формат; // Строка
Перем _ПутьВвода; // Строка, Неопределено
Перем _ПутьВывода; // Строка
Перем _ЗавершатьПриПредупреждении; // Булево

#Область ОбработчикиСобытий

// Создаёт неизменяемые параметры команды convert.
//
// Параметры:
//   Команда - Строка, Массив, ФиксированныйМассив - Исходная команда curl.
//   Цель - Строка - Идентификатор целевого генератора.
//   Локаль - Строка - Код локали генерируемого кода.
//   Формат - Строка - Формат консольного вывода.
//   ПутьВвода - Строка, Неопределено - Путь к файлу с командой или признак стандартного ввода "-".
//   ПутьВывода - Строка - Путь к файлу результата или признак стандартного вывода "-".
//   ЗавершатьПриПредупреждении - Булево - Завершать выполнение ненулевым кодом при предупреждении.
Процедура ПриСозданииОбъекта(
	Команда,
	Цель,
	Локаль,
	Формат,
	ПутьВвода = Неопределено,
	ПутьВывода = "-",
	ЗавершатьПриПредупреждении = Ложь
)

	_Команда = СкопироватьКоманду(Команда);
	_Цель = Цель;
	_Локаль = Локаль;
	_Формат = Формат;
	_ПутьВвода = ПутьВвода;
	_ПутьВывода = ПутьВывода;
	_ЗавершатьПриПредупреждении = ЗавершатьПриПредупреждении;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает исходную команду.
//
// Возвращаемое значение:
//   Строка, Массив из Строка - Строка либо копия массива команды.
Функция Команда() Экспорт

	Возврат СкопироватьКоманду(_Команда);

КонецФункции

// Возвращает путь к источнику команды.
//
// Возвращаемое значение:
//   Строка, Неопределено - Путь к файлу с командой или признак стандартного ввода "-".
Функция ПутьВвода() Экспорт

	Возврат _ПутьВвода;

КонецФункции

// Возвращает путь назначения результата.
//
// Возвращаемое значение:
//   Строка - Путь к файлу результата или признак стандартного вывода "-".
Функция ПутьВывода() Экспорт

	Возврат _ПутьВывода;

КонецФункции

// Возвращает признак завершения ненулевым кодом при предупреждении.
//
// Возвращаемое значение:
//   Булево - Истина, если предупреждение должно приводить к коду завершения 5.
Функция ЗавершатьПриПредупреждении() Экспорт

	Возврат _ЗавершатьПриПредупреждении;

КонецФункции

// Возвращает идентификатор целевого генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор целевого генератора.
Функция Цель() Экспорт

	Возврат _Цель;

КонецФункции

// Возвращает код локали.
//
// Возвращаемое значение:
//   Строка - Код локали генерируемого кода.
Функция Локаль() Экспорт

	Возврат _Локаль;

КонецФункции

// Возвращает формат консольного вывода.
//
// Возвращаемое значение:
//   Строка - Формат консольного вывода.
Функция ФорматВывода() Экспорт

	Возврат _Формат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СкопироватьКоманду(Команда)

	Если Команда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Команда) = Тип("Строка") Тогда
		Возврат Команда;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Команда Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

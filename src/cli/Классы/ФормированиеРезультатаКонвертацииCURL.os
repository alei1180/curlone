#Использовать jason
#Использовать "../.."

#Область СлужебныйПрограммныйИнтерфейс

// Формирует консольные потоки из безопасного результата конвертации.
//
// Параметры:
//   Результат - РезультатКонвертацииCURL - Код и диагностика.
//   Формат - Строка - Формат `text` или `json`.
//   КодЗавершения - Число - Код завершения процесса.
//   ЗапрошеннаяЦель - Строка - Цель для ранней ошибки.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Данные для stdout, stderr и код завершения.
//
// Исключения:
//   argument.invalid_value - Указан неизвестный формат.
Функция Сформировать(Результат, Формат, КодЗавершения, ЗапрошеннаяЦель) Экспорт

	Если Формат = "text" Тогда
		Возврат СформироватьТекст(Результат, КодЗавершения);
	ИначеЕсли Формат = "json" Тогда
		Возврат СформироватьJSON(Результат, КодЗавершения, ЗапрошеннаяЦель);
	КонецЕсли;

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
		"Формат должен иметь значение text или json"
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьТекст(Результат, КодЗавершения)

	СтандартныйВывод = "";
	Если Результат.Успешно() Тогда
		СтандартныйВывод = Результат.Код();
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Диагностика Из Результат.Диагностика() Цикл
		Строки.Добавить(СтрокаДиагностики(Диагностика));
	КонецЦикла;

	ВыводОшибок = "";
	Если Строки.Количество() > 0 Тогда
		ВыводОшибок = СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Возврат Новый РезультатВыполненияCurlone(КодЗавершения, СтандартныйВывод, ВыводОшибок);

КонецФункции

Функция СтрокаДиагностики(Диагностика)

	Возврат СтрШаблон(
		"%1 [%2]: %3",
		НРег(Диагностика.Вид),
		Диагностика.Код,
		Диагностика.Сообщение
	);

КонецФункции

Функция СформироватьJSON(Результат, КодЗавершения, ЗапрошеннаяЦель)

	Данные = Новый ФормированиеДанныхРезультатаКонвертацииCURL().Сформировать(
		Результат,
		ЗапрошеннаяЦель
	);

	Текст = Новый СериализаторJson().Сериализовать(Данные);

	Возврат Новый РезультатВыполненияCurlone(КодЗавершения, Текст, "");

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать jason

#Область СлужебныйПрограммныйИнтерфейс

// Формирует консольные потоки из безопасного результата конвертации.
//
// Параметры:
//   Результат - РезультатКонвертацииCURL - Код и диагностика.
//   Формат - Строка - Формат `text` или `json`.
//   КодЗавершения - Число - Код завершения процесса.
//   ЗапрошеннаяЦель - Строка - Цель для ранней ошибки.
//
// Возвращаемое значение:
//   РезультатВыполненияCurlone - Данные для stdout, stderr и код завершения.
//
// Исключения:
//   argument.invalid_value - Указан неизвестный формат.
Функция Сформировать(Результат, Формат, КодЗавершения, ЗапрошеннаяЦель) Экспорт

	Если Формат = "text" Тогда
		Возврат СформироватьТекст(Результат, КодЗавершения);
	ИначеЕсли Формат = "json" Тогда
		Возврат СформироватьJSON(Результат, КодЗавершения, ЗапрошеннаяЦель);
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента("Формат", "text или json");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьТекст(Результат, КодЗавершения)

	СтандартныйВывод = "";
	Если Результат.Успешно() Тогда
		СтандартныйВывод = Результат.Код() + Символы.ПС;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Диагностика Из Результат.Диагностика() Цикл
		Строки.Добавить(СтрокаДиагностики(Диагностика));
	КонецЦикла;

	ВыводОшибок = "";
	Если Строки.Количество() > 0 Тогда
		ВыводОшибок = СтрСоединить(Строки, Символы.ПС) + Символы.ПС;
	КонецЕсли;

	Возврат Новый РезультатВыполненияCurlone(КодЗавершения, СтандартныйВывод, ВыводОшибок);

КонецФункции

Функция СтрокаДиагностики(Диагностика)

	Возврат СтрШаблон(
		"%1 [%2]: %3",
		НРег(Диагностика.Вид),
		Диагностика.Код,
		Диагностика.Сообщение
	);

КонецФункции

Функция СформироватьJSON(Результат, КодЗавершения, ЗапрошеннаяЦель)

	Ошибки = Новый Массив;
	Предупреждения = Новый Массив;

	Для Каждого Диагностика Из Результат.Диагностика() Цикл
		Если Диагностика.Вид = "Ошибка" Тогда
			Ошибки.Добавить(ОшибкаJSON(Диагностика));
		Иначе
			Предупреждения.Добавить(ПредупреждениеJSON(Диагностика));
		КонецЕсли;
	КонецЦикла;

	Цель = Результат.ИдентификаторГенератора();
	Если ПустаяСтрока(Цель) Тогда
		Цель = ЗапрошеннаяЦель;
	КонецЕсли;

	Данные = Новый Структура("success,target,code,errors,warnings");
	Данные.success = Результат.Успешно();
	Данные.target = Цель;
	Данные.code = Результат.Код();
	Данные.errors = Ошибки;
	Данные.warnings = Предупреждения;

	Текст = Новый СериализаторJson().Сериализовать(Данные) + Символы.ПС;

	Возврат Новый РезультатВыполненияCurlone(КодЗавершения, Текст, "");

КонецФункции

Функция ОшибкаJSON(Диагностика)

	Возврат Новый Структура(
		"code,message",
		Диагностика.Код,
		Диагностика.Сообщение
	);

КонецФункции

Функция ПредупреждениеJSON(Диагностика)

	Возврат Новый Структура(
		"code,message,capability,option,position,target",
		Диагностика.Код,
		Диагностика.Сообщение,
		ЗначениеИлиNull(Диагностика.ИдентификаторВозможности),
		ЗначениеИлиNull(Диагностика.ИсходнаяОпция),
		ПозицияИлиNull(Диагностика.Позиция),
		ЗначениеИлиNull(Диагностика.ИдентификаторГенератора)
	);

КонецФункции

Функция ЗначениеИлиNull(Значение)

	Если Значение = Неопределено Или Значение = "" Тогда
		Возврат Null;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПозицияИлиNull(Значение)

	Если Значение = Неопределено Или Значение < 0 Тогда
		Возврат Null;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts
#Использовать errors
#Использовать "../../src/cli"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("КомандаПослеМаркера")
&ИсточникЗначение("ОпцииИКомандаПослеМаркера")
&ИсточникЗначение("КомандаСтрокой")
&ИсточникЗначение("ОпцииЧерезРавноИКомандаСтрокой")
Процедура ТестДолжен_РазобратьПоддерживаемыйСинтаксис(Сценарий) Экспорт

	// Подготовка
	Данные = ДанныеУспешногоСценария(Сценарий);

	// Действие
	Результат = Новый РазборАргументовКонвертацииCURL().Разобрать(Данные.Аргументы);

	// Проверка
	ПроверитьКоманду(Результат.Команда(), Данные.Команда);
	Ожидаем.Что(Результат.Цель(), Сценарий + ": цель конвертации").Равно(Данные.Цель);
	Ожидаем.Что(Результат.Локаль(), Сценарий + ": локаль конвертации").Равно(Данные.Локаль);
	Ожидаем.Что(Результат.ФорматВывода(), Сценарий + ": формат вывода").Равно(Данные.Формат);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Пусто", "argument.required")
&ИсточникЗначение("ПустаяКоманда", "argument.required")
&ИсточникЗначение("ДваИсточника", "argument.invalid_value")
&ИсточникЗначение("БезCurl", "argument.invalid_value")
&ИсточникЗначение("ЦельБезЗначения", "argument.required")
&ИсточникЗначение("ЦельПередМаркером", "argument.required")
&ИсточникЗначение("ЦельПередОпцией", "argument.required")
&ИсточникЗначение("НеизвестнаяЛокаль", "argument.invalid_value")
&ИсточникЗначение("НеизвестныйФормат", "argument.invalid_value")
&ИсточникЗначение("НеизвестнаяОпция", "argument.invalid_value")
Процедура ТестДолжен_ОтклонитьОшибкуИспользования(Сценарий, КодОшибки) Экспорт

	// Подготовка
	Аргументы = АргументыОшибочногоСценария(Сценарий);

	// Действие
	Ошибка = ПолучитьОшибкуРазбора(Аргументы);

	// Проверка
	Ожидаем.Что(Ошибка, Сценарий + ": ошибка разбора").Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка), Сценарий + ": код ошибки").Равно(КодОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьМассивКомандыОтИзменения() Экспорт

	// Подготовка
	ИсходнаяКоманда = Новый Массив;
	ИсходнаяКоманда.Добавить("curl");
	Параметры = Новый ПараметрыКомандыКонвертацииCURL(ИсходнаяКоманда, "1c", "ru", "text");

	// Действие
	ИсходнаяКоманда.Добавить("https://example.com");
	ПолученнаяКоманда = Параметры.Команда();
	ПолученнаяКоманда.Добавить("https://example.org");

	// Проверка
	Ожидаем.Что(Параметры.Команда(), "Команда после пустого маркера --").ИмеетДлину(1);
	Ожидаем.Что(Параметры.Команда()[0], "Первый элемент команды после маркера --").Равно("curl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьНеизвестнуюЦельРееструГенераторов() Экспорт

	// Подготовка
	Аргументы = МассивИз("--target", "unknown", "--command", "curl https://example.com");

	// Действие
	Результат = Новый РазборАргументовКонвертацииCURL().Разобрать(Аргументы);

	// Проверка
	Ожидаем.Что(Результат.Цель(), "Распознанная неизвестная цель").Равно("unknown");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьРезультатВыполнения() Экспорт

	// Действие
	Результат = Новый РезультатВыполненияCurlone(2, "вывод", "ошибка");

	// Проверка
	Ожидаем.Что(Результат.КодЗавершения(), "Код завершения результата").Равно(2);
	Ожидаем.Что(Результат.СтандартныйВывод(), "Стандартный вывод результата").Равно("вывод");
	Ожидаем.Что(Результат.ВыводОшибок(), "Вывод ошибок результата").Равно("ошибка");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеУспешногоСценария(Сценарий)

	Если Сценарий = "КомандаПослеМаркера" Тогда
		Возврат Новый Структура(
			"Аргументы,Команда,Цель,Локаль,Формат",
			Новый ФиксированныйМассив(МассивИз("--", "CURL", "https://example.com")),
			МассивИз("CURL", "https://example.com"),
			"1c",
			"ru",
			"text"
		);
	ИначеЕсли Сценарий = "ОпцииИКомандаПослеМаркера" Тогда
		Возврат Новый Структура(
			"Аргументы,Команда,Цель,Локаль,Формат",
			МассивИз("--target", "connector", "--locale", "en", "--",
				"curl", "--data", "value", "https://example.com"),
			МассивИз("curl", "--data", "value", "https://example.com"),
			"connector",
			"en",
			"text"
		);
	ИначеЕсли Сценарий = "КомандаСтрокой" Тогда
		Возврат Новый Структура(
			"Аргументы,Команда,Цель,Локаль,Формат",
			МассивИз("--command", "curl https://example.com"),
			"curl https://example.com",
			"1c",
			"ru",
			"text"
		);
	КонецЕсли;

	Возврат Новый Структура(
		"Аргументы,Команда,Цель,Локаль,Формат",
		МассивИз("--target=connector", "--locale=en", "--format=json", "--command",
			"curl https://example.com"),
		"curl https://example.com",
		"connector",
		"en",
		"json"
	);

КонецФункции

Функция АргументыОшибочногоСценария(Сценарий)

	Если Сценарий = "Пусто" Тогда
		Возврат Новый Массив;
	ИначеЕсли Сценарий = "ПустаяКоманда" Тогда
		Возврат МассивИз("--command", "");
	ИначеЕсли Сценарий = "ДваИсточника" Тогда
		Возврат МассивИз("--command", "curl https://example.com", "--", "curl",
			"https://example.org");
	ИначеЕсли Сценарий = "БезCurl" Тогда
		Возврат МассивИз("--", "https://example.com");
	ИначеЕсли Сценарий = "ЦельБезЗначения" Тогда
		Возврат МассивИз("--target");
	ИначеЕсли Сценарий = "ЦельПередМаркером" Тогда
		Возврат МассивИз("--target", "--", "--", "curl", "https://example.com");
	ИначеЕсли Сценарий = "ЦельПередОпцией" Тогда
		Возврат МассивИз("--target", "--format", "json", "--command", "curl https://example.com");
	ИначеЕсли Сценарий = "НеизвестнаяЛокаль" Тогда
		Возврат МассивИз("--locale", "de", "--command", "curl https://example.com");
	ИначеЕсли Сценарий = "НеизвестныйФормат" Тогда
		Возврат МассивИз("--format", "xml", "--command", "curl https://example.com");
	ИначеЕсли Сценарий = "НестроковыйЭлементКоманды" Тогда
		Возврат МассивИз("--", "curl", 1);
	КонецЕсли;

	Возврат МассивИз("--unknown", "value", "--command", "curl https://example.com");

КонецФункции

Процедура ПроверитьКоманду(Фактическая, Ожидаемая)

	Ожидаем.Что(Фактическая, "Тип разобранной команды").ИмеетТип(Строка(ТипЗнч(Ожидаемая)));
	Если ТипЗнч(Ожидаемая) = Тип("Строка") Тогда
		Ожидаем.Что(Фактическая, "Текст разобранной команды").Равно(Ожидаемая);
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Фактическая, "Количество элементов разобранной команды").ИмеетДлину(Ожидаемая.Количество());
	Для Индекс = 0 По Ожидаемая.ВГраница() Цикл
		Ожидаем.Что(Фактическая[Индекс], "Элемент разобранной команды " + Индекс).Равно(Ожидаемая[Индекс]);
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьОшибкуРазбора(Аргументы)

	Попытка
		Результат = Новый РазборАргументовКонвертацииCURL().Разобрать(Аргументы);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуСозданияРезультата(ИмяАргумента)

	Попытка
		Если ИмяАргумента = "Код" Тогда
			Результат = Новый РезультатВыполненияCurlone("два", "", "");
		ИначеЕсли ИмяАргумента = "СтандартныйВывод" Тогда
			Результат = Новый РезультатВыполненияCurlone(0, 1, "");
		Иначе
			Результат = Новый РезультатВыполненияCurlone(0, "", 1);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция МассивИз(
	Значение1,
	Значение2 = Неопределено,
	Значение3 = Неопределено,
	Значение4 = Неопределено,
	Значение5 = Неопределено,
	Значение6 = Неопределено,
	Значение7 = Неопределено,
	Значение8 = Неопределено,
	Значение9 = Неопределено
)

	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	ДобавитьЕслиОпределено(Результат, Значение2);
	ДобавитьЕслиОпределено(Результат, Значение3);
	ДобавитьЕслиОпределено(Результат, Значение4);
	ДобавитьЕслиОпределено(Результат, Значение5);
	ДобавитьЕслиОпределено(Результат, Значение6);
	ДобавитьЕслиОпределено(Результат, Значение7);
	ДобавитьЕслиОпределено(Результат, Значение8);
	ДобавитьЕслиОпределено(Результат, Значение9);

	Возврат Результат;

КонецФункции

Процедура ДобавитьЕслиОпределено(Массив, Значение)

	Если Значение <> Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

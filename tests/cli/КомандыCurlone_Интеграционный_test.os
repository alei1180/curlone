#Использовать asserts

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьДокументированныеПотокиИКоды() Экспорт

	Для Каждого Сценарий Из Сценарии() Цикл
		// Подготовка
		Данные = ДанныеСценария(Сценарий);

		// Действие
		Результат = ВыполнитьПроцесс(Данные.Аргументы);

		// Проверка
		Ожидаем.Что(Результат.Код, Сценарий + ": код завершения").Равно(Данные.Код);
		Ожидаем.Что(
			НормализоватьПереводыСтрок(Результат.СтандартныйВывод),
			Сценарий + ": стандартный вывод"
		).Равно(
			Данные.СтандартныйВывод
		);
		Ожидаем.Что(
			НормализоватьПереводыСтрок(Результат.ВыводОшибок),
			Сценарий + ": вывод ошибок"
		).Равно(
			Данные.ВыводОшибок
		);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_АвтоматическиПрочитатьПеренаправленныйСтандартныйВвод() Экспорт

	// Действие
	Результат = ВыполнитьПроцессСПеренаправленнымВводом();

	// Проверка
	Ожидаем.Что(Результат.ВыводОшибок, "Ошибки стандартного ввода").Равно("");
	Ожидаем.Что(Результат.Код, "Код завершения").Равно(0);
	Ожидаем.Что(
		НормализоватьПереводыСтрок(Результат.СтандартныйВывод),
		"Код из команды стандартного ввода"
	).Равно(КодПлатформы() + Символы.ПС);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сценарии()

	Результат = Новый Массив;
	Результат.Добавить("Платформа");
	Результат.Добавить("Коннектор");
	Результат.Добавить("JSON");
	Результат.Добавить("Формат");
	Результат.Добавить("БезURL");
	Результат.Добавить("НеизвестнаяЦель");
	Результат.Добавить("СпециальныеСимволы");
	Результат.Добавить("Справка");
	Результат.Добавить("Версия");
	Результат.Добавить("УдаленнаяКоманда");

	Возврат Результат;

КонецФункции

Функция ДанныеСценария(Сценарий)

	Если Сценарий = "Платформа" Тогда
		Возврат НовыеДанные(
			"convert --target 1c --locale ru -- curl http://example.com",
			0,
			КодПлатформы() + Символы.ПС,
			""
		);
	ИначеЕсли Сценарий = "Коннектор" Тогда
		Возврат НовыеДанные(
			"convert --target connector ""curl http://example.com""",
			0,
			"Результат = КоннекторHTTP.Get(""http://example.com"");" + Символы.ПС,
			""
		);
	ИначеЕсли Сценарий = "JSON" Тогда
		Возврат НовыеДанные(
			"convert --format json ""curl http://example.com""",
			0,
			УспешныйJSON(),
			""
		);
	ИначеЕсли Сценарий = "Формат" Тогда
		Возврат НовыеДанные(
			"convert --format xml ""curl http://example.com""",
			2,
			"",
			"argument.invalid_value: Формат должен иметь значение text или json" + Символы.ПС
		);
	ИначеЕсли Сценарий = "БезURL" Тогда
		Возврат НовыеДанные(
			"convert ""curl""",
			3,
			"",
			"ошибка [curlone.command.url_required]: В команде не указан URL" + Символы.ПС
		);
	ИначеЕсли Сценарий = "СпециальныеСимволы" Тогда
		Возврат НовыеДанные(
			"convert --target connector ""curl http://example.com/!OS!""",
			0,
			"Результат = КоннекторHTTP.Get(""http://example.com/!OS!"");" + Символы.ПС,
			""
		);
	ИначеЕсли Сценарий = "Справка" Тогда
		Возврат НовыеДанные("--help", 0, ОбщаяСправка(), "");
	ИначеЕсли Сценарий = "Версия" Тогда
		Возврат НовыеДанные("--version", 0, "curlone 2.0.0-alpha.1" + Символы.ПС, "");
	ИначеЕсли Сценарий = "УдаленнаяКоманда" Тогда
		Возврат НовыеДанные("web", 2, "", "Неизвестная команда curlone" + Символы.ПС);
	КонецЕсли;

	Возврат НовыеДанные(
		"convert --target unknown ""curl http://example.com""",
		4,
		"",
		"ошибка [curlone.generator.unknown]: Целевой генератор не зарегистрирован" + Символы.ПС
	);

КонецФункции

Функция НовыеДанные(Аргументы, Код, СтандартныйВывод, ВыводОшибок)

	Возврат Новый Структура(
		"Аргументы,Код,СтандартныйВывод,ВыводОшибок",
		Аргументы,
		Код,
		СтандартныйВывод,
		ВыводОшибок
	);

КонецФункции

Функция ВыполнитьПроцесс(Аргументы)

	КаталогПроекта = Новый Файл(ТекущийКаталог()).ПолноеИмя;
	Если Не Новый Файл(ОбъединитьПути(КаталогПроекта, "src/main.os")).Существует() Тогда
		КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогПроекта, "..")).ПолноеИмя;
	КонецЕсли;
	КоманднаяСтрока = "oscript src/main.os " + Аргументы;
	Процесс = СоздатьПроцесс(КоманднаяСтрока, КаталогПроекта, Истина, Истина);
	Процесс.Запустить();
	Потоки = ПрочитатьПотокиДоЗавершения(Процесс);

	Возврат Новый Структура(
		"Код,СтандартныйВывод,ВыводОшибок",
		Процесс.КодВозврата,
		Потоки.СтандартныйВывод,
		Потоки.ВыводОшибок
	);

КонецФункции

Функция ВыполнитьПроцессСПеренаправленнымВводом()

	КаталогПроекта = Новый Файл(ТекущийКаталог()).ПолноеИмя;
	Если Не Новый Файл(ОбъединитьПути(КаталогПроекта, "src/main.os")).Существует() Тогда
		КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогПроекта, "..")).ПолноеИмя;
	КонецЕсли;

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоWindows = Найти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0;
	Если ЭтоWindows Тогда
		КоманднаяСтрока = "cmd.exe /D /S /C ""echo curl http://example.com|oscript src/main.os""";
	Иначе
		КоманднаяСтрока = "/bin/sh -c ""printf 'curl http://example.com' | oscript src/main.os""";
	КонецЕсли;

	Процесс = СоздатьПроцесс(КоманднаяСтрока, КаталогПроекта, Истина, Истина);
	Процесс.Запустить();
	Потоки = ПрочитатьПотокиДоЗавершения(Процесс);

	Возврат Новый Структура(
		"Код,СтандартныйВывод,ВыводОшибок",
		Процесс.КодВозврата,
		Потоки.СтандартныйВывод,
		Потоки.ВыводОшибок
	);

КонецФункции

Функция ПрочитатьПотокиДоЗавершения(Процесс)

	СтандартныйВывод = "";
	ВыводОшибок = "";
	Пока Не Процесс.Завершен
		Или Процесс.ПотокВывода.ЕстьДанные
		Или Процесс.ПотокОшибок.ЕстьДанные Цикл

		ПрочитаныДанные = Ложь;
		Если Процесс.ПотокВывода.ЕстьДанные Тогда
			СтандартныйВывод = СтандартныйВывод + Процесс.ПотокВывода.Прочитать();
			ПрочитаныДанные = Истина;
		КонецЕсли;

		Если Процесс.ПотокОшибок.ЕстьДанные Тогда
			ВыводОшибок = ВыводОшибок + Процесс.ПотокОшибок.Прочитать();
			ПрочитаныДанные = Истина;
		КонецЕсли;

		Если Не ПрочитаныДанные Тогда
			Приостановить(10);
		КонецЕсли;

	КонецЦикла;

	Процесс.ОжидатьЗавершения();
	Пока Процесс.ПотокВывода.ЕстьДанные Цикл
		СтандартныйВывод = СтандартныйВывод + Процесс.ПотокВывода.Прочитать();
	КонецЦикла;

	Пока Процесс.ПотокОшибок.ЕстьДанные Цикл
		ВыводОшибок = ВыводОшибок + Процесс.ПотокОшибок.Прочитать();
	КонецЦикла;

	СтандартныйВывод = ВосстановитьЗавершающийПереводСтроки(СтандартныйВывод);
	ВыводОшибок = ВосстановитьЗавершающийПереводСтроки(ВыводОшибок);

	Возврат Новый Структура(
		"СтандартныйВывод,ВыводОшибок",
		СтандартныйВывод,
		ВыводОшибок
	);

КонецФункции

Функция ВосстановитьЗавершающийПереводСтроки(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	Если Прав(Текст, 1) = Символы.ПС Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Текст + Символы.ПС;

КонецФункции

Функция НормализоватьПереводыСтрок(Текст)

	Возврат СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);

КонецФункции

Функция КодПлатформы()

	Возврат "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

КонецФункции

Функция УспешныйJSON()

	Код = "Соединение = Новый HTTPСоединение(\""example.com\"", 80);\n"
		+ "HTTPЗапрос = Новый HTTPЗапрос(\""/\"");\n\n"
		+ "HTTPОтвет = Соединение.ВызватьHTTPМетод(\""GET\"", HTTPЗапрос);";
	Шаблон = "{
	|""success"": true,
	|""target"": ""1c"",
	|""code"": ""%1"",
	|""errors"": [],
	|""warnings"": []
	|}
	|";

	Возврат СтрШаблон(Шаблон, Код);

КонецФункции

Функция ОбщаяСправка()

	Возврат "curlone преобразует команды curl в код на языке 1С.
	|
	|Использование:
	|  curlone convert [ОПЦИИ] [КОМАНДА]
	|  curlone serve [ОПЦИИ]
	|  curlone help [КОМАНДА]
	|
	|Команды:
	|  convert  Преобразовать команду curl в код
	|  serve    Запустить веб-интерфейс
	|  help     Показать справку
	|
	|Опции:
	|  -h, --help  Показать справку
	|      --version  Показать версию
	|";

КонецФункции

#КонецОбласти

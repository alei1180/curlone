#Использовать asserts
#Использовать errors
#Использовать "../.."
#Использовать "../../src/cli"

Перем _ПоследниеАргументы; // Массив из Строка
Перем _Исключение; // Булево
Перем _ПеренаправленСтандартныйВвод; // Булево

#Область Тесты

&Тест
Процедура ТестДолжен_ПоказатьОбщуюСправкуБезАргументов() Экспорт

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ВыполнитьКоманду(Новый Массив);

	// Проверка
	Ожидаем.Что(Результат.КодЗавершения(), "Код завершения справки").Равно(0);
	Ожидаем.Что(Результат.СтандартныйВывод(), "Общая справка").Равно(ОжидаемаяОбщаяСправка());
	Ожидаем.Что(Результат.ВыводОшибок(), "Ошибки при выводе справки").Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--help")
&ИсточникЗначение("-h")
&ИсточникЗначение("help")
Процедура ТестДолжен_ПоказатьОбщуюСправкуПоОпцииИКоманде(Аргумент) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить(Аргумент);

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(Результат, 0, ОжидаемаяОбщаяСправка(), "");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Опция")
&ИсточникЗначение("КомандаСправки")
Процедура ТестДолжен_ПоказатьСправкуConvert(Сценарий) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Если Сценарий = "Опция" Тогда
		Аргументы.Добавить("convert");
		Аргументы.Добавить("--help");
	Иначе
		Аргументы.Добавить("help");
		Аргументы.Добавить("convert");
	КонецЕсли;

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(Результат, 0, ОжидаемаяСправкаConvert(), "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьСправкуServe() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("help");
	Аргументы.Добавить("serve");

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(Результат, 0, ОжидаемаяСправкаServe(), "");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("unknown")
&ИсточникЗначение("web")
Процедура ТестДолжен_ОтклонитьНеизвестнуюКоманду(Команда) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить(Команда);

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(
		Результат,
		2,
		"",
		"Неизвестная команда curlone"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоказатьВерсию() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("--version");
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект, "9.8.7");

	// Действие
	Результат = Приложение.ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(Результат, 0, "curlone 9.8.7", "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьДопустимыйЗапускСервера() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("serve");
	Аргументы.Добавить("--port");
	Аргументы.Добавить("8080");

	// Действие
	Результат = Новый КонсольноеПриложениеCurlone(ЭтотОбъект).ПараметрыЗапускаСервера(Аргументы);

	// Проверка
	Ожидаем.Что(Результат, "Параметры запуска сервера").Существует();
	Ожидаем.Что(Результат.Порт, "Порт сервера").Равно(8080);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0")
&ИсточникЗначение("65536")
&ИсточникЗначение("нечисло")
Процедура ТестДолжен_ОтклонитьНедопустимыйПортСервера(Порт) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("serve");
	Аргументы.Добавить("--port");
	Аргументы.Добавить(Порт);

	// Действие
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект);
	ПараметрыСервера = Приложение.ПараметрыЗапускаСервера(Аргументы);
	Результат = Приложение.ВыполнитьКоманду(Аргументы);

	// Проверка
	Ожидаем.Что(ПараметрыСервера, "Параметры недопустимого запуска").Равно(Неопределено);
	Ожидаем.Что(Результат.КодЗавершения(), "Код ошибки порта").Равно(2);
	Ожидаем.Что(Результат.ВыводОшибок(), "Сообщение ошибки порта").Равно(
		"argument.invalid_value: Порт должен быть целым числом от 1 до 65535"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодставитьСтандартныйВводПриПеренаправлении() Экспорт

	// Подготовка
	_ПеренаправленСтандартныйВвод = Истина;
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект, "1.8.0", ЭтотОбъект);

	// Действие
	Результат = Приложение.ПодготовитьАргументы(Новый Массив);

	// Проверка
	Ожидаем.Что(Результат, "Аргументы автоматического стандартного ввода").ИмеетДлину(3);
	Ожидаем.Что(Результат[0], "Команда").Равно("convert");
	Ожидаем.Что(Результат[1], "Опция ввода").Равно("--input");
	Ожидаем.Что(Результат[2], "Стандартный ввод").Равно("-");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодставитьСтандартныйВводПослеОпцийКонвертации() Экспорт

	// Подготовка
	_ПеренаправленСтандартныйВвод = Истина;
	Аргументы = Новый Массив;
	Аргументы.Добавить("convert");
	Аргументы.Добавить("--format");
	Аргументы.Добавить("json");
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект, "1.8.0", ЭтотОбъект);

	// Действие
	Результат = Приложение.ПодготовитьАргументы(Аргументы);

	// Проверка
	Ожидаем.Что(Результат, "Аргументы автоматического стандартного ввода").ИмеетДлину(5);
	Ожидаем.Что(Результат[0], "Команда").Равно("convert");
	Ожидаем.Что(Результат[1], "Опция формата").Равно("--format");
	Ожидаем.Что(Результат[2], "Формат").Равно("json");
	Ожидаем.Что(Результат[3], "Опция ввода").Равно("--input");
	Ожидаем.Что(Результат[4], "Стандартный ввод").Равно("-");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьИсполнителюТолькоХвостАргументов() Экспорт

	// Подготовка
	_Исключение = Ложь;
	Команда = "convert";
	Аргументы = Новый Массив;
	Аргументы.Добавить(Команда);
	Аргументы.Добавить("первый");
	Аргументы.Добавить("второй");
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект);

	// Действие
	Результат = Приложение.ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(Результат, 0, "готово", "");
	Ожидаем.Что(_ПоследниеАргументы, "Хвост аргументов, переданный исполнителю").ИмеетДлину(2);
	Ожидаем.Что(_ПоследниеАргументы[0], "Первый аргумент исполнителя").Равно("первый");
	Ожидаем.Что(_ПоследниеАргументы[1], "Второй аргумент исполнителя").Равно("второй");
	Ожидаем.Что(Аргументы, "Неизменность исходных аргументов").ИмеетДлину(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкрытьИсключениеИсполнителя() Экспорт

	// Подготовка
	_Исключение = Истина;
	Аргументы = Новый Массив;
	Аргументы.Добавить("convert");
	Приложение = Новый КонсольноеПриложениеCurlone(ЭтотОбъект);

	// Действие
	Результат = Приложение.ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьРезультат(
		Результат,
		1,
		"",
		"Внутренняя ошибка выполнения команды curlone"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Имитирует проверку перенаправления стандартного ввода.
Функция СтандартныйВводПеренаправлен() Экспорт

	Возврат _ПеренаправленСтандартныйВвод;

КонецФункции

// Имитирует исполнителя консольной команды.
Функция ВыполнитьКоманду(Аргументы) Экспорт

	Если _Исключение Тогда
		ВызватьИсключение "секрет";
	КонецЕсли;

	_ПоследниеАргументы = Аргументы;

	Возврат Новый РезультатВыполненияCurlone(0, "готово", "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОжидаемаяОбщаяСправка()

	Возврат "curlone преобразует команды curl в код на языке 1С.
	|
	|Использование:
	|  curlone convert [ОПЦИИ] [КОМАНДА]
	|  curlone serve [ОПЦИИ]
	|  curlone help [КОМАНДА]
	|
	|Команды:
	|  convert  Преобразовать команду curl в код
	|  serve    Запустить веб-интерфейс
	|  help     Показать справку
	|
	|Опции:
	|  -h, --help  Показать справку
	|      --version  Показать версию";

КонецФункции

Функция ОжидаемаяСправкаConvert()

	Возврат "Использование:
	|  curlone convert [ОПЦИИ] [КОМАНДА]
	|  curlone convert [ОПЦИИ] -- curl [АРГУМЕНТЫ]
	|
	|Опции:
	|  -t, --target 1c|connector  Цель, по умолчанию 1c
	|  -l, --locale ru|en         Язык кода, по умолчанию ru
	|  -f, --format text|json     Формат результата, по умолчанию text
	|  -i, --input ФАЙЛ           Прочитать команду из файла, - означает stdin
	|  -o, --output ФАЙЛ          Записать результат в файл, - означает stdout
	|      --fail-on-warning      Вернуть код 5 при предупреждениях
	|  -h, --help                 Показать справку";

КонецФункции

Функция ОжидаемаяСправкаServe()

	Возврат "Использование:
	|  curlone serve [ОПЦИИ]
	|
	|Опции:
	|  -p, --port ПОРТ  Порт веб-сервера
	|  -o, --open       Открыть веб-интерфейс в браузере
	|  -h, --help       Показать справку";

КонецФункции

Процедура ПроверитьРезультат(Результат, Код, СтандартныйВывод, ВыводОшибок)

	Ожидаем.Что(Результат.КодЗавершения(), "Код завершения результата исполнителя").Равно(Код);
	Ожидаем.Что(Результат.СтандартныйВывод(), "Стандартный вывод результата исполнителя").Равно(СтандартныйВывод);
	Ожидаем.Что(Результат.ВыводОшибок(), "Вывод ошибок результата исполнителя").Равно(ВыводОшибок);

КонецПроцедуры

#КонецОбласти

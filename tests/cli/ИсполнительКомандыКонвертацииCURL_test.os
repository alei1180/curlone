// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts
#Использовать errors
#Использовать "../.."
#Использовать "../../src/cli"

Перем _РежимКонвертера; // Строка
Перем _ЧислоВызововКонвертера; // Число

#Область Тесты

&Тест
Процедура ТестДолжен_ВернутьПолныйКодПлатформыБезЗавершающегоПереводаСтроки() Экспорт

	// Подготовка
	Аргументы = МассивИз("curl http://example.com");
	ОжидаемыйВывод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Результат = Новый ИсполнительКомандыКонвертацииCURL().ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьПолныйРезультат(Результат, 0, ОжидаемыйВывод, "");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьКомандуИзФайлаUTF8() Экспорт

	// Подготовка
	Путь = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать("curl http://example.com");
	Запись.Закрыть();

	Аргументы = МассивИз("--input", Путь);
	ОжидаемыйВывод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Результат = Новый ИсполнительКомандыКонвертацииCURL().ВыполнитьКоманду(Аргументы);

	// Проверка
	УдалитьФайлы(Путь);
	ПроверитьПолныйРезультат(Результат, 0, ОжидаемыйВывод, "");

КонецПроцедуры


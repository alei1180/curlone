&Тест
Процедура ТестДолжен_ЗаписатьОтсутствующиеПоляПредупрежденияКакNull() Экспорт

	// Подготовка
	_РежимКонвертера = "ПредупреждениеБезПолей";
	_ЧислоВызововКонвертера = 0;
	Исполнитель = Новый ИсполнительКомандыКонвертацииCURL(ЭтотОбъект);
	Аргументы = МассивИз("--format", "json", "curl http://example.com");

	// Действие
	Результат = Исполнитель.ВыполнитьКоманду(Аргументы);

	// Проверка
	Данные = РазобратьJSON(Результат.СтандартныйВывод());
	Предупреждение = Данные["warnings"][0];
	Ожидаем.Что(Предупреждение.Количество(), "Количество полей предупреждения").Равно(6);
	Ожидаем.Что(Предупреждение["capability"], "Возможность предупреждения").Равно(Неопределено);
	Ожидаем.Что(Предупреждение["option"], "Исходная опция предупреждения").Равно(Неопределено);
	Ожидаем.Что(Предупреждение["position"], "Позиция предупреждения").Равно(Неопределено);
	Ожидаем.Что(Предупреждение["target"], "Цель предупреждения").Равно(Неопределено);
	Ожидаем.Что(_ЧислоВызововКонвертера, "Количество вызовов конвертера").Равно(1);

КонецПроцедуры


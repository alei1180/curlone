&Тест
Процедура ТестДолжен_ВывестиКодИПредупреждениеВТекстовомРежиме() Экспорт

	// Подготовка
	Аргументы = МассивИз("curl --retry 1 https://example.org");
	ОжидаемыйКод = "ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	|
	|Соединение = Новый HTTPСоединение(""example.org"", 443, , , , , ЗащищенноеСоединение);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";
	ОжидаемаяОшибка = "предупреждение [curlone.generator.unsupported_capability]: "
		+ "Не поддерживается возможность: retry.count";

	// Действие
	Результат = Новый ИсполнительКомандыКонвертацииCURL().ВыполнитьКоманду(Аргументы);

	// Проверка
	ПроверитьПолныйРезультат(Результат, 0, ОжидаемыйКод, ОжидаемаяОшибка);

КонецПроцедуры


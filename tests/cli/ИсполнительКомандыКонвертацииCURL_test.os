	// Проверка
	ПроверитьПолныйРезультат(Результат, 0, "", "");
	Ожидаем.Что(Результат.ПутьВывода(), "Путь к файлу результата").Равно("result.os");
	Ожидаем.Что(Результат.СодержимоеФайла(), "Содержимое файла результата").Равно(ОжидаемыйВывод);


&Тест
Процедура ТестДолжен_ВернутьТочныйJSONСПредупреждением() Экспорт

	// Подготовка
	Аргументы = МассивИз(
		"--format", "json", "curl --retry 1 https://example.org"
	);

	// Действие
	Результат = Новый ИсполнительКомандыКонвертацииCURL().ВыполнитьКоманду(Аргументы);

	// Проверка
	Данные = РазобратьJSON(Результат.СтандартныйВывод());
	ПроверитьПолныйJSON(Результат, Истина, "1c", ОжидаемыйКодСПредупреждением(), 0, 1);
	Предупреждение = Данные["warnings"][0];
	Ожидаем.Что(Предупреждение.Количество(), "Количество полей предупреждения JSON").Равно(6);
	Ожидаем.Что(Предупреждение["code"], "Код предупреждения JSON").Равно(
		"curlone.generator.unsupported_capability"
	);
	Ожидаем.Что(Предупреждение["message"], "Сообщение предупреждения JSON").Равно(
		"Не поддерживается возможность: retry.count"
	);
	Ожидаем.Что(Предупреждение["capability"], "Возможность предупреждения JSON").Равно("retry.count");
	Ожидаем.Что(Предупреждение["option"], "Исходная опция предупреждения JSON").Равно("--retry");
	Ожидаем.Что(Предупреждение["position"], "Позиция предупреждения JSON").Равно(2);
	Ожидаем.Что(Предупреждение["target"], "Цель предупреждения JSON").Равно("1c");

КонецПроцедуры


&Тест
Процедура ТестДолжен_ВернутьБезопасныйJSONПриВнутреннемСбое() Экспорт

	// Подготовка
	_РежимКонвертера = "Исключение";
	Исполнитель = Новый ИсполнительКомандыКонвертацииCURL(ЭтотОбъект);
	Аргументы = МассивИз("--format", "json", "curl http://example.com");

	// Действие
	Результат = Исполнитель.ВыполнитьКоманду(Аргументы);

	// Проверка
	Данные = РазобратьJSON(Результат.СтандартныйВывод());
	ПроверитьПолныйJSON(Результат, Ложь, "1c", "", 1, 0, 1);
	Ошибка = Данные["errors"][0];
	Ожидаем.Что(Ошибка.Количество(), "Количество полей внутренней ошибки").Равно(3);
	Ожидаем.Что(Ошибка["code"], "Код внутренней ошибки").Равно("internal.invariant_violation");
	Ожидаем.Что(Ошибка["message"], "Безопасное сообщение внутренней ошибки").Равно(
		"Внутренняя ошибка выполнения команды convert"
	);
	Ожидаем.Что(Ошибка["position"], "Позиция внутренней ошибки").Равно(Неопределено);
	Ожидаем.Что(
		СтрНайти(Результат.СтандартныйВывод(), "секрет"),
		"Позиция секрета в стандартном выводе"
	).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает тестовый результат или имитирует внутренний сбой.
Функция Конвертировать(Параметры) Экспорт

	_ЧислоВызововКонвертера = _ЧислоВызововКонвертера + 1;

	Если _РежимКонвертера = "Исключение" Тогда
		ВызватьИсключение "секрет-внутреннего-сбоя";
	КонецЕсли;

	Если _РежимКонвертера = "ПредупреждениеБезПолей" Тогда
		Предупреждения = Новый Массив;
		Предупреждения.Добавить(Новый ПредупреждениеКонвертацииCURL("test.warning", "Тест"));

		Возврат Новый РезультатКонвертацииCURL("code", Неопределено, Предупреждения, Параметры.Цель);
	КонецЕсли;

	Ошибки = Новый Массив;
	Ошибки.Добавить(ФабрикаОшибок.Создать(
		КодыОшибокCurlone.НеизвестныйГенератор(),
		"Целевой генератор не зарегистрирован"
	));

	Возврат Новый РезультатКонвертацииCURL("", Ошибки, Неопределено, Параметры.Цель);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПолныйРезультат(Результат, Код, СтандартныйВывод, ВыводОшибок)

	Ожидаем.Что(Результат.КодЗавершения(), "Код завершения результата").Равно(Код);
	Ожидаем.Что(Результат.СтандартныйВывод(), "Стандартный вывод результата").Равно(СтандартныйВывод);
	Ожидаем.Что(Результат.ВыводОшибок(), "Вывод ошибок результата").Равно(ВыводОшибок);

КонецПроцедуры

Процедура ПроверитьПолныйJSON(
	Результат,
	Успех,
	Цель,
	Код,
	ЧислоОшибок,
	ЧислоПредупреждений,
	КодЗавершения = 0
)

	ЕстьЗавершающийПереводСтроки = Прав(Результат.СтандартныйВывод(), 1) = Символы.ПС;
	Ожидаем.Что(ЕстьЗавершающийПереводСтроки, "Завершающий перевод строки вывода JSON").Равно(Ложь);
	Ожидаем.Что(Результат.КодЗавершения(), "Код завершения результата JSON").Равно(КодЗавершения);
	Ожидаем.Что(Результат.ВыводОшибок(), "Вывод ошибок результата JSON").Равно("");
	Данные = РазобратьJSON(Результат.СтандартныйВывод());
	Ожидаем.Что(Данные.Количество(), "Количество полей результата JSON").Равно(5);
	Ожидаем.Что(Данные["success"], "Признак успеха результата JSON").Равно(Успех);
	Ожидаем.Что(Данные["target"], "Цель результата JSON").Равно(Цель);
	Ожидаем.Что(Данные["code"], "Код результата JSON").Равно(Код);
	Ожидаем.Что(Данные["errors"].Количество(), "Количество ошибок результата JSON").Равно(ЧислоОшибок);
	Ожидаем.Что(Данные["warnings"].Количество(), "Количество предупреждений результата JSON").Равно(
		ЧислоПредупреждений
	);

КонецПроцедуры

Функция РазобратьJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

Функция ОжидаемыйКодСПредупреждением()

	Возврат "ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	|
	|Соединение = Новый HTTPСоединение(""example.org"", 443, , , , , ЗащищенноеСоединение);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

КонецФункции

Функция МассивИз(
	Значение1,
	Значение2 = Неопределено,
	Значение3 = Неопределено,
	Значение4 = Неопределено,
	Значение5 = Неопределено,
	Значение6 = Неопределено
)

	Результат = Новый Массив;
	ДобавитьЕслиОпределено(Результат, Значение1);
	ДобавитьЕслиОпределено(Результат, Значение2);
	ДобавитьЕслиОпределено(Результат, Значение3);
	ДобавитьЕслиОпределено(Результат, Значение4);
	ДобавитьЕслиОпределено(Результат, Значение5);
	ДобавитьЕслиОпределено(Результат, Значение6);

	Возврат Результат;

КонецФункции

Процедура ДобавитьЕслиОпределено(Массив, Значение)

	Если Значение <> Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

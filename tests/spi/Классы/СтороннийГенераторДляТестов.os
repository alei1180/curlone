#Область ПрограммныйИнтерфейс

// Возвращает уникальный идентификатор генератора.
//
// Возвращаемое значение:
//   Строка - Идентификатор генератора.
Функция Идентификатор() Экспорт

	Возврат "third-party";

КонецФункции

// Возвращает человекочитаемое наименование генератора.
//
// Возвращаемое значение:
//   Строка - Наименование генератора.
Функция Наименование() Экспорт

	Возврат "Сторонний генератор для тестов";

КонецФункции

// Возвращает поддерживаемую версию контракта генератора.
//
// Возвращаемое значение:
//   Число - Версия контракта.
Функция ВерсияКонтракта() Экспорт

	Возврат 1;

КонецФункции

// Возвращает поддерживаемые генератором возможности.
//
// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Идентификаторы возможностей.
Функция Возможности() Экспорт

	Возврат Новый ФиксированныйМассив(Новый Массив);

КонецФункции

// Генерирует программный код из подготовленного контекста.
//
// Параметры:
//   КонтекстГенерацииКода - КонтекстГенерацииКода - Неизменяемый контекст генерации.
//
// Возвращаемое значение:
//   Строка - Программный код BSL.
Функция Сгенерировать(КонтекстГенерацииКода) Экспорт

	Возврат СтрШаблон(
		"// generator=%1; locale=%2; operations=%3",
		КонтекстГенерацииКода.ИдентификаторГенератора(),
		КонтекстГенерацииКода.Локаль(),
		КонтекстГенерацииКода.Операции().Количество()
	);

КонецФункции

#КонецОбласти

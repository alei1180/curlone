// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts
#Использовать "../../src/public"
#Использовать "../../src/domain"
#Использовать "../../src/generation"
#Использовать "../domain"
#Использовать "Классы"

#Область Тесты

&Тест
Процедура ТестДолжен_ВыполнитьКонтрактСтороннегоГенератора() Экспорт

	// Подготовка
	Генератор = Новый СтороннийГенераторДляТестов();
	Операции = Новый Массив;
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl https://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Описание = Новый ОписаниеГенератораCURL(
		"third-party", "Сторонний", 1, Новый ФиксированныйМассив(СтрРазделить("protocol.https", "|")));
	ПубличныйКонтекст = Новый КонтекстГенерацииКода(
		Выполнение.Операции(),
		"ru",
		Новый Соответствие,
		Описание.Идентификатор(),
		Описание.Возможности()
	);
	Операции.Добавить(ПубличныйКонтекст.Операции()[0]);
	Контекст = Новый КонтекстГенерацииКода(
		Операции,
		ЛокалиКонвертацииCURL.Русская(),
		Новый Соответствие,
		"third-party",
		Описание.Возможности()
	);

	// Действие
	Идентификатор = Генератор.Идентификатор();
	Наименование = Генератор.Наименование();
	ВерсияКонтракта = Генератор.ВерсияКонтракта();
	Возможности = Генератор.Возможности();
	Код = Генератор.Сгенерировать(Контекст);

	// Проверка
	Ожидаем.Что(Идентификатор).Равно("third-party");
	Ожидаем.Что(Наименование).Равно("Сторонний генератор для тестов");
	Ожидаем.Что(ВерсияКонтракта).Равно(ВерсииКонтрактаГенератораCURL.Актуальная());
	Ожидаем.Что(ВерсияКонтракта).Равно(1);
	Ожидаем.Что(ТипЗнч(Возможности)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Возможности).ИмеетДлину(0);
	Ожидаем.Что(Код).Равно(
		СтрШаблон(
			"// generator=third-party; locale=%1; operations=1",
			ЛокалиКонвертацииCURL.Русская()
		)
	);

КонецПроцедуры

#КонецОбласти

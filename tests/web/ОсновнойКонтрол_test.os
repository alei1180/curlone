&Тест
Процедура ТестДолжен_ВозвращатьПредупреждения() Экспорт

	// Подготовка
	Тело = "{""command"":""curl --upload-file a --upload-file b https://example.org""}";
	ОжидаемоеПредупреждение = Новый Соответствие;
	ОжидаемоеПредупреждение.Вставить("code", "curlone.generator.option_ignored");
	ОжидаемоеПредупреждение.Вставить(
		"message",
		"Файл 'b' из опции -T, --upload-file был проигнорирован, т.к. отсутствует URL для файла"
	);
	ОжидаемоеПредупреждение.Вставить("capability", "body.upload");
	ОжидаемоеПредупреждение.Вставить("option", "--upload-file");
	ОжидаемоеПредупреждение.Вставить("position", 4);
	ОжидаемоеПредупреждение.Вставить("target", Null);
	Предупреждения = Новый Массив;
	Предупреждения.Добавить(ОжидаемоеПредупреждение);

	// Действие
	Ответ = ОтправитьJSON(Тело);

	// Проверка
	ОжидаемыеДанные = ОжидаемыйУспешныйОтвет("1c", ОжидаемыйКодСПредупреждением());
	ОжидаемыеДанные["warnings"] = Предупреждения;
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтображатьСсылкуНаВерсиюИзPackagedef() Экспорт

	// Подготовка
	ВерсияПриложения = Новый ИнформацияОПакете("packagedef").Версия();
	ОжидаемаяСсылкаНаВерсию = "https://github.com/alei1180/curlone/releases/tag/ver" + ВерсияПриложения;

	// Действие
	ТекстСтраницы = КоннекторHTTP.Get(URL()).Текст();
	СценарийСтраницы = КоннекторHTTP.Get(URL() + "/static/index.js").Текст();

	// Проверка
	Ожидаем.Что(ТекстСтраницы, "Версия приложения на главной странице").Содержит("ver " + ВерсияПриложения);
	Ожидаем.Что(ТекстСтраницы, "Ссылка на выпуск на главной странице").Содержит(ОжидаемаяСсылкаНаВерсию);
	Ожидаем.Что(ТекстСтраницы, "Отключённые элементы формы до появления API v2").Содержит("disabled");
	Ожидаем.Что(СтрНайти(СценарийСтраницы, "/api/v1"), "Ссылка на API v1 в сценарии страницы").Равно(0);
	Ожидаем.Что(СтрНайти(СценарийСтраницы, "fetch("), "Прямой HTTP-запрос из сценария страницы").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПубликоватьУдаленныеМаршрутыAPIv1() Экспорт

	Пути = Новый Массив;
	Пути.Добавить("/api");
	Пути.Добавить("/api/v1");
	Пути.Добавить("/api/v1/convert");

	Для Каждого Путь Из Пути Цикл
		// Действие
		Ответ = КоннекторHTTP.Get(URL() + Путь);

		// Проверка
		Ожидаем.Что(Ответ.КодСостояния, "Код ответа отсутствующего маршрута " + Путь).Равно(404);
	КонецЦикла;

	// Действие
	ОтветPOST = КоннекторHTTP.Post(URL() + "/api/v1/convert", "");

	// Проверка
	Ожидаем.Что(ОтветPOST.КодСостояния, "Код POST-ответа удалённого маршрута конвертации").Равно(404);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтправитьJSON(Тело)

	Возврат ОтправитьJSONСЗаголовком(Тело, "application/json");

КонецФункции

Функция ОтправитьJSONСЗаголовком(Тело, ТипСодержимого)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", ТипСодержимого);
	Заголовки.Вставить("Accept", "application/json");

	Возврат КоннекторHTTP.Post(
		URL() + "/api/v2/convert",
		Тело,
		Неопределено,
		Новый Структура("Заголовки", Заголовки)
	);

КонецФункции

Функция ОтправитьJSONСМетодом(Метод, Тело)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	ДополнительныеПараметры = Новый Структура("Заголовки", Заголовки);

	Если Метод = "PUT" Тогда
		Возврат КоннекторHTTP.Put(URL() + "/api/v2/convert", Тело, Неопределено, ДополнительныеПараметры);
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемый метод теста";

КонецФункции

Процедура ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, КодСостояния = 200)

	Ожидаем.Что(Ответ.КодСостояния, "Код состояния HTTP-ответа").Равно(КодСостояния);
	Ожидаем.Что(Ответ.Заголовки["Content-Type"], "Тип содержимого HTTP-ответа").Равно(
		"application/json"
	);
	Данные = Новый ДесериализаторJson().Десериализовать(Ответ.Текст(), Неопределено, Истина);
	ЗаписьJSON = Новый СериализаторJson;
	Ожидаем.Что(
		ЗаписьJSON.Сериализовать(Данные),
		"Полное JSON-содержимое HTTP-ответа"
	).Равно(ЗаписьJSON.Сериализовать(ОжидаемыеДанные));

КонецПроцедуры

Функция ОжидаемыйОтветСОшибкой(Код, Сообщение)

	Ошибки = Новый Массив;
	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ошибка.Вставить("position", Null);
	Ошибки.Добавить(Ошибка);

	Данные = Новый Соответствие;
	Данные.Вставить("success", Ложь);
	Данные.Вставить("target", "");
	Данные.Вставить("code", "");
	Данные.Вставить("errors", Ошибки);
	Данные.Вставить("warnings", Новый Массив);

	Возврат Данные;

КонецФункции

Функция СлучайНевернойФормыJSON(Имя)

	Если Имя = "ОбрезанныйJSON" Тогда
		Возврат СлучайJSON("{", 400, "data.invalid", "Тело запроса содержит неверный JSON");
	ИначеЕсли Имя = "Массив" Тогда
		Возврат СлучайJSON("[]", 400, "argument.invalid_type", "Тело JSON должно быть объектом");
	ИначеЕсли Имя = "Скаляр" Тогда
		Возврат СлучайJSON("1", 400, "argument.invalid_type", "Тело JSON должно быть объектом");
	ИначеЕсли Имя = "БезКоманды" Тогда
		Возврат СлучайJSON("{}", 400, "argument.required", "Поле command обязательно");
	ИначеЕсли Имя = "ПустаяКоманда" Тогда
		Возврат СлучайJSON("{""command"":""""}", 400, "argument.required", "Поле command обязательно");
	ИначеЕсли Имя = "ТипКоманды" Тогда
		Возврат СлучайJSON("{""command"":1}", 400, "argument.invalid_type", "Поле command должно быть строкой");
	ИначеЕсли Имя = "ТипЦели" Тогда
		Возврат СлучайJSONПоля("target", "1", 400, "argument.invalid_type", "Поле target должно быть строкой");
	ИначеЕсли Имя = "ТипЛокали" Тогда
		Возврат СлучайJSONПоля("locale", "1", 400, "argument.invalid_type", "Поле locale должно быть строкой");
	ИначеЕсли Имя = "ЗначениеЦели" Тогда
		Возврат СлучайJSONПоля("target", """bad""", 422, "argument.invalid_value", "Неизвестное значение поля target");
	ИначеЕсли Имя = "ЗначениеЛокали" Тогда
		Возврат СлучайJSONПоля("locale", """bad""", 400, "argument.invalid_value", "Неизвестное значение поля locale");
	ИначеЕсли Имя = "СоставноеЗначениеЦели" Тогда
		Возврат СлучайJSONПоля(
			"target",
			"""1c,connector""",
			422,
			"argument.invalid_value",
			"Неизвестное значение поля target"
		);
	ИначеЕсли Имя = "СоставноеЗначениеЛокали" Тогда
		Возврат СлучайJSONПоля(
			"locale",
			"""ru,en""",
			400,
			"argument.invalid_value",
			"Неизвестное значение поля locale"
		);
	ИначеЕсли Имя = "ТипПараметров" Тогда
		Тело = "{""command"":""curl x"",""generatorOptions"":1}";
		Возврат СлучайJSON(Тело, 400, "argument.invalid_type", "Поле generatorOptions должно быть объектом");
	ИначеЕсли Имя = "ТипПараметра" Тогда
		Тело = "{""command"":""curl x"",""generatorOptions"":{""responseDeserializationFormat"":1}}";
		Сообщение = "Поле responseDeserializationFormat должно быть строкой";
		Возврат СлучайJSON(Тело, 400, "argument.invalid_type", Сообщение);
	ИначеЕсли Имя = "ЗначениеПараметра" Тогда
		Тело = "{""command"":""curl x"",""generatorOptions"":{""responseDeserializationFormat"":""xml""}}";
		Сообщение = "Неизвестное значение поля responseDeserializationFormat";
		Возврат СлучайJSON(Тело, 400, "argument.invalid_value", Сообщение);
	ИначеЕсли Имя = "ПолеЗапроса" Тогда
		Возврат СлучайJSONПоля("extra", "1", 400, "argument.invalid_value", "Запрос содержит неизвестное поле");
	ИначеЕсли Имя = "СоставноеПолеЗапроса" Тогда
		Возврат СлучайJSONПоля(
			"command,target",
			"1",
			400,
			"argument.invalid_value",
			"Запрос содержит неизвестное поле"
		);
	Иначе
		Тело = "{""command"":""curl x"",""generatorOptions"":{""extra"":1}}";
		Сообщение = "Параметры генератора содержат неизвестное поле";
		Возврат СлучайJSON(Тело, 400, "argument.invalid_value", Сообщение);
	КонецЕсли;

КонецФункции

Функция СлучайJSONПоля(Имя, ЗначениеJSON, Статус, Код, Сообщение)

	Тело = "{""command"":""curl x"",""" + Имя + """:" + ЗначениеJSON + "}";
	Возврат СлучайJSON(Тело, Статус, Код, Сообщение);

КонецФункции

Функция СлучайJSON(Тело, Статус, Код, Сообщение)

	Возврат Новый Структура("Тело,Статус,Код,Сообщение", Тело, Статус, Код, Сообщение);

КонецФункции

Функция ОжидаемыйОтветКонвертацииСОшибкой(Цель, Ошибки)

	Данные = Новый Соответствие;
	Данные.Вставить("success", Ложь);
	Данные.Вставить("target", Цель);
	Данные.Вставить("code", "");
	Данные.Вставить("errors", Ошибки);
	Данные.Вставить("warnings", Новый Массив);

	Возврат Данные;

КонецФункции

Функция ОжидаемыйУспешныйОтвет(Цель, Код)

	Данные = Новый Соответствие;
	Данные.Вставить("success", Истина);
	Данные.Вставить("target", Цель);
	Данные.Вставить("code", Код);
	Данные.Вставить("errors", Новый Массив);
	Данные.Вставить("warnings", Новый Массив);

	Возврат Данные;

КонецФункции

Функция ОжидаемыйКодСПредупреждением()

	Возврат "ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	|
	|Соединение = Новый HTTPСоединение(""example.org"", 443, , , , , ЗащищенноеСоединение);
	|HTTPЗапрос = Новый HTTPЗапрос(""/a"");
	|HTTPЗапрос.УстановитьИмяФайлаТела(""a"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""PUT"", HTTPЗапрос);";

КонецФункции

Функция КодGETДляExampleCom()

	Возврат "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

КонецФункции

Функция СтрокаРазмером(Основа, Размер)

	Части = Новый Массив;
	Части.Добавить(Основа);
	Для Индекс = СтрДлина(Основа) + 1 По Размер Цикл
		Части.Добавить(" ");
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

Процедура НачатьОжиданиеЗапуска()

	ЗадержкаМеждуПопытками = 100; // Миллисекунд
	ТаймаутОжидания = 15; // Секунд
	ВремяНачала = ТекущаяУниверсальнаяДата();

	Пока Истина Цикл

		Если ПроцессВебСервера.Завершен Тогда
			ВызватьИсключение СтрШаблон(
				"Веб-сервер завершился во время запуска с кодом %1.",
				ПроцессВебСервера.КодВозврата
			);
		КонецЕсли;

		КодСостояния = Неопределено;
		ТекстИсключения = "";
		Попытка
			Ответ = КоннекторHTTP.Head(URL(), Новый Структура("Таймаут", ТаймаутОжидания));
			КодСостояния = Ответ.КодСостояния;
		Исключение
			ТекстИсключения = СокрП(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ТекстИсключения = СтрПолучитьСтроку(ТекстИсключения, СтрЧислоСтрок(ТекстИсключения));
		КонецПопытки;

		Если КодСостояния = 200 Тогда
			Приостановить(ЗадержкаМеждуПопытками);
			Прервать;
		КонецЕсли;

		ПрошлоСекунд = ТекущаяУниверсальнаяДата() - ВремяНачала;
		Если ПрошлоСекунд > ТаймаутОжидания Или ЗначениеЗаполнено(КодСостояния) Тогда
			ВызватьИсключение СтрШаблон(
				"Не удалось запустить веб-сервер в течение %1 сек.: %2",
				ТаймаутОжидания,
				ТекстИсключения
			);
		КонецЕсли;

		Приостановить(ЗадержкаМеждуПопытками);

	КонецЦикла;

КонецПроцедуры

Функция URL()

	Возврат "http://127.0.0.1:3333";

КонецФункции

#КонецОбласти

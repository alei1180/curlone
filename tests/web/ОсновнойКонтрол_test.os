&ИсточникЗначение(65537, 413)
Процедура ТестДолжен_СоблюдатьГраницуРазмераТела(Размер, Статус) Экспорт

	// Подготовка
	Основа = "{""command"":""curl http://example.com""}";
	Тело = СтрокаРазмером(Основа, Размер);

	Если Статус = 200 Тогда
		ОжидаемыеДанные = ОжидаемыйУспешныйОтвет("1c", КодGETДляExampleCom());
	Иначе
		ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("data.too_large", "Тело запроса превышает 65536 байт");
	КонецЕсли;

	// Действие
	Ответ = ОтправитьJSON(Тело);

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, Статус);


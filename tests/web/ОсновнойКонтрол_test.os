#Использовать 1connector
#Использовать jason
#Использовать packageinfo

Перем ПроцессВебСервера; // Процесс

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередВсеми
Процедура ЗапуститьВебСервер() Экспорт

	ПроцессВебСервера = СоздатьПроцесс("oscript src/main.os serve", ".");
	ПроцессВебСервера.Запустить();

	НачатьОжиданиеЗапуска();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьВебСервер() Экспорт

	Если Не ПроцессВебСервера = Неопределено И Не ПроцессВебСервера.Завершен Тогда
		ПроцессВебСервера.Завершить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПубликоватьСпецификациюOpenAPI() Экспорт

	// Действие
	Ответ = КоннекторHTTP.Get(URL() + "/api/v2/openapi.json");

	// Проверка
	Ожидаем.Что(Ответ.КодСостояния, "Код ответа OpenAPI").Равно(200);
	Ожидаем.Что(Ответ.Заголовки["Content-Type"], "Тип содержимого OpenAPI").Содержит("application/json");
	Спецификация = Новый ДесериализаторJson().Десериализовать(Ответ.Текст(), Неопределено, Истина);
	Ожидаем.Что(Спецификация["openapi"], "Версия опубликованной спецификации").Равно("3.1.0");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("GET")
&ИсточникЗначение("PUT")
Процедура ТестДолжен_ОтклонятьМетодКромеPOST(Метод) Экспорт

	// Подготовка
	ОжидаемыеДанные = ОжидаемыйОтветСОшибкой("argument.invalid_value", "Метод HTTP должен быть POST");

	// Действие
	Если Метод = "GET" Тогда
		Ответ = КоннекторHTTP.Get(URL() + "/api/v2/convert");
	Иначе
		Ответ = ОтправитьJSONСМетодом("PUT", "{""command"":""curl http://example.com""}");
	КонецЕсли;

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, 405);
	Ожидаем.Что(Ответ.Заголовки["Allow"], "Разрешённые HTTP-методы").Равно("POST");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьНеверныйТипКонтента() Экспорт

	// Подготовка
	ОжидаемыеДанные = ОжидаемыйОтветСОшибкой(
		"argument.invalid_value",
		"Тип содержимого должен быть application/json"
	);

	// Действие
	Ответ = ОтправитьJSONСЗаголовком("{}", "text/plain");

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, 415);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПриниматьJSONСКодировкой() Экспорт

	// Подготовка
	Тело = "{""command"":""curl http://example.com""}";
	ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Ответ = ОтправитьJSONСЗаголовком(Тело, "application/json; charset=utf-8");

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыйУспешныйОтвет("1c", ОжидаемыйКод));

КонецПроцедуры


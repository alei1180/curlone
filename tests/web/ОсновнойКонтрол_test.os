Процедура ТестДолжен_ОтклонятьНевернуюФормуJSON(ИмяСлучая) Экспорт

	// Подготовка
	Случай = СлучайНевернойФормыJSON(ИмяСлучая);
	ОжидаемыеДанные = ОжидаемыйОтветСОшибкой(Случай.Код, Случай.Сообщение);

	// Действие
	Ответ = ОтправитьJSON(Случай.Тело);

	// Проверка
	ПроверитьПолныйJSONОтвет(Ответ, ОжидаемыеДанные, Случай.Статус);


#Использовать 1connector
#Использовать asserts

#Область Тесты

&Тест
Процедура ТестДолжен_ОписыватьПолныйКонтрактHTTPAPIv2() Экспорт

	// Подготовка
	Спецификация = ПрочитатьСпецификацию();

	// Действие
	Пути = Спецификация["paths"];
	Операция = Пути["/api/v2/convert"]["post"];
	Схемы = Спецификация["components"]["schemas"];
	Запрос = Схемы["ConversionRequest"];
	Ответ = Схемы["ConversionResponse"];

	// Проверка
	Ожидаем.Что(Спецификация["openapi"], "Версия OpenAPI").Равно("3.1.0");
	Ожидаем.Что(Пути.Количество(), "Количество путей").Равно(1);
	Ожидаем.Что(Пути["/api/v2/convert"].Количество(), "Количество методов").Равно(1);
	Ожидаем.Что(Операция["x-maxBodyBytes"], "Предел тела в байтах").Равно(65536);
	Ожидаем.Что(
		Операция["requestBody"]["content"].Получить("application/json"),
		"JSON-содержимое запроса"
	).Не_().Равно(Неопределено);
	Ожидаем.Что(СтрСоединить(Запрос["required"], ","), "Обязательные поля").Равно("command");
	Ожидаем.Что(Запрос["additionalProperties"], "Запрет неизвестных полей").Равно(Ложь);
	Ожидаем.Что(Запрос["properties"]["command"].Получить("x-maxUtf8Bytes")).Равно(Неопределено);
	Ожидаем.Что(Запрос["properties"]["command"].Получить("maxLength")).Равно(Неопределено);
	ПроверитьПеречисление(Запрос["properties"]["target"], "1c,connector", "1c");
	ПроверитьПеречисление(Запрос["properties"]["locale"], "ru,en", "ru");
	ПроверитьПараметрыГенератора(Запрос["properties"]["generatorOptions"]);
	ПроверитьСтатусы(Операция["responses"]);
	ПроверитьСхемуОтвета(Ответ, Схемы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьСпецификацию()

	Чтение = Новый ЧтениеТекста("src/web/view/static/openapi.json", КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Текст);

	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);

КонецФункции

Процедура ПроверитьПеречисление(Схема, ОжидаемыеЗначения, ЗначениеПоУмолчанию)

	Ожидаем.Что(СтрСоединить(Схема["enum"], ","), "Перечисление").Равно(ОжидаемыеЗначения);
	Ожидаем.Что(Схема["default"], "Значение по умолчанию").Равно(ЗначениеПоУмолчанию);

КонецПроцедуры

Процедура ПроверитьПараметрыГенератора(Схема)

	Ожидаем.Что(Схема["additionalProperties"], "Запрет неизвестных параметров").Равно(Ложь);
	Параметр = Схема["properties"]["responseDeserializationFormat"];

	Ожидаем.Что(
		СтрСоединить(Параметр["type"], ","),
		"Типы параметра генератора"
	).Равно("string,null");
	Ожидаем.Что(Параметр["enum"], "Число форматов десериализации").ИмеетДлину(2);
	Ожидаем.Что(Параметр["enum"][0], "Формат десериализации").Равно("json");
	Ожидаем.Что(Параметр["enum"][1], "Отключение десериализации").Равно(Неопределено);

КонецПроцедуры

Процедура ПроверитьСтатусы(Ответы)

	Коды = Новый Массив;
	Для Каждого Ответ Из Ответы Цикл
		Коды.Добавить(Ответ.Ключ);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Коды, ","), "Статусы операции").Равно("200,400,405,413,415,422,500,503");
	Ожидаем.Что(Ответы["405"]["headers"]["Allow"]["schema"]["const"]).Равно("POST");

КонецПроцедуры

Процедура ПроверитьСхемуОтвета(Ответ, Схемы)

	ОжидаемыеПоля = "success,target,code,errors,warnings";
	Ожидаем.Что(СтрСоединить(Ответ["required"], ","), "Поля ответа").Равно(ОжидаемыеПоля);
	Ожидаем.Что(Ответ["additionalProperties"], "Запрет неизвестных полей ответа").Равно(Ложь);
	Ожидаем.Что(СтрСоединить(Схемы["ConversionError"]["required"], ",")).Равно("code,message,position");
	Ожидаем.Что(
		СтрСоединить(Схемы["ConversionWarning"]["required"], ","),
		"Поля предупреждения"
	).Равно("code,message,capability,option,position,target");
	Ожидаем.Что(Схемы["ConversionError"]["properties"]["position"]["minimum"]).Равно(1);
	Ожидаем.Что(Схемы["ConversionWarning"]["properties"]["position"]["minimum"]).Равно(1);

КонецПроцедуры

#КонецОбласти

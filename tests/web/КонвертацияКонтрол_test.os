#Область Тесты

&Тест
Процедура ТестДолжен_ПроверятьОграничениеПараллелизмаПриСоздании() Экспорт

	// Действие
	Попытка
		Контрол = Новый КонвертацияКонтрол(Неопределено, 0);
		Ошибка = Неопределено;
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка, "Ошибка недопустимого ограничения параллелизма").Существует();
	Ожидаем.Что(
		СтрНайти(Ошибка.Описание, "Лимит параллелизма") > 0,
		"Проверка ограничения контроллером"
	).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьБезопасныйОтветПриНепредвиденномСбое() Экспорт

	// Подготовка
	Контрол = Новый КонвертацияКонтрол(Новый КонвертерСоСбоемДляТестов);
	Запрос = Новый Структура("Метод,Заголовки,Тело,ТелоДвоичныеДанные");
	Запрос.Метод = "POST";
	Запрос.Заголовки = Новый Соответствие;
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Тело = "{""command"":""curl https://СЕКРЕТ_КОМАНДА.example""}";
	Запрос.ТелоДвоичныеДанные = Неопределено;
	Ответ = Новый ОтветПреобразованияДляТестов;

	ОжидаемаяОшибка = Новый Соответствие;
	ОжидаемаяОшибка.Вставить("code", "internal.invariant_violation");
	ОжидаемаяОшибка.Вставить("message", "Внутренняя ошибка сервера");
	ОжидаемаяОшибка.Вставить("position", Null);

	ОжидаемыеОшибки = Новый Массив;
	ОжидаемыеОшибки.Добавить(ОжидаемаяОшибка);

	ОжидаемыеДанные = Новый Соответствие;
	ОжидаемыеДанные.Вставить("success", Ложь);
	ОжидаемыеДанные.Вставить("target", "");
	ОжидаемыеДанные.Вставить("code", "");
	ОжидаемыеДанные.Вставить("errors", ОжидаемыеОшибки);
	ОжидаемыеДанные.Вставить("warnings", Новый Массив);

	// Действие
	Контрол.Преобразовать(Запрос, Ответ);

	// Проверка
	Ожидаем.Что(Ответ.СостояниеКод, "Код состояния").Равно(500);
	Ожидаем.Что(Ответ.СостояниеТекст, "Текст состояния").Равно("Internal Server Error");
	Ожидаем.Что(Ответ.Заголовки["Content-Type"], "Тип содержимого").Равно("application/json");
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "СЕКРЕТ_ТОКЕН"), "Ответ без секрета из исключения").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "C:\\Закрыто"), "Ответ без пути из исключения").Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "СЕКРЕТ_КОМАНДА"), "Ответ без команды").Равно(0);

	ДанныеОтвета = Новый ДесериализаторJson().Десериализовать(Ответ.ТелоТекст, Неопределено, Истина);
	ЗаписьJSON = Новый СериализаторJson;
	Ожидаем.Что(
		ЗаписьJSON.Сериализовать(ДанныеОтвета),
		"Полное JSON-содержимое ответа"
	).Равно(ЗаписьJSON.Сериализовать(ОжидаемыеДанные));

КонецПроцедуры

#КонецОбласти

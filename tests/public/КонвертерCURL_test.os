#Область Тесты

&Тест
Процедура ТестДолжен_СконвертироватьОбеимиВстроеннымиЦелями() Экспорт

	// Подготовка
	Конвертер = Новый КонвертерCURL;

	// Действие и Проверка
	ПроверитьПолныйРезультат(
		Конвертер,
		ЦелиКонвертацииCURL.ПлатформенныйHTTP(),
		"Соединение = Новый HTTPСоединение(""example.com"", 80);" + Символы.ПС
			+ "HTTPЗапрос = Новый HTTPЗапрос(""/"");" + Символы.ПС + Символы.ПС
			+ "HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);"
	);
	ПроверитьПолныйРезультат(
		Конвертер,
		ЦелиКонвертацииCURL.КоннекторHTTP(),
		"Результат = КоннекторHTTP.Get(""http://example.com"");"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьТолькоПользовательскийРеестр() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый СторонняяЦельДляТестовCURL);
	Конвертер = Новый КонвертерCURL(Реестр);
	Параметры = Новый ПараметрыКонвертацииCURL("curl https://example.org");
	Параметры.Цель = "third-party-test";

	// Действие
	РезультатСтороннегоГенератора = Конвертер.Конвертировать(Параметры);
	Параметры.Цель = ЦелиКонвертацииCURL.ПлатформенныйHTTP();
	РезультатВстроенногоГенератора = Конвертер.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(РезультатСтороннегоГенератора.Успешно(), "Успех стороннего генератора").Равно(Истина);
	Ожидаем.Что(РезультатСтороннегоГенератора.Код(), "Код стороннего генератора").Равно(
		"target=third-party-test;locale=ru;url=https://example.org;parameters=0"
	);
	Ожидаем.Что(РезультатВстроенногоГенератора.Успешно(), "Успех неизвестного встроенного генератора").Равно(Ложь);
	Ожидаем.Что(
		ДиагностикаОшибок.КодОшибки(РезультатВстроенногоГенератора.Ошибки()[0]),
		"Код ошибки неизвестного встроенного генератора"
	).Равно(
		КодыОшибокCurlone.НеизвестныйГенератор()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИзменитьПереданныеПараметры() Экспорт

	// Подготовка
	Команда = Новый Массив;
	Команда.Добавить("curl");
	Команда.Добавить("https://example.org");
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Параметры.ПараметрыГенератора.Вставить("ДесериализоватьОтветИзJSON", Истина);
	Конвертер = Новый КонвертерCURL;
	ОжидаемыйКод = "ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	|
	|Соединение = Новый HTTPСоединение(""example.org"", 443, , , , , ЗащищенноеСоединение);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);
	|
	|// Десериализация JSON
	|Поток = HTTPОтвет.ПолучитьТелоКакПоток();
	|ЧтениеJSON = Новый ЧтениеJSON();
	|ЧтениеJSON.ОткрытьПоток(Поток);
	|Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	|Поток.Закрыть();";

	// Действие
	Результат = Конвертер.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно(), "Успех конвертации с пользовательским реестром").Равно(Истина);
	Ожидаем.Что(Результат.Код(), "Код пользовательского генератора").Равно(ОжидаемыйКод);
	Ожидаем.Что(Параметры.Команда[0], "Имя команды пользовательского генератора").Равно("curl");
	Ожидаем.Что(Параметры.Команда[1], "Адрес команды пользовательского генератора").Равно("https://example.org");
	Ожидаем.Что(Параметры.Цель, "Цель пользовательского генератора").Равно(
		ЦелиКонвертацииCURL.ПлатформенныйHTTP()
	);
	Ожидаем.Что(Параметры.Локаль, "Локаль пользовательского генератора").Равно(
		ЛокалиКонвертацииCURL.Русская()
	);
	Ожидаем.Что(Параметры.ПараметрыГенератора.Количество(), "Количество параметров генератора").Равно(1);
	Ожидаем.Что(
		Параметры.ПараметрыГенератора["ДесериализоватьОтветИзJSON"],
		"Параметр десериализации ответа JSON"
	).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторноИспользоватьОдинФасад() Экспорт

	// Подготовка
	Конвертер = Новый КонвертерCURL;
	Параметры = Новый ПараметрыКонвертацииCURL("curl http://example.com");

	// Действие
	ПервыйРезультат = Конвертер.Конвертировать(Параметры);
	Параметры.Цель = ЦелиКонвертацииCURL.КоннекторHTTP();
	ВторойРезультат = Конвертер.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(ПервыйРезультат.Успешно(), "Успех первой независимой конвертации").Равно(Истина);
	Ожидаем.Что(ВторойРезультат.Успешно(), "Успех второй независимой конвертации").Равно(Истина);
	Ожидаем.Что(ПервыйРезультат.Код(), "Код первой независимой конвертации").Равно(
		"Соединение = Новый HTTPСоединение(""example.com"", 80);" + Символы.ПС
			+ "HTTPЗапрос = Новый HTTPЗапрос(""/"");" + Символы.ПС + Символы.ПС
			+ "HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);"
	);
	Ожидаем.Что(ВторойРезультат.Код(), "Код второй независимой конвертации").Равно(
		"Результат = КоннекторHTTP.Get(""http://example.com"");"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСодержатьСтарыеТипыВКорневойБиблиотеке() Экспорт

	// Подготовка
	Чтение = Новый ЧтениеТекста(Новый Файл("lib.config").ПолноеИмя);
	СодержимоеБиблиотеки = Чтение.Прочитать();
	Чтение.Закрыть();
	СтарыеТипы = Новый Массив;

	СтарыеТипы.Добавить("КонвертерКомандыCURL");
	СтарыеТипы.Добавить("КонсольныйКонвертерКомандыCURL");
	СтарыеТипы.Добавить("ПулКонвертеровКомандыCURL");
	СтарыеТипы.Добавить("ГенераторПрограммногоКода1С");
	СтарыеТипы.Добавить("ГенераторПрограммногоКодаКоннекторHTTP");

	// Действие и Проверка
	Для Каждого СтарыйТип Из СтарыеТипы Цикл

		Ожидаем.Что(СтрНайти(СодержимоеБиблиотеки, СтарыйТип), "Ссылка на старый тип " + СтарыйТип).Равно(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПубликоватьВспомогательныйВстроенныйРеестр() Экспорт

	// Подготовка
	Чтение = Новый ЧтениеТекста(Новый Файл("lib.config").ПолноеИмя);
	СодержимоеБиблиотеки = Чтение.Прочитать();
	Чтение.Закрыть();

	// Действие и Проверка
	Ожидаем.Что(
		СтрНайти(СодержимоеБиблиотеки, "ВстроенныйРеестрГенераторовCURL"),
		"Ссылка на удалённый встроенный реестр"
	).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПолныйРезультат(Конвертер, Цель, ОжидаемыйКод)

	Параметры = Новый ПараметрыКонвертацииCURL("curl http://example.com");
	Параметры.Цель = Цель;
	Результат = Конвертер.Конвертировать(Параметры);

	Ожидаем.Что(Результат.Успешно(), "Успех конвертации со встроенным реестром").Равно(Истина);
	Ожидаем.Что(Результат.Код(), "Код встроенного генератора").Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

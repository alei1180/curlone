// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts
#Использовать errors
#Использовать "../../src/public"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьПараметрыСоЗначениямиПоУмолчанию() Экспорт

	// Подготовка
	Команда = "curl https://example.com";

	// Действие
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);

	// Проверка
	Ожидаем.Что(Параметры.Команда).Равно(Команда);
	Ожидаем.Что(Параметры.Цель).Равно(ЦелиКонвертацииCURL.ПлатформенныйHTTP());
	Ожидаем.Что(Параметры.Локаль).Равно(ЛокалиКонвертацииCURL.Русская());
	Ожидаем.Что(ТипЗнч(Параметры.ПараметрыГенератора)).Равно(Тип("Соответствие"));
	Ожидаем.Что(Параметры.ПараметрыГенератора).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьМассивАргументов() Экспорт

	// Подготовка
	Команда = Новый Массив;
	Команда.Добавить("curl");
	Команда.Добавить("https://example.com");

	// Действие
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Команда[0] = "изменённая команда";

	// Проверка
	Ожидаем.Что(Параметры.Команда).ИмеетДлину(2);
	Ожидаем.Что(Параметры.Команда[0]).Равно("curl");
	Ожидаем.Что(Параметры.Команда[1]).Равно("https://example.com");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьФиксированныйМассивАргументов() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	Аргументы.Добавить("https://example.com");
	Команда = Новый ФиксированныйМассив(Аргументы);

	// Действие
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Параметры.Команда.Добавить("--head");

	// Проверка
	Ожидаем.Что(ТипЗнч(Параметры.Команда)).Равно(Тип("Массив"));
	Ожидаем.Что(Параметры.Команда).ИмеетДлину(3);
	Ожидаем.Что(Команда).ИмеетДлину(2);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(Неопределено)
Процедура ТестДолжен_ОтклонитьКомандуНеверногоТипа(Команда) Экспорт

	// Подготовка
	ОжидаемыйКодОшибки = КодыСтандартныхОшибок.НеверныйТипАргумента();

	// Действие
	Ошибка = ПолучитьОшибкуСозданияПараметров(Команда);

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустуюСтрокуКоманды() Экспорт

	// Подготовка
	Команда = "";
	ОжидаемыйКодОшибки = КодыСтандартныхОшибок.АргументНеЗаполнен();

	// Действие
	Ошибка = ПолучитьОшибкуСозданияПараметров(Команда);

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустойМассивКоманды() Экспорт

	// Подготовка
	Команда = Новый Массив;
	ОжидаемыйКодОшибки = КодыСтандартныхОшибок.АргументНеЗаполнен();

	// Действие
	Ошибка = ПолучитьОшибкуСозданияПараметров(Команда);

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуСозданияПараметров(Команда)

	Попытка
		Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

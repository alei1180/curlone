#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьВидыДиагностики() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ВидыДиагностикиКонвертацииCURL.Ошибка()).Равно("Ошибка");
	Ожидаем.Что(ВидыДиагностикиКонвертацииCURL.Предупреждение()).Равно("Предупреждение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьУспешнымРезультатСКодомИПредупреждением() Экспорт

	// Подготовка
	Предупреждения = Новый Массив;
	Предупреждения.Добавить(НовоеПредупреждение("Первое предупреждение", "--retry", 2));

	// Действие
	Результат = Новый РезультатКонвертацииCURL(
		"Сообщить(""Готово"");",
		Неопределено,
		Предупреждения,
		"third-party"
	);

	// Проверка
	Ожидаем.Что(Результат.Успешно(), "Признак успеха результата").ЭтоИстина();
	Ожидаем.Что(Результат.Код(), "Сформированный код результата").Равно("Сообщить(""Готово"");");
	Ожидаем.Что(Результат.Ошибки(), "Ошибки успешного результата").ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения(), "Предупреждения успешного результата").ИмеетДлину(1);
	Ожидаем.Что(Результат.ИдентификаторГенератора(), "Идентификатор генератора результата").Равно("third-party");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНеуспешнымРезультатСОшибкой() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить(НоваяОшибка("Генератор не зарегистрирован"));

	// Действие
	Результат = Новый РезультатКонвертацииCURL("Сформированный код", Ошибки);

	// Проверка
	Ожидаем.Что(Результат.Успешно(), "Успех результата с критической ошибкой").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНеуспешнымРезультатБезКода() Экспорт

	// Действие
	Результат = Новый РезультатКонвертацииCURL();

	// Проверка
	Ожидаем.Что(Результат.Успешно(), "Успех пустого результата").ЭтоЛожь();
	Ожидаем.Что(Результат.Код(), "Код пустого результата").Равно("");
	Ожидаем.Что(Результат.Ошибки(), "Ошибки пустого результата").ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения(), "Предупреждения пустого результата").ИмеетДлину(0);
	Ожидаем.Что(Результат.Диагностика(), "Диагностика пустого результата").ИмеетДлину(0);
	Ожидаем.Что(Результат.ИдентификаторГенератора(), "Генератор пустого результата").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьБезопаснуюДиагностикуВПравильномПорядке() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	ПерваяОшибка = ФабрикаОшибок.Создать(
		КодыОшибокCurlone.НеизвестныйГенератор(),
		"Первый генератор не зарегистрирован",
		Новый Структура("Секрет", "SECRET-DIAGNOSTIC-DATA")
	);
	ВтораяОшибка = ФабрикаОшибок.Создать(
		КодыОшибокCurlone.ОшибкаГенератора(),
		"Второй генератор завершился с ошибкой"
	);
	Ошибки.Добавить(ПерваяОшибка);
	Ошибки.Добавить(ВтораяОшибка);

	Предупреждения = Новый Массив;
	ПервоеПредупреждение = НовоеПредупреждение("Первое предупреждение", "--retry", 2);
	ВтороеПредупреждение = НовоеПредупреждение("Второе предупреждение", "--head", 5);
	Предупреждения.Добавить(ПервоеПредупреждение);
	Предупреждения.Добавить(ВтороеПредупреждение);

	// Действие
	Результат = Новый РезультатКонвертацииCURL("", Ошибки, Предупреждения, "result-generator");
	Диагностика = Результат.Диагностика();

	// Проверка
	Ожидаем.Что(Диагностика, "Количество элементов диагностики").ИмеетДлину(4);
	ПроверитьИменаПолейДиагностики(Диагностика[0]);
	ПроверитьДиагностикуОшибки(Диагностика[0], ПерваяОшибка);
	ПроверитьДиагностикуОшибки(Диагностика[1], ВтораяОшибка);
	ПроверитьДиагностикуПредупреждения(Диагностика[2], ПервоеПредупреждение);
	ПроверитьДиагностикуПредупреждения(Диагностика[3], ВтороеПредупреждение);
	Ожидаем.Что(Диагностика[0].Сообщение, "Безопасное сообщение диагностики").Не_().Содержит(
		"SECRET-DIAGNOSTIC-DATA"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьКоллекцииОтИзмененияСнаружи() Экспорт

	// Подготовка
	ИсходныеОшибки = Новый Массив;
	ИсходныеОшибки.Добавить(НоваяОшибка("Исходная ошибка"));
	ИсходныеПредупреждения = Новый Массив;
	ИсходныеПредупреждения.Добавить(НовоеПредупреждение("Исходное предупреждение"));
	Результат = Новый РезультатКонвертацииCURL(
		"",
		ИсходныеОшибки,
		ИсходныеПредупреждения
	);

	// Действие
	ИсходныеОшибки.Очистить();
	ИсходныеПредупреждения.Очистить();
	ПолученныеОшибки = Результат.Ошибки();
	ПолученныеПредупреждения = Результат.Предупреждения();
	ПолученныеОшибки.Очистить();
	ПолученныеПредупреждения.Очистить();

	// Проверка
	Ожидаем.Что(Результат.Ошибки(), "Копия массива ошибок").ИмеетДлину(1);
	Ожидаем.Что(Результат.Предупреждения(), "Копия массива предупреждений").ИмеетДлину(1);
	Ожидаем.Что(Результат.Ошибки(), "Тип коллекции ошибок").ИмеетТип("Массив");
	Ожидаем.Что(Результат.Предупреждения(), "Тип коллекции предупреждений").ИмеетТип("Массив");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьФиксированныеКоллекции() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить(НоваяОшибка("Ошибка"));
	Предупреждения = Новый Массив;
	Предупреждения.Добавить(НовоеПредупреждение("Предупреждение"));

	// Действие
	Результат = Новый РезультатКонвертацииCURL(
		"",
		Новый ФиксированныйМассив(Ошибки),
		Новый ФиксированныйМассив(Предупреждения)
	);

	// Проверка
	Ожидаем.Что(Результат.Ошибки(), "Неизменённые ошибки результата").ИмеетДлину(1);
	Ожидаем.Что(Результат.Предупреждения(), "Неизменённые предупреждения результата").ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКодНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата(1);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКоллекциюОшибокНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата("", "не массив");

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЭлементОшибокНеверногоТипа() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить("не ошибка");

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата("", Ошибки);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКоллекциюПредупрежденийНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата("", Неопределено, "не массив");

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЭлементПредупрежденийНеверногоТипа() Экспорт

	// Подготовка
	Предупреждения = Новый Массив;
	Предупреждения.Добавить(НоваяОшибка("не предупреждение"));

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата("", Неопределено, Предупреждения);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьИдентификаторГенератораНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата("", Неопределено, Неопределено, 1);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяОшибка(Сообщение)

	Возврат ФабрикаОшибок.Создать(
		КодыОшибокCurlone.НеизвестныйГенератор(),
		Сообщение
	);

КонецФункции

Функция НовоеПредупреждение(Сообщение, ИсходнаяОпция = "", Позиция = -1)

	Возврат Новый ПредупреждениеКонвертацииCURL(
		КодыПредупрежденийCurlone.НеподдерживаемаяВозможность(),
		Сообщение,
		"retry",
		ИсходнаяОпция,
		Позиция,
		"warning-generator"
	);

КонецФункции

Процедура ПроверитьИменаПолейДиагностики(ЭлементДиагностики)

	ИменаПолей = Новый Массив;
	Для Каждого Поле Из ЭлементДиагностики Цикл
		ИменаПолей.Добавить(Поле.Ключ);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(ИменаПолей, ", "), "Имена полей элемента диагностики").Равно(
		"Вид, Код, Сообщение, ИдентификаторВозможности, ИсходнаяОпция, Позиция, ИдентификаторГенератора"
	);

КонецПроцедуры

Процедура ПроверитьДиагностикуОшибки(ЭлементДиагностики, Ошибка)

	Ожидаем.Что(ЭлементДиагностики.Вид, "Вид диагностики ошибки").Равно("Ошибка");
	КодОшибки = ДиагностикаОшибок.КодОшибки(Ошибка);
	Ожидаем.Что(ЭлементДиагностики.Код, "Код диагностики ошибки").Равно(КодОшибки);
	Ожидаем.Что(ЭлементДиагностики.Сообщение, "Сообщение диагностики ошибки").Равно(
		ДиагностикаОшибок.НайтиПервую(Ошибка, КодОшибки).Сообщение()
	);
	Ожидаем.Что(ЭлементДиагностики.ИдентификаторВозможности, "Возможность диагностики ошибки").Равно(
		Неопределено
	);
	Ожидаем.Что(ЭлементДиагностики.ИсходнаяОпция, "Исходная опция диагностики ошибки").Равно(Неопределено);
	Ожидаем.Что(ЭлементДиагностики.Позиция, "Позиция диагностики ошибки").Равно(Неопределено);
	Ожидаем.Что(ЭлементДиагностики.ИдентификаторГенератора, "Генератор диагностики ошибки").Равно(
		Неопределено
	);

КонецПроцедуры

Процедура ПроверитьДиагностикуПредупреждения(ЭлементДиагностики, Предупреждение)

	Ожидаем.Что(ЭлементДиагностики.Вид, "Вид диагностики предупреждения").Равно("Предупреждение");
	Ожидаем.Что(ЭлементДиагностики.Код, "Код диагностики предупреждения").Равно(Предупреждение.Код());
	Ожидаем.Что(ЭлементДиагностики.Сообщение, "Сообщение диагностики предупреждения").Равно(
		Предупреждение.Сообщение()
	);
	Ожидаем.Что(
		ЭлементДиагностики.ИдентификаторВозможности,
		"Возможность диагностики предупреждения"
	).Равно(
		Предупреждение.ИдентификаторВозможности()
	);
	Ожидаем.Что(ЭлементДиагностики.ИсходнаяОпция, "Исходная опция диагностики предупреждения").Равно(
		Предупреждение.ИсходнаяОпция()
	);
	Ожидаем.Что(ЭлементДиагностики.Позиция, "Позиция диагностики предупреждения").Равно(
		Предупреждение.Позиция()
	);
	Ожидаем.Что(
		ЭлементДиагностики.ИдентификаторГенератора,
		"Генератор диагностики предупреждения"
	).Равно(
		Предупреждение.ИдентификаторГенератора()
	);

КонецПроцедуры

Процедура ПроверитьОшибкуНеверногоТипа(Ошибка)

	Ожидаем.Что(Ошибка, "Ошибка неверного типа аргумента").Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка), "Код ошибки неверного типа").Равно(
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

Функция ПолучитьОшибкуСозданияРезультата(
	Код = "",
	Ошибки = Неопределено,
	Предупреждения = Неопределено,
	ИдентификаторГенератора = ""
)

	Попытка
		Результат = Новый РезультатКонвертацииCURL(
			Код,
			Ошибки,
			Предупреждения,
			ИдентификаторГенератора
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьСтабильныеКодыОшибок() Экспорт

	// Подготовка
	Коды = Новый Массив();
	Коды.Добавить(КодыОшибокCurlOne.НезакрытаяКавычка());
	Коды.Добавить(КодыОшибокCurlOne.НеУказанURL());
	Коды.Добавить(КодыОшибокCurlOne.КонфликтТелаЗапроса());
	Коды.Добавить(КодыОшибокCurlOne.НеизвестныйГенератор());
	Коды.Добавить(КодыОшибокCurlOne.ОшибкаГенератора());
	Коды.Добавить(КодыОшибокCurlOne.НарушенКонтрактГенератора());
	Коды.Добавить(КодыОшибокCurlOne.НесовместимаяВерсияКонтрактаГенератора());

	// Действие
	Ошибка = ФабрикаОшибок.Создать(Коды[0], "Тестовая ошибка");

	// Проверка
	УникальныеКоды = Новый Соответствие();
	Для Каждого Код Из Коды Цикл
		УникальныеКоды.Вставить(Код, Истина);
	КонецЦикла;
	Ожидаем.Что(Коды).ИмеетДлину(7);
	Ожидаем.Что(УникальныеКоды).ИмеетДлину(7);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("curlone.command.unclosed_quote");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьСтабильныеКодыПредупрежденийИВерсиюSPI() Экспорт

	// Действие
	Коды = Новый Массив();
	Коды.Добавить(КодыПредупрежденийCurlOne.НеподдерживаемаяВозможность());
	Коды.Добавить(КодыПредупрежденийCurlOne.ОпцияПроигнорирована());
	Коды.Добавить(КодыПредупрежденийCurlOne.ПреобразованиеСПотерями());

	// Проверка
	Ожидаем.Что(Коды[0]).Равно("curlone.generator.unsupported_capability");
	Ожидаем.Что(Коды[1]).Равно("curlone.generator.option_ignored");
	Ожидаем.Что(Коды[2]).Равно("curlone.generator.lossy_conversion");
	Ожидаем.Что(ВерсииКонтрактаГенератораCURL.Актуальная()).Равно(1);

КонецПроцедуры

#КонецОбласти

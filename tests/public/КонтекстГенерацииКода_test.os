#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьИсходныеЗначенияКонтекста() Экспорт

	// Подготовка
	Операции = Новый Массив;
	ПараметрыГенератора = Новый Соответствие;

	// Действие
	Контекст = Новый КонтекстГенерацииКода(
		Операции,
		ЛокалиКонвертацииCURL.Русская(),
		ПараметрыГенератора,
		"third-party",
		ПустыеВозможности(),
		ФорматыДесериализацииОтветаCURL.JSON()
	);

	// Проверка
	Ожидаем.Что(ТипЗнч(Контекст.Операции())).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Контекст.Операции()).ИмеетДлину(0);
	Ожидаем.Что(Контекст.Локаль()).Равно(ЛокалиКонвертацииCURL.Русская());
	Ожидаем.Что(ТипЗнч(Контекст.ПараметрыГенератора())).Равно(
		Тип("ФиксированноеСоответствие")
	);
	Ожидаем.Что(Контекст.ПараметрыГенератора()).ИмеетДлину(0);
	Ожидаем.Что(Контекст.ИдентификаторГенератора()).Равно("third-party");
	Ожидаем.Что(Контекст.ФорматДесериализацииОтвета()).Равно(
		ФорматыДесериализацииОтветаCURL.JSON()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьВнешниеКонтейнерыОтИзменения() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -H 'X-Test: first' -d one https://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Операция = Выполнение.Операции()[0];
	Операции = Новый Массив;
	Операции.Добавить(Операция);
	Вложенный = Новый Массив;
	Вложенный.Добавить("исходное");
	Параметры = Новый Соответствие;
	Параметры.Вставить("Вложения", Новый ФиксированнаяСтруктура("Список", Вложенный));

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Операции, "ru", Параметры, "test", ПустыеВозможности());
	Вложенный[0] = "измененное";
	Операции.Добавить(Операция);
	Параметры.Вставить("Добавлено", Истина);

	// Проверка
	Ожидаем.Что(Контекст.Операции()[0] = Операция).Равно(Истина);
	Ожидаем.Что(Контекст.Операции()[0].Запрос() = Операция.Запрос()).Равно(Истина);
	Ожидаем.Что(Операция.Запрос().Заголовки()[0].Значение()).Равно(" first");
	Ожидаем.Что(Контекст.ПараметрыГенератора()["Вложения"].Список[0]).Равно("измененное");
	Ожидаем.Что(Контекст.Операции()).ИмеетДлину(1);
	Ожидаем.Что(Контекст.Операции() = Операции).Равно(Ложь);
	Ожидаем.Что(ПолучитьОшибкуДобавленияВМассив(Операция.Запрос().Заголовки())).Существует();
	Ожидаем.Что(Контекст.ПараметрыГенератора() = Параметры).Равно(Ложь);
	Ожидаем.Что(Контекст.ПараметрыГенератора().Получить("Добавлено") = Неопределено).Равно(Истина);
	Ожидаем.Что(ПолучитьОшибкуДобавленияВСоответствие(Контекст.ПараметрыГенератора())).Существует();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкопироватьФиксированныйМассив() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl https://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Операции = Выполнение.Операции();

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Операции, "ru", Новый Соответствие, "test", ПустыеВозможности());

	// Проверка
	Ожидаем.Что(Контекст.Операции() = Операции).Равно(Ложь);
	Ожидаем.Что(Контекст.Операции()[0].Ресурс() = Операции[0].Ресурс()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьПроизвольныйОбъектВПараметрах() Экспорт

	// Подготовка
	Параметры = Новый Соответствие;
	Объект = Новый ТаблицаЗначений;
	Параметры.Вставить("Объект", Объект);

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Новый Массив, "ru", Параметры, "test", ПустыеВозможности());

	// Проверка
	Ожидаем.Что(Контекст.ПараметрыГенератора()["Объект"] = Объект).Равно(Истина);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("неизвестный")
&ИсточникЗначение("повтор")
&ИсточникЗначение("нестроковый")
Процедура ТестДолжен_ПроверитьВозможностиНаПубличнойГранице(Случай) Экспорт

	// Подготовка
	Если Случай = "нестроковый" Тогда
		Набор = Новый Массив;
		Набор.Добавить(1);
		Возможности = Новый ФиксированныйМассив(Набор);
	Иначе
		Значения = ?(Случай = "повтор", "protocol.http|protocol.http", "unknown");
		Возможности = Новый ФиксированныйМассив(СтрРазделить(Значения, "|"));
	КонецЕсли;

	// Действие
	Ошибка = Неопределено;
	Попытка
		НекорректныйКонтекст = Новый КонтекстГенерацииКода(
			Новый Массив, "ru", Новый Соответствие, "test", Возможности);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_value");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("тип")
&ИсточникЗначение("значение")
Процедура ТестДолжен_ПроверитьФорматДесериализацииНаПубличнойГранице(Случай) Экспорт

	// Подготовка
	Формат = ?(Случай = "тип", Истина, "xml");
	ОжидаемыйКод = ?(Случай = "тип", "argument.invalid_type", "argument.invalid_value");

	// Действие
	Ошибка = Неопределено;
	Попытка
		НекорректныйКонтекст = Новый КонтекстГенерацииКода(
			Новый Массив,
			"ru",
			Новый Соответствие,
			"test",
			ПустыеВозможности(),
			Формат
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьНестроковыйКлючПараметра() Экспорт

	// Подготовка
	Параметры = Новый Соответствие;
	Параметры.Вставить(1, "значение");

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Новый Массив, "ru", Параметры, "test", ПустыеВозможности());

	// Проверка
	Ожидаем.Что(Контекст.ПараметрыГенератора() = Параметры).Равно(Ложь);
	Ожидаем.Что(Контекст.ПараметрыГенератора()[1]).Равно("значение");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(Ложь)
Процедура ТестДолжен_ПередатьМодельБезПроверкиВложенныхПолей(Протокол) Экспорт

	// Подготовка
	Исходная = СоздатьКонтекстПримера().Операции()[0];
	Ресурс = Исходная.Ресурс();
	НеверныйРесурс = Новый АдресПередачиCURL(
		Ресурс.ИсходныйАдрес(),
		Ресурс.АдресДляВыполнения(),
		Ресурс.Фрагмент(),
		Ресурс.ФрагментУказан(),
		Протокол,
		Ресурс.ОтложеннаяКлассификация(),
		Ресурс.ТребуетРазбора(),
		Ресурс.Источник()
	);
	Операции = Новый Массив;
	Операции.Добавить(Новый ОперацияПередачиCURL(
		НеверныйРесурс, Исходная.Запрос(), Исходная.Соединение(), Исходная.Политики(), Исходная.Результат()));

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Операции, "ru", Новый Соответствие, "test", ПустыеВозможности());

	// Проверка
	Ожидаем.Что(Контекст.Операции()[0] = Операции[0]).Равно(Истина);
	Ожидаем.Что(Контекст.Операции()[0].Ресурс().Протокол()).Равно(Протокол);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуДобавленияВМассив(Массив)

	Попытка
		Массив.Добавить("новое значение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуДобавленияВСоответствие(Соответствие)

	Попытка
		Соответствие.Вставить("новое", "значение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПустыеВозможности()
	Возврат Новый ФиксированныйМассив(Новый Массив);
КонецФункции

Функция СоздатьКонтекстПримера()

	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -H 'X-Test: first' -d one https://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Возможности = Новый ФиксированныйМассив(СтрРазделить("protocol.https", "|"));
	Описание = Новый ОписаниеГенератораCURL("test", "Тестовый", 1, Возможности);
	Возврат Новый КонтекстГенерацииКода(
		Выполнение.Операции(),
		"ru",
		Новый Соответствие,
		Описание.Идентификатор(),
		Описание.Возможности()
	);

КонецФункции

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьЗначенияКонтекстаТолькоДляЧтения() Экспорт

	// Подготовка
	Операции = Новый Массив;
	ПараметрыГенератора = Новый Соответствие;

	// Действие
	Контекст = Новый КонтекстГенерацииКода(
		Операции,
		ЛокалиКонвертацииCURL.Русская(),
		ПараметрыГенератора,
		"third-party"
	);

	// Проверка
	Ожидаем.Что(ТипЗнч(Контекст.Операции())).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Контекст.Операции()).ИмеетДлину(0);
	Ожидаем.Что(Контекст.Локаль()).Равно(ЛокалиКонвертацииCURL.Русская());
	Ожидаем.Что(ТипЗнч(Контекст.ПараметрыГенератора())).Равно(
		Тип("ФиксированноеСоответствие")
	);
	Ожидаем.Что(Контекст.ПараметрыГенератора()).ИмеетДлину(0);
	Ожидаем.Что(Контекст.ИдентификаторГенератора()).Равно("third-party");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ГлубокоЗафиксироватьИзменяемыеКоллекции() Экспорт

	// Подготовка
	Теги = Новый Массив;
	Теги.Добавить("retry");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Операция = Новый Структура;
	Операция.Вставить("Метод", "GET");
	Операция.Вставить("Теги", Теги);
	Операция.Вставить("Заголовки", Заголовки);
	Операции = Новый Массив;
	Операции.Добавить(Операция);

	Форматирование = Новый Структура("Отступ", 4);
	ПараметрыГенератора = Новый Соответствие;
	ПараметрыГенератора.Вставить("Форматирование", Форматирование);

	Контекст = Новый КонтекстГенерацииКода(
		Операции,
		ЛокалиКонвертацииCURL.Русская(),
		ПараметрыГенератора,
		"third-party"
	);

	// Действие
	Операции.Добавить(Новый Структура("Метод", "DELETE"));
	Операция.Вставить("Метод", "POST");
	Теги[0] = "changed";
	Теги.Добавить("verbose");
	Заголовки.Вставить("Accept", "text/plain");
	Заголовки.Вставить("Changed", Истина);
	ПараметрыГенератора.Вставить("НовыйПараметр", Истина);
	Форматирование.Вставить("Отступ", 8);

	// Проверка
	СнимокОперации = Контекст.Операции()[0];
	Ожидаем.Что(Контекст.Операции()).ИмеетДлину(1);
	Ожидаем.Что(ТипЗнч(СнимокОперации)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(СнимокОперации.Метод).Равно("GET");
	Ожидаем.Что(ТипЗнч(СнимокОперации.Теги)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(СнимокОперации.Теги).ИмеетДлину(1);
	Ожидаем.Что(СнимокОперации.Теги[0]).Равно("retry");
	Ожидаем.Что(ТипЗнч(СнимокОперации.Заголовки)).Равно(
		Тип("ФиксированноеСоответствие")
	);
	Ожидаем.Что(СнимокОперации.Заголовки.Получить("Accept")).Равно("application/json");
	Ожидаем.Что(СнимокОперации.Заголовки).ИмеетДлину(1);
	Ожидаем.Что(Контекст.ПараметрыГенератора()).ИмеетДлину(1);
	СнимокФорматирования = Контекст.ПараметрыГенератора().Получить("Форматирование");
	Ожидаем.Что(ТипЗнч(СнимокФорматирования)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(СнимокФорматирования.Отступ).Равно(4);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПересоздатьУжеФиксированныеКоллекцииБезСсылокНаВложения() Экспорт

	// Подготовка
	ЛистОперации = Новый Структура("Значение", "исходное");
	ВложенныеОперации = Новый Массив;
	ВложенныеОперации.Добавить(ЛистОперации);
	ФиксированныеВложенныеОперации = Новый ФиксированныйМассив(ВложенныеОперации);
	Операция = Новый Структура("Вложения", ФиксированныеВложенныеОперации);
	ФиксированнаяОперация = Новый ФиксированнаяСтруктура(Операция);
	Операции = Новый Массив;
	Операции.Добавить(ФиксированнаяОперация);
	ФиксированныеОперации = Новый ФиксированныйМассив(Операции);

	ЛистПараметров = Новый Массив;
	ЛистПараметров.Добавить("исходное");
	ВложенныеПараметры = Новый Соответствие;
	ВложенныеПараметры.Вставить("Список", ЛистПараметров);
	ФиксированныеВложенныеПараметры = Новый ФиксированноеСоответствие(ВложенныеПараметры);
	ПараметрыГенератора = Новый Соответствие;
	ПараметрыГенератора.Вставить("Вложения", ФиксированныеВложенныеПараметры);
	ФиксированныеПараметрыГенератора = Новый ФиксированноеСоответствие(ПараметрыГенератора);

	Контекст = Новый КонтекстГенерацииКода(
		ФиксированныеОперации,
		ЛокалиКонвертацииCURL.Русская(),
		ФиксированныеПараметрыГенератора,
		"third-party"
	);

	// Действие
	ЛистОперации.Вставить("Значение", "изменённое");
	ЛистПараметров[0] = "изменённое";

	// Проверка
	СнимокОперации = Контекст.Операции()[0];
	Ожидаем.Что(ТипЗнч(СнимокОперации)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(ТипЗнч(СнимокОперации.Вложения)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(ТипЗнч(СнимокОперации.Вложения[0])).Равно(
		Тип("ФиксированнаяСтруктура")
	);
	Ожидаем.Что(СнимокОперации.Вложения[0].Значение).Равно("исходное");

	СнимокВложений = Контекст.ПараметрыГенератора().Получить("Вложения");
	Ожидаем.Что(ТипЗнч(СнимокВложений)).Равно(Тип("ФиксированноеСоответствие"));
	Ожидаем.Что(ТипЗнч(СнимокВложений.Получить("Список"))).Равно(
		Тип("ФиксированныйМассив")
	);
	Ожидаем.Что(СнимокВложений.Получить("Список")[0]).Равно("исходное");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьИзменениеКорневыхИВложенныхКоллекций() Экспорт

	// Подготовка
	Теги = Новый Массив;
	Теги.Добавить("retry");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Операция = Новый Структура("Теги, Заголовки", Теги, Заголовки);
	Операции = Новый Массив;
	Операции.Добавить(Операция);
	ПараметрыГенератора = Новый Соответствие;
	ПараметрыГенератора.Вставить("Режим", "strict");
	Контекст = Новый КонтекстГенерацииКода(
		Операции,
		ЛокалиКонвертацииCURL.Русская(),
		ПараметрыГенератора,
		"third-party"
	);
	СнимокОперации = Контекст.Операции()[0];

	// Действие
	ОшибкаИзмененияОпераций = ПолучитьОшибкуДобавленияВМассив(Контекст.Операции());
	ОшибкаИзмененияОперации = ПолучитьОшибкуИзмененияСтруктуры(СнимокОперации);
	ОшибкаИзмененияТегов = ПолучитьОшибкуДобавленияВМассив(СнимокОперации.Теги);
	ОшибкаИзмененияЗаголовков = ПолучитьОшибкуИзмененияСоответствия(
		СнимокОперации.Заголовки
	);
	ОшибкаИзмененияПараметров = ПолучитьОшибкуИзмененияСоответствия(
		Контекст.ПараметрыГенератора()
	);

	// Проверка
	Ожидаем.Что(ОшибкаИзмененияОпераций).Существует();
	Ожидаем.Что(ОшибкаИзмененияОперации).Существует();
	Ожидаем.Что(ОшибкаИзмененияТегов).Существует();
	Ожидаем.Что(ОшибкаИзмененияЗаголовков).Существует();
	Ожидаем.Что(ОшибкаИзмененияПараметров).Существует();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОперацииНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияКонтекста(
		"не массив",
		ЛокалиКонвертацииCURL.Русская(),
		Новый Соответствие,
		"third-party"
	);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЛокальНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияКонтекста(
		Новый Массив,
		1,
		Новый Соответствие,
		"third-party"
	);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПараметрыГенератораНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияКонтекста(
		Новый Массив,
		ЛокалиКонвертацииCURL.Русская(),
		Новый Массив,
		"third-party"
	);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьИдентификаторГенератораНеверногоТипа() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияКонтекста(
		Новый Массив,
		ЛокалиКонвертацииCURL.Русская(),
		Новый Соответствие,
		1
	);

	// Проверка
	ПроверитьОшибкуНеверногоТипа(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОшибкуНеверногоТипа(Ошибка)

	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НеверныйТипАргумента()
	);

КонецПроцедуры

Функция ПолучитьОшибкуСозданияКонтекста(
	Операции,
	Локаль,
	ПараметрыГенератора,
	ИдентификаторГенератора
)

	Попытка
		Контекст = Новый КонтекстГенерацииКода(
			Операции,
			Локаль,
			ПараметрыГенератора,
			ИдентификаторГенератора
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуДобавленияВМассив(Массив)

	Попытка
		Массив.Добавить("новое значение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуИзмененияСтруктуры(Структура)

	Попытка
		Структура.Вставить("НовоеПоле", "новое значение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуИзмененияСоответствия(Соответствие)

	Попытка
		Соответствие.Вставить("НовыйКлюч", "новое значение");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

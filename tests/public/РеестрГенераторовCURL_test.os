#Использовать errors
#Использовать "../../src/public"
#Использовать "../generation/Классы"

#Область Тесты

&Тест
Процедура ТестДолжен_ПриниматьФункцииSPIБезУчетаРегистра() Экспорт

	// Подготовка
	Генератор = Новый ГенераторСДругимРегистромФункцийCURL;
	Реестр = Новый РеестрГенераторовCURL;

	// Действие
	Реестр.Зарегистрировать(Генератор);

	// Проверка
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(1);
	Ожидаем.Что(Реестр.Описания()[0].Идентификатор()).Равно("case-insensitive-functions");
	Ожидаем.Что(Реестр.Снимок().Получить("case-insensitive-functions").Генератор).Равно(Генератор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗарегистрироватьГенераторИСоздатьСнимок() Экспорт

	// Подготовка
	Генератор = Новый ГенераторДляПроверкиКонвертацииCURL;
	Реестр = Новый РеестрГенераторовCURL;

	// Действие
	Реестр.Зарегистрировать(Генератор);
	Снимок = Реестр.Снимок();

	// Проверка
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(1);
	Ожидаем.Что(Снимок.Получить("test-generator").Генератор).Равно(Генератор);
	Ожидаем.Что(Генератор.КоличествоВызовов("Идентификатор")).Равно(1);
	Ожидаем.Что(Генератор.КоличествоВызовов("Сгенерировать")).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНевернуюФормуАтомарно() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;

	// Действие и Проверка
	ПроверитьНарушениеКонтракта(Реестр, Новый ГенераторБезФункцииГенерацииCURL);
	ПроверитьНарушениеКонтракта(Реестр, Новый ГенераторСПроцедуройГенерацииCURL);
	ПроверитьНарушениеКонтракта(Реестр, Новый ГенераторСНевернойАрностьюCURL);
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСтарыйСнимокИУчитыватьРегистр() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторДляПроверкиКонвертацииCURL("target"));
	СтарыйСнимок = Реестр.Снимок();

	// Действие
	Реестр.Зарегистрировать(Новый ГенераторДляПроверкиКонвертацииCURL("Target"));

	// Проверка
	Ожидаем.Что(СтарыйСнимок).ИмеетДлину(1);
	Ожидаем.Что(Реестр.Снимок()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныеМетаданныеИсключениеИДубликатАтомарно() Экспорт

	// Подготовка
	Сценарии = Новый Массив;
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Идентификатор", 1));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Идентификатор", " "));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Идентификатор", " target"));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Наименование", 1));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Наименование", " "));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "ВерсияКонтракта", "1"));
	Сценарии.Добавить(Новый Структура("Имя, Значение", "Возможности", Новый Массив));
	Сценарии.Добавить(Новый Структура(
		"Имя, Значение",
		"Возможности",
		ФиксированныйМассивИз(1)
	));
	Сценарии.Добавить(Новый Структура(
		"Имя, Значение",
		"Возможности",
		ФиксированныйМассивИз("unknown")
	));
	Сценарии.Добавить(Новый Структура(
		"Имя, Значение",
		"Возможности",
		ФиксированныйМассивИз("protocol.http", "protocol.http")
	));

	// Действие и Проверка
	Для Каждого Сценарий Из Сценарии Цикл
		Реестр = Новый РеестрГенераторовCURL;
		Генератор = Новый ГенераторСНастраиваемымиМетаданнымиCURL;
		Генератор.Настроить(Сценарий.Имя, Сценарий.Значение);
		ПроверитьНарушениеКонтракта(Реестр, Генератор);
		Ожидаем.Что(Реестр.Описания()).ИмеетДлину(0);
	КонецЦикла;

	Реестр = Новый РеестрГенераторовCURL;
	Генератор = Новый ГенераторСНастраиваемымиМетаданнымиCURL;
	Генератор.НастроитьИсключение("Наименование");
	ПроверитьНарушениеКонтракта(Реестр, Генератор);
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(0);

	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторДляПроверкиКонвертацииCURL("duplicate"));
	ПроверитьНарушениеКонтракта(
		Реестр,
		Новый ГенераторДляПроверкиКонвертацииCURL("duplicate")
	);
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьОсобыйКодТолькоДляНесовместимойЧисловойВерсии() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Генератор = Новый ГенераторСНастраиваемымиМетаданнымиCURL;
	Генератор.Настроить("ВерсияКонтракта", 2);

	// Действие
	Ошибка = ПолучитьОшибкуРегистрации(Реестр, Генератор);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыОшибокCurlone.НесовместимаяВерсияКонтрактаГенератора()
	);
	Ожидаем.Что(Реестр.Описания()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗафиксироватьМетаданныеПослеРегистрации() Экспорт

	// Подготовка
	Генератор = Новый ГенераторСНастраиваемымиМетаданнымиCURL;
	Генератор.Настроить("Возможности", ФиксированныйМассивИз("protocol.http"));
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Генератор);

	// Действие
	Генератор.Настроить("Идентификатор", "changed");
	Генератор.Настроить("Возможности", ФиксированныйМассивИз("protocol.https"));
	Описание = Реестр.Описания()[0];

	// Проверка
	Ожидаем.Что(Описание.Идентификатор()).Равно("configured");
	Ожидаем.Что(Описание.Возможности()[0]).Равно("protocol.http");
	Для Каждого Имя Из СтрРазделить("Идентификатор|Наименование|ВерсияКонтракта|Возможности", "|") Цикл
		Ожидаем.Что(Генератор.КоличествоВызовов(Имя)).Равно(1);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНарушениеКонтракта(Реестр, Генератор)
	Ошибка = ПолучитьОшибкуРегистрации(Реестр, Генератор);
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыОшибокCurlone.НарушенКонтрактГенератора()
	);
КонецПроцедуры

Функция ПолучитьОшибкуРегистрации(Реестр, Генератор)
	Попытка
		Реестр.Зарегистрировать(Генератор);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ФиксированныйМассивИз(Значение1, Значение2 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Массив.Добавить(Значение2);
	КонецЕсли;
	Возврат Новый ФиксированныйМассив(Массив);
КонецФункции

#КонецОбласти

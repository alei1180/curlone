Процедура ТестДолжен_ПреобразоватьВидМоделиВКод(ИмяФункции, Вид, Код) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить(Вид);

	// Действие
	Результат = Новый Рефлектор().ВызватьМетод(КодыВозможностейГенератораCURL, ИмяФункции, Аргументы);

	// Проверка
	Ожидаем.Что(Результат).Равно(Код);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ВходитВГруппу", 1, "protocol")
&ИсточникЗначение("ВходитВГруппу", Неопределено, "protocol")
&ИсточникЗначение("ВходитВГруппу", "protocol.http", 1)
&ИсточникЗначение("ВходитВГруппу", "protocol.http", Неопределено)
&ИсточникЗначение("ЭтоПротокол", 1)
&ИсточникЗначение("ЭтоВычисляемоеЗначение", Неопределено)
&ИсточникЗначение("ДляПротокола", 1)
&ИсточникЗначение("ДляВидаТела", 1)
&ИсточникЗначение("ДляСпособаАутентификации", 1)
&ИсточникЗначение("ДляРежимаFTP", 1)
&ИсточникЗначение("ДляПротоколаПрокси", 1)
&ИсточникЗначение("ДляСпособаАутентификацииПрокси", 1)
&ИсточникЗначение("ДляРежимаВывода", 1)
Процедура ТестДолжен_ОтклонитьНеверныйТип(ИмяФункции, Код, Группа = Неопределено) Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить(Код);

	Если ИмяФункции = "ВходитВГруппу" Тогда
		Аргументы.Добавить(Группа);
	КонецЕсли;

	Ошибка = Неопределено;

	// Действие
	Попытка
		Результат = Новый Рефлектор().ВызватьМетод(КодыВозможностейГенератораCURL, ИмяФункции, Аргументы);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка <> Неопределено).Равно(Истина);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("argument.invalid_type");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтделитьВычисляемыйПротоколОтОбъявляемыхВозможностей() Экспорт

	// Подготовка
	Коды = КодыВозможностейГенератораCURL;
	КодыВозможностей = КодыВозможностейГенератораCURL;

	// Действие
	Код = Коды.ВычисляемыйПротокол();

	// Проверка
	Ожидаем.Что(Код).Равно("protocol.dynamic");
	Ожидаем.Что(Коды.ЭтоПротокол(Код)).Равно(Истина);
	Ожидаем.Что(КодыВозможностей.Содержит(Код)).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьОбщийМассивПриПовторномЧтении() Экспорт

	// Подготовка
	Коды = КодыВозможностейГенератораCURL;

	// Действие
	Идентификаторы = Коды.Все();
	Повторно = Коды.Все();

	// Проверка
	Ожидаем.Что(ТипЗнч(Идентификаторы)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Идентификаторы = Повторно).Равно(Истина);

КонецПроцедуры


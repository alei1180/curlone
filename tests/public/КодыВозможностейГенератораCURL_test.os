Процедура ТестДолжен_ОпределитьПредметнуюГруппу(Код, Протокол, Значение) Экспорт

	// Подготовка
	Коды = КодыВозможностейГенератораCURL;

	// Действие и Проверка
	Ожидаем.Что(Коды.ЭтоПротокол(Код)).Равно(Протокол);
	Ожидаем.Что(Коды.ЭтоВычисляемоеЗначение(Код)).Равно(Значение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСоставИПорядокКаталога() Экспорт

	// Подготовка
	Ожидаемые = СтрРазделить(
		"protocol.http|protocol.https|protocol.ftp|protocol.ftps|"
		+ "operations.multiple|request.explicit_method|request.metadata_only|request.names_only|"
		+ "query.parts|headers.ordered|headers.repeated|headers.empty|"
		+ "headers.remove|headers.file|headers.stdin|headers.json_defaults|"
		+ "body.data|body.multipart|body.upload|multipart.part_headers|"
		+ "multipart.filename|multipart.content_type|data.urlencode|input.file|"
		+ "input.stdin|input.stdin_nonblocking|auth.credentials|auth.basic|"
		+ "auth.digest|auth.negotiate|auth.ntlm|auth.oauth2_bearer|"
		+ "auth.selection|auth.oauth2|auth.aws_sigv4|proxy.http|"
		+ "proxy.https|proxy.socks4|proxy.socks4a|proxy.socks5|"
		+ "proxy.socks5_hostname|proxy.credentials|proxy.basic|proxy.ntlm|"
		+ "proxy.unix_socket|tls.client_certificate|tls.ca_file|tls.system_store|"
		+ "timeout.total|timeout.connect|ftp.active|ftp.passive|"
		+ "redirect.follow|retry.count|retry.max_time|output.file|"
		+ "output.remote_name|output.directory|output.create_directories|values.expressions|"
		+ "values.deferred_classification", "|");

	// Действие
	Полученные = КодыВозможностейГенератораCURL.Все();

	// Проверка
	Ожидаем.Что(Полученные.Количество()).Равно(Ожидаемые.Количество());

	Для Номер = 0 По Ожидаемые.Количество() - 1 Цикл
		Ожидаем.Что(Полученные[Номер]).Равно(Ожидаемые[Номер]);
	КонецЦикла;

	Ожидаем.Что(Полученные.Найти("protocol.dynamic")).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест

Процедура ТестДолжен_СохранитьКодВозможности(ИмяФункции, Код) Экспорт

	// Подготовка
	Отражатель = Новый Рефлектор;

	// Действие
	Результат = Отражатель.ВызватьМетод(КодыВозможностейГенератораCURL, ИмяФункции);

	// Проверка
	Ожидаем.Что(Результат).Равно(Код);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("protocol.http", "protocol", Истина)
&ИсточникЗначение("protocol.http.extra", "protocol", Истина)
&ИсточникЗначение("protocol.http.extra", "protocol.http", Истина)
&ИсточникЗначение("protocols.http", "protocol", Ложь)
&ИсточникЗначение("xprotocol.http", "protocol", Ложь)
&ИсточникЗначение("protocol", "protocol", Ложь)
&ИсточникЗначение("protocol.", "protocol", Ложь)
&ИсточникЗначение("protocol.http", "protocol.", Ложь)
&ИсточникЗначение("protocol.http", "", Ложь)
&ИсточникЗначение("", "protocol", Ложь)
&ИсточникЗначение("Protocol.http", "protocol", Ложь)
Процедура ТестДолжен_ПроверитьГраницуГруппы(Код, Группа, Входит) Экспорт

	// Подготовка
	Коды = КодыВозможностейГенератораCURL;

	// Действие
	Результат = Коды.ВходитВГруппу(Код, Группа);

	// Проверка
	Ожидаем.Что(Результат).Равно(Входит);

КонецПроцедуры


&Тест
Процедура ТестДолжен_УстановитьЗначенияПоУмолчанию() Экспорт

	// Подготовка
	Код = КодыПредупрежденийCurlone.ОпцияПроигнорирована();
	Сообщение = "Опция не поддерживается генератором";

	// Действие
	Предупреждение = Новый ПредупреждениеКонвертацииCURL(Код, Сообщение);

	// Проверка
	Ожидаем.Что(Предупреждение.ИдентификаторВозможности()).Равно("");
	Ожидаем.Что(Предупреждение.ИсходнаяОпция()).Равно("");
	Ожидаем.Что(Предупреждение.Позиция()).Равно(-1);
	Ожидаем.Что(Предупреждение.ИдентификаторГенератора()).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуСозданияПредупреждения(
	Код,
	Сообщение,
	ИдентификаторВозможности = "",
	ИсходнаяОпция = "",
	Позиция = -1,
	ИдентификаторГенератора = ""
)

	Попытка
		Предупреждение = Новый ПредупреждениеКонвертацииCURL(
			Код,
			Сообщение,
			ИдентификаторВозможности,
			ИсходнаяОпция,
			Позиция,
			ИдентификаторГенератора
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

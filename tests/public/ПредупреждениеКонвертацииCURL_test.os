#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьПредупреждениеСоВсемиЗначениями() Экспорт

	// Подготовка
	Код = КодыПредупрежденийCurlone.НеподдерживаемаяВозможность();
	Сообщение = "Генератор не поддерживает повторные попытки";

	// Действие
	Предупреждение = Новый ПредупреждениеКонвертацииCURL(
		Код,
		Сообщение,
		"retry",
		"--retry",
		4,
		"third-party"
	);

	// Проверка
	Ожидаем.Что(Предупреждение.Код()).Равно(Код);
	Ожидаем.Что(Предупреждение.Сообщение()).Равно(Сообщение);
	Ожидаем.Что(Предупреждение.ИдентификаторВозможности()).Равно("retry");
	Ожидаем.Что(Предупреждение.ИсходнаяОпция()).Равно("--retry");
	Ожидаем.Что(Предупреждение.Позиция()).Равно(4);
	Ожидаем.Что(Предупреждение.ИдентификаторГенератора()).Равно("third-party");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКодНеверногоТипа() Экспорт

	// Подготовка
	ОжидаемыйКодОшибки = КодыСтандартныхОшибок.НеверныйТипАргумента();

	// Действие
	Ошибка = ПолучитьОшибкуСозданияПредупреждения(1, "Текст предупреждения");

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(ОжидаемыйКодОшибки);

КонецПроцедуры


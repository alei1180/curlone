// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts
#Использовать "../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьЗначимыеПробелыЗначения() Экспорт

	// Подготовка
	Парсер = Новый ПарсерЗначенияОпцииForm();

	// Действие
	Результат = Парсер.Распарсить("field=""  value  """);

	// Проверка
	Ожидаем.Что(Результат.Значения[0].Значение).Равно("  value  ");
	Ожидаем.Что(ТипЗнч(Результат.Значения[0].ФайлыЗаголовков)).Равно(Тип("Массив"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПовторныеФайлыИInlineЗаголовокДляПоследнегоЗначения() Экспорт

	// Подготовка
	Парсер = Новый ПарсерЗначенияОпцииForm();

	// Действие
	Результат = Парсер.Распарсить(
		"files=@a.txt,@b.txt;headers=@headers1.txt;headers=""X-Inline: ok"";headers=@headers2.txt"
	);

	// Проверка
	Ожидаем.Что(Результат.Значения).ИмеетДлину(2);
	Ожидаем.Что(Результат.Значения[0].Параметры["headers"]).ИмеетДлину(0);
	Ожидаем.Что(Результат.Значения[0].ФайлыЗаголовков).ИмеетДлину(0);
	Ожидаем.Что(Результат.Значения[1].ФайлыЗаголовков).ИмеетДлину(2);
	Ожидаем.Что(Результат.Значения[1].ФайлыЗаголовков[0]).Равно("headers1.txt");
	Ожидаем.Что(Результат.Значения[1].ФайлыЗаголовков[1]).Равно("headers2.txt");
	Ожидаем.Что(Результат.Значения[1].Параметры["headers"]).ИмеетДлину(1);
	Ожидаем.Что(Результат.Значения[1].Параметры["headers"]["X-Inline"]).Равно("ok");

КонецПроцедуры

#КонецОбласти

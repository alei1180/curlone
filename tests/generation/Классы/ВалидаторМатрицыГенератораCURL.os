#Использовать errors
#Использовать "../../../src/public"
#Использовать "../../../src/generation"

Перем _Сервис; // СервисКонвертацииCURL
Перем _Цель; // Строка

#Область ОбработчикиСобытий

// Создает валидатор сценариев матрицы генератора.
//
// Параметры:
//   Реестр - РеестрГенераторовCURL - Реестр с проверяемым генератором.
//   Цель - Строка - Идентификатор проверяемого генератора.
Процедура ПриСозданииОбъекта(Реестр = Неопределено, Цель = "")

	Если Реестр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	_Сервис = Новый СервисКонвертацииCURL(Реестр);
	_Цель = Цель;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет точный результат сценария и английскую локализацию сгенерированного кода.
//
// Параметры:
//   Сценарий - Соответствие - Команда, настройки генератора и ожидаемый код на русском языке.
Процедура Проверить(Сценарий) Экспорт

	Результат = Конвертировать(Сценарий, ЛокалиКонвертацииCURL.Русская());

	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(Сценарий["ОжидаемыйКод"]);

	Если СодержитРусскиеБуквы(Сценарий["Команда"]) Тогда
		Возврат;
	КонецЕсли;

	РезультатПеревода = Конвертировать(Сценарий, ЛокалиКонвертацииCURL.Английская());
	Сообщение = СтрШаблон("Перевод %1:
	|%2", Сценарий["Команда"], РезультатПеревода.Код());

	Ожидаем.Что(РезультатПеревода.Успешно()).ЭтоИстина();
	Ожидаем.Что(РезультатПеревода.Код()).Не_().Содержит("{t(");
	Ожидаем.Что(СодержитРусскиеБуквы(РезультатПеревода.Код()), Сообщение).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Конвертировать(Сценарий, Локаль)

	Параметры = Новый ПараметрыКонвертацииCURL(Сценарий["Команда"]);
	Параметры.Цель = _Цель;
	Параметры.Локаль = Локаль;
	Параметры.ПараметрыГенератора.Вставить("ДесериализоватьОтветИзJSON", Сценарий["РазбиратьJSON"]);

	Возврат _Сервис.Конвертировать(Параметры);

КонецФункции

Функция СодержитРусскиеБуквы(Строка)

	Алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"; // BSLLS:Typo-off
	Для Порядок = 1 По СтрДлина(Алфавит) Цикл

		Если СтрНайти(Строка, Сред(Алфавит, Порядок, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

Перем Значения;
Перем Счетчики;
Перем ВызыватьИсключение;

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Значения = Новый Структура(
		"Идентификатор, Наименование, ВерсияКонтракта, Возможности",
		"configured",
		"Настраиваемый генератор",
		1,
		Новый ФиксированныйМассив(Новый Массив)
	);
	Счетчики = Новый Соответствие;
	ВызыватьИсключение = "";
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура Настроить(Имя, Значение) Экспорт
	Значения.Вставить(Имя, Значение);
КонецПроцедуры

Процедура НастроитьИсключение(Имя) Экспорт
	ВызыватьИсключение = Имя;
КонецПроцедуры

Функция КоличествоВызовов(Имя) Экспорт
	Количество = Счетчики.Получить(Имя);
	Возврат ?(Количество = Неопределено, 0, Количество);
КонецФункции

Функция Идентификатор() Экспорт
	Возврат Прочитать("Идентификатор");
КонецФункции

Функция Наименование() Экспорт
	Возврат Прочитать("Наименование");
КонецФункции

Функция ВерсияКонтракта() Экспорт
	Возврат Прочитать("ВерсияКонтракта");
КонецФункции

Функция Возможности() Экспорт
	Возврат Прочитать("Возможности");
КонецФункции

Функция Сгенерировать(КонтекстГенерацииКода) Экспорт
	Возврат "// configured";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Прочитать(Имя)
	Счетчики.Вставить(Имя, КоличествоВызовов(Имя) + 1);
	Если ВызыватьИсключение = Имя Тогда
		ВызватьИсключение "Ошибка чтения метаданных";
	КонецЕсли;
	Возврат Значения[Имя];
КонецФункции

#КонецОбласти

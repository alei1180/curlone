Перем Режим;
Перем ЧислоВызовов;
Перем ИдентификаторЦели;
Перем Блокировка;
Перем АктивныхВызовов;
Перем МаксимумВызовов;
Перем ВозможностиЦели;
Перем БарьерВключен;

#Область ОбработчикиСобытий

// Создаёт управляемую стороннюю цель для проверки сервиса.
//
// Параметры:
//   РежимРезультата - Строка - Способ формирования результата либо исключения.
//   Идентификатор - Строка - Идентификатор цели.
//   Возможности - ФиксированныйМассив, Неопределено - Метаданные либо полный каталог.
Процедура ПриСозданииОбъекта(
	РежимРезультата = "Код",
	Идентификатор = "third-party-test",
	Возможности = Неопределено)
	Режим = РежимРезультата;
	ИдентификаторЦели = Идентификатор;
	ЧислоВызовов = 0;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	АктивныхВызовов = 0;
	МаксимумВызовов = 0;
	ВозможностиЦели = Возможности;
	БарьерВключен = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//   Строка - Идентификатор тестовой цели.
Функция Идентификатор() Экспорт
	Возврат ИдентификаторЦели;
КонецФункции

// Возвращаемое значение:
//   Строка - Наименование тестовой цели.
Функция Наименование() Экспорт
	Возврат "Сторонняя цель для тестов";
КонецФункции

// Возвращаемое значение:
//   Число - Версия SPI.
Функция ВерсияКонтракта() Экспорт
	Возврат 1;
КонецФункции

// Возвращаемое значение:
//   ФиксированныйМассив из Строка - Текущий ответ метаданных.
Функция Возможности() Экспорт
	Если ВозможностиЦели <> Неопределено Тогда
		Возврат ВозможностиЦели;
	КонецЕсли;

	Возврат КодыВозможностейГенератораCURL.Все();
КонецФункции

// Формирует наблюдаемый результат и учитывает одновременные вызовы.
//
// Параметры:
//   Контекст - КонтекстГенерацииКода - Публичные данные вызова.
//
// Возвращаемое значение:
//   Строка, Число - Результат заданного тестового режима.
//
// Исключения:
//   При режиме Исключение создаёт ошибку с контрольным секретом.
Функция Сгенерировать(Контекст) Экспорт
	Блокировка.Заблокировать();
	ЧислоВызовов = ЧислоВызовов + 1;
	АктивныхВызовов = АктивныхВызовов + 1;
	МаксимумВызовов = Макс(МаксимумВызовов, АктивныхВызовов);
	Блокировка.Разблокировать();

	Если БарьерВключен Тогда
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 5000 Цикл
			Блокировка.Заблокировать();
			Пересечение = МаксимумВызовов > 1;
			Блокировка.Разблокировать();

			Если Пересечение Тогда
				Прервать;
			КонецЕсли;

			Приостановить(5);
		КонецЦикла;
	КонецЕсли;

	Блокировка.Заблокировать();
	АктивныхВызовов = АктивныхВызовов - 1;
	Блокировка.Разблокировать();

	Если Режим = "ИзменитьПараметры" Тогда
		Параметры = Контекст.ПараметрыГенератора();
		Параметры.Вставить("Результат", "готово");
		Параметры["Вложения"].Добавить("добавлено");
		Возврат "Параметры изменены";
	КонецЕсли;

	Если Режим = "Возможности" Тогда
		ИменаВозможностей = Новый Массив;
		Для Каждого Возможность Из Контекст.ВозможностиГенератора() Цикл
			ИменаВозможностей.Добавить(Возможность);
		КонецЦикла;

		Возврат СтрСоединить(ИменаВозможностей, ",");
	ИначеЕсли Режим = "Число" Тогда
		Возврат 1;
	ИначеЕсли Режим = "Пусто" Тогда
		Возврат "   ";
	ИначеЕсли Режим = "Исключение" Тогда
		ВызватьИсключение "секрет-вложенного-исключения";
	КонецЕсли;

	ЗначениеПараметра = Контекст.ПараметрыГенератора().Получить("index");
	Возврат СтрШаблон(
		"target=%1;locale=%2;url=%3;parameters=%4",
		Контекст.ИдентификаторГенератора(),
		Контекст.Локаль(),
		Контекст.Операции()[0].Ресурс().АдресДляВыполнения().ЛитеральноеЗначение(),
		?(ЗначениеПараметра = Неопределено, 0, ЗначениеПараметра)
	);
КонецФункции

// Возвращаемое значение:
//   Число - Число вызовов генерации; читать после завершения заданий.
Функция Вызовов() Экспорт
	Возврат ЧислоВызовов;
КонецФункции

// Возвращаемое значение:
//   Число - Максимум пересекающихся вызовов; читать после завершения заданий.
Функция МаксимумОдновременныхВызовов() Экспорт
	Возврат МаксимумВызовов;
КонецФункции

// Включает ограниченное ожидание пересечения вызовов после последовательных эталонов.
Процедура ВключитьБарьер() Экспорт

	БарьерВключен = Истина;
	МаксимумВызовов = 0;

КонецПроцедуры

// Меняет ответ метаданных для проверки сохранения зарегистрированного снимка.
//
// Параметры:
//   Возможности - ФиксированныйМассив из Строка - Новый ответ функции SPI.
Процедура ИзменитьВозможности(Возможности) Экспорт

	ВозможностиЦели = Возможности;

КонецПроцедуры

#КонецОбласти

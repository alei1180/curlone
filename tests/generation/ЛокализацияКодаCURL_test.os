#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьЛитералыИКомментарииПриПереводе() Экспорт

	// Подготовка
	Код = "// Новый "" ЗапросHTTP
	|ЗапросHTTP = Новый HTTPЗапрос(""/Новый/Записать"");
	|ЗапросHTTP.УстановитьТелоИзСтроки(""Если """"Новый"""" Тогда"");";
	ОжидаемыйКод = "// Новый "" ЗапросHTTP
	|HTTPRequest = New HTTPRequest(""/Новый/Записать"");
	|HTTPRequest.SetBodyFromString(""Если """"Новый"""" Тогда"");";

	// Действие
	Результат = Новый ЛокализацияКодаCURL(ЛокалиКонвертацииCURL.Английская()).Перевести(Код);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьЗаписьFTPИДвоичныхДанных() Экспорт

	// Подготовка
	Код = "СоединениеFTP.Записать(""local.txt"", ""/remote.txt"");
	|ДанныеОтвета.Записать(""result.bin"");";
	ОжидаемыйКод = "FTPConnection.Put(""local.txt"", ""/remote.txt"");
	|ResponseData.Write(""result.bin"");";

	// Действие
	Результат = Новый ЛокализацияКодаCURL(ЛокалиКонвертацииCURL.Английская()).Перевести(Код);

	// Проверка
	Ожидаем.Что(Результат).Равно(ОжидаемыйКод);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ru", "Требуется дополнительная обработка. Процентно закодируйте ДанныеЧасти.")
&ИсточникЗначение("en", "Additional processing is required. Percent-encode PartData.")
Процедура ТестДолжен_ПолучитьКомментарийИзПакетаРесурсов(Локаль, ОжидаемыйКомментарий) Экспорт

	// Подготовка
	Локализация = Новый ЛокализацияКодаCURL(Локаль);

	// Действие
	Комментарий = Локализация.ПолучитьРесурс("ТребуетсяКодированиеДанныхURL");

	// Проверка
	Ожидаем.Что(Комментарий).Равно(ОжидаемыйКомментарий);

КонецПроцедуры

#КонецОбласти

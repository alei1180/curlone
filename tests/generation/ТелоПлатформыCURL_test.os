&Тест
Процедура ТестДолжен_ОформлятьЧастиMultipart() Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды(
		"curl -F 'field=value' -F 'file=@missing.bin;type=application/octet-stream' https://example.org"
	);
	Строки = Новый ПостроительКодаCURL;
	Генератор = СоздатьФормировательТела();

	// Действие
	Генератор.ДобавитьТелоИзЧастей(Строки, Запрос.Тело().Части(), КодыВозможностейГенератораCURL.Все());
	Код = Строки.ПолучитьРезультат();

	// Проверка
	Ожидаем.Что(Код).Содержит("multipart/form-data; boundary=");
	Ожидаем.Что(Код).Содержит("Content-Disposition: form-data; name=");
	Ожидаем.Что(Код).Содержит("Content-Type: application/octet-stream");
	Ожидаем.Что(Код).Содержит("Новый ДвоичныеДанные(""missing.bin"")");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщатьОДополнительномКодированииСтрокиЗапроса() Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды("curl --url-query 'name=a b' https://example.org");
	Строки = Новый ПостроительКодаCURL;
	Генератор = СоздатьФормировательТела();

	// Действие
	Генератор.ДобавитьСтрокуЗапроса(
		Строки,
		Запрос.СтрокаЗапроса().Части(),
		КодыВозможностейГенератораCURL.Все()
	);
	Код = Строки.ПолучитьРезультат();

	// Проверка
	Ожидаем.Что(Код).Содержит(
		"// Требуется дополнительная обработка. Процентно закодируйте ДанныеЧасти."
	);
	Ожидаем.Что(Код).Содержит("""name="" + ТекстЧасти");
	ПроверитьОтсутствиеРукописнойОбработкиБайтов(Код);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛокализоватьКомментарийОДополнительномКодировании() Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды("curl --url-query 'name=a b' https://example.org");
	Строки = Новый ПостроительКодаCURL;
	Генератор = СоздатьФормировательТела(ЛокалиКонвертацииCURL.Английская());
	ОжидаемыйКод = "ДанныеЧасти = ПолучитьДвоичныеДанныеИзСтроки(""a b"", КодировкаТекста.UTF8, Ложь);
	|// Additional processing is required. Percent-encode PartData.
	|ТекстЧасти = ПолучитьСтрокуИзДвоичныхДанных(ДанныеЧасти, КодировкаТекста.UTF8);
	|Адрес = Адрес + ?(СтрНайти(Адрес, ""?"") = 0, ""?"", ""&"") + ""name="" + ТекстЧасти;";

	// Действие
	Генератор.ДобавитьСтрокуЗапроса(
		Строки,
		Запрос.СтрокаЗапроса().Части(),
		КодыВозможностейГенератораCURL.Все()
	);

	// Проверка
	Ожидаем.Что(Строки.ПолучитьРезультат()).Равно(ОжидаемыйКод);

КонецПроцедуры


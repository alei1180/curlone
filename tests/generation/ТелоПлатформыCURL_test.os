КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВозможностиКроме(ИсключеннаяВозможность)

	Результат = Новый Массив;
	Для Каждого Возможность Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Возможность <> ИсключеннаяВозможность Тогда
			Результат.Добавить(Возможность);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗапросИзКоманды(Текст)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(Текст);
	Интерпретация = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Возврат Интерпретация.Выполнение().Операции()[0].Запрос();

КонецФункции

Функция СоздатьФормировательТела(Локаль = Неопределено)

	Если Локаль = Неопределено Тогда
		Локаль = ЛокалиКонвертацииCURL.Русская();
	КонецЕсли;

	Выражения = Новый ГенераторВыраженийCURL(
		Локаль,
		Новый Соответствие
	);

	Возврат Новый ФормированиеТелаHTTPЗапросаCURL(Выражения, , , Локаль);

КонецФункции

Процедура ПроверитьОтсутствиеРукописнойОбработкиБайтов(Код)

	Ожидаем.Что(СтрНайти(Код, "БуферЧасти")).Равно(0);
	Ожидаем.Что(СтрНайти(Код, "ШестнадцатеричныеДанные")).Равно(0);
	Ожидаем.Что(СтрНайти(Код, "ОчищенныеДанные")).Равно(0);
	Ожидаем.Что(СтрНайти(Код, "ЦифрыHEX")).Равно(0);

КонецПроцедуры
#КонецОбласти

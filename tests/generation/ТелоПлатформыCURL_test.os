	Ожидаем.Что(Строки.ПолучитьРезультат()).Равно("");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("multipart.filename", "filename=")
&ИсточникЗначение("multipart.content_type", "Content-Type: text/custom")
&ИсточникЗначение("multipart.part_headers", "X-Part: value")
Процедура ТестДолжен_ПропускатьНеподдержанныеСвойстваЧасти(Возможность, Фрагмент) Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды(
		"curl -F 'field=@missing.bin;filename=sent.bin;type=text/custom;headers=X-Part: value' https://example.org"
	);
	Строки = Новый ПостроительКодаCURL;
	Генератор = СоздатьФормировательТела();

	// Действие
	Генератор.ДобавитьТелоИзЧастей(Строки, Запрос.Тело().Части(), ВозможностиКроме(Возможность));
	Код = Строки.ПолучитьРезультат();

	// Проверка
	Ожидаем.Что(СтрНайти(Код, Фрагмент)).Равно(0);
	Ожидаем.Что(Код).Содержит("Новый ДвоичныеДанные(""missing.bin"")");

КонецПроцедуры


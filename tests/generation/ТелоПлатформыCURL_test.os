#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("-d", Истина)
&ИсточникЗначение("--data-binary", Ложь)
Процедура ТестДолжен_СохранятьРежимФайлаПриПереносеВСтрокуЗапроса(Опция, УдалятьПереводыСтрок) Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды("curl -G " + Опция + " @missing.txt https://example.org");
	Строки = Новый ПостроительКодаCURL;
	Генератор = СоздатьФормировательТела();

	// Действие
	Генератор.ДобавитьСтрокуЗапроса(
		Строки,
		Запрос.СтрокаЗапроса().Части(),
		КодыВозможностейГенератораCURL.Все()
	);
	Код = Строки.ПолучитьРезультат();

	// Проверка
	Ожидаем.Что(Код).Содержит("Новый ДвоичныеДанные(""missing.txt"")");
	Ожидаем.Что(СтрНайти(Код, "Требуется дополнительная обработка. Удалите байты NUL, CR и LF") > 0)
		.Равно(УдалятьПереводыСтрок);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("-d value", "body.data")
&ИсточникЗначение("-T missing.bin", "body.upload")
&ИсточникЗначение("-F field=value", "body.multipart")
&ИсточникЗначение("--data-urlencode name=value", "data.urlencode")
Процедура ТестДолжен_ПропускатьНеподдержанноеТело(Опции, ИсключеннаяВозможность) Экспорт

	// Подготовка
	Запрос = ЗапросИзКоманды("curl " + Опции + " https://example.org");
	Строки = Новый ПостроительКодаCURL;
	Возможности = ВозможностиКроме(ИсключеннаяВозможность);
	Генератор = СоздатьФормировательТела();

	// Действие
	Генератор.ДобавитьТелоИзЧастей(Строки, Запрос.Тело().Части(), Возможности);

	// Проверка
	Ожидаем.Что(Строки.ПолучитьРезультат()).Равно("");

КонецПроцедуры


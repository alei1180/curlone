#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("ftp://example.org/file")
&ИсточникЗначение("ftps://example.org/file")
Процедура ТестДолжен_БлокироватьНеподдерживаемыйПротокол(Адрес) Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl " + Адрес);
	Параметры.Цель = "connector";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Код()).Равно("");
	КодОшибки = Новый РазборОшибки(Результат.Ошибки()[0]).КодОшибки();
	Ожидаем.Что(КодОшибки).Равно("curlone.generator.unrepresentable_semantics");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("headers.remove")
&ИсточникЗначение("auth.aws_sigv4")
&ИсточникЗначение("redirect.follow")
&ИсточникЗначение("retry.count")
&ИсточникЗначение("retry.max_time")
&ИсточникЗначение("timeout.total")
Процедура ТестДолжен_НеОбъявлятьТочнымиВозможностиСПотерями(Возможность) Экспорт

	// Подготовка
	Генератор = Новый ГенераторКодаКоннектораCURL;

	// Действие
	Возможности = Генератор.Возможности();

	// Проверка
	Ожидаем.Что(Возможности.Найти(Возможность)).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоддерживатьСовместимыеВычисляемыеЗначения() Экспорт

	// Подготовка
	Генератор = Новый ГенераторКодаКоннектораCURL;

	// Действие
	Возможности = Генератор.Возможности();

	// Проверка
	Ожидаем.Что(Возможности.Найти("values.expressions")).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьПолитикиHEADСПредупреждениями() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL(
		"curl -I -L --retry 2 --retry-max-time 5 --max-time 3 http://example.org"
	);
	Параметры.Цель = "connector";
	ОжидаемыйКод = "ДополнительныеПараметры = Новый Структура();
	|ДополнительныеПараметры.Вставить(""Таймаут"", 3);
	|ДополнительныеПараметры.Вставить(""МаксимальноеКоличествоПовторов"", 2);
	|ДополнительныеПараметры.Вставить(""МаксимальноеВремяПовторов"", 5);
	|
	|Результат = КоннекторHTTP.Head(""http://example.org"", ДополнительныеПараметры);";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Предупреждения().Количество()).Равно(4);

КонецПроцедуры

#КонецОбласти

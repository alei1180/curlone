#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьПодавлениеАвтоматическогоЗаголовка() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки(
		"curl --json '{}' -H 'content-type:' http://example.org");
	Операция = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение().Операции()[0];

	// Действие
	Результат = Новый ПодготовкаОперацииДляГенерацииCURL().Подготовить(
		Операция, КодыВозможностейГенератораCURL.Все());

	// Проверка
	Ожидаем.Что(Результат.Заголовки.Получить("content-type").Удален).Равно(Истина);
	Ожидаем.Что(Результат.Заголовки.Получить("accept").Значение).Равно("application/json");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПропуститьЗаголовкиВнеСнимкаВозможностей() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -H 'X-Test: value' http://example.org");
	Операция = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение().Операции()[0];

	// Действие
	Результат = Новый ПодготовкаОперацииДляГенерацииCURL().Подготовить(
		Операция, Новый ФиксированныйМассив(Новый Массив));

	// Проверка
	Ожидаем.Что(Результат.Заголовки.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИсходнуюОперациюИПорядокЧастей() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -d a=1 -d b=2 https://example.org");
	Интерпретация = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Операция = Интерпретация.Выполнение().Операции()[0];

	// Действие
	Результат = Новый ПодготовкаОперацииДляГенерацииCURL().Подготовить(
		Операция,
		КодыВозможностейГенератораCURL.Все()
	);

	// Проверка
	Ожидаем.Что(Результат.Операция = Операция).Равно(Истина);
	Ожидаем.Что(Результат.ЧастиТела).ИмеетДлину(2);
	Ожидаем.Что(Результат.ЧастиТела[0].Текст()).Равно("a=1");
	Ожидаем.Что(Результат.ЧастиТела[1].Текст()).Равно("b=2");

КонецПроцедуры

#КонецОбласти

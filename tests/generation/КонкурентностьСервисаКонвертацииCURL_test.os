#Использовать asserts
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "."

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ИзолироватьПараллельныеВызовыСервиса() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Генератор = Новый СторонняяЦельДляТестовCURL;
	Реестр.Зарегистрировать(Генератор);
	ВтораяЦель = Новый СторонняяЦельДляТестовCURL("Код", "second");
	Реестр.Зарегистрировать(ВтораяЦель);
	Сервис = Новый СервисКонвертацииCURL(Реестр);
	Контексты = Новый Массив;
	Задания = Новый Массив;
	Для Индекс = 1 По 12 Цикл
		Адрес = "https://host" + СокрЛП(Строка(Индекс)) + ".example.org";
		Параметры = Новый ПараметрыКонвертацииCURL("curl " + Адрес);
		Если Индекс % 4 = 0 Тогда
			Параметры.Команда = "curl --max-time invalid " + Адрес;
		КонецЕсли;
		Параметры.Цель = ?(Индекс % 2 = 0, "third-party-test", "second");
		Параметры.Локаль = ?(Индекс % 2 = 0, "ru", "en");
		Параметры.ПараметрыГенератора.Вставить("index", Индекс);
		РезультатЭталона = Сервис.Конвертировать(Параметры);
		Ожидаем.Что(РезультатЭталона.Успешно()).Равно(Индекс % 4 <> 0);
		Эталон = РезультатЭталона.Код();
		Контексты.Добавить(Новый Структура(
			"Сервис, Параметры, Эталон, Результат, Ошибка, Успех, ЧислоОшибок",
			Сервис, Параметры, Эталон, Неопределено, Неопределено,
			РезультатЭталона.Успешно(), РезультатЭталона.Ошибки().Количество()));
	КонецЦикла;

	// Действие
	Генератор.ВключитьБарьер();
	ВтораяЦель.ВключитьБарьер();
	Для Каждого Контекст Из Контексты Цикл
		Аргументы = Новый Массив;
		Аргументы.Добавить(Контекст);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "КонвертироватьВФоне", Аргументы));
	КонецЦикла;
	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Проверка
	Для Каждого Контекст Из Контексты Цикл
		Ожидаем.Что(Контекст.Ошибка).Равно(Неопределено);
		Ожидаем.Что(Контекст.Результат.Код()).Равно(Контекст.Эталон);
		Ожидаем.Что(Контекст.Результат.Успешно()).Равно(Контекст.Успех);
		Ожидаем.Что(Контекст.Результат.Ошибки()).ИмеетДлину(Контекст.ЧислоОшибок);
	КонецЦикла;
	Ожидаем.Что(Генератор.МаксимумОдновременныхВызовов() > 1).Равно(Истина);
	Ожидаем.Что(ВтораяЦель.МаксимумОдновременныхВызовов() > 1).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет конвертацию в фоновом задании.
//
// Параметры:
//   Контекст - Структура - Сервис, входные параметры и место для результата задания.
Процедура КонвертироватьВФоне(Контекст) Экспорт
	Попытка
		Контекст.Результат = Контекст.Сервис.Конвертировать(Контекст.Параметры);
	Исключение
		Контекст.Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

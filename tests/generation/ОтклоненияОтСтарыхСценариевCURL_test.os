#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьКодПлатформыПриНеподдерживаемойПодписиAWS() Экспорт

	// Подготовка
	Команда = "curl http://example.com --aws-sigv4 aws:amz:us-east-2:es --user key:secret";
	ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80, ""key"", ""secret"");
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаПлатформыCURL);

	// Проверка
	ПроверитьПредупреждение(
		Результат,
		ОжидаемыйКод,
		КодыВозможностейГенератораCURL.ПодписьAWSV4()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСопоставленныеПередачиПлатформыПриЛишнихФайлах() Экспорт

	// Подготовка
	Команда = КомандаСЛишнимиФайлами();
	ОжидаемыйКод = "// Запрос 1. http://example1.com
	|Соединение = Новый HTTPСоединение(""example1.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/file1.txt"");
	|HTTPЗапрос.УстановитьИмяФайлаТела(""path/to/file1.txt"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""PUT"", HTTPЗапрос);
	|
	|// Запрос 2. http://example2.com
	|Соединение = Новый HTTPСоединение(""example2.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/file2.txt"");
	|HTTPЗапрос.УстановитьИмяФайлаТела(""path/to/file2.txt"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""PUT"", HTTPЗапрос);";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаПлатформыCURL);

	// Проверка
	ПроверитьЛишниеФайлы(Результат, ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСопоставленныеПередачиКоннектораПриЛишнихФайлах() Экспорт

	// Подготовка
	Команда = КомандаСЛишнимиФайлами();
	ОжидаемыйКод = "// Запрос 1. http://example1.com
	|Данные = Новый ДвоичныеДанные(""path/to/file1.txt"");
	|Результат = КоннекторHTTP.Put(""http://example1.com/file1.txt"", Данные);
	|
	|// Запрос 2. http://example2.com
	|Данные = Новый ДвоичныеДанные(""path/to/file2.txt"");
	|Результат = КоннекторHTTP.Put(""http://example2.com/file2.txt"", Данные);";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаКоннектораCURL);

	// Проверка
	ПроверитьЛишниеФайлы(Результат, ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеподдерживаемыйПроксиПлатформы() Экспорт

	// Подготовка
	Команда = "curl http://example.com/ --proxy socks5h://proxy.example";
	ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаПлатформыCURL);

	// Проверка
	ПроверитьНеподдерживаемыйПрокси(Результат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеподдерживаемыйПроксиКоннектора() Экспорт

	// Подготовка
	Команда = "curl http://example.com/ --proxy socks5h://proxy.example";
	ОжидаемыйКод = "Результат = КоннекторHTTP.Get(""http://example.com"");";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаКоннектораCURL);

	// Проверка
	ПроверитьНеподдерживаемыйПрокси(Результат);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКодFTPПриИгнорированииАдресаАктивногоРежима() Экспорт

	// Подготовка
	Команда = "curl ftp://ftp.example.com/file.txt --ftp-port 1.1.1.1";
	ОжидаемыйКод = "Соединение = Новый FTPСоединение(""ftp.example.com"", 21);
	|
	|Соединение.Получить(""/file.txt"", ""path/to/file"");";

	// Действие
	Результат = Конвертировать(Команда, Новый ГенераторКодаПлатформыCURL);

	// Проверка
	ПроверитьПредупреждение(
		Результат,
		ОжидаемыйКод,
		КодыВозможностейГенератораCURL.АктивныйFTP()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Конвертировать(Команда, Генератор)

	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Генератор);
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Параметры.Цель = Генератор.Идентификатор();
	Параметры.Локаль = ЛокалиКонвертацииCURL.Русская();

	Возврат Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

КонецФункции

Функция КомандаСЛишнимиФайлами()

	Возврат "curl -T path/to/file1.txt -T path/to/file2.txt -T path/to/file3.txt "
		+ "-T path/to/file4.txt http://example1.com http://example2.com";

КонецФункции

Процедура ПроверитьЛишниеФайлы(Результат, ОжидаемыйКод)

	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(2);

	Для Каждого Предупреждение Из Результат.Предупреждения() Цикл
		Ожидаем.Что(Предупреждение.Код()).Равно(КодыПредупрежденийCurlone.ОпцияПроигнорирована());
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьНеподдерживаемыйПрокси(Результат)

	Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
	Ожидаем.Что(Результат.Код()).Равно("");
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НепредставимаяСемантикаГенератора()
	);

КонецПроцедуры

Процедура ПроверитьПредупреждение(Результат, ОжидаемыйКод, Возможность)

	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(1);
	Предупреждение = Результат.Предупреждения()[0];
	Ожидаем.Что(Предупреждение.Код()).Равно(
		КодыПредупрежденийCurlone.НеподдерживаемаяВозможность()
	);
	Ожидаем.Что(Предупреждение.ИдентификаторВозможности()).Равно(Возможность);

КонецПроцедуры

#КонецОбласти

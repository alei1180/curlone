#Область Тесты

&Тест
Процедура ТестДолжен_ПрименитьСокращенныйСнимокВозможностей() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки(
		"curl -X PATCH -H 'X-Test: value' -d secret --user alice:pass http://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Возможности = СтрРазделить("protocol.http,operations.multiple", ",");
	Контекст = Новый КонтекстГенерацииКода(
		Выполнение.Операции(), "ru", Новый Соответствие, "1c", Новый ФиксированныйМассив(Возможности));
	ОжидаемыйКод = "Адрес = ""/"";
	|ЗапросHTTP = Новый HTTPЗапрос(Адрес);
	|СоединениеHTTP = Новый HTTPСоединение(""example.org"", 80);
	|ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(""POST"", ЗапросHTTP);
	|Результат = ОтветHTTP.ПолучитьТелоКакСтроку();";

	// Действие
	Код = Новый ГенераторКодаПлатформыCURL().Сгенерировать(Контекст);

	// Проверка
	Ожидаем.Что(Код).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьЧтениеJSONЧерезЧитатель() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl http://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Генератор = Новый ГенераторКодаПлатформыCURL;
	Параметры = Новый Соответствие;
	Параметры.Вставить("ДесериализоватьОтветИзJSON", Истина);
	Контекст = Новый КонтекстГенерацииКода(
		Выполнение.Операции(), "ru", Параметры, "1c", Генератор.Возможности());
	ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.org"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);
	|
	|// Десериализация JSON
	|Поток = HTTPОтвет.ПолучитьТелоКакПоток();
	|ЧтениеJSON = Новый ЧтениеJSON();
	|ЧтениеJSON.ОткрытьПоток(Поток);
	|Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	|Поток.Закрыть();";

	// Действие
	Код = Генератор.Сгенерировать(Контекст);

	// Проверка
	Ожидаем.Что(Код).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьМетаданныеSPI() Экспорт

	// Подготовка
	Генератор = Новый ГенераторКодаПлатформыCURL;

	// Действие и Проверка
	Ожидаем.Что(Генератор.Идентификатор()).Равно("1c");
	Ожидаем.Что(Генератор.Наименование()).Равно("Платформенные HTTP и FTP");
	Ожидаем.Что(Генератор.ВерсияКонтракта()).Равно(1);
	Ожидаем.Что(ТипЗнч(Генератор.Возможности())).Равно(Тип("ФиксированныйМассив"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СгенерироватьНезависимыеОперацииЧерезСервис() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаПлатформыCURL);
	Сервис = Новый СервисКонвертацииCURL(Реестр);
	Параметры = Новый ПараметрыКонвертацииCURL(
		"curl -H 'X-First: 1' https://one.example --next http://two.example");
	Параметры.Цель = "1c";
	ОжидаемыйКод = "// Запрос 1. https://one.example
	|Заголовки = Новый Соответствие();
	|Заголовки.Вставить(""X-First"", ""1"");
	|
	|ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	|
	|Соединение = Новый HTTPСоединение(""one.example"", 443, , , , , ЗащищенноеСоединение);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"", Заголовки);
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);
	|
	|// Запрос 2. http://two.example
	|Соединение = Новый HTTPСоединение(""two.example"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос);";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьРезервноеИмяДляURLБезИмениФайла() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаПлатформыCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl http://example.com/ -O");
	Параметры.Цель = "1c";
	Параметры.Локаль = ЛокалиКонвертацииCURL.Русская();
	ОжидаемыйКод = "Соединение = Новый HTTPСоединение(""example.com"", 80);
	|HTTPЗапрос = Новый HTTPЗапрос(""/"");
	|
	|HTTPОтвет = Соединение.ВызватьHTTPМетод(""GET"", HTTPЗапрос, ""curl_response"");";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

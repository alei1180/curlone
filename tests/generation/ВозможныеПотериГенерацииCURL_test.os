#Использовать asserts
#Использовать "../../src/public"
#Использовать "../../src/domain"
#Использовать "../../src/generation"
#Использовать "../domain"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("--header @missing-secret.txt", "headers.repeated", "--header")
&ИсточникЗначение("--header @-", "headers.empty", "--header")
&ИсточникЗначение("--form 'name=value;headers=@missing-secret.txt'", "headers.remove", "--form")
&ИсточникЗначение("--data ""$SECRET""", "input.file", "--data-ascii")
Процедура ТестДолжен_СообщитьОбУсловнойПотереБезРаскрытияЗначения(Опции, Возможность, Имя) Экспорт

	// Подготовка
	Выполнение = Разобрать("curl " + Опции + " https://example.org");
	Описание = ОписаниеБез(Возможность);

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(Выполнение, Описание);

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(1);
	Предупреждение = Результат.Предупреждения()[0];
	Ожидаем.Что(Предупреждение.ИдентификаторВозможности()).Равно(Возможность);
	Ожидаем.Что(Предупреждение.ИсходнаяОпция()).Равно(Имя);
	Ожидаем.Что(Предупреждение.Позиция() >= 0).Равно(Истина);
	Ожидаем.Что(Предупреждение.ИдентификаторГенератора()).Равно("test");
	Ожидаем.Что(СтрНачинаетсяС(Предупреждение.Сообщение(), "Возможна потеря")).Равно(Истина);
	Ожидаем.Что(СтрНайти(НРег(Предупреждение.Сообщение()), "secret")).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокОперацийКаталогаИПервыйИсточник() Экспорт

	// Подготовка
	Выполнение = Разобрать("curl --data @secret --data @second -H 'X: 1' https://one https://two");
	Возможности = Новый Массив;
	Возможности.Добавить("protocol.https");
	Возможности.Добавить("operations.multiple");
	Описание = Новый ОписаниеГенератораCURL("test", "Тест", 1, Новый ФиксированныйМассив(Возможности));

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(Выполнение, Описание);

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Предупреждения = Результат.Предупреждения();
	Ожидаем.Что(Предупреждения).ИмеетДлину(6);
	Для Номер = 0 По 1 Цикл
		Ожидаем.Что(Предупреждения[Номер * 3].ИдентификаторВозможности()).Равно("headers.ordered");
		Ожидаем.Что(Предупреждения[Номер * 3 + 1].ИдентификаторВозможности()).Равно("body.data");
		Источник = Предупреждения[Номер * 3 + 2];
		Ожидаем.Что(Источник.ИдентификаторВозможности()).Равно("input.file");
		Ожидаем.Что(Источник.Позиция()).Равно(
			Выполнение.Операции()[Номер].Запрос().Тело().Части()[0].Источник().ИсходныйТокен().Позиция());
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьХотяБыОдинПротоколДинамическогоРесурса() Экспорт

	// Подготовка
	Выполнение = Разобрать("curl ""$URL""");
	Возможности = Новый Массив;
	Для Каждого Имя Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Не СтрНачинаетсяС(Имя, "protocol.") Тогда
			Возможности.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	БезПротоколов = Новый ОписаниеГенератораCURL("test", "Тест", 1, Новый ФиксированныйМассив(Возможности));
	Возможности.Добавить("protocol.https");
	ОдинПротокол = Новый ОписаниеГенератораCURL("test", "Тест", 1, Новый ФиксированныйМассив(Возможности));
	Анализатор = Новый АнализаторВозможностейГенератора;

	// Действие
	Ошибка = Анализатор.Анализировать(Выполнение, БезПротоколов);
	Успех = Анализатор.Анализировать(Выполнение, ОдинПротокол);

	// Проверка
	Ожидаем.Что(Ошибка.Ошибки()).ИмеетДлину(1);
	Ожидаем.Что(Успех.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Успех.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("curl --data ""$BODY"" -H @missing-secret.txt https://example.org")
&ИсточникЗначение("curl --form ""$FORM"" --proxy ""$PROXY"" --output ""$OUT"" ""$URL""")
Процедура ТестДолжен_ПринятьВсеПотенциальныеВозможностиПолнойЦели(Текст) Экспорт

	// Подготовка
	Выполнение = Разобрать(Текст);

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(Выполнение, ОписаниеБез(""));

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеБез(Исключенная)

	Возможности = Новый Массив;
	Для Каждого Имя Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Имя <> Исключенная Тогда
			Возможности.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ОписаниеГенератораCURL("test", "Тест", 1, Новый ФиксированныйМассив(Возможности));

КонецФункции

Функция Разобрать(Текст)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(Текст);
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Возврат Результат.Выполнение();

КонецФункции

#КонецОбласти

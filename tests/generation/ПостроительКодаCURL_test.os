#Область Тесты

&Тест
Процедура ТестДолжен_ПодставитьПеременнуюИПостроитьВызов() Экспорт

	// Подготовка
	Токен = Новый ЛексерКомандыCURL().Разобрать("curl ""http://$HOST/items""").Токены()[1];
	Выражение = Новый ВыражениеЗначенияCURL(Токен);
	ИменаПеременных = Новый Соответствие;
	ПредставлениеВыражений = Новый ГенераторВыраженийCURL("ru", ИменаПеременных);
	Код = Новый ПостроительКодаCURL(ПредставлениеВыражений);
	Параметры = Новый Массив;
	Параметры.Добавить(Код.ПредставитьВыражение(Выражение));
	ОжидаемыйКод = "Результат = Клиент.Получить(""http://"" + HOST + ""/items"");";

	// Действие
	Код.ДобавитьВызов("Результат = ", "Клиент.Получить", Параметры);

	// Проверка
	Ожидаем.Что(Код.ПолучитьРезультат()).Равно(ОжидаемыйКод);
	Ожидаем.Что(ИменаПеременных.Получить("HOST")).Равно("HOST");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьВложенныеМассивыИСоответствия() Экспорт

	// Подготовка
	Элементы = Новый Массив;
	Элементы.Добавить("первый");
	Элементы.Добавить(Неопределено);
	Данные = Новый Соответствие;
	Данные.Вставить("items", Элементы);
	Данные.Вставить("enabled", Истина);
	Код = Новый ПостроительКодаCURL;
	ОжидаемыйКод = "Данные = Новый Соответствие();
	|Данные.Вставить(""items"", Новый Массив());
	|Данные[""items""].Добавить(""первый"");
	|Данные[""items""].Добавить(Неопределено);
	|Данные.Вставить(""enabled"", Истина);";

	// Действие
	Код.ДобавитьКоллекцию("Данные", Данные);

	// Проверка
	Ожидаем.Что(Код.ПолучитьРезультат()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьДлинноеСоставноеВыражение() Экспорт

	// Подготовка
	Выражения = Новый Массив;
	Выражения.Добавить("ПервоеЗначение");
	Выражения.Добавить("ВтороеЗначение");
	Выражения.Добавить("ТретьеЗначение");
	Код = Новый ПостроительКодаCURL;
	ОжидаемыйКод = "Данные = ПервоеЗначение
	|	+ ""&"" + ВтороеЗначение
	|	+ ""&"" + ТретьеЗначение;";

	// Действие
	Код.ДобавитьСоставноеВыражение("Данные", Выражения, "&");

	// Проверка
	Ожидаем.Что(Код.ПолучитьРезультат()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПеренестиДлинныеПараметрыВызова() Экспорт

	// Подготовка
	Параметры = Новый Массив;
	Параметры.Добавить("ОченьДлинноеПервоеВыражениеСПараметрамиИОбращениямиКСвойствамОбъекта");
	Параметры.Добавить("ОченьДлинноеВтороеВыражениеСПараметрамиИОбращениямиКСвойствамОбъекта");
	Код = Новый ПостроительКодаCURL;
	ОжидаемыйКод = "Результат = Клиент.Выполнить(ОченьДлинноеПервоеВыражениеСПараметрамиИОбращениямиКСвойствамОбъекта,
	|	ОченьДлинноеВтороеВыражениеСПараметрамиИОбращениямиКСвойствамОбъекта);";

	// Действие
	Код.ДобавитьВызов("Результат = ", "Клиент.Выполнить", Параметры);

	// Проверка
	Ожидаем.Что(Код.ПолучитьРезультат()).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

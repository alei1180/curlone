#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьМоделиИЗащититьКонтейнеры() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки(
		"curl -H ""X-Test: first"" -H ""X-Test: second"" --data ""$BODY"" https://example.org");
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Возможности = Новый ФиксированныйМассив(СтрРазделить("protocol.https|body.data", "|"));
	Описание = Новый ОписаниеГенератораCURL("test", "Тестовый", 1, Возможности);
	Параметры = Новый Соответствие;
	Метки = Новый Массив;
	Метки.Добавить("first");
	Параметры.Вставить("Метки", Метки);

	// Действие
	Контекст = Новый КонтекстГенерацииКода(
		Выполнение.Операции(),
		"ru",
		Параметры,
		Описание.Идентификатор(),
		Описание.Возможности()
	);
	Метки.Добавить("second");

	// Проверка
	Операция = Контекст.Операции()[0];
	Ожидаем.Что(ТипЗнч(Операция)).Равно(Тип("ОперацияПередачиCURL"));
	Ожидаем.Что(Контекст.Операции() = Выполнение.Операции()).Равно(Ложь);
	Ожидаем.Что(Операция = Выполнение.Операции()[0]).Равно(Истина);
	Ожидаем.Что(Операция.Запрос().Заголовки()[0].Значение()).Равно(" first");
	Ожидаем.Что(Операция.Запрос().Заголовки()[1].Значение()).Равно(" second");
	Ожидаем.Что(Операция.Запрос().Тело().Части()[0].ОтложеннаяКлассификация().Грамматика()).Равно("data");
	Ожидаем.Что(Контекст.ПараметрыГенератора()["Метки"]).ИмеетДлину(2);
	Ожидаем.Что(Контекст.ВозможностиГенератора()).ИмеетДлину(2);
	Ожидаем.Что(Операция.Ресурс().Источник() = Выполнение.Операции()[0].Ресурс().Источник()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьЦиклИПовторнуюСсылку() Экспорт

	// Подготовка
	Параметры = Новый Соответствие;
	Общие = Новый Массив;
	Общие.Добавить("text");
	Параметры.Вставить("first", Общие);
	Параметры.Вставить("second", Общие);
	Возможности = Новый ФиксированныйМассив(Новый Массив);

	// Действие
	Контекст = Новый КонтекстГенерацииКода(Новый Массив, "ru", Параметры, "test", Возможности);
	Общие.Добавить(Параметры);
	Ошибка = Неопределено;
	Попытка
		НекорректныйКонтекст = Новый КонтекстГенерацииКода(Новый Массив, "ru", Параметры, "test", Возможности);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Контекст.ПараметрыГенератора()["first"]).ИмеетДлину(2);
	Ожидаем.Что(Ошибка = Неопределено).Равно(Истина);
	Ожидаем.Что(Контекст.ПараметрыГенератора() = Параметры).Равно(Ложь);
	Ожидаем.Что(Контекст.ПараметрыГенератора()["first"] = Общие).Равно(Истина);
	Ожидаем.Что(Контекст.ПараметрыГенератора()["second"] = Общие).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьФормуАутентификациюИСоединение() Экспорт

	// Подготовка
	Текст = "curl -X PATCH -u user:pass --digest --proxy http://proxy.test:8080 --proxy-user proxy:secret "
		+ "--proxy-ntlm --cert client.pem:password --cacert ca.pem --ca-native "
		+ "--max-time 12.5 --connect-timeout 3 --retry 2 --retry-max-time 10 --location "
		+ "-F 'upload=@data.txt;filename=report.txt;type=text/plain;headers=X-Part: yes' "
		+ "-o report.out --output-dir result --create-dirs https://example.org/path#part";

	// Действие
	Контекст = КонтекстИзСтроки(Текст);

	// Проверка
	Операция = Контекст.Операции()[0];
	Ожидаем.Что(Операция.Ресурс().Фрагмент()).Равно("part");
	Ожидаем.Что(Операция.Запрос().ЯвныйМетод().ЛитеральноеЗначение()).Равно("PATCH");
	Ожидаем.Что(Операция.Запрос().Аутентификация().УчетныеДанные().Пользователь()).Равно("user");
	Ожидаем.Что(Операция.Запрос().Аутентификация().Способы()[0].Вид()).Равно("digest");
	Часть = Операция.Запрос().Тело().Части()[0];
	Ожидаем.Что(Часть.ИмяПоля()).Равно("upload");
	Ожидаем.Что(Часть.ИмяФайла()).Равно("report.txt");
	Ожидаем.Что(Часть.MIMEТип()).Равно("text/plain");
	Ожидаем.Что(Часть.Заголовки()[0].Имя()).Равно("X-Part");
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно("data.txt");
	Ожидаем.Что(Операция.Соединение().Прокси().Порт()).Равно(8080);
	Ожидаем.Что(Операция.Соединение().Прокси().УчетныеДанные().Пользователь()).Равно("proxy");
	Ожидаем.Что(Операция.Соединение().Прокси().СпособыАутентификации()[0].Вид()).Равно("ntlm");
	Ожидаем.Что(Операция.Соединение().TLS().СертификатКлиента().Путь()).Равно("client.pem");
	Ожидаем.Что(Операция.Соединение().TLS().СертификатКлиента().Пароль()).Равно("password");
	Ожидаем.Что(Операция.Соединение().TLS().ИспользоватьСистемноеХранилище()).Равно(Истина);
	Ожидаем.Что(Операция.Соединение().TLS().СертификатыУдостоверяющегоЦентра().ЛитеральноеЗначение()).Равно("ca.pem");
	Ожидаем.Что(Операция.Соединение().Таймаут().Значение()).Равно(12500);
	Ожидаем.Что(Операция.Соединение().ТаймаутСоединения().Значение()).Равно(3000);
	Ожидаем.Что(Операция.Политики().Перенаправления().Следовать()).Равно(Истина);
	Ожидаем.Что(Операция.Политики().Повторы().Количество().Значение()).Равно(2);
	Ожидаем.Что(Операция.Политики().Повторы().МаксимальноеВремя().Значение()).Равно(10000);
	Ожидаем.Что(Операция.Результат().ИмяФайла().ЛитеральноеЗначение()).Равно("report.out");
	Ожидаем.Что(Операция.Результат().Каталог().ЛитеральноеЗначение()).Равно("result");
	Ожидаем.Что(Операция.Результат().СоздаватьКаталоги()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьOAuthПодписьИРазделители() Экспорт

	// Подготовка
	Текст = "curl --oauth2-bearer token --aws-sigv4 aws:amz:eu:test -G -d one -d two https://example.org/?q=0";

	// Действие
	Контекст = КонтекстИзСтроки(Текст);

	// Проверка
	Запрос = Контекст.Операции()[0].Запрос();
	Ожидаем.Что(Запрос.Аутентификация().OAuth2().Выражение().ЛитеральноеЗначение()).Равно("token");
	Ожидаем.Что(Запрос.Аутентификация().ПодписьAWSV4().Поставщик()).Равно("aws");
	Ожидаем.Что(Запрос.Аутентификация().ПодписьAWSV4().Регион()).Равно("eu");
	Ожидаем.Что(Запрос.СтрокаЗапроса().Части()).ИмеетДлину(2);
	Ожидаем.Что(Запрос.СтрокаЗапроса().Части()[0].Текст()).Равно("one");
	Ожидаем.Что(Запрос.СтрокаЗапроса().Части()[1].Текст()).Равно("two");
	Ожидаем.Что(Запрос.СтрокаЗапроса().РазделительПередПервойЧастью()).Равно("ampersand");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьДинамическийURLИИсходныйТокен() Экспорт

	// Подготовка
	Текст = "curl --url ""https://$HOST/path""";

	// Действие
	Контекст = КонтекстИзСтроки(Текст);

	// Проверка
	Ресурс = Контекст.Операции()[0].Ресурс();
	Ожидаем.Что(Ресурс.Протокол()).Равно(Неопределено);
	Ожидаем.Что(Ресурс.ИсходныйАдрес().ЛитеральноеЗначение()).Равно(Неопределено);
	Ожидаем.Что(Ресурс.ИсходныйАдрес().Фрагменты()[1].Значение).Равно("HOST");
	Ожидаем.Что(Ресурс.ИсходныйАдрес().Фрагменты()[1].Количество()).Равно(3);
	Ожидаем.Что(Ресурс.Источник().ОписаниеОпции().КаноническоеИмя()).Равно("url");
	Ожидаем.Что(Ресурс.ИсходныйАдрес().Источник().Значение()).Равно("https://$HOST/path");
	Ожидаем.Что(ТипЗнч(Ресурс.Источник())).Равно(Тип("ЭлементРазобраннойКомандыCURL"));
	Ожидаем.Что(Ресурс.ОтложеннаяКлассификация().Грамматика()).Равно("url");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтекстИзСтроки(Текст)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(Текст);
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Описание = Новый ОписаниеГенератораCURL(
		"test", "Тестовый", 1, КодыВозможностейГенератораCURL.Все());
	Возврат Новый КонтекстГенерацииКода(
		Результат.Выполнение().Операции(),
		"ru",
		Новый Соответствие,
		Описание.Идентификатор(),
		Описание.Возможности()
	);

КонецФункции



#КонецОбласти

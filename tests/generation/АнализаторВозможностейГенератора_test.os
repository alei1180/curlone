Процедура ТестДолжен_ПредупредитьОбОтсутствующейВозможности(Опции, Возможность) Экспорт

	// Подготовка
	Описание = ОписаниеБез(Возможность);
	Выполнение = Разобрать("curl " + Опции + " https://example.org");

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(Выполнение, Описание);

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Предупреждения()[0].ИдентификаторВозможности()).Равно(Возможность);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъяснитьПотерюПовторяющихсяЗаголовков() Экспорт

	// Подготовка
	Выполнение = Разобрать("curl -H 'X-Test: 1' -H 'x-test: 2' https://example.org");

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(
		Выполнение,
		ОписаниеБез("headers.repeated")
	);

	// Проверка
	Ожидаем.Что(Результат.Предупреждения()[0].Сообщение()).Равно(
		"Повторяющиеся заголовки не сохраняются. Останется только последнее значение."
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъяснитьУсловнуюПотерюПовторяющихсяЗаголовков() Экспорт

	// Подготовка
	Выполнение = Разобрать("curl --header @missing https://example.org");

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(
		Выполнение,
		ОписаниеБез("headers.repeated")
	);

	// Проверка
	Ожидаем.Что(Результат.Предупреждения()[0].Сообщение()).Равно(
		"После чтения источника могут обнаружиться повторяющиеся заголовки. "
			+ "Генератор сохранит только последнее значение."
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьВсеВозможностиБезВнутреннихКодов() Экспорт

	// Подготовка
	Описания = Новый ОписаниеНеподдерживаемыхВозможностейCURL;

	// Действие и Проверка
	Для Каждого Возможность Из КодыВозможностейГенератораCURL.Все() Цикл
		Сообщение = Описания.Предупреждение(Возможность, Ложь);

		Ожидаем.Что(Сообщение = "Часть команды не поддерживается и может быть потеряна.").Равно(Ложь);
		Ожидаем.Что(СтрНайти(Сообщение, Возможность)).Равно(0);
	КонецЦикла;

КонецПроцедуры


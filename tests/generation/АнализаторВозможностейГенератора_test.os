Процедура ТестДолжен_ОграничитьЗависимыеНастройкиДинамическогоURL(Адрес, Возможность, ЧислоПредупреждений) Экспорт

	// Подготовка
	Выполнение = Разобрать("curl """ + Адрес + """");

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(Выполнение, ОписаниеБез(Возможность));

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(ЧислоПредупреждений);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьСпособBearerИНастройкуТокена() Экспорт

	// Подготовка
	Операция = Разобрать("curl --oauth2-bearer token https://example.org").Операции()[0];
	Запрос = Операция.Запрос();
	Способы = Новый Массив;
	Способы.Добавить(Новый СпособАутентификацииCURL(
		СпособыАутентификацииCURL.OAuth2Bearer(), Запрос.Аутентификация().OAuth2().Источник()));
	Аутентификация = Новый АутентификацияCURL(Неопределено, Способы, Неопределено, Неопределено);
	Запрос = Новый ЗапросCURL(
		Запрос.ЯвныйМетод(),
		Запрос.МетодПоУмолчанию(),
		Запрос.ПереноситьДанныеВURL(),
		Запрос.НеПолучатьТело(),
		Запрос.ТолькоИменаПриПеречислении(),
		Запрос.СтрокаЗапроса(),
		Запрос.Заголовки(),
		Запрос.Тело(),
		Аутентификация);
	Операции = Новый Массив;
	Операции.Добавить(Новый ОперацияCURL(
		Операция.Ресурс(), Запрос, Операция.Соединение(), Операция.Политики(), Операция.Результат()));
	Выполнение = Новый ОписаниеВыполненияCURL(Операции);
	Анализатор = Новый АнализаторВозможностейГенератора;

	// Действие
	БезСпособа = Анализатор.Анализировать(Выполнение, ОписаниеБез("auth.oauth2_bearer"));
	БезТокена = Анализатор.Анализировать(Выполнение, ОписаниеБез("auth.oauth2"));

	// Проверка
	Ожидаем.Что(БезСпособа.Предупреждения()).ИмеетДлину(1);
	Ожидаем.Что(БезСпособа.Предупреждения()[0].ИдентификаторВозможности()).Равно("auth.oauth2_bearer");
	Ожидаем.Что(БезТокена.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеТребоватьНеиспользуемыеВозможностиКаталога() Экспорт

	// Подготовка
	Выполнение = Разобрать("curl https://example.org");
	Анализатор = Новый АнализаторВозможностейГенератора;

	Для Каждого Возможность Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Возможность = "protocol.https" Тогда
			Продолжить;
		КонецЕсли;

		// Действие
		Результат = Анализатор.Анализировать(Выполнение, ОписаниеБез(Возможность));

		// Проверка
		Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
		Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеБез(Исключенная)

	Возможности = Новый Массив;
	Для Каждого Идентификатор Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Идентификатор <> Исключенная Тогда
			Возможности.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ОписаниеГенератораCURL(
		"test", "Тестовый", 1, Новый ФиксированныйМассив(Возможности));

КонецФункции

Функция Разобрать(Текст)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(Текст);
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Возврат Результат.Выполнение();

КонецФункции

#КонецОбласти

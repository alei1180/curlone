Процедура ТестДолжен_ОтклонитьОтсутствующуюОбязательнуюВозможность(Текст, Возможность) Экспорт

	// Подготовка
	Выполнение = Разобрать(Текст);

	// Действие
	Результат = Новый АнализаторВозможностейГенератора().Анализировать(
		Выполнение, ОписаниеБез(Возможность));

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(Выполнение.Операции().Количество());
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		"curlone.generator.unrepresentable_semantics");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--ftp-port address", "ftp.active")
&ИсточникЗначение("--ftp-pasv", "ftp.passive")
Процедура ТестДолжен_ТребоватьРежимFTPТолькоДляFTP(Опции, Возможность) Экспорт

	// Подготовка
	Анализатор = Новый АнализаторВозможностейГенератора;
	Описание = ОписаниеБез(Возможность);
	FTP = Разобрать("curl " + Опции + " ftp://example.org");
	HTTP = Разобрать("curl " + Опции + " https://example.org");

	// Действие
	РезультатFTP = Анализатор.Анализировать(FTP, Описание);
	РезультатHTTP = Анализатор.Анализировать(HTTP, Описание);

	// Проверка
	Ожидаем.Что(РезультатFTP.Предупреждения()).ИмеетДлину(1);
	Ожидаем.Что(РезультатFTP.Предупреждения()[0].ИдентификаторВозможности()).Равно(Возможность);
	Ожидаем.Что(РезультатHTTP.Предупреждения()).ИмеетДлину(0);

КонецПроцедуры


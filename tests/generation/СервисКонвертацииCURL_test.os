#Область Тесты

&Тест
Процедура ТестДолжен_ПередатьГенераторуИсходныеПараметры() Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL("ИзменитьПараметры");
	Сервис = СоздатьСервис(Генератор);
	Параметры = СоздатьПараметры("curl https://example.org");
	Вложения = Новый Массив;
	Параметры.ПараметрыГенератора.Вставить("Вложения", Вложения);
	Параметры.ПараметрыГенератора.Вставить("Объект", Новый ТаблицаЗначений);
	Параметры.ПараметрыГенератора.Вставить("Цикл", Параметры.ПараметрыГенератора);

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Параметры.ПараметрыГенератора["Результат"]).Равно("готово");
	Ожидаем.Что(Вложения[0]).Равно("добавлено");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СгенерироватьКодДляСтрокиИАргументов() Экспорт

	Для Каждого Команда Из Команды() Цикл
		// Подготовка
		Генератор = Новый СторонняяЦельДляТестовCURL;
		Сервис = СоздатьСервис(Генератор);

		// Действие
		Результат = Сервис.Конвертировать(СоздатьПараметры(Команда));

		// Проверка
		Ожидаем.Что(Результат.Успешно()).Равно(Истина);
		Ожидаем.Что(Результат.Код()).Равно(
			"target=third-party-test;locale=ru;url=https://example.org;parameters=0");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьНазваниеКомандыИзАнглийскогоПакетаРесурсов() Экспорт

	// Подготовка
	Сервис = СоздатьСервис(Новый СторонняяЦельДляТестовCURL);
	Параметры = СоздатьПараметры("curl https://one.example.org & curl https://two.example.org");
	Параметры.Локаль = "en";
	ОжидаемыйКод = "//////////////////////////////////////////////
	|// Command #1.
	|
	|target=third-party-test;locale=en;url=https://one.example.org;parameters=0
	|
	|//////////////////////////////////////////////
	|// Command #2.
	|
	|target=third-party-test;locale=en;url=https://two.example.org;parameters=0";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьСнимокРеестра() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый СторонняяЦельДляТестовCURL);
	Сервис = Новый СервисКонвертацииCURL(Реестр);
	Реестр.Зарегистрировать(Новый СторонняяЦельДляТестовCURL("Код", "later"));
	Параметры = СоздатьПараметры("curl https://example.org");
	Параметры.Цель = "later";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НеизвестныйГенератор());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьОшибкуНеизвестнойЦели() Экспорт

	// Подготовка
	Сервис = СоздатьСервис(Новый СторонняяЦельДляТестовCURL);
	Параметры = СоздатьПараметры("curl https://example.org");
	Параметры.Цель = "missing";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НеизвестныйГенератор());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Число")
&ИсточникЗначение("Пусто")
Процедура ТестДолжен_ОтклонитьНеверныйРезультатГенератора(Режим) Экспорт

	// Подготовка
	Сервис = СоздатьСервис(Новый СторонняяЦельДляТестовCURL(Режим));

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры("curl https://example.org"));

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НарушенКонтрактГенератора());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПредупрежденияПриОшибкеГенератора() Экспорт

	// Подготовка
	Возможности = Новый Массив;
	Для Каждого Возможность Из КодыВозможностейГенератораCURL.Все() Цикл
		Если Возможность <> "retry.count" Тогда
			Возможности.Добавить(Возможность);
		КонецЕсли;
	КонецЦикла;
	Генератор = Новый СторонняяЦельДляТестовCURL(
		"Исключение", "third-party-test", Новый ФиксированныйМассив(Возможности));
	Сервис = СоздатьСервис(Генератор);

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры(
		"curl --retry 1 https://example.org"));

		// Проверка
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Предупреждения()[0].ИдентификаторВозможности()).Равно("retry.count");

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноОбернутьИсключениеГенератора() Экспорт

	// Подготовка
	Сервис = СоздатьСервис(Новый СторонняяЦельДляТестовCURL("Исключение"));

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры("curl https://example.org"));

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.ОшибкаГенератора());
	Ожидаем.Что(СтрНайти(Результат.Диагностика()[0].Сообщение, "секрет")).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПроверкиЭтапов

&Тест
Процедура ТестДолжен_СкрытьПричинуВнутреннейОшибкиВПубличнойДиагностике() Экспорт

	// Подготовка
	Попытка
		ВызватьИсключение "секрет-внутреннего-этапа";
	Исключение
		Причина = ИнформацияОбОшибке();
	КонецПопытки;

	// Действие
	Ошибка = Новый ФабрикаОшибокГенерацииCURL().Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		"Внутренняя ошибка конвертации", Неопределено, Причина);
	Ошибки = Новый Массив;
	Ошибки.Добавить(Ошибка);
	Результат = Новый РезультатКонвертацииCURL("", Ошибки);

	// Проверка
	Ожидаем.Что(Результат.Диагностика()[0].Код).Равно("internal.invariant_violation");
	Ожидаем.Что(СтрНайти(Результат.Диагностика()[0].Сообщение, "секрет")).Равно(0);
	Ожидаем.Что(СтрНайти(ДиагностикаОшибок.ДиагностическоеПредставление(Ошибка), "секрет") > 0).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередатьЗарегистрированныеВозможностиПослеИзмененияМетаданных() Экспорт

	// Подготовка
	Возможности = Новый Массив;
	Возможности.Добавить("protocol.https");
	Генератор = Новый СторонняяЦельДляТестовCURL(
		"Возможности", "third-party-test", Новый ФиксированныйМассив(Возможности));
	Сервис = СоздатьСервис(Генератор);
	Генератор.ИзменитьВозможности(Новый ФиксированныйМассив(Новый Массив));

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры("curl https://example.org"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Код()).Равно("protocol.https");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("curl 'unterminated")
&ИсточникЗначение("curl --unknown-option https://example.org")
&ИсточникЗначение("curl --max-time invalid https://example.org")
Процедура ТестДолжен_ОстановитьсяДоГенерацииПриОшибкеЭтапа(Команда) Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL;
	Сервис = СоздатьСервис(Генератор);

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры(Команда));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Код()).Равно("");
	Ожидаем.Что(Генератор.Вызовов()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОстановитьсяПослеАнализаИСохранитьПредупреждения() Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL(
		"Код", "third-party-test", Новый ФиксированныйМассив(Новый Массив));
	Сервис = СоздатьСервис(Генератор);

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры("curl --retry 1 https://example.org"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Предупреждения()).ИмеетДлину(1);
	Ожидаем.Что(Генератор.Вызовов()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьГенераторОдинРазДляВсехОпераций() Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL;
	Сервис = СоздатьСервис(Генератор);

	// Действие
	Результат = Сервис.Конвертировать(СоздатьПараметры("curl https://one.example.org https://two.example.org"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Генератор.Вызовов()).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСервис(Генератор)
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Генератор);
	Возврат Новый СервисКонвертацииCURL(Реестр);
КонецФункции

Функция СоздатьПараметры(Команда)
	Параметры = Новый ПараметрыКонвертацииCURL(Команда);
	Параметры.Цель = "third-party-test";
	Возврат Параметры;
КонецФункции

Функция Команды()
	Результат = Новый Массив;
	Результат.Добавить("curl https://example.org");
	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	Аргументы.Добавить("https://example.org");
	Результат.Добавить(Аргументы);
	Возврат Результат;
КонецФункции

#КонецОбласти

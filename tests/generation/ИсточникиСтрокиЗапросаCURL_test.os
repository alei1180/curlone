#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("--data @missing.txt", "text_file_without_crlf_nul")
&ИсточникЗначение("--data-binary @missing.bin", "binary_file")
&ИсточникЗначение("--data-urlencode name@missing.txt", "binary_file")
Процедура ТестДолжен_СохранитьРежимЧтенияПриПереносеДанныхВURL(Опции, Режим) Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -G " + Опции + " http://example.org");

	// Действие
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	Часть = Результат.Выполнение().Операции()[0].Запрос().СтрокаЗапроса().Части()[0];
	Ожидаем.Что(Часть.РежимИсточника()).Равно(Режим);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СообщитьОбУдаленииCRLFNULИзФайлаПриФормированииQuery() Экспорт

	// Подготовка
	Путь = ПолучитьИмяВременногоФайла();
	ПолучитьДвоичныеДанныеИзHexСтроки("610D0A0062").Записать(Путь);
	Команда = Новый КомандыДляТестовCURL().ИзСтроки("curl -G --data '@" + Путь + "' http://example.org");
	Модель = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Части = Модель.Операции()[0].Запрос().СтрокаЗапроса().Части();
	Строки = Новый ПостроительКодаCURL;
	Выражения = Новый ГенераторВыраженийCURL(ЛокалиКонвертацииCURL.Русская(), Новый Соответствие);
	Генератор = Новый ФормированиеТелаHTTPЗапросаCURL(Выражения);

	// Действие
	Попытка

		Генератор.ДобавитьСтрокуЗапроса(
			Строки,
			Части,
			КодыВозможностейГенератораCURL.Все()
		);
		Код = Строки.ПолучитьРезультат();

	Исключение
		УдалитьФайлы(Путь);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(Путь);

	// Проверка
	Ожидаем.Что(Код).Содержит(
		"// Требуется дополнительная обработка. Удалите байты NUL, CR и LF из ДанныеЧасти."
	);
	Ожидаем.Что(СтрНайти(Код, "ОчищенныеДанные")).Равно(0);

КонецПроцедуры

#КонецОбласти

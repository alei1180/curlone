#Использовать asserts
#Использовать errors
#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("parameters_key")
&ИсточникЗначение("parameters_object")
&ИсточникЗначение("parameters_cycle")
Процедура ТестДолжен_ПередатьПараметрыБезОбходаЗначений(Случай) Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL;
	Сервис = СоздатьСервис(Генератор);
	Параметры = ПараметрыСОшибкой(Случай);

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Генератор.Вызовов()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("command_null", "argument.invalid_type")
Процедура ТестДолжен_ОтклонитьНеопределеннуюКоманду(Случай, КодОшибки) Экспорт

	// Подготовка
	Генератор = Новый СторонняяЦельДляТестовCURL;
	Сервис = СоздатьСервис(Генератор);
	Параметры = ПараметрыСОшибкой(Случай);

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(КодОшибки);
	Ожидаем.Что(Результат.Код()).Равно("");
	Ожидаем.Что(Генератор.Вызовов()).Равно(0);
	Цель = ?(ТипЗнч(Параметры.Цель) = Тип("Строка"), Параметры.Цель, "");
	Ожидаем.Что(Результат.ИдентификаторГенератора()).Равно(Цель);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИдентификаторНеизвестнойЦели() Экспорт

	// Подготовка
	Сервис = СоздатьСервис(Новый СторонняяЦельДляТестовCURL);
	Параметры = ПараметрыСОшибкой("");
	Параметры.Цель = "missing-target";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.ИдентификаторГенератора()).Равно("missing-target");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		"curlone.generator.unknown");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокИСкрытьСекретыПриОтказеГенератора() Экспорт

	// Подготовка
	Возможности = Новый Массив;
	Возможности.Добавить("protocol.https");
	Генератор = Новый СторонняяЦельДляТестовCURL(
		"Исключение", "third-party-test", Новый ФиксированныйМассив(Возможности));
	Сервис = СоздатьСервис(Генератор);
	Параметры = ПараметрыСОшибкой("");
	Параметры.Команда = "curl -H 'X-Secret: secret-header' --data secret-body --data @secret-file "
		+ "--user secret-user:secret-pass https://secret-host.example/secret-path";

	// Действие
	Результат = Сервис.Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Код()).Равно("");
	Ожидаем.Что(Генератор.Вызовов()).Равно(1);
	Диагностика = Результат.Диагностика();
	Ожидаем.Что(Диагностика).ИмеетДлину(5);
	Ожидаем.Что(Диагностика[0].Код).Равно("curlone.generator.failed");
	Порядок = СтрРазделить("headers.ordered|body.data|input.file|auth.credentials", "|");
	Для Индекс = 0 По Порядок.Количество() - 1 Цикл
		Ожидаем.Что(Диагностика[Индекс + 1].ИдентификаторВозможности).Равно(Порядок[Индекс]);
	КонецЦикла;
	Для Каждого Элемент Из Диагностика Цикл
		Ожидаем.Что(СтрНайти(Элемент.Сообщение, "secret")).Равно(0);
		Ожидаем.Что(СтрНайти(Элемент.Сообщение, "секрет")).Равно(0);
	КонецЦикла;
	Техническое = ДиагностикаОшибок.ДиагностическоеПредставление(Результат.Ошибки()[0]);
	Ожидаем.Что(СтрНайти(Техническое, "секрет-вложенного-исключения") > 0).Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьСервис(Генератор)

	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Генератор);
	Возврат Новый СервисКонвертацииCURL(Реестр);

КонецФункции

Функция ПараметрыСОшибкой(Случай)

	Параметры = Новый ПараметрыКонвертацииCURL("curl https://example.org");
	Параметры.Цель = "third-party-test";
	Если Случай = "command_null" Тогда
		Параметры.Команда = Неопределено;
	ИначеЕсли Случай = "command_number" Тогда
		Параметры.Команда = 1;
	ИначеЕсли Случай = "command_empty" Тогда
		Параметры.Команда = "";
	ИначеЕсли Случай = "command_spaces" Тогда
		Параметры.Команда = "  ";
	ИначеЕсли Случай = "argv_empty" Или Случай = "argv_number" Тогда
		Параметры.Команда = Новый Массив;
		Если Случай = "argv_number" Тогда
			Параметры.Команда.Добавить(1);
		КонецЕсли;
	ИначеЕсли Случай = "target_number" Тогда
		Параметры.Цель = 1;
	ИначеЕсли Случай = "target_empty" Тогда
		Параметры.Цель = "";
	ИначеЕсли Случай = "locale_number" Тогда
		Параметры.Локаль = 1;
	ИначеЕсли Случай = "locale_empty" Тогда
		Параметры.Локаль = "";
	ИначеЕсли Случай = "locale_unknown" Тогда
		Параметры.Локаль = "fr";
	ИначеЕсли Случай = "parameters_null" Тогда
		Параметры.ПараметрыГенератора = Неопределено;
	ИначеЕсли Случай = "parameters_key" Тогда
		Параметры.ПараметрыГенератора.Вставить(1, "value");
	ИначеЕсли Случай = "parameters_object" Тогда
		Параметры.ПараметрыГенератора.Вставить("object", Новый Рефлектор);
	ИначеЕсли Случай = "parameters_cycle" Тогда
		Параметры.ПараметрыГенератора.Вставить("self", Параметры.ПараметрыГенератора);
	КонецЕсли;
	Возврат Параметры;

КонецФункции

#КонецОбласти


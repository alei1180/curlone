#Область Тесты

&Тест
Процедура ТестДолжен_ПрименитьСокращенныйСнимокВозможностей() Экспорт

	// Подготовка
	Команда = Новый КомандыДляТестовCURL().ИзСтроки(
		"curl -X PATCH -H 'X-Test: value' -d secret --user alice:pass http://example.org"
	);
	Выполнение = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение();
	Возможности = Новый ФиксированныйМассив(СтрРазделить("protocol.http,operations.multiple", ","));
	Контекст = Новый КонтекстГенерацииКода(
		Выполнение.Операции(), "ru", Новый Соответствие, "connector", Возможности
	);
	ОжидаемыйКод = "Адрес = ""http://example.org/"";
	|Заголовки = Новый Соответствие;
	|ДанныеЗапроса = Неопределено;
	|ПараметрыЗапроса = Новый Структура;
	|ПараметрыЗапроса.Вставить(""Заголовки"", Заголовки);
	|ПараметрыЗапроса.Вставить(""Данные"", ДанныеЗапроса);
	|ПараметрыЗапроса.Вставить(""РазрешитьПеренаправление"", Ложь);
	|Результат = КоннекторHTTP.ВызватьМетод(""POST"", Адрес, ПараметрыЗапроса);";

	// Действие
	Код = Новый ГенераторКодаКоннектораCURL().Сгенерировать(Контекст);

	// Проверка
	Ожидаем.Что(Код).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьМетаданныеSPI() Экспорт

	// Подготовка
	Генератор = Новый ГенераторКодаКоннектораCURL;

	// Действие и Проверка
	Ожидаем.Что(Генератор.Идентификатор()).Равно("connector");
	Ожидаем.Что(Генератор.Наименование()).Равно("Коннектор HTTP");
	Ожидаем.Что(Генератор.ВерсияКонтракта()).Равно(1);
	Ожидаем.Что(ТипЗнч(Генератор.Возможности())).Равно(Тип("ФиксированныйМассив"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--ntlm")
&ИсточникЗначение("--negotiate")
Процедура ТестДолжен_ПередатьАутентификациюОСБезЯвногоПользователя(Опция) Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl " + Опция + " http://example.org");
	Параметры.Цель = "connector";
	ОжидаемыйКод = "Аутентификация = Новый Структура(""ИспользоватьАутентификациюОС"", Истина);
	|
	|ДополнительныеПараметры = Новый Структура();
	|ДополнительныеПараметры.Вставить(""Аутентификация"", Аутентификация);
	|
	|Результат = КоннекторHTTP.Get(""http://example.org"", , ДополнительныеПараметры);";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Ложь, "Get")
&ИсточникЗначение(Истина, "GetJson")
Процедура ТестДолжен_СформироватьПолныйКодGET(РазбиратьJSON, Метод) Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl http://example.org/items?q=%2F");
	Параметры.Цель = "connector";
	Параметры.ПараметрыГенератора.Вставить("ДесериализоватьОтветИзJSON", РазбиратьJSON);
	ОжидаемыйКод = "ПараметрыЗапроса = Новый Соответствие();
	|ПараметрыЗапроса.Вставить(""q"", ""/"");
	|
	|Результат = КоннекторHTTP." + Метод + "(""http://example.org/items"", ПараметрыЗапроса);";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьРезервноеИмяДляURLБезИмениФайла() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl http://example.com/ -O");
	Параметры.Цель = "connector";
	Параметры.Локаль = ЛокалиКонвертацииCURL.Русская();
	ОжидаемыйКод = "Результат = КоннекторHTTP.Get(""http://example.com"");
	|
	|ИмяФайлаОтвета = ""curl_response"";
	|ДанныеОтвета = Результат.ДвоичныеДанные();
	|ДанныеОтвета.Записать(ИмяФайлаОтвета);
	|Результат = ИмяФайлаОтвета;";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКодированиеДанныхПользователяВURL() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Параметры = Новый ПараметрыКонвертацииCURL("curl http://alice:p%40ss@example.com");
	Параметры.Цель = "connector";
	ОжидаемыйКод = "Результат = КоннекторHTTP.Get(""http://alice:p%40ss@example.com"");";

	// Действие
	Результат = Новый СервисКонвертацииCURL(Реестр).Конвертировать(Параметры);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
	Ожидаем.Что(Результат.Код()).Равно(ОжидаемыйКод);

КонецПроцедуры


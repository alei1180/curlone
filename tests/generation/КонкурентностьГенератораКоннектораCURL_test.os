#Использовать asserts
#Использовать errors
#Использовать "../../src/shared"
#Использовать "../../src/public"
#Использовать "../../src/generation"
#Использовать "../../src/generators/connector-http"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ИзолироватьЛокалиИДанныеПараллельныхВызовов() Экспорт

	// Подготовка
	Реестр = Новый РеестрГенераторовCURL;
	Реестр.Зарегистрировать(Новый ГенераторКодаКоннектораCURL);
	Сервис = Новый СервисКонвертацииCURL(Реестр);
	Контексты = Новый Массив;
	Задания = Новый Массив;
	Затвор = Новый БлокировкаРесурса(Контексты);

	Для Номер = 1 По 16 Цикл

		Маркер = "request" + СокрЛП(Строка(Номер));
		Команда = СтрШаблон(
			"curl -H 'X-Request: %1' --user '%1:password' --data-raw '%1=body' https://%1.example.org",
			Маркер
		);
		Параметры = Новый ПараметрыКонвертацииCURL(Команда);
		Параметры.Цель = "connector";
		Параметры.Локаль = ?(Номер % 2 = 0, "ru", "en");
		Параметры.ФорматДесериализацииОтвета = ?(
			Номер % 3 = 0,
			ФорматыДесериализацииОтветаCURL.JSON(),
			Неопределено
		);
		Эталон = Сервис.Конвертировать(Параметры);
		Ожидаем.Что(Эталон.Успешно()).ЭтоИстина();
		Ожидаем.Что(Эталон.Код()).Содержит(Маркер);

		Контексты.Добавить(Новый Структура(
			"Сервис, Параметры, Эталон, Затвор, Ошибка, Результаты",
			Сервис,
			Параметры,
			Эталон.Код(),
			Затвор,
			Неопределено,
			Новый Массив
		));

	КонецЦикла;

	// Действие
	Затвор.Заблокировать();

	Попытка

		Для Каждого Контекст Из Контексты Цикл

			Аргументы = Новый Массив;
			Аргументы.Добавить(Контекст);
			Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "КонвертироватьВФоне", Аргументы));

		КонецЦикла;

	Исключение
		Затвор.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Затвор.Разблокировать();

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Проверка
	Для Каждого Контекст Из Контексты Цикл

		Ожидаем.Что(Контекст.Ошибка).Равно(Неопределено);
		Ожидаем.Что(Контекст.Результаты).ИмеетДлину(3);

		Для Каждого Результат Из Контекст.Результаты Цикл
			Если Не Результат.Успешно() Тогда
				ВызватьИсключение Результат.Ошибки()[0];
			КонецЕсли;

			Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
			Ожидаем.Что(Результат.Код()).Равно(Контекст.Эталон);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Повторяет конвертацию после общего сигнала начала фоновых вызовов.
//
// Параметры:
//   Контекст - Структура - Сервис, параметры, затвор и результаты одного фонового задания.
Процедура КонвертироватьВФоне(Контекст) Экспорт

	Попытка

		Контекст.Затвор.Заблокировать();
		Контекст.Затвор.Разблокировать();

		Для Номер = 1 По 3 Цикл
			Контекст.Результаты.Добавить(Контекст.Сервис.Конвертировать(Контекст.Параметры));
		КонецЦикла;

	Исключение
		Контекст.Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

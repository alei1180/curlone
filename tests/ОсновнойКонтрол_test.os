#Использовать 1connector
#Использовать packageinfo

Перем ПроцессВебСервера; // Процесс

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередВсеми
Процедура ЗапуститьВебСервер() Экспорт

	ПроцессВебСервера = СоздатьПроцесс("oscript src/main.os web", ".");
	ПроцессВебСервера.Запустить();

	НачатьОжиданиеЗапуска();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьВебСервер() Экспорт

	Если Не ПроцессВебСервера = Неопределено И Не ПроцессВебСервера.Завершен Тогда
		ПроцессВебСервера.Завершить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ОтображатьСсылкуНаВерсиюИзPackagedef() Экспорт

	// Подготовка
	ВерсияПриложения = Новый ИнформацияОПакете("packagedef").Версия();
	ОжидаемаяСсылкаНаВерсию = "https://github.com/alei1180/curlone/releases/tag/ver" + ВерсияПриложения;

	// Действие
	ТекстСтраницы = КоннекторHTTP.Get(URL()).Текст();
	СценарийСтраницы = КоннекторHTTP.Get(URL() + "/static/index.js").Текст();

	// Проверка
	Ожидаем.Что(ТекстСтраницы, "Версия приложения на главной странице").Содержит("ver " + ВерсияПриложения);
	Ожидаем.Что(ТекстСтраницы, "Ссылка на выпуск на главной странице").Содержит(ОжидаемаяСсылкаНаВерсию);
	Ожидаем.Что(ТекстСтраницы, "Отключённые элементы формы до появления API v2").Содержит("disabled");
	Ожидаем.Что(СтрНайти(СценарийСтраницы, "/api/v1"), "Ссылка на API v1 в сценарии страницы").Равно(0);
	Ожидаем.Что(СтрНайти(СценарийСтраницы, "fetch("), "Прямой HTTP-запрос из сценария страницы").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПубликоватьУдаленныеМаршрутыAPIv1() Экспорт

	Пути = Новый Массив;
	Пути.Добавить("/api");
	Пути.Добавить("/api/v1");
	Пути.Добавить("/api/v1/convert");

	Для Каждого Путь Из Пути Цикл
		// Действие
		Ответ = КоннекторHTTP.Get(URL() + Путь);

		// Проверка
		Ожидаем.Что(Ответ.КодСостояния, "Код ответа отсутствующего маршрута " + Путь).Равно(404);
	КонецЦикла;

	// Действие
	ОтветPOST = КоннекторHTTP.Post(URL() + "/api/v1/convert", "");

	// Проверка
	Ожидаем.Что(ОтветPOST.КодСостояния, "Код POST-ответа удалённого маршрута конвертации").Равно(404);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура НачатьОжиданиеЗапуска()

	ЗадержкаМеждуПопытками = 100; // Миллисекунд
	ТаймаутОжидания = 15; // Секунд
	ВремяНачала = ТекущаяУниверсальнаяДата();

	Пока Истина Цикл

		Если ПроцессВебСервера.Завершен Тогда
			ВызватьИсключение СтрШаблон(
				"Веб-сервер завершился во время запуска с кодом %1.",
				ПроцессВебСервера.КодВозврата
			);
		КонецЕсли;

		КодСостояния = Неопределено;
		ТекстИсключения = "";
		Попытка
			Ответ = КоннекторHTTP.Head(URL(), Новый Структура("Таймаут", ТаймаутОжидания));
			КодСостояния = Ответ.КодСостояния;
		Исключение
			ТекстИсключения = СокрП(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ТекстИсключения = СтрПолучитьСтроку(ТекстИсключения, СтрЧислоСтрок(ТекстИсключения));
		КонецПопытки;

		Если КодСостояния = 200 Тогда
			Приостановить(ЗадержкаМеждуПопытками);
			Прервать;
		КонецЕсли;

		ПрошлоСекунд = ТекущаяУниверсальнаяДата() - ВремяНачала;
		Если ПрошлоСекунд > ТаймаутОжидания Или ЗначениеЗаполнено(КодСостояния) Тогда
			ВызватьИсключение СтрШаблон(
				"Не удалось запустить веб-сервер в течение %1 сек.: %2",
				ТаймаутОжидания,
				ТекстИсключения
			);
		КонецЕсли;

		Приостановить(ЗадержкаМеждуПопытками);

	КонецЦикла;

КонецПроцедуры

Функция URL()

	Возврат "http://127.0.0.1:3333";

КонецФункции

#КонецОбласти

#Использовать "../../../src/syntax"

#Область ПрограммныйИнтерфейс

// Разбирает готовый список аргументов без обработки кавычек командной оболочки.
//
// Параметры:
//  Аргументы - Массив из Строка - аргументы, включая имя команды.
//
// Возвращаемое значение:
//  РазобраннаяКомандаCURL - разобранная команда.
//
// Исключения:
//  argument.invalid_type - неверный тип массива или его элемента.
//
Функция ИзАргументов(Аргументы) Экспорт

	ТокеныКоманды = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены();
	Возврат Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды).Команда();

КонецФункции

// Разбирает текст команды через лексер, сохраняя кавычки и переменные.
//
// Параметры:
//  Текст - Строка - полный текст команды.
//
// Возвращаемое значение:
//  РазобраннаяКомандаCURL - разобранная команда.
//
// Исключения:
//  argument.invalid_type - текст команды имеет неверный тип.
//
Функция ИзСтроки(Текст) Экспорт

	ТокеныКоманды = Новый ЛексерКомандыCURL().Разобрать(Текст).Токены();
	Возврат Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды).Команда();

КонецФункции

// Создает источник URL из одного готового аргумента.
//
// Параметры:
//  Значение - Строка - URL без обработки кавычек и переменных.
//
// Возвращаемое значение:
//  ЭлементРазобраннойКомандыCURL - источник значения.
//
// Исключения:
//  argument.invalid_type - значение URL имеет неверный тип.
//
Функция ИсточникURL(Значение) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Значение);
	Токен = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены()[0];
	Возврат СоздательЭлементовРазобраннойКомандыCURL.URL(Токен);

КонецФункции

// Создает источник опции из готового аргумента, включая пустые строки и знак "|".
//
// Параметры:
//  Имя - Строка - имя опции с префиксом "--".
//  Значение - Строка - значение опции.
//
// Возвращаемое значение:
//  ЭлементРазобраннойКомандыCURL - источник значения.
//
// Исключения:
//  argument.invalid_type - имя или значение опции имеет неверный тип.
//
Функция ИсточникОпции(Имя, Значение) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	Аргументы.Добавить(Имя);
	Аргументы.Добавить(Значение);
	Аргументы.Добавить("example.org");
	Возврат ИзАргументов(Аргументы).Элементы()[0];

КонецФункции

#КонецОбласти

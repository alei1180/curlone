// Регистрирует событие ДобавитьЧастьТела.
//
// Параметры:
//   Часть - ЧастьТелаЗапросаCURL - Часть события.
Процедура ДобавитьЧастьТела(Часть) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Часть);
	_События.Добавить(Новый ФиксированнаяСтруктура("Имя, Аргументы",
		"ДобавитьЧастьТела", Новый ФиксированныйМассив(Аргументы)));

КонецПроцедуры

#КонецОбласти


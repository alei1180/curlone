Перем _События; // Массив из ФиксированнаяСтруктура: Имя (Строка), Аргументы (ФиксированныйМассив)

#Область ОбработчикиСобытий

// Создаёт получатель семантических событий для тестов.
Процедура ПриСозданииОбъекта()

	_События = Новый Массив;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает зафиксированные события в порядке вызовов.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - Имя и аргументы каждого вызова.
Функция События() Экспорт

	Возврат Новый ФиксированныйМассив(_События);

КонецФункции

// Регистрирует событие ДобавитьURL.
//
// Параметры:
//   Элемент - ЭлементРазобраннойКомандыCURL - Элемент события.
Процедура ДобавитьURL(Элемент) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Элемент);
	_События.Добавить(Новый ФиксированнаяСтруктура("Имя, Аргументы",
		"ДобавитьURL", Новый ФиксированныйМассив(Аргументы)));

КонецПроцедуры


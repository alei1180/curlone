#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("X-Test: value", "Установить", "X-Test", " value", "")
&ИсточникЗначение("X-Test:", "Удалить", "X-Test", "", "")
&ИсточникЗначение("X-Test;", "ПередатьПустой", "X-Test", "", "")
&ИсточникЗначение("@headers.txt", "ЗагрузитьИзФайла", "", "", "headers.txt")
&ИсточникЗначение("@-", "ЗагрузитьИзСтандартногоВвода", "", "", "")
Процедура ТестДолжен_КлассифицироватьЛитеральныйЗаголовок(
	Текст,
	ИмяДействия,
	Имя,
	Значение,
	ПутьКФайлу
) Экспорт

	// Подготовка
	Источник = ИсточникОпции("--header", Текст);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Результат = Новый КлассификаторЗаголовкаCURL().Классифицировать(Выражение, Источник);
	Операция = Результат.Значение();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Операция.Действие()).Равно(ДействиеПоИмени(ИмяДействия));
	Ожидаем.Что(Операция.Выражение()).Равно(Выражение);
	Ожидаем.Что(Операция.Имя()).Равно(ПустоеКакНеопределено(Имя));
	Ожидаем.Что(Операция.Значение()).Равно(ПустоеКакНеопределено(Значение));
	Ожидаем.Что(Операция.ПутьКФайлу()).Равно(ПустоеКакНеопределено(ПутьКФайлу));
	Ожидаем.Что(Операция.ТребуетРазбора()).Равно(Ложь);
	Ожидаем.Что(Операция.Источник()).Равно(Источник);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьДинамическийЗаголовок() Экспорт

	// Подготовка
	Источник = ИсточникОпцииИзСтроки("--header", """X-$NAME: $VALUE""");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Операция = Новый КлассификаторЗаголовкаCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Операция.Действие()).Равно(ДействияНадЗаголовкамиCURL.ОпределитьПослеВычисления());
	Ожидаем.Что(Операция.ОтложеннаяКлассификация().Грамматика()).Равно(ГрамматикиЗначенийCURL.Заголовок());
	Ожидаем.Что(Операция.ТребуетРазбора()).Равно(Истина);
	Ожидаем.Что(Операция.Имя()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("curl|--user-agent|curlone|example.org", "УстановитьЕслиОтсутствует", "curlone")
&ИсточникЗначение("curl|--user-agent||example.org", "Удалить", "")
Процедура ТестДолжен_КлассифицироватьПользовательскийАгент(Команда, ИмяДействия, Значение) Экспорт

	// Подготовка
	Источник = РазобратьКоманду(Команда).Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Операция = Новый КлассификаторЗаголовкаCURL().КлассифицироватьПользовательскийАгент(
		Выражение,
		Источник
	).Значение();

	// Проверка
	Ожидаем.Что(Операция.Действие()).Равно(ДействиеПоИмени(ИмяДействия));
	Ожидаем.Что(Операция.Имя()).Равно("User-Agent");
	Ожидаем.Что(Операция.Значение()).Равно(ПустоеКакНеопределено(Значение));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьДинамическийПользовательскийАгент() Экспорт

	// Подготовка
	Источник = ИсточникОпцииИзСтроки("--user-agent", """$AGENT""");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Операция = Новый КлассификаторЗаголовкаCURL().КлассифицироватьПользовательскийАгент(
		Выражение,
		Источник
	).Значение();

	// Проверка
	Ожидаем.Что(Операция.Действие()).Равно(ДействияНадЗаголовкамиCURL.ОпределитьПослеВычисления());
	Ожидаем.Что(Операция.ОтложеннаяКлассификация().Грамматика()).Равно(
		ГрамматикиЗначенийCURL.ПользовательскийАгент()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьУсловныеJSONЗаголовкиПослеЯвногоИсточника() Экспорт

	// Подготовка
	ИсточникЗаголовка = ИсточникОпции("--header", "@headers.txt");
	ИсточникJSON = ИсточникОпции("--json", "{}");
	Классификатор = Новый КлассификаторЗаголовкаCURL();
	ЯвнаяОперация = Классификатор.Классифицировать(
		Новый ВыражениеЗначенияCURL(ИсточникЗаголовка.ТокенЗначения()),
		ИсточникЗаголовка
	).Значение();

	// Действие
	Операции = Новый Массив;
	Операции.Добавить(ЯвнаяОперация);
	Операции.Добавить(Классификатор.АвтоматическийJSON("Content-Type", "application/json", ИсточникJSON));
	Операции.Добавить(Классификатор.АвтоматическийJSON("Accept", "application/json", ИсточникJSON));

	// Проверка
	Ожидаем.Что(Операции).ИмеетДлину(3);
	Ожидаем.Что(Операции[0].Действие()).Равно(ДействияНадЗаголовкамиCURL.ЗагрузитьИзФайла());
	Для Индекс = 1 По 2 Цикл
		Ожидаем.Что(Операции[Индекс].Действие()).Равно(
			ДействияНадЗаголовкамиCURL.УстановитьЕслиОтсутствует()
		);
		Ожидаем.Что(Операции[Индекс].Выражение()).Равно(Неопределено);
		Ожидаем.Что(Операции[Индекс].Источник()).Равно(ИсточникJSON);
	КонецЦикла;
	Ожидаем.Что(Операции[1].Имя()).Равно("Content-Type");
	Ожидаем.Что(Операции[2].Имя()).Равно("Accept");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсточникОпции(ИмяОпции, Значение)

	Возврат Новый КомандыДляТестовCURL().ИсточникОпции(ИмяОпции, Значение);

КонецФункции

Функция ИсточникОпцииИзСтроки(ИмяОпции, ЗначениеВСтроке)

	Возврат Новый КомандыДляТестовCURL().ИзСтроки("curl " + ИмяОпции + " " + ЗначениеВСтроке).Элементы()[0];

КонецФункции

Функция РазобратьКоманду(СтрокаАргументов)

	Аргументы = СтрРазделить(СтрокаАргументов, "|", Истина);
	Возврат Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);

КонецФункции

Функция ДействиеПоИмени(Имя)

	Возврат Вычислить("ДействияНадЗаголовкамиCURL." + Имя + "()");

КонецФункции

Функция ПустоеКакНеопределено(Значение)

	Возврат ?(Значение = "", Неопределено, Значение);

КонецФункции

#КонецОбласти


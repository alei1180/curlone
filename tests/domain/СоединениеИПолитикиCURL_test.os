#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("0", "non_negative_integer", 0)
&ИсточникЗначение("2147483647", "non_negative_integer", 2147483647)
&ИсточникЗначение("0", "non_negative_decimal", 0)
&ИсточникЗначение("1.2349", "non_negative_decimal", 1234)
&ИсточникЗначение("2147482.999", "non_negative_decimal", 2147482999)
Процедура ТестДолжен_КлассифицироватьПереносимоеЧисло(Текст, Формат, ОжидаемоеЗначение) Экспорт

	// Подготовка
	Источник = ИсточникURL(Текст);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(Выражение, Формат, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение().Значение()).Равно(ОжидаемоеЗначение);
	Ожидаем.Что(Результат.Значение().ТребуетВычисления()).Равно(Ложь);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("", "non_negative_decimal")
&ИсточникЗначение(".5", "non_negative_decimal")
&ИсточникЗначение("1.", "non_negative_decimal")
&ИсточникЗначение("1..2", "non_negative_decimal")
&ИсточникЗначение("2147483648", "non_negative_integer")
&ИсточникЗначение("2147483", "non_negative_decimal")
&ИсточникЗначение("-1", "non_negative_decimal")
&ИсточникЗначение("+1", "non_negative_decimal")
&ИсточникЗначение("1,2", "non_negative_decimal")
&ИсточникЗначение("NaN", "non_negative_decimal")
&ИсточникЗначение("Infinity", "non_negative_decimal")
&ИсточникЗначение("1x", "non_negative_decimal")
Процедура ТестДолжен_ОтклонитьНедопустимоеЧисло(Текст, Формат) Экспорт

	// Подготовка
	Источник = ИсточникURL(Текст);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(Выражение, Формат, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьКлассификациюЧисла() Экспорт

	// Подготовка
	Источник = ДинамическийИсточник("$TIMEOUT");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧисловогоЗначенияCURL().Классифицировать(
		Выражение,
		ФорматыЧисловыхЗначенийCURL.ДесятичноеНеотрицательное(),
		Источник
	);

	// Проверка
	Ожидаем.Что(Результат.Значение().Значение()).Равно(Неопределено);
	Ожидаем.Что(Результат.Значение().ТребуетВычисления()).Равно(Истина);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("C:/certs/client.pem:secret", "C:/certs/client.pem", "secret", Истина)
&ИсточникЗначение("C:/certs/client.pem", "C:/certs/client.pem", Неопределено, Ложь)
&ИсточникЗначение("C:/certs/client.pem:", "C:/certs/client.pem", "", Истина)
&ИсточникЗначение("client.pem:secret", "client.pem", "secret", Истина)
&ИсточникЗначение("client.pem", "client.pem", Неопределено, Ложь)
&ИсточникЗначение("C:\\cert.pem:secret", "C:\\cert.pem", "secret", Истина)
&ИсточникЗначение("client\:main.pem:secret", "client:main.pem", "secret", Истина)
&ИсточникЗначение("pkcs11:object=client", "pkcs11:object=client", Неопределено, Ложь)
Процедура ТестДолжен_КлассифицироватьСертификат(Текст, Путь, Пароль, ПарольУказан) Экспорт

	// Подготовка
	Источник = ИсточникURL(Текст);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторСертификатаCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Сертификат = Результат.Значение();
	Ожидаем.Что(Сертификат.Путь()).Равно(Путь);
	Ожидаем.Что(Сертификат.Пароль()).Равно(Пароль);
	Ожидаем.Что(Сертификат.ПарольУказан()).Равно(ПарольУказан);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("proxy.example", "http", "proxy.example", 1080, Неопределено)
&ИсточникЗначение("https://proxy.example:8443", "https", "proxy.example", 8443, Неопределено)
&ИсточникЗначение("socks5h://localhost/run/proxy.sock", "socks5h", "localhost", 1080, "/run/proxy.sock")
Процедура ТестДолжен_КлассифицироватьПрокси(
	Текст,
	Протокол,
	Сервер,
	Порт,
	ПутьUnixСокета
) Экспорт

	// Подготовка
	Источник = ИсточникURL(Текст);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторПроксиCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Прокси = Результат.Значение();
	Ожидаем.Что(Прокси.Режим()).Равно(РежимыПроксиCURL.Настроен());
	Ожидаем.Что(Прокси.Протокол()).Равно(Протокол);
	Ожидаем.Что(Прокси.Сервер()).Равно(Сервер);
	Ожидаем.Что(Прокси.Порт()).Равно(Порт);
	Ожидаем.Что(Прокси.ПутьUnixСокета()).Равно(ПутьUnixСокета);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличатьОтключенныйИДинамическийПрокси() Экспорт

	// Подготовка
	ПустойИсточник = ИсточникURL("");
	ДинамическийИсточник = ДинамическийИсточник("$PROXY");

	// Действие
	Пустой = Новый КлассификаторПроксиCURL().Классифицировать(
		Новый ВыражениеЗначенияCURL(ПустойИсточник.ТокенURL()), ПустойИсточник
	).Значение();
	Динамический = Новый КлассификаторПроксиCURL().Классифицировать(
		Новый ВыражениеЗначенияCURL(ДинамическийИсточник.ТокенURL()), ДинамическийИсточник
	).Значение();

	// Проверка
	Ожидаем.Что(Пустой.Режим()).Равно(РежимыПроксиCURL.Отключен());
	Ожидаем.Что(Динамический.Режим()).Равно(РежимыПроксиCURL.ОпределитьПослеВычисления());
	Ожидаем.Что(Динамический.ОтложеннаяКлассификация().Грамматика()).Равно(ГрамматикиЗначенийCURL.Прокси());

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьКодированныеУчетныеДанныеПрокси() Экспорт

	// Подготовка
	Источник = ИсточникURL("http://user%3Aname:pass%40word@proxy.example");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторПроксиCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Данные = Результат.Значение().УчетныеДанные();
	Ожидаем.Что(Данные.Пользователь()).Равно("user:name");
	Ожидаем.Что(Данные.Пароль()).Равно("pass@word");
	Ожидаем.Что(Данные.ПарольУказан()).Равно(Истина);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ftp://proxy.example")
&ИсточникЗначение("http://proxy.example/path")
&ИсточникЗначение("http://proxy.example?query")
&ИсточникЗначение("http://proxy.example#fragment")
&ИсточникЗначение("http://proxy.example:0")
&ИсточникЗначение("http://proxy.example:65536")

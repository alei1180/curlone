КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПолитикиПередачи() Экспорт

	// Подготовка
	Источник = ИсточникURL("--location");
	Количество = "число повторов";
	МаксимальноеВремя = "время повторов";

	// Действие
	Перенаправления = Новый ПолитикаПеренаправленийCURL(Истина, Источник);
	Повторы = Новый ПолитикаПовторовCURL(Количество, МаксимальноеВремя);

	// Проверка
	Ожидаем.Что(Перенаправления.Следовать()).Равно(Истина);
	Ожидаем.Что(Перенаправления.Источник()).Равно(Источник);
	Ожидаем.Что(Повторы.Количество()).Равно(Количество);
	Ожидаем.Что(Повторы.МаксимальноеВремя()).Равно(МаксимальноеВремя);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсточникURL(Значение)

	Возврат Новый КомандыДляТестовCURL().ИсточникURL(Значение);

КонецФункции

Функция ДинамическийИсточник(Значение)
	Токен = Новый ЛексерКомандыCURL().Разобрать("curl """ + Значение + """").Токены()[1];
	Возврат СоздательЭлементовРазобраннойКомандыCURL.URL(Токен);
КонецФункции

#КонецОбласти

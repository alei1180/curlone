#Область Тесты

&Тест
Процедура ТестДолжен_РазделитьСекцииКомандыИСброситьНастройки() Экспорт

	// Подготовка
	Команда = РазобратьКоманду("curl|--head|--remote-name-all|https://a.example|--next|https://b.example");

	// Действие
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Операции = Результат.Выполнение().Операции();
	Ожидаем.Что(Операции).ИмеетДлину(2);
	Ожидаем.Что(Операции[0].Запрос().МетодПоУмолчанию()).Равно(МетодыЗапросаПоУмолчаниюCURL.HEAD());
	Ожидаем.Что(Операции[1].Запрос().МетодПоУмолчанию()).Равно(МетодыЗапросаПоУмолчаниюCURL.GET());
	Ожидаем.Что(Операции[1].Результат().Режим()).Равно(РежимыРезультатаCURL.СтандартныйВывод());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьОшибкиПустыхСекцийКомандыИНеподдержанныхОпций() Экспорт

	// Подготовка
	Команда = РазобратьКоманду("curl|--next|--silent|--next");

	// Действие
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Выполнение()).Равно(Неопределено);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(4);
	ДанныеОшибки = ДиагностикаОшибок.ДанныеОшибки(Результат.Ошибки()[0]);
	Ожидаем.Что(ДанныеОшибки.ИсходноеПредставление).Равно("--next");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьКоманду(Текст)

	Аргументы = СтрРазделить(Текст, "|", Истина);
	Возврат Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);

КонецФункции

#КонецОбласти

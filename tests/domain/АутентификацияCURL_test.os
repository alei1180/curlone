#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьАутентификациюТолькоСоСпособами() Экспорт

	// Подготовка
	Способы = Новый Массив;

	// Действие
	Аутентификация = Новый АутентификацияCURL(Способы);

	// Проверка
	Ожидаем.Что(Аутентификация.Способы()).ИмеетДлину(0);
	Ожидаем.Что(Аутентификация.УчетныеДанные()).Равно(Неопределено);
	Ожидаем.Что(Аутентификация.OAuth2()).Равно(Неопределено);
	Ожидаем.Что(Аутентификация.ПодписьAWSV4()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазделитьУчетныеДанныеПоПервомуДвоеточию() Экспорт

	// Подготовка
	Источник = РазобратьКоманду("curl|--user|user:pass:word|example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Результат = Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Источник);
	Данные = Результат.Значение();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Данные.Пользователь()).Равно("user");
	Ожидаем.Что(Данные.Пароль()).Равно("pass:word");
	Ожидаем.Что(Данные.ПарольУказан()).Равно(Истина);
	Ожидаем.Что(Данные.ТребуетРазбора()).Равно(Ложь);
	Ожидаем.Что(Данные.Выражение()).Равно(Выражение);
	Ожидаем.Что(Данные.Источник()).Равно(Источник);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазличитьОтсутствующийИПустойПароль() Экспорт

	// Действие
	БезПароля = КлассифицироватьУчетныеДанные("user");
	СПустымПаролем = КлассифицироватьУчетныеДанные("user:");

	// Проверка
	Ожидаем.Что(БезПароля.Пароль()).Равно(Неопределено);
	Ожидаем.Что(БезПароля.ПарольУказан()).Равно(Ложь);
	Ожидаем.Что(СПустымПаролем.Пароль()).Равно("");
	Ожидаем.Что(СПустымПаролем.ПарольУказан()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьРазборДинамическихУчетныхДанных() Экспорт

	// Подготовка
	Источник = РазобратьСтроку("curl --user $CREDENTIALS example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Данные = Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Данные.Пользователь()).Равно(Неопределено);
	Ожидаем.Что(Данные.Пароль()).Равно(Неопределено);
	Ожидаем.Что(Данные.ПарольУказан()).Равно(Ложь);
	Ожидаем.Что(Данные.ТребуетРазбора()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСпособыИТокенOAuth2() Экспорт

	// Подготовка
	Источник = РазобратьКоманду("curl|--basic|example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(
		РазобратьКоманду("curl|--oauth2-bearer|token|example.org").Элементы()[0].ТокенЗначения()
	);

	// Действие
	Способ = Новый СпособАутентификацииCURL(СпособыАутентификацииCURL.Basic(), Источник);
	СпособПрокси = Новый СпособАутентификацииПроксиCURL(СпособыАутентификацииПроксиCURL.NTLM(), Источник);
	OAuth2 = Новый ТокенOAuth2CURL(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Способ.Вид()).Равно(СпособыАутентификацииCURL.Basic());
	Ожидаем.Что(Способ.Источник()).Равно(Источник);
	Ожидаем.Что(СпособПрокси.Вид()).Равно(СпособыАутентификацииПроксиCURL.NTLM());
	Ожидаем.Что(СпособПрокси.Источник()).Равно(Источник);
	Ожидаем.Что(OAuth2.Выражение()).Равно(Выражение);
	Ожидаем.Что(OAuth2.Источник()).Равно(Источник);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьОтОдногоДоЧетырехКомпонентовAWS() Экспорт

	// Действие
	Один = КлассифицироватьПодписьAWS("aws");
	Два = КлассифицироватьПодписьAWS("aws:amz");
	Три = КлассифицироватьПодписьAWS("aws:amz:ru-central1");
	Четыре = КлассифицироватьПодписьAWS("aws:amz:ru-central1:s3");

	// Проверка
	Ожидаем.Что(Один.Поставщик()).Равно("aws");
	Ожидаем.Что(Один.ВторойПрефиксПоставщика()).Равно(Неопределено);
	Ожидаем.Что(Два.ВторойПрефиксПоставщика()).Равно("amz");
	Ожидаем.Что(Три.Регион()).Равно("ru-central1");
	Ожидаем.Что(Четыре.Сервис()).Равно("s3");
	Ожидаем.Что(Четыре.ТребуетРазбора()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустогоПоставщикаИБольшеЧетырехКомпонентовAWS() Экспорт

	// Действие
	Пустой = РезультатПодписиAWS(":amz");
	Лишний = РезультатПодписиAWS("aws:amz:region:service:extra");

	// Проверка
	Ожидаем.Что(Пустой.Успешно()).Равно(Ложь);
	Ожидаем.Что(Лишний.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Пустой.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НедопустимоеЗначениеОпции()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьРазборДинамическойПодписиAWS() Экспорт

	// Подготовка
	Источник = РазобратьСтроку("curl --aws-sigv4 $AWS example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Подпись = Новый КлассификаторАутентификацииCURL().ПодписьAWSV4(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Подпись.Поставщик()).Равно(Неопределено);
	Ожидаем.Что(Подпись.Сервис()).Равно(Неопределено);
	Ожидаем.Что(Подпись.ТребуетРазбора()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВытеснитьСпособыПодписьюAWSИСкопироватьМассив() Экспорт

	// Подготовка
	Источник = РазобратьКоманду("curl|--basic|example.org").Элементы()[0];
	Способы = Новый Массив;
	Способы.Добавить(Новый СпособАутентификацииCURL(СпособыАутентификацииCURL.Basic(), Источник));
	Подпись = КлассифицироватьПодписьAWS("aws:amz:region:s3");

	// Действие
	Аутентификация = Новый АутентификацияCURL(Способы, Неопределено, Неопределено, Подпись);
	Способы.Очистить();

	// Проверка
	Ожидаем.Что(Аутентификация.УчетныеДанные()).Равно(Неопределено);
	Ожидаем.Что(Аутентификация.Способы()).ИмеетДлину(0);
	Ожидаем.Что(Аутентификация.OAuth2()).Равно(Неопределено);
	Ожидаем.Что(Аутентификация.ПодписьAWSV4()).Равно(Подпись);
	ПроверитьЧтоКоллекцияНеизменяема(Аутентификация.Способы());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьУчетныеДанные(Значение)

	Источник = РазобратьКоманду("curl|--user|" + Значение + "|example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	Возврат Новый КлассификаторАутентификацииCURL().УчетныеДанные(Выражение, Источник).Значение();

КонецФункции

Функция КлассифицироватьПодписьAWS(Значение)

	Возврат РезультатПодписиAWS(Значение).Значение();

КонецФункции

Функция РезультатПодписиAWS(Значение)

	Источник = РазобратьКоманду("curl|--aws-sigv4|" + Значение + "|example.org").Элементы()[0];
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	Возврат Новый КлассификаторАутентификацииCURL().ПодписьAWSV4(Выражение, Источник);

КонецФункции

Функция РазобратьКоманду(СтрокаАргументов)

	Аргументы = СтрРазделить(СтрокаАргументов, "|", Истина);
	Возврат Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);

КонецФункции

Функция РазобратьСтроку(СтрокаКоманды)

	Возврат Новый КомандыДляТестовCURL().ИзСтроки(СтрокаКоманды);

КонецФункции

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

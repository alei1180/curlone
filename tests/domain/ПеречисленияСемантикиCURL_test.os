&Тест
Процедура ТестДолжен_ПредоставитьПротоколы() Экспорт

	// Действие и Проверка
	Ожидаем.Что(ПротоколыCURL.HTTP()).Равно("http");
	Ожидаем.Что(ПротоколыCURL.HTTPS()).Равно("https");
	Ожидаем.Что(ПротоколыCURL.FTP()).Равно("ftp");
	Ожидаем.Что(ПротоколыCURL.FTPS()).Равно("ftps");
	Ожидаем.Что(ПротоколыCURL.FILE()).Равно("file");
	Ожидаем.Что(ПротоколыCURL.DICT()).Равно("dict");
	Ожидаем.Что(ПротоколыCURL.IMAP()).Равно("imap");
	Ожидаем.Что(ПротоколыCURL.LDAP()).Равно("ldap");
	Ожидаем.Что(ПротоколыCURL.POP3()).Равно("pop3");
	Ожидаем.Что(ПротоколыCURL.SMTP()).Равно("smtp");
	Ожидаем.Что(ПротоколыCURL.SOCKS4()).Равно("socks4");
	Ожидаем.Что(ПротоколыCURL.SOCKS4A()).Равно("socks4a");
	Ожидаем.Что(ПротоколыCURL.SOCKS5()).Равно("socks5");
	Ожидаем.Что(ПротоколыCURL.SOCKS5H()).Равно("socks5h");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУникальность(Значения, ОжидаемоеКоличество)

	УникальныеЗначения = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		УникальныеЗначения.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(Значения).ИмеетДлину(ОжидаемоеКоличество);
	Ожидаем.Что(УникальныеЗначения).ИмеетДлину(ОжидаемоеКоличество);

КонецПроцедуры

Функция ЗначенияМетодовЗапроса()

	Значения = Новый Массив;
	Значения.Добавить(МетодыЗапросаПоУмолчаниюCURL.GET());
	Значения.Добавить(МетодыЗапросаПоУмолчаниюCURL.HEAD());
	Значения.Добавить(МетодыЗапросаПоУмолчаниюCURL.POST());
	Значения.Добавить(МетодыЗапросаПоУмолчаниюCURL.PUT());
	Значения.Добавить(МетодыЗапросаПоУмолчаниюCURL.ЗависитОтПротокола());
	Возврат Значения;

КонецФункции


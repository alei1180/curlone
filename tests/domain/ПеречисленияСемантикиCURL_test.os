#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьРазделителиЧастейТела() Экспорт

	// Действие и Проверка
	Ожидаем.Что(РазделителиЧастейТелаCURL.Нет()).Равно("none");
	Ожидаем.Что(РазделителиЧастейТелаCURL.Амперсанд()).Равно("ampersand");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьГрамматикиЗначений() Экспорт

	// Действие
	Значения = Новый Массив;
	Значения.Добавить(ГрамматикиЗначенийCURL.URL());

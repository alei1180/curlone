#Использовать errors
#Использовать asserts
#Использовать "../../src/syntax"
#Использовать "../../src/domain"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ИзолироватьПараллельныеВызовыОдногоИнтерпретатора() Экспорт

	// Подготовка
	Интерпретатор = Новый ИнтерпретаторКомандыCURL();
	Контексты = Новый Массив;
	Задания = Новый Массив;
	Для Индекс = 1 По 12 Цикл
		Адрес = "https://host" + Строка(Индекс) + ".example/path";
		Текст = ?(Индекс % 3 = 0, "curl|--silent|" + Адрес,
			?(Индекс % 2 = 0, "curl|--head|" + Адрес, "curl|--max-time|1|" + Адрес));
		Аргументы = СтрРазделить(Текст, "|", Истина);
		ТокеныКоманды = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены();
		Команда = Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды).Команда();
		Эталон = Интерпретатор.Интерпретировать(Команда);
		Контексты.Добавить(Новый Структура(
			"Интерпретатор, Команда, Эталон, Результат, Ошибка",
			Интерпретатор,
			Команда,
			Эталон,
			Неопределено,
			Неопределено
		));
	КонецЦикла;

	// Действие
	Для Каждого Контекст Из Контексты Цикл
		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(Контекст);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ИнтерпретироватьВФоне", ПараметрыВызова));
	КонецЦикла;
	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Проверка
	Для Каждого Контекст Из Контексты Цикл
		Ожидаем.Что(Контекст.Ошибка).Равно(Неопределено);
		Ожидаем.Что(Контекст.Результат.Успешно()).Равно(Контекст.Эталон.Успешно());
		Если Контекст.Эталон.Успешно() Тогда
			Эталон = Контекст.Эталон.Выполнение().Операции()[0];
			Операция = Контекст.Результат.Выполнение().Операции()[0];
			Ожидаем.Что(Операция.Ресурс().ИсходныйАдрес().ЛитеральноеЗначение()).Равно(
				Эталон.Ресурс().ИсходныйАдрес().ЛитеральноеЗначение());
			Ожидаем.Что(Операция.Запрос().МетодПоУмолчанию()).Равно(Эталон.Запрос().МетодПоУмолчанию());
			Ожидаем.Что(Операция.Запрос().НеПолучатьТело()).Равно(Эталон.Запрос().НеПолучатьТело());
		Иначе
			Ожидаем.Что(Контекст.Результат.Ошибки()).ИмеетДлину(Контекст.Эталон.Ошибки().Количество());
			Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Контекст.Результат.Ошибки()[0])).Равно(
				ДиагностикаОшибок.КодОшибки(Контекст.Эталон.Ошибки()[0]));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет независимую интерпретацию в фоновом задании.
//
// Параметры:
//   Контекст - Структура - Интерпретатор, Команда, Эталон, Результат и Ошибка одного вызова.
Процедура ИнтерпретироватьВФоне(Контекст) Экспорт

	Попытка
		Контекст.Результат = Контекст.Интерпретатор.Интерпретировать(Контекст.Команда);
	Исключение
		Контекст.Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Использовать asserts
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("curl --data-urlencode name=value example.org")
&ИсточникЗначение("curl --data-binary @body.bin example.org")
&ИсточникЗначение("curl --upload-file body.bin example.org")
&ИсточникЗначение("curl --form 'field=@a.txt;filename=b.txt;type=text/plain;headers=X-Test:value' example.org")
&ИсточникЗначение("curl --form ""$FORM"" example.org")
Процедура ТестДолжен_МенятьТолькоРазделительЧасти(ТекстКоманды) Экспорт

	// Подготовка
	Исходная = ЧастьКоманды(ТекстКоманды);

	// Действие
	Копия = Исходная.СРазделителем(РазделителиЧастейТелаCURL.Амперсанд());

	// Проверка
	Ожидаем.Что(Копия.РазделительПеред()).Равно(РазделителиЧастейТелаCURL.Амперсанд());
	Ожидаем.Что(Исходная.РазделительПеред()).Равно(РазделителиЧастейТелаCURL.Нет());
	ПроверитьСодержимоеИПоле(Копия, Исходная);
	Ожидаем.Что(Копия.ОтложеннаяКлассификация()).Равно(Исходная.ОтложеннаяКлассификация());
	Ожидаем.Что(Копия.ТребуетРазбора()).Равно(Исходная.ТребуетРазбора());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СниматьОтложеннуюКлассификациюБезИзмененияИсходнойЧасти() Экспорт

	// Подготовка
	Исходная = ЧастьКоманды("curl --data ""$DATA"" example.org");

	// Действие
	Копия = Исходная.БезОтложеннойКлассификации();

	// Проверка
	Ожидаем.Что(Копия.ОтложеннаяКлассификация()).Равно(Неопределено);
	Ожидаем.Что(Копия.ТребуетРазбора()).Равно(Ложь);
	Ожидаем.Что(Исходная.ТребуетРазбора()).Равно(Истина);
	Ожидаем.Что(Исходная.ОтложеннаяКлассификация()).Существует();
	Ожидаем.Что(Копия.РазделительПеред()).Равно(Исходная.РазделительПеред());
	ПроверитьСодержимоеИПоле(Копия, Исходная);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьЗаголовкиПоляОтИзмененияВходногоМассива() Экспорт

	// Подготовка
	Исходная = ЧастьКоманды("curl --form 'field=value;headers=X-Test:value' example.org");
	Заголовки = Новый Массив;
	Заголовки.Добавить(Исходная.Заголовки()[0]);

	// Действие
	Поле = Новый ОписаниеПоляТелаCURL("field", "", "text/plain", Заголовки);
	Заголовки.Очистить();
	КопияПоля = Новый ОписаниеПоляТелаCURL("field", "", "text/plain", Поле.Заголовки());

	// Проверка
	Ожидаем.Что(Поле.Заголовки()).ИмеетТип("ФиксированныйМассив");
	Ожидаем.Что(Поле.Заголовки()).ИмеетДлину(1);
	Ожидаем.Что(КопияПоля.Заголовки()[0]).Равно(Исходная.Заголовки()[0]);
	Ожидаем.Что(Поле.ИмяФайла()).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЧастьКоманды(ТекстКоманды)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(ТекстКоманды);
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Возврат Результат.Выполнение().Операции()[0].Запрос().Тело().Части()[0];

КонецФункции

Процедура ПроверитьСодержимоеИПоле(Копия, Исходная)

	Ожидаем.Что(Копия.Вид()).Равно(Исходная.Вид());
	Ожидаем.Что(Копия.РежимИсточника()).Равно(Исходная.РежимИсточника());
	Ожидаем.Что(Копия.Выражение()).Равно(Исходная.Выражение());
	Ожидаем.Что(Копия.Текст()).Равно(Исходная.Текст());
	Ожидаем.Что(Копия.ПутьКФайлу()).Равно(Исходная.ПутьКФайлу());
	Ожидаем.Что(Копия.ИмяПоля()).Равно(Исходная.ИмяПоля());
	Ожидаем.Что(Копия.ИмяФайла()).Равно(Исходная.ИмяФайла());
	Ожидаем.Что(Копия.MIMEТип()).Равно(Исходная.MIMEТип());
	Ожидаем.Что(Копия.Заголовки()).Равно(Исходная.Заголовки());
	Ожидаем.Что(Копия.Кодировать()).Равно(Исходная.Кодировать());
	Ожидаем.Что(Копия.Источник()).Равно(Исходная.Источник());

КонецПроцедуры

#КонецОбласти

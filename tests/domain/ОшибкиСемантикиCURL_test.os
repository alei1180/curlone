#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьБезопаснуюМатрицуДляВсехКодовИИсточников() Экспорт

	// Подготовка
	Источники = БезопасныеИсточники();
	Коды = ВсеКодыОшибок();
	Фабрика = Новый ФабрикаОшибокКомандыCURL();

	// Действие и Проверка
	Для Каждого Код Из Коды Цикл
		Для Каждого Сценарий Из Источники Цикл
			Ошибка = Фабрика.Создать(Код, "Безопасное сообщение", Сценарий.Источник);
			Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);
			ПроверитьПозицииИсточника(Данные, Сценарий.Источник.ИсходныйТокен());
			Ожидаем.Что(Данные.ИсходноеПредставление).Равно(Сценарий.Представление);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьКонецКомандыДляВсехКодов() Экспорт

	// Подготовка
	Фабрика = Новый ФабрикаОшибокКомандыCURL();

	// Действие и Проверка
	Для Каждого Код Из ВсеКодыОшибок() Цикл
		Ошибка = Фабрика.Создать(Код, "Ошибка конца команды", Неопределено);
		Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);
		Ожидаем.Что(Данные.Позиция).Равно(-1);
		Ожидаем.Что(Данные.ПозицияВИсходнойСтроке).Равно(-1);
		Ожидаем.Что(Данные.ПозицияВАргументе).Равно(-1);
		Ожидаем.Что(Данные.ИсходноеПредставление).Равно("");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьБезопаснуюОшибкуДляОпцииБезЗначения() Экспорт

	// Подготовка
	Источник = РазобратьКоманду("curl --location example.org").Элементы()[0];

	// Действие
	Ошибка = Новый ФабрикаОшибокКомандыCURL().Создать("test.error", "Ошибка опции", Источник);
	Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно("test.error");
	Ожидаем.Что(Данные.Позиция).Равно(2);
	Ожидаем.Что(Данные.ПозицияВИсходнойСтроке).Равно(6);
	Ожидаем.Что(Данные.ПозицияВАргументе).Равно(1);
	Ожидаем.Что(Данные.ИсходноеПредставление).Равно("--location");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СкрытьЗначениеОпцииИURL() Экспорт

	// Подготовка
	Команда = РазобратьКоманду("curl --user secret:password https://secret.example");

	// Действие
	ОшибкаОпции = Новый ФабрикаОшибокКомандыCURL().Создать("test.option", "Ошибка", Команда.Элементы()[0]);
	ОшибкаURL = Новый ФабрикаОшибокКомандыCURL().Создать("test.url", "Ошибка", Команда.Элементы()[1]);

	// Проверка
	ДанныеОпции = ДиагностикаОшибок.ДанныеОшибки(ОшибкаОпции);
	ДанныеURL = ДиагностикаОшибок.ДанныеОшибки(ОшибкаURL);
	Ожидаем.Что(ДанныеОпции.ИсходноеПредставление).Равно("<значение скрыто>");
	Ожидаем.Что(ДанныеURL.ИсходноеПредставление).Равно("<значение скрыто>");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОшибкуКонцаКомандыСНеизвестнымиПозициями() Экспорт

	// Действие
	Ошибка = Новый ФабрикаОшибокКомандыCURL().Создать("test.end", "Ошибка конца команды", Неопределено);
	Данные = ДиагностикаОшибок.ДанныеОшибки(Ошибка);

	// Проверка
	Ожидаем.Что(Данные.Позиция).Равно(-1);
	Ожидаем.Что(Данные.ПозицияВИсходнойСтроке).Равно(-1);
	Ожидаем.Что(Данные.ПозицияВАргументе).Равно(-1);
	Ожидаем.Что(Данные.ИсходноеПредставление).Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БезопасныеИсточники()

	Элементы = РазобратьКоманду(
		"curl --location --user secret:password https://secret.example/private --next").Элементы();
	ТокенРазделителя = ТокенИзАргумента("--");
	Источники = Новый Массив;
	Источники.Добавить(Новый Структура("Источник, Представление", Элементы[0], "--location"));
	Источники.Добавить(Новый Структура("Источник, Представление", Элементы[1], "<значение скрыто>"));
	Источники.Добавить(Новый Структура("Источник, Представление", Элементы[2], "<значение скрыто>"));
	Источники.Добавить(Новый Структура("Источник, Представление", Элементы[3], "--next"));
	Источники.Добавить(Новый Структура(
		"Источник, Представление", СоздательЭлементовРазобраннойКомандыCURL.URL(ТокенРазделителя), "--"));

	Возврат Источники;

КонецФункции

Функция ВсеКодыОшибок()

	Коды = Новый Массив;
	Коды.Добавить(КодыОшибокCurlone.НезакрытаяКавычка());
	Коды.Добавить(КодыОшибокCurlone.ТребуетсяCurl());
	Коды.Добавить(КодыОшибокCurlone.НеподдерживаемыйСинтаксисОболочки());
	Коды.Добавить(КодыОшибокCurlone.НеизвестнаяОпция());
	Коды.Добавить(КодыОшибокCurlone.ТребуетсяЗначениеОпции());
	Коды.Добавить(КодыОшибокCurlone.ЗначениеОпцииНеДопускается());
	Коды.Добавить(КодыОшибокCurlone.НеУказанURL());
	Коды.Добавить(КодыОшибокCurlone.НеподдерживаемаяОпция());
	Коды.Добавить(КодыОшибокCurlone.НедопустимыйURL());
	Коды.Добавить(КодыОшибокCurlone.НедопустимоеЗначениеОпции());
	Коды.Добавить(КодыОшибокCurlone.НесопоставленнаяОпцияURL());
	Коды.Добавить(КодыОшибокCurlone.КонфликтТелаЗапроса());
	Коды.Добавить(КодыОшибокCurlone.КонфликтРежимаЗапроса());
	Коды.Добавить(КодыОшибокCurlone.КонфликтСоединения());
	Коды.Добавить(КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач());
	Коды.Добавить(КодыОшибокCurlone.НедопустимоеМатериализованноеЗначение());
	Коды.Добавить(КодыОшибокCurlone.НеподдерживаемыйМатериализованныйИсточникНесколькихПередач());
	Коды.Добавить(КодыОшибокCurlone.НеизвестныйГенератор());
	Коды.Добавить(КодыОшибокCurlone.ОшибкаГенератора());
	Коды.Добавить(КодыОшибокCurlone.НарушенКонтрактГенератора());
	Коды.Добавить(КодыОшибокCurlone.НесовместимаяВерсияКонтрактаГенератора());

	Возврат Коды;

КонецФункции

Процедура ПроверитьПозицииИсточника(Данные, Токен)

	Ожидаем.Что(Данные.Позиция).Равно(Токен.Позиция());
	Ожидаем.Что(Данные.ПозицияВИсходнойСтроке).Равно(Токен.ПозицияВИсходнойСтроке());
	Ожидаем.Что(Данные.ПозицияВАргументе).Равно(Токен.ПозицияВАргументе());

КонецПроцедуры

Функция ТокенИзАргумента(Аргумент)

	Аргументы = Новый Массив;
	Аргументы.Добавить(Аргумент);
	Возврат Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены()[0];

КонецФункции

Функция РазобратьКоманду(Команда)

	Возврат Новый КомандыДляТестовCURL().ИзСтроки(Команда);

КонецФункции

#КонецОбласти

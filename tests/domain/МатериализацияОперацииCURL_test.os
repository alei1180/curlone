&ПараметризованныйТест
&ИсточникЗначение("", Истина)
&ИсточникЗначение("http://proxy.org", Ложь)
Процедура ТестДолжен_ПроверитьДинамическийПроксиПриАктивномFTP(АдресПрокси, Успешно) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --ftp-port - --proxy ""$P"" ftp://example.org/file");
	Переменные = Новый Соответствие;
	Переменные.Вставить("P", АдресПрокси);

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Успешно);
	Если Не Успешно Тогда
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
			КодыОшибокCurlone.НедопустимоеМатериализованноеЗначение());
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("explicit:pass", "", "explicit", "pass")
&ИсточникЗначение(":", "", "", "")
&ИсточникЗначение("$USER", "explicit:pass", "explicit", "pass")
&ИсточникЗначение("$USER", ":", "", "")
&ИсточникЗначение("$USER", ":pass", "", "pass")
&ИсточникЗначение("$USER", "explicit:", "explicit", "")
&ИсточникЗначение("$USER", "explicit", "explicit", Неопределено)
&ИсточникЗначение("$USER", "", "", Неопределено)
Процедура ТестДолжен_СохранитьЯвныеДанныеДинамическогоПрокси(Аргумент, Значение, Имя, Пароль) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --proxy-user """ + Аргумент
		+ """ --proxy-basic --proxy-ntlm --proxy ""$PROXY"" https://example.org");
	ИсходныйПрокси = Операция.Соединение().Прокси();
	ИсточникДанных = ИсходныйПрокси.УчетныеДанные().Источник();
	Переменные = Новый Соответствие;
	Переменные.Вставить("PROXY", "http://embedded:secret@proxy.example.org:8080");
	Переменные.Вставить("USER", Значение);

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Прокси = Результат.Выполнение().Операции()[0].Соединение().Прокси();
	Данные = Прокси.УчетныеДанные();
	Ожидаем.Что(Данные.Пользователь()).Равно(Имя);
	Ожидаем.Что(Данные.Пароль()).Равно(Пароль);
	Ожидаем.Что(Данные.ПарольУказан()).Равно(Пароль <> Неопределено);
	Ожидаем.Что(Данные.ТребуетРазбора()).Равно(Ложь);
	Ожидаем.Что(Данные.Источник()).Равно(ИсточникДанных);
	Ожидаем.Что(Прокси.ИсточникУчетныхДанных()).Равно(ИсточникДанных);
	Ожидаем.Что(ИсточникДанных.ОписаниеОпции().КаноническоеИмя()).Равно("proxy-user");
	Ожидаем.Что(Прокси.Сервер()).Равно("proxy.example.org");
	Ожидаем.Что(Прокси.ИсточникАдреса()).Равно(ИсходныйПрокси.ИсточникАдреса());
	Способы = Прокси.СпособыАутентификации();
	Ожидаем.Что(Способы).ИмеетДлину(2);
	Ожидаем.Что(Способы[0].Вид()).Равно(СпособыАутентификацииПроксиCURL.Basic());
	Ожидаем.Что(Способы[1].Вид()).Равно(СпособыАутентификацииПроксиCURL.NTLM());
	Ожидаем.Что(Способы[0].Источник()).Равно(ИсходныйПрокси.СпособыАутентификации()[0].Источник());
	Ожидаем.Что(Способы[1].Источник()).Равно(ИсходныйПрокси.СпособыАутентификации()[1].Источник());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("embedded:secret", "embedded", "secret")
&ИсточникЗначение(":secret", "", "secret")
&ИсточникЗначение(":", "", "")
Процедура ТестДолжен_ПолучитьДанныеИзДинамическогоАдресаПрокси(Значение, Имя, Пароль) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --proxy-basic --proxy ""$PROXY"" https://example.org");
	ИсходныйПрокси = Операция.Соединение().Прокси();
	Переменные = Новый Соответствие;
	Переменные.Вставить("PROXY", "http://" + Значение + "@proxy.example.org:8080");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Прокси = Результат.Выполнение().Операции()[0].Соединение().Прокси();
	Данные = Прокси.УчетныеДанные();
	Ожидаем.Что(Данные.Пользователь()).Равно(Имя);
	Ожидаем.Что(Данные.Пароль()).Равно(Пароль);
	Ожидаем.Что(Данные.ПарольУказан()).Равно(Истина);
	Ожидаем.Что(Данные.ТребуетРазбора()).Равно(Ложь);
	Ожидаем.Что(Данные.Источник()).Равно(ИсходныйПрокси.ИсточникАдреса());
	Ожидаем.Что(Прокси.ИсточникУчетныхДанных()).Равно(ИсходныйПрокси.ИсточникАдреса());
	Ожидаем.Что(Прокси.СпособыАутентификации()).ИмеетДлину(1);
	Ожидаем.Что(Прокси.СпособыАутентификации()[0].Вид()).Равно(СпособыАутентификацииПроксиCURL.Basic());

КонецПроцедуры

&Тест
Процедура ТестДолжен_БезопасноОтклонитьНедопустимыеУчетныеДанныеДинамическогоURL() Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl ""https://user:%FF@$HOST/file""");
	Переменные = Новый Соответствие;
	Переменные.Вставить("HOST", "example.org");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НедопустимоеМатериализованноеЗначение());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнтерпретироватьСтроку(Текст)

	Команда = Новый КомандыДляТестовCURL().ИзСтроки(Текст);
	Возврат Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда).Выполнение().Операции()[0];

КонецФункции

Процедура ПроверитьГрамматику(Операция, Эталон, Грамматика)

	ПроверитьПоле(Операция.Запрос().МетодПоУмолчанию(), Эталон.Запрос().МетодПоУмолчанию());
	Если Грамматика = "URL" Тогда
		ПроверитьРесурс(Операция.Ресурс(), Эталон.Ресурс());
	ИначеЕсли Грамматика = "Заголовок" Или Грамматика = "ПользовательскийАгент" Тогда
		ПроверитьЗаголовки(Операция.Запрос().Заголовки(), Эталон.Запрос().Заголовки());
	ИначеЕсли Грамматика = "ЧастьЗапроса" Тогда
		Запрос = Операция.Запрос().СтрокаЗапроса();
		ОжидаемыйЗапрос = Эталон.Запрос().СтрокаЗапроса();
		ПроверитьПоле(Запрос.РазделительПередПервойЧастью(), ОжидаемыйЗапрос.РазделительПередПервойЧастью());
		Части = Запрос.Части();
		ОжидаемыеЧасти = ОжидаемыйЗапрос.Части();
		Ожидаем.Что(Части).ИмеетДлину(ОжидаемыеЧасти.Количество());
		Для Индекс = 0 По Части.Количество() - 1 Цикл
			ПроверитьЧастьЗапроса(Части[Индекс], ОжидаемыеЧасти[Индекс]);
		КонецЦикла;
	ИначеЕсли Грамматика = "Результат" Тогда
		ПроверитьРезультат(Операция.Результат(), Эталон.Результат());
	ИначеЕсли Грамматика = "УчетныеДанные" Тогда
		ПроверитьУчетныеДанные(Операция.Запрос().Аутентификация().УчетныеДанные(),
			Эталон.Запрос().Аутентификация().УчетныеДанные());
	ИначеЕсли Грамматика = "Прокси" Тогда
		ПроверитьПрокси(Операция.Соединение().Прокси(), Эталон.Соединение().Прокси());
	ИначеЕсли Грамматика = "Сертификат" Тогда
		ПроверитьСертификат(Операция.Соединение().TLS().СертификатКлиента(),
			Эталон.Соединение().TLS().СертификатКлиента());
	ИначеЕсли Грамматика = "ЦелоеНеотрицательное" Тогда
		ПроверитьПоле(Операция.Политики().Повторы().Количество().Значение(),
			Эталон.Политики().Повторы().Количество().Значение());
	ИначеЕсли Грамматика = "ДесятичноеНеотрицательное" Тогда
		ПроверитьПоле(Операция.Соединение().Таймаут().Значение(), Эталон.Соединение().Таймаут().Значение());
	Иначе
		Тело = Операция.Запрос().Тело();
		ОжидаемоеТело = Эталон.Запрос().Тело();
		ПроверитьПоле(Тело.Вид(), ОжидаемоеТело.Вид());
		Части = Тело.Части();
		ОжидаемыеЧасти = ОжидаемоеТело.Части();
		Ожидаем.Что(Части).ИмеетДлину(ОжидаемыеЧасти.Количество());
		Для Индекс = 0 По Части.Количество() - 1 Цикл
			ПроверитьЧастьТела(Части[Индекс], ОжидаемыеЧасти[Индекс]);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаголовки(Заголовки, Эталон)

	Ожидаем.Что(Заголовки).ИмеетДлину(Эталон.Количество());
	Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
		ПроверитьЗаголовок(Заголовки[Индекс], Эталон[Индекс]);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьРесурс(Значение, Эталон)

	ПроверитьПоле(Значение.АдресДляВыполнения().ЛитеральноеЗначение(), Эталон.АдресДляВыполнения().ЛитеральноеЗначение());
	ПроверитьПоле(Значение.Фрагмент(), Эталон.Фрагмент());
	ПроверитьПоле(Значение.ФрагментУказан(), Эталон.ФрагментУказан());
	ПроверитьПоле(Значение.Протокол(), Эталон.Протокол());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());

КонецПроцедуры

Процедура ПроверитьЗаголовок(Значение, Эталон)

	ПроверитьПоле(Значение.Действие(), Эталон.Действие());
	ПроверитьПоле(Значение.Имя(), Эталон.Имя());
	ПроверитьПоле(Значение.Значение(), Эталон.Значение());
	ПроверитьПоле(Значение.ПутьКФайлу(), Эталон.ПутьКФайлу());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());

КонецПроцедуры

Процедура ПроверитьЧастьЗапроса(Значение, Эталон)

	ПроверитьПоле(Значение.ВидИсточника(), Эталон.ВидИсточника());
	ПроверитьПоле(Значение.Имя(), Эталон.Имя());
	ПроверитьПоле(Значение.Текст(), Эталон.Текст());
	ПроверитьПоле(Значение.ПутьКФайлу(), Эталон.ПутьКФайлу());
	ПроверитьПоле(Значение.Кодировать(), Эталон.Кодировать());
	ПроверитьПоле(Значение.ДобавлятьЗнакРавно(), Эталон.ДобавлятьЗнакРавно());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());

КонецПроцедуры

Процедура ПроверитьЧастьТела(Значение, Эталон)

	ПроверитьПоле(Значение.Вид(), Эталон.Вид());
	ПроверитьПоле(Значение.РежимИсточника(), Эталон.РежимИсточника());
	ПроверитьПоле(Значение.Текст(), Эталон.Текст());
	ПроверитьПоле(Значение.ПутьКФайлу(), Эталон.ПутьКФайлу());
	ПроверитьПоле(Значение.ИмяПоля(), Эталон.ИмяПоля());
	ПроверитьПоле(Значение.ИмяФайла(), Эталон.ИмяФайла());
	ПроверитьПоле(Значение.MIMEТип(), Эталон.MIMEТип());
	ПроверитьПоле(Значение.Кодировать(), Эталон.Кодировать());
	ПроверитьПоле(Значение.РазделительПеред(), Эталон.РазделительПеред());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());
	ПроверитьЗаголовки(Значение.Заголовки(), Эталон.Заголовки());

КонецПроцедуры

Процедура ПроверитьРезультат(Значение, Эталон)

	ПроверитьПоле(Значение.Режим(), Эталон.Режим());
	ПроверитьПоле(Значение.ИмяФайла().ЛитеральноеЗначение(), Эталон.ИмяФайла().ЛитеральноеЗначение());
	ПроверитьПоле(Значение.СоздаватьКаталоги(), Эталон.СоздаватьКаталоги());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());

КонецПроцедуры

Процедура ПроверитьУчетныеДанные(Значение, Эталон)

	ПроверитьПоле(Значение.Пользователь(), Эталон.Пользователь());
	ПроверитьПоле(Значение.Пароль(), Эталон.Пароль());
	ПроверитьПоле(Значение.ПарольУказан(), Эталон.ПарольУказан());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());

КонецПроцедуры

Процедура ПроверитьПрокси(Значение, Эталон)

	ПроверитьПоле(Значение.Режим(), Эталон.Режим());
	ПроверитьПоле(Значение.Протокол(), Эталон.Протокол());
	ПроверитьПоле(Значение.Сервер(), Эталон.Сервер());
	ПроверитьПоле(Значение.Порт(), Эталон.Порт());
	ПроверитьПоле(Значение.ПутьUnixСокета(), Эталон.ПутьUnixСокета());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());
	ПроверитьПоле(Значение.ОтложеннаяКлассификация(), Эталон.ОтложеннаяКлассификация());
	Если Эталон.УчетныеДанные() = Неопределено Тогда
		ПроверитьПоле(Значение.УчетныеДанные(), Неопределено);
	Иначе
		ПроверитьУчетныеДанные(Значение.УчетныеДанные(), Эталон.УчетныеДанные());
	КонецЕсли;
	Ожидаем.Что(Значение.СпособыАутентификации()).ИмеетДлину(Эталон.СпособыАутентификации().Количество());
	Для Индекс = 0 По Эталон.СпособыАутентификации().Количество() - 1 Цикл
		ПроверитьПоле(Значение.СпособыАутентификации()[Индекс].Вид(),
			Эталон.СпособыАутентификации()[Индекс].Вид());
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСертификат(Значение, Эталон)

	ПроверитьПоле(Значение.Путь(), Эталон.Путь());
	ПроверитьПоле(Значение.Пароль(), Эталон.Пароль());
	ПроверитьПоле(Значение.ПарольУказан(), Эталон.ПарольУказан());
	ПроверитьПоле(Значение.ТребуетРазбора(), Эталон.ТребуетРазбора());

КонецПроцедуры

Процедура ПроверитьПоле(Значение, Эталон)

	Ожидаем.Что(ТипЗнч(Значение)).Равно(ТипЗнч(Эталон));
	Ожидаем.Что(Значение).Равно(Эталон);

КонецПроцедуры


#КонецОбласти

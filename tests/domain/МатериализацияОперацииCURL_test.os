&ИсточникЗначение("--user", "user", "УчетныеДанные")
&ИсточникЗначение("--user", "user:", "УчетныеДанные")
&ИсточникЗначение("--proxy", "http://user:pass@proxy.example.org:8080", "Прокси")
&ИсточникЗначение("--cert", "client.pem", "Сертификат")
&ИсточникЗначение("--cert", "client.pem:", "Сертификат")
Процедура ТестДолжен_МатериализоватьКаждуюГрамматику(Опция, Значение, ИмяГрамматики) Экспорт

	// Подготовка
	Команда = "curl " + Опция + " ""$VALUE"" https://example.org";
	Операция = ИнтерпретироватьСтроку(Команда);
	АргументыЭталона = Новый Массив;
	АргументыЭталона.Добавить("curl");
	АргументыЭталона.Добавить(Опция);
	АргументыЭталона.Добавить(Значение);
	АргументыЭталона.Добавить("https://example.org");
	КомандаЭталона = Новый КомандыДляТестовCURL().ИзАргументов(АргументыЭталона);
	Эталон = Новый ИнтерпретаторКомандыCURL().Интерпретировать(КомандаЭталона).Выполнение().Операции()[0];
	Переменные = Новый Соответствие;
	Переменные.Вставить("VALUE", Значение);

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Материализованная = Результат.Выполнение().Операции()[0];
	ПроверитьГрамматику(Материализованная, Эталон, ИмяГрамматики);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьТипыПередВычислением() Экспорт

	// Подготовка
	Операция = Новый ОперацияCURL(
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено,
		Неопределено
	);
	Неверные = Новый Массив;
	Неверные.Добавить(Новый Массив);
	НеверныйКлюч = Новый Соответствие;
	НеверныйКлюч.Вставить(1, "значение");
	Неверные.Добавить(НеверныйКлюч);
	НеверноеЗначение = Новый Соответствие;
	НеверноеЗначение.Вставить("KEY", 1);
	Неверные.Добавить(НеверноеЗначение);

	// Действие и Проверка
	Для Каждого Переменные Из Неверные Цикл
		Ошибка = Неопределено;
		Попытка
			Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		Ожидаем.Что(Ошибка).Существует();
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыСтандартныхОшибок.НеверныйТипАргумента());
	КонецЦикла;

	Ошибка = Неопределено;
	Попытка
		Результат = Новый МатериализаторОперацииCURL().Материализовать(Новый Массив, Новый Соответствие);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НеверныйТипАргумента());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВычислитьURLБезПовторнойПодстановки() Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --user explicit:pass --remote-name ""https://$HOST/$FILE""");
	Переменные = Новый Соответствие;
	Переменные.Вставить("HOST", "user:secret@example.org");
	Переменные.Вставить("FILE", "file.txt");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Материализованная = Результат.Выполнение().Операции()[0];
	Ожидаем.Что(Материализованная.Ресурс().АдресДляВыполнения().ЛитеральноеЗначение()).Равно(
		"https://example.org/file.txt");
	Ожидаем.Что(Материализованная.Запрос().МетодПоУмолчанию()).Равно("GET");
	Ожидаем.Что(Материализованная.Запрос().Аутентификация().УчетныеДанные().Пользователь()).Равно("explicit");
	Ожидаем.Что(Материализованная.Результат().ИмяФайла().ЛитеральноеЗначение()).Равно("file.txt");
	Ожидаем.Что(Операция.Ресурс().ТребуетРазбора()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьАтомарностьИСкрытьНедопустимыеЗначения() Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --max-time ""$TIME"" ""$URL""");
	Переменные = Новый Соответствие;
	Переменные.Вставить("URL", "@secret-file");
	Переменные.Вставить("TIME", "secret-invalid-number");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Выполнение()).Равно(Неопределено);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(2);
	Для Каждого Ошибка Из Результат.Ошибки() Цикл
		Ожидаем.Что(Новый РазборОшибки(Ошибка).Данные().ИсходноеПредставление).Равно("<значение скрыто>");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьРегистрОтсутствующиеИПовторныеПеременные() Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl ""https://$HOST/$host/$MISSING/$HOST""");
	Переменные = Новый Соответствие;
	Переменные.Вставить("HOST", "example.org");
	Переменные.Вставить("host", "path");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Адрес = Результат.Выполнение().Операции()[0].Ресурс().АдресДляВыполнения().ЛитеральноеЗначение();
	Ожидаем.Что(Адрес).Равно("https://example.org/path//example.org");

КонецПроцедуры


&ПараметризованныйТест
&ИсточникЗначение("https:/example.org/path")
&ИсточникЗначение("https://example.org/path")
&ИсточникЗначение("https:///example.org/path")
Процедура ТестДолжен_НормализоватьДинамическийURLИСохранитьПорядокЧастей(Адрес) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку(
		"curl --data ""$DATA"" --url-query second=2 --get ""$URL""");
	Переменные = Новый Соответствие;
	Переменные.Вставить("URL", Адрес);
	Переменные.Вставить("DATA", "first=1");

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Материализованная = Результат.Выполнение().Операции()[0];
	Ожидаем.Что(Материализованная.Ресурс().АдресДляВыполнения().ЛитеральноеЗначение()).Равно(
		"https://example.org/path");
	Части = Материализованная.Запрос().СтрокаЗапроса().Части();
	Ожидаем.Что(Части).ИмеетДлину(2);
	Ожидаем.Что(Части[0].Текст()).Равно("first=1");
	Ожидаем.Что(Части[1].Имя()).Равно("second");
	Ожидаем.Что(Части[1].Текст()).Равно("2");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.org/file", "", "none")
&ИсточникЗначение("https://example.org/file?", "", "none")
&ИсточникЗначение("https://example.org/file?a=1#part", "", "none")
&ИсточникЗначение("https://example.org/file", "--url-query b=2", "question_mark")
&ИсточникЗначение("https://example.org/file?a=1", "--url-query b=2", "ampersand")
Процедура ТестДолжен_СогласоватьРазделительДинамическогоURLСЧастями(Адрес, Опции, Разделитель) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl " + Опции + " ""$URL""");
	Эталон = ИнтерпретироватьСтроку("curl " + Опции + " """ + Адрес + """");
	Переменные = Новый Соответствие;
	Переменные.Вставить("URL", Адрес);

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Запрос = Результат.Выполнение().Операции()[0].Запрос().СтрокаЗапроса();
	Ожидаем.Что(Запрос.РазделительПередПервойЧастью()).Равно(Разделитель);
	Ожидаем.Что(Запрос.РазделительПередПервойЧастью()).Равно(
		Эталон.Запрос().СтрокаЗапроса().РазделительПередПервойЧастью());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("=a=b", Неопределено, "a=b", Ложь)
&ИсточникЗначение("name=a=b", "name", "a=b", Истина)
Процедура ТестДолжен_СохранитьСемантикуКодированныхДанныхПослеВычисления(Значение, Имя, Текст, Равно) Экспорт

	// Подготовка
	Операция = ИнтерпретироватьСтроку("curl --get --data-urlencode ""$VALUE"" example.org");
	Переменные = Новый Соответствие;
	Переменные.Вставить("VALUE", Значение);

	// Действие
	Результат = Новый МатериализаторОперацииCURL().Материализовать(Операция, Переменные);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Часть = Результат.Выполнение().Операции()[0].Запрос().СтрокаЗапроса().Части()[0];
	Ожидаем.Что(Часть.Имя()).Равно(Имя);
	Ожидаем.Что(Часть.Текст()).Равно(Текст);
	Ожидаем.Что(Часть.ДобавлятьЗнакРавно()).Равно(Равно);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--url", "https://example.org/file", "URL")
&ИсточникЗначение("--header", "X-Test: value", "Заголовок")
&ИсточникЗначение("--user-agent", "curlone", "ПользовательскийАгент")
&ИсточникЗначение("--url-query", "name=value", "ЧастьЗапроса")
&ИсточникЗначение("--data", "value", "Данные")
&ИсточникЗначение("--data-raw", "@value", "ДанныеБезСсылкиНаФайл")
&ИсточникЗначение("--data-binary", "@body.bin", "ДвоичныеДанные")
&ИсточникЗначение("--data-urlencode", "a b", "КодированныеДанные")
&ИсточникЗначение("--json", "{}", "JSON")
&ИсточникЗначение("--form", "field=value", "Форма")
&ИсточникЗначение("--form-string", "field=value", "СтроковаяФорма")
&ИсточникЗначение("--output", "result.txt", "Результат")
&ИсточникЗначение("--user", "user:password", "УчетныеДанные")
&ИсточникЗначение("--proxy", "http://proxy.example.org:8080", "Прокси")
&ИсточникЗначение("--cert", "client.pem:password", "Сертификат")
&ИсточникЗначение("--retry", "2", "ЦелоеНеотрицательное")
&ИсточникЗначение("--max-time", "1.25", "ДесятичноеНеотрицательное")
&ИсточникЗначение("--url", "https://example.org/path?#", "URL")
&ИсточникЗначение("--header", "X-Empty;", "Заголовок")
&ИсточникЗначение("--url-query", "=a|b", "ЧастьЗапроса")
&ИсточникЗначение("--url-query", "name=", "ЧастьЗапроса")
&ИсточникЗначение("--data-urlencode", "", "КодированныеДанные")
&ИсточникЗначение("--data-urlencode", "=a|b", "КодированныеДанные")
&ИсточникЗначение("--data-urlencode", "name=", "КодированныеДанные")

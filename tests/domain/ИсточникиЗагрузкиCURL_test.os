#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("body.bin", Истина, "body.bin")
&ИсточникЗначение("part[one].bin", Истина, "part[one].bin")
&ИсточникЗначение("part\[1-3\].bin", Истина, "part[1-3].bin")
&ИсточникЗначение("part\{a,b\}.bin", Истина, "part{a,b}.bin")
&ИсточникЗначение("part[1-3].bin", Ложь, "")
&ИсточникЗначение("part{a,b}.bin", Ложь, "")
Процедура ТестДолжен_РаспознатьТолькоАктивныйШаблон(Путь, Успешно, ПутьПослеРазбора) Экспорт

	// Подготовка
	Аргументы = СтрРазделить("curl|--upload-file|" + Путь + "|https://example.org", "|", Истина);
	Команда = Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);

	// Действие
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Успешно);
	Если Успешно Тогда
		Операция = Результат.Выполнение().Операции()[0];
		Ожидаем.Что(Операция.Запрос().МетодПоУмолчанию()).Равно("PUT");
		Ожидаем.Что(Операция.Запрос().Тело().Части()[0].ПутьКФайлу()).Равно(ПутьПослеРазбора);
	Иначе
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
			КодыОшибокCurlone.НеподдерживаемыйИсточникНесколькихПередач());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("--get|--data|first=1|--url-query|second=2", "first=1|second=2")
&ИсточникЗначение("--get|--url-query|first=1|--data|second=2", "first=1|second=2")
&ИсточникЗначение("--data|first=1|--url-query|second=2|--json|third=3|--get", "first=1|second=2|third=3")
&ИсточникЗначение("--get|--data|first=1|--url-query|second=2|--no-get", "second=2")
Процедура ТестДолжен_СохранитьПорядокСмешанныхЧастейЗапроса(Опции, ОжидаемыйПорядок) Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду("curl|" + Опции + "|https://example.org");

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Части = Результат.Значение()[0].Запрос().СтрокаЗапроса().Части();
	ОжидаемыеЧасти = СтрРазделить(ОжидаемыйПорядок, "|", Истина);
	Ожидаем.Что(Части).ИмеетДлину(ОжидаемыеЧасти.Количество());
	Для Индекс = 0 По Части.ВГраница() Цикл
		Ожидаем.Что(Части[Индекс].Выражение().ЛитеральноеЗначение()).Равно(ОжидаемыеЧасти[Индекс]);
	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--head|--data|a", "curlone.command.conflicting_request_mode")
&ИсточникЗначение("--head|--form|a=b", "curlone.command.conflicting_request_mode")
&ИсточникЗначение("--form|a=b|--head", "curlone.command.conflicting_request_mode")
&ИсточникЗначение("--head|--upload-file|body", "curlone.command.conflicting_request_mode")
&ИсточникЗначение("--head|--no-head", "curlone.command.conflicting_request_mode")
&ИсточникЗначение("--data|a|--form|a=b", "curlone.command.conflicting_body")
&ИсточникЗначение("--ftp-port|-|--proxy|proxy.example.org", "curlone.command.conflicting_connection_options")
&ИсточникЗначение("--output|a|--output|b", "curlone.command.unmatched_per_url_option")
&ИсточникЗначение("--upload-file|a|--upload-file|b", "curlone.command.unmatched_per_url_option")
Процедура ТестДолжен_ВернутьТочныйКодКонфликта(Опции, Код) Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду("curl|" + Опции + "|https://example.org");

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Значение()).Равно(Неопределено);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(Код);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьНезависимыеОчередиЗагрузкиИРезультата() Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду(
		"curl|https://a.example|--output|result.txt|https://b.example|--upload-file|body.bin");

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Первая = Результат.Значение()[0];
	Вторая = Результат.Значение()[1];
	Ожидаем.Что(Первая.Запрос().МетодПоУмолчанию()).Равно("PUT");
	Ожидаем.Что(Первая.Запрос().Тело().Части()[0].ПутьКФайлу()).Равно("body.bin");
	Ожидаем.Что(Первая.Результат().ИмяФайла().ЛитеральноеЗначение()).Равно("result.txt");
	Ожидаем.Что(Вторая.Запрос().МетодПоУмолчанию()).Равно("GET");
	Ожидаем.Что(Вторая.Запрос().Тело().Части()).ИмеетДлину(0);
	Ожидаем.Что(Вторая.Результат().Режим()).Равно(РежимыРезультатаCURL.СтандартныйВывод());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("--remote-name-all|--no-remote-name", "stdout", "remote_name")
&ИсточникЗначение("--no-remote-name|--remote-name-all", "remote_name", "remote_name")
&ИсточникЗначение("--remote-name-all|--output|-", "stdout", "remote_name")
&ИсточникЗначение("--remote-name-all|--no-remote-name-all", "stdout", "stdout")
Процедура ТестДолжен_ПрименитьПозиционныйПриоритетРезультата(Опции, ПервыйРежим, ВторойРежим) Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду("curl|" + Опции + "|https://a.example|https://b.example");

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()[0].Результат().Режим()).Равно(ПервыйРежим);
	Ожидаем.Что(Результат.Значение()[1].Результат().Режим()).Равно(ВторойРежим);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("https://example.org", "question_mark")
&ИсточникЗначение("https://example.org?", "ampersand")
&ИсточникЗначение("https://example.org?a=1", "ampersand")
Процедура ТестДолжен_ОпределитьПервыйРазделитель(Адрес, Разделитель) Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду("curl|--url-query|b=2|" + Адрес);

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()[0].Запрос().СтрокаЗапроса().РазделительПередПервойЧастью()).Равно(Разделитель);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьОперацииВПорядкеURL() Экспорт

	// Подготовка
	Команда = РазобратьКоманду("curl|https://first.example|https://second.example");
	Построитель = Новый ПостроительГруппыCURL();
	Для Каждого Элемент Из Команда.Элементы() Цикл
		Построитель.ДобавитьURL(Элемент);
	КонецЦикла;

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()).ИмеетДлину(2);
	Ожидаем.Что(Результат.Значение()[0].Ресурс().ИсходныйАдрес().ЛитеральноеЗначение()).Равно(
		"https://first.example");
	Ожидаем.Что(Результат.Значение()[1].Ресурс().ИсходныйАдрес().ЛитеральноеЗначение()).Равно(
		"https://second.example");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СопоставитьОчередьРезультатаНезависимоОтПоложенияURL() Экспорт

	// Подготовка
	Построитель = ПрименитьКоманду("curl|https://a.example|https://b.example|--output|a.txt|--remote-name");

	// Действие
	Результат = Построитель.Построить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()[0].Результат().ИмяФайла().ЛитеральноеЗначение()).Равно("a.txt");
	Ожидаем.Что(Результат.Значение()[1].Результат().Режим()).Равно(РежимыРезультатаCURL.ИмяИзURL());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьКоманду(Текст)

	Аргументы = СтрРазделить(Текст, "|", Истина);
	Возврат Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);

КонецФункции

Функция ПрименитьКоманду(Текст)

	Построитель = Новый ПостроительГруппыCURL();
	Реестр = Новый РеестрСемантическихОбработчиковCURL();
	Для Каждого Элемент Из РазобратьКоманду(Текст).Элементы() Цикл
		Если Элемент.Вид() = ВидыЭлементовРазобраннойКомандыCURL.URL() Тогда
			Построитель.ДобавитьURL(Элемент);
		Иначе
			Реестр.НайтиОбработчик(Элемент.ОписаниеОпции().ИдентификаторОбработчика()).Применить(Элемент, Построитель);
		КонецЕсли;
	КонецЦикла;
	Возврат Построитель;

КонецФункции

#КонецОбласти

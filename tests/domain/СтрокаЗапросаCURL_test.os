#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("content", "text", Неопределено, "content", Неопределено, Истина, Ложь)
&ИсточникЗначение("=content", "text", Неопределено, "content", Неопределено, Истина, Ложь)
&ИсточникЗначение("name=content", "text", "name", "content", Неопределено, Истина, Истина)
&ИсточникЗначение("@filename", "file", Неопределено, Неопределено, "filename", Истина, Ложь)
&ИсточникЗначение("@-", "stdin", Неопределено, Неопределено, Неопределено, Истина, Ложь)
&ИсточникЗначение("name@filename", "file", "name", Неопределено, "filename", Истина, Истина)
Процедура ТестДолжен_КлассифицироватьЛитеральнуюЧастьЗапроса(
	Значение,
	ВидИсточника,
	Имя,
	Текст,
	ПутьКФайлу,
	Кодировать,
	ДобавлятьЗнакРавно
) Экспорт

	// Подготовка
	Источник = ИсточникURL(Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(
		Выражение,
		Источник,
		Ложь
	);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	ПроверитьЧасть(
		Результат.Значение(),
		ВидИсточника,
		Имя,
		Текст,
		ПутьКФайлу,
		Кодировать,
		ДобавлятьЗнакРавно,
		Источник
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьНачальныйПлюсБезКодирования() Экспорт

	// Подготовка
	Источник = ИсточникURL("+name=%20foo");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(
		Выражение,
		Источник,
		Истина
	);

	// Проверка
	ПроверитьЧасть(
		Результат.Значение(),
		ВидыИсточниковЧастиСтрокиЗапросаCURL.Текст(),
		Неопределено,
		"name=%20foo",
		Неопределено,
		Ложь,
		Ложь,
		Источник
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьНачальныйПлюсОбычнымТекстомКогдаОнНеРазрешен() Экспорт

	// Подготовка
	Источник = ИсточникURL("+text");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(
		Выражение,
		Источник,
		Ложь
	);

	// Проверка
	Ожидаем.Что(Результат.Значение().Текст()).Равно("+text");
	Ожидаем.Что(Результат.Значение().Кодировать()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьКлассификациюДинамическойЧастиЗапроса() Экспорт

	// Подготовка
	Токен = Новый ЛексерКомандыCURL().Разобрать("curl ""$QUERY""").Токены()[1];
	Источник = СоздательЭлементовРазобраннойКомандыCURL.URL(Токен);
	Выражение = Новый ВыражениеЗначенияCURL(Токен);

	// Действие
	Результат = Новый КлассификаторЧастиСтрокиЗапросаCURL().Классифицировать(
		Выражение,
		Источник,
		Истина
	);

	// Проверка
	Часть = Результат.Значение();
	Ожидаем.Что(Часть.ВидИсточника()).Равно(
		ВидыИсточниковЧастиСтрокиЗапросаCURL.ОпределитьПослеВычисления()
	);
	Ожидаем.Что(Часть.Выражение()).Равно(Выражение);
	Ожидаем.Что(Часть.Имя()).Равно(Неопределено);
	Ожидаем.Что(Часть.Текст()).Равно(Неопределено);
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(Неопределено);
	Ожидаем.Что(Часть.Кодировать()).Равно(Неопределено);
	Ожидаем.Что(Часть.ДобавлятьЗнакРавно()).Равно(Неопределено);
	Ожидаем.Что(Часть.ОтложеннаяКлассификация().Грамматика()).Равно(
		ГрамматикиЗначенийCURL.ЧастьЗапроса()
	);
	Ожидаем.Что(Часть.Источник()).Равно(Источник);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНеизменяемуюСтрокуЗапроса() Экспорт

	// Подготовка
	ИсходныеЧасти = Новый Массив;
	ИсходныеЧасти.Добавить("часть");

	// Действие
	СтрокаЗапроса = Новый СтрокаЗапросаCURL(
		ИсходныеЧасти,
		РазделителиСтрокиЗапросаCURL.ВопросительныйЗнак()
	);
	ИсходныеЧасти.Очистить();

	// Проверка
	Ожидаем.Что(СтрокаЗапроса.Части()).ИмеетДлину(1);
	Ожидаем.Что(СтрокаЗапроса.Части()[0]).Равно("часть");
	Ожидаем.Что(СтрокаЗапроса.РазделительПередПервойЧастью()).Равно(
		РазделителиСтрокиЗапросаCURL.ВопросительныйЗнак()
	);
	ПроверитьЧтоКоллекцияНеизменяема(СтрокаЗапроса.Части());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсточникURL(Значение)

	Возврат Новый КомандыДляТестовCURL().ИсточникURL(Значение);

КонецФункции

Процедура ПроверитьЧасть(
	Часть,
	ВидИсточника,
	Имя,
	Текст,
	ПутьКФайлу,
	Кодировать,
	ДобавлятьЗнакРавно,
	Источник
)

	Ожидаем.Что(Часть.ВидИсточника()).Равно(ВидИсточника);
	Ожидаем.Что(Часть.Имя()).Равно(Имя);
	Ожидаем.Что(Часть.Текст()).Равно(Текст);
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(ПутьКФайлу);
	Ожидаем.Что(Часть.Кодировать()).Равно(Кодировать);
	Ожидаем.Что(Часть.ДобавлятьЗнакРавно()).Равно(ДобавлятьЗнакРавно);
	Ожидаем.Что(Часть.ОтложеннаяКлассификация()).Равно(Неопределено);
	Ожидаем.Что(Часть.Источник()).Равно(Источник);

КонецПроцедуры

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

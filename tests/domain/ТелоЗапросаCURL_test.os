#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("field=value;filename=shown.txt", "shown.txt")
&ИсточникЗначение("field=value;filename=""shown;a.txt""", "shown;a.txt")
&ИсточникЗначение("field=value;filename=", "")
Процедура ТестДолжен_СохранитьИмяФайлаСтроковогоПоляФормы(Значение, ИмяФайла) Экспорт

	// Подготовка
	Источник = ИсточникОпции("form", Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Результат = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Часть = Результат.Значение()[0];
	Ожидаем.Что(Часть.Текст()).Равно("value");
	Ожидаем.Что(Часть.ИмяФайла()).Равно(ИмяФайла);
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("data", "@body.txt", "ТекстовыйФайлБезCRLFNUL", "body.txt", Ложь)
&ИсточникЗначение("data-raw", "@raw", "ЛитеральноеЗначение", "", Ложь)
&ИсточникЗначение("data-binary", "@body.bin", "ДвоичныйФайл", "body.bin", Ложь)
&ИсточникЗначение("data-urlencode", "a b", "ЛитеральноеЗначение", "", Истина)
&ИсточникЗначение("json", "@body.json", "ДвоичныйФайл", "body.json", Ложь)
Процедура ТестДолжен_КлассифицироватьДанные(
	ИмяОпции,
	Значение,
	ИмяРежима,
	Путь,
	Кодировать
) Экспорт
	// Подготовка
	Источник = ИсточникОпции(ИмяОпции, Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Часть = Новый КлассификаторДанныхCURL().Классифицировать(
		ИмяОпции,
		Выражение,
		Источник,
		РазделителиЧастейТелаCURL.Нет()
	).Значение();
	// Проверка
	Ожидаем.Что(Часть.РежимИсточника()).Равно(РежимПоИмени(ИмяРежима));
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(ПустоеКакНеопределено(Путь));
	Ожидаем.Что(Часть.Кодировать()).Равно(Кодировать);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("content", "", "content", "")
&ИсточникЗначение("=content", "", "content", "")
&ИсточникЗначение("name=content", "name", "content", "")
&ИсточникЗначение("@file.txt", "", "", "file.txt")
&ИсточникЗначение("name@file.txt", "name", "", "file.txt")
&ИсточникЗначение("@-", "", "", "")
Процедура ТестДолжен_КлассифицироватьВсеФормыКодированныхДанных(
	Значение,
	ИмяПоля,
	Текст,
	Путь
) Экспорт

	// Подготовка
	Источник = ИсточникОпции("data-urlencode", Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Часть = Новый КлассификаторДанныхCURL().Классифицировать(
		"data-urlencode",
		Выражение,
		Источник,
		РазделителиЧастейТелаCURL.Нет()
	).Значение();

	// Проверка
	Ожидаем.Что(Часть.ИмяПоля()).Равно(ПустоеКакНеопределено(ИмяПоля));
	Ожидаем.Что(Часть.Текст()).Равно(ПустоеКакНеопределено(Текст));
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(ПустоеКакНеопределено(Путь));
	Ожидаем.Что(Часть.Кодировать()).Равно(Истина);
	Если Значение = "@-" Тогда
		Ожидаем.Что(Часть.РежимИсточника()).Равно(РежимыИсточникаТелаCURL.СтандартныйВвод());
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("data", "@-", "СтандартныйВвод")
&ИсточникЗначение("data-binary", "@-", "СтандартныйВвод")
&ИсточникЗначение("upload-file", "-", "СтандартныйВвод")
&ИсточникЗначение("upload-file", ".", "НеблокирующийСтандартныйВвод")
Процедура ТестДолжен_СохранитьРежимСтандартногоВвода(ИмяОпции, Значение, ИмяРежима) Экспорт
	// Подготовка
	Источник = ИсточникОпции(ИмяОпции, Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Если ИмяОпции = "upload-file" Тогда
		Часть = Новый КлассификаторЗагрузкиCURL().Классифицировать(Выражение, Источник).Значение();
	Иначе
		Часть = Новый КлассификаторДанныхCURL().Классифицировать(
			ИмяОпции,
			Выражение,
			Источник,
			РазделителиЧастейТелаCURL.Амперсанд()
		).Значение();
	КонецЕсли;
	// Проверка
	Ожидаем.Что(Часть.РежимИсточника()).Равно(РежимПоИмени(ИмяРежима));
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьДинамическиеДанные() Экспорт
	// Подготовка
	Источник = ИсточникОпцииИзСтроки("--data-binary", """$BODY""");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Часть = Новый КлассификаторДанныхCURL().Классифицировать(
		"data-binary",
		Выражение,
		Источник,
		РазделителиЧастейТелаCURL.Амперсанд()
	).Значение();
	// Проверка
	Ожидаем.Что(Часть.ТребуетРазбора()).Равно(Истина);
	Ожидаем.Что(Часть.ОтложеннаяКлассификация().Грамматика()).Равно(ГрамматикиЗначенийCURL.ДвоичныеДанные());
	Ожидаем.Что(Часть.РазделительПеред()).Равно(РазделителиЧастейТелаCURL.Амперсанд());
КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьФормуСНесколькимиФайламиИМодификаторами() Экспорт
	// Подготовка
	Источник = ИсточникОпции("form", "photo=@a.png,b.png;type=image/png;filename=x.png;headers=X-A: 1");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Результат = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник);
	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()).ИмеетДлину(2);
	Ожидаем.Что(Результат.Значение()[0].ИмяПоля()).Равно("photo");
	Ожидаем.Что(Результат.Значение()[1].ПутьКФайлу()).Равно("b.png");
	Ожидаем.Что(Результат.Значение()[0].MIMEТип()).Равно("image/png");
	Ожидаем.Что(Результат.Значение()[0].ИмяФайла()).Равно("x.png");
	Ожидаем.Что(Результат.Значение()[0].Заголовки()).ИмеетДлину(1);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("field=@folder/file.txt", "file.txt")
&ИсточникЗначение("field=<folder/file.txt", "")
Процедура ТестДолжен_РазличитьПередаваемыйФайлИСодержимоеФайла(Значение, ИмяФайла) Экспорт

	// Подготовка
	Источник = ИсточникОпции("form", Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Часть = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник).Значение()[0];

	// Проверка
	Ожидаем.Что(Часть.ПутьКФайлу()).Равно("folder/file.txt");
	Ожидаем.Что(Часть.ИмяФайла()).Равно(ПустоеКакНеопределено(ИмяФайла));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СнятьКавычкиДоРазделенияСпискаФайлов() Экспорт

	// Подготовка
	Источник = ИсточникОпции("form", "field=@""a,b.txt""");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());

	// Действие
	Части = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Части).ИмеетДлину(1);
	Ожидаем.Что(Части[0].ПутьКФайлу()).Равно("a,b.txt");
	Ожидаем.Что(Части[0].ИмяФайла()).Равно("a,b.txt");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СнятьКавычкиПослеПрефиксовФормы() Экспорт

	// Подготовка
	Источник = ИсточникОпции(
		"form", "field=@source.txt;filename=""shown;a.txt"";headers=""X-Test: value""");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	ИсточникСодержимого = ИсточникОпции("form", "field=<""a;b.txt""");
	ВыражениеСодержимого = Новый ВыражениеЗначенияCURL(ИсточникСодержимого.ТокенЗначения());

	// Действие
	Часть = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник).Значение()[0];
	Содержимое = Новый КлассификаторФормыCURL().Классифицировать(
		ВыражениеСодержимого, ИсточникСодержимого).Значение()[0];

	// Проверка
	Ожидаем.Что(Содержимое.ПутьКФайлу()).Равно("a;b.txt");
	Ожидаем.Что(Часть.ИмяФайла()).Равно("shown;a.txt");
	Ожидаем.Что(Часть.Заголовки()).ИмеетДлину(1);
	Ожидаем.Что(Часть.Заголовки()[0].Имя()).Равно("X-Test");
	Ожидаем.Что(Часть.Заголовки()[0].Значение()).Равно(" value");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ТрактоватьСтроковуюФормуЛитерально() Экспорт
	// Подготовка
	Источник = ИсточникОпции("form-string", "field=@file;type=text/plain");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Часть = Новый КлассификаторФормыCURL().КлассифицироватьСтроку(Выражение, Источник).Значение()[0];
	// Проверка
	Ожидаем.Что(Часть.Текст()).Равно("@file;type=text/plain");
	Ожидаем.Что(Часть.РежимИсточника()).Равно(РежимыИсточникаТелаCURL.ЛитеральноеЗначение());
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("field=value;encoder=base64")
&ИсточникЗначение("field=(nested")
&ИсточникЗначение("field=@""unclosed")
Процедура ТестДолжен_ОтклонитьНеподдерживаемуюФорму(Значение) Экспорт
	// Подготовка
	Источник = ИсточникОпции("form", Значение);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенЗначения());
	// Действие
	Результат = Новый КлассификаторФормыCURL().Классифицировать(Выражение, Источник);
	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ИсточникОпции(Имя, Значение)
	Возврат Новый КомандыДляТестовCURL().ИсточникОпции("--" + Имя, Значение);
КонецФункции
Функция ИсточникОпцииИзСтроки(Имя, Значение)
	Возврат Новый КомандыДляТестовCURL().ИзСтроки("curl " + Имя + " " + Значение).Элементы()[0];
КонецФункции
Функция РазобратьКоманду(СтрокаАргументов)
	Аргументы = СтрРазделить(СтрокаАргументов, "|", Истина);
	Возврат Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);
КонецФункции
Функция РежимПоИмени(Имя) Возврат Вычислить("РежимыИсточникаТелаCURL." + Имя + "()"); КонецФункции
Функция ПустоеКакНеопределено(Значение) Возврат ?(Значение = "", Неопределено, Значение); КонецФункции
#КонецОбласти

#Использовать asserts
#Использовать "../../src/shared"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение(Ложь)
&ИсточникЗначение(Истина)
Процедура ТестДолжен_СкопироватьПорядокИСсылкиНаЭлементы(Фиксированный) Экспорт

	// Подготовка
	Элемент = Новый ФиксированнаяСтруктура("Имя", "первый");
	Массив = Новый Массив;
	Массив.Добавить(Элемент);
	Массив.Добавить(Неопределено);
	Источник = ?(Фиксированный, Новый ФиксированныйМассив(Массив), Массив);

	// Действие
	Результат = КоллекцииМоделиCURL.Скопировать(Источник);
	Массив.Очистить();

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("Массив");
	Ожидаем.Что(Результат).ИмеетДлину(2);
	Ожидаем.Что(Результат[0]).Равно(Элемент);
	Ожидаем.Что(Результат[1]).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Ложь)
&ИсточникЗначение(Истина)
Процедура ТестДолжен_СоздатьНезависимуюИзменяемуюКопию(Фиксированный) Экспорт

	// Подготовка
	Массив = Новый Массив;
	Массив.Добавить("первый");
	Массив.Добавить("второй");
	Источник = ?(Фиксированный, Новый ФиксированныйМассив(Массив), Массив);

	// Действие
	Результат = КоллекцииМоделиCURL.Скопировать(Источник);
	Результат.Удалить(0);
	Массив.Очистить();

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("Массив");
	Ожидаем.Что(Результат).ИмеетДлину(1);
	Ожидаем.Что(Результат[0]).Равно("второй");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Ложь)
&ИсточникЗначение(Истина)
Процедура ТестДолжен_СкопироватьСоответствиеСохранивКлючиИСсылки(Фиксированное) Экспорт

	// Подготовка
	Значение = Новый ТаблицаЗначений;
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Объект", Значение);
	Соответствие.Вставить(1, Неопределено);
	Источник = ?(Фиксированное, Новый ФиксированноеСоответствие(Соответствие), Соответствие);

	// Действие
	Результат = КоллекцииМоделиCURL.Скопировать(Источник);
	Результат.Вставить("Добавлено", Истина);
	Соответствие.Очистить();

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("Соответствие");
	Ожидаем.Что(Результат.Количество()).Равно(3);
	Ожидаем.Что(Результат["Объект"]).Равно(Значение);
	Ожидаем.Что(Результат[1]).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Ложь)
&ИсточникЗначение(Истина)
Процедура ТестДолжен_СкопироватьСтруктуруСохранивСвойстваИСсылки(Фиксированная) Экспорт

	// Подготовка
	Значение = Новый ТаблицаЗначений;
	Структура = Новый Структура;
	Структура.Вставить("Объект", Значение);
	Структура.Вставить("Пустое", Неопределено);
	Источник = ?(Фиксированная, Новый ФиксированнаяСтруктура(Структура), Структура);

	// Действие
	Результат = КоллекцииМоделиCURL.Скопировать(Источник);
	Результат.Вставить("Добавлено", Истина);
	Структура.Удалить("Объект");

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("Структура");
	Ожидаем.Что(Результат.Количество()).Равно(3);
	Ожидаем.Что(Результат.Объект).Равно(Значение);
	Ожидаем.Что(Результат.Пустое).Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

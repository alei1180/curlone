#Область Тесты

&Тест
Процедура ТестДолжен_ПередатьСобытияСемиОбработчиков() Экспорт

	// Подготовка
	Сценарии = Новый Соответствие;
	Сценарии.Вставить("--output|file.txt", "ДобавитьРезультат");
	Сценарии.Вставить("--head", "УстановитьНеПолучатьТело");
	Сценарии.Вставить("--data|data", "ДобавитьЧастьТела");
	Сценарии.Вставить("--user|user:pass", "УстановитьУчетныеДанные");
	Сценарии.Вставить("--cert|cert.pem", "УстановитьСертификатКлиента");
	Сценарии.Вставить("--proxy|localhost", "УстановитьПрокси");
	Сценарии.Вставить("--max-time|1", "УстановитьТаймаут");
	Реестр = Новый РеестрСемантическихОбработчиковCURL();

	// Действие и Проверка
	Для Каждого Сценарий Из Сценарии Цикл
		Аргументы = СтрРазделить("curl|" + Сценарий.Ключ + "|https://example.org", "|", Истина);
		ТокеныКоманды = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены();
		Элемент = Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды).Команда().Элементы()[0];
		Регистратор = Новый РегистраторСемантикиДляТестов();
		Реестр.НайтиОбработчик(Элемент.ОписаниеОпции().ИдентификаторОбработчика()).Применить(Элемент, Регистратор);
		Ожидаем.Что(Регистратор.События()).ИмеетДлину(1);
		Ожидаем.Что(Регистратор.События()[0].Имя).Равно(Сценарий.Значение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОбработчикиВсехПоддержанныхОпций() Экспорт

	// Подготовка
	Реестр = Новый РеестрСемантическихОбработчиковCURL();

	// Действие и Проверка
	Для Каждого Описание Из СпецификацияОпцийCURL.Все() Цикл
		Если Описание.Поддерживается() Тогда
			Обработчик = Реестр.НайтиОбработчик(Описание.ИдентификаторОбработчика());
			Ожидаем.Что(Обработчик).Существует();
			Ожидаем.Что(Реестр.НайтиОбработчик(Описание.ИдентификаторОбработчика())).Равно(Обработчик);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеизвестныйИПустойИдентификатор() Экспорт

	// Подготовка
	Реестр = Новый РеестрСемантическихОбработчиковCURL();

	// Действие и Проверка
	Для Каждого Идентификатор Из СтрРазделить("|unknown", "|", Истина) Цикл
		Ошибка = Неопределено;
		Попытка
			Реестр.НайтиОбработчик(Идентификатор);
		Исключение
			Ошибка = ИнформацияОбОшибке();
		КонецПопытки;
		Ожидаем.Что(Ошибка).Существует();
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
			КодыСтандартныхОшибок.НарушенВнутреннийИнвариант()
		);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

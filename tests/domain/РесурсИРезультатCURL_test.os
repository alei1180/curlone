#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("https:/example.org/path", "https://example.org/path", "https")
&ИсточникЗначение("https://example.org/path", "https://example.org/path", "https")
&ИсточникЗначение("https:///example.org/path", "https://example.org/path", "https")
&ИсточникЗначение("http:/example.org/path", "http://example.org/path", "http")
&ИсточникЗначение("ftp:///example.org/path", "ftp://example.org/path", "ftp")
&ИсточникЗначение("file:/C:/tmp/data", "file:///C:/tmp/data", "file")
&ИсточникЗначение("file:///C:/tmp/data", "file:///C:/tmp/data", "file")
&ИсточникЗначение("example.org:8080/path", "http://example.org:8080/path", "http")
&ИсточникЗначение("example.org/path/https://other", "http://example.org/path/https://other", "http")
Процедура ТестДолжен_НормализоватьРазделительСхемы(Адрес, ОжидаемыйАдрес, Протокол) Экспорт

	// Подготовка
	Источник = ИсточникURL(Адрес);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ресурс = Результат.Значение().Ресурс();
	Ожидаем.Что(Ресурс.АдресДляВыполнения().ЛитеральноеЗначение()).Равно(ОжидаемыйАдрес);
	Ожидаем.Что(Ресурс.Протокол()).Равно(Протокол);
	Ожидаем.Что(Ресурс.ИсходныйАдрес()).Равно(Выражение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЭкранированныеСкобкиКакЛитерал() Экспорт

	// Подготовка
	Источник = ИсточникURL("https://example.org/\{a,b\}/\[1-3\]");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение().Ресурс().ИсходныйАдрес()).Равно(Выражение);
	Ожидаем.Что(Результат.Значение().Ресурс().АдресДляВыполнения().ЛитеральноеЗначение()).Равно(
		"https://example.org/%7Ba,b%7D/%5B1-3%5D");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("user:pass@ftp.example.org/path", "ftp")
&ИсточникЗначение("FTP.example.org/file", "ftp")
&ИсточникЗначение("ImAp.example.org/inbox", "imap")
&ИсточникЗначение("DICT.example.org/word", "dict")
&ИсточникЗначение("LDAP.example.org/entry", "ldap")
&ИсточникЗначение("POP3.example.org/mail", "pop3")
&ИсточникЗначение("SMTP.example.org/mail", "smtp")
&ИсточникЗначение("example.org:8080/path", "http")
&ИсточникЗначение("https://[::1]/path", "https")
&ИсточникЗначение("example.org/file", "http")
Процедура ТестДолжен_ОпределитьПодразумеваемуюСхему(Адрес, Протокол) Экспорт

	// Подготовка
	Источник = ИсточникURL(Адрес);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение().Ресурс().Протокол()).Равно(Протокол);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьДанныеПользователяЗапросИФрагмент() Экспорт

	// Подготовка
	Источник = ИсточникURL("https://user%3Aname:pass%20word@example.org/path?#");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Результат.УчетныеДанные().Пользователь()).Равно("user:name");
	Ожидаем.Что(Результат.УчетныеДанные().Пароль()).Равно("pass word");
	Ожидаем.Что(Результат.РазделительПередПервойЧастью()).Равно(РазделителиСтрокиЗапросаCURL.Амперсанд());
	Ожидаем.Что(Результат.Ресурс().ФрагментУказан()).Равно(Истина);
	Ожидаем.Что(Результат.Ресурс().Фрагмент()).Равно("");
	Ожидаем.Что(Результат.Ресурс().АдресДляВыполнения().ЛитеральноеЗначение()).Равно(
		"https://example.org/path?"
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьРазборДинамическогоURL() Экспорт

	// Подготовка
	Источник = ДинамическийИсточник("$HOST/path");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Результат.Ресурс().ТребуетРазбора()).Равно(Истина);
	Ожидаем.Что(Результат.Ресурс().Протокол()).Равно(Неопределено);
	Ожидаем.Что(Результат.РазделительПередПервойЧастью()).Равно(
		РазделителиСтрокиЗапросаCURL.ОпределитьПоАдресу()
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("@file", "curlone.command.unsupported_multiple_transfer_source")
&ИсточникЗначение("@-", "curlone.command.unsupported_multiple_transfer_source")
&ИсточникЗначение("https://example.org/[1-3]", "curlone.command.unsupported_multiple_transfer_source")
&ИсточникЗначение("https://example.org/[a-z:2]", "curlone.command.unsupported_multiple_transfer_source")
&ИсточникЗначение("", "curlone.command.invalid_url")
&ИсточникЗначение("https://%FF:secret@example.org", "curlone.command.invalid_url")
&ИсточникЗначение("http:////example.org/path", "curlone.command.invalid_url")
&ИсточникЗначение("https:/", "curlone.command.invalid_url")
&ИсточникЗначение("http://", "curlone.command.invalid_url")
&ИсточникЗначение("https://example.org:65536", "curlone.command.invalid_url")
&ИсточникЗначение("https://example.org/{one,two}", "curlone.command.unsupported_multiple_transfer_source")
&ИсточникЗначение("http://[", "curlone.command.invalid_url")
Процедура ТестДолжен_ОтклонитьНедопустимыйИсточникURL(Адрес, Код) Экспорт

	// Подготовка
	Источник = ИсточникURL(Адрес);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРесурсаCURL().Классифицировать(Выражение, Источник);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(Код);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("-", "stdout")
&ИсточникЗначение("result.json", "file")
Процедура ТестДолжен_КлассифицироватьРезультат(Имя, Режим) Экспорт

	// Подготовка
	Источник = ИсточникURL(Имя);
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРезультатаCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Результат.Режим()).Равно(Режим);
	Ожидаем.Что(Результат.ИмяФайла()).Равно(?(Режим = "file", Выражение, Неопределено));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтложитьКлассификациюРезультата() Экспорт

	// Подготовка
	Источник = ДинамическийИсточник("$OUTPUT");
	Выражение = Новый ВыражениеЗначенияCURL(Источник.ТокенURL());

	// Действие
	Результат = Новый КлассификаторРезультатаCURL().Классифицировать(Выражение, Источник).Значение();

	// Проверка
	Ожидаем.Что(Результат.Режим()).Равно(РежимыРезультатаCURL.ОпределитьПослеВычисления());
	Ожидаем.Что(Результат.ОтложеннаяКлассификация().Грамматика()).Равно(ГрамматикиЗначенийCURL.Результат());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсточникURL(Значение)

	Возврат Новый КомандыДляТестовCURL().ИсточникURL(Значение);

КонецФункции

Функция ДинамическийИсточник(Значение)

	Токен = Новый ЛексерКомандыCURL().Разобрать("curl """ + Значение + """").Токены()[1];
	Возврат СоздательЭлементовРазобраннойКомандыCURL.URL(Токен);

КонецФункции

#КонецОбласти

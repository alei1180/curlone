#Область Тесты

&Тест
Процедура ТестДолжен_СоставитьОперациюИзВсехРазделовИСохранитьКоллекции() Экспорт

	// Подготовка
	Операция = ИнтерпретироватьПолнуюОперацию();

	// Действие
	КопияОперации = Новый ОперацияCURL(
		Операция.Ресурс(),
		Операция.Запрос(),
		Операция.Соединение(),
		Операция.Политики(),
		Операция.Результат()
	);

	// Проверка
	Ожидаем.Что(КопияОперации.Ресурс()).Равно(Операция.Ресурс());
	Ожидаем.Что(КопияОперации.Запрос()).Равно(Операция.Запрос());
	Ожидаем.Что(КопияОперации.Соединение()).Равно(Операция.Соединение());
	Ожидаем.Что(КопияОперации.Политики()).Равно(Операция.Политики());
	Ожидаем.Что(КопияОперации.Результат()).Равно(Операция.Результат());
	ПроверитьФиксированныйМассив(Операция.Запрос().Заголовки(), 1);
	ПроверитьФиксированныйМассив(Операция.Запрос().СтрокаЗапроса().Части(), 1);
	ПроверитьФиксированныйМассив(Операция.Запрос().Тело().Части(), 1);
	ПроверитьФиксированныйМассив(Операция.Запрос().Аутентификация().Способы(), 1);
	ПроверитьФиксированныйМассив(Операция.Соединение().Прокси().СпособыАутентификации(), 1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокОперацийИКопироватьКоллекцию() Экспорт

	// Подготовка
	Первая = ИнтерпретироватьПолнуюОперацию();
	Вторая = Новый ОперацияCURL(
		Первая.Ресурс(),
		Первая.Запрос(),
		Первая.Соединение(),
		Первая.Политики(),
		Первая.Результат()
	);
	Операции = Новый Массив;
	Операции.Добавить(Первая);
	Операции.Добавить(Вторая);

	// Действие
	Описание = Новый ОписаниеВыполненияCURL(Операции);
	Результат = Новый РезультатИнтерпретацииCURL(Описание, Новый Массив);
	Операции.Очистить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Выполнение()).Равно(Описание);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	ПроверитьФиксированныйМассив(Описание.Операции(), 2);
	Ожидаем.Что(Описание.Операции()[0]).Равно(Первая);
	Ожидаем.Что(Описание.Операции()[1]).Равно(Вторая);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнтерпретироватьПолнуюОперацию()

	Аргументы = СтрРазделить(
		"curl|--url-query|q=1|--header|X-Test: value|--form|field=value|--basic|--proxy-basic|"
		+ "--user|user:password|--proxy|http://proxy.example:8080|--max-time|2|--location|"
		+ "--output|result.txt|https://example.org/path",
		"|",
		Истина
	);
	Команда = Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);
	Результат = Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);

	Возврат Результат.Выполнение().Операции()[0];

КонецФункции

Процедура ПроверитьФиксированныйМассив(Значение, ОжидаемаяДлина)

	Ожидаем.Что(ТипЗнч(Значение)).Равно(Тип("ФиксированныйМассив"));
	Ожидаем.Что(Значение).ИмеетДлину(ОжидаемаяДлина);

КонецПроцедуры

#КонецОбласти

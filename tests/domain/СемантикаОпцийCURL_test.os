&Тест
Процедура ТестДолжен_ПеренестиДанныеПриGetИОставитьMultipart() Экспорт

	// Действие
	Перенесенный = ИнтерпретироватьАргументы(
		"curl|--get|--head|--data|a=1|https://example.org").Выполнение().Операции()[0];
	Multipart = ИнтерпретироватьАргументы(
		"curl|--get|--form|name=value|https://example.org").Выполнение().Операции()[0];

	// Проверка
	Ожидаем.Что(Перенесенный.Запрос().МетодПоУмолчанию()).Равно("HEAD");
	Ожидаем.Что(Перенесенный.Запрос().Тело().Вид()).Равно(ВидыТелаЗапросаCURL.Отсутствует());
	Ожидаем.Что(Перенесенный.Запрос().СтрокаЗапроса().Части()).ИмеетДлину(1);
	Ожидаем.Что(Multipart.Запрос().МетодПоУмолчанию()).Равно("POST");
	Ожидаем.Что(Multipart.Запрос().Тело().Вид()).Равно(ВидыТелаЗапросаCURL.Multipart());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЯвныеЗаголовкиПередАвтоматическими() Экспорт

	// Действие
	Результат = ИнтерпретироватьАргументы(
		"curl|--json|{}|--json|{}|--header|@missing.headers|--header|X-A:1|https://example.org");

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Заголовки = Результат.Выполнение().Операции()[0].Запрос().Заголовки();
	Ожидаем.Что(Заголовки).ИмеетДлину(4);
	Ожидаем.Что(Заголовки[0].Действие()).Равно(ДействияНадЗаголовкамиCURL.ЗагрузитьИзФайла());
	Ожидаем.Что(Заголовки[1].Имя()).Равно("X-A");
	Ожидаем.Что(Заголовки[2].Действие()).Равно(ДействияНадЗаголовкамиCURL.УстановитьЕслиОтсутствует());
	Ожидаем.Что(Заголовки[3].Действие()).Равно(ДействияНадЗаголовкамиCURL.УстановитьЕслиОтсутствует());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьЯвныеДанныеИВытеснитьСпособыПодписью() Экспорт

	// Действие
	Результат = ИнтерпретироватьАргументы(
		"curl|--user|:|--basic|--aws-sigv4|aws|--digest|--oauth2-bearer|token|https://a:b@example.org");

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Аутентификация = Результат.Выполнение().Операции()[0].Запрос().Аутентификация();
	Ожидаем.Что(Аутентификация.УчетныеДанные().Пользователь()).Равно("");
	Ожидаем.Что(Аутентификация.УчетныеДанные().Пароль()).Равно("");
	Ожидаем.Что(Аутентификация.Способы()).ИмеетДлину(0);
	Ожидаем.Что(Аутентификация.OAuth2().Выражение().ЛитеральноеЗначение()).Равно("token");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНесовместимыеРежимыИИсточники() Экспорт

	// Подготовка
	Команды = Новый Массив;
	Команды.Добавить("curl|--head|--data|a|https://example.org");
	Команды.Добавить("curl|--head|--form|a=b|https://example.org");
	Команды.Добавить("curl|--head|--upload-file|a|https://example.org");
	Команды.Добавить("curl|--form|a=b|--head|https://example.org");
	Команды.Добавить("curl|--head|--no-head|https://example.org");
	Команды.Добавить("curl|--url|@missing");
	Команды.Добавить("curl|--output|a|--output|b|https://example.org");

	// Действие и Проверка
	Для Каждого Команда Из Команды Цикл
		Результат = ИнтерпретироватьАргументы(Команда);
		Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
		Ожидаем.Что(Результат.Выполнение()).Равно(Неопределено);
		Ожидаем.Что(Результат.Ошибки().Количество() > 0).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнтерпретироватьАргументы(Текст)

	Аргументы = СтрРазделить(Текст, "|", Истина);
	Команда = Новый КомандыДляТестовCURL().ИзАргументов(Аргументы);
	Возврат Новый ИнтерпретаторКомандыCURL().Интерпретировать(Команда);

КонецФункции

// Список берется из выполняемых сценариев, чтобы проверка полноты не жила отдельной таблицей.
Функция ОпцииПараметризованныхТестов()

	Результат = Новый Соответствие;
	Методы = Новый Рефлектор().ПолучитьТаблицуМетодов(ЭтотОбъект);
	Для Каждого Метод Из Методы Цикл
		Если Метод.Аннотации.Найти("ПроверяетПоддержанныеОпции", "Имя") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ожидаем.Что(Метод.Аннотации.Найти("ПараметризованныйТест", "Имя")).Существует();
		Для Каждого Аннотация Из Метод.Аннотации Цикл
			Если Аннотация.Имя = "ИсточникЗначение" Тогда
				ИмяОпции = Аннотация.Параметры[0].Значение;
				Результат.Вставить(ИмяОпции, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать asserts
#Использовать "../../src/syntax"
#Использовать "../../src/domain"
#Использовать "."

#Область Тесты

&Тест
Процедура ТестДолжен_ИметьСценарииДляВсехПоддержанныхОпций() Экспорт

	// Подготовка
	ПроверенныеОпции = ОпцииПараметризованныхТестов();

	// Действие и Проверка
	Количество = 0;
	Для Каждого Описание Из СпецификацияОпцийCURL.Все() Цикл
		Если Описание.ПоддерживаласьВV1() Тогда
			Ожидаем.Что(ПроверенныеОпции.Получить(Описание.КаноническоеИмя())).Равно(Истина);
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Количество).Равно(42);
	Ожидаем.Что(ПроверенныеОпции.Количество()).Равно(Количество);

КонецПроцедуры

&ПроверяетПоддержанныеОпции
&ПараметризованныйТест
&ИсточникЗначение("request", "--request|PATCH", "GET", "PATCH")
Процедура ТестДолжен_ПрименитьЯвныйМетод(ИмяОпции, Аргументы, Метод, Значение) Экспорт

	// Подготовка
	Команда = "curl|" + Аргументы + "|https://example.org";

	// Действие
	Результат = ИнтерпретироватьАргументы(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Операция = Результат.Выполнение().Операции()[0];
	Ожидаем.Что(Операция.Запрос().МетодПоУмолчанию()).Равно(Метод);
	Ожидаем.Что(Операция.Запрос().ЯвныйМетод().ЛитеральноеЗначение()).Равно(Значение);

КонецПроцедуры


#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"
#Использовать "../../src/domain"

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьУспешныйРезультатКлассификации() Экспорт

	// Действие
	Результат = Новый РезультатКлассификацииCURL("значение", Новый Массив);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Значение()).Равно("значение");
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНеуспешныйРезультатСЗащитнойКопиейОшибок() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить(ФабрикаОшибок.Создать("test.error", "Ошибка"));

	// Действие
	Результат = Новый РезультатКлассификацииCURL(Неопределено, Ошибки);
	Ошибки.Очистить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Значение()).Равно(Неопределено);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
	ПроверитьЧтоКоллекцияНеизменяема(Результат.Ошибки());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьРезультатБезЗначенияИОшибок() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСоздания(Неопределено, Новый Массив);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьЗначениеВРезультатеСОшибками() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Ошибки.Добавить(ФабрикаОшибок.Создать("test.error", "Ошибка"));

	// Действие
	Ошибка = ПолучитьОшибкуСоздания("значение", Ошибки);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуСоздания(Значение, Ошибки)

	Попытка
		Результат = Новый РезультатКлассификацииCURL(Значение, Ошибки);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

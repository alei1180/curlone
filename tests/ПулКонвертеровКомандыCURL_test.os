#Использовать asserts
#Использовать "../src/core"

#Область Тесты

&Тест
Процедура ТестДолжен_ЛенивоСоздатьКонвертер() Экспорт

	// Подготовка
	Пул = Новый ПулКонвертеровКомандыCURL(20);

	// Действие
	Конвертер = Пул.Получить();

	// Проверка
	Ожидаем.Что(Конвертер, "Пул должен вернуть созданный конвертер").Заполнено();
	Пул.Вернуть(Конвертер);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РасширитьПулПоТребованию() Экспорт

	// Подготовка
	Пул = Новый ПулКонвертеровКомандыCURL(20);

	// Действие
	Первый = Пул.Получить();
	Второй = Пул.Получить();

	// Проверка
	Ожидаем.Что(Первый = Второй, "Пул должен создать второй конвертер при отсутствии свободных").ЭтоЛожь();
	Пул.Вернуть(Первый);
	Пул.Вернуть(Второй);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторноИспользоватьВозвращенныйКонвертер() Экспорт

	// Подготовка
	Пул = Новый ПулКонвертеровКомандыCURL(20);
	Первый = Пул.Получить();
	Пул.Вернуть(Первый);

	// Действие
	Второй = Пул.Получить();

	// Проверка
	Ожидаем.Что(Второй = Первый, "Пул должен повторно использовать возвращенный конвертер").ЭтоИстина();
	Пул.Вернуть(Второй);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОжидатьВозвратаПриДостиженииМаксимума() Экспорт

	// Подготовка
	Пул = Новый ПулКонвертеровКомандыCURL(1);
	Первый = Пул.Получить();
	Контекст = Новый Структура("Пул, Получен", Пул, Ложь);
	Параметры = Новый Массив();
	Параметры.Добавить(Контекст);

	// Действие
	ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПолучитьИВернутьКонвертер", Параметры);
	Приостановить(100);

	// Проверка
	Ожидаем.Что(Контекст.Получен, "Получение должно ожидать возврата конвертера при достижении максимума").ЭтоЛожь();
	Пул.Вернуть(Первый);
	ФоновыеЗадания.ОжидатьЗавершенияЗадач();
	Ожидаем.Что(Контекст.Получен, "Получение должно завершиться после возврата конвертера").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНовыйКонвертерПослеОтбрасывания() Экспорт

	// Подготовка
	Пул = Новый ПулКонвертеровКомандыCURL(1);
	Первый = Пул.Получить();

	// Действие
	Пул.Отбросить();
	Второй = Пул.Получить();

	// Проверка
	Ожидаем.Что(Второй = Первый, "Пул должен создать новый конвертер вместо отброшенного").ЭтоЛожь();
	Пул.Вернуть(Второй);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Получает конвертер в фоновом задании и сразу возвращает его в пул.
//
// Параметры:
//   Контекст - Структура - Пул и признак получения конвертера.
Процедура ПолучитьИВернутьКонвертер(Контекст) Экспорт
	Конвертер = Контекст.Пул.Получить();
	Контекст.Получен = Истина;
	Контекст.Пул.Вернуть(Конвертер);
КонецПроцедуры

#КонецОбласти

#Использовать asserts
#Использовать errors
#Использовать "../../src/syntax"

#Область Тесты

&Тест
Процедура ТестДолжен_АдаптироватьМассивБезИнтерпретацииЗначений() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	Аргументы.Добавить("$NAME");
	Аргументы.Добавить("'quoted'");
	Аргументы.Добавить("");

	// Действие
	Результат = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()).ИмеетДлину(4);
	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Токен = Результат.Токены()[Индекс];
		Ожидаем.Что(Токен.Значение()).Равно(Аргументы[Индекс]);
		Ожидаем.Что(Токен.ИсходноеПредставление()).Равно(Аргументы[Индекс]);
		Ожидаем.Что(Токен.Позиция()).Равно(Индекс + 1);
		Ожидаем.Что(Токен.ПозицияВИсходнойСтроке()).Равно(-1);
		Ожидаем.Что(Токен.ПозицияВАргументе()).Равно(1);
		Ожидаем.Что(Токен.Фрагменты()[0].Вид).Равно(ВидыФрагментовТокенаCURL.Текст());
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПринятьФиксированныйМассивИЗащититьсяОтИзменения() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	ФиксированныеАргументы = Новый ФиксированныйМассив(Аргументы);

	// Действие
	Результат = Новый АдаптерАргументовКомандыCURL().Адаптировать(ФиксированныеАргументы);
	Аргументы[0] = "changed";

	// Проверка
	Ожидаем.Что(Результат.Токены()[0].Значение()).Равно("curl");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеверныеТипыАргументов() Экспорт

	// Подготовка
	Аргументы = Новый Массив;
	Аргументы.Добавить("curl");
	Аргументы.Добавить(42);
	Адаптер = Новый АдаптерАргументовКомандыCURL;

	// Действие и Проверка
	ПроверитьКодИсключения(Адаптер, 42);
	ПроверитьКодИсключения(Адаптер, Аргументы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКодИсключения(Адаптер, Аргументы)

	Попытка
		Адаптер.Адаптировать(Аргументы);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ИнформацияОбОшибке())).Равно(
			КодыСтандартныхОшибок.НеверныйТипАргумента()
		);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

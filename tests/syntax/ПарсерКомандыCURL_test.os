#Область Тесты

&Тест
Процедура ТестДолжен_РазобратьДлинныеКороткиеИПрисоединенныеФормы() Экспорт

	// Подготовка
	ТокеныКоманды = ТокеныИзАргументов("curl|--header|A: B|--header=C: D|-H|E: F|-HG: H");

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Элементы = Результат.Команда().Элементы();
	Ожидаем.Что(Элементы).ИмеетДлину(4);
	Ожидаем.Что(Элементы[0].ТокенЗначения().Значение()).Равно("A: B");
	Ожидаем.Что(Элементы[1].ТокенЗначения().Значение()).Равно("C: D");
	Ожидаем.Что(Элементы[2].ТокенЗначения().Значение()).Равно("E: F");
	Ожидаем.Что(Элементы[3].ТокенЗначения().Значение()).Равно("G: H");
	Ожидаем.Что(Элементы[1].ТокенЗначения().ПозицияВАргументе()).Равно(10);
	Ожидаем.Что(Элементы[3].ТокенЗначения().ПозицияВАргументе()).Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьHelpСПрисоединеннымЗначениемКакКороткуюОпцию() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|-header"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Элемент = Результат.Команда().Элементы()[0];
	Ожидаем.Что(Элемент.ОписаниеОпции().КаноническоеИмя()).Равно("help");
	Ожидаем.Что(Элемент.ТокенЗначения().Значение()).Равно("eader");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьДлинныйИКороткийHelpБезНеобязательногоЗначения() Экспорт

	// Действие
	ДлиннаяФорма = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|--help"));
	КороткаяФорма = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|-h"));

	// Проверка
	Ожидаем.Что(ДлиннаяФорма.Успешно()).Равно(Истина);
	Ожидаем.Что(ДлиннаяФорма.Команда().Элементы()[0].ТокенЗначения()).ЭтоНеопределено();
	Ожидаем.Что(КороткаяФорма.Успешно()).Равно(Истина);
	Ожидаем.Что(КороткаяФорма.Команда().Элементы()[0].ТокенЗначения()).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьHelpСНеобязательнымЗначением() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|--help|all"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Элемент = Результат.Команда().Элементы()[0];
	Ожидаем.Что(Элемент.ТокенЗначения().Значение()).Равно("all");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьГруппуФлаговОтрицаниеИГраницы() Экспорт

	// Подготовка
	ТокеныКоманды = ТокеныИзАргументов("curl|-sS|--location|--no-location|--next|-:|example.org");

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Элементы = Результат.Команда().Элементы();
	Ожидаем.Что(Элементы).ИмеетДлину(7);
	Ожидаем.Что(Элементы[0].ТокенОпции().ПозицияВАргументе()).Равно(1);
	Ожидаем.Что(Элементы[1].ТокенОпции().ПозицияВАргументе()).Равно(3);
	Ожидаем.Что(Элементы[3].ОтрицательнаяФорма()).Равно(Истина);
	Ожидаем.Что(Элементы[4].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды());
	Ожидаем.Что(Элементы[5].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды());
	Ожидаем.Что(Элементы[6].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.URL());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПроизводныйТокенNextВГруппеКороткихОпций() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|-:s"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Граница = Результат.Команда().Элементы()[0];
	Ожидаем.Что(Граница.ТокенОпции().Значение()).Равно("-:");
	Ожидаем.Что(Граница.ИсходныйТокен().Значение()).Равно("-:s");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьРазборОпцийПослеДвойногоДефиса() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|--|--location|-H"));

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Команда().Элементы()).ИмеетДлину(2);
	Ожидаем.Что(Результат.Команда().Элементы()[0].ТокенURL().Значение()).Равно("--location");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьЗначенияБезПредметнойПроверки() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(
		ТокеныИзАргументов("curl|--retry|abc|--max-time|-1|--header|")
	);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Команда().Элементы()).ИмеетДлину(3);
	Ожидаем.Что(Результат.Команда().Элементы()[2].ТокенЗначения().Значение()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьТочныеКодыСинтаксическихОшибок() Экспорт

	// Действие и Проверка
	ПроверитьКодОшибки("wget|example.org", КодыОшибокCurlone.ТребуетсяCurl());
	ПроверитьКодОшибки("curl|--unknown", КодыОшибокCurlone.НеизвестнаяОпция());
	ПроверитьКодОшибки("curl|--H", КодыОшибокCurlone.НеизвестнаяОпция());
	ПроверитьКодОшибки("curl|--header", КодыОшибокCurlone.ТребуетсяЗначениеОпции());
	ПроверитьКодОшибки("curl|--location=true", КодыОшибокCurlone.ЗначениеОпцииНеДопускается());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаполнитьВсеПоляДанныхОшибки() Экспорт

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов("curl|--unknown"));
	Данные = ДиагностикаОшибок.ДанныеОшибки(Результат.Ошибки()[0]);

	// Проверка
	Ожидаем.Что(Данные.Свойство("Позиция")).Равно(Истина);
	Ожидаем.Что(Данные.Свойство("ПозицияВИсходнойСтроке")).Равно(Истина);
	Ожидаем.Что(Данные.Свойство("ПозицияВАргументе")).Равно(Истина);
	Ожидаем.Что(Данные.Свойство("ИсходноеПредставление")).Равно(Истина);
	Ожидаем.Что(Данные.Позиция).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПорядокURLИПозицииПроизводныхТокенов() Экспорт

	// Подготовка
	ЛексическийРезультат = Новый ЛексерКомандыCURL().Разобрать(
		"curl -sS example.org --header=value second.example -Hvalue"
	);

	// Действие
	Результат = Новый ПарсерКомандыCURL().Разобрать(ЛексическийРезультат.Токены());

	// Проверка
	Элементы = Результат.Команда().Элементы();
	Ожидаем.Что(Элементы).ИмеетДлину(6);
	Ожидаем.Что(Элементы[0].ТокенОпции().ПозицияВИсходнойСтроке()).Равно(6);
	Ожидаем.Что(Элементы[1].ТокенОпции().ПозицияВИсходнойСтроке()).Равно(8);
	Ожидаем.Что(Элементы[2].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.URL());
	Ожидаем.Что(Элементы[3].ТокенЗначения().ПозицияВИсходнойСтроке()).Равно(31);
	Ожидаем.Что(Элементы[4].ТокенURL().Значение()).Равно("second.example");
	Ожидаем.Что(Элементы[5].ТокенЗначения().ПозицияВАргументе()).Равно(3);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТокеныИзАргументов(СтрокаАргументов)

	Аргументы = СтрРазделить(СтрокаАргументов, "|", Истина);
	Возврат Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены();

КонецФункции

Процедура ПроверитьКодОшибки(СтрокаАргументов, ОжидаемыйКод)

	Результат = Новый ПарсерКомандыCURL().Разобрать(ТокеныИзАргументов(СтрокаАргументов));
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Команда()).ЭтоНеопределено();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти

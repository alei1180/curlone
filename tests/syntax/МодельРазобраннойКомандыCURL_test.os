#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьТриВидаЭлементовИНезависимуюКоманду() Экспорт

	// Подготовка
	Аргументы = СтрРазделить("curl|-L|example.org", "|");
	ТокеныКоманды = Новый АдаптерАргументовКомандыCURL().Адаптировать(Аргументы).Токены();
	Описание = СпецификацияОпцийCURL.НайтиПоИмени("L");
	Элементы = Новый Массив;
	Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.Опция(
		Описание, "-L", Ложь, ТокеныКоманды[1], Неопределено, ТокеныКоманды[1]));
	Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.URL(ТокеныКоманды[2]));
	Элементы.Добавить(СоздательЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды(
		СпецификацияОпцийCURL.НайтиПоИмени("next"), "--next", ТокеныКоманды[1], ТокеныКоманды[1]));

	// Действие
	Команда = Новый РазобраннаяКомандаCURL(Элементы);
	Элементы.Очистить();

	// Проверка
	Ожидаем.Что(Команда.Элементы()).ИмеетДлину(3);
	Ожидаем.Что(Команда.Элементы()[0].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.Опция());
	Ожидаем.Что(Команда.Элементы()[0].ТокенURL()).ЭтоНеопределено();
	Ожидаем.Что(Команда.Элементы()[1].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.URL());
	Ожидаем.Что(Команда.Элементы()[1].ОтрицательнаяФорма()).Равно(Ложь);
	Ожидаем.Что(Команда.Элементы()[2].Вид()).Равно(ВидыЭлементовРазобраннойКомандыCURL.ГраницаСекцииКоманды());
	ПроверитьЧтоКоллекцияНеизменяема(Команда.Элементы());

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьНеизменяемыйРезультат() Экспорт

	// Подготовка
	Ошибки = Новый Массив;
	Команда = Новый РазобраннаяКомандаCURL(Новый Массив);

	// Действие
	Результат = Новый РезультатСинтаксическогоРазбораCURL(Команда, Ошибки);
	Ошибки.Добавить("ошибка");

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Команда()).Равно(Команда);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	ПроверитьЧтоКоллекцияНеизменяема(Результат.Ошибки());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьУспешныйРезультатБезКоманды() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата(Неопределено, Новый Массив);

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьКомандуВРезультатеСОшибками() Экспорт

	// Подготовка
	Команда = Новый РазобраннаяКомандаCURL(Новый Массив);
	Ошибки = Новый Массив;
	Ошибки.Добавить(ОшибкиРазбораCURL.Создать("curlone.command.unknown_option", "Ошибка", -1, -1, -1, ""));

	// Действие
	Ошибка = ПолучитьОшибкуСозданияРезультата(Команда, Ошибки);

	// Проверка
	Ожидаем.Что(Ошибка).Существует();
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДоверятьКомандеВнутреннегоРезультата() Экспорт

	// Действие
	Результат = Новый РезультатСинтаксическогоРазбораCURL(1, Новый Массив);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Команда()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДоверятьАргументамВнутреннегоКонструктораЭлемента() Экспорт

	// Действие
	Элемент = Новый ЭлементРазобраннойКомандыCURL(
		"ВнутреннийВид",
		"Описание",
		1,
		"ОтрицательнаяФорма",
		2,
		3,
		4,
		5
	);

	// Проверка
	Ожидаем.Что(Элемент.Вид()).Равно("ВнутреннийВид");
	Ожидаем.Что(Элемент.ОписаниеОпции()).Равно("Описание");
	Ожидаем.Что(Элемент.УказанноеИмяОпции()).Равно(1);
	Ожидаем.Что(Элемент.ИсходныйТокен()).Равно(5);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьОшибкуСозданияРезультата(Команда, Ошибки)

	Попытка
		Результат = Новый РезультатСинтаксическогоРазбораCURL(Команда, Ошибки);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

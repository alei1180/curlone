#Использовать "../../src/syntax"

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("LF")
&ИсточникЗначение("CRLF")
&ИсточникЗначение("CR")
Процедура ТестДолжен_СохранитьПродолжениеСтрокиИПозицииКоманд(ВидПереноса) Экспорт

	// Подготовка
	Перенос = ?(ВидПереноса = "LF", Символы.ПС, Символы.ВК);
	Если ВидПереноса = "CRLF" Тогда
		Перенос = Символы.ВК + Символы.ПС;
	КонецЕсли;

	ПерваяКоманда = "curl --data-raw line1\" + Перенос + "line2 http://example.com";
	ВтораяКоманда = "curl http://example.org";
	Текст = "  " + ПерваяКоманда + Перенос + "  " + ВтораяКоманда;

	// Действие
	Команды = Новый РазделительКомандCURL().РазделитьСПозициями(Текст);

	// Проверка
	Ожидаем.Что(Команды).ИмеетДлину(2);
	Ожидаем.Что(Команды[0].Команда).Равно(ПерваяКоманда);
	Ожидаем.Что(Команды[0].ПозицияВИсходнойСтроке).Равно(3);
	Ожидаем.Что(Команды[1].Команда).Равно(ВтораяКоманда);
	Ожидаем.Что(Команды[1].ПозицияВИсходнойСтроке).Равно(СтрНайти(Текст, ВтораяКоманда));

	Разбор = Новый ЛексерКомандыCURL().Разобрать(Команды[0].Команда, Команды[0].ПозицияВИсходнойСтроке);
	Ожидаем.Что(Разбор.Успешно()).ЭтоИстина();
	Ожидаем.Что(Разбор.Токены()[2].Значение()).Равно("line1line2");
	Ожидаем.Что(Разбор.Токены()[3].ПозицияВИсходнойСтроке()).Равно(СтрНайти(Текст, "http://example.com"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("value\ ", "value ")
&ИсточникЗначение("value\  ", "value ")
&ИсточникЗначение("value\ \ ", "value  ")
&ИсточникЗначение("value\{TAB}", "value{TAB}")
Процедура ТестДолжен_СохранитьЭкранированныеПробелыВКонцеКоманды(Аргумент, Значение) Экспорт

	// Подготовка
	Аргумент = СтрЗаменить(Аргумент, "{TAB}", Символы.Таб);
	Значение = СтрЗаменить(Значение, "{TAB}", Символы.Таб);
	Команда = "curl http://example.com --data-raw " + Аргумент;

	// Действие
	Команды = Новый РазделительКомандCURL().Разделить(Команда);

	// Проверка
	Ожидаем.Что(Команды).ИмеетДлину(1);
	Ожидаем.Что(Команды[0]).Равно(Команда);

	Разбор = Новый ЛексерКомандыCURL().Разобрать(Команды[0]);
	Ожидаем.Что(Разбор.Успешно()).ЭтоИстина();
	Ожидаем.Что(Разбор.Токены()[3].Значение()).Равно(Значение);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазделитьКомандыПослеЭкранированногоОбратногоСлеша() Экспорт

	// Подготовка
	ПерваяКоманда = "curl http://example.com --data-raw value\\";
	ВтораяКоманда = "curl http://example.org";
	Текст = ПерваяКоманда + Символы.ВК + Символы.ПС + ВтораяКоманда;

	// Действие
	Команды = Новый РазделительКомандCURL().Разделить(Текст);

	// Проверка
	Ожидаем.Что(Команды).ИмеетДлину(2);
	Ожидаем.Что(Команды[0]).Равно(ПерваяКоманда);
	Ожидаем.Что(Команды[1]).Равно(ВтораяКоманда);

	Разбор = Новый ЛексерКомандыCURL().Разобрать(Команды[0]);
	Ожидаем.Что(Разбор.Успешно()).ЭтоИстина();
	Ожидаем.Что(Разбор.Токены()[3].Значение()).Равно("value\");

КонецПроцедуры

#КонецОбласти

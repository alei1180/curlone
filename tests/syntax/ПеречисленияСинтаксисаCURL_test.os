&Тест
Процедура ТестДолжен_ПредоставитьПравилаПовторенияОпций() Экспорт

	// Действие
	Значения = Новый Массив;
	Значения.Добавить(ПравилаПовторенияОпцийCURL.БезДополнительногоЭффекта());

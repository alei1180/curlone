#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставитьВидыФрагментовТокена() Экспорт

	// Действие
	Значения = Новый Массив;
	Значения.Добавить(ВидыФрагментовТокенаCURL.Текст());
	Значения.Добавить(ВидыФрагментовТокенаCURL.Переменная());

	// Проверка
	ПроверитьЗначения(Значения, "text,variable");

КонецПроцедуры


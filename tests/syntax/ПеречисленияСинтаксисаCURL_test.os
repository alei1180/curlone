#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗначения(Значения, ОжидаемыеЗначения)

	Ожидаемые = СтрРазделить(ОжидаемыеЗначения, ",");
	Уникальные = Новый Соответствие;
	Для Каждого Значение Из Значения Цикл
		Уникальные.Вставить(Значение, Истина);
	КонецЦикла;

	Ожидаем.Что(Значения).ИмеетДлину(Ожидаемые.Количество());
	Ожидаем.Что(Уникальные).ИмеетДлину(Ожидаемые.Количество());
	Для Индекс = 0 По Ожидаемые.ВГраница() Цикл
		Ожидаем.Что(Значения[Индекс]).Равно(Ожидаемые[Индекс]);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

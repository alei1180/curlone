#Область Тесты

&Тест
Процедура ТестДолжен_РазделитьАргументыИСохранитьПозиции() Экспорт

	// Подготовка
	Лексер = Новый ЛексерКомандыCURL;

	// Действие
	Результат = Лексер.Разобрать("curl" + Символы.Таб + "  https://example.com");

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()).ИмеетДлину(2);
	ПроверитьТокен(Результат.Токены()[0], "curl", "curl", 1, 1);
	ПроверитьТокен(Результат.Токены()[1], "https://example.com", "https://example.com", 2, 8);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбработатьКавычкиИПустыеАргументы() Экспорт

	// Подготовка
	Команда = "curl 'a b' ""c d"" '' """"";

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()).ИмеетДлину(5);
	Ожидаем.Что(Результат.Токены()[1].Значение()).Равно("a b");
	Ожидаем.Что(Результат.Токены()[1].ИсходноеПредставление()).Равно("'a b'");
	Ожидаем.Что(Результат.Токены()[2].Значение()).Равно("c d");
	Ожидаем.Что(Результат.Токены()[3].Значение()).Равно("");
	Ожидаем.Что(Результат.Токены()[4].Значение()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСтруктурированныеПеременные() Экспорт

	// Подготовка
	Команда = "curl ""usr:$PASSWORD"" '$LITERAL' ${TOKEN}";

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()[1].Значение()).Равно("usr:$PASSWORD");
	Ожидаем.Что(Результат.Токены()[1].Фрагменты()).ИмеетДлину(3);
	Ожидаем.Что(Результат.Токены()[1].Фрагменты()[1].Вид).Равно(
		ВидыФрагментовТокенаCURL.Переменная()
	);
	Ожидаем.Что(Результат.Токены()[1].Фрагменты()[1].Значение).Равно("PASSWORD");
	Ожидаем.Что(Результат.Токены()[2].Фрагменты()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Токены()[2].Фрагменты()[0].Вид).Равно(ВидыФрагментовТокенаCURL.Текст());
	Ожидаем.Что(Результат.Токены()[3].Фрагменты()[0].Значение).Равно("TOKEN");
	Ожидаем.Что(Результат.Токены()[3].Фрагменты()[0].ИсходноеПредставление).Равно("${TOKEN}");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименитьПравилаЭкранированияBash() Экспорт

	// Подготовка
	Команда = "curl a\ b ""\d+"" ""\$VALUE"" line1\" + Символы.ПС + "line2";

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()[1].Значение()).Равно("a b");
	Ожидаем.Что(Результат.Токены()[2].Значение()).Равно("\d+");
	Ожидаем.Что(Результат.Токены()[3].Значение()).Равно("$VALUE");
	Ожидаем.Что(Результат.Токены()[4].Значение()).Равно("line1line2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьПродолжениеСтрокиCRLF() Экспорт

	// Подготовка
	Команда = "curl line1\" + Символы.ВК + Символы.ПС + "line2";

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()[1].Значение()).Равно("line1line2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПереводСтрокиВКавычках() Экспорт

	// Подготовка
	Команда = "curl ""line1" + Символы.ПС + "line2""";

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать(Команда);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()[1].Значение()).Равно("line1" + Символы.ПС + "line2");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьДолларПередКавычкойТекстомВнутриДвойныхКавычек() Экспорт

	// Действие
	ПередОдинарнойКавычкой = Новый ЛексерКомандыCURL().Разобрать("curl ""a$'b'""");
	ПередЗакрывающейКавычкой = Новый ЛексерКомандыCURL().Разобрать("curl ""a$""b");

	// Проверка
	Ожидаем.Что(ПередОдинарнойКавычкой.Успешно()).Равно(Истина);
	Ожидаем.Что(ПередОдинарнойКавычкой.Токены()[1].Значение()).Равно("a$'b'");
	Ожидаем.Что(ПередЗакрывающейКавычкой.Успешно()).Равно(Истина);
	Ожидаем.Что(ПередЗакрывающейКавычкой.Токены()[1].Значение()).Равно("a$b");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьСтруктурированнуюОшибкуShellСинтаксиса() Экспорт

	// Подготовка
	Лексер = Новый ЛексерКомандыCURL;

	// Действие
	Результат = Лексер.Разобрать("curl https://example.com | jq");

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(1);
	Ошибка = Результат.Ошибки()[0];
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыОшибокCurlone.НеподдерживаемыйСинтаксисОболочки()
	);
	Данные = Новый РазборОшибки(Ошибка).Данные();
	Ожидаем.Что(Данные.Позиция).Равно(3);
	Ожидаем.Что(Данные.ПозицияВИсходнойСтроке).Равно(26);
	Ожидаем.Что(Данные.ПозицияВАргументе).Равно(-1);
	Ожидаем.Что(Данные.ИсходноеПредставление).Равно("|");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНезакрытуюКавычкуИНеподдерживаемыеПодстановки() Экспорт

	// Действие
	НезакрытаяКавычка = Новый ЛексерКомандыCURL().Разобрать("curl 'value");
	Подстановка = Новый ЛексерКомандыCURL().Разобрать("curl ${NAME:-default}");
	Команда = Новый ЛексерКомандыCURL().Разобрать("curl ""$(whoami)""");

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(НезакрытаяКавычка.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НезакрытаяКавычка()
	);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Подстановка.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НеподдерживаемыйСинтаксисОболочки()
	);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Команда.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НеподдерживаемыйСинтаксисОболочки()
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("$@")
&ИсточникЗначение("$*")
&ИсточникЗначение("$#")
&ИсточникЗначение("$!")
&ИсточникЗначение("$-")
&ИсточникЗначение("$'text'")
&ИсточникЗначение("$""text""")
Процедура ТестДолжен_ОтклонитьНеподдерживаемуюФормуДоллараBash(Подстановка) Экспорт

	// Действие
	Результат = Новый ЛексерКомандыCURL().Разобрать("curl " + Подстановка);

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат.Ошибки()[0])).Равно(
		КодыОшибокCurlone.НеподдерживаемыйСинтаксисОболочки()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТокен(Токен, Значение, ИсходноеПредставление, Позиция, ПозицияВИсходнойСтроке)

	Ожидаем.Что(Токен.Значение()).Равно(Значение);
	Ожидаем.Что(Токен.ИсходноеПредставление()).Равно(ИсходноеПредставление);
	Ожидаем.Что(Токен.Позиция()).Равно(Позиция);
	Ожидаем.Что(Токен.ПозицияВИсходнойСтроке()).Равно(ПозицияВИсходнойСтроке);
	Ожидаем.Что(Токен.ПозицияВАргументе()).Равно(1);

КонецПроцедуры

#КонецОбласти

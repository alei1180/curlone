#Использовать asserts
#Использовать "../../src/syntax"

#Область Тесты

&Тест
Процедура ТестДолжен_ПотокобезопасноИнициализироватьСпецификацию() Экспорт

	// Подготовка
	Затвор = Новый БлокировкаРесурса();
	Затвор.Заблокировать();
	Задания = Новый Массив;
	Для Индекс = 1 По 20 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Затвор);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "НайтиОпциюПослеОткрытияЗатвора", Параметры));
	КонецЦикла;
	Приостановить(100);

	// Действие
	Затвор.Разблокировать();
	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	// Проверка
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.Состояние).Равно(СостояниеФоновогоЗадания.Завершено);
		Ожидаем.Что(Задание.Результат).Равно("header");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Находит описание опции после одновременного открытия затвора.
//
// Параметры:
//   Затвор - БлокировкаРесурса - Общая блокировка запуска фоновых заданий.
//
// Возвращаемое значение:
//   Строка - Каноническое имя найденной опции.
Функция НайтиОпциюПослеОткрытияЗатвора(Затвор) Экспорт

	Затвор.Заблокировать();
	Затвор.Разблокировать();
	Возврат СпецификацияОпцийCURL.НайтиПоИмени("header").КаноническоеИмя();

КонецФункции

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьЗначениеФрагментыИПозиции() Экспорт

	// Подготовка
	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ТекстовыйФрагмент("-H"));
	Фрагменты.Добавить(ФрагментПеременной("HEADER"));
	КартаПозиций = ПоследовательностьЧисел(9);

	// Действие
	Токен = Новый ТокенКомандыCURL("-H$HEADER", "-H$HEADER", Фрагменты, 2, 6, 1, КартаПозиций);

	// Проверка
	Ожидаем.Что(Токен.Значение()).Равно("-H$HEADER");
	Ожидаем.Что(Токен.ИсходноеПредставление()).Равно("-H$HEADER");
	Ожидаем.Что(Токен.Позиция()).Равно(2);
	Ожидаем.Что(Токен.ПозицияВИсходнойСтроке()).Равно(6);
	Ожидаем.Что(Токен.ПозицияВАргументе()).Равно(1);
	Ожидаем.Что(Токен.Фрагменты()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПроизводныйТокенПеременной() Экспорт

	// Подготовка
	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ТекстовыйФрагмент("-H"));
	Фрагменты.Добавить(ФрагментПеременной("HEADER"));
	Токен = Новый ТокенКомандыCURL(
		"-H$HEADER",
		"-H$HEADER",
		Фрагменты,
		2,
		6,
		1,
		ПоследовательностьЧисел(9)
	);

	// Действие
	Производный = Токен.СоздатьПроизводный(3, 7);

	// Проверка
	Ожидаем.Что(Производный.Значение()).Равно("$HEADER");
	Ожидаем.Что(Производный.ИсходноеПредставление()).Равно("$HEADER");
	Ожидаем.Что(Производный.Позиция()).Равно(2);
	Ожидаем.Что(Производный.ПозицияВИсходнойСтроке()).Равно(8);
	Ожидаем.Что(Производный.ПозицияВАргументе()).Равно(3);
	Ожидаем.Что(Производный.Фрагменты()[0].Вид).Равно(ВидыФрагментовТокенаCURL.Переменная());
	Ожидаем.Что(Производный.Фрагменты()[0].Значение).Равно("HEADER");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗащититьКоллекцииТокенаОтИзменения() Экспорт

	// Подготовка
	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ТекстовыйФрагмент("curl"));
	Токен = Новый ТокенКомандыCURL("curl", "curl", Фрагменты, 1, 1, 1, ПоследовательностьЧисел(4));

	// Действие
	Фрагменты.Очистить();

	// Проверка
	Ожидаем.Что(Токен.Фрагменты()).ИмеетДлину(1);
	ПроверитьЧтоКоллекцияНеизменяема(Токен.Фрагменты());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДоверятьСкалярнымАргументамВнутреннегоКонструктора() Экспорт

	// Подготовка
	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ТекстовыйФрагмент("curl"));

	// Действие
	Токен = Новый ТокенКомандыCURL(
		1,
		2,
		Фрагменты,
		"Позиция",
		"ПозицияВИсходнойСтроке",
		"ПозицияВАргументе",
		ПоследовательностьЧисел(4)
	);

	// Проверка
	Ожидаем.Что(Токен.Значение()).Равно(1);
	Ожидаем.Что(Токен.ИсходноеПредставление()).Равно(2);
	Ожидаем.Что(Токен.Позиция()).Равно("Позиция");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПроизводныйТокенЗаГраницамиЗначения() Экспорт

	// Подготовка
	Токен = ТекстовыйТокен("curl");

	// Действие и Проверка
	Попытка
		Токен.СоздатьПроизводный(5, 1);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ошибка = ИнформацияОбОшибке();
		Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
		);
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеизменяемыйРезультатЛексическогоРазбора() Экспорт

	// Подготовка
	ИсходныеТокены = Новый Массив;
	ИсходныеТокены.Добавить(ТекстовыйТокен("curl"));
	ИсходныеОшибки = Новый Массив;

	// Действие
	Результат = Новый РезультатЛексическогоРазбораCURL(ИсходныеТокены, ИсходныеОшибки);
	ИсходныеТокены.Очистить();

	// Проверка
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);
	Ожидаем.Что(Результат.Токены()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Ошибки()).ИмеетДлину(0);
	ПроверитьЧтоКоллекцияНеизменяема(Результат.Токены());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстовыйТокен(Значение)

	Фрагменты = Новый Массив;
	Фрагменты.Добавить(ТекстовыйФрагмент(Значение));
	Возврат Новый ТокенКомандыCURL(
		Значение,
		Значение,
		Фрагменты,
		1,
		1,
		1,
		ПоследовательностьЧисел(СтрДлина(Значение))
	);

КонецФункции

Функция ТекстовыйФрагмент(Значение)

	Возврат Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Текст(),
		Значение,
		Значение
	);

КонецФункции

Функция ФрагментПеременной(Имя)

	Возврат Новый Структура(
		"Вид, Значение, ИсходноеПредставление",
		ВидыФрагментовТокенаCURL.Переменная(),
		Имя,
		"$" + Имя
	);

КонецФункции

Функция ПоследовательностьЧисел(Количество)

	Результат = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Результат.Добавить(Индекс);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

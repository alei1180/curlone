КонецПроцедуры

&Тест
Процедура ТестДолжен_СодержатьВесьКаталогV1БезДубликатов() Экспорт

	// Действие
	ВсеОпции = СпецификацияОпцийCURL.Все();
	КаноническиеИмена = Новый Соответствие;
	Псевдонимы = Новый Соответствие;
	КоличествоПсевдонимов = 0;
	КоличествоОпцийV1 = 0;
	Для Каждого Описание Из ВсеОпции Цикл
		КаноническиеИмена.Вставить(Описание.КаноническоеИмя(), Истина);
		Если Описание.ПоддерживаласьВV1() Тогда
			КоличествоОпцийV1 = КоличествоОпцийV1 + 1;
		КонецЕсли;
		Ожидаем.Что(Описание.РежимЗначения()).Заполнено();
		Ожидаем.Что(Описание.ТипЗначения()).Заполнено();
		Ожидаем.Что(Описание.ОбластьДействия()).Заполнено();
		Ожидаем.Что(Описание.ПравилоПовторения()).Заполнено();
		Ожидаем.Что(Описание.ИдентификаторОбработчика() <> "").Равно(Описание.ПоддерживаласьВV1());
		Для Каждого Псевдоним Из Описание.Псевдонимы() Цикл
			Псевдонимы.Вставить(Псевдоним, Истина);
			КоличествоПсевдонимов = КоличествоПсевдонимов + 1;
			Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени(Псевдоним)).Равно(Описание);
		КонецЦикла;
	КонецЦикла;

	// Проверка
	Ожидаем.Что(ВсеОпции).ИмеетДлину(264);
	Ожидаем.Что(КаноническиеИмена).ИмеетДлину(264);
	Ожидаем.Что(Псевдонимы).ИмеетДлину(КоличествоПсевдонимов);
	Ожидаем.Что(КоличествоОпцийV1).Равно(42);
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("xattr")).Существует();
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("abstract-unix-socket")).Существует();
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("--no-silent")).Существует();
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("silent").ОбластьДействия()).Равно(
		ОбластиДействияОпцийCURL.Локальная()
	);
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("header").ПравилоПовторения()).Равно(
		ПравилаПовторенияОпцийCURL.Добавление()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоответствоватьЭталонуКаталогаCURLВосемьШестнадцать() Экспорт

	// Подготовка
	ЭталонныеСтроки = ПрочитатьЭталонныеСтрокиКаталога();
	ВсеОпции = СпецификацияОпцийCURL.Все();

	// Действие и Проверка
	Ожидаем.Что(ВсеОпции).ИмеетДлину(ЭталонныеСтроки.Количество());
	Для Индекс = 0 По ВсеОпции.ВГраница() Цикл
		Ожидаем.Что(СериализоватьОписание(ВсеОпции[Индекс])).Равно(ЭталонныеСтроки[Индекс]);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеизменяемыеКоллекцииОписания() Экспорт

	// Подготовка
	Описание = СпецификацияОпцийCURL.НайтиПоИмени("header");

	// Действие и Проверка
	ПроверитьЧтоКоллекцияНеизменяема(Описание.Псевдонимы());
	ПроверитьЧтоКоллекцияНеизменяема(Описание.ОтрицательныеПсевдонимы());
	ПроверитьЧтоКоллекцияНеизменяема(СпецификацияОпцийCURL.Все());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСоздаватьОтрицательнуюФормуДляСамостоятельныхФлагов() Экспорт

	// Подготовка
	ИменаФлагов = СтрРазделить(
		"anyauth,dump-ca-embed,ftp-pasv,http1.0,http1.1,http2,http2-prior-knowledge,http3,http3-only,ipv4,ipv6,"
		+ "proxy-tlsv1,sslv2,sslv3,tlsv1,tlsv1.0,tlsv1.1,tlsv1.2,tlsv1.3",
		","
	);

	// Действие и Проверка
	Для Каждого ИмяФлага Из ИменаФлагов Цикл
		Описание = СпецификацияОпцийCURL.НайтиПоИмени(ИмяФлага);
		Ожидаем.Что(Описание.ОтрицательныеПсевдонимы()).ИмеетДлину(0);
		Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("no-" + ИмяФлага)).ЭтоНеопределено();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЧтоКоллекцияНеизменяема(Коллекция)

	Попытка
		Коллекция.Добавить(Неопределено);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("Метод объекта не обнаружен");
	КонецПопытки;

КонецПроцедуры

Функция ПрочитатьЭталонныеСтрокиКаталога()

	Чтение = Новый ЧтениеТекста("tests/syntax/ЭталонСпецификацииОпцийCURL_8_16_0.tsv");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Текст = СтрЗаменить(Текст, Символы.ПС + "|", "");
	Возврат СтрРазделить(Текст, Символы.ПС, Ложь);

КонецФункции

Функция СериализоватьОписание(Описание)

	Поля = Новый Массив;
	Поля.Добавить(Описание.КаноническоеИмя());
	Поля.Добавить(СоединитьКоллекцию(Описание.Псевдонимы()));
	Поля.Добавить(СоединитьКоллекцию(Описание.ОтрицательныеПсевдонимы()));
	Поля.Добавить(Описание.РежимЗначения());
	Поля.Добавить(Описание.ТипЗначения());
	Поля.Добавить(Описание.ОбластьДействия());
	Поля.Добавить(Описание.ПравилоПовторения());
	// Эталон curl фиксирует синтаксис; распределение обработчиков v2 проверяется отдельно.
	Поля.Добавить("");
	Поля.Добавить(?(Описание.ПоддерживаласьВV1(), "true", "false"));
	Поля.Добавить(?(Описание.Управляющая(), "true", "false"));
	Возврат СтрСоединить(Поля, Символы.Таб);

КонецФункции

Функция СоединитьКоллекцию(Коллекция)

	Элементы = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат СтрСоединить(Элементы, ",");

КонецФункции

#КонецОбласти

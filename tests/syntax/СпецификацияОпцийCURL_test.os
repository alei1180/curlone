#Область Тесты

&Тест
Процедура ТестДолжен_НазначитьОбработчикКаждойПоддержаннойОпции() Экспорт

	// Действие и Проверка
	Для Каждого Описание Из СпецификацияОпцийCURL.Все() Цикл
		Если Описание.ПоддерживаласьВV1() Тогда
			Ожидаем.Что(Описание.ИдентификаторОбработчика() <> "").Равно(Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиОпциюПоКороткомуИДлинномуИмени() Экспорт

	// Действие
	ПоКороткомуИмени = СпецификацияОпцийCURL.НайтиПоИмени("H");
	ПоКороткойФорме = СпецификацияОпцийCURL.НайтиПоИмени("-H");
	ПоДлинномуИмени = СпецификацияОпцийCURL.НайтиПоИмени("header");
	ПоДлиннойФорме = СпецификацияОпцийCURL.НайтиПоИмени("--header");

	// Проверка
	Ожидаем.Что(ПоКороткомуИмени.КаноническоеИмя()).Равно("header");
	Ожидаем.Что(ПоКороткойФорме).Равно(ПоКороткомуИмени);
	Ожидаем.Что(ПоДлинномуИмени).Равно(ПоКороткомуИмени);
	Ожидаем.Что(ПоДлиннойФорме).Равно(ПоКороткомуИмени);
	Ожидаем.Что(ПоКороткомуИмени.РежимЗначения()).Равно(РежимыЗначенияОпцийCURL.Требует());
	Ожидаем.Что(ПоКороткомуИмени.ТипЗначения()).Равно(ТипыЗначенийОпцийCURL.Строковое());
	Ожидаем.Что(ПоКороткомуИмени.ПоддерживаласьВV1()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьРегистрИФормуПрефикса() Экспорт

	// Действие
	Заголовок = СпецификацияОпцийCURL.НайтиПоИмени("-H");
	Справка = СпецификацияОпцийCURL.НайтиПоИмени("-h");

	// Проверка
	Ожидаем.Что(Заголовок.КаноническоеИмя()).Равно("header");
	Ожидаем.Что(Справка.КаноническоеИмя()).Равно("help");
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("--H")).Равно(Неопределено);
	Ожидаем.Что(СпецификацияОпцийCURL.НайтиПоИмени("-header")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъединитьПоложительнуюИОтрицательнуюФормы() Экспорт

	// Действие
	Положительная = СпецификацияОпцийCURL.НайтиПоИмени("--location");
	Отрицательная = СпецификацияОпцийCURL.НайтиПоИмени("--no-location");

	// Проверка
	Ожидаем.Что(Отрицательная).Равно(Положительная);
	Ожидаем.Что(Положительная.ОтрицательныеПсевдонимы().Найти("no-location")).Существует();
	Ожидаем.Что(Положительная.ПоддерживаласьВV1()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставитьУправляющуюОпциюNext() Экспорт

	// Действие
	Длинная = СпецификацияОпцийCURL.НайтиПоИмени("--next");
	Короткая = СпецификацияОпцийCURL.НайтиПоИмени("-:");

	// Проверка
	Ожидаем.Что(Длинная).Равно(Короткая);
	Ожидаем.Что(Длинная.КаноническоеИмя()).Равно("next");
	Ожидаем.Что(Длинная.Управляющая()).Равно(Истина);

КонецПроцедуры

&Тест

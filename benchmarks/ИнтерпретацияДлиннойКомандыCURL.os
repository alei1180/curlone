#Использовать errors
#Использовать "../src/public"
#Использовать "../src/shared"
#Использовать "../src/syntax"
#Использовать "../src/domain"

Перем _Лексер; // ЛексерКомандыCURL
Перем _Парсер; // ПарсерКомандыCURL
Перем _Интерпретатор; // ИнтерпретаторКомандыCURL
Перем _СтрокаКоманды; // Строка
Перем _Команда; // РазобраннаяКомандаCURL
Перем _ПоследнийРезультат; // РезультатИнтерпретацииCURL, РезультатСинтаксическогоРазбораCURL

#Область ОбработчикиСобытий

// Подготавливает длинную команду вне измеряемой части.
&КоличествоИтераций(10)
&КоличествоПрогревочныхИтераций(2)
&КоличествоВызововЗаИтерацию(100)
Процедура ПриСозданииОбъекта()

	_Лексер = Новый ЛексерКомандыCURL();
	_Парсер = Новый ПарсерКомандыCURL();
	_Интерпретатор = Новый ИнтерпретаторКомандыCURL();

	Части = Новый Массив;
	Части.Добавить("curl");

	Для Индекс = 1 По 50 Цикл
		Части.Добавить(СтрШаблон("--header ""X-Header-%1: value-%1""", Индекс));
	КонецЦикла;

	Части.Добавить("https://example.org/resource?first=1&second=2");

	_СтрокаКоманды = СтрСоединить(Части, " ");
	_Команда = _Парсер.Разобрать(_Лексер.Разобрать(_СтрокаКоманды).Токены()).Команда();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет лексический и синтаксический этапы без интерпретации.
&Бенчмарк(Наименование = "Лексер и парсер длинной команды")
Процедура РазобратьДлиннуюКоманду() Экспорт

	_ПоследнийРезультат = _Парсер.Разобрать(_Лексер.Разобрать(_СтрокаКоманды).Токены());

КонецПроцедуры

// Измеряет только семантическую интерпретацию подготовленной команды.
&Бенчмарк(Наименование = "Интерпретация длинной команды")
Процедура ИнтерпретироватьДлиннуюКоманду() Экспорт

	_ПоследнийРезультат = _Интерпретатор.Интерпретировать(_Команда);

КонецПроцедуры

#КонецОбласти

#Использовать "../src/public"
#Использовать "../src/syntax"

Перем _Лексер; // ЛексерКомандыCURL
Перем _Парсер; // ПарсерКомандыCURL
Перем _Команда; // Строка
Перем _Токены; // ФиксированныйМассив из ТокенКомандыCURL
Перем _ПоследнийРезультат; // РезультатЛексическогоРазбораCURL, РезультатСинтаксическогоРазбораCURL

#Область ОбработчикиСобытий

&КоличествоИтераций(10)
&КоличествоПрогревочныхИтераций(2)
&КоличествоВызововЗаИтерацию(100)
Процедура ПриСозданииОбъекта()

	_Лексер = Новый ЛексерКомандыCURL;
	_Парсер = Новый ПарсерКомандыCURL;
	_Команда = СоздатьКомандуДляЗамера();
	_Токены = _Лексер.Разобрать(_Команда).Токены();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет лексический разбор длинной команды curl.
&Бенчмарк(Наименование = "Лексический разбор длинной команды")
Процедура ВыполнитьЛексическийРазбор() Экспорт

	_ПоследнийРезультат = _Лексер.Разобрать(_Команда);

КонецПроцедуры

// Измеряет синтаксический разбор заранее подготовленных токенов.
&Бенчмарк(Наименование = "Синтаксический разбор длинной команды")
Процедура ВыполнитьСинтаксическийРазбор() Экспорт

	_ПоследнийРезультат = _Парсер.Разобрать(_Токены);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКомандуДляЗамера()

	ЧастиКоманды = Новый Массив;
	ЧастиКоманды.Добавить("curl");

	Для Индекс = 1 По 50 Цикл
		ЧастиКоманды.Добавить(СтрШаблон("-H ""X-Header-%1: value-%1""", Индекс));
	КонецЦикла;

	ЧастиКоманды.Добавить("https://example.com/resource?first=1&second=2");

	Возврат СтрСоединить(ЧастиКоманды, " ");

КонецФункции

#КонецОбласти

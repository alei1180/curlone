#Использовать errors
#Использовать "../src/public"
#Использовать "../src/shared"
#Использовать "../src/syntax"
#Использовать "../src/domain"
#Использовать "../src/generation"

Перем _Короткое; // ОписаниеВыполненияCURL
Перем _Длинное; // ОписаниеВыполненияCURL
Перем _Описание; // ОписаниеГенератораCURL
Перем _Анализатор; // АнализаторВозможностейГенератора
Перем _Параметры; // Соответствие
Перем _Результат; // Произвольный

#Область ОбработчикиСобытий

// Подготавливает модели и снимок возможностей вне измеряемого участка.
&КоличествоИтераций(5)
&КоличествоПрогревочныхИтераций(2)
&КоличествоВызововЗаИтерацию(30)
Процедура ПриСозданииОбъекта()

	Текст = "curl";
	Для Индекс = 1 По 50 Цикл
		Текст = Текст + СтрШаблон(" -H ""X-Test-%1: value%1""", Индекс);
	КонецЦикла;

	_Анализатор = Новый АнализаторВозможностейГенератора;
	_Параметры = Новый Соответствие;
	_Описание = Новый ОписаниеГенератораCURL("benchmark", "Измерение", 1, КодыВозможностейГенератораCURL.Все());
	_Короткое = Подготовить("curl https://example.org");
	_Длинное = Подготовить(Текст + " https://example.org");

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет анализ короткой модели.
&Бенчмарк(Наименование = "Анализ короткой модели")
Процедура АнализКороткойМодели() Экспорт

	_Результат = _Анализатор.Анализировать(_Короткое, _Описание);

КонецПроцедуры

// Измеряет анализ длинной модели.
&Бенчмарк(Наименование = "Анализ длинной модели")
Процедура АнализДлиннойМодели() Экспорт

	_Результат = _Анализатор.Анализировать(_Длинное, _Описание);

КонецПроцедуры

// Измеряет создание и проверку публичного контекста без копирования короткой модели.
&Бенчмарк(Наименование = "Контекст короткой модели")
Процедура КонтекстКороткойМодели() Экспорт

	_Результат = Новый КонтекстГенерацииКода(
		_Короткое.Операции(),
		"ru",
		_Параметры,
		_Описание.Идентификатор(),
		_Описание.Возможности()
	);

КонецПроцедуры

// Измеряет создание и проверку публичного контекста без копирования длинной модели.
&Бенчмарк(Наименование = "Контекст длинной модели")
Процедура КонтекстДлиннойМодели() Экспорт

	_Результат = Новый КонтекстГенерацииКода(
		_Длинное.Операции(),
		"ru",
		_Параметры,
		_Описание.Идентификатор(),
		_Описание.Возможности()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Подготовить(Текст)

	ТокеныКоманды = Новый ЛексерКомандыCURL().Разобрать(Текст).Токены();
	РазобраннаяКоманда = Новый ПарсерКомандыCURL().Разобрать(ТокеныКоманды).Команда();

	Возврат Новый ИнтерпретаторКомандыCURL().Интерпретировать(РазобраннаяКоманда).Выполнение();

КонецФункции

#КонецОбласти

#Использовать errors
#Использовать "../src/public"
#Использовать "../src/syntax"

Перем _Разделитель; // РазделительКомандCURL
Перем _Лексер; // ЛексерКомандыCURL
Перем _Команда; // Строка
Перем _ПоследнийРезультат; // РезультатЛексическогоРазбораCURL

#Область ОбработчикиСобытий

&КоличествоИтераций(3)
&КоличествоПрогревочныхИтераций(1)
&КоличествоВызововЗаИтерацию(1)
Процедура ПриСозданииОбъекта()

	_Разделитель = Новый РазделительКомандCURL;
	_Лексер = Новый ЛексерКомандыCURL;

	ЧастиТела = Новый Массив;
	Для Индекс = 1 По 1000 Цикл
		ЧастиТела.Добавить("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
	КонецЦикла;

	_Команда = "curl --data-raw """ + СтрСоединить(ЧастиТела, "") + """ https://example.org";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Измеряет разделение и лексический разбор команды с телом 64 КБ.
&Бенчмарк(Наименование = "Разбор команды с телом 64 КБ")
Процедура РазобратьБольшоеТело() Экспорт

	Команды = _Разделитель.Разделить(_Команда);
	_ПоследнийРезультат = _Лексер.Разобрать(Команды[0]);

КонецПроцедуры

#КонецОбласти
